{%- comment -%}
  XERO film — full-bleed video.

  This section previously rendered ONLY a striped placeholder with a fake play
  button; the `film` setting existed in the schema but nothing ever read it, so
  no uploaded video could play. It now actually renders the video, autoplays
  muted when it scrolls into view, loops, and pauses when it leaves.

  muted + playsinline are required or mobile browsers refuse to autoplay.
{%- endcomment -%}

{%- assign film = section.settings.film -%}

<section class="xero-night" data-sec="film" style="position:relative;width:100%;background:var(--pg);padding:0;">

  <div data-m="frame" style="position:relative;width:100%;height:min(84vh,56.25vw);min-height:20rem;overflow:hidden;background:#000;">

    {%- if film != blank -%}
      {{ film | video_tag:
           image_size: '1600x',
           playsinline: true,
           muted: true,
           loop: true,
           autoplay: true,
           controls: false,
           preload: 'metadata',
           style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;'
      }}

      <button data-m="sound" aria-label="Toggle sound"
        style="position:absolute;right:1.1rem;bottom:1.1rem;z-index:2;width:2.6rem;height:2.6rem;border-radius:50%;background:rgba(14,14,20,.6);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;cursor:pointer;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6.5 9H3v6h3.5L11 19z"></path><path data-m="mute" d="M16 9.5l4.5 5M20.5 9.5l-4.5 5"></path><path data-m="unmute" style="display:none" d="M15.5 8.8a4.4 4.4 0 0 1 0 6.4M18.4 6.4a8 8 0 0 1 0 11.2"></path></svg>
      </button>

    {%- elsif section.settings.poster != blank -%}
      {% render 'xero-image', key: 'poster', label: "", radius: 0, circle: false %}

    {%- else -%}
      <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.2rem;background:repeating-linear-gradient(135deg,rgba(255,255,255,.05) 0 12px,transparent 12px 24px);">
        <span style="font:500 .8rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.04em;color:var(--txt3,#8a8b91);text-align:center;">{{ section.settings.label }}</span>
      </div>
    {%- endif -%}

  </div>

</section>

<script>
(function(){
  var secs = document.querySelectorAll('[data-sec="film"]');
  secs.forEach(function(sec){
    var v = sec.querySelector('video');
    if (!v) return;

    // belt and braces — Shopify's video_tag does not always emit these
    v.muted = true;
    v.setAttribute('muted','');
    v.setAttribute('playsinline','');
    v.setAttribute('webkit-playsinline','');
    v.loop = true;

    new IntersectionObserver(function(en){
      en.forEach(function(e){
        if (e.isIntersecting){ v.play().catch(function(){}); }
        else if (!v.paused){ v.pause(); }
      });
    }, { threshold: .2 }).observe(v);

    var btn = sec.querySelector('[data-m="sound"]');
    if (btn){
      btn.addEventListener('click', function(){
        v.muted = !v.muted;
        sec.querySelector('[data-m="mute"]').style.display   = v.muted ? '' : 'none';
        sec.querySelector('[data-m="unmute"]').style.display = v.muted ? 'none' : '';
        if (v.paused) v.play().catch(function(){});
      });
    }
  });
})();
</script>

{% schema %}
{
  "name": "XERO film",
  "tag": "div",
  "settings": [
    { "type": "video", "id": "film", "label": "Film" },
    { "type": "image_picker", "id": "poster", "label": "Poster (shown if there is no film)" },
    { "type": "text", "id": "label", "label": "Placeholder label", "default": "full-bleed film — 16:9" }
  ],
  "presets": [{ "name": "XERO film" }]
}
{% endschema %}
