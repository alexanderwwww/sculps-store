{%- comment -%}
  HOMEPAGE TRACKING — small globe + fast track.

  Replaces the old stage-rail version. Half the weight: a compact hexagon globe,
  one line of copy, and a client-ID field that jumps straight to the full page.

  The field writes the ID to localStorage and navigates — /pages/track already
  auto-opens a remembered ID, so a valid code lands on its own timeline with no
  second click.

  Copy is deliberate: the bikes are BUILT AND WAITING. We do the quality check
  and prep. Nothing here claims we start building after someone orders.
{%- endcomment -%}

<section class="xero-night" data-sec="track" id="track" style="position:relative;width:100%;background:var(--pg2);padding:6.5rem 1.4rem 6rem;">

  <div style="max-width:70rem;margin:0 auto;display:grid;grid-template-columns:.85fr 1.15fr;gap:3rem;align-items:center;" data-m="trkgrid">

    {%- comment -%} compact globe {%- endcomment -%}
    <div data-m="miniglobe" style="position:relative;width:100%;max-width:22rem;aspect-ratio:1/1;margin-inline:auto;">
      <canvas data-m="minicanvas" style="position:absolute;inset:0;width:100%;height:100%;display:block;"></canvas>
      {%- comment -%}
        The pulsing "LIVE" chip and the "SHIPPING FROM NEVADA, USA" label were both
        removed, and they must not come back. The globe's arc is decoration drawn from
        hardcoded coordinates - there is no live shipment behind it. Labelling static
        artwork as live fulfilment activity on a store with no orders is fabricated
        trading history, and naming a dispatch country the business does not operate
        from is a KYC misrepresentation that fails payment underwriting outright.
        If you ever want an origin label here, it has to be the real one.
      {%- endcomment -%}
    </div>

    {%- comment -%} copy + fast track {%- endcomment -%}
    <div>
      <div style="font-size:.76rem;font-weight:600;letter-spacing:.22em;color:var(--txt3,#7c7d85);">{{ section.settings.eyebrow }}</div>
      <h2 style="margin:.9rem 0 0;font-size:clamp(1.9rem,4.4vw,3.1rem);font-weight:700;letter-spacing:-.038em;line-height:1.05;color:var(--txt,#0e0e0e);text-wrap:balance;">{{ section.settings.heading }}</h2>
      <p style="margin:1rem 0 0;max-width:32rem;font-size:1.04rem;line-height:1.55;color:var(--txt2,#55565c);text-wrap:pretty;">{{ section.settings.sub }}</p>

      {%- comment -%} three quick facts, plain type {%- endcomment -%}
      <div style="margin-top:1.6rem;display:flex;gap:1.6rem;flex-wrap:wrap;">
        {%- for i in (1..3) -%}
          {%- assign fk = i | prepend: 'f' | append: '_text' -%}
          {%- if section.settings[fk] != blank -%}
            <div style="display:flex;align-items:center;gap:.5rem;font-size:.92rem;color:var(--txt2,#55565c);">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="#c68bff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 4 6 12 3 9"></polyline></svg>
              {{ section.settings[fk] }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} fast track field {%- endcomment -%}
      <div style="margin-top:1.9rem;display:flex;gap:.6rem;max-width:26rem;flex-wrap:wrap;">
        <input data-m="trkin" type="text" inputmode="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="12" placeholder="XR-0000-0000" aria-label="Client ID"
          style="flex:1 1 12rem;height:3.1rem;border-radius:.9rem;border:1.5px solid var(--hair,rgba(255,255,255,.14));background:rgba(0,0,0,.28);color:var(--txt,#0e0e0e);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:1rem;font-weight:600;letter-spacing:.12em;text-align:center;text-transform:uppercase;outline:none;transition:border-color .3s,box-shadow .3s;">
        <button data-m="trkgo" type="button"
          style="flex:0 0 auto;height:3.1rem;padding:0 1.5rem;border-radius:1.55rem;background:#3a82fb;color:#fff;font-size:1rem;font-weight:600;border:0;cursor:pointer;transition:transform .25s cubic-bezier(.28,.11,.32,1);">{{ section.settings.cta }}</button>
      </div>
      <p data-m="trkerr" style="margin:.6rem 0 0;font-size:.82rem;color:#f87171;min-height:1.1em;"></p>
      <p style="margin:.2rem 0 0;font-size:.82rem;color:var(--txt3,#7c7d85);">{{ section.settings.hint }}</p>
    </div>

  </div>
</section>

<style>
  @keyframes xmpulse{ 70%{ box-shadow:0 0 0 .5rem rgba(198,139,255,0); } 100%{ box-shadow:0 0 0 0 rgba(198,139,255,0); } }
  [data-sec="track"] [data-m="trkin"]:focus{ border-color:#c68bff; box-shadow:0 0 0 4px rgba(198,139,255,.14); }
  [data-sec="track"] [data-m="trkgo"]:active{ transform:scale(.98); }
  @media (max-width: 860px){
    [data-sec="track"] [data-m="trkgrid"]{ grid-template-columns:1fr !important; gap:1.8rem !important; text-align:center; }
    [data-sec="track"] [data-m="trkgrid"] > div:last-child > div[style*="flex"]{ justify-content:center; }
    [data-sec="track"] [data-m="trkin"]{ text-align:center; }
  }
</style>

{% render 'xero-globe' %}

<script>
(function(){
  var sec = document.querySelector('[data-sec="track"]');
  if (!sec) return;
  var host = sec.querySelector('[data-m="miniglobe"]');
  var cv   = sec.querySelector('[data-m="minicanvas"]');
  var input= sec.querySelector('[data-m="trkin"]');
  var go   = sec.querySelector('[data-m="trkgo"]');
  var err  = sec.querySelector('[data-m="trkerr"]');
  var RE   = /^XR-[A-Z0-9]{4}-[A-Z0-9]{4}$/;

  function fmt(v){
    v = v.toUpperCase().replace(/[^A-Z0-9]/g,'');
    if (v.slice(0,2) !== 'XR') v = 'XR' + v.replace(/^X?R?/,'');
    v = v.slice(0,10);
    var out = v.slice(0,2);
    if (v.length > 2) out += '-' + v.slice(2,6);
    if (v.length > 6) out += '-' + v.slice(6,10);
    return out;
  }
  input.addEventListener('input', function(){ input.value = fmt(input.value); err.textContent=''; });

  function jump(){
    var v = input.value.trim().toUpperCase();
    if (!RE.test(v)){ err.textContent = 'Format is XR-XXXX-XXXX \u2014 it is etched on your card.'; return; }
    try{ localStorage.setItem('xero_track_id', v); }catch(e){}
    location.href = '/pages/track';
  }
  go.addEventListener('click', jump);
  input.addEventListener('keydown', function(e){ if (e.key === 'Enter') jump(); });

  // build the globe only when the section scrolls into view
  var made = false;
  new IntersectionObserver(function(en, obs){
    if (!en.some(function(x){ return x.isIntersecting; }) || made) return;
    var tries = 0;
    (function start(){
      if (!window.XeroGlobe){ if (++tries > 100) return; return setTimeout(start, 60); }
      made = true; obs.disconnect();
      try{
        window.XeroGlobe(host, cv, {
          // Decorative arc only. These two points and the progress value are not a
          // shipment and must never be labelled as one in the markup above - see the
          // comment where the origin caption used to be.
          origin: { lat: 39.53, lon: -119.81 },
          dest:   { lat: 40.71, lon: -74.01 },
          progress: 0.62
        });
      }catch(e){}
    })();
  }, { rootMargin: '250px' }).observe(host);
})();
</script>

{% schema %}
{
  "name": "XERO tracking",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BUILT, CHECKED, DELIVERED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow it to your door." },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Your Chiron is already built. We run the final quality check, pair your ID, and bring it to you ourselves — no carriers, no depots, no freight terminal." },
    { "type": "header", "content": "Quick facts" },
    { "type": "text", "id": "f1_text", "label": "Fact 1", "default": "Free shipping" },
    { "type": "text", "id": "f2_text", "label": "Fact 2", "default": "Delivered to your door" },
    { "type": "text", "id": "f3_text", "label": "Fact 3", "default": "By our own staff" },
    { "type": "header", "content": "Fast track" },
    { "type": "text", "id": "cta", "label": "Button text", "default": "Track" },
    { "type": "text", "id": "hint", "label": "Hint", "default": "Enter the client ID etched on your steel card." }
  ],
  "presets": [{ "name": "XERO tracking" }]
}
{% endschema %}
