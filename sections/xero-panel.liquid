{%- comment -%}
  THE PANEL — image-led. No slider, no scroll x-ray, no scan lines.
  One hero image of the panel, then three facts, then two detail images.
{%- endcomment -%}

<section class="xero-night" data-sec="panel" style="position:relative;width:100%;background:var(--pg2);padding:7rem 1.4rem 6.5rem;">

  <div style="max-width:52rem;margin:0 auto;text-align:center;">
    <div style="font-size:.78rem;font-weight:600;letter-spacing:.22em;color:var(--txt3,#7c7d85);">{{ section.settings.eyebrow }}</div>
    <h2 style="margin:1rem 0 0;font-size:clamp(2.1rem,4.8vw,3.7rem);font-weight:700;letter-spacing:-.038em;line-height:1.03;color:var(--txt,#0e0e0e);text-wrap:balance;">{{ section.settings.heading }}</h2>
    {%- if section.settings.sub != blank -%}
      <p style="margin:1rem auto 0;max-width:34rem;font-size:1.06rem;line-height:1.55;color:var(--txt2,#55565c);text-wrap:pretty;">{{ section.settings.sub }}</p>
    {%- endif -%}
  </div>

  {%- comment -%} hero {%- endcomment -%}
  <div style="position:relative;width:100%;max-width:74rem;margin:2.8rem auto 0;aspect-ratio:16 / 9;overflow:hidden;border-radius:1.3rem;">
    {% render 'xero-image', key: 'pnl_hero', label: "the panel", radius: 20, circle: false %}
  </div>

  {%- comment -%} three facts {%- endcomment -%}
  <div data-m="facts" style="max-width:64rem;margin:3rem auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:2.4rem;">
    {%- for i in (1..3) -%}
      {%- assign n = i | prepend: 'f' -%}
      {%- assign tk = n | append: '_title' -%}
      {%- assign bk = n | append: '_body' -%}
      <div>
        <div style="font:600 .74rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;color:#c68bff;">0{{ i }}</div>
        <div style="margin-top:.8rem;font-size:1.18rem;font-weight:650;letter-spacing:-.026em;line-height:1.15;color:var(--txt,#0e0e0e);">{{ section.settings[tk] }}</div>
        <p style="margin:.55rem 0 0;font-size:.96rem;line-height:1.5;color:var(--txt2,#55565c);text-wrap:pretty;">{{ section.settings[bk] }}</p>
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} two details {%- endcomment -%}
  <div data-m="pair" style="max-width:74rem;margin:2.4rem auto 0;display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
    <div style="position:relative;width:100%;aspect-ratio:4 / 3;overflow:hidden;border-radius:1rem;">
      {% render 'xero-image', key: 'pnl_a', label: "detail", radius: 16, circle: false %}
    </div>
    <div style="position:relative;width:100%;aspect-ratio:4 / 3;overflow:hidden;border-radius:1rem;">
      {% render 'xero-image', key: 'pnl_b', label: "detail", radius: 16, circle: false %}
    </div>
  </div>

</section>

<style>
  @media (max-width: 760px){
    [data-sec="panel"] [data-m="facts"]{ grid-template-columns:1fr !important; gap:1.8rem !important; max-width:30rem; }
    [data-sec="panel"] [data-m="pair"]{ grid-template-columns:1fr !important; }
  }
</style>

{% schema %}
{
  "name": "XERO panel",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE PANEL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One piece of aluminium." },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "The panel is not a cover. It carries the pack, the motor mounts and the rider — and everything you touch sits on its face." },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "pnl_hero", "label": "Hero image (16:9)" },
    { "type": "image_picker", "id": "pnl_a", "label": "Detail A (4:3)" },
    { "type": "image_picker", "id": "pnl_b", "label": "Detail B (4:3)" },
    { "type": "header", "content": "Facts" },
    { "type": "text", "id": "f1_title", "label": "1 title", "default": "One casting" },
    { "type": "textarea", "id": "f1_body", "label": "1 body", "default": "Structure, not bodywork. No subframe underneath adding weight back." },
    { "type": "text", "id": "f2_title", "label": "2 title", "default": "One seam" },
    { "type": "textarea", "id": "f2_body", "label": "2 body", "default": "A single continuous LED is the running light, the charge gauge and the lock indicator. Nothing else on the bike lights up." },
    { "type": "text", "id": "f3_title", "label": "3 title", "default": "Four bolts" },
    { "type": "textarea", "id": "f3_body", "label": "3 body", "default": "One tool, about a minute. Every serviceable part on the bike is behind this panel." }
  ],
  "presets": [{ "name": "XERO panel" }]
}
{% endschema %}
