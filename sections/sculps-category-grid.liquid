<section class="sp-s" id="shop">
  <div class="sp-s-title">
    <span>{{ section.settings.heading | default: 'Shop' }}</span>
    {%- if section.settings.view_all_url != blank -%}
      <a href="{{ section.settings.view_all_url }}">{{ section.settings.view_all_label | default: 'View All →' }}</a>
    {%- endif -%}
  </div>
  <div class="sp-cat-grid">
    <a href="{{ section.settings.cat1_url | default: '/collections/intimates' }}" class="sp-cat-card sp-cat-main">
      {%- if section.settings.cat1_image %}<img src="{{ section.settings.cat1_image | image_url: width: 800 }}" alt="{{ section.settings.cat1_title | escape }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{%- else -%}<div class="sp-cat-inner sp-c1"></div>{%- endif -%}
      <div class="sp-cat-grad"></div>
      <div class="sp-cat-info">
        <div class="sp-cat-name">{{ section.settings.cat1_title | default: 'Invisible Bra Inserts' }}</div>
        <div class="sp-cat-sub">{{ section.settings.cat1_sub | default: '6 skin tones · Medical grade silicone' }}</div>
      </div>
    </a>
    <div class="sp-cat-right">
      <div class="sp-cat-row sp-cat-row-top">
        <a href="{{ section.settings.cat2_url | default: '/collections/bottoms' }}" class="sp-cat-card">
          {%- if section.settings.cat2_image %}<img src="{{ section.settings.cat2_image | image_url: width: 800 }}" alt="{{ section.settings.cat2_title | escape }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{%- else -%}<div class="sp-cat-inner sp-c2"></div>{%- endif -%}
          <div class="sp-cat-grad"></div>
          <div class="sp-cat-info">
            <div class="sp-cat-name">{{ section.settings.cat2_title | default: 'Seamless Intimates' }}</div>
            <div class="sp-cat-sub">{{ section.settings.cat2_sub | default: 'Zero lines · All tones' }}</div>
          </div>
        </a>
        <a href="{{ section.settings.cat3_url | default: '/collections/sets' }}" class="sp-cat-card">
          {%- if section.settings.cat3_image %}<img src="{{ section.settings.cat3_image | image_url: width: 800 }}" alt="{{ section.settings.cat3_title | escape }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{%- else -%}<div class="sp-cat-inner sp-c3"></div>{%- endif -%}
          <div class="sp-cat-grad"></div>
          <div class="sp-cat-info">
            <div class="sp-cat-name">{{ section.settings.cat3_title | default: 'The Sets' }}</div>
            <div class="sp-cat-sub">{{ section.settings.cat3_sub | default: '4 colorways · Drop 1' }}</div>
          </div>
        </a>
      </div>
      <div class="sp-cat-row sp-cat-row-bot">
        <a href="{{ section.settings.cat4_url | default: '/collections/accessories' }}" class="sp-cat-card">
          {%- if section.settings.cat4_image %}<img src="{{ section.settings.cat4_image | image_url: width: 800 }}" alt="{{ section.settings.cat4_title | escape }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{%- else -%}<div class="sp-cat-inner sp-c4"></div>{%- endif -%}
          <div class="sp-cat-grad"></div>
          <div class="sp-cat-info">
            <div class="sp-cat-name">{{ section.settings.cat4_title | default: 'Accessories' }}</div>
            <div class="sp-cat-sub">{{ section.settings.cat4_sub | default: 'Pouch · Socks · Scrunchie' }}</div>
          </div>
        </a>
        <a href="{{ section.settings.cat5_url | default: '/collections/kits' }}" class="sp-cat-card">
          {%- if section.settings.cat5_image %}<img src="{{ section.settings.cat5_image | image_url: width: 800 }}" alt="{{ section.settings.cat5_title | escape }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{%- else -%}<div class="sp-cat-inner sp-c5"></div>{%- endif -%}
          <div class="sp-cat-grad"></div>
          <div class="sp-cat-info">
            <div class="sp-cat-name">{{ section.settings.cat5_title | default: 'Confidence Kit' }}</div>
            <div class="sp-cat-sub">{{ section.settings.cat5_sub | default: '$120 · Save $35' }}</div>
          </div>
        </a>
        <a href="{{ section.settings.cat6_url | default: '/collections/kits' }}" class="sp-cat-card">
          {%- if section.settings.cat6_image %}<img src="{{ section.settings.cat6_image | image_url: width: 800 }}" alt="{{ section.settings.cat6_title | escape }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{%- else -%}<div class="sp-cat-inner sp-c6"></div>{%- endif -%}
          <div class="sp-cat-grad"></div>
          <div class="sp-cat-info">
            <div class="sp-cat-name">{{ section.settings.cat6_title | default: 'Girl Trip Kit' }}</div>
            <div class="sp-cat-sub">{{ section.settings.cat6_sub | default: '$120 · Save $31' }}</div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Grid",
  "settings": [
    {"type": "text", "id": "heading", "label": "Section heading", "default": "Shop"},
    {"type": "url", "id": "view_all_url", "label": "\"View All\" URL"},
    {"type": "text", "id": "view_all_label", "label": "\"View All\" text", "default": "View All →"},
    {"type": "header", "content": "Card 1 — Large Left"},
    {"type": "image_picker", "id": "cat1_image", "label": "Image"},
    {"type": "text", "id": "cat1_title", "label": "Title", "default": "Invisible Bra Inserts"},
    {"type": "text", "id": "cat1_sub", "label": "Subtitle", "default": "6 skin tones · Medical grade silicone"},
    {"type": "url", "id": "cat1_url", "label": "URL"},
    {"type": "header", "content": "Card 2"},
    {"type": "image_picker", "id": "cat2_image", "label": "Image"},
    {"type": "text", "id": "cat2_title", "label": "Title", "default": "Seamless Intimates"},
    {"type": "text", "id": "cat2_sub", "label": "Subtitle", "default": "Zero lines · All tones"},
    {"type": "url", "id": "cat2_url", "label": "URL"},
    {"type": "header", "content": "Card 3"},
    {"type": "image_picker", "id": "cat3_image", "label": "Image"},
    {"type": "text", "id": "cat3_title", "label": "Title", "default": "The Sets"},
    {"type": "text", "id": "cat3_sub", "label": "Subtitle", "default": "4 colorways · Drop 1"},
    {"type": "url", "id": "cat3_url", "label": "URL"},
    {"type": "header", "content": "Card 4"},
    {"type": "image_picker", "id": "cat4_image", "label": "Image"},
    {"type": "text", "id": "cat4_title", "label": "Title", "default": "Accessories"},
    {"type": "text", "id": "cat4_sub", "label": "Subtitle", "default": "Pouch · Socks · Scrunchie"},
    {"type": "url", "id": "cat4_url", "label": "URL"},
    {"type": "header", "content": "Card 5"},
    {"type": "image_picker", "id": "cat5_image", "label": "Image"},
    {"type": "text", "id": "cat5_title", "label": "Title", "default": "Confidence Kit"},
    {"type": "text", "id": "cat5_sub", "label": "Subtitle", "default": "$120 · Save $35"},
    {"type": "url", "id": "cat5_url", "label": "URL"},
    {"type": "header", "content": "Card 6"},
    {"type": "image_picker", "id": "cat6_image", "label": "Image"},
    {"type": "text", "id": "cat6_title", "label": "Title", "default": "Girl Trip Kit"},
    {"type": "text", "id": "cat6_sub", "label": "Subtitle", "default": "$120 · Save $31"},
    {"type": "url", "id": "cat6_url", "label": "URL"}
  ],
  "presets": [{"name": "Category Grid"}]
}
{% endschema %}
