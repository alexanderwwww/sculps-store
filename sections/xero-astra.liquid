{%- comment -%}
  ASTRA ULTIMUM - the battery section.
  Deliberately quiet: a kicker, one headline, the object, three numbers. That's it.
  No glow, no badge, no dividers, no paragraph. Everything that isn't the pack or
  a fact was removed - the clarity IS the design.
  Image resolves from Content > Files as astra_hero.png via the xero-image snippet.
{%- endcomment -%}

<section class="xero-night" data-sec="astra" id="battery" style="position:relative;width:100%;background:var(--pg);padding:7rem 0 6rem;overflow:hidden;">

  <div style="max-width:52rem;margin:0 auto;padding:0 2.06rem;text-align:center;">
    <div style="font-size:.78rem;font-weight:600;letter-spacing:.22em;color:var(--txt3,#7c7d85);">{{ section.settings.kicker }}</div>
    <h2 style="margin:1rem 0 0;font-size:clamp(2.2rem,4.8vw,3.8rem);font-weight:700;letter-spacing:-.038em;line-height:1.04;color:var(--txt,#0e0e0e);">{{ section.settings.heading }}</h2>
  </div>

  {%- comment -%} the object {%- endcomment -%}
  <div style="position:relative;width:100%;max-width:74rem;margin:2rem auto 0;aspect-ratio:16 / 9;">
    {% render 'xero-image', key: 'astra_hero', label: "ASTRA ULTIMUM battery", radius: 0, circle: false %}
  </div>

  {%- comment -%} three facts, evenly spaced, no chrome {%- endcomment -%}
  <div style="max-width:56rem;margin:2.4rem auto 0;padding:0 2.06rem;display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;">
    <div style="text-align:center;">
      <div style="font-size:clamp(1.7rem,3.4vw,2.5rem);font-weight:600;letter-spacing:-.035em;line-height:1;color:var(--txt,#0e0e0e);">{{ section.settings.stat1_value }}</div>
      <div style="margin-top:.5rem;font-size:.9rem;font-weight:400;color:var(--txt2,#55565c);">{{ section.settings.stat1_label }}</div>
    </div>
    <div style="text-align:center;">
      <div style="font-size:clamp(1.7rem,3.4vw,2.5rem);font-weight:600;letter-spacing:-.035em;line-height:1;color:var(--txt,#0e0e0e);">{{ section.settings.stat2_value }}</div>
      <div style="margin-top:.5rem;font-size:.9rem;font-weight:400;color:var(--txt2,#55565c);">{{ section.settings.stat2_label }}</div>
    </div>
    <div style="text-align:center;">
      <div style="font-size:clamp(1.7rem,3.4vw,2.5rem);font-weight:600;letter-spacing:-.035em;line-height:1;color:var(--txt,#0e0e0e);">{{ section.settings.stat3_value }}</div>
      <div style="margin-top:.5rem;font-size:.9rem;font-weight:400;color:var(--txt2,#55565c);">{{ section.settings.stat3_label }}</div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "XERO battery",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "ASTRA ULTIMUM" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A new kind of battery." },
    { "type": "image_picker", "id": "astra_hero", "label": "Battery image (cut-out PNG)" },
    { "type": "header", "content": "Numbers" },
    { "type": "text", "id": "stat1_value", "label": "Stat 1 value", "default": "8.4 kWh" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "Capacity" },
    { "type": "text", "id": "stat2_value", "label": "Stat 2 value", "default": "11 sec" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "To swap" },
    { "type": "text", "id": "stat3_value", "label": "Stat 3 value", "default": "1,500" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "Charge cycles" }
  ],
  "presets": [{ "name": "XERO battery" }]
}
{% endschema %}
