<!-- ========== MOBILE NAV OVERLAY ========== -->
<nav id="sculps-mobNav" class="sp-mob-nav" aria-label="Mobile navigation">
  <button id="sculps-mobClose" class="sp-mob-close" aria-label="Close menu">&#x2715;</button>
  <ul class="sp-mob-nav-links">
    <li><a href="/">Home</a></li>
    <li><a href="/collections/all">Shop</a></li>
    <li><a href="/collections/kits">Kits</a></li>
    <li><a href="/collections/sets">Sets</a></li>
    <li><a href="/pages/creator-studio">Creator</a></li>
  </ul>
</nav>

<!-- ========== ANNOUNCEMENT BAR ========== -->
<div class="sp-ann" aria-hidden="true">
  <div class="sp-ann-track" style="animation-duration:{{ section.settings.ann_speed | default: 30 }}s">
    {%- if section.settings.ann_msg_1 != blank %}<span>{{ section.settings.ann_msg_1 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_2 != blank %}<span>{{ section.settings.ann_msg_2 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_3 != blank %}<span>{{ section.settings.ann_msg_3 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_4 != blank %}<span>{{ section.settings.ann_msg_4 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_5 != blank %}<span>{{ section.settings.ann_msg_5 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_6 != blank %}<span>{{ section.settings.ann_msg_6 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_7 != blank %}<span>{{ section.settings.ann_msg_7 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_1 != blank %}<span>{{ section.settings.ann_msg_1 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_2 != blank %}<span>{{ section.settings.ann_msg_2 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_3 != blank %}<span>{{ section.settings.ann_msg_3 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_4 != blank %}<span>{{ section.settings.ann_msg_4 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_5 != blank %}<span>{{ section.settings.ann_msg_5 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_6 != blank %}<span>{{ section.settings.ann_msg_6 }}</span>{% endif -%}
    {%- if section.settings.ann_msg_7 != blank %}<span>{{ section.settings.ann_msg_7 }}</span>{% endif -%}
  </div>
</div>

<!-- ========== HEADER ========== -->
<header class="sp-header" id="sculps-header">
  <!-- Hamburger (mobile) -->
  <button id="sculps-hamBtn" class="sp-ham" aria-label="Open menu" aria-expanded="false" aria-controls="sculps-mobNav">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <!-- Logo -->
  <a href="/" class="sp-logo" aria-label="{{ shop.name }} home" style="display:flex;align-items:center;">
    {% if section.settings.logo %}
      {%- assign logo_h = section.settings.logo_height | default: 36 -%}
      <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="height:{{ logo_h }}px;width:auto;display:block;" loading="eager">
    {% else %}
      <span style="font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:4px;color:#1A1410;">{{ shop.name }}</span>
    {% endif %}
  </a>

  <!-- Desktop nav -->
  <nav class="sp-nav" aria-label="Main navigation">
    <ul>
      <li><a href="/collections/all">Shop</a></li>
      <li><a href="/collections/kits">Kits</a></li>
      <li><a href="/collections/sets">Sets</a></li>
      <li><a href="/pages/creator-studio">Creator</a></li>
    </ul>
  </nav>

  <!-- Right side actions -->
  <div class="sp-hdr-right">
    <!-- Search -->
    <button id="sculps-searchBtn" class="sp-hdr-icon-btn" aria-label="Search" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/>
      </svg>
    </button>
    <!-- Account -->
    <a href="/account" class="sp-hdr-icon-btn" aria-label="Account">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
      </svg>
    </a>
    <!-- Cart -->
    <button id="sculps-cartBtn" class="sp-cart-btn" aria-label="Open cart" aria-expanded="false" aria-controls="sculps-cartDrawer">
      <svg class="sp-cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <span class="sp-cart-count" id="sculps-cartCount"{% if cart.item_count == 0 %} style="display:none"{% endif %}>{{ cart.item_count }}</span>
    </button>
  </div>
</header>

<!-- Search Overlay -->
<div id="sculps-searchOverlay" class="sp-search-overlay" aria-hidden="true" role="dialog" aria-label="Search">
  <div class="sp-search-inner">
    <form action="/search" method="get" class="sp-search-form" role="search">
      <input type="hidden" name="type" value="product">
      <input
        id="sculps-searchInput"
        class="sp-search-input"
        type="search"
        name="q"
        placeholder="Search products…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="Search products"
      >
      <button type="submit" class="sp-search-submit" aria-label="Submit search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/>
        </svg>
      </button>
    </form>
    <button id="sculps-searchClose" class="sp-search-close" aria-label="Close search">&#x2715;</button>
  </div>
</div>

<style>
.sp-hdr-icon-btn{background:none;border:none;cursor:pointer;padding:6px;display:flex;align-items:center;justify-content:center;color:var(--black);text-decoration:none;transition:opacity .2s}
.sp-hdr-icon-btn:hover{opacity:.6}
.sp-hdr-right{display:flex;align-items:center;gap:4px}
.sp-search-overlay{position:fixed;inset:0;background:rgba(255,255,255,.98);z-index:500;display:flex;align-items:flex-start;justify-content:center;padding-top:120px;opacity:0;pointer-events:none;transition:opacity .25s}
.sp-search-overlay.open{opacity:1;pointer-events:all}
.sp-search-inner{width:100%;max-width:640px;padding:0 24px;position:relative}
.sp-search-form{display:flex;align-items:center;border-bottom:2px solid var(--black);padding-bottom:8px}
.sp-search-input{flex:1;font-family:inherit;font-size:clamp(24px,4vw,36px);font-weight:300;border:none;outline:none;background:transparent;color:var(--black)}
.sp-search-input::placeholder{color:rgba(0,0,0,.25)}
.sp-search-submit{background:none;border:none;cursor:pointer;padding:4px;color:var(--black)}
.sp-search-close{position:fixed;top:24px;right:28px;font-size:22px;background:none;border:none;cursor:pointer;color:var(--grey);font-family:inherit;transition:color .2s}
.sp-search-close:hover{color:var(--black)}
</style>

<script>
(function(){
  var btn    = document.getElementById('sculps-searchBtn');
  var overlay= document.getElementById('sculps-searchOverlay');
  var closeBtn = document.getElementById('sculps-searchClose');
  var input  = document.getElementById('sculps-searchInput');
  if(!btn || !overlay) return;
  function open(){overlay.classList.add('open');overlay.setAttribute('aria-hidden','false');btn.setAttribute('aria-expanded','true');if(input)setTimeout(function(){input.focus();},50);}
  function close(){overlay.classList.remove('open');overlay.setAttribute('aria-hidden','true');btn.setAttribute('aria-expanded','false');}
  btn.addEventListener('click',open);
  if(closeBtn) closeBtn.addEventListener('click',close);
  overlay.addEventListener('click',function(e){if(e.target===overlay)close();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&overlay.classList.contains('open'))close();});
})();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "text",
      "id": "ann_msg_1",
      "label": "Message 1",
      "default": "Free Shipping On Orders Over $75"
    },
    {
      "type": "text",
      "id": "ann_msg_2",
      "label": "Message 2",
      "default": "We Don’t Hire Models. We Work With Real Women."
    },
    {
      "type": "text",
      "id": "ann_msg_3",
      "label": "Message 3",
      "default": "6 Skin Tones. Finally."
    },
    {
      "type": "text",
      "id": "ann_msg_4",
      "label": "Message 4",
      "default": "Invisible Support. Visible Confidence."
    },
    {
      "type": "text",
      "id": "ann_msg_5",
      "label": "Message 5",
      "default": "30 Day Returns. No Questions Asked."
    },
    {
      "type": "text",
      "id": "ann_msg_6",
      "label": "Message 6",
      "default": "Real Women. Real Results. Real Rewards."
    },
    {
      "type": "text",
      "id": "ann_msg_7",
      "label": "Message 7",
      "default": "Made For Every Body. Every Shade. Every Size."
    },
    {
      "type": "range",
      "id": "ann_speed",
      "label": "Scroll speed (seconds)",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 30
    }
  ]
}
{% endschema %}
