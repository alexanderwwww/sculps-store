{
  "name": "XERO popup (retired)",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "This section is retired and renders nothing. The entry popup was removed at the owner's request. Remove it from the page in the section list if you want it out of the template entirely." }
  ]
}
{% endschema %}
