{%- comment -%}
  Mini bar, sticky cart, cart drawer, menu, intro screen.
  Rendered from layout/theme.liquid, once, outside the section loop.
{%- endcomment -%}
<div data-m="sticky" data-ref="stickyGlass" style="position:fixed;left:50%;bottom:1.5rem;z-index:58;display:flex;align-items:center;gap:1rem;padding:.55rem .65rem .55rem .8rem;border-radius:2rem;overflow:hidden;isolation:isolate;background:var(--stickybg,rgba(255,255,255,.18));backdrop-filter:blur(var(--stickyb,0px)) saturate(var(--stickys,1)) brightness(var(--stickybr,1));-webkit-backdrop-filter:blur(var(--stickyb,0px)) saturate(var(--stickys,1)) brightness(var(--stickybr,1));border:1px solid var(--stickyrim,rgba(255,255,255,.5));box-shadow:0 1.4rem 3.4rem var(--shadow,rgba(0,0,0,.3)),0 .1rem .3rem rgba(0,0,0,.12);transform:translate(-50%,calc((1 - var(--sticky,0)) * 160%)) scale(calc(.94 + var(--sticky,0) * .06));opacity:var(--sticky,0);pointer-events:var(--sticky-pe,none);transition:transform .5s cubic-bezier(.28,.11,.32,1),opacity .34s;">
    <span aria-hidden="true" style="position:absolute;inset:-45%;z-index:0;pointer-events:none;background:radial-gradient(closest-side,var(--liq1,rgba(255,255,255,.85)),rgba(255,255,255,0) 70%);opacity:.75;animation:xliqA 17s ease-in-out infinite;will-change:transform;"></span>
    <span aria-hidden="true" style="position:absolute;inset:-45%;z-index:0;pointer-events:none;background:radial-gradient(closest-side,var(--liq2,rgba(180,205,255,.55)),rgba(255,255,255,0) 68%);opacity:.8;animation:xliqB 23s ease-in-out infinite;will-change:transform;"></span>
    <span aria-hidden="true" style="position:absolute;inset:0;z-index:0;pointer-events:none;background:radial-gradient(22rem 9rem at var(--sx,50%) var(--sy,0%),var(--sheen,rgba(255,255,255,.88)),rgba(255,255,255,0) 68%);opacity:var(--spec,.34);transition:opacity .4s cubic-bezier(.28,.11,.32,1);"></span>
    <span aria-hidden="true" style="position:absolute;left:0;right:0;top:0;height:46%;z-index:0;pointer-events:none;background:linear-gradient(180deg,var(--sheen,rgba(255,255,255,.88)),rgba(255,255,255,0));opacity:.24;"></span>
    <span aria-hidden="true" style="position:absolute;inset:0;z-index:0;pointer-events:none;border-radius:2rem;box-shadow:inset 0 1.4px 0 var(--sheen,rgba(255,255,255,.88)),inset 1.4px 0 0 var(--glow,rgba(255,255,255,.22)),inset -1.4px 0 0 var(--glow,rgba(255,255,255,.22)),inset 0 -1.4px 0 rgba(0,0,0,.16),inset 0 0 3.4rem var(--glow,rgba(255,255,255,.22));"></span>
    <div style="position:relative;z-index:1;width:3.6rem;height:2.9rem;border-radius:.7rem;overflow:hidden;background:var(--sub,rgba(0,0,0,.045));flex:0 0 auto;">
      <img src="{{ 'bike-day.webp' | asset_url }}" alt="" width="674" height="564" loading="lazy" decoding="async" style="position:absolute;inset:6%;width:88%;height:88%;object-fit:contain;opacity:calc(1 - var(--nite,0));" />
      <img src="{{ 'bike-night.webp' | asset_url }}" alt="" width="674" height="564" loading="lazy" decoding="async" style="position:absolute;inset:6%;width:88%;height:88%;object-fit:contain;opacity:var(--nite,0);" />
    </div>
    <div style="position:relative;z-index:1;display:flex;flex-direction:column;gap:.1rem;min-width:0;">
      <span style="font-size:.98rem;font-weight:600;letter-spacing:-.02em;color:var(--txt,#0e0e0e);white-space:nowrap;"><span data-bind="selectedTitle"></span></span>
      <span style="display:flex;align-items:center;gap:.45rem;white-space:nowrap;">
        <span style="font-size:.92rem;font-weight:600;letter-spacing:-.015em;color:var(--txt,#0e0e0e);"><span data-bind="selectedPriceText"></span></span>
        {%- comment -%}
          A hardcoded "$139/mo" sat here, beside the live price, in the sticky bar that
          follows the visitor down the whole page. No lender exists behind that number and
          no instalment provider is connected, so it was a credit offer the checkout could
          not honour - the same claim that was removed from the hero and the popup, hiding
          in the one component that is on screen the entire time. Restore only when a
          provider is genuinely live, and let that provider's widget print the figure.
        {%- endcomment -%}
      </span>
    </div>
    <div style="position:relative;z-index:1;width:1px;height:2.1rem;background:var(--hair,rgba(0,0,0,.1));flex:0 0 auto;"></div>
    <button data-x="xh6 xh1" data-act="addToCart" style="position:relative;z-index:1;flex:0 0 auto;height:2.85rem;padding:0 1.4rem;border-radius:1.43rem;background:#3a82fb;color:#fff;font-size:.98rem;font-weight:600;letter-spacing:-.01em;transition:transform .3s cubic-bezier(.28,.11,.32,1);">Reserve</button>
    <button data-x="xh3 xh1" data-act="toggleCart" style="position:relative;flex:0 0 auto;width:2.85rem;height:2.85rem;border-radius:50%;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 46%,var(--glow,rgba(255,255,255,.22))),var(--pill,rgba(255,255,255,.82));border:1px solid var(--pill-b,rgba(0,0,0,.05));box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22));display:flex;align-items:center;justify-content:center;transition:transform .3s cubic-bezier(.28,.11,.32,1);" aria-label="Open cart">
      <svg width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="var(--txt,#0e0e0e)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5.6 6.2h6.8l.9 8.1H4.7l.9-8.1z"></path><path d="M6.9 6.2V4.6a2.1 2.1 0 0 1 4.2 0v1.6"></path></svg>
      <span style="position:absolute;top:-.1rem;right:-.1rem;min-width:1.15rem;height:1.15rem;padding:0 .28rem;border-radius:.6rem;background:#005df9;color:#fff;font-size:.66rem;font-weight:700;display:flex;align-items:center;justify-content:center;transform:scale(var(--badge,0));transition:transform .34s cubic-bezier(.28,.11,.32,1);"><span data-bind="cartCount"></span></span>
    </button>
  </div>

  <div data-shopify-section="xero-chrome" data-m="mini" style="position:fixed;left:0;right:0;bottom:0;z-index:60;display:none;align-items:center;gap:.8rem;padding:.72rem 1rem calc(.72rem + env(safe-area-inset-bottom));background:var(--solid,rgb(247,247,249));border-top:1px solid var(--glass-b,rgba(0,0,0,.07));transform:translateY(calc((1 - var(--mini,0)) * 110%));opacity:var(--mini,0);pointer-events:var(--mini-pe,none);transition:transform .42s cubic-bezier(.28,.11,.32,1),opacity .3s;">
    <div style="flex:1;min-width:0;">
      <div style="font-size:1rem;font-weight:600;letter-spacing:-.02em;color:var(--txt,#0e0e0e);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">XERO Chiron.</div>
      <div style="font-size:.88rem;color:var(--txt2,#55565c);"><span data-bind="selectedPriceText"></span></div>
    </div>
    <button data-act="buyNow" style="height:2.9rem;padding:0 1.5rem;border-radius:1.45rem;background:#3a82fb;color:#fff;font-size:1rem;font-weight:600;">Reserve now</button>
  </div>

  <div data-act="closeAll" style="position:fixed;inset:0;z-index:70;background:rgba(0,0,0,.34);opacity:var(--scrim,0);pointer-events:var(--scrim-pe,none);transition:opacity .36s cubic-bezier(.28,.11,.32,1);"></div>

  <aside data-screen-label="Cart" style="position:fixed;right:0;top:0;bottom:0;width:min(26rem,92vw);z-index:80;background:var(--solid,rgb(247,247,249));border-left:1px solid var(--glass-b,rgba(0,0,0,.07));box-shadow:-1rem 0 4rem rgba(0,0,0,.16);display:flex;flex-direction:column;transform:translateX(calc((1 - var(--cart,0)) * 101%));opacity:calc(.15 + var(--cart,0) * .85);pointer-events:var(--cart-pe,none);transition:transform .44s cubic-bezier(.28,.11,.32,1),opacity .3s;">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:1.4rem 1.4rem 1rem;">
      <h2 style="margin:0;font-size:1.5rem;font-weight:700;letter-spacing:-.028em;color:var(--txt,#0e0e0e);">Cart</h2>
      <button data-x="xh1" data-act="toggleCart" style="width:2.2rem;height:2.2rem;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--sub,rgba(0,0,0,.05));" aria-label="Close cart">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="var(--txt,#0e0e0e)" stroke-width="1.6" stroke-linecap="round"><path d="M4.2 4.2l7.6 7.6M11.8 4.2l-7.6 7.6"></path></svg>
      </button>
    </div>
    <div style="flex:1;overflow-y:auto;padding:0 1.4rem;">
      <div data-when="cartEmpty" hidden>
        <p style="margin:2.4rem 0;font-size:1rem;color:var(--txt2,#55565c);text-align:center;">Your cart is empty.</p>
      </div>
      <div data-list="cartLines"></div>
      <template data-tpl="cartLine">
        <div style="display:flex;gap:.9rem;padding:1rem 0;border-bottom:1px solid var(--hair,rgba(0,0,0,.07));">
          <div style="position:relative;width:5rem;height:4.2rem;border-radius:.6rem;overflow:hidden;background:var(--sub,rgba(0,0,0,.04));flex:0 0 auto;">
            <img src="{{ 'bike-day.webp' | asset_url }}" alt="" width="674" height="564" loading="lazy" decoding="async" style="position:absolute;inset:8%;width:84%;height:84%;object-fit:contain;opacity:calc(1 - var(--nite,0));" />
            <img src="{{ 'bike-night.webp' | asset_url }}" alt="" width="674" height="564" loading="lazy" decoding="async" style="position:absolute;inset:8%;width:84%;height:84%;object-fit:contain;opacity:var(--nite,0);" />
          </div>
          <div style="flex:1;min-width:0;">
            <div style="font-size:1rem;font-weight:600;letter-spacing:-.018em;color:var(--txt,#0e0e0e);"><span data-line="title"></span></div>
            <div style="margin-top:.18rem;font-size:.85rem;color:var(--txt2,#55565c);line-height:1.35;"><span data-line="sub"></span></div>
            <div style="margin-top:.55rem;display:flex;align-items:center;gap:.7rem;">
              <div style="display:flex;align-items:center;gap:.1rem;border:1px solid var(--hair,rgba(0,0,0,.12));border-radius:1rem;height:1.85rem;padding:0 .3rem;">
                <button data-line-act="dec" style="width:1.5rem;height:1.7rem;font-size:1.05rem;line-height:1;color:var(--txt,#0e0e0e);" aria-label="Decrease">&#8722;</button>
                <span style="min-width:1.2rem;text-align:center;font-size:.9rem;font-weight:600;color:var(--txt,#0e0e0e);"><span data-line="qty"></span></span>
                <button data-line-act="inc" style="width:1.5rem;height:1.7rem;font-size:1.05rem;line-height:1;color:var(--txt,#0e0e0e);" aria-label="Increase">+</button>
              </div>
              <button data-line-act="remove" style="font-size:.85rem;color:var(--txt2,#55565c);text-decoration:underline;text-underline-offset:.16em;">Remove</button>
              <span style="margin-left:auto;font-size:1rem;font-weight:600;color:var(--txt,#0e0e0e);"><span data-line="total"></span></span>
            </div>
          </div>
        </div></template>
    </div>
    <div style="padding:1.2rem 1.4rem calc(1.4rem + env(safe-area-inset-bottom));border-top:1px solid var(--hair,rgba(0,0,0,.08));">
      <div style="display:flex;justify-content:space-between;font-size:1.05rem;font-weight:600;color:var(--txt,#0e0e0e);"><span>Subtotal</span><span><span data-bind="cartTotalText"></span></span></div>
      <p style="margin:.3rem 0 .35rem;font-size:.82rem;color:var(--txt2,#55565c);">Taxes and duties calculated at checkout. Free shipping.</p>
      {%- comment -%}
        The lead time has to appear on the last screen before payment. It was stated in
        the hero and nowhere else, and buyNow() goes straight from the mini bar to
        Shopify checkout - so a buyer could reach the payment sheet having never seen
        it. Disclosing a deferred delivery only on a page the buyer may skip is the
        omission that turns a late shipment into a chargeback the merchant loses.
      {%- endcomment -%}
      <p style="margin:0 0 .95rem;font-size:.8rem;line-height:1.45;color:var(--txt2,#55565c);">The Chiron is a concept machine in development. Estimated first deliveries 4&ndash;6 weeks from order &mdash; an estimate, not a guaranteed date. Cancel any time before dispatch for a full refund.</p>
      <button data-x="xh1" data-act="buyNow" style="width:100%;height:3.3rem;border-radius:1.65rem;background:#3a82fb;color:#fff;font-size:1.08rem;font-weight:600;">Checkout</button>
    </div>
  </aside>

  {%- comment -%} Burger menu. Specs removed — the whole page is the spec sheet.
      Track your build sits in its place. {%- endcomment -%}
  <div style="position:fixed;right:2.06rem;top:5.9rem;z-index:85;width:13rem;border-radius:1rem;background:var(--solid,rgb(247,247,249));border:1px solid var(--glass-b,rgba(0,0,0,.07));box-shadow:0 .8rem 2.4rem var(--shadow,rgba(0,0,0,.14));padding:.5rem;display:flex;flex-direction:column;transform-origin:100% 0;transform:scale(calc(.94 + var(--menu,0) * .06));opacity:var(--menu,0);pointer-events:var(--menu-pe,none);transition:opacity .3s cubic-bezier(.28,.11,.32,1),transform .3s cubic-bezier(.28,.11,.32,1);">
    <a href="/#specs" data-act="goSpecs" style="padding:.66rem .8rem;border-radius:.6rem;font-size:1rem;color:var(--txt,#0e0e0e);">Specs</a>
    <a href="/pages/track" style="padding:.66rem .8rem;border-radius:.6rem;font-size:1rem;color:var(--txt,#0e0e0e);">Track your build</a>
    <a href="/pages/activate" style="padding:.66rem .8rem;border-radius:.6rem;font-size:1rem;color:var(--txt,#0e0e0e);">Activate a key</a>
    <button data-act="toggleCart" style="padding:.66rem .8rem;border-radius:.6rem;font-size:1rem;text-align:left;color:var(--txt,#0e0e0e);">Cart</button>
  </div>

  <div data-m="splash" hidden style="display:none !important;">
    <button data-act="skipSplash" hidden style="display:none !important;">Skip</button>
  </div>

{% schema %}
{ "name": "XERO chrome", "settings": [] }
{% endschema %}
