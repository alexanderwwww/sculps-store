    <div style="position:relative;height:3.13rem;border-radius:1.57rem;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 46%,var(--glow,rgba(255,255,255,.22))),var(--pill,rgba(255,255,255,.82));border:1px solid var(--pill-b,rgba(0,0,0,.05));box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22)),0 .22rem 1.1rem var(--shadow,rgba(0,0,0,.09));display:flex;padding:.28rem;align-items:center;">
      <div style="position:absolute;left:.28rem;top:.28rem;bottom:.28rem;width:calc(50% - .28rem);border-radius:1.3rem;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 46%,var(--glow,rgba(255,255,255,.22))),var(--knob,#fff);box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22)),0 .14rem .5rem var(--shadow,rgba(0,0,0,.16));transform:translateX(calc(var(--seg-mode,0) * 100%));transition:transform .6s cubic-bezier(.28,.11,.32,1);"></div>
      <button data-act="setDay" style="position:relative;width:7.4rem;display:flex;align-items:center;justify-content:center;gap:.55rem;z-index:1;">
        <svg width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="var(--txt2,#55565c)" stroke-width="1.5" stroke-linecap="round"><circle cx="9" cy="9" r="3.3" fill="var(--txt2,#55565c)" stroke="none"></circle><circle cx="9" cy="9" r="6.4" stroke-dasharray="0.6 4.05"></circle></svg>
        <span style="font-size:1.02rem;font-weight:600;letter-spacing:.02em;color:var(--txt,#0e0e0e);">DAY</span>
      </button>
      <button data-act="setNight" style="position:relative;width:7.4rem;display:flex;align-items:center;justify-content:center;gap:.55rem;z-index:1;">
        <span style="font-size:1.02rem;font-weight:600;letter-spacing:.02em;color:var(--txt,#0e0e0e);">NIGHT</span>
        <svg width="17" height="17" viewBox="0 0 18 18" fill="var(--txt2,#55565c)"><path d="M15.1 11.2A6.6 6.6 0 0 1 6.8 2.9a6.9 6.9 0 1 0 8.3 8.3z"></path></svg>
      </button>
    </div>


  </div>

  <div data-m="side" style="position:absolute;left:3.3%;top:50%;margin-top:-5.6rem;z-index:30;display:flex;flex-direction:column;gap:.9rem;">
    <button data-x="xh3 xh1" data-act="prevAngle" style="width:3.56rem;height:3.56rem;border-radius:50%;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 46%,var(--glow,rgba(255,255,255,.22))),var(--pill,rgba(255,255,255,.82));border:1px solid var(--pill-b,rgba(0,0,0,.05));display:flex;align-items:center;justify-content:center;box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22)),0 .2rem 1rem var(--shadow,rgba(0,0,0,.10));transition:transform .3s cubic-bezier(.28,.11,.32,1);" aria-label="Previous angle">
      <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="var(--txt,#0e0e0e)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="12.2 4.4 6.6 10 12.2 15.6"></polyline></svg>
    </button>
    <button data-x="xh3 xh1" data-act="resetView" style="width:3.56rem;height:3.56rem;border-radius:50%;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 46%,var(--glow,rgba(255,255,255,.22))),var(--pill,rgba(255,255,255,.82));border:1px solid var(--pill-b,rgba(0,0,0,.05));display:flex;align-items:center;justify-content:center;box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22)),0 .2rem 1rem var(--shadow,rgba(0,0,0,.10));transition:transform .3s cubic-bezier(.28,.11,.32,1);" aria-label="Reset view">
      <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="var(--txt,#0e0e0e)" stroke-width="1.8" stroke-linecap="round"><path d="M5.4 5.4l9.2 9.2M14.6 5.4l-9.2 9.2"></path></svg>
    </button>
    <button data-x="xh3 xh1" data-act="toggleSpin" style="width:3.56rem;height:3.56rem;border-radius:50%;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 46%,var(--glow,rgba(255,255,255,.22))),var(--spinbg,rgba(255,255,255,.82));border:1px solid var(--spinbd,rgba(0,0,0,.05));display:flex;align-items:center;justify-content:center;box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22)),0 .2rem 1rem var(--shadow,rgba(0,0,0,.10));transition:transform .3s cubic-bezier(.28,.11,.32,1),background .35s,border-color .35s;" aria-label="Auto-spin">
      <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="var(--spinfg,#0e0e0e)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16.4 10a6.4 6.4 0 1 1-1.9-4.5"></path><polyline points="16.6 2.6 16.6 6.2 13 6.2"></polyline></svg>
    </button>
    <button data-x="xh3 xh1" data-act="nextAngle" style="width:3.56rem;height:3.56rem;border-radius:50%;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 46%,var(--glow,rgba(255,255,255,.22))),var(--pill,rgba(255,255,255,.82));border:1px solid var(--pill-b,rgba(0,0,0,.05));display:flex;align-items:center;justify-content:center;box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22)),0 .2rem 1rem var(--shadow,rgba(0,0,0,.10));transition:transform .3s cubic-bezier(.28,.11,.32,1);" aria-label="Next angle">
      <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="var(--txt,#0e0e0e)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="7.8 4.4 13.4 10 7.8 15.6"></polyline></svg>
    </button>
  </div>

  <aside data-m="buy" data-screen-label="Buy box" style="position:absolute;left:68%;right:2%;top:9%;bottom:8.5%;z-index:35;border-radius:1.62rem;background:var(--glass,rgba(245,245,247,.9));backdrop-filter:blur(14px) saturate(1.7);border:1px solid var(--glass-b,rgba(0,0,0,.055));box-shadow:0 1.2rem 3.6rem var(--shadow,rgba(0,0,0,.10));padding:1.5rem 1.5rem 1.2rem;display:flex;flex-direction:column;overflow-y:auto;scrollbar-width:none;">
    <h1 style="margin:0;font-size:2.94rem;font-weight:700;letter-spacing:-.032em;line-height:1.02;color:var(--txt,#0e0e0e);">{{ product.title | default: section.settings.title }}</h1>
    <p style="margin:.52rem 0 0;font-size:1.31rem;font-weight:400;letter-spacing:-.015em;color:var(--txt2,#55565c);">{{ section.settings.subtitle }}</p>

    {%- comment -%}
      A hardcoded 4.5-star rating, a "42 reviews" link and an "In stock" pip used to sit
      here. All three were untrue and all three are the kind of thing a payment
      underwriter opens the page specifically to look for: a store with no orders
      showing an aggregate rating is fabricated social proof, and asserting on-hand
      inventory of a machine that is built to order invites a demand for a supplier
      invoice you cannot produce. The review link was also dead - the reviews section
      is no longer on any template. Do not restore any of it without real orders and
      real reviews behind it.
    {%- endcomment -%}
    <p style="margin:.9rem 0 0;font-size:.94rem;color:var(--txt2,#55565c);">{{ section.settings.ships_in }}</p>

    <div data-ref="priceRef" style="margin-top:.85rem;flex:0 0 auto;display:flex;align-items:flex-start;font-size:2.75rem;font-weight:700;letter-spacing:-.035em;line-height:1;color:var(--txt,#0e0e0e);">
      <span>$</span>
      <span style="display:inline-block;height:1em;overflow:hidden;"><span style="display:block;transform:translateY(calc(var(--d0,4) * -1em));transition:transform .55s cubic-bezier(.28,.11,.32,1);"><span style="display:block;height:1em;">0</span><span style="display:block;height:1em;">1</span><span style="display:block;height:1em;">2</span><span style="display:block;height:1em;">3</span><span style="display:block;height:1em;">4</span><span style="display:block;height:1em;">5</span><span style="display:block;height:1em;">6</span><span style="display:block;height:1em;">7</span><span style="display:block;height:1em;">8</span><span style="display:block;height:1em;">9</span></span></span>
      <span>,</span>
      <span style="display:inline-block;height:1em;overflow:hidden;"><span style="display:block;transform:translateY(calc(var(--d1,9) * -1em));transition:transform .55s cubic-bezier(.28,.11,.32,1);transition-delay:.03s;"><span style="display:block;height:1em;">0</span><span style="display:block;height:1em;">1</span><span style="display:block;height:1em;">2</span><span style="display:block;height:1em;">3</span><span style="display:block;height:1em;">4</span><span style="display:block;height:1em;">5</span><span style="display:block;height:1em;">6</span><span style="display:block;height:1em;">7</span><span style="display:block;height:1em;">8</span><span style="display:block;height:1em;">9</span></span></span>
      <span style="display:inline-block;height:1em;overflow:hidden;"><span style="display:block;transform:translateY(calc(var(--d2,9) * -1em));transition:transform .55s cubic-bezier(.28,.11,.32,1);transition-delay:.06s;"><span style="display:block;height:1em;">0</span><span style="display:block;height:1em;">1</span><span style="display:block;height:1em;">2</span><span style="display:block;height:1em;">3</span><span style="display:block;height:1em;">4</span><span style="display:block;height:1em;">5</span><span style="display:block;height:1em;">6</span><span style="display:block;height:1em;">7</span><span style="display:block;height:1em;">8</span><span style="display:block;height:1em;">9</span></span></span>
      <span style="display:inline-block;height:1em;overflow:hidden;"><span style="display:block;transform:translateY(calc(var(--d3,9) * -1em));transition:transform .55s cubic-bezier(.28,.11,.32,1);transition-delay:.09s;"><span style="display:block;height:1em;">0</span><span style="display:block;height:1em;">1</span><span style="display:block;height:1em;">2</span><span style="display:block;height:1em;">3</span><span style="display:block;height:1em;">4</span><span style="display:block;height:1em;">5</span><span style="display:block;height:1em;">6</span><span style="display:block;height:1em;">7</span><span style="display:block;height:1em;">8</span><span style="display:block;height:1em;">9</span></span></span>
    </div>
    <div style="margin-top:.5rem;display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;">
      <span style="display:inline-flex;align-items:center;gap:.4rem;height:1.85rem;padding:0 .7rem;border-radius:.93rem;background:rgba(58,130,251,.12);font-size:.88rem;font-weight:600;letter-spacing:-.01em;color:#005df9;">or $139/mo</span>
      <span style="font-size:.88rem;color:var(--txt2,#55565c);">36 months · 0% APR · no deposit</span>
    </div>

    <div style="margin-top:1.05rem;flex:0 0 auto;display:flex;align-items:baseline;justify-content:space-between;">
      <span style="font-size:.82rem;font-weight:600;letter-spacing:.055em;color:var(--txt2,#55565c);">CHOOSE YOUR BUNDLE</span>
    </div>
    <div style="margin-top:.5rem;flex:0 0 auto;display:flex;flex-direction:column;gap:.55rem;">
      <button data-x="xh4" data-act="pickVariant0" style="display:flex;align-items:center;gap:.9rem;height:4.4rem;padding:0 1.15rem;border-radius:1rem;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 46%,var(--glow,rgba(255,255,255,.22))),var(--vbg0,rgba(255,255,255,.6));border:1.8px solid var(--vb0,#005df9);box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88));text-align:left;transition:border-color .35s,background .35s,transform .3s cubic-bezier(.28,.11,.32,1);">
        <span style="flex:0 0 auto;width:1.32rem;height:1.32rem;border-radius:50%;border:1.8px solid var(--vr0,#005df9);display:flex;align-items:center;justify-content:center;transition:border-color .35s;"><span style="width:.66rem;height:.66rem;border-radius:50%;background:var(--vd0,#005df9);transition:background .35s,transform .3s cubic-bezier(.28,.11,.32,1);transform:scale(var(--vs0,1));"></span></span>
        <span style="flex:1;display:flex;flex-direction:column;gap:.14rem;">
          <span style="font-size:1.14rem;font-weight:600;letter-spacing:-.02em;color:var(--txt,#0e0e0e);">Chiron</span>
          <span style="font-size:.82rem;color:var(--txt2,#55565c);">The standard bike</span>
        </span>
        <span style="font-size:1.14rem;font-weight:600;letter-spacing:-.02em;color:var(--vp0,#005df9);transition:color .35s;">$4,999</span>
      </button>
      <button data-x="xh4" data-act="pickVariant1" style="display:flex;align-items:center;gap:.9rem;height:4.4rem;padding:0 1.15rem;border-radius:1rem;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 46%,var(--glow,rgba(255,255,255,.22))),var(--vbg1,rgba(255,255,255,.6));border:1.8px solid var(--vb1,rgba(0,0,0,.06));box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88));text-align:left;transition:border-color .35s,background .35s,transform .3s cubic-bezier(.28,.11,.32,1);">
        <span style="flex:0 0 auto;width:1.32rem;height:1.32rem;border-radius:50%;border:1.8px solid var(--vr1,#c3c4c9);display:flex;align-items:center;justify-content:center;transition:border-color .35s;"><span style="width:.66rem;height:.66rem;border-radius:50%;background:var(--vd1,transparent);transition:background .35s,transform .3s cubic-bezier(.28,.11,.32,1);transform:scale(var(--vs1,0));"></span></span>
        <span style="flex:1;display:flex;flex-direction:column;gap:.14rem;">
          <span style="font-size:1.14rem;font-weight:600;letter-spacing:-.02em;color:var(--txt,#0e0e0e);">Chiron + 10-Year Replacement</span>
          <span style="font-size:.82rem;color:var(--txt2,#55565c);">We replace the whole bike. For ten years.</span>
        </span>
        <span style="display:flex;flex-direction:column;align-items:flex-end;line-height:1.2;">
          <span style="font-size:1.14rem;font-weight:600;letter-spacing:-.02em;color:var(--vp1,var(--txt,#0e0e0e));transition:color .35s;">$6,998.99</span>
          <span style="font-size:.82rem;font-weight:500;color:var(--txt2,#55565c);">+ $1,999.99</span>
        </span>
      </button>
    </div>

    <div style="margin-top:.85rem;flex:0 0 auto;font-size:.82rem;font-weight:600;letter-spacing:.055em;color:var(--txt2,#55565c);">ADD-ONS</div>
    <div style="margin-top:.42rem;flex:0 0 auto;border-radius:.72rem;background:var(--sub,rgba(255,255,255,.44));border:1px solid var(--glass-b,rgba(0,0,0,.05));overflow:hidden;">
      <button data-act="toggleKey" style="display:flex;align-items:center;width:100%;height:2.62rem;padding:0 .95rem;gap:.75rem;">
        <span style="position:relative;flex:0 0 auto;width:2.3rem;height:2.3rem;border-radius:.55rem;overflow:hidden;background:var(--sub,rgba(255,255,255,.05));border:1px solid var(--hair,rgba(255,255,255,.085));">{% render 'xero-image', key: 'addon_key_img', label: "", radius: 8, circle: false %}</span>
        <span style="flex:1;text-align:left;font-size:.88rem;font-weight:450;color:var(--txt,#0e0e0e);">Spare wireless key (NFC pebble)</span>
        <span style="font-size:.88rem;color:var(--txt2,#55565c);">+ $99</span>
        <span style="position:relative;width:2.5rem;height:1.5rem;border-radius:.75rem;background:var(--sw0,rgba(120,120,128,.22));transition:background .34s cubic-bezier(.28,.11,.32,1);">
          <span style="position:absolute;top:.12rem;left:.12rem;width:1.26rem;height:1.26rem;border-radius:50%;background:#fff;box-shadow:0 .08rem .26rem rgba(0,0,0,.2);transform:translateX(calc(var(--swx0,0) * 1rem));transition:transform .34s cubic-bezier(.28,.11,.32,1);"></span>
        </span>
      </button>
    </div>

    <div style="margin-top:1rem;flex:0 0 auto;display:flex;flex-direction:column;gap:.55rem;">
      {%- comment -%}
        Shopify's own accelerated checkout button. It renders the real, Apple-licensed
        Apple Pay mark (or Google Pay / Shop Pay, whichever the shopper supports) and
        hides itself entirely where none apply. Never hand-draw the Apple Pay mark.
        Its interior styling is owned by Shopify; only the wrapper is ours.
      {%- endcomment -%}
      <div data-m="paybtn" style="min-height:3.25rem;pointer-events:var(--xpay-pe,auto);transition:opacity .35s cubic-bezier(.28,.11,.32,1);">
        {%- form 'product', product, id: 'xero-buy', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-ref="payVariant">
          {{ form | payment_button }}
        {%- endform -%}
      </div>
      {%- comment -%}
        Express checkout posts one variant, so it cannot represent a basket that also has
        add-ons in it. Rather than silently drop them, the button steps aside and says why.
      {%- endcomment -%}
      <p data-ref="payNote" hidden style="margin:.55rem 0 0;text-align:center;font-size:.82rem;line-height:1.4;color:var(--txt2,#55565c);">Express checkout covers the bike only &mdash; use Buy now to include your add-ons.</p>
      <button data-x="xh1" data-act="buyNow" style="height:3.25rem;border-radius:1.63rem;background:#3a82fb;color:#fff;font-size:1.1rem;font-weight:600;letter-spacing:-.01em;transition:transform .3s cubic-bezier(.28,.11,.32,1);">Buy now</button>
      <button data-x="xh1" data-act="addToCart" data-ref="addBtnRef" style="height:3.25rem;border-radius:1.63rem;background:transparent;border:1.6px solid #005df9;color:#005df9;font-size:1.1rem;font-weight:600;letter-spacing:-.01em;transition:transform .3s cubic-bezier(.28,.11,.32,1);">Add to cart</button>
      <div style="margin-top:.85rem;display:flex;flex-direction:column;gap:.5rem;align-items:center;">
        <span style="font-size:.88rem;color:var(--txt2,#55565c);">Pay over time from <strong style="font-weight:600;color:#005df9;">$139/mo</strong></span>
        <div style="display:flex;flex-wrap:wrap;gap:.4rem;justify-content:center;">
          <span style="display:inline-flex;align-items:center;height:1.7rem;padding:0 .62rem;border-radius:.42rem;background:var(--sub,rgba(255,255,255,.5));border:1px solid var(--hair,rgba(0,0,0,.08));font-size:.72rem;font-weight:700;letter-spacing:.005em;color:var(--txt2,#55565c);white-space:nowrap;">Affirm</span>
          <span style="display:inline-flex;align-items:center;height:1.7rem;padding:0 .62rem;border-radius:.42rem;background:var(--sub,rgba(255,255,255,.5));border:1px solid var(--hair,rgba(0,0,0,.08));font-size:.72rem;font-weight:700;letter-spacing:.005em;color:var(--txt2,#55565c);white-space:nowrap;">Klarna</span>
          <span style="display:inline-flex;align-items:center;height:1.7rem;padding:0 .62rem;border-radius:.42rem;background:var(--sub,rgba(255,255,255,.5));border:1px solid var(--hair,rgba(0,0,0,.08));font-size:.72rem;font-weight:700;letter-spacing:.005em;color:var(--txt2,#55565c);white-space:nowrap;">Shop Pay</span>
          <span style="display:inline-flex;align-items:center;height:1.7rem;padding:0 .62rem;border-radius:.42rem;background:var(--sub,rgba(255,255,255,.5));border:1px solid var(--hair,rgba(0,0,0,.08));font-size:.72rem;font-weight:700;letter-spacing:.005em;color:var(--txt2,#55565c);white-space:nowrap;">Afterpay</span>
        </div>
      </div>
    </div>

    <div style="margin-top:auto;flex:0 0 auto;padding-top:.95rem;display:flex;align-items:center;justify-content:space-between;gap:.6rem;font-size:.78rem;color:var(--txt2,#55565c);">
      <span style="display:inline-flex;align-items:center;gap:.38rem;"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="var(--txt2,#55565c)" stroke-width="1.25" stroke-linecap="round"><path d="M13.6 8a5.6 5.6 0 1 1-1.7-4"></path><path d="M13.4 1.8v2.6h-2.6"></path></svg>Fully refundable</span>
      <span style="display:inline-flex;align-items:center;gap:.38rem;"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="var(--txt2,#55565c)" stroke-width="1.25" stroke-linejoin="round"><path d="M8 1.6 13.6 3.9v3.9c0 3-2.3 5.2-5.6 6.6-3.3-1.4-5.6-3.6-5.6-6.6V3.9z"></path></svg>2-year warranty</span>
      <span style="display:inline-flex;align-items:center;gap:.38rem;"><svg width="15" height="15" viewBox="0 0 18 16" fill="none" stroke="var(--txt2,#55565c)" stroke-width="1.25" stroke-linejoin="round"><rect x="1" y="3.4" width="9.2" height="7.2" rx="1"></rect><path d="M10.2 5.8h3l2.2 2.4v2.4h-5.2z"></path><circle cx="5" cy="12.4" r="1.4"></circle><circle cx="12.6" cy="12.4" r="1.4"></circle></svg>Free shipping</span>
    </div>
  </aside>
  

</section>

{% schema %}
{
  "name": "XERO product stage",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Bike" },
    { "type": "product", "id": "addon_key", "label": "Add-on — spare wireless key" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "title", "label": "Title", "default": "XERO Chiron." },
