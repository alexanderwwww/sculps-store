        <div style="position:absolute;inset:0;opacity:var(--ph4,0);transform:scale(calc(.985 + var(--ph4,0) * .015));transition:opacity .5s cubic-bezier(.28,.11,.32,1),transform .6s cubic-bezier(.28,.11,.32,1);">{% render 'xero-image', key: 'stage_ph_4', label: "rear", radius: 20, circle: false %}</div>
