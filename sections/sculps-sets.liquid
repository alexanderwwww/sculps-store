{% comment %} SCULPS Sets Collection Page {% endcomment %}
<style>
/* Sets banner */
.sp-sets-banner{position:relative;height:320px;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:var(--black)}
.sp-sets-banner-bg{position:absolute;inset:0;object-fit:cover;width:100%;height:100%;opacity:.4}
.sp-sets-banner-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(56px,12vw,100px);color:var(--white);letter-spacing:4px;line-height:1;position:relative;z-index:2}
.sp-sets-banner-sub{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.6);position:relative;z-index:2;margin-top:8px}

/* Color filter */
.sp-sets-filter{display:flex;gap:8px;flex-wrap:wrap;padding:20px 48px;border-bottom:1px solid var(--border)}
.sp-sets-pill{padding:8px 18px;border-radius:999px;border:1.5px solid var(--black);background:none;font-family:inherit;font-size:11px;font-weight:700;cursor:pointer;transition:all .2s;white-space:nowrap;color:var(--black)}
.sp-sets-pill.active,.sp-sets-pill:hover{background:var(--black);color:var(--white)}

/* Product grid */
.sp-sets-grid-wrap{padding:40px 48px 60px}
.sp-sets-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:32px}
.sp-sets-card{display:flex;flex-direction:column}
.sp-sets-card.sp-hidden{display:none}
.sp-sets-card-img{aspect-ratio:3/4;overflow:hidden;background:var(--cream);margin-bottom:14px;display:block}
.sp-sets-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.sp-sets-card:hover .sp-sets-card-img img{transform:scale(1.03)}
.sp-sets-card-brand{font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--grey);margin-bottom:4px}
.sp-sets-card-name{font-size:14px;font-weight:600;margin-bottom:8px;line-height:1.3;color:var(--black);text-decoration:none;display:block}
.sp-sets-card-prices{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.sp-sets-card-price{font-size:16px;font-weight:900}
.sp-sets-card-compare{font-size:12px;color:var(--grey);text-decoration:line-through}
.sp-sets-card-circles{display:flex;gap:6px;margin-bottom:12px}
.sp-sets-card-circle{width:20px;height:20px;border-radius:50%;border:1.5px solid rgba(0,0,0,.1);cursor:pointer;transition:transform .15s,box-shadow .15s;padding:0;flex-shrink:0}
.sp-sets-card-circle:hover,.sp-sets-card-circle.active{transform:scale(1.15);box-shadow:0 0 0 2px var(--black)}
.sp-sets-size-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.sp-sets-size-btn{width:36px;height:36px;border:1.5px solid var(--border);background:none;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center}
.sp-sets-size-btn:hover{border-color:var(--black)}
.sp-sets-size-btn.active{background:var(--black);color:var(--white);border-color:var(--black)}
.sp-sets-atc-btn{width:100%;padding:13px;background:none;color:var(--black);border:1.5px solid var(--black);font-family:inherit;font-size:10px;font-weight:900;letter-spacing:2.5px;text-transform:uppercase;cursor:pointer;transition:all .2s;margin-top:auto}
.sp-sets-atc-btn:hover{background:var(--black);color:var(--white)}

/* Manifesto strip */
.sp-sets-manifesto{background:var(--black);padding:72px 60px;text-align:center}
.sp-sets-manifesto-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(36px,6vw,64px);color:var(--white);letter-spacing:3px;line-height:1.1;margin-bottom:28px}
.sp-sets-manifesto-btn{display:inline-block;border:2px solid var(--white);color:var(--white);font-size:10px;font-weight:900;letter-spacing:3px;text-transform:uppercase;padding:14px 32px;text-decoration:none;transition:all .2s}
.sp-sets-manifesto-btn:hover{background:var(--white);color:var(--black)}

@media(max-width:768px){
  .sp-sets-filter{padding:16px 20px}
  .sp-sets-grid-wrap{padding:28px 20px 48px}
  .sp-sets-manifesto{padding:48px 24px}
  .sp-sets-banner{height:240px}
}
</style>

{%- for block in section.blocks -%}
  {%- case block.type -%}

    {%- when 'collection_banner' -%}
      <div class="sp-sets-banner" {{ block.shopify_attributes }}>
        {%- if block.settings.banner_image -%}
          <img class="sp-sets-banner-bg" src="{{ block.settings.banner_image | image_url: width: 1600 }}" alt="" loading="eager">
        {%- endif -%}
        <div class="sp-sets-banner-h">{{ block.settings.heading | default: 'THE SETS' }}</div>
        {%- if block.settings.subheading != blank -%}
          <div class="sp-sets-banner-sub">{{ block.settings.subheading }}</div>
        {%- endif -%}
      </div>

    {%- when 'color_filter' -%}
      <div class="sp-sets-filter" id="sp-sets-filter" {{ block.shopify_attributes }}>
        <button class="sp-sets-pill active" data-color="all" type="button">All</button>
        <button class="sp-sets-pill" data-color="Baby Pink" type="button">Baby Pink</button>
        <button class="sp-sets-pill" data-color="Sage Green" type="button">Sage Green</button>
        <button class="sp-sets-pill" data-color="Lavender" type="button">Lavender</button>
        <button class="sp-sets-pill" data-color="Steel Blue Grey" type="button">Steel Blue Grey</button>
      </div>

    {%- when 'product_grid' -%}
      <script>window.sculpsSetVars = window.sculpsSetVars || {};</script>
      {%- assign color_swatches = 'Baby Pink:#F5B8C4,Sage Green:#9BAF8A,Lavender:#C9B8E8,Steel Blue Grey:#7B9AB5' | split: ',' -%}
      <div class="sp-sets-grid-wrap" {{ block.shopify_attributes }}>
        <div class="sp-sets-grid" id="sp-sets-grid">
          {%- for product in collection.products -%}
            {%- comment -%}Find color and size options{%- endcomment -%}
            {%- assign color_opt = null -%}
            {%- assign size_opt = null -%}
            {%- for opt in product.options_with_values -%}
              {%- if opt.name == 'Color' -%}{%- assign color_opt = opt -%}{%- endif -%}
              {%- if opt.name == 'Size' -%}{%- assign size_opt = opt -%}{%- endif -%}
            {%- endfor -%}
            {%- comment -%}Build data-colors for filter{%- endcomment -%}
            {%- if color_opt -%}
              {%- assign product_colors = color_opt.values | join: '|' -%}
            {%- else -%}
              {%- assign product_colors = 'all' -%}
            {%- endif -%}
            {%- comment -%}Output variant data{%- endcomment -%}
            <script>window.sculpsSetVars['{{ product.id }}'] = {{ product.variants | json }};</script>
            <div class="sp-sets-card"
              id="sets-card-{{ product.id }}"
              data-product-id="{{ product.id }}"
              data-colors="{{ product_colors }}"
              data-selected-color="{%- if color_opt -%}{{ color_opt.values | first }}{%- endif -%}"
              data-selected-size="{%- if size_opt -%}{{ size_opt.values | first }}{%- endif -%}">
              <a href="{{ product.url }}" class="sp-sets-card-img" id="img-wrap-{{ product.id }}">
                {%- if product.featured_image -%}
                  <img id="img-{{ product.id }}"
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.title | escape }}" loading="lazy">
                {%- else -%}
                  <div style="width:100%;height:100%;background:var(--cream)"></div>
                {%- endif -%}
              </a>
              <div class="sp-sets-card-brand">SCULPS</div>
              <a href="{{ product.url }}" class="sp-sets-card-name">{{ product.title }}</a>
              <div class="sp-sets-card-prices">
                <span class="sp-sets-card-price" id="price-{{ product.id }}">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="sp-sets-card-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
              {%- if color_opt -%}
                <div class="sp-sets-card-circles">
                  {%- for val in color_opt.values -%}
                    {%- assign swatch_color = '' -%}
                    {%- if val == 'Baby Pink' -%}{%- assign swatch_color = '#F5B8C4' -%}
                    {%- elsif val == 'Sage Green' -%}{%- assign swatch_color = '#9BAF8A' -%}
                    {%- elsif val == 'Lavender' -%}{%- assign swatch_color = '#C9B8E8' -%}
                    {%- elsif val == 'Steel Blue Grey' -%}{%- assign swatch_color = '#7B9AB5' -%}
                    {%- else -%}{%- assign swatch_color = '#ccc' -%}
                    {%- endif -%}
                    <button class="sp-sets-card-circle{%- if forloop.first %} active{%- endif -%}"
                      style="background:{{ swatch_color }}"
                      data-product-id="{{ product.id }}"
                      data-color="{{ val }}"
                      type="button"
                      aria-label="{{ val }}"></button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              {%- if size_opt -%}
                <div class="sp-sets-size-row">
                  {%- for val in size_opt.values -%}
                    <button class="sp-sets-size-btn{%- if forloop.first %} active{%- endif -%}"
                      data-product-id="{{ product.id }}"
                      data-size="{{ val }}"
                      type="button">{{ forloop.index }}</button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <button class="sp-sets-atc-btn"
                data-product-id="{{ product.id }}"
                data-variant-id="{{ product.first_available_variant.id }}"
                type="button">ADD TO CART</button>
            </div>
          {%- endfor -%}
        </div>
      </div>

    {%- when 'manifesto_strip' -%}
      <div class="sp-sets-manifesto" {{ block.shopify_attributes }}>
        <div class="sp-sets-manifesto-h">{{ block.settings.heading | default: "WE DON'T HIRE MODELS. WE WORK WITH REAL WOMEN." }}</div>
        <a href="{{ block.settings.button_url | default: '/pages/creator-studio' }}" class="sp-sets-manifesto-btn">{{ block.settings.button_label | default: 'JOIN CREATOR STUDIO' }}</a>
      </div>

  {%- endcase -%}
{%- endfor -%}

<script>
(function(){
  // Color filter pills
  var pills = document.querySelectorAll('.sp-sets-pill');
  var cards = document.querySelectorAll('.sp-sets-card');
  pills.forEach(function(pill){
    pill.addEventListener('click', function(){
      var color = pill.getAttribute('data-color');
      pills.forEach(function(p){ p.classList.remove('active'); });
      pill.classList.add('active');
      cards.forEach(function(card){
        if(color === 'all'){
          card.classList.remove('sp-hidden');
        } else {
          var colors = (card.getAttribute('data-colors') || '').split('|').map(function(c){ return c.trim(); });
          card.classList.toggle('sp-hidden', colors.indexOf(color) === -1);
        }
      });
    });
  });

  // Color swatch circles
  document.addEventListener('click', function(e){
    var circle = e.target.closest('.sp-sets-card-circle');
    if(circle){
      var pid = circle.getAttribute('data-product-id');
      var color = circle.getAttribute('data-color');
      var card = document.getElementById('sets-card-' + pid);
      if(!card) return;
      card.setAttribute('data-selected-color', color);
      card.querySelectorAll('.sp-sets-card-circle').forEach(function(c){ c.classList.remove('active'); });
      circle.classList.add('active');
      // Find first variant matching color
      var vars = window.sculpsSetVars && window.sculpsSetVars[pid];
      if(vars){
        var size = card.getAttribute('data-selected-size');
        var variant = vars.find(function(v){ return v.options.indexOf(color) > -1 && (!size || v.options.indexOf(size) > -1); });
        if(!variant) variant = vars.find(function(v){ return v.options.indexOf(color) > -1; });
        if(variant){
          var atcBtn = card.querySelector('.sp-sets-atc-btn');
          if(atcBtn) atcBtn.setAttribute('data-variant-id', variant.id);
          var img = document.getElementById('img-' + pid);
          if(img && variant.featured_image){ img.style.opacity='0'; setTimeout(function(){ img.src = variant.featured_image.src; img.style.opacity='1'; }, 150); }
        }
      }
    }
  });

  // Size buttons
  document.addEventListener('click', function(e){
    var sizeBtn = e.target.closest('.sp-sets-size-btn');
    if(sizeBtn){
      var pid = sizeBtn.getAttribute('data-product-id');
      var size = sizeBtn.getAttribute('data-size');
      var card = document.getElementById('sets-card-' + pid);
      if(!card) return;
      card.setAttribute('data-selected-size', size);
      card.querySelectorAll('.sp-sets-size-btn').forEach(function(b){ b.classList.remove('active'); });
      sizeBtn.classList.add('active');
      var vars = window.sculpsSetVars && window.sculpsSetVars[pid];
      if(vars){
        var color = card.getAttribute('data-selected-color');
        var variant = vars.find(function(v){ return (!color || v.options.indexOf(color) > -1) && v.options.indexOf(size) > -1; });
        if(variant){
          var atcBtn = card.querySelector('.sp-sets-atc-btn');
          if(atcBtn) atcBtn.setAttribute('data-variant-id', variant.id);
        }
      }
    }
  });

  // ATC buttons
  document.addEventListener('click', function(e){
    var atcBtn = e.target.closest('.sp-sets-atc-btn');
    if(atcBtn){
      var variantId = atcBtn.getAttribute('data-variant-id');
      if(!variantId) return;
      atcBtn.textContent = 'ADDING...';
      atcBtn.disabled = true;
      fetch('/cart/add.js', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({id: variantId, quantity: 1})
      }).then(function(r){ return r.json(); }).then(function(){
        atcBtn.textContent = 'ADDED ✓';
        setTimeout(function(){ atcBtn.textContent = 'ADD TO CART'; atcBtn.disabled = false; }, 2000);
        // Update cart count
        fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
          var countEls = document.querySelectorAll('.sp-cart-count');
          countEls.forEach(function(el){ el.textContent = cart.item_count; });
          if(typeof window.sculpsCartRefresh === 'function') window.sculpsCartRefresh();
        });
      }).catch(function(){
        atcBtn.textContent = 'ADD TO CART';
        atcBtn.disabled = false;
      });
    }
  });
})();
</script>

{% schema %}
{
  "name": "SCULPS Sets Page",
  "blocks": [
    {
      "type": "collection_banner",
      "name": "Collection Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Banner Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "THE SETS"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "DROP 1 — 4 COLORWAYS"
        }
      ]
    },
    {
      "type": "color_filter",
      "name": "Color Filter",
      "settings": []
    },
    {
      "type": "product_grid",
      "name": "Product Grid",
      "settings": []
    },
    {
      "type": "manifesto_strip",
      "name": "Manifesto Strip",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "WE DON'T HIRE MODELS. WE WORK WITH REAL WOMEN."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "JOIN CREATOR STUDIO"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SCULPS Sets",
      "blocks": [
        {"type": "collection_banner"},
        {"type": "color_filter"},
        {"type": "product_grid"},
        {"type": "manifesto_strip"}
      ]
    }
  ]
}
{% endschema %}
