{%- comment -%}
  YOUR IPHONE IS THE KEY — the pairing sequence, in the real order:
    1. the empty pocket
    2. the card goes in and is read
    3. the phone goes in and it charges

  Real photographs of the machine, not renders. Makes no claim about an app —
  the pairing is hardware and works the day the bike arrives.
{%- endcomment -%}

<section class="xero-night" data-sec="pairing" id="key" style="position:relative;width:100%;background:var(--pg);padding:7rem 1.4rem 6.5rem;">

  <div style="max-width:52rem;margin:0 auto;text-align:center;">
    <div style="font-size:.78rem;font-weight:600;letter-spacing:.22em;color:var(--txt3,#7c7d85);">{{ section.settings.eyebrow }}</div>
    <h2 style="margin:1rem 0 0;font-size:clamp(2.1rem,4.8vw,3.8rem);font-weight:700;letter-spacing:-.038em;line-height:1.03;color:var(--txt,#0e0e0e);text-wrap:balance;">{{ section.settings.heading }}</h2>
    {%- if section.settings.sub != blank -%}
      <p style="margin:1rem auto 0;max-width:36rem;font-size:1.08rem;line-height:1.5;color:var(--txt2,#55565c);text-wrap:pretty;">{{ section.settings.sub }}</p>
    {%- endif -%}
  </div>

  {%- comment -%} three steps, in order {%- endcomment -%}
  <div data-m="steps" style="max-width:76rem;margin:3rem auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:1.6rem;">

    {%- assign imgs = 'step1_img,step2_img,step3_img' | split: ',' -%}
    {%- for i in (1..3) -%}
      {%- assign n = i | prepend: 's' -%}
      {%- assign tk = n | append: '_title' -%}
      {%- assign bk = n | append: '_body' -%}
      {%- assign ik = imgs[forloop.index0] -%}
      <div>
        <div style="position:relative;width:100%;aspect-ratio:4 / 3;overflow:hidden;border-radius:1rem;background:var(--sub,rgba(255,255,255,.04));">
          {% render 'xero-image', key: ik, label: "step ", append: i, radius: 16, circle: false %}
        </div>
        <div style="margin-top:1.1rem;display:flex;align-items:baseline;gap:.7rem;">
          <span style="font:600 .76rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:#c68bff;">0{{ i }}</span>
          <span style="font-size:1.18rem;font-weight:650;letter-spacing:-.026em;color:var(--txt,#0e0e0e);">{{ section.settings[tk] }}</span>
        </div>
        <p style="margin:.5rem 0 0;font-size:.98rem;line-height:1.55;color:var(--txt2,#55565c);text-wrap:pretty;">{{ section.settings[bk] }}</p>
      </div>
    {%- endfor -%}

  </div>

  {%- comment -%} payoff {%- endcomment -%}
  <div style="max-width:44rem;margin:3.4rem auto 0;text-align:center;">
    <p style="margin:0;font-size:clamp(1.3rem,2.4vw,1.85rem);font-weight:600;letter-spacing:-.03em;line-height:1.3;color:var(--txt,#0e0e0e);text-wrap:balance;">{{ section.settings.payoff }}</p>
    {%- if section.settings.payoff_sub != blank -%}
      <p style="margin:.9rem auto 0;max-width:32rem;font-size:1rem;line-height:1.55;color:var(--txt2,#55565c);">{{ section.settings.payoff_sub }}</p>
    {%- endif -%}
    {%- if section.settings.cta != blank -%}
      <a href="{{ section.settings.cta_link | default: '/pages/activate' }}" style="display:inline-flex;align-items:center;gap:.45rem;margin-top:1.4rem;font-size:1.02rem;font-weight:600;color:#3a82fb;text-decoration:none;">
        {{ section.settings.cta }}
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M9 5l3 3-3 3"></path></svg>
      </a>
    {%- endif -%}
  </div>

</section>

<style>
  @media (max-width: 860px){
    [data-sec="pairing"] [data-m="steps"]{ grid-template-columns: 1fr !important; gap: 2.4rem !important; max-width: 30rem; }
  }
</style>

{% schema %}
{
  "name": "XERO iPhone key",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NO KEYS. NO FOB HUNTING." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your iPhone is the key." },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Card in, card out, phone in. After that the bike knows your phone and nothing else will start it." },
    { "type": "header", "content": "Step 1 — the pocket" },
    { "type": "image_picker", "id": "step1_img", "label": "Step 1 image" },
    { "type": "text", "id": "s1_title", "label": "Step 1 title", "default": "Cut for your phone" },
    { "type": "textarea", "id": "s1_body", "label": "Step 1 body", "default": "A pocket milled into the tank to the exact size and thickness of an iPhone, with the charging coil built into the floor of it. Nothing clips on. Nothing sticks out." },
    { "type": "header", "content": "Step 2 — the card" },
    { "type": "image_picker", "id": "step2_img", "label": "Step 2 image" },
    { "type": "text", "id": "s2_title", "label": "Step 2 title", "default": "Tap your card once" },
    { "type": "textarea", "id": "s2_body", "label": "Step 2 body", "default": "Your steel card carries the bike's client ID and serial. Lay it in the pocket, the NFC reader picks it up, and the machine is claimed. Then take the card straight back out." },
    { "type": "header", "content": "Step 3 — the phone" },
    { "type": "image_picker", "id": "step3_img", "label": "Step 3 image" },
    { "type": "text", "id": "s3_title", "label": "Step 3 title", "default": "Drop your phone in" },
    { "type": "textarea", "id": "s3_body", "label": "Step 3 body", "default": "It lies flat and flush, the magnet holds it, and it charges while you ride. From then on the bike wakes for that phone alone." },
    { "type": "header", "content": "Payoff" },
    { "type": "text", "id": "payoff", "label": "Payoff line", "default": "Built for iPhone. Only for iPhone." },
    { "type": "textarea", "id": "payoff_sub", "label": "Payoff sub", "default": "The pocket, the magnet, the NFC handshake — every millimetre of it is designed around iOS. Your card and key ship days before the bike does, so you can register your ID the moment they land." },
    { "type": "text", "id": "cta", "label": "Link text", "default": "Activate your ID" },
    { "type": "url", "id": "cta_link", "label": "Link" }
  ],
  "presets": [{ "name": "XERO iPhone key" }]
}
{% endschema %}
