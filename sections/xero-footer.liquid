{%- comment -%}
  FOOTER - only links to things that exist.

  The previous version listed 26 links across four columns, every one of them href="#".
  A footer full of dead links reads as an unfinished site, which is the opposite of what a
  $4,999 product page needs. This links to the three real pages, the real policies Shopify
  has generated, and the on-page anchors. Policies are looped from shop.policies, so a
  policy appears here the moment you write it in admin and never before.
{%- endcomment -%}

<footer class="xero-night" data-sec="footer" style="position:relative;width:100%;background:var(--pg2);padding:0;">

  <div data-anim style="display:flex;width:max-content;padding:1.15rem 0;border-bottom:1px solid var(--hair,rgba(255,255,255,.08));animation:xtick 34s linear infinite;">
    {%- assign tick = section.settings.ticker | default: 'RIDE TO THE STARS' -%}
    {%- for i in (1..2) -%}
      <span style="font-size:.8rem;font-weight:700;letter-spacing:.19em;color:var(--txt3,#7c7d85);white-space:nowrap;">
        {%- for j in (1..3) -%}{{ tick }} &nbsp;&middot;&nbsp; {% endfor -%}
      </span>
    {%- endfor -%}
  </div>

  <div style="position:relative;max-width:76rem;margin:0 auto;padding:4.4rem 1.6rem 0;">
    <div style="display:flex;flex-wrap:wrap;gap:3.2rem 2.4rem;align-items:flex-start;">

      {%- comment -%} newsletter {%- endcomment -%}
      <div style="flex:1 1 20rem;min-width:0;max-width:26rem;">
        <div style="font-size:2.5rem;font-weight:700;letter-spacing:-.03em;line-height:1.05;color:var(--txt,#f4f4f6);text-wrap:balance;">{{ section.settings.news_heading }}</div>
        {%- if section.settings.news_body != blank -%}
          <p style="margin:.7rem 0 1.3rem;font-size:1rem;line-height:1.5;color:var(--txt2,#a9aab1);text-wrap:pretty;">{{ section.settings.news_body }}</p>
        {%- else -%}
          <div style="height:1.3rem;"></div>
        {%- endif -%}

        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display:flex;gap:.5rem;padding:.34rem;border-radius:1.5rem;background:var(--pill,rgba(255,255,255,.06));border:1px solid var(--pill-b,rgba(255,255,255,.08));">
            <input type="email" name="contact[email]" required placeholder="you@email.com" aria-label="Email address"
                   style="flex:1;min-width:0;height:2.7rem;padding:0 .95rem;border:0;background:none;outline:none;font-size:1rem;letter-spacing:-.01em;color:var(--txt,#f4f4f6);">
            <button type="submit" data-x="xh6 xh1" style="flex:0 0 auto;height:2.7rem;padding:0 1.35rem;border-radius:1.35rem;background:#3a82fb;color:#fff;font-size:.95rem;font-weight:600;transition:transform .3s cubic-bezier(.28,.11,.32,1);">Join</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p style="margin:.7rem 0 0;font-size:.9rem;color:var(--ok,#34d058);">Thanks. You are on the list.</p>
          {%- endif -%}
        {%- endform -%}

        {%- assign socials = section.settings.socials | split: ',' -%}
        {%- if socials.size > 0 and section.settings.socials != blank -%}
          <div style="margin-top:2.6rem;display:flex;flex-wrap:wrap;gap:.55rem;">
            {%- for s in socials -%}
              {%- assign bits = s | strip | split: '|' -%}
              {%- if bits[1] != blank -%}
                <a data-x="xh2" href="{{ bits[1] | strip }}" target="_blank" rel="noopener"
                   style="height:2.4rem;padding:0 1rem;border-radius:1.2rem;display:inline-flex;align-items:center;font-size:.82rem;font-weight:600;color:var(--txt,#f4f4f6);background:var(--pill,rgba(255,255,255,.06));border:1px solid var(--pill-b,rgba(255,255,255,.08));transition:transform .3s cubic-bezier(.28,.11,.32,1);">{{ bits[0] | strip }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} real links only {%- endcomment -%}
      <div data-m="ftgrid" style="flex:1 1 26rem;min-width:0;display:flex;flex-wrap:wrap;gap:2.6rem 1.6rem;">

        <div style="flex:1 1 10rem;min-width:0;">
          <div style="margin-bottom:.75rem;font-size:.74rem;font-weight:700;letter-spacing:.11em;color:var(--txt3,#7c7d85);">CHIRON</div>
          <a data-x="xh7" href="/" style="display:block;padding:.2rem 0;font-size:.94rem;color:var(--txt2,#a9aab1);transition:color .25s;">Overview</a>
          <a data-x="xh7" href="/#specs" style="display:block;padding:.2rem 0;font-size:.94rem;color:var(--txt2,#a9aab1);transition:color .25s;">Specs</a>
        </div>

        <div style="flex:1 1 10rem;min-width:0;">
          <div style="margin-bottom:.75rem;font-size:.74rem;font-weight:700;letter-spacing:.11em;color:var(--txt3,#7c7d85);">OWNERS</div>
          <a data-x="xh7" href="/pages/activate" style="display:block;padding:.2rem 0;font-size:.94rem;color:var(--txt2,#a9aab1);transition:color .25s;">Activate a key</a>
          <a data-x="xh7" href="/pages/track" style="display:block;padding:.2rem 0;font-size:.94rem;color:var(--txt2,#a9aab1);transition:color .25s;">Track your build</a>
          <a data-x="xh7" href="/cart" style="display:block;padding:.2rem 0;font-size:.94rem;color:var(--txt2,#a9aab1);transition:color .25s;">Cart</a>
        </div>

        <div style="flex:1 1 10rem;min-width:0;">
          <div style="margin-bottom:.75rem;font-size:.74rem;font-weight:700;letter-spacing:.11em;color:var(--txt3,#7c7d85);">SUPPORT</div>
          <a data-x="xh7" href="/pages/contact" style="display:block;padding:.2rem 0;font-size:.94rem;color:var(--txt2,#a9aab1);transition:color .25s;">Contact</a>
          {%- if shop.email != blank -%}
            <a data-x="xh7" href="mailto:{{ shop.email }}" style="display:block;padding:.2rem 0;font-size:.94rem;color:var(--txt2,#a9aab1);transition:color .25s;">{{ shop.email }}</a>
          {%- endif -%}
        </div>

      </div>
    </div>

    <div style="margin-top:4.4rem;display:flex;flex-wrap:wrap;gap:.9rem 2rem;align-items:baseline;padding-bottom:3rem;">
      <span style="font-size:.86rem;color:var(--txt3,#7c7d85);">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- comment -%} only the policies that actually exist in admin {%- endcomment -%}
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}
          <a data-x="xh7" href="{{ policy.url }}" style="font-size:.86rem;color:var(--txt3,#7c7d85);transition:color .25s;">{{ policy.title }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.tagline != blank -%}
        <span style="margin-left:auto;font-size:.86rem;color:var(--txt3,#7c7d85);">{{ section.settings.tagline }}</span>
      {%- endif -%}
    </div>
  </div>

  <div style="border-top:1px solid var(--hair,rgba(255,255,255,.08));">
    <div style="max-width:76rem;margin:0 auto;padding:2.6rem 1.6rem 3rem;display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:1.2rem 2rem;">
      <div data-m="ftbig" style="font-size:min(11vw,7.4rem);font-weight:700;letter-spacing:-.05em;line-height:.9;color:var(--txt,#f4f4f6);user-select:none;">{{ section.settings.wordmark }}</div>
      {%- if section.settings.signoff != blank -%}
        <div style="font-size:1rem;font-weight:500;letter-spacing:-.015em;color:var(--txt2,#a9aab1);text-align:right;">{{ section.settings.signoff }}</div>
      {%- endif -%}
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "XERO footer",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "news_heading", "label": "Newsletter heading", "default": "Get the launch drop." },
    { "type": "text", "id": "news_body", "label": "Newsletter body", "default": "Build slots, ride days, and the first film. Nothing else." },
    { "type": "text", "id": "ticker", "label": "Ticker text", "default": "RIDE TO THE STARS" },
    { "type": "textarea", "id": "socials", "label": "Social links", "info": "One per line as Label|https://url - leave empty to hide the row." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Designed on Earth. Tested elsewhere." },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "XERO" },
    { "type": "text", "id": "signoff", "label": "Sign-off", "default": "Ride to the stars." }
  ],
  "presets": [{ "name": "XERO footer" }]
}
{% endschema %}
