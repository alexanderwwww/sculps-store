{%- comment -%}
  XERO watch — one plain film frame. "Watch it move."

  Deliberately the simplest section in the theme: a heading and a single 16:9
  YouTube embed. The owner pastes the video ID in the editor and places the
  section wherever they want via Add section. This file writes nothing into
  any template, so it can never disturb editor-owned content.

  Renders nothing at all on the storefront while the ID is empty; in the
  theme editor an empty state shows a hint instead, so the section stays
  findable and never looks broken to a visitor.
{%- endcomment -%}

{%- assign yt = section.settings.youtube_id | strip -%}

{%- if yt != blank or request.design_mode -%}
<section class="xero-night" data-sec="watch" style="position:relative;width:100%;background:var(--pg);padding:6rem 0 5.5rem;">
  <div style="max-width:70rem;margin:0 auto;padding:0 2.06rem;">

    {%- if section.settings.kicker != blank -%}
      <div style="display:flex;align-items:center;gap:.75rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.75rem;font-weight:500;letter-spacing:.2em;color:var(--txt3,#7c7d85);">
        <span style="width:.46rem;height:.46rem;border-radius:50%;background:#8b7bff;box-shadow:0 0 9px rgba(139,123,255,.85);"></span>
        <span>{{ section.settings.kicker }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 style="margin:1rem 0 0;font-size:clamp(2rem,4.2vw,3.2rem);font-weight:700;letter-spacing:-.038em;line-height:1.05;color:var(--txt,#f4f4f6);">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div style="margin-top:2.2rem;position:relative;aspect-ratio:16/9;border-radius:1.1rem;overflow:hidden;background:#000;border:1px solid rgba(255,255,255,.08);">
      {%- if yt != blank -%}
        <iframe
          src="https://www.youtube-nocookie.com/embed/{{ yt }}?rel=0&modestbranding=1&playsinline=1"
          title="{{ section.settings.heading | default: 'XERO film' | escape }}"
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
          style="position:absolute;inset:0;width:100%;height:100%;border:0;"></iframe>
      {%- else -%}
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:1.5rem;">
          <span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.75rem;letter-spacing:.08em;color:var(--txt3,#7c7d85);text-align:center;">Paste a YouTube video ID in the section settings. This section stays hidden on the live site until then.</span>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "XERO watch",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "IN MOTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch it move." },
    { "type": "text", "id": "youtube_id", "label": "YouTube video ID", "info": "Just the ID — the part after watch?v=, or the last segment of a youtu.be or Shorts link. Not the full URL." }
  ],
  "presets": [{ "name": "XERO watch" }]
}
{% endschema %}
