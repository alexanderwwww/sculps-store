<section class="xero-night" data-sec="delivery" style="position:relative;width:100%;background:var(--pg);padding:6.4rem 2.06rem;">

    <div style="max-width:76rem;margin:0 auto;">
      <div style="max-width:46rem;">
        <div style="font-size:.76rem;font-weight:700;letter-spacing:.13em;color:var(--txt3,#8a8b91);">WHAT ARRIVES, AND WHEN</div>
        <h2 style="margin:.9rem 0 0;font-size:clamp(2.2rem,4.6vw,3.8rem);font-weight:700;letter-spacing:-.038em;line-height:1.02;color:var(--txt,#0e0e0e);text-wrap:balance;">The key comes before the bike.</h2>
        <p style="margin:1.15rem 0 0;font-size:1.18rem;line-height:1.5;letter-spacing:-.015em;color:var(--txt2,#55565c);text-wrap:pretty;">Ordering a Chiron is not a shipping notification. A handmade box lands on your table days before the bike does, and by the time the truck arrives everything is already in your name.</p>
      </div>

      <div style="margin-top:2.8rem;">
        <div style="position:relative;width:100%;aspect-ratio:21 / 9;border-radius:1.8rem;overflow:hidden;">{% render 'xero-image', key: 'dlv_hero', label: "the box &mdash; open, key and code card inside", radius: 22, circle: false %}</div>
      </div>

      <div data-m="steprow" style="margin-top:1.1rem;display:flex;flex-wrap:wrap;gap:1.1rem;">
        <div style="flex:1 1 15rem;min-width:0;display:flex;flex-direction:column;padding:1.5rem 1.4rem 1.6rem;border-radius:1.25rem;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 44%,var(--glow,rgba(255,255,255,.22))),var(--card,rgba(255,255,255,.74));border:1px solid var(--rvb,rgba(0,0,0,.06));box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22)),0 .4rem 1.4rem var(--shadow,rgba(0,0,0,.10));">
          <div style="display:flex;align-items:center;gap:.7rem;">
            <span style="flex:0 0 auto;width:1.9rem;height:1.9rem;border-radius:50%;background:var(--acc,#005df9);color:#fff;font:700 .82rem/1 system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;">1</span>
            <span style="height:1px;flex:1;background:var(--hair,rgba(0,0,0,.1));"></span>
          </div>
          <div style="margin-top:1rem;font-size:1.24rem;font-weight:700;letter-spacing:-.026em;line-height:1.12;color:var(--txt,#0e0e0e);">The box arrives first</div>
          <p style="margin:.6rem 0 0;font-size:.96rem;line-height:1.46;color:var(--txt2,#55565c);text-wrap:pretty;">Handmade, numbered, and lined for one object. Inside: your wireless key and a single activation code on a card.</p>
        </div>
        <div style="flex:1 1 15rem;min-width:0;display:flex;flex-direction:column;padding:1.5rem 1.4rem 1.6rem;border-radius:1.25rem;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 44%,var(--glow,rgba(255,255,255,.22))),var(--card,rgba(255,255,255,.74));border:1px solid var(--rvb,rgba(0,0,0,.06));box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22)),0 .4rem 1.4rem var(--shadow,rgba(0,0,0,.10));">
          <div style="display:flex;align-items:center;gap:.7rem;">
            <span style="flex:0 0 auto;width:1.9rem;height:1.9rem;border-radius:50%;background:var(--acc,#005df9);color:#fff;font:700 .82rem/1 system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;">2</span>
            <span style="height:1px;flex:1;background:var(--hair,rgba(0,0,0,.1));"></span>
          </div>
          <div style="margin-top:1rem;font-size:1.24rem;font-weight:700;letter-spacing:-.026em;line-height:1.12;color:var(--txt,#0e0e0e);">Scan the key</div>
          <p style="margin:.6rem 0 0;font-size:.96rem;line-height:1.46;color:var(--txt2,#55565c);text-wrap:pretty;">Hold the pebble to your iPhone. The XERO app opens itself &mdash; no store search, no account hunt.</p>
        </div>
        <div style="flex:1 1 15rem;min-width:0;display:flex;flex-direction:column;padding:1.5rem 1.4rem 1.6rem;border-radius:1.25rem;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 44%,var(--glow,rgba(255,255,255,.22))),var(--card,rgba(255,255,255,.74));border:1px solid var(--rvb,rgba(0,0,0,.06));box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22)),0 .4rem 1.4rem var(--shadow,rgba(0,0,0,.10));">
          <div style="display:flex;align-items:center;gap:.7rem;">
            <span style="flex:0 0 auto;width:1.9rem;height:1.9rem;border-radius:50%;background:var(--acc,#005df9);color:#fff;font:700 .82rem/1 system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;">3</span>
            <span style="height:1px;flex:1;background:var(--hair,rgba(0,0,0,.1));"></span>
          </div>
          <div style="margin-top:1rem;font-size:1.24rem;font-weight:700;letter-spacing:-.026em;line-height:1.12;color:var(--txt,#0e0e0e);">Enter the code</div>
          <p style="margin:.6rem 0 0;font-size:.96rem;line-height:1.46;color:var(--txt2,#55565c);text-wrap:pretty;">The key pairs to you and the app unlocks. Your bike is registered before it is anywhere near your street.</p>
        </div>
        <div style="flex:1 1 15rem;min-width:0;display:flex;flex-direction:column;padding:1.5rem 1.4rem 1.6rem;border-radius:1.25rem;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 44%,var(--glow,rgba(255,255,255,.22))),var(--card,rgba(255,255,255,.74));border:1px solid var(--rvb,rgba(0,0,0,.06));box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22)),0 .4rem 1.4rem var(--shadow,rgba(0,0,0,.10));">
          <div style="display:flex;align-items:center;gap:.7rem;">
            <span style="flex:0 0 auto;width:1.9rem;height:1.9rem;border-radius:50%;background:var(--acc,#005df9);color:#fff;font:700 .82rem/1 system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;">4</span>
            <span style="height:1px;flex:1;background:var(--hair,rgba(0,0,0,.1));"></span>
          </div>
          <div style="margin-top:1rem;font-size:1.24rem;font-weight:700;letter-spacing:-.026em;line-height:1.12;color:var(--txt,#0e0e0e);">The bike follows</div>
          <p style="margin:.6rem 0 0;font-size:.96rem;line-height:1.46;color:var(--txt2,#55565c);text-wrap:pretty;">It arrives a few days later, already yours. Walk up to it and it wakes. Nothing to set up in the driveway.</p>
        </div>
      </div>

      <div data-m="dlvpair" style="margin-top:1.1rem;display:flex;flex-wrap:wrap;gap:1.1rem;align-items:stretch;">
        <div style="flex:1 1 26rem;min-width:0;"><div style="position:relative;width:100%;aspect-ratio:4 / 3;border-radius:1.4rem;overflow:hidden;">{% render 'xero-image', key: 'dlv_key', label: "wireless key — macro, in the box", radius: 22, circle: false %}</div></div>
        <div style="flex:1 1 18rem;min-width:0;display:flex;flex-direction:column;gap:1.1rem;">
          <div style="flex:1;min-height:0;"><div style="position:relative;width:100%;aspect-ratio:4 / 3;border-radius:1.4rem;overflow:hidden;">{% render 'xero-image', key: 'dlv_app', label: "app — activation screen after the scan", radius: 22, circle: false %}</div></div>
          <div style="padding:1.35rem 1.4rem;border-radius:1.25rem;background:linear-gradient(180deg,var(--gloss,rgba(255,255,255,.46)),rgba(255,255,255,0) 44%,var(--glow,rgba(255,255,255,.22))),var(--card,rgba(255,255,255,.74));border:1px solid var(--rvb,rgba(0,0,0,.06));box-shadow:inset 0 1px 0 var(--sheen,rgba(255,255,255,.88)),inset 0 -1px 0 var(--glow,rgba(255,255,255,.22));">
            <div style="font-size:.74rem;font-weight:700;letter-spacing:.11em;color:var(--txt3,#8a8b91);">IN THE BOX</div>
            <p style="margin:.6rem 0 0;font-size:.98rem;line-height:1.5;color:var(--txt,#0e0e0e);text-wrap:pretty;">One wireless key. One activation card. Nothing else &mdash; no manual, no filler, no plastic tray.</p>
          </div>
        </div>
      </div>

      <p style="margin:2.2rem 0 0;font-size:.8rem;color:var(--txt3,#8a8b91);">Key dispatch and bike delivery windows are confirmed by email after your order. Ships in 4 to 6 weeks from order — an estimate given in good faith, not a guaranteed date. Already have your box? <a href="/pages/activate" style="color:var(--acc,#005df9);text-decoration:underline;text-underline-offset:.18em;">Activate your key</a>.</p>
    </div>
  
</section>

{% schema %}
{
  "name": "XERO delivery",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHAT ARRIVES, AND WHEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The key comes before the bike."
    },
    {
      "type": "image_picker",
      "id": "dlv_hero",
      "label": "The box (21:9)"
    },
    {
      "type": "image_picker",
      "id": "dlv_key",
      "label": "Wireless key macro"
    },
    {
      "type": "image_picker",
      "id": "dlv_app",
      "label": "App activation screen"
    }
  ],
  "presets": [
    {
      "name": "XERO delivery"
    }
  ]
}
{% endschema %}
