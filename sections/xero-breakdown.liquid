{%- comment -%}
  IN MOTION — vertical film, framed, with the specs stacked beside it.

  Two columns: a 9:16 film in a rounded phone-style frame on the left, and the
  numbers listed down the right as rows. The film autoplays muted and loops when
  it scrolls into view and pauses when it leaves. Until a film is uploaded the
  poster carries the frame with no placeholder chrome.

  Mobile: film on top, specs underneath.
{%- endcomment -%}

{%- assign film = section.settings.film -%}

<section id="specs" class="xero-night" data-sec="motion" style="position:relative;width:100%;background:var(--pg);padding:6.5rem 1.4rem 6rem;">

  <div style="max-width:52rem;margin:0 auto;text-align:center;">
    <div style="font-size:.78rem;font-weight:600;letter-spacing:.22em;color:var(--txt3,#7c7d85);">{{ section.settings.eyebrow }}</div>
    <h2 style="margin:1rem 0 0;font-size:clamp(2.1rem,5vw,3.6rem);font-weight:700;letter-spacing:-.038em;line-height:1.03;color:var(--txt,#0e0e0e);text-wrap:balance;">{{ section.settings.heading }}</h2>
    {%- if section.settings.sub != blank -%}
      <p style="margin:1rem auto 0;max-width:34rem;font-size:1.06rem;line-height:1.55;color:var(--txt2,#55565c);text-wrap:pretty;">{{ section.settings.sub }}</p>
    {%- endif -%}
  </div>

  <div data-m="grid" style="max-width:64rem;margin:3rem auto 0;display:grid;grid-template-columns:auto 1fr;gap:3.5rem;align-items:center;">

    {%- comment -%} the film, framed, 9:16 {%- endcomment -%}
    <div data-m="film" style="position:relative;width:min(23rem,74vw);aspect-ratio:9 / 16;border-radius:2rem;overflow:hidden;background:#000;border:1px solid var(--hair,rgba(255,255,255,.12));box-shadow:0 2rem 5rem rgba(0,0,0,.5);margin-inline:auto;">
      {%- if film != blank -%}
        {{ film | video_tag:
             image_size: '1200x',
             playsinline: true,
             muted: true,
             loop: true,
             autoplay: false,
             controls: false,
             preload: 'metadata',
             style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;'
        }}
        <button data-m="sound" aria-label="Toggle sound"
          style="position:absolute;right:.8rem;bottom:.8rem;z-index:2;width:2.4rem;height:2.4rem;border-radius:50%;background:rgba(14,14,20,.6);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;cursor:pointer;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6.5 9H3v6h3.5L11 19z"></path><path data-m="mute" d="M16 9.5l4.5 5M20.5 9.5l-4.5 5"></path><path data-m="unmute" style="display:none" d="M15.5 8.8a4.4 4.4 0 0 1 0 6.4M18.4 6.4a8 8 0 0 1 0 11.2"></path></svg>
        </button>
      {%- else -%}
        <div style="position:absolute;inset:0;">
          {% render 'xero-image', key: 'motion_poster', label: "film of the bike moving", radius: 0, circle: false %}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} specs, stacked down the right {%- endcomment -%}
    <div data-m="specs">
      {%- for i in (1..6) -%}
        {%- assign n = i | prepend: 's' -%}
        {%- assign vk = n | append: '_value' -%}
        {%- assign lk = n | append: '_label' -%}
        {%- if section.settings[vk] != blank -%}
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:1.4rem;padding:1.05rem 0;{% unless forloop.last %}border-bottom:1px solid var(--hair,rgba(255,255,255,.09));{% endunless %}">
            <span style="font:600 .7rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em;color:var(--txt3,#7c7d85);">{{ section.settings[lk] }}</span>
            <span style="font-size:clamp(1.3rem,2.4vw,1.75rem);font-weight:700;letter-spacing:-.038em;line-height:1;color:var(--txt,#0e0e0e);white-space:nowrap;">{{ section.settings[vk] }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>

</section>

<style>
  @media (max-width: 860px){
    [data-sec="motion"] [data-m="grid"]{ grid-template-columns:1fr !important; gap:2.2rem !important; }
    [data-sec="motion"] [data-m="specs"]{ max-width:30rem; margin-inline:auto; width:100%; }
  }
</style>

<script>
(function(){
  var sec = document.querySelector('[data-sec="motion"]');
  if (!sec) return;
  var v = sec.querySelector('video');
  if (!v) return;

  new IntersectionObserver(function(en){
    en.forEach(function(e){
      if (e.isIntersecting){ v.play().catch(function(){}); }
      else if (!v.paused){ v.pause(); }
    });
  }, { threshold: .25 }).observe(v);

  var btn = sec.querySelector('[data-m="sound"]');
  if (btn){
    btn.addEventListener('click', function(){
      v.muted = !v.muted;
      sec.querySelector('[data-m="mute"]').style.display   = v.muted ? '' : 'none';
      sec.querySelector('[data-m="unmute"]').style.display = v.muted ? 'none' : '';
      if (v.paused) v.play().catch(function(){});
    });
  }
})();
</script>

{% schema %}
{
  "name": "XERO breakdown",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "IN MOTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch it move." },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "No engine note, no clutch, no gears. Just a throttle and everything the pack has, instantly." },
    { "type": "header", "content": "The film" },
    { "type": "video", "id": "film", "label": "Film of the bike moving (9:16 vertical)" },
    { "type": "image_picker", "id": "motion_poster", "label": "Poster (shown until the film is uploaded)" },
    { "type": "header", "content": "Specs" },
    { "type": "text", "id": "s1_value", "label": "1 value", "default": "82 hp" },
    { "type": "text", "id": "s1_label", "label": "1 label", "default": "PEAK POWER (TARGET)" },
    { "type": "text", "id": "s2_value", "label": "2 value", "default": "980 Nm" },
    { "type": "text", "id": "s2_label", "label": "2 label", "default": "AT THE WHEEL (TARGET)" },
    { "type": "text", "id": "s3_value", "label": "3 value", "default": "120 km/h" },
    { "type": "text", "id": "s3_label", "label": "3 label", "default": "TOP SPEED (TARGET)" },
    { "type": "text", "id": "s4_value", "label": "4 value", "default": "2.3 s" },
    { "type": "text", "id": "s4_label", "label": "4 label", "default": "0–60 KM/H (TARGET)" },
    { "type": "text", "id": "s5_value", "label": "5 value", "default": "104 kg" },
    { "type": "text", "id": "s5_label", "label": "5 label", "default": "ALL IN (TARGET)" },
    { "type": "text", "id": "s6_value", "label": "6 value", "default": "0" },
    { "type": "text", "id": "s6_label", "label": "6 label", "default": "BY DESIGN" }
  ],
  "presets": [{ "name": "XERO breakdown" }]
}
{% endschema %}
