{%- comment -%}
  XERO reel — one vertical film.

  Deliberately a single clip, not a carousel: one good reel sells better than
  three mediocre ones, and one video is one decode instead of three on a phone.

  SOURCE: an uploaded Shopify-hosted video only. No URLs, no embed ids, no
  third-party player. An uploaded file autoplays muted, loops, fills the 9:16
  frame with object-fit:cover and carries no player UI, no watermark and no
  related-video panel. Upload in Content > Files, then pick it here.

  LAYOUT. One component, two arrangements, no duplicated markup:
    desktop  - reel on the left, copy beside it, vertically centred
    mobile   - copy first, reel below, full width
  Both come from a single flex container that wraps; nothing is hidden and
  re-shown at a breakpoint, so there is only ever one <video> on the page.

  PLAYBACK. muted + playsinline are forced in JS because Shopify's video_tag
  does not reliably emit both, and without them iOS and Android refuse to
  autoplay - the usual cause of a black tile on a phone. The clip plays only
  while it is on screen and pauses when it leaves, so a 4K vertical file is not
  burning battery three sections further down. Tapping the reel toggles sound;
  it never starts unmuted.

  FRAMING. Captioning brand footage as customer or owner video is fabricated
  social proof - the same category as the invented review handles stripped out
  of xero-ugc - and a store with no orders cannot have owner footage anyway.
  Keep the footnote honest about whose film this is.

  EMPTY STATE. With no video the section renders NOTHING on the storefront; the
  theme editor shows a hint instead, so it stays findable and can never look
  broken to a visitor.
{%- endcomment -%}

{%- assign uid = section.id -%}
{%- assign clip = section.settings.video -%}

{%- if clip != blank or request.design_mode -%}
<section class="xero-night" data-sec="reel" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}
         style="position:relative;width:100%;background:var(--pg);padding:6rem 0 5.5rem;">

  <div style="max-width:70rem;margin:0 auto;padding:0 2.06rem;display:flex;flex-wrap:wrap;align-items:center;gap:clamp(2rem,5vw,4rem);">

    {%- comment -%}
      Copy. order:2 on wide screens puts it to the right of the reel; on a
      narrow screen the flex line wraps and the default order:1 in the media
      query below floats it back above. One block of markup, both layouts.
    {%- endcomment -%}
    <div data-m="reelcopy" style="flex:1 1 20rem;min-width:0;">
      {%- if section.settings.kicker != blank -%}
        <div style="display:flex;align-items:center;gap:.7rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.74rem;font-weight:500;letter-spacing:.2em;color:var(--txt3,#7c7d85);">
          <span style="width:.44rem;height:.44rem;border-radius:50%;background:#8b7bff;box-shadow:0 0 9px rgba(139,123,255,.85);"></span>
          <span>{{ section.settings.kicker }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 style="margin:1rem 0 0;font-size:clamp(2rem,4.4vw,3.2rem);font-weight:700;letter-spacing:-.038em;line-height:1.05;color:var(--txt,#f4f4f6);text-wrap:balance;">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.sub != blank -%}
        <p style="margin:1.05rem 0 0;max-width:30rem;font-size:1.02rem;line-height:1.55;color:var(--txt2,#a9aab1);text-wrap:pretty;">{{ section.settings.sub }}</p>
      {%- endif -%}
      {%- if section.settings.footnote != blank -%}
        <p style="margin:1.6rem 0 0;max-width:30rem;font-size:.8rem;line-height:1.55;color:var(--txt3,#7c7d85);">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>

    <div data-m="reelmedia" style="flex:0 1 22rem;min-width:0;margin-inline:auto;">
      <div data-m="reeltile" style="position:relative;width:100%;aspect-ratio:9/16;border-radius:1.25rem;overflow:hidden;background:#0a0a0c;border:1px solid rgba(255,255,255,.09);box-shadow:0 30px 60px -22px rgba(0,0,0,.65);{% if clip != blank %}cursor:pointer;{% endif %}">

        {%- if clip != blank -%}
          {{ clip | video_tag:
               image_size: '1080x',
               playsinline: true,
               muted: true,
               loop: true,
               autoplay: true,
               controls: false,
               preload: 'metadata',
               style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;'
          }}

          {%- if section.settings.caption != blank -%}
            <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(0deg,rgba(6,6,8,.62),rgba(6,6,8,0) 40%);"></div>
            <figcaption style="position:absolute;left:1rem;right:1rem;bottom:.95rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.75rem;letter-spacing:.05em;color:rgba(255,255,255,.9);pointer-events:none;">{{ section.settings.caption }}</figcaption>
          {%- endif -%}

          <span data-m="reelsound" aria-hidden="true"
                style="position:absolute;right:.8rem;top:.8rem;width:2.2rem;height:2.2rem;border-radius:50%;background:rgba(14,14,20,.5);-webkit-backdrop-filter:blur(16px) saturate(170%);backdrop-filter:blur(16px) saturate(170%);border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;pointer-events:none;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6.5 9H3v6h3.5L11 19z"></path><path data-m="mute" d="M16 9.5l4.5 5M20.5 9.5l-4.5 5"></path><path data-m="unmute" style="display:none" d="M15.5 8.8a4.4 4.4 0 0 1 0 6.4M18.4 6.4a8 8 0 0 1 0 11.2"></path></svg>
          </span>

        {%- else -%}
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:1.5rem;background:repeating-linear-gradient(135deg,rgba(255,255,255,.04) 0 12px,transparent 12px 24px);">
            <span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.72rem;letter-spacing:.06em;color:var(--txt3,#7c7d85);text-align:center;line-height:1.6;">Upload a vertical video in this section's settings. Nothing renders on the live site until you do.</span>
          </div>
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

<style>
  /* Wide: reel left, copy right. The copy is second in the DOM so that on a
     narrow screen it lands above the reel naturally - here it is pushed after. */
  @media (min-width: 861px){
    #shopify-section-{{ uid }} [data-m="reelcopy"]{ order:2; }
    #shopify-section-{{ uid }} [data-m="reelmedia"]{ order:1; flex-basis:20rem; }
  }
  @media (max-width: 860px){
    #shopify-section-{{ uid }} [data-m="reelmedia"]{ flex:1 1 100%; max-width:24rem; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ uid }}');
  if (!root) return;
  var v = root.querySelector('[data-m="reeltile"] video');
  if (!v) return;

  /* Shopify's video_tag does not reliably emit all of these, and without them
     iOS and Android refuse to autoplay - the usual cause of a black tile. */
  v.muted = true;
  v.setAttribute('muted', '');
  v.setAttribute('playsinline', '');
  v.setAttribute('webkit-playsinline', '');
  v.loop = true;

  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (en) {
      en.forEach(function (e) {
        if (e.isIntersecting) { v.play().catch(function () {}); }
        else if (!v.paused) { v.pause(); }
      });
    }, { threshold: 0.3 }).observe(v);
  } else {
    v.play().catch(function () {});
  }

  var tile = root.querySelector('[data-m="reeltile"]');
  if (tile) {
    tile.addEventListener('click', function () {
      v.muted = !v.muted;
      var m = root.querySelector('[data-m="mute"]'), u = root.querySelector('[data-m="unmute"]');
      if (m) m.style.display = v.muted ? '' : 'none';
      if (u) u.style.display = v.muted ? 'none' : '';
      if (v.paused) v.play().catch(function () {});
    });
  }
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "XERO reel",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "One vertical film. Upload the video in Content > Files, then pick it below. It autoplays muted, loops and fills the frame; tapping it turns sound on. Nothing renders on the live site until a video is set." },
    { "type": "video", "id": "video", "label": "Video", "info": "Vertical 9:16 works best. A landscape file will be cropped to fit." },
    { "type": "text", "id": "caption", "label": "Caption on the reel" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "ON THE TRAIL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The machine, being ridden." },
    { "type": "textarea", "id": "sub", "label": "Sub-line", "default": "Handheld footage from our own rides. Forest singletrack, rock, wet roots, after dark." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "info": "Say plainly whose footage this is. Captioning brand footage as customer video is fabricated social proof.", "default": "Filmed by XERO. Not customer footage." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Optional. Lets a nav link point here." }
  ],
  "presets": [{ "name": "XERO reel" }]
}
{% endschema %}
