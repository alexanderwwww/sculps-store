{%- comment -%}
  XERO specs — the specification sheet, telemetry edition.

  COMPATIBILITY CONTRACT - do not break it:
  The live template already stores the owner's content for this section. Every
  setting id (kicker, heading, sub, footnote) and the group block schema
  (title, note, rows) is UNCHANGED from the previous version, so that content
  renders into the new UI untouched. New capability arrives only as NEW
  settings (clip1..3), which default to empty and therefore change nothing
  until the owner fills them in the editor.

  THE UI. A dark instrument-panel reading of the same data:
  - dot-matrix canvas behind everything: one canvas, geometry cached on
    resize, DPR capped at 2, animated only while the section is on screen
  - monospace kicker with a status dot and blinking cursor in the LED purple
  - numbered group panels; values count up on scroll; a purple rule draws
    itself under each value as its group reveals
  - FIELD FOOTAGE row: up to three vertical click-to-play YouTube facades
    driven by the clip settings. An empty slot renders nothing on the live
    site (only a hint in the theme editor), so it can never look broken.

  VISIBILITY CONTRACT - the fix for the invisible-sheet bug, keep it:
  The sheet is VISIBLE BY DEFAULT. The hidden pre-reveal state exists only
  under [data-anim="1"], which the script sets on itself right before wiring
  the IntersectionObserver, with a 2.5s reveal-everything backstop. A JS
  error, a blocked script, an old browser or reduced-motion all leave every
  number on screen. Never reintroduce an inline opacity:0 on the groups - an
  inline style outranks any non-important stylesheet rule, which is exactly
  how this sheet once rendered fully invisible while looking correct in the
  DOM.

  NO COMPARISON COLUMN, deliberately and permanently - owner's standing rule.
  Every figure shown is a manufacturer specification set in the theme editor.
{%- endcomment -%}

{%- assign uid = section.id -%}

<section id="specs" class="xero-night" data-sec="specs" style="position:relative;width:100%;background:var(--pg);padding:6.5rem 0 6rem;overflow:hidden;">

  <canvas data-m="specmatrix" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.42;"></canvas>

  <div style="position:relative;z-index:1;max-width:70rem;margin:0 auto;padding:0 2.06rem;">

    <div style="display:flex;align-items:center;gap:.75rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.75rem;font-weight:500;letter-spacing:.2em;color:var(--txt3,#7c7d85);">
      <span style="width:.46rem;height:.46rem;border-radius:50%;background:#8b7bff;box-shadow:0 0 9px rgba(139,123,255,.85);"></span>
      <span>{{ section.settings.kicker }}</span>
      <span data-m="speccursor" style="width:.55em;height:1.05em;background:currentColor;opacity:.8;"></span>
    </div>

    <h2 style="margin:1.1rem 0 0;font-size:clamp(2.2rem,4.8vw,3.6rem);font-weight:700;letter-spacing:-.038em;line-height:1.04;color:var(--txt,#f4f4f6);">{{ section.settings.heading }}</h2>
    {%- if section.settings.sub != blank -%}
      <p style="margin:1rem 0 0;max-width:40rem;font-size:1rem;line-height:1.55;color:var(--txt2,#a9aab1);text-wrap:pretty;">{{ section.settings.sub }}</p>
    {%- endif -%}

    <div data-m="specscan" style="margin-top:2.6rem;height:1px;background:rgba(255,255,255,.08);position:relative;overflow:hidden;">
      <span style="position:absolute;top:0;left:0;width:34%;height:100%;background:linear-gradient(90deg,transparent,#8b7bff,transparent);"></span>
    </div>

    <div data-m="specgroups" style="margin-top:2.4rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,26rem),1fr));gap:1.1rem;">
      {%- assign gi = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          {%- assign gi = gi | plus: 1 -%}
          <div data-m="specgroup" {{ block.shopify_attributes }} style="border:1px solid rgba(255,255,255,.08);border-radius:1.1rem;background:rgba(255,255,255,.022);padding:1.45rem 1.55rem 1.65rem;">

            <div style="display:flex;align-items:baseline;gap:.85rem;padding-bottom:.95rem;border-bottom:1px solid rgba(255,255,255,.07);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;">
              <span style="font-size:.72rem;color:#8b7bff;">0{{ gi }}</span>
              <span style="font-size:.74rem;font-weight:600;letter-spacing:.2em;color:var(--txt3,#7c7d85);">{{ block.settings.title }}</span>
              {%- if block.settings.note != blank -%}
                <span style="margin-left:auto;font-size:.72rem;letter-spacing:.06em;color:var(--txt3,#7c7d85);">{{ block.settings.note }}</span>
              {%- endif -%}
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(9.5rem,1fr));gap:1.7rem 1.9rem;padding-top:1.55rem;">
              {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign parts = row | strip | split: '|' -%}
                {%- if parts.size >= 2 -%}
                  {%- assign val = parts[1] | strip -%}
                  <div>
                    <div data-m="specval" data-value="{{ val | escape }}" style="position:relative;display:inline-block;padding-bottom:.5rem;font-size:clamp(1.5rem,2.6vw,2rem);font-weight:600;letter-spacing:-.035em;line-height:1;color:var(--txt,#f4f4f6);font-variant-numeric:tabular-nums;">{{ val }}</div>
                    <div style="margin-top:.5rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.7rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--txt3,#8a8b91);">{{ parts[0] | strip }}</div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} FIELD FOOTAGE - renders only when at least one clip id is set,
        or in the theme editor where empty slots show as hints. {%- endcomment -%}
    {%- assign any_clip = false -%}
    {%- for i in (1..3) -%}
      {%- capture k -%}clip{{ i }}_id{%- endcapture -%}
      {%- assign v = section.settings[k] | strip -%}
      {%- if v != blank -%}{%- assign any_clip = true -%}{%- endif -%}
    {%- endfor -%}

    {%- if any_clip or request.design_mode -%}
      <div data-m="specclips" style="margin-top:3.4rem;">
        <div style="display:flex;align-items:center;gap:.75rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.72rem;font-weight:600;letter-spacing:.2em;color:var(--txt3,#7c7d85);">
          <span style="width:.46rem;height:.46rem;border-radius:50%;background:#8b7bff;box-shadow:0 0 9px rgba(139,123,255,.85);"></span>
          <span>{{ section.settings.clips_label | default: 'FIELD FOOTAGE' }}</span>
        </div>
        <div style="margin-top:1.2rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:1rem;">
          {%- for i in (1..3) -%}
            {%- capture idkey -%}clip{{ i }}_id{%- endcapture -%}
            {%- capture capkey -%}clip{{ i }}_cap{%- endcapture -%}
            {%- assign cid = section.settings[idkey] | strip -%}
            {%- assign ccap = section.settings[capkey] -%}
            {%- if cid != blank -%}
              <figure style="margin:0;">
                <div data-m="fclip" data-yt="{{ cid | escape }}" style="position:relative;aspect-ratio:9/16;border-radius:1rem;overflow:hidden;background:#0a0a0c;border:1px solid rgba(255,255,255,.08);cursor:pointer;">
                  <img src="https://i.ytimg.com/vi/{{ cid }}/hqdefault.jpg" alt="" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
                  <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(6,6,8,.6),rgba(6,6,8,0) 45%);"></div>
                  <button type="button" aria-label="Play clip" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:3.3rem;height:3.3rem;border-radius:50%;border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.14);-webkit-backdrop-filter:blur(16px) saturate(170%);backdrop-filter:blur(16px) saturate(170%);display:flex;align-items:center;justify-content:center;pointer-events:none;">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="#fff" aria-hidden="true"><path d="M5 3.2v9.6L13 8z"></path></svg>
                  </button>
                  {%- if ccap != blank -%}
                    <figcaption style="position:absolute;left:.8rem;right:.8rem;bottom:.75rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.72rem;letter-spacing:.06em;color:rgba(255,255,255,.88);">{{ ccap }}</figcaption>
                  {%- endif -%}
                </div>
              </figure>
            {%- elsif request.design_mode -%}
              <div style="position:relative;aspect-ratio:9/16;border-radius:1rem;border:1px dashed rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;padding:1rem;">
                <span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.7rem;letter-spacing:.08em;color:var(--txt3,#7c7d85);text-align:center;">Clip {{ i }} — paste a YouTube ID in the section settings. Hidden on the live site until filled.</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p style="margin:3rem 0 0;max-width:46rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.72rem;line-height:1.6;letter-spacing:.04em;color:var(--txt3,#7c7d85);">{{ section.settings.footnote }}</p>
    {%- endif -%}

  </div>
</section>

<style>
  #shopify-section-{{ uid }} [data-m="speccursor"]{ animation: xspecBlink 1.1s steps(1) infinite; }
  @keyframes xspecBlink{ 50%{ opacity:0; } }
  #shopify-section-{{ uid }} [data-m="specscan"] > span{ animation: xspecScan 3.8s cubic-bezier(.4,0,.6,1) infinite; }
  @keyframes xspecScan{ from{ transform:translateX(-110%); } to{ transform:translateX(320%); } }

  /* The purple rule under each value. Full-width by default so a static render
     (no JS, reduced motion) shows the finished state; in anim mode it starts
     collapsed and draws itself when the group reveals. */
  #shopify-section-{{ uid }} [data-m="specval"]::after{
    content:''; position:absolute; left:0; bottom:0; height:2px; width:100%;
    background:linear-gradient(90deg,#8b7bff,rgba(139,123,255,0));
    transform-origin:left; transition:transform .9s cubic-bezier(.28,.11,.32,1) .25s;
  }
  #shopify-section-{{ uid }}[data-anim="1"] [data-m="specgroup"]:not(.is-in) [data-m="specval"]::after{ transform:scaleX(0); }

  /* Visibility contract (see header comment): the hidden state exists ONLY under
     data-anim, which the script sets itself. Never inline-hide the groups. */
  #shopify-section-{{ uid }}[data-anim="1"] [data-m="specgroup"]{
    opacity:0; transform:translateY(14px);
    transition:opacity .7s cubic-bezier(.28,.11,.32,1), transform .7s cubic-bezier(.28,.11,.32,1);
  }
  #shopify-section-{{ uid }}[data-anim="1"] [data-m="specgroup"].is-in{ opacity:1; transform:none; }

  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ uid }} [data-m="specgroup"]{ opacity:1 !important; transform:none !important; transition:none !important; }
    #shopify-section-{{ uid }} [data-m="specmatrix"]{ display:none; }
    #shopify-section-{{ uid }} [data-m="speccursor"],
    #shopify-section-{{ uid }} [data-m="specscan"] > span{ animation:none; }
  }
  @media (max-width: 900px){
    #shopify-section-{{ uid }} [data-m="specmatrix"]{ opacity:.3; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ uid }}');
  if (!root) return;

  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- field footage: click-to-play facades ----------------------- */
  root.addEventListener('click', function (e) {
    var tile = e.target.closest('[data-m="fclip"]');
    if (!tile || tile.dataset.live === '1') return;
    var id = tile.getAttribute('data-yt');
    if (!id) return;
    tile.dataset.live = '1';
    var f = document.createElement('iframe');
    f.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
    f.title = 'XERO field footage';
    f.allow = 'autoplay; encrypted-media; picture-in-picture; web-share';
    f.setAttribute('allowfullscreen', '');
    f.referrerPolicy = 'strict-origin-when-cross-origin';
    f.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
    tile.innerHTML = '';
    tile.appendChild(f);
  });

  /* ---------- count-up ----------------------------------------------------
     Values are authored display strings ("980 Nm", "2.3 s", "1,500", "IP69K").
     Parse out the first number, remember how it was written - decimals, comma
     grouping, what sits either side - and rebuild identically every frame.
     Anything with no number ("Direct drive") is left alone. */
  function parse(str) {
    var m = String(str).match(/^(.*?)(\d[\d,]*(?:\.\d+)?)(.*)$/);
    if (!m) return null;
    var raw = m[2];
    return {
      prefix: m[1],
      suffix: m[3],
      target: parseFloat(raw.replace(/,/g, '')),
      decimals: (raw.split('.')[1] || '').length,
      grouped: raw.indexOf(',') !== -1
    };
  }

  function render(p, v) {
    var s = v.toFixed(p.decimals);
    if (p.grouped) {
      var bits = s.split('.');
      bits[0] = bits[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      s = bits.join('.');
    }
    return p.prefix + s + p.suffix;
  }

  function countUp(el) {
    var p = parse(el.getAttribute('data-value'));
    if (!p || reduce) return;
    var dur = 900, t0 = null;
    el.textContent = render(p, 0);
    function step(t) {
      if (t0 === null) t0 = t;
      var k = Math.min(1, (t - t0) / dur);
      var e = 1 - Math.pow(1 - k, 3);
      el.textContent = render(p, p.target * e);
      if (k < 1) requestAnimationFrame(step);
      else el.textContent = el.getAttribute('data-value');
    }
    requestAnimationFrame(step);
  }

  /* ---------- reveal ------------------------------------------------------ */
  var groups = root.querySelectorAll('[data-m="specgroup"]');

  function revealAll() {
    Array.prototype.forEach.call(groups, function (g) { g.classList.add('is-in'); });
  }

  if ('IntersectionObserver' in window && !reduce) {
    /* Only now is it safe to hide the groups - the code that reveals them is
       guaranteed to be running. */
    root.setAttribute('data-anim', '1');

    /* Backstop: if anything below throws or a group never intersects, the
       sheet must not stay blank. */
    setTimeout(revealAll, 2500);

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        var g = en.target;
        io.unobserve(g);
        var delay = Math.min(260, Math.max(0, g.getBoundingClientRect().top) * 0.12);
        setTimeout(function () {
          g.classList.add('is-in');
          Array.prototype.forEach.call(g.querySelectorAll('[data-m="specval"]'), function (el, i) {
            setTimeout(function () { countUp(el); }, i * 55);
          });
        }, delay);
      });
    }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
    Array.prototype.forEach.call(groups, function (g) { io.observe(g); });
  }
  /* else: data-anim is never set, nothing was ever hidden - static full sheet */

  /* ---------- dot matrix --------------------------------------------------
     One canvas. Geometry computed on resize and cached; each frame only
     rewrites fill styles. DPR capped at 2. Runs only while on screen. */
  var cv = root.querySelector('[data-m="specmatrix"]');
  if (cv && !reduce && window.innerWidth > 560) {
    var ctx = cv.getContext('2d', { alpha: true });
    var dots = [], w = 0, h = 0, raf = 0, running = false;
    var GAP = 22, R = 1.6;

    function build() {
      var r = root.getBoundingClientRect();
      w = Math.max(1, r.width | 0); h = Math.max(1, r.height | 0);
      var dpr = Math.min(2, window.devicePixelRatio || 1);
      cv.width = w * dpr; cv.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      dots.length = 0;
      for (var y = GAP; y < h; y += GAP)
        for (var x = GAP; x < w; x += GAP)
          dots.push({ x: x, y: y, d: (x + y) / (w + h) });
    }

    function frame(t) {
      if (!running) return;
      ctx.clearRect(0, 0, w, h);
      var phase = (t % 5200) / 5200;
      for (var i = 0; i < dots.length; i++) {
        var p = dots[i], k = (p.d - phase + 1) % 1;
        var a = k < 0.16 ? (1 - k / 0.16) : 0;
        ctx.fillStyle = 'rgba(139,123,255,' + (0.05 + a * 0.3).toFixed(3) + ')';
        ctx.beginPath();
        ctx.arc(p.x, p.y, R, 0, 6.2832);
        ctx.fill();
      }
      raf = requestAnimationFrame(frame);
    }

    build();
    window.addEventListener('resize', build);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (en) {
        en.forEach(function (e) {
          if (e.isIntersecting && !running) { running = true; raf = requestAnimationFrame(frame); }
          else if (!e.isIntersecting && running) { running = false; cancelAnimationFrame(raf); }
        });
      }, { threshold: 0.02 }).observe(root);
    } else {
      running = true;
      raf = requestAnimationFrame(frame);
    }
  }
})();
</script>

{% schema %}
{
  "name": "XERO specs",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "SPECIFICATIONS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every number." },
    { "type": "textarea", "id": "sub", "label": "Sub-line", "default": "The whole sheet. No asterisks, no small print, nothing withheld." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "info": "Shown small under the sheet." },
    { "type": "header", "content": "Field footage" },
    { "type": "paragraph", "content": "Up to three vertical video slots inside the sheet. Paste a YouTube video ID (the part after watch?v=, or the last segment of a Shorts link). An empty slot renders nothing on the live site." },
    { "type": "text", "id": "clips_label", "label": "Row label", "default": "FIELD FOOTAGE" },
    { "type": "text", "id": "clip1_id", "label": "Clip 1 — YouTube ID" },
    { "type": "text", "id": "clip1_cap", "label": "Clip 1 — caption" },
    { "type": "text", "id": "clip2_id", "label": "Clip 2 — YouTube ID" },
    { "type": "text", "id": "clip2_cap", "label": "Clip 2 — caption" },
    { "type": "text", "id": "clip3_id", "label": "Clip 3 — YouTube ID" },
    { "type": "text", "id": "clip3_cap", "label": "Clip 3 — caption" }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Spec group",
      "settings": [
        { "type": "text", "id": "title", "label": "Group title", "default": "POWERTRAIN" },
        { "type": "text", "id": "note", "label": "Note beside the title" },
        { "type": "textarea", "id": "rows", "label": "Rows", "info": "One per line, as: Label | Value", "default": "Peak power | 82 hp\nTorque at the wheel | 980 Nm" }
      ]
    }
  ],
  "presets": [
    {
      "name": "XERO specs",
      "blocks": [
        { "type": "group", "settings": { "title": "POWERTRAIN", "rows": "Peak power | 82 hp\nTorque at the wheel | 980 Nm\nMotor speed | 15,000 rpm\nTransmission | Direct drive" } },
        { "type": "group", "settings": { "title": "PERFORMANCE", "rows": "Top speed | 120 km/h\n0–60 km/h | 2.3 s" } },
        { "type": "group", "settings": { "title": "BATTERY", "note": "ASTRA ULTIMUM", "rows": "Capacity | 8.4 kWh\nCharge 0–100% | 55 min\nCycles to 80% | 1,500\nSwap time | 11 sec" } },
        { "type": "group", "settings": { "title": "CHASSIS", "rows": "Weight, all in | 104 kg\nSuspension travel | 310 mm\nFront brake | 280 mm, 4-piston\nSealing | IP69K" } }
      ]
    }
  ]
}
{% endschema %}
