<section class="sp-rev-s">
  <div class="sp-rev-h">{{ section.settings.heading | default: 'Real Reviews From Real Women' }}</div>
  <div class="sp-rev-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' and block.settings.text != blank -%}
        <div class="sp-rev-card" {{ block.shopify_attributes }}>
          <div class="sp-rev-stars">
            {%- assign stars = block.settings.stars | default: 5 -%}
            {%- for s in (1..stars) -%}★{%- endfor -%}
          </div>
          <p class="sp-rev-text">{{ block.settings.text }}</p>
          <div class="sp-rev-name">{{ block.settings.name | default: 'Verified Buyer' }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {"type": "text", "id": "heading", "label": "Section heading", "default": "Real Reviews From Real Women"}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type": "textarea", "id": "text", "label": "Review text"},
        {"type": "text", "id": "name", "label": "Reviewer name", "default": "Verified Buyer"},
        {"type": "range", "id": "stars", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5}
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {"type": "review", "settings": {"text": "\"These inserts are a game changer. I feel so confident in everything I wear. I cannot go back to a regular bra.\"", "name": "Jessica R. — Verified Buyer", "stars": 5}},
        {"type": "review", "settings": {"text": "\"Finally something that actually stays in place and feels like nothing. Wore these all day at a wedding. Perfect.\"", "name": "Brianna K. — Verified Buyer", "stars": 5}},
        {"type": "review", "settings": {"text": "\"The best investment I have made for myself. Worth every single penny. I use every product in my kit weekly.\"", "name": "Lauren M. — Verified Buyer", "stars": 5}}
      ]
    }
  ]
}
{% endschema %}
