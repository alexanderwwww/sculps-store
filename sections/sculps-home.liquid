<script>
(function(){
  // Email signup
  window.sculpsEmailSignup = function() {
    var input = document.getElementById('sculps-email-input');
    if (!input) return;
    var email = input.value.trim();
    if (!email || !email.includes('@')) {
      alert('Please enter a valid email address.');
      return;
    }
    // Shopify customer newsletter signup via contact form
    fetch('/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'form_type=customer&utf8=%E2%9C%93&contact%5Bemail%5D=' + encodeURIComponent(email) + '&contact%5Btags%5D=newsletter'
    }).then(function() {
      input.value = '';
      input.placeholder = 'Thanks for signing up!';
      setTimeout(function(){ input.placeholder = 'Your email address'; }, 4000);
    }).catch(function() {
      input.placeholder = 'Thanks for signing up!';
      input.value = '';
    });
  };

  // Sticky header shadow on scroll
  var hdr = document.querySelector('.sp-header');
  if (hdr) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 10) {
        hdr.style.boxShadow = '0 2px 24px rgba(26,20,16,.1)';
      } else {
        hdr.style.boxShadow = 'none';
      }
    }, { passive: true });
  }

  // Skin tone circles on hero — link to product
  document.querySelectorAll('.sp-htone').forEach(function(el) {
