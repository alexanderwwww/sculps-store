{%- comment -%}sculps-home.liquid — SCULPS Custom Homepage{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,700;0,9..40,900;1,9..40,300;1,9..40,400&display=swap" rel="stylesheet">
<style>
/* ── SCULPS DESIGN SYSTEM ── */
:root{
  --black:#1A1410;--white:#FFFFFF;--cream:#FAF8F5;--nude:#F5E6D8;
  --gold:#C9A96E;--grey:#8B7355;--border:#F0EAE0;
  --tone1:#F5E6D8;--tone2:#E8C9A0;--tone3:#C8956C;
  --tone4:#A0714F;--tone5:#7B4F3A;--tone6:#3D2314;
  --pink:#F5B8C4;--sage:#9BAF8A;--lav:#C9B8E8;--steel:#7B9AB5;
}
/* Hide Dawn theme default header/footer so our custom ones take over */
#header-group,
.shopify-section-group-header-group,
.shopify-section-group-footer-group,
x-section-footer { display:none!important; }

.sculps-page *,.sculps-page *::before,.sculps-page *::after{box-sizing:border-box;margin:0;padding:0}
.sculps-page{font-family:'DM Sans',sans-serif;background:var(--white);color:var(--black);overflow-x:hidden}
.sculps-page img{display:block;width:100%;height:100%;object-fit:cover}
.sculps-page a{text-decoration:none;color:inherit}
.sculps-page button{cursor:pointer;font-family:inherit;border:none;background:none}

/* ── ANNOUNCEMENT BAR ── */
.sp-ann{background:var(--black);height:36px;overflow:hidden;display:flex;align-items:center}
.sp-ann-track{display:flex;animation:sp-ticker 30s linear infinite;white-space:nowrap;will-change:transform}
.sp-ann-track span{padding:0 48px;font-size:10px;font-weight:700;letter-spacing:2px;color:var(--white);text-transform:uppercase;flex-shrink:0}
.sp-ann-track span::after{content:'·';margin-left:48px;color:var(--gold)}
@keyframes sp-ticker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* ── HEADER ── */
.sp-header{position:sticky;top:0;z-index:200;background:rgba(255,255,255,.96);backdrop-filter:blur(24px);border-bottom:1px solid var(--border);height:64px;display:flex;align-items:center;padding:0 40px;justify-content:space-between}
.sp-logo{display:flex;align-items:center;flex-shrink:0}
.sp-logo-svg{height:28px}
.sp-nav ul{display:flex;gap:32px;list-style:none}
.sp-nav ul a{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--black);transition:color .2s}
.sp-nav ul a:hover{color:var(--grey)}
.sp-hdr-right{display:flex;align-items:center;gap:16px}
.sp-bag-btn{background:var(--black);color:var(--white);padding:9px 22px;font-size:10px;font-weight:800;letter-spacing:2px;text-transform:uppercase;transition:background .2s;font-family:'DM Sans',sans-serif}
.sp-bag-btn:hover{background:var(--grey)}
.sp-ham{display:none;flex-direction:column;gap:5px;padding:6px;cursor:pointer}
.sp-ham span{display:block;width:22px;height:2px;background:var(--black);transition:all .3s}
.sp-mob-nav{display:none;position:fixed;inset:0;background:var(--black);z-index:500;flex-direction:column;align-items:center;justify-content:center;gap:40px}
.sp-mob-nav.open{display:flex}
.sp-mob-nav a{font-family:'Bebas Neue',sans-serif;font-size:48px;color:var(--white);letter-spacing:4px}
.sp-mob-nav a:hover{color:var(--gold)}
.sp-mob-close{position:absolute;top:24px;right:24px;background:none;border:none;color:var(--white);font-size:28px;cursor:pointer;font-family:'DM Sans',sans-serif}

/* ── HERO ── */
.sp-hero{position:relative;height:92vh;min-height:580px;overflow:hidden;display:flex;align-items:flex-end}
.sp-hero-bg{position:absolute;inset:0;background:linear-gradient(135deg,#1A1410 0%,#3D2314 35%,#7B4F3A 65%,#C8956C 100%)}
.sp-hero-img-layer{position:absolute;inset:0;opacity:.35;background:radial-gradient(ellipse at 70% 30%,#C8956C 0%,transparent 60%),radial-gradient(ellipse at 30% 80%,#7B9AB5 0%,transparent 50%),radial-gradient(ellipse at 80% 80%,#C9B8E8 0%,transparent 40%)}
.sp-hero-grad{position:absolute;inset:0;background:linear-gradient(to top,rgba(26,20,16,.92) 0%,rgba(26,20,16,.4) 50%,rgba(26,20,16,.1) 100%)}
.sp-hero-content{position:relative;z-index:2;padding:0 60px 80px;max-width:680px}
.sp-hero-pre{font-size:10px;font-weight:700;letter-spacing:4px;color:var(--gold);text-transform:uppercase;margin-bottom:18px}
.sp-hero-h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(60px,9vw,108px);color:var(--white);line-height:.92;letter-spacing:2px;margin-bottom:22px}
.sp-hero-sub{font-size:15px;color:rgba(255,255,255,.6);margin-bottom:40px;font-weight:300;font-style:italic;letter-spacing:.5px}
.sp-hero-ctas{display:flex;gap:14px;flex-wrap:wrap}
.sp-btn-w{padding:15px 40px;background:var(--white);color:var(--black);font-size:10px;font-weight:900;letter-spacing:3px;text-transform:uppercase;transition:all .2s;font-family:'DM Sans',sans-serif;display:inline-block}
.sp-btn-w:hover{background:var(--gold);color:var(--white)}
.sp-btn-o{padding:15px 40px;background:transparent;color:var(--white);border:1px solid rgba(255,255,255,.35);font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;transition:all .2s;font-family:'DM Sans',sans-serif;display:inline-block}
.sp-btn-o:hover{border-color:var(--white);background:rgba(255,255,255,.08)}
.sp-hero-tones{position:absolute;right:50px;bottom:80px;z-index:3;display:flex;flex-direction:column;align-items:center;gap:10px}
.sp-hero-tones-lbl{font-size:8px;color:rgba(255,255,255,.4);letter-spacing:2px;text-transform:uppercase;writing-mode:vertical-rl;margin-bottom:6px}
.sp-htone{width:22px;height:22px;border-radius:50%;border:2px solid transparent;transition:all .2s;cursor:pointer}
.sp-htone:hover{border-color:var(--white);transform:scale(1.2)}

/* ── SECTIONS ── */
.sp-s{padding:80px 60px}
.sp-s-sm{padding:56px 60px}
.sp-s-title{font-size:10px;font-weight:900;letter-spacing:3px;text-transform:uppercase;margin-bottom:36px;display:flex;justify-content:space-between;align-items:center}
.sp-s-title a{font-size:9px;color:var(--grey);letter-spacing:1px;font-weight:600;border-bottom:1px solid var(--border);padding-bottom:2px;transition:color .2s}
.sp-s-title a:hover{color:var(--black)}

/* ── CATEGORIES ── */
.sp-cat-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;grid-template-rows:340px 260px;gap:3px}
.sp-cat-card{position:relative;overflow:hidden;cursor:pointer;background:var(--black);display:block}
.sp-cat-card:nth-child(1){grid-row:span 2}
.sp-cat-inner{position:absolute;inset:0;transition:transform .6s ease}
.sp-cat-card:hover .sp-cat-inner{transform:scale(1.04)}
.sp-cat-grad{position:absolute;inset:0;background:linear-gradient(to top,rgba(26,20,16,.85) 0%,rgba(26,20,16,.2) 55%,transparent 100%)}
.sp-cat-info{position:absolute;bottom:0;left:0;right:0;padding:24px 28px}
.sp-cat-name{font-family:'Bebas Neue',sans-serif;font-size:20px;color:var(--white);letter-spacing:2px;margin-bottom:4px}
.sp-cat-sub{font-size:9px;color:rgba(255,255,255,.55);letter-spacing:1.5px;text-transform:uppercase}
.sp-c1{background:linear-gradient(160deg,#3D2314,#7B4F3A,#C8956C)}
.sp-c2{background:linear-gradient(140deg,#E8C9A0,#A0714F)}
.sp-c3{background:linear-gradient(140deg,#F5B8C4,#C9B8E8)}
.sp-c4{background:linear-gradient(140deg,#9BAF8A,#7B9AB5)}
.sp-c5{background:linear-gradient(140deg,#1A1410,#3D2314)}
.sp-c6{background:linear-gradient(140deg,#7B9AB5,#C9B8E8)}

/* ── BEST SELLERS ── */
.sp-bs-scroll{display:flex;gap:18px;overflow-x:auto;scrollbar-width:none;padding-bottom:4px}
.sp-bs-scroll::-webkit-scrollbar{display:none}
.sp-pc{min-width:210px;flex-shrink:0}
.sp-pc-img{aspect-ratio:3/4;position:relative;overflow:hidden;margin-bottom:14px}
.sp-pc-tag{position:absolute;top:10px;left:10px;background:var(--black);color:var(--white);font-size:7px;font-weight:900;padding:4px 8px;letter-spacing:1px;text-transform:uppercase;z-index:2}
.sp-pc-swatch{width:100%;height:100%}
.sp-pc-brand{font-size:7px;font-weight:900;letter-spacing:2px;color:var(--grey);text-transform:uppercase;margin-bottom:3px}
.sp-pc-name{font-size:13px;font-weight:600;margin-bottom:7px;line-height:1.3}
.sp-pc-prices{display:flex;align-items:center;gap:7px;margin-bottom:10px}
.sp-pc-price{font-size:15px;font-weight:900}
.sp-pc-was{font-size:11px;color:var(--grey);text-decoration:line-through}
.sp-dots-row{display:flex;gap:5px;margin-bottom:11px}
.sp-dot{width:13px;height:13px;border-radius:50%;border:1px solid rgba(0,0,0,.12);cursor:pointer;transition:transform .15s}
.sp-dot:hover{transform:scale(1.35)}
.sp-pc-btn{width:100%;padding:10px;background:var(--black);color:var(--white);font-size:8px;font-weight:900;letter-spacing:2px;text-transform:uppercase;transition:background .2s;font-family:'DM Sans',sans-serif;display:block;text-align:center}
.sp-pc-btn:hover{background:var(--grey)}

/* ── SHADE FINDER ── */
.sp-shade-s{background:var(--cream);text-align:center;padding:80px 60px}
.sp-shade-big{font-family:'Bebas Neue',sans-serif;font-size:clamp(40px,6vw,68px);letter-spacing:5px;margin-bottom:6px}
.sp-shade-hint{font-size:13px;color:var(--grey);font-style:italic;margin-bottom:52px}
.sp-shade-row{display:flex;justify-content:center;gap:24px;flex-wrap:wrap}
.sp-sh-circle{width:76px;height:76px;border-radius:50%;cursor:pointer;border:3px solid transparent;transition:all .25s;box-shadow:0 6px 24px rgba(0,0,0,.18)}
.sp-sh-circle:hover{transform:scale(1.18);border-color:var(--black)}

/* ── MANIFESTO ── */
.sp-manifesto{background:var(--black);padding:110px 60px;text-align:center}
.sp-mani-pre{font-size:9px;font-weight:700;letter-spacing:4px;color:var(--gold);text-transform:uppercase;margin-bottom:36px}
.sp-mani-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(50px,9vw,120px);color:var(--white);line-height:.92;letter-spacing:3px;margin-bottom:44px}
.sp-mani-p{font-size:14px;color:rgba(255,255,255,.45);max-width:460px;margin:0 auto 48px;line-height:1.9;font-weight:300}
.sp-mani-btn{padding:16px 52px;background:var(--white);color:var(--black);font-size:10px;font-weight:900;letter-spacing:3px;text-transform:uppercase;transition:all .2s;font-family:'DM Sans',sans-serif;display:inline-block}
.sp-mani-btn:hover{background:var(--gold);color:var(--white)}

/* ── KITS ── */
.sp-kits-wrap{display:grid;grid-template-columns:1fr 1fr;gap:3px;margin-bottom:3px}
.sp-kit-card{position:relative;min-height:520px;overflow:hidden;cursor:pointer;display:block}
.sp-kit-bg{position:absolute;inset:0}
.sp-kit-fade{position:absolute;inset:0;background:linear-gradient(to top,var(--white) 0%,rgba(255,255,255,.7) 45%,transparent 100%)}
.sp-kit-body{position:absolute;bottom:0;left:0;right:0;z-index:2;padding:36px}
.sp-kit-badge{display:inline-block;background:var(--black);color:var(--white);font-size:8px;font-weight:900;padding:5px 10px;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:12px}
.sp-kit-name{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:2px;color:var(--black);margin-bottom:6px}
.sp-kit-items{font-size:11px;color:var(--grey);margin-bottom:14px;line-height:1.6}
.sp-kit-pr{display:flex;align-items:baseline;gap:10px;margin-bottom:18px}
.sp-kit-p{font-size:28px;font-weight:900}
.sp-kit-cp{font-size:14px;color:var(--grey);text-decoration:line-through}
.sp-kit-cta{width:100%;padding:14px;background:var(--black);color:var(--white);font-size:10px;font-weight:900;letter-spacing:2px;text-transform:uppercase;transition:background .2s;font-family:'DM Sans',sans-serif;display:block;text-align:center}
.sp-kit-cta:hover{background:var(--gold)}
.sp-both-banner{background:var(--gold);padding:20px 40px;display:flex;align-items:center;justify-content:center;gap:20px;cursor:pointer;text-decoration:none}
.sp-both-banner span{font-size:11px;font-weight:900;letter-spacing:3px;text-transform:uppercase;color:var(--white)}
.sp-both-banner strong{font-size:18px;color:var(--white);font-weight:900}

/* ── HOW IT WORKS ── */
.sp-hiw{display:grid;grid-template-columns:repeat(3,1fr);gap:60px}
.sp-hiw-n{font-family:'Bebas Neue',sans-serif;font-size:80px;color:rgba(26,20,16,.05);line-height:1;margin-bottom:14px}
.sp-hiw-t{font-size:12px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px}
.sp-hiw-d{font-size:13px;color:var(--grey);line-height:1.8}

/* ── TIKTOK ── */
.sp-tt-s{background:var(--black);padding:80px 60px}
.sp-tt-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(36px,5vw,56px);color:var(--white);letter-spacing:4px;margin-bottom:10px;text-align:center}
.sp-tt-sub{font-size:12px;color:rgba(255,255,255,.35);text-align:center;margin-bottom:40px;letter-spacing:1px;text-transform:uppercase}
.sp-tt-row{display:flex;gap:14px;overflow-x:auto;scrollbar-width:none}
.sp-tt-row::-webkit-scrollbar{display:none}
.sp-tt-card{min-width:170px;flex-shrink:0;aspect-ratio:9/16;border-radius:10px;overflow:hidden;position:relative;cursor:pointer}
.sp-tt-inner{position:absolute;inset:0}
.sp-tt-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.8) 0%,transparent 55%)}
.sp-tt-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;color:var(--white);font-size:16px;backdrop-filter:blur(4px)}
.sp-tt-meta{position:absolute;bottom:0;left:0;right:0;padding:14px}
.sp-tt-handle{font-size:11px;font-weight:700;color:var(--white);margin-bottom:3px}
.sp-tt-likes{font-size:9px;color:rgba(255,255,255,.55);letter-spacing:1px}

/* ── REVIEWS ── */
.sp-rev-s{background:var(--cream);padding:80px 60px}
.sp-rev-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(36px,5vw,56px);letter-spacing:4px;margin-bottom:40px;text-align:center}
.sp-rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.sp-rev-card{background:var(--white);padding:28px;border-left:3px solid var(--gold)}
.sp-rev-stars{color:var(--gold);font-size:12px;letter-spacing:3px;margin-bottom:14px}
.sp-rev-text{font-size:13px;color:var(--black);line-height:1.75;font-style:italic;margin-bottom:16px}
.sp-rev-name{font-size:10px;font-weight:700;color:var(--grey);letter-spacing:1px;text-transform:uppercase}

/* ── CREATOR STUDIO ── */
.sp-cs-s{background:var(--black);padding:100px 60px;text-align:center}
.sp-cs-pre{font-size:9px;font-weight:700;letter-spacing:4px;color:var(--gold);text-transform:uppercase;margin-bottom:28px}
.sp-cs-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(44px,7vw,96px);color:var(--white);line-height:.92;letter-spacing:3px;margin-bottom:24px}
.sp-cs-p{font-size:14px;color:rgba(255,255,255,.4);max-width:440px;margin:0 auto 48px;line-height:1.9;font-weight:300}
.sp-cs-tiers{display:flex;gap:14px;justify-content:center;margin-bottom:48px;flex-wrap:wrap}
.sp-cs-tier{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);padding:22px 26px;text-align:left;min-width:190px}
.sp-cs-tier-lbl{font-size:8px;font-weight:900;letter-spacing:2px;color:var(--gold);text-transform:uppercase;margin-bottom:8px}
.sp-cs-tier-val{font-size:12px;font-weight:700;color:var(--white);line-height:1.5}
.sp-cs-btn{padding:16px 52px;background:var(--white);color:var(--black);font-size:10px;font-weight:900;letter-spacing:3px;text-transform:uppercase;transition:all .2s;font-family:'DM Sans',sans-serif;display:inline-block}
.sp-cs-btn:hover{background:var(--gold);color:var(--white)}

/* ── VALUES BAR ── */
.sp-vals{display:flex;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.sp-val{flex:1;padding:22px 16px;text-align:center;border-right:1px solid var(--border)}
.sp-val:last-child{border-right:none}
.sp-val-icon{font-size:18px;margin-bottom:5px}
.sp-val-lbl{font-size:8px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;line-height:1.4}
.sp-val-sub{font-size:9px;color:var(--grey);margin-top:3px}

/* ── FOOTER ── */
.sp-footer{background:var(--black);padding:64px 60px 36px}
.sp-ft-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;margin-bottom:48px}
.sp-ft-logo{font-family:'Bebas Neue',sans-serif;font-size:38px;color:var(--white);letter-spacing:4px;margin-bottom:8px}
.sp-ft-tag{font-size:12px;color:rgba(255,255,255,.28);font-style:italic;margin-bottom:26px}
.sp-ft-email-row{display:flex}
.sp-ft-input{flex:1;padding:12px 16px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-right:none;color:var(--white);font-size:12px;outline:none;font-family:'DM Sans',sans-serif}
.sp-ft-input::placeholder{color:rgba(255,255,255,.25)}
.sp-ft-sub{padding:12px 20px;background:var(--white);color:var(--black);font-size:9px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;font-family:'DM Sans',sans-serif;border:none;cursor:pointer}
.sp-ft-sub:hover{background:var(--gold);color:var(--white)}
.sp-ft-col-h{font-size:8px;font-weight:900;color:var(--white);letter-spacing:2px;text-transform:uppercase;margin-bottom:16px}
.sp-ft-lnk{display:block;font-size:12px;color:rgba(255,255,255,.35);margin-bottom:8px;transition:color .2s}
.sp-ft-lnk:hover{color:var(--white)}
.sp-ft-bottom{border-top:1px solid rgba(255,255,255,.06);padding-top:24px;display:flex;justify-content:space-between;font-size:10px;color:rgba(255,255,255,.25)}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .sp-header{padding:0 20px}
  .sp-nav{display:none}
  .sp-ham{display:flex}
  .sp-s,.sp-s-sm{padding:52px 20px}
  .sp-shade-s,.sp-manifesto,.sp-tt-s,.sp-rev-s,.sp-cs-s{padding:64px 20px}
  .sp-hero-content{padding:0 24px 64px;max-width:100%}
  .sp-hero-tones{right:20px;bottom:64px}
  .sp-hero-h1{font-size:clamp(48px,12vw,72px)}
  .sp-cat-grid{grid-template-columns:1fr 1fr;grid-template-rows:auto}
  .sp-cat-card:nth-child(1){grid-row:span 1;grid-column:span 2;height:280px}
  .sp-cat-card{height:180px}
  .sp-kits-wrap{grid-template-columns:1fr}
  .sp-kit-card{min-height:420px}
  .sp-hiw{grid-template-columns:1fr;gap:36px}
  .sp-rev-grid{grid-template-columns:1fr}
  .sp-cs-tiers{flex-direction:column;align-items:center}
  .sp-cs-tier{width:100%;max-width:320px}
  .sp-ft-grid{grid-template-columns:1fr 1fr;gap:32px}
  .sp-ft-grid>div:first-child{grid-column:span 2}
  .sp-vals{flex-wrap:wrap}
  .sp-val{min-width:50%;border-bottom:1px solid var(--border)}
  .sp-footer{padding:48px 20px 32px}
  .sp-ft-bottom{flex-direction:column;gap:8px}
  .sp-both-banner{flex-direction:column;gap:8px;padding:20px}
}
@media(max-width:480px){
  .sp-hero{height:100svh}
  .sp-hero-h1{font-size:clamp(42px,14vw,60px)}
  .sp-hero-ctas{flex-direction:column}
  .sp-btn-w,.sp-btn-o{width:100%;text-align:center}
  .sp-cat-card:nth-child(1){height:220px}
  .sp-cat-card{height:150px}
  .sp-shade-row{gap:16px}
  .sp-sh-circle{width:58px;height:58px}
  .sp-tt-card{min-width:145px}
  .sp-pc{min-width:180px}
}
</style>

<div class="sculps-page">

<!-- MOBILE NAV -->
<nav class="sp-mob-nav" id="sculps-mobNav">
  <button class="sp-mob-close" onclick="document.getElementById('sculps-mobNav').classList.remove('open')">✕</button>
  <a href="/collections/all" onclick="document.getElementById('sculps-mobNav').classList.remove('open')">Shop</a>
