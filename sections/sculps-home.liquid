{%- comment -%}sculps-home.liquid — SCULPS Custom Homepage (content only, no layout chrome){%- endcomment -%}

<!-- HERO -->
<section class="sp-hero"{% if section.settings.hero_image %} style="background-image:url('{{ section.settings.hero_image | image_url: width: 2000 }}');background-size:cover;background-position:center;"{% endif %}>
  <div class="sp-hero-bg"></div>
  <div class="sp-hero-img-layer"></div>
  <div class="sp-hero-grad"></div>
  <div class="sp-hero-content">
    <div class="sp-hero-pre">{{ section.settings.hero_pre | default: 'New Collection — SCULPS 2025' }}</div>
    <h1 class="sp-hero-h1">{{ section.settings.hero_headline | default: 'Invisible<br>Support.<br>Visible<br>Confidence.' | newline_to_br }}</h1>
    <p class="sp-hero-sub">{{ section.settings.hero_sub | default: 'Seamless. Sculpted. You.' }}</p>
    <div class="sp-hero-ctas">
      <a href="{{ section.settings.hero_btn1_url | default: '/collections/all' }}" class="sp-btn-w">{{ section.settings.hero_btn1_label | default: 'Shop Now' }}</a>
      <a href="{{ section.settings.hero_btn2_url | default: '/collections/kits' }}" class="sp-btn-o">{{ section.settings.hero_btn2_label | default: 'View Kits' }}</a>
    </div>
  </div>
  <div class="sp-hero-tones">
    <span class="sp-hero-tones-lbl">6 tones</span>
    <div class="sp-htone" style="background:var(--tone1)" title="Porcelain" data-href="/collections/intimates"></div>
    <div class="sp-htone" style="background:var(--tone2)" title="Light" data-href="/collections/intimates"></div>
    <div class="sp-htone" style="background:var(--tone3)" title="Medium" data-href="/collections/intimates"></div>
    <div class="sp-htone" style="background:var(--tone4)" title="Tan" data-href="/collections/intimates"></div>
    <div class="sp-htone" style="background:var(--tone5)" title="Deep" data-href="/collections/intimates"></div>
    <div class="sp-htone" style="background:var(--tone6)" title="Rich" data-href="/collections/intimates"></div>
  </div>
</section>

