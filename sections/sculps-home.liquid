<!-- BEST SELLERS -->
<section class="sp-s-sm">
  <div class="sp-s-title">
    <span>{{ section.settings.bs_title | default: 'Best Sellers' }}</span>
    <a href="/collections/all">View All →</a>
  </div>
  <div class="sp-bs-scroll">
    {%- if section.settings.bs_collection != blank -%}
      {%- assign bs_col = collections[section.settings.bs_collection] -%}
      {%- assign bs_limit = section.settings.bs_limit | default: 6 -%}
      {%- for product in bs_col.products limit: bs_limit -%}
        <div class="sp-pc">
          <div class="sp-pc-img" style="display:block;aspect-ratio:3/4;position:relative;overflow:hidden;margin-bottom:14px">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">
            {%- else -%}
              <div class="sp-pc-swatch" style="background:var(--cream)"></div>
            {%- endif -%}
            {%- assign first_tag = product.tags | first -%}
            {%- if first_tag != blank -%}<div class="sp-pc-tag">{{ first_tag }}</div>{%- endif -%}
            <div class="sp-pc-quick-add"><span>Quick Add</span></div>
          </div>
          <div class="sp-pc-brand">SCULPS</div>
          <div class="sp-pc-name">{{ product.title }}</div>
          <div class="sp-pc-prices">
            <span class="sp-pc-price">{{ product.price | money }}</span>
            {%- if product.compare_at_price > product.price -%}
              <span class="sp-pc-was">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
          {%- comment -%}Determine if skin-tone or color product{%- endcomment -%}
          {%- assign is_tone = false -%}
          {%- for opt in product.options -%}
            {%- if opt == 'Shade' or opt == 'Tone' or opt == 'Skin Tone' -%}{%- assign is_tone = true -%}{%- endif -%}
          {%- endfor -%}
          {%- if is_tone -%}
            <div class="sp-dots-row">
              <div class="sp-dot" style="background:var(--tone1)" title="Porcelain"></div>
              <div class="sp-dot" style="background:var(--tone2)" title="Light"></div>
              <div class="sp-dot" style="background:var(--tone3)" title="Medium"></div>
              <div class="sp-dot" style="background:var(--tone4)" title="Tan"></div>
              <div class="sp-dot" style="background:var(--tone5)" title="Deep"></div>
              <div class="sp-dot" style="background:var(--tone6)" title="Rich"></div>
            </div>
          {%- else -%}
            <div class="sp-dots-row">
              <div class="sp-dot" style="background:var(--pink)" title="Baby Pink"></div>
              <div class="sp-dot" style="background:var(--sage)" title="Sage Green"></div>
              <div class="sp-dot" style="background:var(--lav)" title="Lavender"></div>
              <div class="sp-dot" style="background:var(--steel)" title="Steel Blue"></div>
            </div>
          {%- endif -%}
          <button class="sp-pc-btn sp-atc-btn"
            data-variant-id="{{ product.first_available_variant.id }}"
            data-product-id="{{ product.id }}"
            type="button">Add to Bag</button>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%}Fallback static products when no collection selected{%- endcomment -%}
      {%- assign best_seller_handles = 'sculps-lift-inserts,sculps-nipple-covers,sculps-invisible-thong,sculps-seamless-brief,sculps-terry-pouch,sculps-summer-set' | split: ',' -%}
      {%- assign bs_tags = 'Best Seller,6 Tones,No Lines,Waistband,Iconic,Drop Now' | split: ',' -%}
      {%- assign bs_gradients = 'linear-gradient(160deg,#F5E6D8 0%,#C8956C 100%),linear-gradient(160deg,#E8C9A0 0%,#A0714F 100%),linear-gradient(160deg,#C8956C 0%,#7B4F3A 100%),linear-gradient(160deg,#F5B8C4 0%,#C9B8E8 100%),linear-gradient(160deg,#9BAF8A 0%,#7B9AB5 100%),linear-gradient(160deg,#C9B8E8 0%,#9BAF8A 100%)' | split: ',' -%}
      {%- assign bs_was = '$75,$28,$24,$32,$45,$85' | split: ',' -%}
      {%- for handle in best_seller_handles -%}
        {%- assign product = all_products[handle] -%}
        {%- assign grad = bs_gradients[forloop.index0] -%}
        {%- assign tag = bs_tags[forloop.index0] -%}
        {%- assign was = bs_was[forloop.index0] -%}
        <div class="sp-pc">
          <a href="{{ product.url }}" class="sp-pc-img" style="display:block">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">
            {%- else -%}
              <div class="sp-pc-swatch" style="background:{{ grad }}"></div>
            {%- endif -%}
            <div class="sp-pc-tag">{{ tag }}</div>
          </a>
          <div class="sp-pc-brand">SCULPS</div>
          <div class="sp-pc-name">{{ product.title | remove: 'Sculps ' }}</div>
          <div class="sp-pc-prices">
            <span class="sp-pc-price">{{ product.price | money }}</span>
            <span class="sp-pc-was">{{ was }}</span>
          </div>
          {%- if forloop.index <= 3 -%}
          <div class="sp-dots-row">
            <div class="sp-dot" style="background:var(--tone1)" title="Porcelain"></div>
            <div class="sp-dot" style="background:var(--tone2)" title="Light"></div>
            <div class="sp-dot" style="background:var(--tone3)" title="Medium"></div>
            <div class="sp-dot" style="background:var(--tone4)" title="Tan"></div>
            <div class="sp-dot" style="background:var(--tone5)" title="Deep"></div>
            <div class="sp-dot" style="background:var(--tone6)" title="Rich"></div>
          </div>
          {%- else -%}
          <div class="sp-dots-row">
            <div class="sp-dot" style="background:var(--pink)" title="Baby Pink"></div>
            <div class="sp-dot" style="background:var(--sage)" title="Sage Green"></div>
            <div class="sp-dot" style="background:var(--lav)" title="Lavender"></div>
            <div class="sp-dot" style="background:var(--steel)" title="Steel Blue"></div>
          </div>
          {%- endif -%}
          <a href="{{ product.url }}" class="sp-pc-btn">Add to Bag</a>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

