{%- assign v0 = product.selected_or_first_available_variant -%}
{%- assign tone_hex    = '#F5E6D8,#E8C9A0,#C8956C,#A0714F,#7B4F3A,#3D2314' | split: ',' -%}
{%- assign tone_names  = 'PORCELAIN,LIGHT,MEDIUM,TAN,DEEP,RICH'             | split: ',' -%}
{%- assign color_hex   = '#F5B8C4,#9BAF8A,#C9B8E8,#7B9AB5'                  | split: ',' -%}
{%- assign color_names = 'ROSE,SAGE,LAVENDER,SLATE'                          | split: ',' -%}

{%- comment -%} ── SCHEMA ──────────────────────────────────────────────── {%- endcomment -%}
{% schema %}
{
  "name": "Sculps Product",
  "tag": "section",
  "class": "sculps-product-section",
  "settings": [],
  "blocks": [
    {
      "type": "images",
      "name": "Product Images",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title_price",
      "name": "Title & Price",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_stars",    "label": "Show star rating",   "default": true },
        { "type": "number",   "id": "review_count",  "label": "Review count",        "default": 847  }
      ]
    },
    {
      "type": "bullet_points",
      "name": "Bullet Points",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "b1", "label": "Bullet 1", "default": "Medical grade silicone — safe for all skin types" },
        { "type": "text", "id": "b2", "label": "Bullet 2", "default": "Reusable 40+ wears with proper care" },
        { "type": "text", "id": "b3", "label": "Bullet 3", "default": "Invisible under any outfit" },
        { "type": "text", "id": "b4", "label": "Bullet 4", "default": "Available in 6 skin tones" }
      ]
    },
    {
      "type": "skin_tone",
      "name": "Skin Tone Selector",
      "limit": 1,
      "settings": []
    },
    {
      "type": "size",
      "name": "Size Selector",
      "limit": 1,
      "settings": []
    },
    {
      "type": "add_to_cart",
      "name": "Add to Cart",
      "limit": 1,
      "settings": [
        { "type": "text",     "id": "btn_text", "label": "Button text", "default": "ADD TO CART" },
        { "type": "text",     "id": "note",     "label": "Below-button note", "default": "Free shipping over $75 · 30-day returns" }
      ]
    },
    {
      "type": "whats_included",
      "name": "What's Included",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading",  "default": "WHAT'S INCLUDED" },
        { "type": "text", "id": "i1",      "label": "Item 1",   "default": "1 Pair Lift Inserts" },
        { "type": "text", "id": "i2",      "label": "Item 2",   "default": "Carry Pouch" },
        { "type": "text", "id": "i3",      "label": "Item 3",   "default": "Care Instructions" }
      ]
    },
    {
      "type": "fbt",
      "name": "Frequently Bought Together",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "FREQUENTLY BOUGHT TOGETHER" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust Badges",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "t1i", "label": "Badge 1 icon",     "default": "shield"  },
        { "type": "text", "id": "t1l", "label": "Badge 1 label",    "default": "INVISIBLE DESIGN" },
        { "type": "text", "id": "t1s", "label": "Badge 1 subtext",  "default": "Seamless under any outfit." },
        { "type": "text", "id": "t2i", "label": "Badge 2 icon",     "default": "refresh" },
        { "type": "text", "id": "t2l", "label": "Badge 2 label",    "default": "REUSABLE" },
        { "type": "text", "id": "t2s", "label": "Badge 2 subtext",  "default": "40+ wears with care." },
        { "type": "text", "id": "t3i", "label": "Badge 3 icon",     "default": "drop"    },
        { "type": "text", "id": "t3l", "label": "Badge 3 label",    "default": "MEDICAL GRADE" },
        { "type": "text", "id": "t3s", "label": "Badge 3 subtext",  "default": "Safe, skin-friendly silicone." },
        { "type": "text", "id": "t4i", "label": "Badge 4 icon",     "default": "heart"   },
        { "type": "text", "id": "t4l", "label": "Badge 4 label",    "default": "MADE FOR YOU" },
        { "type": "text", "id": "t4s", "label": "Badge 4 subtext",  "default": "All body types. All skin tones." }
      ]
    },
    {
      "type": "reviews",
      "name": "Reviews",
      "limit": 1,
      "settings": [
        { "type": "text",   "id": "heading", "label": "Section heading", "default": "REAL REVIEWS FROM REAL WOMEN" },
        { "type": "text",   "id": "r1t",     "label": "Review 1 text",   "default": "Finally a product that actually stays on." },
        { "type": "text",   "id": "r1n",     "label": "Review 1 name",   "default": "Jasmine R." },
        { "type": "number", "id": "r1s",     "label": "Review 1 stars",  "default": 5 },
        { "type": "text",   "id": "r2t",     "label": "Review 2 text",   "default": "The skin tone match is absolutely perfect." },
        { "type": "text",   "id": "r2n",     "label": "Review 2 name",   "default": "Sofia M." },
        { "type": "number", "id": "r2s",     "label": "Review 2 stars",  "default": 5 },
        { "type": "text",   "id": "r3t",     "label": "Review 3 text",   "default": "I've tried every brand and SCULPS is by far the best." },
        { "type": "text",   "id": "r3n",     "label": "Review 3 name",   "default": "Amara K." },
        { "type": "number", "id": "r3s",     "label": "Review 3 stars",  "default": 5 },
        { "type": "text",   "id": "r4t",     "label": "Review 4 text",   "default": "Ordered for my sister too. We're obsessed." },
        { "type": "text",   "id": "r4n",     "label": "Review 4 name",   "default": "Priya S." },
        { "type": "number", "id": "r4s",     "label": "Review 4 stars",  "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sculps Product",
      "blocks": [
        { "type": "images" },
        { "type": "title_price" },
        { "type": "bullet_points" },
        { "type": "skin_tone" },
        { "type": "size" },
        { "type": "add_to_cart" },
        { "type": "whats_included" },
        { "type": "fbt" },
        { "type": "trust" },
        { "type": "reviews" }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%} ── CSS ─────────────────────────────────────────────────── {%- endcomment -%}
<style>
  /* ── Reset & base ───────────────────────────────────────────────────── */
  .sp { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1a1a1a; }
  .sp *, .sp *::before, .sp *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── Layout ─────────────────────────────────────────────────────────── */
  .sp-wrap     { max-width: 520px; margin: 0 auto; padding: 0 16px 60px; }

  /* ── Gallery ────────────────────────────────────────────────────────── */
  .sp-gallery  { position: relative; overflow: hidden; border-radius: 12px; background: #faf9f7; margin-bottom: 8px; }
  .sp-slides   { display: flex; transition: transform .35s ease; will-change: transform; }
  .sp-slide    { min-width: 100%; aspect-ratio: 1/1; overflow: hidden; }
  .sp-slide img{ width: 100%; height: 100%; object-fit: cover; display: block; }
  .sp-arrow    { position: absolute; top: 50%; transform: translateY(-50%);
                 background: rgba(255,255,255,.85); border: none; border-radius: 50%;
                 width: 36px; height: 36px; cursor: pointer; font-size: 18px;
                 display: flex; align-items: center; justify-content: center;
                 box-shadow: 0 2px 8px rgba(0,0,0,.15); z-index: 2; }
  .sp-arrow-l  { left: 10px; }
  .sp-arrow-r  { right: 10px; }
  .sp-dots     { display: flex; justify-content: center; gap: 6px; padding: 10px 0 4px; }
  .sp-dot      { width: 7px; height: 7px; border-radius: 50%; background: #ccc; border: none;
                 cursor: pointer; padding: 0; transition: background .2s; }
  .sp-dot.active { background: #1a1a1a; }
  .sp-thumbs   { display: flex; gap: 8px; overflow-x: auto; padding: 4px 0 12px;
                 scrollbar-width: none; }
  .sp-thumbs::-webkit-scrollbar { display: none; }
  .sp-thumb    { min-width: 64px; width: 64px; height: 64px; border-radius: 8px;
                 overflow: hidden; cursor: pointer; border: 2px solid transparent;
                 flex-shrink: 0; transition: border-color .2s; }
  .sp-thumb.active { border-color: #1a1a1a; }
  .sp-thumb img{ width: 100%; height: 100%; object-fit: cover; }

  /* ── Stars ──────────────────────────────────────────────────────────── */
  .sp-stars    { display: flex; align-items: center; gap: 6px; margin: 16px 0 4px; }
  .sp-star-row { color: #e8a000; font-size: 17px; letter-spacing: 1px; }
  .sp-rev-cnt  { font-size: 13px; color: #555; }

  /* ── Title / price ──────────────────────────────────────────────────── */
  .sp-title    { font-size: clamp(20px, 5vw, 26px); font-weight: 800;
                 letter-spacing: .04em; text-transform: uppercase; line-height: 1.15;
                 margin-bottom: 10px; }
  .sp-price-row{ display: flex; align-items: baseline; gap: 10px; margin-bottom: 14px; }
  .sp-price    { font-size: 22px; font-weight: 700; }
  .sp-compare  { font-size: 16px; color: #999; text-decoration: line-through; }
  .sp-badge    { font-size: 11px; font-weight: 700; background: #e85c3a;
                 color: #fff; padding: 3px 8px; border-radius: 4px; letter-spacing: .05em; }

  /* ── Bullets ────────────────────────────────────────────────────────── */
  .sp-bullets  { list-style: none; margin: 0 0 20px; }
  .sp-bullets li{ display: flex; align-items: flex-start; gap: 8px;
                  font-size: 14px; line-height: 1.45; padding: 4px 0; }
  .sp-bullets li::before { content: '✓'; color: #4a9e6f; font-weight: 700;
                            flex-shrink: 0; margin-top: 1px; }

  /* ── Section label ──────────────────────────────────────────────────── */
  .sp-label    { font-size: 11px; font-weight: 700; letter-spacing: .1em;
                 text-transform: uppercase; color: #555; margin-bottom: 10px; }

  /* ── Skin-tone swatches ─────────────────────────────────────────────── */
  .sp-tones    { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
  .sp-tone     { width: 38px; height: 38px; border-radius: 50%; border: 3px solid transparent;
                 cursor: pointer; position: relative; transition: border-color .2s; }
  .sp-tone.sel { border-color: #1a1a1a; }
  .sp-tone-tip { position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%);
                 background: #1a1a1a; color: #fff; font-size: 10px; font-weight: 600;
                 white-space: nowrap; padding: 3px 7px; border-radius: 4px;
                 pointer-events: none; opacity: 0; transition: opacity .15s; }
  .sp-tone:hover .sp-tone-tip,
  .sp-tone.sel  .sp-tone-tip { opacity: 1; }

  /* ── Size buttons ───────────────────────────────────────────────────── */
  .sp-sizes    { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
  .sp-size-btn { min-width: 56px; padding: 9px 14px; border: 1.5px solid #ccc;
                 border-radius: 6px; font-size: 13px; font-weight: 600;
                 cursor: pointer; background: #fff; transition: border-color .2s, background .2s; }
  .sp-size-btn:hover  { border-color: #888; }
  .sp-size-btn.sel    { border-color: #1a1a1a; background: #1a1a1a; color: #fff; }
  .sp-size-btn.unavail{ opacity: .35; cursor: not-allowed; text-decoration: line-through; }

  /* ── ATC form ───────────────────────────────────────────────────────── */
  .sp-form     { margin-bottom: 10px; }
  .sp-atc      { width: 100%; padding: 16px; border: none; border-radius: 8px;
                 background: #1a1a1a; color: #fff; font-size: 15px; font-weight: 700;
                 letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
                 transition: opacity .2s; }
  .sp-atc:hover{ opacity: .85; }
  .sp-atc:disabled { opacity: .45; cursor: not-allowed; }
  .sp-note     { font-size: 12px; color: #777; text-align: center; margin-top: 8px; }

  /* ── What's Included ───────────────────────────────────────────────── */
  .sp-incl     { border: 1.5px solid #e8e8e8; border-radius: 10px;
                 padding: 16px 20px; margin-bottom: 24px; }
  .sp-incl-h   { font-size: 12px; font-weight: 700; letter-spacing: .1em;
                 text-transform: uppercase; margin-bottom: 12px; }
  .sp-incl-list{ list-style: none; }
  .sp-incl-list li { display: flex; align-items: center; gap: 8px;
                     font-size: 14px; padding: 4px 0; }
  .sp-incl-list li::before { content: '•'; color: #1a1a1a; font-size: 18px; line-height: 1; }

  /* ── FBT ────────────────────────────────────────────────────────────── */
  .sp-fbt      { background: #faf9f7; border-radius: 12px; padding: 20px 16px; margin-bottom: 24px; }
  .sp-fbt-h    { font-size: 12px; font-weight: 700; letter-spacing: .1em;
                 text-transform: uppercase; margin-bottom: 16px; }
  .sp-fbt-row  { display: flex; align-items: center; gap: 8px; overflow-x: auto;
                 scrollbar-width: none; }
  .sp-fbt-row::-webkit-scrollbar { display: none; }
  .sp-fbt-item { flex-shrink: 0; text-align: center; width: 100px; }
  .sp-fbt-img  { width: 80px; height: 80px; object-fit: cover; border-radius: 8px;
                 display: block; margin: 0 auto 6px; }
  .sp-fbt-name { font-size: 11px; font-weight: 600; line-height: 1.3; }
  .sp-fbt-price{ font-size: 12px; color: #555; margin-top: 2px; }
  .sp-fbt-plus { font-size: 22px; color: #ccc; flex-shrink: 0; }
  .sp-fbt-total{ margin-top: 14px; }
  .sp-fbt-atc  { width: 100%; padding: 13px; border: 2px solid #1a1a1a; border-radius: 8px;
                 background: transparent; color: #1a1a1a; font-size: 14px; font-weight: 700;
                 letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
                 transition: background .2s, color .2s; }
  .sp-fbt-atc:hover { background: #1a1a1a; color: #fff; }

  /* ── Trust badges ───────────────────────────────────────────────────── */
  .sp-trust    { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 32px; }
  .sp-trust-item{ display: flex; align-items: flex-start; gap: 10px;
                  background: #faf9f7; border-radius: 10px; padding: 14px 12px; }
  .sp-trust-ico { font-size: 22px; flex-shrink: 0; }
  .sp-trust-l  { font-size: 11px; font-weight: 700; letter-spacing: .06em;
                 text-transform: uppercase; }
  .sp-trust-s  { font-size: 12px; color: #666; margin-top: 2px; line-height: 1.4; }

  /* ── Reviews ────────────────────────────────────────────────────────── */
  .sp-reviews  { margin-bottom: 32px; }
  .sp-rev-h    { font-size: 13px; font-weight: 700; letter-spacing: .08em;
                 text-transform: uppercase; margin-bottom: 16px; }
  .sp-rev-card { background: #faf9f7; border-radius: 10px; padding: 16px;
                 margin-bottom: 12px; }
  .sp-rev-stars{ color: #e8a000; font-size: 14px; margin-bottom: 6px; }
  .sp-rev-text { font-size: 14px; line-height: 1.55; margin-bottom: 8px; font-style: italic; }
  .sp-rev-name { font-size: 12px; font-weight: 700; color: #555; }

  /* ── Divider ────────────────────────────────────────────────────────── */
  .sp-divider  { height: 1px; background: #ebebeb; margin: 22px 0; }
</style>

{%- comment -%} ── HTML ────────────────────────────────────────────────── {%- endcomment -%}
<div class="sp">
  <div class="sp-wrap">

    {%- for block in section.blocks -%}

      {%- comment -%} ═══════════════════════════════════════════════
          BLOCK: images
      ═══════════════════════════════════════════════ {%- endcomment -%}
      {%- if block.type == 'images' -%}
        {%- assign imgs = product.images -%}
        {%- if imgs.size > 0 -%}
          <div class="sp-gallery" {{ block.shopify_attributes }}>
            <div class="sp-slides" id="sp-slides">
              {%- for img in imgs -%}
                <div class="sp-slide">
                  <img src="{{ img | image_url: width: 800 }}"
                       alt="{{ img.alt | escape }}"
                       loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                       width="800" height="800">
                </div>
              {%- endfor -%}
            </div>
            {%- if imgs.size > 1 -%}
              <button class="sp-arrow sp-arrow-l" id="sp-prev" aria-label="Previous">&#8249;</button>
              <button class="sp-arrow sp-arrow-r" id="sp-next" aria-label="Next">&#8250;</button>
            {%- endif -%}
          </div>

          {%- if imgs.size > 1 -%}
            <div class="sp-dots" id="sp-dots">
              {%- for img in imgs -%}
                <button class="sp-dot{% if forloop.first %} active{% endif %}"
                        data-idx="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}"></button>
              {%- endfor -%}
            </div>
            <div class="sp-thumbs" id="sp-thumbs">
              {%- for img in imgs -%}
                <div class="sp-thumb{% if forloop.first %} active{% endif %}" data-idx="{{ forloop.index0 }}">
                  <img src="{{ img | image_url: width: 120 }}"
                       alt="{{ img.alt | escape }}" loading="lazy" width="120" height="120">
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} ═══════════════════════════════════════════════
          BLOCK: title_price
      ═══════════════════════════════════════════════ {%- endcomment -%}
      {%- if block.type == 'title_price' -%}
        {%- if block.settings.show_stars -%}
          <div class="sp-stars" {{ block.shopify_attributes }}>
            <span class="sp-star-row">★★★★★</span>
            <span class="sp-rev-cnt">{{ block.settings.review_count }} reviews</span>
          </div>
        {%- endif -%}
        <h1 class="sp-title">{{ product.title }}</h1>
        <div class="sp-price-row">
          <span class="sp-price">{{ v0.price | money }}</span>
          {%- if v0.compare_at_price > v0.price -%}
            <span class="sp-compare">{{ v0.compare_at_price | money }}</span>
            {%- assign pct = v0.compare_at_price | minus: v0.price
                             | times: 100 | divided_by: v0.compare_at_price -%}
            <span class="sp-badge">{{ pct }}% OFF</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ═══════════════════════════════════════════════
          BLOCK: bullet_points
      ═══════════════════════════════════════════════ {%- endcomment -%}
      {%- if block.type == 'bullet_points' -%}
        <ul class="sp-bullets" {{ block.shopify_attributes }}>
          {%- for i in (1..4) -%}
            {%- assign bkey = 'b' | append: i -%}
            {%- assign bval = block.settings[bkey] -%}
            {%- if bval != blank -%}<li>{{ bval }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} ═══════════════════════════════════════════════
          BLOCK: skin_tone
      ═══════════════════════════════════════════════ {%- endcomment -%}
      {%- if block.type == 'skin_tone' -%}
        {%- comment -%}
          Detect whether a "Skin Tone" option exists on the product.
          If it does we let the swatches drive variant selection;
          if it doesn't we render a purely decorative guide.
        {%- endcomment -%}
        {%- assign tone_opt_idx = nil -%}
        {%- for opt in product.options -%}
          {%- assign opt_lower = opt | downcase -%}
          {%- if opt_lower == 'skin tone' or opt_lower == 'tone' or opt_lower == 'shade' -%}
            {%- assign tone_opt_idx = forloop.index0 -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="sp-label"
             {{ block.shopify_attributes }}>Choose your skin tone</div>
        <div class="sp-tones" id="sp-tones">
          {%- for i in (0..5) -%}
            {%- assign th = tone_hex[i]   -%}
            {%- assign tn = tone_names[i] -%}
            <button class="sp-tone{% if forloop.first %} sel{% endif %}"
                    type="button"
                    data-tone-idx="{{ i }}"
                    data-tone-name="{{ tn }}"
                    aria-label="{{ tn }}"
                    style="background:{{ th }};">
              <span class="sp-tone-tip">{{ tn }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ═══════════════════════════════════════════════
          BLOCK: size
      ═══════════════════════════════════════════════ {%- endcomment -%}
      {%- if block.type == 'size' -%}
        {%- assign size_opt_idx = nil -%}
        {%- for opt in product.options -%}
          {%- assign opt_lower = opt | downcase -%}
          {%- if opt_lower == 'size' -%}
            {%- assign size_opt_idx = forloop.index0 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if size_opt_idx != nil -%}
          {%- assign size_values = product.options_with_values[size_opt_idx].values -%}
          <div class="sp-label" {{ block.shopify_attributes }}>Select size</div>
          <div class="sp-sizes" id="sp-sizes">
            {%- for sv in size_values -%}
              {%- assign sv_up = sv | upcase -%}
              <button class="sp-size-btn{% if forloop.first %} sel{% endif %}"
                      type="button"
                      data-size="{{ sv }}"
                      aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                {{ sv_up }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} ═══════════════════════════════════════════════
          BLOCK: add_to_cart
      ═══════════════════════════════════════════════ {%- endcomment -%}
      {%- if block.type == 'add_to_cart' -%}
        <form action="/cart/add" method="post" class="sp-form"
              {{ block.shopify_attributes }} id="sp-form">
          <input type="hidden" name="id" id="sp-variant-id"
                 value="{{ v0.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="sp-atc" id="sp-atc"
                  {% unless v0.available %}disabled{% endunless %}>
            {%- if v0.available -%}
              {{ block.settings.btn_text | default: 'ADD TO CART' }}
            {%- else -%}
              SOLD OUT
            {%- endif -%}
          </button>
        </form>
        {%- if block.settings.note != blank -%}
          <p class="sp-note">{{ block.settings.note }}</p>
        {%- endif -%}
        <div class="sp-divider"></div>
      {%- endif -%}

      {%- comment -%} ═══════════════════════════════════════════════
          BLOCK: whats_included
      ═══════════════════════════════════════════════ {%- endcomment -%}
      {%- if block.type == 'whats_included' -%}
        <div class="sp-incl" {{ block.shopify_attributes }}>
          <div class="sp-incl-h">{{ block.settings.heading }}</div>
          <ul class="sp-incl-list">
            {%- for i in (1..3) -%}
              {%- assign ikey = 'i' | append: i -%}
              {%- assign ival = block.settings[ikey] -%}
              {%- if ival != blank -%}<li>{{ ival }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%} ═══════════════════════════════════════════════
          BLOCK: fbt  (Frequently Bought Together)
      ═══════════════════════════════════════════════ {%- endcomment -%}
      {%- if block.type == 'fbt' -%}
        {%- assign coll = collections['all'] -%}
        {%- assign fbt_products = coll.products | where: 'available', true -%}
        {%- unless fbt_products.size > 1 -%}
          {%- assign fbt_products = collections.all.products -%}
        {%- endunless -%}

        <div class="sp-fbt" {{ block.shopify_attributes }}>
          <div class="sp-fbt-h">{{ block.settings.heading }}</div>
          <div class="sp-fbt-row">

            {%- comment -%} Current product (always first) {%- endcomment -%}
            <div class="sp-fbt-item">
              {%- if product.featured_image -%}
                <img class="sp-fbt-img"
                     src="{{ product.featured_image | image_url: width: 160 }}"
                     alt="{{ product.title | escape }}" loading="lazy">
              {%- endif -%}
              <div class="sp-fbt-name">{{ product.title }}</div>
              <div class="sp-fbt-price">{{ v0.price | money }}</div>
            </div>

            {%- comment -%} Up to 2 companion products from collection {%- endcomment -%}
            {%- assign fbt_shown = 0 -%}
            {%- for fp in fbt_products -%}
              {%- if fbt_shown >= 2 -%}{%- break -%}{%- endif -%}
              {%- if fp.id == product.id -%}{%- continue -%}{%- endif -%}
              <span class="sp-fbt-plus">+</span>
              <div class="sp-fbt-item" data-fbt-id="{{ fp.variants.first.id }}">
                {%- if fp.featured_image -%}
                  <img class="sp-fbt-img"
                       src="{{ fp.featured_image | image_url: width: 160 }}"
                       alt="{{ fp.title | escape }}" loading="lazy">
                {%- endif -%}
                <div class="sp-fbt-name">{{ fp.title }}</div>
                <div class="sp-fbt-price">{{ fp.price | money }}</div>
              </div>
              {%- assign fbt_shown = fbt_shown | plus: 1 -%}
            {%- endfor -%}
          </div>

          <div class="sp-fbt-total">
            <button type="button" class="sp-fbt-atc" id="sp-fbt-btn"
                    data-main-id="{{ v0.id }}">Add All to Cart</button>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ═══════════════════════════════════════════════
          BLOCK: trust
      ═══════════════════════════════════════════════ {%- endcomment -%}
      {%- if block.type == 'trust' -%}
        {%- assign icon_map = 'shield:🛡️,refresh:🔄,drop:💧,heart:❤️,star:⭐,check:✅,lock:🔒,truck:🚚' | split: ',' -%}
        <div class="sp-trust" {{ block.shopify_attributes }}>
          {%- for ti in (1..4) -%}
            {%- assign tii = 't' | append: ti | append: 'i' -%}
            {%- assign til = 't' | append: ti | append: 'l' -%}
            {%- assign tis = 't' | append: ti | append: 's' -%}
            {%- assign icon_key  = block.settings[tii] | default: 'star' -%}
            {%- assign icon_label = block.settings[til] -%}
            {%- assign icon_sub  = block.settings[tis] -%}

            {%- comment -%} Map key → emoji {%- endcomment -%}
            {%- assign resolved_icon = '⭐' -%}
            {%- for pair in icon_map -%}
              {%- assign kv = pair | split: ':' -%}
              {%- if kv[0] == icon_key -%}{%- assign resolved_icon = kv[1] -%}{%- endif -%}
            {%- endfor -%}

            <div class="sp-trust-item">
              <div class="sp-trust-ico">{{ resolved_icon }}</div>
              <div>
                <div class="sp-trust-l">{{ icon_label }}</div>
                <div class="sp-trust-s">{{ icon_sub }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ═══════════════════════════════════════════════
          BLOCK: reviews
      ═══════════════════════════════════════════════ {%- endcomment -%}
      {%- if block.type == 'reviews' -%}
        <div class="sp-reviews" {{ block.shopify_attributes }}>
          <div class="sp-rev-h">{{ block.settings.heading }}</div>
          {%- for ri in (1..4) -%}
            {%- assign rt = 'r' | append: ri | append: 't' -%}
            {%- assign rn = 'r' | append: ri | append: 'n' -%}
            {%- assign rs = 'r' | append: ri | append: 's' -%}
            {%- assign rv_text = block.settings[rt] -%}
            {%- assign rv_name = block.settings[rn] -%}
            {%- assign rv_stars = block.settings[rs] | default: 5 -%}
            {%- if rv_text != blank -%}
              <div class="sp-rev-card">
                <div class="sp-rev-stars">
                  {%- for s in (1..rv_stars) -%}★{%- endfor -%}
                </div>
                <div class="sp-rev-text">&ldquo;{{ rv_text }}&rdquo;</div>
                <div class="sp-rev-name">— {{ rv_name }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    {%- endfor -%}
  </div>{%- comment -%}/.sp-wrap{%- endcomment -%}
</div>{%- comment -%}/.sp{%- endcomment -%}

{%- comment -%} ── JS ──────────────────────────────────────────────────── {%- endcomment -%}
<script>
(function () {
  'use strict';

  /* ── helpers ─────────────────────────────────────────────────────── */
  const $ = (sel, ctx = document) => ctx.querySelector(sel);
  const $$ = (sel, ctx = document) => [...ctx.querySelectorAll(sel)];

  /* ── 1. Gallery ──────────────────────────────────────────────────── */
  const slides   = $('#sp-slides');
  const dots     = $$('.sp-dot');
  const thumbs   = $$('.sp-thumb');
  let   cur      = 0;
  const total    = $$('.sp-slide').length;

  function goTo(n) {
    cur = (n + total) % total;
    if (slides) slides.style.transform = `translateX(-${cur * 100}%)`;
    dots.forEach((d, i)   => d.classList.toggle('active', i === cur));
    thumbs.forEach((t, i) => t.classList.toggle('active', i === cur));
  }

  const prev = $('#sp-prev');
  const next = $('#sp-next');
  if (prev) prev.addEventListener('click', () => goTo(cur - 1));
  if (next) next.addEventListener('click', () => goTo(cur + 1));
  dots.forEach(d   => d.addEventListener('click', () => goTo(+d.dataset.idx)));
  thumbs.forEach(t => t.addEventListener('click', () => goTo(+t.dataset.idx)));

  /* touch swipe */
  if (slides) {
    let sx = 0;
    slides.addEventListener('touchstart', e => { sx = e.touches[0].clientX; }, { passive: true });
    slides.addEventListener('touchend',   e => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 40) goTo(dx < 0 ? cur + 1 : cur - 1);
    });
  }

  /* ── 2. Variant data ─────────────────────────────────────────────── */
  const VARIANTS = {{ product.variants | json }};
  const OPTIONS  = {{ product.options | json }};

  /* index of 'Skin Tone'/'Size' options (case-insensitive) */
  const toneOptIdx = OPTIONS.findIndex(o =>
    ['skin tone','tone','shade'].includes(o.toLowerCase()));
  const sizeOptIdx = OPTIONS.findIndex(o => o.toLowerCase() === 'size');

  /* current selections — keyed by option index */
  const sel = {};
  OPTIONS.forEach((_, i) => { sel[i] = null; });

  /* initialise from first available variant */
  const firstAvail = VARIANTS.find(v => v.available) || VARIANTS[0];
  if (firstAvail) {
    OPTIONS.forEach((_, i) => {
      sel[i] = firstAvail[`option${i + 1}`];
    });
  }

  /* resolve best matching variant from current sel object */
  function resolveVariant() {
    return VARIANTS.find(v =>
      OPTIONS.every((_, i) =>
        sel[i] == null || v[`option${i + 1}`] === sel[i]
      )
    ) || VARIANTS[0];
  }

  /* ── 3. Skin-tone swatches ───────────────────────────────────────── */
  const TONE_NAMES  = {{ tone_names | json }};

  $$('.sp-tone').forEach(btn => {
    btn.addEventListener('click', () => {
      $$('.sp-tone').forEach(b => b.classList.remove('sel'));
      btn.classList.add('sel');

      const name = btn.dataset.toneName;          // e.g. "MEDIUM"
      if (toneOptIdx >= 0) {
        /* Try to match variant option to tone name */
        sel[toneOptIdx] = name;
        applyVariant();
      }
    });
  });

  /* ── 4. Size buttons ─────────────────────────────────────────────── */
  $$('.sp-size-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.classList.contains('unavail')) return;
      $$('.sp-size-btn').forEach(b => {
        b.classList.remove('sel');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('sel');
      btn.setAttribute('aria-pressed', 'true');

      if (sizeOptIdx >= 0) {
        sel[sizeOptIdx] = btn.dataset.size;
        applyVariant();
      }
    });
  });

  /* ── 5. applyVariant — sync UI to resolved variant ──────────────── */
  function applyVariant() {
    const v = resolveVariant();
    if (!v) return;

    /* update hidden input + button */
    const idInput = $('#sp-variant-id');
    const atcBtn  = $('#sp-atc');
    if (idInput) idInput.value = v.id;
    if (atcBtn) {
      atcBtn.disabled = !v.available;
      atcBtn.textContent = v.available ? atcBtn.dataset.addText || 'ADD TO CART' : 'SOLD OUT';
    }

    /* mark unavailable sizes */
    $$('.sp-size-btn').forEach(btn => {
      const testSel = { ...sel };
      if (sizeOptIdx >= 0) testSel[sizeOptIdx] = btn.dataset.size;
      const match = VARIANTS.find(v2 =>
        OPTIONS.every((_, i) => testSel[i] == null || v2[`option${i + 1}`] === testSel[i])
      );
      btn.classList.toggle('unavail', !!(match && !match.available));
    });

    /* update FBT main-product id */
    const fbtBtn = $('#sp-fbt-btn');
    if (fbtBtn) fbtBtn.dataset.mainId = v.id;
  }

  /* run once on load */
  applyVariant();

  /* ── 6. ATC form — native Shopify cart POST ──────────────────────── */
  /* The <form action="/cart/add"> already handles submission natively. */
  /* We just need to stop the page from navigating if JS cart is active. */
  const spForm = $('#sp-form');
  if (spForm) {
    spForm.addEventListener('submit', async function (e) {
      const btn = $('#sp-atc');
      const variantId = $('#sp-variant-id')?.value;
      if (!variantId) return; /* let native submit handle it */

      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'ADDING…';

      try {
        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        });
        if (!res.ok) throw new Error('cart error');
        btn.textContent = 'ADDED ✓';
        /* Refresh cart count if theme exposes it */
        document.dispatchEvent(new CustomEvent('cart:updated'));
        setTimeout(() => { btn.disabled = false; applyVariant(); }, 1800);
      } catch {
        btn.disabled = false;
        applyVariant();
        /* fall back to native form submit */
        spForm.submit();
      }
    });
  }

  /* ── 7. FBT — Add All to Cart ────────────────────────────────────── */
  const fbtBtn = $('#sp-fbt-btn');
  if (fbtBtn) {
    fbtBtn.addEventListener('click', async () => {
      const ids = [fbtBtn.dataset.mainId,
        ...$$('[data-fbt-id]').map(el => el.dataset.fbtId)
      ].filter(Boolean);

      fbtBtn.disabled = true;
      fbtBtn.textContent = 'ADDING…';

      try {
        await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: ids.map(id => ({ id, quantity: 1 })) })
        });
        fbtBtn.textContent = 'ADDED TO CART ✓';
        document.dispatchEvent(new CustomEvent('cart:updated'));
        setTimeout(() => {
          fbtBtn.disabled = false;
          fbtBtn.textContent = 'Add All to Cart';
        }, 2000);
      } catch {
        fbtBtn.disabled = false;
        fbtBtn.textContent = 'Add All to Cart';
      }
    });
  }

})();
</script>