
{%- assign v0 = product.selected_or_first_available_variant -%}
{%- assign tone_colors = '#F5E6D8,#E8C9A0,#C8956C,#A0714F,#7B4F3A,#3D2314' | split: ',' -%}
{%- assign tone_labels = 'Porcelain,Light,Medium,Tan,Deep,Rich' | split: ',' -%}
{%- assign color_swatches = '#F5B8C4,#9BAF8A,#C9B8E8,#7B9AB5' | split: ',' -%}

<!-- ============================================================
     SIZE GUIDE MODAL
============================================================ -->
<div class="sp-sg-overlay" id="sp-sg-overlay" aria-hidden="true">
  <div class="sp-sg-modal" role="dialog" aria-modal="true" aria-label="Size Guide">
    <button class="sp-sg-close" id="sp-sg-close" type="button" aria-label="Close">&#x2715;</button>
    <div class="sp-sg-h">SIZE GUIDE</div>
    <div class="sp-sg-sh">Bras &amp; Lift Inserts — Chest</div>
    <table class="sp-sg-table">
      <thead><tr><th>Size</th><th>Cup</th><th>Bust</th></tr></thead>
      <tbody>
        <tr><td>1</td><td>A/B Cup</td><td>30–34"</td></tr>
        <tr><td>2</td><td>C/D Cup</td><td>34–36"</td></tr>
        <tr><td>3</td><td>DD/E Cup</td><td>36–38"</td></tr>
        <tr><td>4</td><td>F Cup</td><td>38–40"</td></tr>
        <tr><td>5</td><td>G+ Cup</td><td>40+"</td></tr>
      </tbody>
    </table>
    <div class="sp-sg-sh" style="margin-top:20px">Bottoms — Thong, Brief, Sets</div>
    <table class="sp-sg-table">
      <thead><tr><th>Size</th><th>Waist</th><th>Hips</th></tr></thead>
      <tbody>
        <tr><td>1 (XS)</td><td>24–26"</td><td>34–36"</td></tr>
        <tr><td>2 (S)</td><td>26–28"</td><td>36–38"</td></tr>
        <tr><td>3 (M)</td><td>28–30"</td><td>38–40"</td></tr>
        <tr><td>4 (L)</td><td>30–34"</td><td>40–44"</td></tr>
        <tr><td>5 (XL)</td><td>34–40"</td><td>44–50"</td></tr>
      </tbody>
    </table>
    <p class="sp-sg-note">Between sizes? Size up.</p>
  </div>
</div>

<!-- ============================================================
     LIGHTBOX
============================================================ -->
<div class="sp-lb-overlay" id="sp-lb-overlay" aria-hidden="true">
  <button class="sp-lb-close" id="sp-lb-close" type="button" aria-label="Close">&#x2715;</button>
  <button class="sp-lb-nav sp-lb-prev" id="sp-lb-prev" type="button" aria-label="Previous">&#8249;</button>
  <img class="sp-lb-img" id="sp-lb-img" src="" alt="">
  <button class="sp-lb-nav sp-lb-next" id="sp-lb-next" type="button" aria-label="Next">&#8250;</button>
</div>

<!-- ============================================================
     STICKY ATC (appears when main ATC scrolls out of view)
============================================================ -->
<div class="sp-satc" id="sp-satc" aria-hidden="true">
  <div class="sp-satc-info">
    {%- if product.featured_image -%}
      <img class="sp-satc-thumb" src="{{ product.featured_image | image_url: width: 80 }}" alt="{{ product.title | escape }}" loading="lazy">
    {%- endif -%}
    <div>
      <div class="sp-satc-name">{{ product.title }}</div>
      <div class="sp-satc-price" id="sp-satc-price">{{ v0.price | money }}</div>
    </div>
  </div>
  <button class="sp-satc-btn" id="sp-satc-btn" type="button">ADD TO CART</button>
</div>

<!-- ============================================================
     MAIN PRODUCT LAYOUT
============================================================ -->
<div class="sp-pdp">

  <!-- ──────────────────────────────────────────────────────────
       LEFT — IMAGE GALLERY
  ────────────────────────────────────────────────────────────── -->
  <div class="sp-pdp-gallery">
    {%- if product.images.size > 0 -%}
      <!-- Main image -->
      <div class="sp-pdp-main-wrap">
        <img id="sp-main-img"
          class="sp-pdp-main-img"
          src="{{ product.images[0] | image_url: width: 900 }}"
          alt="{{ product.images[0].alt | default: product.title | escape }}"
          loading="eager"
          width="900">
        <button class="sp-pdp-zoom-btn" id="sp-zoom-btn" type="button"
          data-zoom="{{ product.images[0] | image_url: width: 2000 }}"
          aria-label="Zoom image">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </div>
      <!-- Thumbnails -->
      {%- if product.images.size > 1 -%}
        <div class="sp-pdp-thumbs">
          {%- for img in product.images -%}
            <button class="sp-pdp-thumb{%- if forloop.first %} active{%- endif -%}"
              type="button"
              data-full="{{ img | image_url: width: 900 }}"
              data-zoom="{{ img | image_url: width: 2000 }}"
              aria-label="Image {{ forloop.index }}">
              <img src="{{ img | image_url: width: 120 }}" alt="{{ img.alt | escape }}" loading="lazy" width="120">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <!-- Placeholder when no product images are uploaded -->
      <div class="sp-pdp-no-img">
        <svg width="48" height="48" fill="none" stroke="#ccc" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg>
        <p>Upload images in<br><strong>Shopify Admin → Products → {{ product.title }}</strong></p>
      </div>
    {%- endif -%}
  </div>

  <!-- ──────────────────────────────────────────────────────────
       RIGHT — PRODUCT INFO (BLOCKS)
  ────────────────────────────────────────────────────────────── -->
  <div class="sp-pdp-info">

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        <!-- ================================================== -->
        {%- when 'product_header' -%}
        <!-- ================================================== -->
        <div class="sp-pdp-header" {{ block.shopify_attributes }}>
          <p class="sp-pdp-vendor">{{ product.vendor | upcase }}</p>
          <h1 class="sp-pdp-title">{{ product.title }}</h1>
          <div class="sp-pdp-price-row">
            <span class="sp-pdp-price" id="sp-price">{{ v0.price | money }}</span>
            {%- if v0.compare_at_price > v0.price -%}
              <span class="sp-pdp-compare" id="sp-compare">{{ v0.compare_at_price | money }}</span>
              <span class="sp-pdp-save" id="sp-save">SAVE {{ v0.compare_at_price | minus: v0.price | money }}</span>
            {%- endif -%}
          </div>
          {%- if block.settings.show_stars -%}
            <div class="sp-pdp-stars">
              <span class="sp-stars-row">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
              <span class="sp-pdp-rc">({{ block.settings.rating_count | default: 0 }} reviews)</span>
            </div>
          {%- endif -%}
          {%- if block.settings.tagline != blank -%}
            <p class="sp-pdp-tagline">{{ block.settings.tagline }}</p>
          {%- endif -%}
        </div>

        <!-- ================================================== -->
        {%- when 'bullet_points' -%}
        <!-- ================================================== -->
        {%- assign has_b = false -%}
        {%- for n in (1..6) -%}{%- assign bk = 'bullet_' | append: n -%}{%- if block.settings[bk] != blank -%}{%- assign has_b = true -%}{%- endif -%}{%- endfor -%}
        {%- if has_b -%}
          <ul class="sp-pdp-bullets" {{ block.shopify_attributes }}>
            {%- for n in (1..6) -%}
              {%- assign bk = 'bullet_' | append: n -%}
              {%- if block.settings[bk] != blank -%}
                <li>{{ block.settings[bk] }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div {{ block.shopify_attributes }}></div>
        {%- endif -%}

        <!-- ================================================== -->
        {%- when 'bundle_items' -%}
        <!-- ================================================== -->
        {%- if block.settings.bundle_label != blank -%}
          <div class="sp-pdp-bundle" {{ block.shopify_attributes }}>
            <div class="sp-pdp-bundle-label">{{ block.settings.bundle_label }}</div>
            <div class="sp-pdp-bundle-grid">
              {%- for n in (1..3) -%}
                {%- assign pk = 'product_' | append: n -%}
                {%- assign bp = block.settings[pk] -%}
                {%- if bp != blank -%}
                  {%- assign bp_img = bp.featured_image -%}
                  <div class="sp-pdp-bundle-item">
                    {%- if bp_img -%}
                      <img src="{{ bp_img | image_url: width: 120 }}" alt="{{ bp.title | escape }}" loading="lazy" class="sp-pdp-bundle-img">
                    {%- else -%}
                      <div class="sp-pdp-bundle-img sp-pdp-bundle-placeholder"></div>
                    {%- endif -%}
                    <div class="sp-pdp-bundle-name">{{ bp.title }}</div>
                    <div class="sp-pdp-bundle-price">{{ bp.price | money }}</div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <div {{ block.shopify_attributes }}></div>
        {%- endif -%}

        <!-- ================================================== -->
        {%- when 'skin_tone_selector' -%}
        <!-- ================================================== -->
        {%- assign tone_opt = nil -%}
        {%- for opt in product.options_with_values -%}
          {%- if opt.name == 'Skin Tone' or opt.name == 'Shade' or opt.name == 'Tone' or opt.name == 'Skin tone' -%}
            {%- assign tone_opt = opt -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if tone_opt -%}
          <div class="sp-pdp-opt-group" {{ block.shopify_attributes }}>
            <div class="sp-pdp-opt-label">CHOOSE YOUR SKIN TONE: <span class="sp-opt-val" id="sp-tone-val">{{ tone_opt.values | first }}</span></div>
            <div class="sp-tone-btns">
              {%- for val in tone_opt.values -%}
                {%- assign ti = forloop.index0 -%}
                {%- assign tc = tone_colors[ti] | default: '#ccc' -%}
                {%- assign tl = tone_labels[ti] | default: val -%}
                <button class="sp-tone-btn{%- if forloop.first %} active{%- endif -%}"
                  type="button"
                  data-opt-pos="{{ tone_opt.position }}"
                  data-opt-val="{{ val | escape }}"
                  style="background:{{ tc }}"
                  title="{{ tl }}">
                  <span class="sp-tone-lbl">{{ tl | upcase }}</span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <div {{ block.shopify_attributes }}></div>
        {%- endif -%}

        <!-- ================================================== -->
        {%- when 'color_selector' -%}
        <!-- ================================================== -->
        {%- assign color_opt = nil -%}
        {%- for opt in product.options_with_values -%}
          {%- if opt.name == 'Color' or opt.name == 'Colour' -%}
            {%- assign color_opt = opt -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if color_opt -%}
          <div class="sp-pdp-opt-group" {{ block.shopify_attributes }}>
            <div class="sp-pdp-opt-label">CHOOSE YOUR COLOR: <span class="sp-opt-val" id="sp-color-val">{{ color_opt.values | first }}</span></div>
            <div class="sp-color-btns">
              {%- for val in color_opt.values -%}
                {%- assign ci = forloop.index0 -%}
                {%- assign cc = color_swatches[ci] | default: '#eee' -%}
                <button class="sp-color-btn{%- if forloop.first %} active{%- endif -%}"
                  type="button"
                  data-opt-pos="{{ color_opt.position }}"
                  data-opt-val="{{ val | escape }}"
                  style="background:{{ cc }}"
                  title="{{ val | escape }}">
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <div {{ block.shopify_attributes }}></div>
        {%- endif -%}

        <!-- ================================================== -->
        {%- when 'size_selector' -%}
        <!-- ================================================== -->
        {%- assign size_opt = nil -%}
        {%- for opt in product.options_with_values -%}
          {%- if opt.name == 'Size' -%}
            {%- assign size_opt = opt -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if size_opt -%}
          <div class="sp-pdp-opt-group" {{ block.shopify_attributes }}>
            <div class="sp-pdp-opt-label-row">
              <span class="sp-pdp-opt-label">CHOOSE YOUR SIZE</span>
              <button class="sp-sg-trigger" type="button" id="sp-sg-open">SIZE GUIDE</button>
            </div>
            <div class="sp-size-btns">
              {%- for val in size_opt.values -%}
                <button class="sp-size-btn{%- if forloop.first %} active{%- endif -%}"
                  type="button"
                  data-opt-pos="{{ size_opt.position }}"
                  data-opt-val="{{ val | escape }}">{{ val }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <div {{ block.shopify_attributes }}></div>
        {%- endif -%}

        <!-- ================================================== -->
        {%- when 'add_to_cart' -%}
        <!-- ================================================== -->
        <div class="sp-pdp-atc-wrap" {{ block.shopify_attributes }}>
          {% form 'product', product, id: 'sp-product-form', novalidate: 'novalidate' %}
            <input type="hidden" name="id" id="sp-variant-id" value="{{ v0.id }}">
            <button type="submit" name="add"
              class="sp-pdp-atc-btn"
              id="sp-main-atc"
              {%- unless v0.available %} disabled{%- endunless -%}>
              <span id="sp-atc-label">
                {%- if v0.available -%}{{ block.settings.btn_text | default: 'ADD TO CART' }}{%- else -%}SOLD OUT{%- endif -%}
              </span>
              <span id="sp-atc-price">&nbsp;·&nbsp;{{ v0.price | money }}</span>
            </button>
          {% endform %}
          <p class="sp-pdp-ship">
            {%- if block.settings.shipping_note != blank -%}
              {{ block.settings.shipping_note }}
            {%- else -%}
              Free shipping over $75 &nbsp;·&nbsp; 30-day returns
            {%- endif -%}
          </p>
        </div>

        <!-- ================================================== -->
        {%- when 'whats_included' -%}
        <!-- ================================================== -->
        {%- assign has_items = false -%}
        {%- for n in (1..8) -%}{%- assign ik = 'item_' | append: n -%}{%- if block.settings[ik] != blank -%}{%- assign has_items = true -%}{%- endif -%}{%- endfor -%}
        {%- if has_items -%}
          <div class="sp-pdp-included" {{ block.shopify_attributes }}>
            <div class="sp-pdp-included-h">{{ block.settings.heading | default: "WHAT'S INCLUDED" }}</div>
            <ul class="sp-pdp-included-list">
              {%- for n in (1..8) -%}
                {%- assign ik = 'item_' | append: n -%}
                {%- if block.settings[ik] != blank -%}
                  <li><span class="sp-check">✓</span> {{ block.settings[ik] }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- else -%}
          <div {{ block.shopify_attributes }}></div>
        {%- endif -%}

        <!-- ================================================== -->
        {%- when 'trust_badges' -%}
        <!-- ================================================== -->
        <div class="sp-pdp-trust" {{ block.shopify_attributes }}>
          {%- for n in (1..4) -%}
            {%- assign lk = 'trust_' | append: n | append: '_label' -%}
            {%- assign sk = 'trust_' | append: n | append: '_sub' -%}
            {%- assign ik = 'trust_' | append: n | append: '_icon' -%}
            {%- if block.settings[lk] != blank -%}
              <div class="sp-trust-item">
                <div class="sp-trust-icon">
                  {%- case block.settings[ik] -%}
                    {%- when 'shield' -%}<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {%- when 'refresh' -%}<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><polyline points="23,4 23,10 17,10"/><polyline points="1,20 1,14 7,14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
                    {%- when 'heart' -%}<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                    {%- else -%}<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                  {%- endcase -%}
                </div>
                <div>
                  <div class="sp-trust-label">{{ block.settings[lk] }}</div>
                  {%- if block.settings[sk] != blank -%}
                    <div class="sp-trust-sub">{{ block.settings[sk] }}</div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- ================================================== -->
        {%- when 'fbt' -%}
        <!-- ================================================== -->
        {%- assign fp1 = block.settings.fbt_1 -%}
        {%- assign fp2 = block.settings.fbt_2 -%}
        {%- if fp1 != blank or fp2 != blank -%}
          <div class="sp-pdp-fbt" {{ block.shopify_attributes }}>
            <div class="sp-pdp-fbt-h">{{ block.settings.fbt_heading | default: 'FREQUENTLY BOUGHT TOGETHER' }}</div>
            <div class="sp-pdp-fbt-grid">
              {%- for n in (1..2) -%}
                {%- assign fpk = 'fbt_' | append: n -%}
                {%- assign fp = block.settings[fpk] -%}
                {%- if fp != blank -%}
                  {%- assign fpv = fp.first_available_variant -%}
                  <div class="sp-pdp-fbt-item">
                    {%- if fp.featured_image -%}
                      <a href="{{ fp.url }}"><img src="{{ fp.featured_image | image_url: width: 200 }}" alt="{{ fp.title | escape }}" class="sp-pdp-fbt-img" loading="lazy"></a>
                    {%- else -%}
                      <a href="{{ fp.url }}" class="sp-pdp-fbt-img sp-pdp-fbt-placeholder"></a>
                    {%- endif -%}
                    <div class="sp-pdp-fbt-name">{{ fp.title }}</div>
                    <div class="sp-pdp-fbt-price">{{ fp.price | money }}</div>
                    {%- if fpv -%}
                      <button class="sp-pdp-fbt-btn sp-atc-btn" type="button"
                        data-variant-id="{{ fpv.id }}">ADD TO CART</button>
                    {%- else -%}
                      <a href="{{ fp.url }}" class="sp-pdp-fbt-btn">VIEW PRODUCT</a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <div {{ block.shopify_attributes }}></div>
        {%- endif -%}

        <!-- ================================================== -->
        {%- when 'reviews' -%}
        <!-- ================================================== -->
        <div class="sp-pdp-reviews" {{ block.shopify_attributes }}>
          <div class="sp-pdp-reviews-h">{{ block.settings.heading | default: 'WHAT CUSTOMERS SAY' }}</div>
          <div class="sp-pdp-reviews-grid">
            {%- for n in (1..6) -%}
              {%- assign tk = 'review_' | append: n | append: '_text' -%}
              {%- assign nk = 'review_' | append: n | append: '_name' -%}
              {%- assign sk = 'review_' | append: n | append: '_stars' -%}
              {%- assign vk = 'review_' | append: n | append: '_verified' -%}
              {%- if block.settings[tk] != blank -%}
                {%- assign rs = block.settings[sk] | default: 5 -%}
                <div class="sp-review-card">
                  <div class="sp-review-stars">
                    {%- for i in (1..5) -%}<span style="color:{%- if i <= rs -%}#F5A623{%- else -%}#ddd{%- endif -%}">&#9733;</span>{%- endfor -%}
                  </div>
                  <p class="sp-review-text">"{{ block.settings[tk] }}"</p>
                  <div class="sp-review-author">
                    {{ block.settings[nk] | default: 'Anonymous' }}
                    {%- if block.settings[vk] -%}<span class="sp-review-badge">✓ Verified</span>{%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <!-- ================================================== -->
        {%- when 'related_products' -%}
        <!-- ================================================== -->
        {%- if collection != blank and collection.products.size > 1 -%}
          <div class="sp-pdp-related" {{ block.shopify_attributes }}>
            <div class="sp-pdp-related-h">{{ block.settings.heading | default: 'YOU MAY ALSO LIKE' }}</div>
            <div class="sp-pdp-related-grid">
              {%- for rp in collection.products limit: 4 -%}
                {%- unless rp.id == product.id -%}
                  {%- assign rpv = rp.first_available_variant -%}
                  <div class="sp-rp-card">
                    <a href="{{ rp.url }}" class="sp-rp-img-link">
                      {%- if rp.featured_image -%}
                        <img src="{{ rp.featured_image | image_url: width: 400 }}" alt="{{ rp.title | escape }}" class="sp-rp-img" loading="lazy">
                      {%- else -%}
                        <div class="sp-rp-img sp-rp-placeholder"></div>
                      {%- endif -%}
                    </a>
                    <div class="sp-rp-info">
                      <a href="{{ rp.url }}" class="sp-rp-name">{{ rp.title }}</a>
                      <div class="sp-rp-price">{{ rp.price | money }}</div>
                    </div>
                    {%- if rpv -%}
                      <button class="sp-rp-atc sp-atc-btn" type="button"
                        data-variant-id="{{ rpv.id }}">ADD TO CART</button>
                    {%- endif -%}
                  </div>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <div {{ block.shopify_attributes }}></div>
        {%- endif -%}

      {%- endcase -%}
    {%- endfor -%}

  </div><!-- /.sp-pdp-info -->
</div><!-- /.sp-pdp -->

<!-- ============================================================
     VARIANT DATA (for JS)
============================================================ -->
<script>
window.spPDP = {
  productId: {{ product.id | json }},
  variants: {{ product.variants | json }},
  money_format: {{ shop.money_format | json }},
  selected: {
    {%- for opt in product.options_with_values -%}
      {{ opt.position | json }}: {{ opt.values | first | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
};
</script>

<!-- ============================================================
     PRODUCT PAGE JAVASCRIPT
============================================================ -->
<script>
(function () {
  'use strict';

  var pdp = window.spPDP || {};
  var variants = pdp.variants || [];
  var selected = pdp.selected || {};

  /* ── Helpers ───────────────────────────────────────────────── */
  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function findVariant() {
    return variants.find(function (v) {
      return v.options.every(function (optVal, i) {
        return selected[i + 1] === optVal;
      });
    }) || variants[0];
  }

  function updateUI(v) {
    if (!v) return;

    /* hidden form input */
    var inp = document.getElementById('sp-variant-id');
    if (inp) inp.value = v.id;

    /* price */
    var priceEl   = document.getElementById('sp-price');
    var compareEl = document.getElementById('sp-compare');
    var saveEl    = document.getElementById('sp-save');
    var satcPrice = document.getElementById('sp-satc-price');
    var atcPrice  = document.getElementById('sp-atc-price');

    if (priceEl)   priceEl.textContent   = formatMoney(v.price);
    if (satcPrice) satcPrice.textContent = formatMoney(v.price);
    if (atcPrice)  atcPrice.textContent  = ' · ' + formatMoney(v.price);

    if (v.compare_at_price && v.compare_at_price > v.price) {
      if (compareEl) { compareEl.textContent = formatMoney(v.compare_at_price); compareEl.style.display = ''; }
      if (saveEl)    { saveEl.textContent = 'SAVE ' + formatMoney(v.compare_at_price - v.price); saveEl.style.display = ''; }
    } else {
      if (compareEl) compareEl.style.display = 'none';
      if (saveEl)    saveEl.style.display    = 'none';
    }

    /* ATC button */
    var atcBtn   = document.getElementById('sp-main-atc');
    var atcLabel = document.getElementById('sp-atc-label');
    var satcBtn  = document.getElementById('sp-satc-btn');
    if (atcBtn) {
      atcBtn.disabled = !v.available;
      if (atcLabel) atcLabel.textContent = v.available ? 'ADD TO CART' : 'SOLD OUT';
    }
    if (satcBtn) satcBtn.disabled = !v.available;

    /* update image to variant image if available */
    if (v.featured_image) {
      var mainImg = document.getElementById('sp-main-img');
      if (mainImg) {
        var src = v.featured_image.src.replace(/\.(jpg|jpeg|png|gif|webp)(\?|$)/i, '_900x.$1$2');
        mainImg.src = src;
        var zoomBtn = document.getElementById('sp-zoom-btn');
        if (zoomBtn) zoomBtn.dataset.zoom = v.featured_image.src.replace(/\.(jpg|jpeg|png|gif|webp)(\?|$)/i, '_2000x.$1$2');
      }
    }
  }

  /* ── Option button clicks ───────────────────────────────────── */
  function handleOptClick(e) {
    var btn = e.target.closest('[data-opt-pos]');
    if (!btn) return;

    var pos = parseInt(btn.dataset.optPos, 10);
    var val = btn.dataset.optVal;
    selected[pos] = val;

    /* mark active within group */
    var group = btn.closest('.sp-tone-btns, .sp-color-btns, .sp-size-btns');
    if (group) {
      group.querySelectorAll('[data-opt-pos]').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
    }

    /* update label text */
    if (btn.closest('.sp-tone-btns')) {
      var lbl = document.getElementById('sp-tone-val');
      if (lbl) lbl.textContent = val;
    }
    if (btn.closest('.sp-color-btns')) {
      var clbl = document.getElementById('sp-color-val');
      if (clbl) clbl.textContent = val;
    }

    updateUI(findVariant());
  }

  document.addEventListener('click', handleOptClick);

  /* ── Thumbnail clicks ───────────────────────────────────────── */
  document.addEventListener('click', function (e) {
    var thumb = e.target.closest('.sp-pdp-thumb');
    if (!thumb) return;
    var mainImg = document.getElementById('sp-main-img');
    var zoomBtn = document.getElementById('sp-zoom-btn');
    if (mainImg && thumb.dataset.full) mainImg.src = thumb.dataset.full;
    if (zoomBtn && thumb.dataset.zoom) zoomBtn.dataset.zoom = thumb.dataset.zoom;
    document.querySelectorAll('.sp-pdp-thumb').forEach(function (t) { t.classList.remove('active'); });
    thumb.classList.add('active');
  });

  /* ── Lightbox ───────────────────────────────────────────────── */
  var lbOverlay = document.getElementById('sp-lb-overlay');
  var lbImg     = document.getElementById('sp-lb-img');

  document.addEventListener('click', function (e) {
    var zBtn = e.target.closest('#sp-zoom-btn');
    if (zBtn && lbOverlay && lbImg) {
      lbImg.src = zBtn.dataset.zoom || '';
      lbOverlay.setAttribute('aria-hidden', 'false');
      lbOverlay.style.display = 'flex';
    }
    if (e.target.closest('#sp-lb-close') || e.target === lbOverlay) {
      if (lbOverlay) { lbOverlay.setAttribute('aria-hidden', 'true'); lbOverlay.style.display = 'none'; }
    }
  });

  /* ── Size guide ─────────────────────────────────────────────── */
  var sgOverlay = document.getElementById('sp-sg-overlay');
  document.addEventListener('click', function (e) {
    if (e.target.closest('#sp-sg-open')) { sgOverlay.setAttribute('aria-hidden','false'); sgOverlay.style.display='flex'; }
    if (e.target.closest('#sp-sg-close') || e.target === sgOverlay) { sgOverlay.setAttribute('aria-hidden','true'); sgOverlay.style.display='none'; }
  });

  /* ── Sticky ATC ─────────────────────────────────────────────── */
  var satcBar  = document.getElementById('sp-satc');
  var mainAtc  = document.getElementById('sp-main-atc');
  var satcBtnEl = document.getElementById('sp-satc-btn');

  if (satcBar && mainAtc) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        satcBar.classList.toggle('sp-satc--visible', !entry.isIntersecting);
        satcBar.setAttribute('aria-hidden', entry.isIntersecting ? 'true' : 'false');
      });
    }, { threshold: 0 });
    io.observe(mainAtc);
  }

  /* sticky ATC triggers the form */
  if (satcBtnEl) {
    satcBtnEl.addEventListener('click', function () {
      var form = document.getElementById('sp-product-form');
      if (form) form.requestSubmit ? form.requestSubmit() : form.submit();
    });
  }

  /* ── ATC form: add loading state ───────────────────────────── */
  var form = document.getElementById('sp-product-form');
  if (form) {
    form.addEventListener('submit', function () {
      var btn = document.getElementById('sp-main-atc');
      if (btn && !btn.disabled) {
        btn.classList.add('sp-pdp-atc-btn--loading');
        btn.disabled = true;
        setTimeout(function () {
          btn.classList.remove('sp-pdp-atc-btn--loading');
          btn.disabled = false;
        }, 2000);
      }
    });
  }

  /* ── Init ───────────────────────────────────────────────────── */
  updateUI(findVariant());

})();
</script>

