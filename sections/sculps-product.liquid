        {"type": "checkbox", "id": "show_stars",    "label": "Show star rating",  "default": true},
        {"type": "number",   "id": "rating_count",  "label": "Review count",      "default": 0},
        {"type": "text",     "id": "tagline",        "label": "Tagline (optional)", "placeholder": "e.g. Free shipping on orders over $75"}
      ]
    },
    {
      "type": "bullet_points",
      "name": "Bullet Points",
      "limit": 1,
      "settings": [
        {"type": "text", "id": "bullet_1", "label": "Bullet 1"},
        {"type": "text", "id": "bullet_2", "label": "Bullet 2"},
        {"type": "text", "id": "bullet_3", "label": "Bullet 3"},
        {"type": "text", "id": "bullet_4", "label": "Bullet 4"},
        {"type": "text", "id": "bullet_5", "label": "Bullet 5"},
        {"type": "text", "id": "bullet_6", "label": "Bullet 6"}
      ]
    },
    {
      "type": "bundle_items",
      "name": "Bundle Items",
      "limit": 1,
      "settings": [
        {"type": "text",    "id": "bundle_label", "label": "Bundle heading",  "default": "BUNDLE INCLUDES"},
        {"type": "product", "id": "product_1",    "label": "Product 1"},
        {"type": "product", "id": "product_2",    "label": "Product 2"},
        {"type": "product", "id": "product_3",    "label": "Product 3"}
      ]
    },
    {
