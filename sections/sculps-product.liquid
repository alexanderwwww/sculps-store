<style>
/* Product hero layout */
.sp-pdp-hero { display:grid; grid-template-columns:1fr 1fr; gap:48px; padding:60px 60px 40px; }
.sp-pdp-gallery { position:sticky; top:80px; align-self:start; }
.sp-pdp-main-img-wrap { aspect-ratio:3/4; overflow:hidden; background:var(--cream); margin-bottom:12px; }
.sp-pdp-main-img { width:100%; height:100%; object-fit:cover; transition:opacity .3s; }
.sp-pdp-thumbs { display:flex; gap:8px; flex-wrap:wrap; }
.sp-pdp-thumb { width:72px; height:96px; object-fit:cover; cursor:pointer; border:2px solid transparent; transition:border-color .2s; opacity:.7; }
.sp-pdp-thumb.active { border-color:var(--black); opacity:1; }
.sp-pdp-thumb:hover { opacity:1; }

/* Product info */
.sp-pdp-info { padding-top:8px; }
.sp-pdp-brand { font-size:8px; font-weight:900; letter-spacing:3px; text-transform:uppercase; color:var(--grey); margin-bottom:10px; }
.sp-pdp-title { font-family:'Bebas Neue',sans-serif; font-size:clamp(36px,5vw,54px); letter-spacing:2px; line-height:.95; margin-bottom:20px; }
.sp-pdp-price-row { display:flex; align-items:center; gap:12px; margin-bottom:24px; flex-wrap:wrap; }
.sp-pdp-price { font-size:28px; font-weight:900; }
.sp-pdp-compare { font-size:16px; color:var(--grey); text-decoration:line-through; }
.sp-pdp-save { background:var(--black); color:var(--white); font-size:9px; font-weight:900; padding:4px 10px; letter-spacing:1px; text-transform:uppercase; }

/* Variant selectors */
.sp-pdp-variants { margin-bottom:24px; }
.sp-variant-label { font-size:9px; font-weight:900; letter-spacing:2px; text-transform:uppercase; margin-bottom:12px; display:flex; align-items:center; gap:8px; }
.sp-variant-label span { font-weight:400; color:var(--grey); letter-spacing:1px; }
.sp-variant-circles { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:20px; }
.sp-variant-circle { width:36px; height:36px; border-radius:50%; cursor:pointer; border:3px solid transparent; transition:all .2s; box-shadow:0 2px 8px rgba(0,0,0,.15); position:relative; }
.sp-variant-circle:hover { transform:scale(1.15); }
.sp-variant-circle.active { border-color:var(--black); transform:scale(1.15); }
.sp-variant-circle .sp-tone-num { position:absolute; bottom:-16px; left:50%; transform:translateX(-50%); font-size:7px; font-weight:700; color:var(--grey); }

/* Size buttons */
.sp-size-btns { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:8px; }
.sp-size-btn { width:44px; height:44px; border:1.5px solid var(--black); background:var(--white); color:var(--black); font-size:13px; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all .2s; font-family:'DM Sans',sans-serif; }
.sp-size-btn:hover { background:var(--black); color:var(--white); }
.sp-size-btn.active { background:var(--black); color:var(--white); }
.sp-size-btn.sold-out { opacity:.35; cursor:not-allowed; text-decoration:line-through; }

/* Size guide link */
.sp-size-guide-link { font-size:10px; color:var(--grey); text-decoration:underline; cursor:pointer; background:none; border:none; font-family:'DM Sans',sans-serif; margin-bottom:24px; display:inline-block; transition:color .2s; }
.sp-size-guide-link:hover { color:var(--black); }

/* Add to cart */
.sp-pdp-add-wrap { margin-bottom:28px; }
.sp-pdp-add-btn { width:100%; padding:17px; background:var(--black); color:var(--white); font-size:11px; font-weight:900; letter-spacing:3px; text-transform:uppercase; border:none; cursor:pointer; font-family:'DM Sans',sans-serif; transition:background .2s; display:block; }
.sp-pdp-add-btn:hover { background:var(--grey); }
.sp-pdp-add-btn:disabled { opacity:.6; cursor:not-allowed; }

/* Product features */
.sp-pdp-features { padding:32px 0; border-top:1px solid var(--border); margin-bottom:0; }
.sp-pdp-features-h { font-size:9px; font-weight:900; letter-spacing:2px; text-transform:uppercase; margin-bottom:16px; }
.sp-pdp-feature { display:flex; align-items:flex-start; gap:10px; font-size:13px; line-height:1.5; margin-bottom:8px; color:var(--black); }
.sp-pdp-feature::before { content:'✓'; font-weight:900; color:var(--gold); flex-shrink:0; margin-top:1px; }

/* Trust badges below ATC */
.sp-pdp-trust { display:flex; gap:0; border:1px solid var(--border); margin-bottom:28px; }
.sp-pdp-trust-badge { flex:1; text-align:center; padding:14px 8px; border-right:1px solid var(--border); }
.sp-pdp-trust-badge:last-child { border-right:none; }
.sp-pdp-trust-icon { font-size:16px; display:block; margin-bottom:4px; }
.sp-pdp-trust-label { font-size:7px; font-weight:900; letter-spacing:1px; text-transform:uppercase; line-height:1.4; }

/* Sticky add to cart bar */
.sp-satc { position:fixed; bottom:0; left:0; right:0; z-index:400; background:var(--black); padding:12px 40px; display:flex; align-items:center; justify-content:space-between; gap:16px; transform:translateY(100%); transition:transform .35s cubic-bezier(.4,0,.2,1); box-shadow:0 -4px 24px rgba(0,0,0,.25); }
.sp-satc.visible { transform:translateY(0); }
.sp-satc-info { display:flex; align-items:center; gap:14px; min-width:0; flex:1; }
.sp-satc-thumb { width:40px; height:52px; object-fit:cover; flex-shrink:0; background:var(--grey); }
.sp-satc-details { min-width:0; }
.sp-satc-name { font-size:12px; font-weight:600; color:var(--white); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.sp-satc-opts { font-size:10px; color:rgba(255,255,255,.5); }
.sp-satc-price { font-size:14px; font-weight:900; color:var(--white); flex-shrink:0; }
.sp-satc-btn { padding:11px 28px; background:var(--white); color:var(--black); font-size:9px; font-weight:900; letter-spacing:2px; text-transform:uppercase; border:none; cursor:pointer; font-family:'DM Sans',sans-serif; flex-shrink:0; transition:background .2s; }
.sp-satc-btn:hover { background:var(--gold); color:var(--white); }

/* FBT section */
.sp-pdp-fbt { padding:60px 60px; background:var(--cream); }
.sp-pdp-fbt-h { font-family:'Bebas Neue',sans-serif; font-size:clamp(28px,4vw,44px); letter-spacing:3px; margin-bottom:32px; }
.sp-fbt-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
.sp-fbt-card { background:var(--white); }
.sp-fbt-card-img { aspect-ratio:3/4; overflow:hidden; background:var(--nude); }
.sp-fbt-card-img img { width:100%; height:100%; object-fit:cover; }
.sp-fbt-card-info { padding:16px; }
.sp-fbt-card-name { font-size:13px; font-weight:600; margin-bottom:6px; line-height:1.3; }
.sp-fbt-card-price { font-size:14px; font-weight:900; margin-bottom:10px; }
.sp-fbt-card-btn { width:100%; padding:10px; background:var(--black); color:var(--white); font-size:8px; font-weight:900; letter-spacing:2px; text-transform:uppercase; border:none; cursor:pointer; font-family:'DM Sans',sans-serif; transition:background .2s; }
.sp-fbt-card-btn:hover { background:var(--grey); }

/* Related products */
.sp-pdp-related { padding:60px 60px; }
.sp-pdp-related-h { font-size:10px; font-weight:900; letter-spacing:3px; text-transform:uppercase; margin-bottom:32px; display:flex; justify-content:space-between; align-items:center; }

/* Size guide modal */
.sp-sg-overlay { position:fixed; inset:0; background:rgba(26,20,16,.7); z-index:900; display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; transition:opacity .25s; }
.sp-sg-overlay.open { opacity:1; pointer-events:all; }
.sp-sg-modal { background:var(--white); max-width:560px; width:90%; max-height:80vh; overflow-y:auto; padding:40px; position:relative; transform:translateY(16px); transition:transform .25s; }
.sp-sg-overlay.open .sp-sg-modal { transform:translateY(0); }
.sp-sg-close { position:absolute; top:16px; right:20px; font-size:22px; cursor:pointer; color:var(--grey); background:none; border:none; font-family:'DM Sans',sans-serif; }
.sp-sg-h { font-family:'Bebas Neue',sans-serif; font-size:36px; letter-spacing:3px; margin-bottom:24px; }
.sp-sg-sub { font-size:11px; color:var(--grey); margin-bottom:20px; }
.sp-sg-table { width:100%; border-collapse:collapse; margin-bottom:28px; }
.sp-sg-table th,.sp-sg-table td { padding:10px 14px; text-align:left; font-size:12px; border-bottom:1px solid var(--border); }
.sp-sg-table th { font-size:9px; font-weight:900; letter-spacing:1.5px; text-transform:uppercase; color:var(--grey); }
.sp-sg-section-h { font-size:10px; font-weight:900; letter-spacing:2px; text-transform:uppercase; margin:24px 0 12px; }

/* Responsive */
@media(max-width:900px){
  .sp-pdp-hero{grid-template-columns:1fr;padding:24px 20px 32px;gap:32px}
  .sp-pdp-gallery{position:static}
  .sp-pdp-fbt{padding:52px 20px}
  .sp-fbt-grid{grid-template-columns:1fr 1fr;gap:14px}
  .sp-pdp-related{padding:52px 20px}
  .sp-satc{padding:12px 20px;gap:10px}
}
@media(max-width:480px){
  .sp-fbt-grid{grid-template-columns:repeat(3,140px);overflow-x:auto;display:flex}
  .sp-fbt-card{min-width:140px;flex-shrink:0}
  .sp-satc{flex-wrap:wrap}
  .sp-satc-btn{width:100%;text-align:center}
}
</style>

<!-- SIZE GUIDE MODAL -->
<div class="sp-sg-overlay" id="sp-sg-overlay">
  <div class="sp-sg-modal">
    <button class="sp-sg-close" id="sp-sg-close" aria-label="Close">✕</button>
    <div class="sp-sg-h">SIZE GUIDE</div>
    <p class="sp-sg-sub">Our sizes are numbered 1 to 5. No confusing letters. Just pick your number.</p>
    <div class="sp-sg-section-h">Chest Products — Lift Inserts, Invisibra</div>
    <table class="sp-sg-table">
      <thead><tr><th>Size</th><th>Bust</th><th>Cup Range</th></tr></thead>
      <tbody>
        <tr><td>1</td><td>30–34"</td><td>A/B</td></tr>
        <tr><td>2</td><td>34–36"</td><td>C/D</td></tr>
        <tr><td>3</td><td>36–38"</td><td>DD/E</td></tr>
        <tr><td>4</td><td>38–40"</td><td>F/G</td></tr>
        <tr><td>5</td><td>40+"</td><td>H+</td></tr>
      </tbody>
    </table>
    <div class="sp-sg-section-h">Bottoms — Thong, Brief, Summer Set</div>
    <table class="sp-sg-table">
      <thead><tr><th>Size</th><th>Waist</th><th>Hips</th></tr></thead>
      <tbody>
        <tr><td>1</td><td>24–26"</td><td>34–36"</td></tr>
        <tr><td>2</td><td>26–28"</td><td>36–38"</td></tr>
        <tr><td>3</td><td>28–30"</td><td>38–40"</td></tr>
        <tr><td>4</td><td>30–34"</td><td>40–44"</td></tr>
        <tr><td>5</td><td>34–40"</td><td>44–50"</td></tr>
      </tbody>
    </table>
    <p style="font-size:11px;color:var(--grey);font-style:italic">Between sizes? Size up. All products have natural stretch for comfort.</p>
  </div>
</div>

<!-- STICKY ADD TO CART BAR -->
<div class="sp-satc" id="sp-satc" data-trigger="#sp-atc-trigger">
  <div class="sp-satc-info">
    {%- if product.featured_image -%}
      <img class="sp-satc-thumb" src="{{ product.featured_image | image_url: width: 80 }}" alt="{{ product.title | escape }}">
    {%- endif -%}
    <div class="sp-satc-details">
      <div class="sp-satc-name">{{ product.title }}</div>
      <div class="sp-satc-opts" id="sp-satc-opts">Select your options</div>
    </div>
  </div>
  <div class="sp-satc-price" id="sp-satc-price">{{ product.price | money }}</div>
  <button class="sp-satc-btn sp-atc-btn"
    data-variant-id="{{ product.first_available_variant.id }}"
    id="sp-satc-atc">Add to Bag</button>
</div>

<!-- PRODUCT HERO -->
<section class="sp-pdp-hero">

  <!-- Gallery (left) -->
  <div class="sp-pdp-gallery">
    <div class="sp-pdp-main-img-wrap">
      {%- if product.featured_image -%}
        <img class="sp-pdp-main-img" id="sp-main-img"
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.title | escape }}">
      {%- else -%}
        <div style="width:100%;height:100%;background:var(--cream)"></div>
      {%- endif -%}
    </div>
    {%- if product.images.size > 1 -%}
      <div class="sp-pdp-thumbs">
        {%- for image in product.images limit: 8 -%}
          <img class="sp-pdp-thumb{% if forloop.first %} active{% endif %}"
            src="{{ image | image_url: width: 200 }}"
            data-src="{{ image | image_url: width: 800 }}"
            alt="{{ product.title | escape }} {{ forloop.index }}"
            loading="lazy">
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Info (right) -->
  <div class="sp-pdp-info">
    <div class="sp-pdp-brand">SCULPS</div>
    <h1 class="sp-pdp-title">{{ product.title }}</h1>

    <div class="sp-pdp-price-row" id="sp-price-row">
      <span class="sp-pdp-price" id="sp-price">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="sp-pdp-compare" id="sp-compare">{{ product.compare_at_price | money }}</span>
        {%- assign save_amount = product.compare_at_price | minus: product.price -%}
        <span class="sp-pdp-save">Save {{ save_amount | money }}</span>
      {%- endif -%}
    </div>

    <!-- VARIANT SELECTORS -->
    {%- assign has_skin_tone = false -%}
    {%- assign has_color = false -%}
    {%- assign has_size = false -%}
    {%- for option in product.options -%}
      {%- if option == 'Shade' or option == 'Tone' or option == 'Skin Tone' -%}
        {%- assign has_skin_tone = true -%}
      {%- elsif option == 'Color' -%}
        {%- assign has_color = true -%}
      {%- elsif option == 'Size' -%}
        {%- assign has_size = true -%}
      {%- endif -%}
    {%- endfor -%}

    <!-- Skin Tone Circles (NEVER show text labels) -->
    {%- if has_skin_tone -%}
      <div class="sp-pdp-variants">
        <div class="sp-variant-label">SELECT YOUR SHADE <span id="sp-selected-shade"></span></div>
        <div class="sp-variant-circles" id="sp-shade-circles">
          {%- assign tone_colors = '#F5E6D8,#E8C9A0,#C8956C,#A0714F,#7B4F3A,#3D2314' | split: ',' -%}
          {%- assign tone_num = 0 -%}
          {%- for variant in product.variants -%}
            {%- if forloop.index <= 6 -%}
              {%- assign tone_num = forloop.index0 -%}
              <div class="sp-variant-circle{% if forloop.first %} active{% endif %}"
                style="background:{{ tone_colors[tone_num] }}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price }}"
                data-compare="{{ variant.compare_at_price }}"
                data-available="{{ variant.available }}"
                {%- if variant.featured_image -%}data-image="{{ variant.featured_image | image_url: width: 800 }}"{%- endif -%}>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Color Circles (NEVER show text labels) -->
    {%- if has_color -%}
      <div class="sp-pdp-variants">
        <div class="sp-variant-label">SELECT YOUR COLOR <span id="sp-selected-color"></span></div>
        <div class="sp-variant-circles" id="sp-color-circles">
          {%- assign color_map = '#F5B8C4,#9BAF8A,#C9B8E8,#7B9AB5' | split: ',' -%}
          {%- assign cidx = 0 -%}
          {%- for variant in product.variants -%}
            {%- if forloop.index <= 4 -%}
              <div class="sp-variant-circle{% if forloop.first %} active{% endif %}"
                style="background:{{ color_map[cidx] }}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price }}"
                {%- if variant.featured_image -%}data-image="{{ variant.featured_image | image_url: width: 800 }}"{%- endif -%}>
              </div>
              {%- assign cidx = cidx | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Size Buttons (NUMBERS ONLY — 1, 2, 3, 4, 5 — never words) -->
    {%- if has_size -%}
      <div class="sp-pdp-variants">
        <div class="sp-variant-label">SELECT YOUR SIZE <span id="sp-selected-size"></span></div>
        <div class="sp-size-btns" id="sp-size-btns">
          {%- for variant in product.variants -%}
            {%- unless has_skin_tone or has_color -%}
              <button class="sp-size-btn{% if forloop.first %} active{% endif %}{% unless variant.available %} sold-out{% endunless %}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price }}"
                {% unless variant.available %}disabled{% endunless %}>
                {{ forloop.index }}
              </button>
            {%- endunless -%}
          {%- endfor -%}
        </div>
        <button class="sp-size-guide-link" data-open-sg>View Size Guide</button>
      </div>
    {%- endif -%}

    <!-- Hidden selected variant input -->
    <input type="hidden" id="sculps-selected-variant" value="{{ product.first_available_variant.id }}">

    <!-- Trust badges -->
    <div class="sp-pdp-trust">
      <div class="sp-pdp-trust-badge">
        <span class="sp-pdp-trust-icon">◻</span>
        <div class="sp-pdp-trust-label">Invisible<br>Design</div>
      </div>
      <div class="sp-pdp-trust-badge">
        <span class="sp-pdp-trust-icon">↺</span>
        <div class="sp-pdp-trust-label">Reusable<br>40+ Wears</div>
      </div>
      <div class="sp-pdp-trust-badge">
        <span class="sp-pdp-trust-icon">◈</span>
        <div class="sp-pdp-trust-label">Medical<br>Grade</div>
      </div>
      <div class="sp-pdp-trust-badge">
        <span class="sp-pdp-trust-icon">♡</span>
        <div class="sp-pdp-trust-label">Every<br>Body</div>
      </div>
    </div>

    <!-- Add to Bag (triggers sticky bar visibility) -->
    <div class="sp-pdp-add-wrap" id="sp-atc-trigger">
      <button class="sp-pdp-add-btn sp-atc-btn"
        id="sp-main-atc"
        data-variant-id="{{ product.first_available_variant.id }}"
        type="button">
        {%- if product.first_available_variant.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}
      </button>
    </div>

    <!-- Product Features -->
    {%- if section.settings.feature_1 != blank -%}
      <div class="sp-pdp-features">
        <div class="sp-pdp-features-h">Product Details</div>
        {%- for i in (1..8) -%}
          {%- assign feat = 'feature_' | append: i -%}
          {%- if section.settings[feat] != blank -%}
            <div class="sp-pdp-feature">{{ section.settings[feat] }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<!-- FREQUENTLY BOUGHT TOGETHER -->
{%- if section.settings.fbt_1 != blank or section.settings.fbt_2 != blank or section.settings.fbt_3 != blank -%}
<section class="sp-pdp-fbt">
  <div class="sp-pdp-fbt-h">Frequently Bought Together</div>
  <div class="sp-fbt-grid">
    {%- assign fbt_handles = '' -%}
    {%- if section.settings.fbt_1 != blank -%}{%- assign fbt_handles = fbt_handles | append: section.settings.fbt_1 | append: ',' -%}{%- endif -%}
    {%- if section.settings.fbt_2 != blank -%}{%- assign fbt_handles = fbt_handles | append: section.settings.fbt_2 | append: ',' -%}{%- endif -%}
    {%- if section.settings.fbt_3 != blank -%}{%- assign fbt_handles = fbt_handles | append: section.settings.fbt_3 -%}{%- endif -%}
    {%- assign fbt_list = fbt_handles | split: ',' -%}
    {%- for handle in fbt_list -%}
      {%- assign fbt_prod = all_products[handle] -%}
      {%- if fbt_prod.title -%}
      <div class="sp-fbt-card">
        <a href="{{ fbt_prod.url }}" class="sp-fbt-card-img" style="display:block">
          {%- if fbt_prod.featured_image -%}
            <img src="{{ fbt_prod.featured_image | image_url: width: 400 }}" alt="{{ fbt_prod.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">
          {%- endif -%}
        </a>
        <div class="sp-fbt-card-info">
          <div class="sp-fbt-card-name">{{ fbt_prod.title }}</div>
          <div class="sp-fbt-card-price">{{ fbt_prod.price | money }}</div>
          <button class="sp-fbt-card-btn sp-atc-btn"
            data-variant-id="{{ fbt_prod.first_available_variant.id }}"
            type="button">Add to Bag</button>
        </div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

<!-- TIKTOK TESTIMONIALS -->
<section class="sp-tt-s">
  <div class="sp-tt-h">{{ section.settings.pdp_tt_heading | default: 'Real Women. Real Results.' }}</div>
  <div class="sp-tt-sub">Submit your video · Get rewarded</div>
  <div class="sp-tt-row">
    {%- assign pdp_tt_gradients = 'linear-gradient(170deg,#3D2314,#7B4F3A),linear-gradient(170deg,#7B4F3A,#C8956C),linear-gradient(170deg,#7B9AB5,#C9B8E8)' | split: ',' -%}
    {%- for i in (1..3) -%}
      {%- assign h = 'pdp_tt' | append: i | append: '_handle' -%}
      {%- assign l = 'pdp_tt' | append: i | append: '_likes' -%}
      <div class="sp-tt-card">
        <div class="sp-tt-inner" style="background:{{ pdp_tt_gradients[forloop.index0] }}"></div>
        <div class="sp-tt-overlay"></div>
        <div class="sp-tt-play">▶</div>
        <div class="sp-tt-meta">
          <div class="sp-tt-handle">{{ section.settings[h] | default: '@sculps.official' }}</div>
          <div class="sp-tt-likes">{{ section.settings[l] | default: '♥ 100K' }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<!-- REVIEWS -->
<section class="sp-rev-s">
  <div class="sp-rev-h">{{ section.settings.pdp_rev_heading | default: 'Real Reviews From Real Women' }}</div>
  <div class="sp-rev-grid">
    {%- for i in (1..3) -%}
      {%- assign rt = 'pdp_rev' | append: i | append: '_text' -%}
      {%- assign rn = 'pdp_rev' | append: i | append: '_name' -%}
      {%- if section.settings[rt] != blank -%}
        <div class="sp-rev-card">
          <div class="sp-rev-stars">★★★★★</div>
          <p class="sp-rev-text">{{ section.settings[rt] }}</p>
          <div class="sp-rev-name">{{ section.settings[rn] }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<!-- RELATED PRODUCTS -->
{%- if collection -%}
  {%- assign related = collection.products -%}
  {%- if related.size > 1 -%}
    <section class="sp-pdp-related">
      <div class="sp-pdp-related-h">
        <span>You May Also Like</span>
        <a href="{{ collection.url }}" style="font-size:9px;color:var(--grey);letter-spacing:1px;font-weight:600;border-bottom:1px solid var(--border);padding-bottom:2px">View All →</a>
      </div>
      <div class="sp-bs-scroll">
        {%- for rel in related limit: 6 -%}
          {%- unless rel.handle == product.handle -%}
            <div class="sp-pc">
              <a href="{{ rel.url }}" class="sp-pc-img" style="display:block;aspect-ratio:3/4;position:relative;overflow:hidden;margin-bottom:14px">
                {%- if rel.featured_image -%}
                  <img src="{{ rel.featured_image | image_url: width: 400 }}" alt="{{ rel.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">
                {%- else -%}
                  <div style="width:100%;height:100%;background:var(--cream)"></div>
                {%- endif -%}
              </a>
              <div class="sp-pc-brand">SCULPS</div>
              <div class="sp-pc-name">{{ rel.title }}</div>
              <div class="sp-pc-prices">
                <span class="sp-pc-price">{{ rel.price | money }}</span>
                {%- if rel.compare_at_price > rel.price -%}
                  <span class="sp-pc-was">{{ rel.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
              <button class="sp-pc-btn sp-atc-btn"
                data-variant-id="{{ rel.first_available_variant.id }}"
                type="button">Add to Bag</button>
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

