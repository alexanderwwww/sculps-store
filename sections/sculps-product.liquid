.sp-sg-h{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:3px;margin-bottom:20px;color:#1A1410}
.sp-sg-sh{font-size:11px;font-weight:800;letter-spacing:2px;color:#1A1410;margin-bottom:10px}
.sp-sg-close{position:absolute;top:16px;right:16px;background:none;border:none;font-size:20px;cursor:pointer;line-height:1;color:#666}
.sp-sg-table{width:100%;border-collapse:collapse;font-size:13px;margin-bottom:4px}
.sp-sg-table th{background:#1A1410;color:#fff;padding:8px 10px;text-align:left;font-size:10px;letter-spacing:1.5px;font-weight:700}
.sp-sg-table td{padding:8px 10px;border-bottom:1px solid #f0ede8;color:#444}
.sp-sg-note{font-size:11px;color:#888;font-style:italic;margin-top:12px}

/* ── Lightbox ───────────────────────────────────────────────── */
.sp-lb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:1100;align-items:center;justify-content:center}
.sp-lb-img{max-width:90vw;max-height:90vh;object-fit:contain}
.sp-lb-close{position:absolute;top:16px;right:16px;background:none;border:none;color:#fff;font-size:28px;cursor:pointer;line-height:1;z-index:10}
.sp-lb-nav{position:absolute;top:50%;transform:translateY(-50%);background:none;border:none;color:#fff;font-size:48px;cursor:pointer;line-height:1;padding:0 16px;user-select:none}
.sp-lb-prev{left:0}
.sp-lb-next{right:0}
</style>

