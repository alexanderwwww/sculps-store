.sp-pdp-zoom-btn{position:absolute;bottom:12px;right:12px;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.9);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}
.sp-pdp-thumbs{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.sp-pdp-thumb{width:72px;height:72px;padding:2px;border:2px solid transparent;background:none;cursor:pointer;overflow:hidden}
