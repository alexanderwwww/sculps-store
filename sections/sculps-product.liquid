.sp-pdp-bundle-item{display:flex;flex-direction:column;gap:6px;text-align:center}
.sp-pdp-bundle-img{width:100%;aspect-ratio:1/1;object-fit:cover}
.sp-pdp-bundle-placeholder{aspect-ratio:1/1;background:#eee}
.sp-pdp-bundle-name{font-size:11px;font-weight:600;color:#1A1410}
.sp-pdp-bundle-price{font-size:11px;color:#666}

/* ── Sticky ATC bar ─────────────────────────────────────────── */
.sp-satc{position:fixed;top:0;left:0;right:0;z-index:200;background:#fff;border-bottom:1px solid #f0ede8;padding:10px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px;transform:translateY(-100%);transition:transform .3s;box-shadow:0 2px 12px rgba(0,0,0,.08)}
.sp-satc--visible{transform:translateY(0)}
.sp-satc-info{display:flex;align-items:center;gap:12px;overflow:hidden}
.sp-satc-thumb{width:44px;height:44px;object-fit:cover;border-radius:2px;flex-shrink:0}
.sp-satc-name{font-size:13px;font-weight:700;color:#1A1410;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sp-satc-price{font-size:13px;color:#555}
.sp-satc-btn{flex-shrink:0;padding:10px 24px;background:#1A1410;color:#fff;font-size:11px;font-weight:800;letter-spacing:2px;border:none;cursor:pointer;font-family:inherit}
.sp-satc-btn:hover{background:#333}
.sp-satc-btn:disabled{opacity:.5;cursor:default}

/* ── Size guide modal ───────────────────────────────────────── */
.sp-sg-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:1000;align-items:center;justify-content:center}
