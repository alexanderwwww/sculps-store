<!-- ========== SIZE GUIDE MODAL ========== -->
<div class="sp-sg-overlay" id="sp-sg-overlay" aria-hidden="true">
  <div class="sp-sg-modal" role="dialog" aria-modal="true" aria-label="Size Guide">
    <button class="sp-sg-close" id="sp-sg-close" aria-label="Close size guide">&#x2715;</button>
    <div class="sp-sg-h">SIZE GUIDE</div>
    <p style="font-size:12px;color:var(--grey);margin-bottom:20px;line-height:1.6">Our sizes are numbered 1–5. No confusing letters.</p>
    <div class="sp-sg-section-h">Chest Products — Lift Inserts, Invisibra</div>
    <table class="sp-sg-table">
      <thead><tr><th>Size</th><th>Bust</th></tr></thead>
      <tbody>
        <tr><td>1</td><td>30–34"</td></tr>
        <tr><td>2</td><td>34–36"</td></tr>
        <tr><td>3</td><td>36–38"</td></tr>
        <tr><td>4</td><td>38–40"</td></tr>
        <tr><td>5</td><td>40+"</td></tr>
      </tbody>
    </table>
    <div class="sp-sg-section-h" style="margin-top:24px">Bottoms — Thong, Brief, Summer Set</div>
    <table class="sp-sg-table">
      <thead><tr><th>Size</th><th>Waist</th><th>Hips</th></tr></thead>
      <tbody>
        <tr><td>1</td><td>24–26"</td><td>34–36"</td></tr>
        <tr><td>2</td><td>26–28"</td><td>36–38"</td></tr>
        <tr><td>3</td><td>28–30"</td><td>38–40"</td></tr>
        <tr><td>4</td><td>30–34"</td><td>40–44"</td></tr>
        <tr><td>5</td><td>34–40"</td><td>44–50"</td></tr>
      </tbody>
    </table>
    <p style="font-size:11px;color:var(--grey);font-style:italic;margin-top:16px">Between sizes? Size up. All products have natural stretch for comfort.</p>
  </div>
</div>

<!-- ========== LIGHTBOX ========== -->
<div class="sp-lb-overlay" id="sp-lb-overlay" aria-hidden="true">
  <button class="sp-lb-close" id="sp-lb-close" aria-label="Close">&#x2715;</button>
  <button class="sp-lb-nav sp-lb-prev" id="sp-lb-prev" aria-label="Previous image">&#8249;</button>
  <img class="sp-lb-img" id="sp-lb-img" src="" alt="{{ product.title | escape }}">
  <button class="sp-lb-nav sp-lb-next" id="sp-lb-next" aria-label="Next image">&#8250;</button>
</div>

<!-- ========== STICKY ADD TO CART BAR ========== -->
<div class="sp-satc" id="sp-satc">
  <div class="sp-satc-info">
    {%- if product.featured_image -%}
      <img class="sp-satc-thumb" src="{{ product.featured_image | image_url: width: 80 }}" alt="{{ product.title | escape }}">
    {%- endif -%}
    <div>
      <div class="sp-satc-name">{{ product.title }}</div>
      <div class="sp-satc-price" id="sp-satc-price">{{ product.price | money }}</div>
    </div>
  </div>
  <button class="sp-satc-btn sp-atc-btn" id="sp-satc-atc"
    data-variant-id="{{ product.first_available_variant.id }}"
    type="button">ADD TO CART</button>
</div>

<!-- ========== PRODUCT PAGE ========== -->

{%- comment -%}Pre-calculate option flags once{%- endcomment -%}
{%- assign has_skin_tone = false -%}
{%- assign has_color     = false -%}
{%- assign has_size      = false -%}
{%- for option in product.options -%}
  {%- if option == 'Shade' or option == 'Tone' or option == 'Skin Tone' -%}
    {%- assign has_skin_tone = true -%}
  {%- elsif option == 'Color' -%}
    {%- assign has_color = true -%}
  {%- elsif option == 'Size' -%}
    {%- assign has_size = true -%}
  {%- endif -%}
{%- endfor -%}

<div class="sp-pdp-page">

  <!-- LEFT COLUMN: image gallery block -->
  <div class="sp-pdp-col-left">
    {%- for block in section.blocks -%}
      {%- if block.type == 'image_gallery' -%}
        <div class="sp-pdp-gallery" {{ block.shopify_attributes }}>

          <!-- Main image + zoom -->
          <div class="sp-pdp-main-wrap">
            {%- if product.featured_image -%}
              <img class="sp-pdp-main-img" id="sp-main-img"
                src="{{ product.featured_image | image_url: width: 900 }}"
                alt="{{ product.title | escape }}"
                loading="eager">
            {%- else -%}
              <div style="width:100%;height:100%;background:var(--cream)"></div>
            {%- endif -%}
            <button class="sp-pdp-zoom-btn" id="sp-zoom-btn" aria-label="Zoom image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/>
                <line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
              </svg>
            </button>
          </div>

          <!-- Dot navigation -->
          {%- if product.images.size > 1 -%}
            <div class="sp-pdp-dots" id="sp-pdp-dots">
              {%- for image in product.images limit: 8 -%}
                <button class="sp-pdp-dot{%- if forloop.first %} active{%- endif -%}"
                  data-index="{{ forloop.index0 }}"
                  data-src="{{ image | image_url: width: 900 }}"
                  data-lb-src="{{ image | image_url: width: 1400 }}"
                  aria-label="Image {{ forloop.index }}"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <!-- Hidden full-res sources for lightbox -->
          <div id="sp-lb-sources" style="display:none">
            {%- for image in product.images limit: 8 -%}
              <span data-src="{{ image | image_url: width: 1400 }}"></span>
            {%- endfor -%}
          </div>

        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <!-- RIGHT COLUMN: product info blocks -->
  <div class="sp-pdp-col-right" id="sp-atc-trigger">

    <!-- Hidden selected variant -->
    <input type="hidden" id="sculps-selected-variant" value="{{ product.first_available_variant.id }}">

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'product_header' -%}
        <div class="sp-pdp-header-block" {{ block.shopify_attributes }}>
          <div class="sp-pdp-brand">SCULPS</div>
          <h1 class="sp-pdp-title">{{ product.title }}</h1>
          <div class="sp-pdp-price-row" id="sp-price-row">
            <span class="sp-pdp-price" id="sp-price">{{ product.selected_or_first_available_variant.price | money }}</span>
            {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
              <span class="sp-pdp-compare" id="sp-compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
              {%- assign save_amt = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price -%}
              <span class="sp-pdp-save">SAVE {{ save_amt | money }}</span>
            {%- endif -%}
          </div>
          <div class="sp-pdp-stars">
            <span class="sp-pdp-stars-icons">★★★★★</span>
            <span class="sp-pdp-stars-count">({{ block.settings.rating_count | default: 847 }} reviews)</span>
          </div>
        </div>

        {%- when 'bullet_points' -%}
        {%- assign any_bullet = false -%}
        {%- for i in (1..4) -%}
          {%- assign bk = 'bullet_' | append: i -%}
          {%- if block.settings[bk] != blank -%}{%- assign any_bullet = true -%}{%- endif -%}
        {%- endfor -%}
        <div class="sp-pdp-bullets" {{ block.shopify_attributes }}>
          {%- for i in (1..4) -%}
            {%- assign bk = 'bullet_' | append: i -%}
            {%- if block.settings[bk] != blank -%}
              <div class="sp-pdp-bullet">{{ block.settings[bk] }}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- when 'skin_tone_selector' -%}
        <div {{ block.shopify_attributes }}>
          {%- if has_skin_tone -%}
            {%- assign tone_colors = '#F5E6D8,#E8C9A0,#C8956C,#A0714F,#7B4F3A,#3D2314' | split: ',' -%}
            <div class="sp-pdp-variant-group">
              <div class="sp-pdp-variant-label"><span>SELECT YOUR SHADE</span></div>
              <div class="sp-variant-circles">
                {%- for variant in product.variants limit: 6 -%}
                  {%- assign tidx = forloop.index0 -%}
                  <div class="sp-variant-circle{%- if forloop.first %} active{%- endif -%}"
                    style="background:{{ tone_colors[tidx] }}"
                    data-variant-id="{{ variant.id }}"
                    data-price="{{ variant.price }}"
                    data-compare="{{ variant.compare_at_price }}"
                    data-available="{{ variant.available }}"
                    {%- if variant.featured_image -%}data-image="{{ variant.featured_image | image_url: width: 900 }}"{%- endif -%}>
                    <span class="sp-pdp-tone-num">{{ forloop.index }}</span>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- when 'color_selector' -%}
        <div {{ block.shopify_attributes }}>
          {%- if has_color -%}
            {%- assign color_map = '#F5B8C4,#9BAF8A,#C9B8E8,#7B9AB5' | split: ',' -%}
            <div class="sp-pdp-variant-group">
              <div class="sp-pdp-variant-label"><span>SELECT YOUR COLOR</span></div>
              <div class="sp-variant-circles">
                {%- assign cidx = 0 -%}
                {%- for variant in product.variants limit: 4 -%}
                  <div class="sp-variant-circle{%- if forloop.first %} active{%- endif -%}"
                    style="background:{{ color_map[cidx] }}"
                    data-variant-id="{{ variant.id }}"
                    data-price="{{ variant.price }}"
                    {%- if variant.featured_image -%}data-image="{{ variant.featured_image | image_url: width: 900 }}"{%- endif -%}>
                  </div>
                  {%- assign cidx = cidx | plus: 1 -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- when 'size_selector' -%}
        <div {{ block.shopify_attributes }}>
          {%- if has_size -%}
            <div class="sp-pdp-variant-group">
              <div class="sp-pdp-variant-label">
                <span>SELECT YOUR SIZE</span>
                <button class="sp-pdp-size-guide sp-size-guide-link" data-open-sg>Size Guide</button>
              </div>
              <div class="sp-size-btns">
                {%- for variant in product.variants -%}
                  {%- if has_skin_tone == false and has_color == false -%}
                    <button class="sp-size-btn{%- if forloop.first %} active{%- endif -%}{%- unless variant.available %} sold-out{%- endunless -%}"
                      data-variant-id="{{ variant.id }}"
                      data-price="{{ variant.price }}"
                      {%- unless variant.available -%}disabled{%- endunless -%}
                      type="button">{{ forloop.index }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- when 'add_to_cart' -%}
        <div class="sp-pdp-atc-wrap" {{ block.shopify_attributes }}>
          <button class="sp-pdp-atc-btn sp-atc-btn" id="sp-main-atc"
            data-variant-id="{{ product.first_available_variant.id }}"
            type="button">
            {%- if product.first_available_variant.available -%}
              ADD TO CART — {{ product.price | money_without_trailing_zeros }}
            {%- else -%}
              SOLD OUT
            {%- endif -%}
          </button>
          <p class="sp-pdp-ship-note">Free shipping on orders over $75&nbsp;&nbsp;·&nbsp;&nbsp;Returns within 30 days</p>
        </div>

        {%- when 'trust_badges' -%}
        <div class="sp-pdp-trust-inline" {{ block.shopify_attributes }}>
          {%- assign trust_icons = '◻,↺,◈,♡' | split: ',' -%}
          {%- for i in (1..4) -%}
            {%- assign lk = 'trust_' | append: i | append: '_label' -%}
            {%- assign sk = 'trust_' | append: i | append: '_sub' -%}
            {%- assign icon = trust_icons[forloop.index0] -%}
            <div class="sp-pdp-trust-inline-badge">
              <span class="sp-pdp-trust-inline-icon">{{ icon }}</span>
              <div class="sp-pdp-trust-inline-label">{{ block.settings[lk] }}</div>
              <div class="sp-pdp-trust-inline-sub">{{ block.settings[sk] }}</div>
            </div>
          {%- endfor -%}
        </div>

      {%- endcase -%}
    {%- endfor -%}

  </div>
</div>

<!-- ========== BELOW FOLD BLOCKS ========== -->
{%- for block in section.blocks -%}
  {%- case block.type -%}

    {%- when 'frequently_bought_together' -%}
    {%- if block.settings.fbt_1_title != blank or block.settings.fbt_2_title != blank -%}
    <section class="sp-pdp-fbt" {{ block.shopify_attributes }}>
      <div class="sp-pdp-fbt-h">FREQUENTLY BOUGHT TOGETHER</div>
      <div class="sp-pdp-fbt-grid">
        {%- for i in (1..2) -%}
          {%- assign ik = 'fbt_' | append: i | append: '_image' -%}
          {%- assign tk = 'fbt_' | append: i | append: '_title' -%}
          {%- assign pk = 'fbt_' | append: i | append: '_price' -%}
          {%- assign uk = 'fbt_' | append: i | append: '_url' -%}
          {%- if block.settings[tk] != blank -%}
          <div class="sp-pdp-fbt-card">
            <a href="{{ block.settings[uk] | default: '#' }}" class="sp-pdp-fbt-img">
              {%- if block.settings[ik] -%}
                <img src="{{ block.settings[ik] | image_url: width: 500 }}" alt="{{ block.settings[tk] | escape }}" loading="lazy">
              {%- else -%}
                <div style="width:100%;height:100%;background:var(--nude)"></div>
              {%- endif -%}
            </a>
            <div class="sp-pdp-fbt-info">
              <div class="sp-pdp-fbt-name">{{ block.settings[tk] }}</div>
              <div class="sp-pdp-fbt-price">{{ block.settings[pk] }}</div>
              <a href="{{ block.settings[uk] | default: '#' }}" class="sp-pdp-fbt-btn">ADD TO CART</a>
            </div>
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
    {%- endif -%}

    {%- when 'whats_included' -%}
    {%- assign is_kit = false -%}
    {%- if product.type == 'Kits' or product.tags contains 'kit' or product.tags contains 'Kit' -%}
      {%- assign is_kit = true -%}
    {%- endif -%}
    {%- assign has_includes = false -%}
    {%- for i in (1..6) -%}
      {%- assign ik = 'include_' | append: i -%}
      {%- if block.settings[ik] != blank -%}{%- assign has_includes = true -%}{%- endif -%}
    {%- endfor -%}
    {%- if is_kit and has_includes -%}
    <section class="sp-pdp-included" {{ block.shopify_attributes }}>
      <div class="sp-pdp-included-h">WHAT'S INCLUDED</div>
      {%- for i in (1..6) -%}
        {%- assign ik = 'include_' | append: i -%}
        {%- if block.settings[ik] != blank -%}
          <div class="sp-pdp-included-item">
            <span class="sp-pdp-included-check">✓</span>
            <span>{{ block.settings[ik] }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </section>
    {%- endif -%}

    {%- when 'tiktok_testimonials' -%}
    <section class="sp-tt-s" {{ block.shopify_attributes }}>
      <div class="sp-tt-h">REAL WOMEN. REAL RESULTS.</div>
      <div class="sp-tt-sub">Submit your video · Get rewarded</div>
      <div class="sp-tt-row">
        {%- assign tt_bg = '#3D2314,#7B4F3A,#7B9AB5' | split: ',' -%}
        {%- for i in (1..3) -%}
          {%- assign uk = 'tiktok_' | append: i | append: '_url' -%}
          {%- assign hk = 'tiktok_' | append: i | append: '_handle' -%}
          {%- assign lk = 'tiktok_' | append: i | append: '_likes' -%}
          {%- assign gi = forloop.index0 -%}
          <div class="sp-tt-card">
            {%- if block.settings[uk] != blank -%}
              <iframe class="sp-tt-inner" src="{{ block.settings[uk] }}" frameborder="0" allowfullscreen loading="lazy"></iframe>
            {%- else -%}
              <div class="sp-tt-inner" style="background:{{ tt_bg[gi] }}"></div>
              <div class="sp-tt-play">▶</div>
            {%- endif -%}
            <div class="sp-tt-overlay"></div>
            <div class="sp-tt-meta">
              <div class="sp-tt-handle">{{ block.settings[hk] | default: '@sculps.official' }}</div>
              <div class="sp-tt-likes">♥ {{ block.settings[lk] | default: '100K' }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </section>

    {%- when 'reviews' -%}
    {%- assign has_rev = false -%}
    {%- for i in (1..4) -%}
      {%- assign rk = 'review_' | append: i | append: '_text' -%}
      {%- if block.settings[rk] != blank -%}{%- assign has_rev = true -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_rev -%}
    <section class="sp-rev-s" {{ block.shopify_attributes }}>
      <div class="sp-rev-h">REAL REVIEWS FROM REAL WOMEN</div>
      <div class="sp-rev-grid">
        {%- for i in (1..4) -%}
          {%- assign rt = 'review_' | append: i | append: '_text' -%}
          {%- assign rn = 'review_' | append: i | append: '_name' -%}
          {%- assign rs = 'review_' | append: i | append: '_stars' -%}
          {%- assign rv = 'review_' | append: i | append: '_verified' -%}
          {%- if block.settings[rt] != blank -%}
          <div class="sp-rev-card">
            <div class="sp-rev-stars">
              {%- assign star_n = block.settings[rs] | default: 5 -%}
              {%- for s in (1..star_n) -%}★{%- endfor -%}
            </div>
            <p class="sp-rev-text">"{{ block.settings[rt] }}"</p>
            <div class="sp-rev-name">— {{ block.settings[rn] }}</div>
            {%- if block.settings[rv] -%}
              <div class="sp-rev-verified">✓ Verified Buyer</div>
            {%- endif -%}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
    {%- endif -%}

    {%- when 'related_products' -%}
    {%- if collection -%}
      {%- assign rel_count = 0 -%}
      {%- for rp in collection.products limit: 7 -%}
        {%- unless rp.handle == product.handle -%}{%- assign rel_count = rel_count | plus: 1 -%}{%- endunless -%}
      {%- endfor -%}
      {%- if rel_count > 0 -%}
      <section class="sp-pdp-related" {{ block.shopify_attributes }}>
        <div class="sp-pdp-related-h">YOU MAY ALSO LIKE</div>
        <div class="sp-bs-scroll">
          {%- for rp in collection.products limit: 7 -%}
            {%- unless rp.handle == product.handle -%}
            <div class="sp-pc">
              <a href="{{ rp.url }}" class="sp-pc-img" style="display:block;aspect-ratio:3/4;overflow:hidden;margin-bottom:14px">
                {%- if rp.featured_image -%}
                  <img src="{{ rp.featured_image | image_url: width: 400 }}" alt="{{ rp.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">
                {%- else -%}
                  <div style="width:100%;height:100%;background:var(--cream)"></div>
                {%- endif -%}
              </a>
              <div class="sp-pc-brand">SCULPS</div>
              <a href="{{ rp.url }}" class="sp-pc-name" style="display:block;font-size:13px;font-weight:600;margin-bottom:7px;line-height:1.3">{{ rp.title }}</a>
              <div class="sp-pc-prices">
                <span class="sp-pc-price">{{ rp.price | money }}</span>
                {%- if rp.compare_at_price > rp.price -%}
                  <span class="sp-pc-was">{{ rp.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
              <button class="sp-pc-btn sp-atc-btn"
                data-variant-id="{{ rp.first_available_variant.id }}"
                type="button">ADD TO BAG</button>
            </div>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </section>
      {%- endif -%}
    {%- endif -%}

  {%- endcase -%}
{%- endfor -%}

{% schema %}
{
  "name": "SCULPS Product",
  "blocks": [
    {
      "type": "image_gallery",
      "name": "Image Gallery",
      "limit": 1,
      "settings": []
    },
    {
      "type": "product_header",
      "name": "Product Header",
      "limit": 1,
      "settings": [
        {"type": "number", "id": "rating_count", "label": "Review count", "default": 847}
      ]
    },
    {
      "type": "bullet_points",
      "name": "Bullet Points",
      "limit": 1,
      "settings": [
        {"type": "text", "id": "bullet_1", "label": "Bullet 1"},
        {"type": "text", "id": "bullet_2", "label": "Bullet 2"},
        {"type": "text", "id": "bullet_3", "label": "Bullet 3"},
        {"type": "text", "id": "bullet_4", "label": "Bullet 4"}
      ]
    },
    {
      "type": "skin_tone_selector",
      "name": "Skin Tone Selector",
      "limit": 1,
      "settings": []
    },
    {
      "type": "color_selector",
      "name": "Color Selector",
      "limit": 1,
      "settings": []
    },
    {
      "type": "size_selector",
      "name": "Size Selector",
      "limit": 1,
      "settings": []
    },
    {
      "type": "add_to_cart",
      "name": "Add to Cart",
      "limit": 1,
      "settings": []
    },
    {
      "type": "trust_badges",
      "name": "Trust Badges",
      "limit": 1,
      "settings": [
        {"type": "text", "id": "trust_1_label", "label": "Badge 1 label", "default": "INVISIBLE DESIGN"},
        {"type": "text", "id": "trust_1_sub",   "label": "Badge 1 subtext", "default": "Seamless under anything"},
        {"type": "text", "id": "trust_2_label", "label": "Badge 2 label", "default": "REUSABLE"},
        {"type": "text", "id": "trust_2_sub",   "label": "Badge 2 subtext", "default": "40+ wears with care"},
        {"type": "text", "id": "trust_3_label", "label": "Badge 3 label", "default": "MEDICAL GRADE"},
        {"type": "text", "id": "trust_3_sub",   "label": "Badge 3 subtext", "default": "Body-safe materials"},
        {"type": "text", "id": "trust_4_label", "label": "Badge 4 label", "default": "EVERY BODY"},
        {"type": "text", "id": "trust_4_sub",   "label": "Badge 4 subtext", "default": "All tones. All shapes."}
      ]
    },
    {
      "type": "frequently_bought_together",
      "name": "Frequently Bought Together",
      "limit": 1,
      "settings": [
        {"type": "image_picker", "id": "fbt_1_image", "label": "Product 1 image"},
        {"type": "text",         "id": "fbt_1_title", "label": "Product 1 title"},
