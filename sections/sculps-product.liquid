<!-- ========== SIZE GUIDE MODAL ========== -->
<div class="sp-sg-overlay" id="sp-sg-overlay" aria-hidden="true">
  <div class="sp-sg-modal" role="dialog" aria-modal="true" aria-label="Size Guide">
    <button class="sp-sg-close" id="sp-sg-close" aria-label="Close">&#x2715;</button>
    <div class="sp-sg-h">SIZE GUIDE</div>
    <div class="sp-sg-section-h">Chest — Lift Inserts, Invisibra</div>
    <table class="sp-sg-table">
      <thead><tr><th>Size</th><th>Cup / Bust</th></tr></thead>
      <tbody>
        <tr><td>1</td><td>A/B Cup — 30–34"</td></tr>
        <tr><td>2</td><td>C/D Cup — 34–36"</td></tr>
        <tr><td>3</td><td>DD/E Cup — 36–38"</td></tr>
        <tr><td>4</td><td>F Cup — 38–40"</td></tr>
        <tr><td>5</td><td>G+ Cup — 40+"</td></tr>
      </tbody>
    </table>
    <div class="sp-sg-section-h" style="margin-top:20px">Bottoms — Thong, Brief, Summer Set</div>
    <table class="sp-sg-table">
      <thead><tr><th>Size</th><th>Waist</th><th>Hips</th></tr></thead>
      <tbody>
        <tr><td>1 (XS)</td><td>24–26"</td><td>34–36"</td></tr>
        <tr><td>2 (S)</td><td>26–28"</td><td>36–38"</td></tr>
        <tr><td>3 (M)</td><td>28–30"</td><td>38–40"</td></tr>
        <tr><td>4 (L)</td><td>30–34"</td><td>40–44"</td></tr>
        <tr><td>5 (XL)</td><td>34–40"</td><td>44–50"</td></tr>
      </tbody>
    </table>
    <p style="font-size:11px;color:var(--grey);font-style:italic;margin-top:14px">Between sizes? Size up.</p>
  </div>
</div>

<!-- ========== LIGHTBOX ========== -->
<div class="sp-lb-overlay" id="sp-lb-overlay" aria-hidden="true">
  <button class="sp-lb-close" id="sp-lb-close" aria-label="Close">&#x2715;</button>
  <button class="sp-lb-nav sp-lb-prev" id="sp-lb-prev" aria-label="Previous">&#8249;</button>
  <img class="sp-lb-img" id="sp-lb-img" src="" alt="">
  <button class="sp-lb-nav sp-lb-next" id="sp-lb-next" aria-label="Next">&#8250;</button>
</div>

<!-- ========== STICKY ATC ========== -->
<div class="sp-satc" id="sp-satc">
  <div class="sp-satc-info">
    {%- if product.featured_image -%}
      <img class="sp-satc-thumb" src="{{ product.featured_image | image_url: width: 80 }}" alt="{{ product.title | escape }}">
    {%- endif -%}
    <div>
      <div class="sp-satc-name">{{ product.title }}</div>
      <div class="sp-satc-price" id="sp-satc-price">{{ product.selected_or_first_available_variant.price | money }}</div>
    </div>
  </div>
  <button
    class="sp-satc-btn sp-pdp-atc-trigger sp-atc-btn"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    type="button">ADD TO CART</button>
</div>

<!-- ========== VARIANT DATA ========== -->
<script>
window.sculpsProduct = {
  variants: {{ product.variants | json }},
  selectedOptions: {}
};
{%- for option in product.options_with_values -%}
  window.sculpsProduct.selectedOptions[{{ option.position }}] = {{ option.values | first | json }};
{%- endfor -%}
</script>

{%- assign v0 = product.selected_or_first_available_variant -%}
{%- assign tone_colors = '#F5E6D8,#E8C9A0,#C8956C,#A0714F,#7B4F3A,#3D2314' | split: ',' -%}
{%- assign tone_labels = 'PORCELAIN,LIGHT,MEDIUM,TAN,DEEP,RICH' | split: ',' -%}
{%- assign color_swatches = '#F5B8C4,#9BAF8A,#C9B8E8,#7B9AB5' | split: ',' -%}

{%- assign tone_option  = nil -%}
{%- assign size_option  = nil -%}
{%- assign color_option = nil -%}
{%- for opt in product.options_with_values -%}
  {%- if opt.name == 'Skin Tone' or opt.name == 'Shade' or opt.name == 'Tone' -%}
    {%- assign tone_option = opt -%}
  {%- elsif opt.name == 'Size' -%}
    {%- assign size_option = opt -%}
  {%- elsif opt.name == 'Color' -%}
    {%- assign color_option = opt -%}
  {%- endif -%}
{%- endfor -%}

<!-- ========== MAIN PRODUCT LAYOUT ========== -->
<div class="sp-pdp-page">

  <!-- LEFT: Gallery -->
  <div class="sp-pdp-col-left">
    {%- for block in section.blocks -%}
      {%- if block.type == 'image_gallery' -%}
      <div class="sp-pdp-gallery" {{ block.shopify_attributes }}>
        <div class="sp-pdp-main-wrap">
          {%- if v0.compare_at_price > v0.price -%}
            {%- assign save_amt = v0.compare_at_price | minus: v0.price -%}
            <div class="sp-pdp-save-circle" id="sp-save-badge">
              <span class="sp-pdp-save-top">SAVE</span>
              <span class="sp-pdp-save-amt" id="sp-save-amt">{{ save_amt | money_without_trailing_zeros }}</span>
            </div>
          {%- endif -%}
          {%- if product.featured_image -%}
            <img class="sp-pdp-main-img" id="sp-main-img"
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.title | escape }}" loading="eager">
          {%- else -%}
            <div class="sp-pdp-img-empty"></div>
          {%- endif -%}
          <button class="sp-pdp-zoom-btn" id="sp-zoom-btn" aria-label="Zoom">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/>
              <line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
          </button>
        </div>
        {%- if product.images.size > 1 -%}
          <div class="sp-pdp-thumbs" id="sp-pdp-thumbs">
            {%- for img in product.images limit: 8 -%}
              <button class="sp-pdp-thumb{%- if forloop.first %} active{%- endif -%}"
                data-src="{{ img | image_url: width: 1000 }}"
                style="background-image:url('{{ img | image_url: width: 120 }}')"
                aria-label="Image {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
          <div class="sp-pdp-dots-mob" id="sp-pdp-dots">
            {%- for img in product.images limit: 8 -%}
              <button class="sp-pdp-dot-mob{%- if forloop.first %} active{%- endif -%}"
                data-src="{{ img | image_url: width: 1000 }}"
                aria-label="Image {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div id="sp-lb-sources" style="display:none">
          {%- for img in product.images limit: 8 -%}
            <span data-src="{{ img | image_url: width: 1800 }}"></span>
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <!-- RIGHT: Info -->
  <div class="sp-pdp-col-right" id="sp-atc-trigger">
    <input type="hidden" id="sculps-selected-variant" value="{{ v0.id }}">

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'product_header' -%}
        <div class="sp-pdp-header-block" {{ block.shopify_attributes }}>
          <div class="sp-pdp-brand">SCULPS</div>
          <h1 class="sp-pdp-title">{{ product.title }}</h1>
          {%- if block.settings.subtitle != blank -%}
            <div class="sp-pdp-subtitle">{{ block.settings.subtitle }}</div>
          {%- endif -%}
          <div class="sp-pdp-price-row">
            <span class="sp-pdp-price" id="sp-price">{{ v0.price | money }}</span>
            {%- if v0.compare_at_price > v0.price -%}
              <span class="sp-pdp-compare" id="sp-compare">{{ v0.compare_at_price | money }}</span>
              {%- assign save_label = v0.compare_at_price | minus: v0.price | money_without_trailing_zeros -%}
              <span class="sp-pdp-save-pill" id="sp-save-tag">SAVE {{ save_label }}</span>
            {%- endif -%}
          </div>
          {%- if block.settings.tagline != blank -%}
            <div class="sp-pdp-tagline">{{ block.settings.tagline }}</div>
          {%- endif -%}
          {%- if block.settings.show_stars -%}
          <div class="sp-pdp-stars">
            ★★★★★
            <span class="sp-pdp-stars-count">({{ block.settings.rating_count | default: 847 }} reviews)</span>
          </div>
          {%- endif -%}
        </div>

        {%- when 'bullet_points' -%}
        {%- assign has_bullets = false -%}
        {%- for i in (1..6) -%}
          {%- assign bk = 'bullet_' | append: i -%}
          {%- if block.settings[bk] != blank -%}{%- assign has_bullets = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_bullets -%}
        <div class="sp-pdp-bullets" {{ block.shopify_attributes }}>
          {%- for i in (1..6) -%}
            {%- assign bk = 'bullet_' | append: i -%}
            {%- if block.settings[bk] != blank -%}
              <div class="sp-pdp-bullet">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {{ block.settings[bk] }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

        {%- when 'bundle_items' -%}
        {%- assign any_bundle = false -%}
        {%- for i in (1..3) -%}
          {%- assign bpk = 'bundle_product_' | append: i -%}
          {%- if block.settings[bpk] != blank -%}{%- assign any_bundle = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if any_bundle -%}
        <div class="sp-pdp-bundle" {{ block.shopify_attributes }}>
          {%- if block.settings.bundle_label != blank -%}
            <div class="sp-pdp-bundle-label">{{ block.settings.bundle_label }}</div>
          {%- endif -%}
          <div class="sp-pdp-bundle-grid">
            {%- for i in (1..3) -%}
              {%- assign bpk = 'bundle_product_' | append: i -%}
              {%- assign bp = block.settings[bpk] -%}
              {%- if bp != blank -%}
              <div class="sp-pdp-bundle-item">
                <div class="sp-pdp-bundle-name">{{ bp.title | upcase }}</div>
                <div class="sp-pdp-bundle-img">
                  {%- if bp.featured_image -%}
                    <img src="{{ bp.featured_image | image_url: width: 300 }}" alt="{{ bp.title | escape }}" loading="lazy">
                  {%- else -%}
                    <div style="width:100%;height:100%;background:var(--cream)"></div>
                  {%- endif -%}
                </div>
              </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        {%- when 'skin_tone_selector' -%}
        {%- if tone_option -%}
        <div class="sp-pdp-variant-group" {{ block.shopify_attributes }}>
          <div class="sp-pdp-variant-label">CHOOSE YOUR SKIN TONE</div>
          <div class="sp-tone-grid">
            {%- for val in tone_option.values -%}
              {%- assign tidx = forloop.index0 -%}
              <div class="sp-tone-item">
                <button class="sp-tone-circle{%- if forloop.first %} active{%- endif -%}"
                  style="background:{{ tone_colors[tidx] }}"
                  data-option="{{ tone_option.position }}"
                  data-value="{{ val }}"
                  type="button"
                  aria-label="{{ val }}"></button>
                <span class="sp-tone-label">{{ tone_labels[tidx] }}</span>
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        {%- when 'color_selector' -%}
        {%- if color_option -%}
        <div class="sp-pdp-variant-group" {{ block.shopify_attributes }}>
          <div class="sp-pdp-variant-label">CHOOSE YOUR COLOR</div>
          <div class="sp-color-btns">
            {%- for val in color_option.values -%}
              {%- assign cidx = forloop.index0 -%}
              <button class="sp-color-btn{%- if forloop.first %} active{%- endif -%}"
                style="background:{{ color_swatches[cidx] }}"
                data-option="{{ color_option.position }}"
                data-value="{{ val }}"
                type="button"
                title="{{ val }}"
                aria-label="{{ val }}"></button>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        {%- when 'size_selector' -%}
        {%- if size_option -%}
        <div class="sp-pdp-variant-group" {{ block.shopify_attributes }}>
          <div class="sp-pdp-variant-label">
            CHOOSE YOUR SIZE
            <button class="sp-pdp-size-guide-btn" id="sp-size-guide-link" type="button">Size Guide</button>
          </div>
          <div class="sp-size-btns">
            {%- for val in size_option.values -%}
              <button class="sp-size-btn{%- if forloop.first %} active{%- endif -%}"
                data-option="{{ size_option.position }}"
                data-value="{{ val }}"
                type="button">{{ val }}</button>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        {%- when 'add_to_cart' -%}
        <div class="sp-pdp-atc-wrap" {{ block.shopify_attributes }}>
          <button
            class="sp-pdp-atc-btn sp-pdp-atc-trigger sp-atc-btn"
            id="sp-main-atc"
            data-variant-id="{{ v0.id }}"
            type="button"
            {%- unless v0.available %} disabled{%- endunless -%}>
            {%- if v0.available -%}
              {{ block.settings.btn_text | default: 'ADD TO CART' }}&nbsp;&nbsp;&middot;&nbsp;&nbsp;{{ v0.price | money }}
            {%- else -%}
              SOLD OUT
            {%- endif -%}
          </button>
          <p class="sp-pdp-ship-note">{{ block.settings.shipping_note | default: 'Free shipping over $75 &nbsp;&middot;&nbsp; 30-day returns' }}</p>
        </div>

        {%- when 'whats_included' -%}
        {%- assign has_items = false -%}
        {%- for i in (1..8) -%}
          {%- assign ik = 'include_' | append: i -%}
          {%- if block.settings[ik] != blank -%}{%- assign has_items = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_items -%}
        <div class="sp-pdp-included" {{ block.shopify_attributes }}>
          <div class="sp-pdp-included-h">WHAT'S INCLUDED</div>
          {%- for i in (1..8) -%}
            {%- assign ik = 'include_' | append: i -%}
            {%- if block.settings[ik] != blank -%}
              <div class="sp-pdp-included-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{{ block.settings[ik] }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

<!-- ========== BELOW FOLD ========== -->
{%- for block in section.blocks -%}
  {%- case block.type -%}

    {%- when 'trust_badges' -%}
    <div class="sp-pdp-trust" {{ block.shopify_attributes }}>
      {%- for i in (1..4) -%}
        {%- assign lk = 'trust_' | append: i | append: '_label' -%}
        {%- assign sk = 'trust_' | append: i | append: '_sub' -%}
        <div class="sp-pdp-trust-item">
          {%- case i -%}
            {%- when 1 -%}<svg class="sp-pdp-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {%- when 2 -%}<svg class="sp-pdp-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
            {%- when 3 -%}<svg class="sp-pdp-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            {%- when 4 -%}<svg class="sp-pdp-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
          {%- endcase -%}
          <div class="sp-pdp-trust-lbl">{{ block.settings[lk] }}</div>
          <div class="sp-pdp-trust-sub">{{ block.settings[sk] }}</div>
        </div>
      {%- endfor -%}
    </div>

    {%- when 'fbt' -%}
    {%- if block.settings.fbt_1 != blank or block.settings.fbt_2 != blank -%}
    <section class="sp-pdp-fbt" {{ block.shopify_attributes }}>
      <div class="sp-pdp-fbt-h">FREQUENTLY BOUGHT TOGETHER</div>
      <div class="sp-pdp-fbt-grid">
        {%- for i in (1..2) -%}
          {%- assign fpk = 'fbt_' | append: i -%}
          {%- assign fp  = block.settings[fpk] -%}
          {%- if fp != blank -%}
          <div class="sp-pdp-fbt-card">
            <a href="{{ fp.url }}" class="sp-pdp-fbt-img-wrap">
              {%- if fp.featured_image -%}
                <img src="{{ fp.featured_image | image_url: width: 600 }}" alt="{{ fp.title | escape }}" loading="lazy">
              {%- else -%}
                <div style="width:100%;height:100%;background:var(--cream)"></div>
              {%- endif -%}
            </a>
            <div class="sp-pdp-fbt-name">{{ fp.title | upcase }}</div>
            <div class="sp-pdp-fbt-price">{{ fp.price | money }}</div>
            {%- if fp.first_available_variant != blank -%}
              <button class="sp-pdp-fbt-btn sp-atc-btn"
                data-variant-id="{{ fp.first_available_variant.id }}"
                type="button">ADD TO CART</button>
            {%- else -%}
              <button class="sp-pdp-fbt-btn" disabled>SOLD OUT</button>
            {%- endif -%}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
    {%- endif -%}

    {%- when 'reviews' -%}
    {%- assign has_rev = false -%}
    {%- for i in (1..6) -%}
      {%- assign rk = 'review_' | append: i | append: '_text' -%}
      {%- if block.settings[rk] != blank -%}{%- assign has_rev = true -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_rev -%}
    <section class="sp-rev-s" {{ block.shopify_attributes }}>
      <div class="sp-rev-h">{{ block.settings.heading | default: 'REAL REVIEWS' }}</div>
      <div class="sp-rev-grid">
        {%- for i in (1..6) -%}
          {%- assign rt = 'review_' | append: i | append: '_text' -%}
          {%- assign rn = 'review_' | append: i | append: '_name' -%}
          {%- assign rs = 'review_' | append: i | append: '_stars' -%}
          {%- assign rv = 'review_' | append: i | append: '_verified' -%}
          {%- if block.settings[rt] != blank -%}
          <div class="sp-rev-card">
            <div class="sp-rev-stars">{%- for s in (1..block.settings[rs]) -%}★{%- endfor -%}</div>
            <p class="sp-rev-text">"{{ block.settings[rt] }}"</p>
            <div class="sp-rev-name">— {{ block.settings[rn] }}</div>
            {%- if block.settings[rv] -%}<div class="sp-rev-verified">✓ Verified Buyer</div>{%- endif -%}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
    {%- endif -%}

    {%- when 'related_products' -%}
    {%- if collection -%}
    <section class="sp-pdp-related" {{ block.shopify_attributes }}>
      <div class="sp-pdp-related-h">{{ block.settings.heading | default: 'YOU MAY ALSO LIKE' }}</div>
      <div class="sp-bs-scroll">
        {%- for rp in collection.products limit: 6 -%}
          {%- unless rp.handle == product.handle -%}
          <div class="sp-pc">
            <a href="{{ rp.url }}" class="sp-pc-img" style="display:block;aspect-ratio:3/4;overflow:hidden;margin-bottom:12px">
              {%- if rp.featured_image -%}
                <img src="{{ rp.featured_image | image_url: width: 400 }}" alt="{{ rp.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">
              {%- else -%}
                <div style="width:100%;height:100%;background:var(--cream)"></div>
              {%- endif -%}
            </a>
            <div class="sp-pc-brand">SCULPS</div>
            <a href="{{ rp.url }}" class="sp-pc-name" style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;letter-spacing:.5px;text-decoration:none;color:var(--black)">{{ rp.title }}</a>
            <div class="sp-pc-prices"><span class="sp-pc-price">{{ rp.price | money }}</span></div>
            {%- if rp.first_available_variant != blank -%}
              <button class="sp-pc-btn sp-atc-btn"
                data-variant-id="{{ rp.first_available_variant.id }}"
                type="button">Add to Bag</button>
            {%- endif -%}
          </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </section>
    {%- endif -%}

  {%- endcase -%}
{%- endfor -%}

<!-- ========== VARIANT JS ========== -->
<script>
(function () {
  var prod = window.sculpsProduct || {};
  var variants = prod.variants || [];
  var sel = prod.selectedOptions || {};

  function findVariant() {
    return variants.find(function (v) {
      return Object.keys(sel).every(function (pos) {
        return v.options[parseInt(pos) - 1] === sel[pos];
      });
    });
  }
  function money(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
  }
  function updateUI(v) {
    if (!v) return;
    var priceEl   = document.getElementById('sp-price');
    var compareEl = document.getElementById('sp-compare');
    var saveTagEl = document.getElementById('sp-save-tag');
    var saveBadge = document.getElementById('sp-save-badge');
    var saveAmt   = document.getElementById('sp-save-amt');
    var atcBtn    = document.getElementById('sp-main-atc');
    var satcPrice = document.getElementById('sp-satc-price');
    var varInput  = document.getElementById('sculps-selected-variant');

    if (priceEl)   priceEl.textContent   = money(v.price);
    if (satcPrice) satcPrice.textContent = money(v.price);
    if (varInput)  varInput.value        = v.id;

    if (v.compare_at_price && v.compare_at_price > v.price) {
      var save = v.compare_at_price - v.price;
      if (compareEl) { compareEl.textContent = money(v.compare_at_price); compareEl.style.display = ''; }
      if (saveTagEl) { saveTagEl.textContent = 'SAVE ' + money(save); saveTagEl.style.display = ''; }
      if (saveBadge) { saveBadge.style.display = ''; }
      if (saveAmt)   { saveAmt.textContent = money(save); }
    } else {
      if (compareEl) compareEl.style.display = 'none';
      if (saveTagEl) saveTagEl.style.display = 'none';
      if (saveBadge) saveBadge.style.display = 'none';
    }

    document.querySelectorAll('.sp-pdp-atc-trigger,.sp-satc-btn').forEach(function (b) {
      b.setAttribute('data-variant-id', v.id);
    });

    if (atcBtn) {
      if (v.available) {
        atcBtn.textContent = 'ADD TO CART  ·  ' + money(v.price);
        atcBtn.disabled = false;
      } else {
        atcBtn.textContent = 'SOLD OUT';
        atcBtn.disabled = true;
      }
    }

    if (v.featured_image) {
      var mi = document.getElementById('sp-main-img');
      if (mi) { mi.style.opacity = '0'; setTimeout(function () { mi.src = v.featured_image.src; mi.style.opacity = '1'; }, 150); }
    }
  }

  function switchImage(src) {
    var mi = document.getElementById('sp-main-img');
    if (!mi || !src) return;
    mi.style.opacity = '0';
    setTimeout(function () { mi.src = src; mi.style.opacity = '1'; }, 100);
    document.querySelectorAll('.sp-pdp-thumb,.sp-pdp-dot-mob').forEach(function (b) {
      b.classList.toggle('active', b.getAttribute('data-src') === src);
    });
  }

  document.addEventListener('click', function (e) {
    var t = e.target;
    if (t.classList.contains('sp-tone-circle')) {
      document.querySelectorAll('.sp-tone-circle').forEach(function (b) { b.classList.remove('active'); });
      t.classList.add('active');
      sel[t.getAttribute('data-option')] = t.getAttribute('data-value');
      var v = findVariant(); if (v) updateUI(v);
    }
    if (t.classList.contains('sp-color-btn')) {
      document.querySelectorAll('.sp-color-btn').forEach(function (b) { b.classList.remove('active'); });
      t.classList.add('active');
      sel[t.getAttribute('data-option')] = t.getAttribute('data-value');
      var v = findVariant(); if (v) updateUI(v);
    }
    if (t.classList.contains('sp-size-btn')) {
      document.querySelectorAll('.sp-size-btn').forEach(function (b) { b.classList.remove('active'); });
      t.classList.add('active');
      sel[t.getAttribute('data-option')] = t.getAttribute('data-value');
      var v = findVariant(); if (v) updateUI(v);
    }
    if (t.classList.contains('sp-pdp-thumb') || t.classList.contains('sp-pdp-dot-mob')) {
      switchImage(t.getAttribute('data-src'));
    }
    if (t.id === 'sp-zoom-btn') {
      var sources = document.querySelectorAll('#sp-lb-sources span');
      if (sources.length) {
        window._lbIdx = 0;
        var li = document.getElementById('sp-lb-img');
        if (li) li.src = sources[0].getAttribute('data-src');
        var lo = document.getElementById('sp-lb-overlay');
        if (lo) { lo.style.display = 'flex'; lo.setAttribute('aria-hidden', 'false'); }
      }
    }
    if (t.id === 'sp-lb-close' || t.id === 'sp-lb-overlay') {
      var lo = document.getElementById('sp-lb-overlay');
      if (lo) { lo.style.display = 'none'; lo.setAttribute('aria-hidden', 'true'); }
    }
    if (t.id === 'sp-lb-next' || t.id === 'sp-lb-prev') {
      var sources = document.querySelectorAll('#sp-lb-sources span');
      if (sources.length) {
        var d = t.id === 'sp-lb-next' ? 1 : -1;
        window._lbIdx = ((window._lbIdx || 0) + d + sources.length) % sources.length;
        var li = document.getElementById('sp-lb-img');
        if (li) li.src = sources[window._lbIdx].getAttribute('data-src');
      }
    }
    if (t.id === 'sp-size-guide-link') {
      var sg = document.getElementById('sp-sg-overlay');
      if (sg) { sg.style.display = 'flex'; sg.setAttribute('aria-hidden', 'false'); }
    }
    if (t.id === 'sp-sg-close') {
      var sg = document.getElementById('sp-sg-overlay');
      if (sg) { sg.style.display = 'none'; sg.setAttribute('aria-hidden', 'true'); }
    }
  });

  var sgEl = document.getElementById('sp-sg-overlay');
  if (sgEl) sgEl.addEventListener('click', function (e) { if (e.target === sgEl) { sgEl.style.display = 'none'; } });
})();
</script>

<style>
/* ===== PRODUCT PAGE LAYOUT ===== */
.sp-pdp-page{display:grid;grid-template-columns:1fr 1fr;gap:56px;max-width:1260px;margin:0 auto;padding:40px 48px 64px}

/* Gallery */
.sp-pdp-gallery{}
.sp-pdp-main-wrap{position:relative;overflow:hidden;background:var(--cream);aspect-ratio:1/1}
.sp-pdp-main-img{width:100%;height:100%;object-fit:cover;display:block;transition:opacity .2s}
.sp-pdp-img-empty{width:100%;height:100%;background:var(--cream)}

/* Save circle badge */
.sp-pdp-save-circle{position:absolute;top:16px;left:16px;width:72px;height:72px;border-radius:50%;background:var(--black);color:var(--white);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:2;line-height:1.2;pointer-events:none}
.sp-pdp-save-top{font-size:10px;font-weight:900;letter-spacing:1px;text-transform:uppercase}
.sp-pdp-save-amt{font-size:17px;font-weight:900;letter-spacing:0}

/* Zoom */
.sp-pdp-zoom-btn{position:absolute;bottom:14px;right:14px;width:36px;height:36px;background:rgba(255,255,255,.9);border:none;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--black);transition:background .2s;z-index:2}
.sp-pdp-zoom-btn:hover{background:#fff}

/* Thumbnails (desktop) */
.sp-pdp-thumbs{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.sp-pdp-thumb{width:66px;height:66px;border:2px solid transparent;cursor:pointer;background-size:cover;background-position:center;padding:0;transition:border-color .15s;flex-shrink:0}
.sp-pdp-thumb.active{border-color:var(--black)}

/* Dots (mobile) */
.sp-pdp-dots-mob{display:none;gap:8px;justify-content:center;margin-top:14px}
.sp-pdp-dot-mob{width:10px;height:10px;border-radius:50%;border:none;background:rgba(0,0,0,.2);cursor:pointer;padding:0;transition:background .15s;flex-shrink:0}
.sp-pdp-dot-mob.active{background:var(--black)}

/* Info column */
.sp-pdp-col-right{display:flex;flex-direction:column}

/* Header */
.sp-pdp-header-block{margin-bottom:16px}
.sp-pdp-brand{font-size:9px;font-weight:900;letter-spacing:3px;text-transform:uppercase;color:var(--grey);margin-bottom:6px}
.sp-pdp-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(30px,3.5vw,52px);letter-spacing:2px;line-height:1.05;margin-bottom:10px}
.sp-pdp-subtitle{font-size:14px;color:var(--grey);margin-bottom:14px;line-height:1.5}
.sp-pdp-price-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap}
.sp-pdp-price{font-size:34px;font-weight:900;letter-spacing:-1px}
.sp-pdp-compare{font-size:20px;color:var(--grey);text-decoration:line-through;font-weight:400}
.sp-pdp-save-pill{background:var(--black);color:var(--white);font-size:10px;font-weight:900;letter-spacing:1.5px;padding:5px 12px;text-transform:uppercase;line-height:1}
.sp-pdp-tagline{font-size:13px;color:var(--grey);font-style:italic;margin-bottom:16px;line-height:1.5}
.sp-pdp-stars{font-size:15px;color:#C9A96E;display:flex;align-items:center;gap:6px;margin-bottom:4px}
.sp-pdp-stars-count{font-size:11px;color:var(--grey);font-family:inherit}

/* Bullet points */
.sp-pdp-bullets{margin-bottom:16px}
.sp-pdp-bullet{display:flex;align-items:flex-start;gap:8px;font-size:13px;margin-bottom:7px;line-height:1.5;color:var(--black)}
.sp-pdp-bullet svg{flex-shrink:0;margin-top:2px}

/* Bundle */
.sp-pdp-bundle{margin:16px 0;padding:16px;border:1px solid var(--border)}
.sp-pdp-bundle-label{font-size:9px;font-weight:900;letter-spacing:2px;text-transform:uppercase;color:var(--grey);margin-bottom:12px;text-align:center}
.sp-pdp-bundle-grid{display:grid;grid-template-columns:repeat(3,1fr)}
.sp-pdp-bundle-item{padding:12px 8px;border-right:1px solid var(--border);text-align:center}
.sp-pdp-bundle-item:last-child{border-right:none}
.sp-pdp-bundle-name{font-size:8px;font-weight:900;letter-spacing:.8px;text-transform:uppercase;margin-bottom:8px;line-height:1.4}
.sp-pdp-bundle-img{aspect-ratio:1/1;overflow:hidden}
.sp-pdp-bundle-img img{width:100%;height:100%;object-fit:cover}

/* Variants */
.sp-pdp-variant-group{margin:16px 0}
.sp-pdp-variant-label{font-size:9px;font-weight:900;letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between}
.sp-pdp-size-guide-btn{font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;background:none;border:none;cursor:pointer;color:var(--grey);text-decoration:underline;font-family:inherit;padding:0}

/* Tone circles */
.sp-tone-grid{display:flex;gap:12px;flex-wrap:wrap}
.sp-tone-item{display:flex;flex-direction:column;align-items:center;gap:5px}
.sp-tone-circle{width:48px;height:48px;border-radius:50%;border:2px solid transparent;cursor:pointer;transition:border-color .15s,transform .15s;padding:0;flex-shrink:0}
.sp-tone-circle:hover{transform:scale(1.08)}
.sp-tone-circle.active{border-color:var(--black);outline:2px solid var(--black);outline-offset:2px}
.sp-tone-label{font-size:7px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:var(--grey)}

/* Color swatches */
.sp-color-btns{display:flex;gap:10px;flex-wrap:wrap}
.sp-color-btn{width:38px;height:38px;border-radius:50%;border:2px solid transparent;cursor:pointer;transition:border-color .15s,transform .15s;padding:0;flex-shrink:0}
.sp-color-btn.active{border-color:var(--black);outline:2px solid var(--black);outline-offset:2px}

/* Size buttons */
.sp-size-btns{display:flex;gap:8px;flex-wrap:wrap}
.sp-size-btn{padding:11px 18px;border:1.5px solid var(--border);background:none;font-family:inherit;font-size:13px;font-weight:700;letter-spacing:.5px;cursor:pointer;transition:all .15s;text-align:center;white-space:nowrap;min-width:50px;line-height:1}
.sp-size-btn:hover{border-color:var(--black)}
.sp-size-btn.active{background:var(--black);color:var(--white);border-color:var(--black)}

/* ATC */
.sp-pdp-atc-wrap{margin-top:20px}
.sp-pdp-atc-btn{display:block;width:100%;padding:18px 24px;background:var(--black);color:var(--white);font-family:inherit;font-size:11px;font-weight:900;letter-spacing:3px;text-transform:uppercase;border:none;cursor:pointer;transition:background .2s}
.sp-pdp-atc-btn:hover:not(:disabled){background:#333}
.sp-pdp-atc-btn:disabled{opacity:.45;cursor:default}
.sp-pdp-ship-note{font-size:11px;color:var(--grey);text-align:center;margin-top:10px;line-height:1.5}

/* What's included */
.sp-pdp-included{margin-top:20px;padding-top:20px;border-top:1px solid var(--border)}
.sp-pdp-included-h{font-size:9px;font-weight:900;letter-spacing:2px;text-transform:uppercase;margin-bottom:14px}
.sp-pdp-included-item{display:flex;align-items:flex-start;gap:10px;font-size:13px;margin-bottom:9px;line-height:1.5;color:var(--black)}
.sp-pdp-included-item svg{flex-shrink:0;margin-top:2px}

/* Trust badges */
.sp-pdp-trust{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin-top:40px}
.sp-pdp-trust-item{display:flex;flex-direction:column;align-items:center;text-align:center;padding:28px 12px;border-right:1px solid var(--border)}
.sp-pdp-trust-item:last-child{border-right:none}
.sp-pdp-trust-icon{width:30px;height:30px;margin-bottom:12px;color:var(--black)}
.sp-pdp-trust-lbl{font-size:8px;font-weight:900;letter-spacing:2px;text-transform:uppercase;margin-bottom:5px}
.sp-pdp-trust-sub{font-size:10px;color:var(--grey);line-height:1.4}

/* FBT */
.sp-pdp-fbt{padding:48px;background:var(--cream)}
.sp-pdp-fbt-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(28px,4vw,40px);letter-spacing:3px;margin-bottom:28px;text-align:center}
.sp-pdp-fbt-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;max-width:720px;margin:0 auto}
.sp-pdp-fbt-card{background:var(--white);padding:20px;display:flex;flex-direction:column}
.sp-pdp-fbt-img-wrap{aspect-ratio:1/1;overflow:hidden;margin-bottom:14px;display:block}
.sp-pdp-fbt-img-wrap img{width:100%;height:100%;object-fit:cover;transition:transform .4s}
.sp-pdp-fbt-card:hover .sp-pdp-fbt-img-wrap img{transform:scale(1.04)}
.sp-pdp-fbt-name{font-size:11px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:6px;line-height:1.4}
.sp-pdp-fbt-price{font-size:18px;font-weight:900;margin-bottom:14px}
.sp-pdp-fbt-btn{width:100%;padding:13px;background:var(--black);color:var(--white) !important;font-family:inherit;font-size:10px;font-weight:900;letter-spacing:2.5px;text-transform:uppercase;border:none;cursor:pointer;transition:background .2s;text-decoration:none !important;text-align:center;display:block;margin-top:auto}
.sp-pdp-fbt-btn:hover:not(:disabled){background:#333}

/* Reviews */
.sp-rev-s{padding:56px 48px;background:var(--white)}
.sp-rev-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(32px,4vw,48px);letter-spacing:3px;text-align:center;margin-bottom:36px}
.sp-rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:1100px;margin:0 auto}
.sp-rev-card{padding:28px;border-left:3px solid #C9A96E;background:var(--cream)}
.sp-rev-stars{color:#C9A96E;font-size:16px;margin-bottom:12px;letter-spacing:2px}
.sp-rev-text{font-size:13px;line-height:1.7;font-style:italic;margin-bottom:14px;color:var(--black)}
.sp-rev-name{font-size:10px;font-weight:900;letter-spacing:2px;text-transform:uppercase;color:var(--grey)}
.sp-rev-verified{font-size:9px;color:#6A8A6A;font-weight:700;letter-spacing:1px;margin-top:6px}

/* Related products */
.sp-pdp-related{padding:56px 48px;background:var(--cream)}
.sp-pdp-related-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(28px,4vw,40px);letter-spacing:3px;margin-bottom:28px;text-align:center}

/* Sticky ATC */
.sp-satc{position:fixed;bottom:0;left:0;right:0;background:var(--white);border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:12px 24px;z-index:300;transform:translateY(100%);transition:transform .3s cubic-bezier(.4,0,.2,1);gap:16px}
.sp-satc.visible{transform:translateY(0)}
.sp-satc-info{display:flex;align-items:center;gap:12px;flex:1;min-width:0}
.sp-satc-thumb{width:48px;height:48px;object-fit:cover;flex-shrink:0}
.sp-satc-name{font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sp-satc-price{font-size:11px;color:var(--grey)}
.sp-satc-btn{background:var(--black);color:var(--white) !important;font-family:inherit;font-size:10px;font-weight:900;letter-spacing:2px;text-transform:uppercase;padding:14px 24px;border:none;cursor:pointer;flex-shrink:0;transition:background .2s;white-space:nowrap;text-decoration:none !important}
.sp-satc-btn:hover{background:#333}

/* Size guide modal */
.sp-sg-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:600;align-items:center;justify-content:center;padding:20px}
.sp-sg-modal{background:var(--white);max-width:520px;width:100%;padding:32px;position:relative;max-height:90vh;overflow-y:auto}
.sp-sg-close{position:absolute;top:16px;right:16px;font-size:20px;background:none;border:none;cursor:pointer;color:var(--grey);font-family:inherit}
.sp-sg-h{font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:3px;margin-bottom:20px}
.sp-sg-section-h{font-size:10px;font-weight:900;letter-spacing:2px;text-transform:uppercase;margin-bottom:10px}
.sp-sg-table{width:100%;border-collapse:collapse;margin-bottom:8px;font-size:13px}
.sp-sg-table th{background:var(--black);color:var(--white);padding:8px 12px;text-align:left;font-size:9px;font-weight:900;letter-spacing:2px;text-transform:uppercase}
.sp-sg-table td{padding:8px 12px;border-bottom:1px solid var(--border)}
.sp-sg-table tr:last-child td{border-bottom:none}

/* Lightbox */
.sp-lb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.95);z-index:700;align-items:center;justify-content:center}
.sp-lb-close{position:fixed;top:20px;right:24px;font-size:28px;background:none;border:none;cursor:pointer;color:#fff;font-family:inherit}
.sp-lb-img{max-width:90vw;max-height:90vh;object-fit:contain;display:block}
.sp-lb-nav{position:fixed;top:50%;transform:translateY(-50%);font-size:40px;background:none;border:none;cursor:pointer;color:#fff;padding:10px;font-family:inherit}
.sp-lb-prev{left:16px}
.sp-lb-next{right:16px}

/* Mobile */
@media(max-width:768px){
  .sp-pdp-page{grid-template-columns:1fr;gap:0;padding:0 0 56px}
  .sp-pdp-main-wrap{aspect-ratio:1/1}
  .sp-pdp-thumbs{display:none}
  .sp-pdp-dots-mob{display:flex}
  .sp-pdp-col-right{padding:20px 16px 0}
  .sp-pdp-title{font-size:28px}
  .sp-pdp-save-circle{width:60px;height:60px}
  .sp-pdp-save-amt{font-size:15px}
  .sp-pdp-trust{grid-template-columns:repeat(2,1fr)}
  .sp-pdp-trust-item:nth-child(2){border-right:none}
  .sp-pdp-trust-item:nth-child(3),.sp-pdp-trust-item:nth-child(4){border-top:1px solid var(--border)}
  .sp-pdp-trust-item:nth-child(4){border-right:none}
  .sp-pdp-fbt{padding:32px 16px}
  .sp-pdp-fbt-grid{grid-template-columns:1fr}
  .sp-rev-s{padding:40px 16px}
  .sp-rev-grid{grid-template-columns:1fr;gap:16px}
  .sp-pdp-related{padding:40px 16px}
  .sp-satc{padding:10px 16px}
}
@media(max-width:480px){
  .sp-tone-circle{width:42px;height:42px}
  .sp-tone-label{font-size:6px}
  .sp-pdp-bundle-grid{grid-template-columns:repeat(3,1fr)}
}
</style>

