.sp-rp-card{display:flex;flex-direction:column;gap:8px}
.sp-rp-img-link{display:block;aspect-ratio:1/1;overflow:hidden}
.sp-rp-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}
