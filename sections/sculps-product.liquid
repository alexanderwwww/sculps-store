      ]
    },
    {
      "type": "color_selector",
      "name": "Color Selector",
      "limit": 1,
      "settings": [
        {"type": "paragraph", "content": "Color swatches come from the variant option named 'Color' in Shopify Admin → Products → Variants."}
      ]
