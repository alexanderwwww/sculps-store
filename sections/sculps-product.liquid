.sp-pdp-thumb.active{border-color:#1A1410}
.sp-pdp-no-img{aspect-ratio:1/1;background:#f4f4f4;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;text-align:center;padding:24px;color:#999;font-size:13px;line-height:1.5}

/* ── Info column ────────────────────────────────────────────── */
.sp-pdp-info{display:flex;flex-direction:column;gap:28px;padding-top:8px}
@media(max-width:768px){.sp-pdp-info{padding:20px 16px}}

/* ── Product header ─────────────────────────────────────────── */
.sp-pdp-vendor{font-size:11px;letter-spacing:3px;color:#8B7355;margin:0 0 6px;font-weight:600}
.sp-pdp-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(32px,4vw,52px);letter-spacing:2px;color:#1A1410;margin:0 0 14px;line-height:1}
.sp-pdp-price-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.sp-pdp-price{font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:1px;color:#1A1410}
.sp-pdp-compare{font-size:18px;color:#aaa;text-decoration:line-through}
.sp-pdp-save{background:#1A1410;color:#fff;font-size:11px;font-weight:800;letter-spacing:2px;padding:4px 10px}
.sp-pdp-stars{display:flex;align-items:center;gap:6px}
.sp-stars-row{color:#F5A623;font-size:16px;letter-spacing:1px}
.sp-pdp-rc{font-size:13px;color:#666}
.sp-pdp-tagline{font-size:14px;color:#555;margin:6px 0 0;line-height:1.5}

/* ── Bullets ────────────────────────────────────────────────── */
.sp-pdp-bullets{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
.sp-pdp-bullets li{display:flex;gap:10px;font-size:13px;color:#444;line-height:1.4;padding-left:0}
.sp-pdp-bullets li::before{content:"✓";color:#1A1410;font-weight:900;flex-shrink:0}

/* ── Option groups ──────────────────────────────────────────── */
.sp-pdp-opt-group{display:flex;flex-direction:column;gap:10px}
.sp-pdp-opt-label{font-size:11px;font-weight:800;letter-spacing:2px;color:#1A1410}
.sp-opt-val{font-weight:400;letter-spacing:0;color:#666}
.sp-pdp-opt-label-row{display:flex;align-items:center;justify-content:space-between}
.sp-sg-trigger{font-size:10px;font-weight:700;letter-spacing:1.5px;color:#8B7355;background:none;border:none;cursor:pointer;text-decoration:underline;font-family:inherit;text-transform:uppercase}

/* ── Skin tone buttons ──────────────────────────────────────── */
.sp-tone-btns{display:flex;gap:10px;flex-wrap:wrap}
.sp-tone-btn{width:44px;height:44px;border-radius:50%;border:3px solid transparent;cursor:pointer;position:relative;transition:transform .15s}
.sp-tone-btn:hover{transform:scale(1.1)}
.sp-tone-btn.active{border-color:#1A1410;outline:2px solid #fff;outline-offset:-4px}
.sp-tone-lbl{position:absolute;bottom:-20px;left:50%;transform:translateX(-50%);font-size:8px;font-weight:700;letter-spacing:.5px;white-space:nowrap;color:#555}

/* ── Color buttons ──────────────────────────────────────────── */
.sp-color-btns{display:flex;gap:8px;flex-wrap:wrap}
.sp-color-btn{width:32px;height:32px;border-radius:50%;border:3px solid transparent;cursor:pointer;transition:transform .15s}
.sp-color-btn:hover{transform:scale(1.1)}
.sp-color-btn.active{border-color:#1A1410;outline:2px solid #fff;outline-offset:-4px}

/* ── Size buttons ───────────────────────────────────────────── */
.sp-size-btns{display:flex;gap:8px;flex-wrap:wrap}
.sp-size-btn{min-width:50px;padding:12px 18px;border:2px solid #ddd;background:#fff;font-family:inherit;font-size:14px;font-weight:700;letter-spacing:.5px;cursor:pointer;transition:all .15s;white-space:nowrap;line-height:1;color:#1A1410}
.sp-size-btn:hover{border-color:#1A1410}
.sp-size-btn.active{background:#1A1410;color:#fff;border-color:#1A1410}

/* ── ATC button ─────────────────────────────────────────────── */
.sp-pdp-atc-wrap{display:flex;flex-direction:column;gap:10px}
.sp-pdp-atc-btn{display:block;width:100%;padding:18px 24px;background:#1A1410;color:#fff;font-family:inherit;font-size:12px;font-weight:900;letter-spacing:3px;text-transform:uppercase;border:none;cursor:pointer;transition:background .2s;text-align:center}
.sp-pdp-atc-btn:hover:not(:disabled){background:#333}
.sp-pdp-atc-btn:disabled{opacity:.5;cursor:default}
.sp-pdp-atc-btn--loading{opacity:.7;pointer-events:none}
.sp-pdp-ship{font-size:12px;color:#888;text-align:center;margin:0}

/* ── What's included ────────────────────────────────────────── */
.sp-pdp-included{background:#f8f7f5;padding:24px}
.sp-pdp-included-h{font-size:11px;font-weight:900;letter-spacing:3px;color:#1A1410;margin-bottom:14px}
.sp-pdp-included-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
.sp-pdp-included-list li{display:flex;gap:10px;font-size:14px;color:#444;align-items:baseline}
.sp-check{color:#1A1410;font-weight:900}

/* ── Trust badges ───────────────────────────────────────────── */
.sp-pdp-trust{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.sp-trust-item{display:flex;gap:12px;align-items:flex-start;padding:16px;border:1px solid #f0ede8}
.sp-trust-icon{flex-shrink:0;color:#1A1410}
.sp-trust-label{font-size:11px;font-weight:800;letter-spacing:1.5px;color:#1A1410;margin-bottom:4px}
.sp-trust-sub{font-size:12px;color:#777;line-height:1.4}
@media(max-width:480px){.sp-pdp-trust{grid-template-columns:1fr}}

/* ── FBT ────────────────────────────────────────────────────── */
.sp-pdp-fbt{padding:24px 0}
.sp-pdp-fbt-h{font-size:11px;font-weight:900;letter-spacing:3px;color:#1A1410;margin-bottom:16px}
.sp-pdp-fbt-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.sp-pdp-fbt-item{display:flex;flex-direction:column;gap:8px}
.sp-pdp-fbt-img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
.sp-pdp-fbt-placeholder{aspect-ratio:1/1;background:#f4f4f4;display:block}
.sp-pdp-fbt-name{font-size:13px;font-weight:600;color:#1A1410}
.sp-pdp-fbt-price{font-size:13px;color:#555}
.sp-pdp-fbt-btn{display:block;width:100%;padding:10px;background:#1A1410;color:#fff;font-size:10px;font-weight:800;letter-spacing:2px;border:none;cursor:pointer;text-align:center;text-decoration:none;font-family:inherit}

/* ── Reviews ────────────────────────────────────────────────── */
.sp-pdp-reviews{padding:8px 0}
.sp-pdp-reviews-h{font-size:11px;font-weight:900;letter-spacing:3px;color:#1A1410;margin-bottom:16px}
.sp-pdp-reviews-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:600px){.sp-pdp-reviews-grid{grid-template-columns:1fr}}
.sp-review-card{background:#f8f7f5;padding:20px;display:flex;flex-direction:column;gap:8px}
.sp-review-stars{font-size:14px;letter-spacing:1px}
.sp-review-text{font-size:13px;color:#444;line-height:1.6;margin:0;font-style:italic}
