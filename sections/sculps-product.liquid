{%- assign v0 = product.selected_or_first_available_variant -%}
{%- assign tone_hex    = '#F5E6D8,#E8C9A0,#C8956C,#A0714F,#7B4F3A,#3D2314' | split: ',' -%}
{%- assign tone_names  = 'PORCELAIN,LIGHT,MEDIUM,TAN,DEEP,RICH'             | split: ',' -%}
{%- assign color_hex   = '#F5B8C4,#9BAF8A,#C9B8E8,#7B9AB5'                  | split: ',' -%}

<!-- Variant data for JS -->
<script>
window.spV = {
  variants: {{ product.variants | json }},
  sel: {
    {%- for o in product.options_with_values -%}
      {{ o.position }}: {{ o.values | first | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
};
</script>

{% form 'product', product, id: 'sp-form', novalidate: 'novalidate' %}
<input type="hidden" name="id" id="sp-vid" value="{{ v0.id }}">

<div class="sp-pdp">

  {%- for block in section.blocks -%}

    {%- case block.type -%}

    {%- when 'images' -%}
    <!–– ═══ IMAGES ═══ ––>
    <div class="sp-imgs" {{ block.shopify_attributes }}>
      {%- if product.images.size > 0 -%}
        <div class="sp-img-track" id="sp-track">
          {%- for img in product.images -%}
            <div class="sp-img-slide">
              <img src="{{ img | image_url: width: 900 }}"
                alt="{{ img.alt | default: product.title | escape }}"
                loading="{%- if forloop.first -%}eager{%- else -%}lazy{%- endif -%}"
                width="900">
            </div>
          {%- endfor -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="sp-dots" id="sp-dots">
            {%- for img in product.images -%}
              <button class="sp-dot{%- if forloop.first %} active{%- endif -%}" type="button"
                data-idx="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="sp-img-placeholder">
          <p>Add images in Shopify Admin → Products → {{ product.title }}</p>
        </div>
      {%- endif -%}
    </div>

    {%- when 'title_price' -%}
    <!–– ═══ TITLE & PRICE ═══ ––>
    <div class="sp-title-block" {{ block.shopify_attributes }}>
      <h1 class="sp-title">{{ product.title }}</h1>
      {%- if block.settings.subtitle != blank -%}
        <p class="sp-subtitle">{{ block.settings.subtitle }}</p>
      {%- endif -%}
      <div class="sp-price-row">
        <span class="sp-price" id="sp-price">{{ v0.price | money }}</span>
        {%- if v0.compare_at_price > v0.price -%}
          <span class="sp-compare" id="sp-compare">{{ v0.compare_at_price | money }}</span>
          <span class="sp-save-badge" id="sp-save">SAVE {{ v0.compare_at_price | minus: v0.price | money }}</span>
        {%- endif -%}
      </div>
      {%- if block.settings.tagline != blank -%}
        <p class="sp-tagline">{{ block.settings.tagline }}</p>
      {%- endif -%}
      {%- if block.settings.show_stars and block.settings.review_count > 0 -%}
        <div class="sp-stars">
          <span class="sp-star-icons">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span class="sp-star-count">({{ block.settings.review_count }} reviews)</span>
        </div>
      {%- endif -%}
    </div>

    {%- when 'bullet_points' -%}
    <!–– ═══ BULLET POINTS ═══ ––>
    {%- assign has_b = false -%}
    {%- for n in (1..6) -%}{%- assign k = 'b' | append: n -%}{%- if block.settings[k] != blank -%}{%- assign has_b = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_b -%}
      <ul class="sp-bullets" {{ block.shopify_attributes }}>
        {%- for n in (1..6) -%}
          {%- assign k = 'b' | append: n -%}
          {%- if block.settings[k] != blank -%}
            <li>{{ block.settings[k] }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div {{ block.shopify_attributes }}></div>
    {%- endif -%}

    {%- when 'bundle' -%}
    <!–– ═══ BUNDLE ITEMS ═══ ––>
    {%- assign bp1 = block.settings.p1 -%}
    {%- assign bp2 = block.settings.p2 -%}
    {%- assign bp3 = block.settings.p3 -%}
    {%- if bp1 != blank or bp2 != blank or bp3 != blank -%}
      <div class="sp-bundle" {{ block.shopify_attributes }}>
        {%- if block.settings.label != blank -%}
          <p class="sp-bundle-label">{{ block.settings.label }}</p>
        {%- endif -%}
        <div class="sp-bundle-grid">
          {%- for n in (1..3) -%}
            {%- assign pk = 'p' | append: n -%}
            {%- assign bp = block.settings[pk] -%}
            {%- if bp != blank -%}
              <div class="sp-bundle-item">
                {%- if bp.featured_image -%}
                  <img src="{{ bp.featured_image | image_url: width: 300 }}" alt="{{ bp.title | escape }}" class="sp-bundle-img" loading="lazy">
                {%- else -%}
                  <div class="sp-bundle-img sp-bundle-ph"></div>
                {%- endif -%}
                <p class="sp-bundle-name">{{ bp.title | upcase }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div {{ block.shopify_attributes }}></div>
    {%- endif -%}

    {%- when 'skin_tone' -%}
    <!–– ═══ SKIN TONE ═══ ––>
    {%- assign tone_opt = nil -%}
    {%- for o in product.options_with_values -%}
      {%- if o.name == 'Skin Tone' or o.name == 'Shade' or o.name == 'Tone' -%}{%- assign tone_opt = o -%}{%- endif -%}
    {%- endfor -%}
    {%- if tone_opt -%}
      <div class="sp-opt-group" {{ block.shopify_attributes }}>
        <p class="sp-opt-label">CHOOSE YOUR SKIN TONE</p>
        <div class="sp-tones">
          {%- for val in tone_opt.values -%}
            {%- assign ti = forloop.index0 -%}
            <button class="sp-tone{%- if forloop.first %} active{%- endif -%}"
              type="button"
              data-pos="{{ tone_opt.position }}"
              data-val="{{ val | escape }}"
              style="background:{{ tone_hex[ti] | default: '#ccc' }}"
              title="{{ tone_names[ti] | default: val }}">
              <span class="sp-tone-name">{{ tone_names[ti] | default: val }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div {{ block.shopify_attributes }}></div>
    {%- endif -%}

    {%- when 'color' -%}
    <!–– ═══ COLOR ═══ ––>
    {%- assign col_opt = nil -%}
    {%- for o in product.options_with_values -%}
      {%- if o.name == 'Color' or o.name == 'Colour' -%}{%- assign col_opt = o -%}{%- endif -%}
    {%- endfor -%}
    {%- if col_opt -%}
      <div class="sp-opt-group" {{ block.shopify_attributes }}>
        <p class="sp-opt-label">CHOOSE YOUR COLOR: <span id="sp-col-val">{{ col_opt.values | first }}</span></p>
        <div class="sp-colors">
          {%- for val in col_opt.values -%}
            {%- assign ci = forloop.index0 -%}
            <button class="sp-color{%- if forloop.first %} active{%- endif -%}"
              type="button"
              data-pos="{{ col_opt.position }}"
              data-val="{{ val | escape }}"
              style="background:{{ color_hex[ci] | default: '#eee' }}"
              title="{{ val | escape }}">
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div {{ block.shopify_attributes }}></div>
    {%- endif -%}

    {%- when 'size' -%}
    <!–– ═══ SIZE ═══ ––>
    {%- assign size_opt = nil -%}
    {%- for o in product.options_with_values -%}
      {%- if o.name == 'Size' -%}{%- assign size_opt = o -%}{%- endif -%}
    {%- endfor -%}
    {%- if size_opt -%}
      <div class="sp-opt-group" {{ block.shopify_attributes }}>
        <p class="sp-opt-label">CHOOSE YOUR SIZE</p>
        <div class="sp-sizes">
          {%- for val in size_opt.values -%}
            <button class="sp-size{%- if forloop.first %} active{%- endif -%}"
              type="button"
              data-pos="{{ size_opt.position }}"
              data-val="{{ val | escape }}">{{ val }}</button>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div {{ block.shopify_attributes }}></div>
    {%- endif -%}

    {%- when 'add_to_cart' -%}
    <!–– ═══ ADD TO CART ═══ ––>
    <div class="sp-atc-block" {{ block.shopify_attributes }}>
      <button type="submit" name="add" class="sp-atc" id="sp-atc"
        {%- unless v0.available %} disabled{%- endunless -%}>
        {%- if v0.available -%}
          {{ block.settings.btn_text | default: 'ADD TO CART' }} &bull; <span id="sp-btn-price">{{ v0.price | money }}</span>
        {%- else -%}
          SOLD OUT
        {%- endif -%}
      </button>
      {%- if block.settings.note != blank -%}
        <p class="sp-atc-note">{{ block.settings.note }}</p>
      {%- endif -%}
    </div>

    {%- when 'whats_included' -%}
    <!–– ═══ WHAT'S INCLUDED ═══ ––>
    {%- assign has_items = false -%}
    {%- for n in (1..8) -%}{%- assign k = 'i' | append: n -%}{%- if block.settings[k] != blank -%}{%- assign has_items = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_items -%}
      <div class="sp-included" {{ block.shopify_attributes }}>
        <p class="sp-included-h">{{ block.settings.heading | default: "WHAT'S INCLUDED" }}</p>
        <ul class="sp-included-list">
          {%- for n in (1..8) -%}
            {%- assign k = 'i' | append: n -%}
            {%- if block.settings[k] != blank -%}
              <li><span class="sp-check">✓</span>{{ block.settings[k] }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- else -%}
      <div {{ block.shopify_attributes }}></div>
    {%- endif -%}

    {%- when 'fbt' -%}
    <!–– ═══ FREQUENTLY BOUGHT TOGETHER ═══ ––>
    {%- assign fp1 = block.settings.p1 -%}
    {%- assign fp2 = block.settings.p2 -%}
    {%- if fp1 != blank or fp2 != blank -%}
      <div class="sp-fbt" {{ block.shopify_attributes }}>
        <p class="sp-fbt-h">{{ block.settings.heading | default: 'FREQUENTLY BOUGHT TOGETHER' }}</p>
        <div class="sp-fbt-grid">
          {%- for n in (1..2) -%}
            {%- assign pk = 'p' | append: n -%}
            {%- assign fp = block.settings[pk] -%}
            {%- if fp != blank -%}
              {%- assign fpv = fp.first_available_variant -%}
              {%- unless forloop.first -%}<div class="sp-fbt-plus">+</div>{%- endunless -%}
              <div class="sp-fbt-item">
                {%- if fp.featured_image -%}
                  <a href="{{ fp.url }}">
                    <img src="{{ fp.featured_image | image_url: width: 400 }}"
                      alt="{{ fp.title | escape }}" class="sp-fbt-img" loading="lazy">
                  </a>
                {%- else -%}
                  <a href="{{ fp.url }}" class="sp-fbt-img sp-fbt-ph"></a>
                {%- endif -%}
                <p class="sp-fbt-name">{{ fp.title | upcase }}</p>
                <p class="sp-fbt-price">{{ fp.price | money }}</p>
                {%- if fpv -%}
                  <button class="sp-fbt-btn sp-atc-btn" type="button"
                    data-variant-id="{{ fpv.id }}">ADD TO CART</button>
                {%- else -%}
                  <a href="{{ fp.url }}" class="sp-fbt-btn">VIEW PRODUCT</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div {{ block.shopify_attributes }}></div>
    {%- endif -%}

    {%- when 'trust' -%}
    <!–– ═══ TRUST BADGES ═══ ––>
    <div class="sp-trust" {{ block.shopify_attributes }}>
      {%- for n in (1..4) -%}
        {%- assign lk = 't' | append: n | append: 'l' -%}
        {%- assign sk = 't' | append: n | append: 's' -%}
        {%- assign ik = 't' | append: n | append: 'i' -%}
        {%- if block.settings[lk] != blank -%}
          <div class="sp-trust-item">
            <div class="sp-trust-ico">
              {%- case block.settings[ik] -%}
                {%- when 'shield' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- when 'refresh' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="23,4 23,10 17,10"/><polyline points="1,20 1,14 7,14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
                {%- when 'drop' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z"/></svg>
                {%- when 'heart' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
              {%- endcase -%}
            </div>
            <div class="sp-trust-label">{{ block.settings[lk] }}</div>
            {%- if block.settings[sk] != blank -%}
              <div class="sp-trust-sub">{{ block.settings[sk] }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- when 'reviews' -%}
    <!–– ═══ REVIEWS ═══ ––>
    {%- assign has_r = false -%}
    {%- for n in (1..6) -%}{%- assign k = 'r' | append: n | append: 't' -%}{%- if block.settings[k] != blank -%}{%- assign has_r = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_r -%}
      <div class="sp-reviews" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <p class="sp-reviews-h">{{ block.settings.heading }}</p>
        {%- endif -%}
        <div class="sp-reviews-grid">
          {%- for n in (1..6) -%}
            {%- assign tk = 'r' | append: n | append: 't' -%}
            {%- assign nk = 'r' | append: n | append: 'n' -%}
            {%- assign stk = 'r' | append: n | append: 's' -%}
            {%- if block.settings[tk] != blank -%}
              {%- assign rs = block.settings[stk] | default: 5 -%}
              <div class="sp-review">
                <div class="sp-review-stars">
                  {%- for i in (1..5) -%}<span style="color:{%- if i <= rs -%}#F5A623{%- else -%}#ddd{%- endif -%}">&#9733;</span>{%- endfor -%}
                </div>
                <p class="sp-review-text">"{{ block.settings[tk] }}"</p>
                <p class="sp-review-name">{{ block.settings[nk] | default: 'Customer' }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div {{ block.shopify_attributes }}></div>
    {%- endif -%}

    {%- endcase -%}
  {%- endfor -%}

</div>
{% endform %}

<!-- ═══ JAVASCRIPT ═══ -->
<script>
(function(){
  var variants = window.spV.variants;
  var sel      = window.spV.sel;

  function money(cents){
    return '$'+(cents/100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');
  }

  function findVariant(){
    return variants.find(function(v){
      return v.options.every(function(val,i){ return sel[i+1]===val; });
    }) || variants[0];
  }

  function update(v){
    if(!v) return;
    /* hidden form field */
    var vid = document.getElementById('sp-vid');
    if(vid) vid.value = v.id;
    /* price */
    var prEl    = document.getElementById('sp-price');
    var cpEl    = document.getElementById('sp-compare');
    var svEl    = document.getElementById('sp-save');
    var bpEl    = document.getElementById('sp-btn-price');
    if(prEl) prEl.textContent = money(v.price);
    if(bpEl) bpEl.textContent = money(v.price);
    if(v.compare_at_price && v.compare_at_price > v.price){
      if(cpEl){ cpEl.textContent=money(v.compare_at_price); cpEl.style.display=''; }
      if(svEl){ svEl.textContent='SAVE '+money(v.compare_at_price-v.price); svEl.style.display=''; }
    } else {
      if(cpEl) cpEl.style.display='none';
      if(svEl) svEl.style.display='none';
    }
    /* ATC button */
    var btn = document.getElementById('sp-atc');
    if(btn){
      btn.disabled = !v.available;
      var lbl = btn.querySelector('#sp-atc-label');
      if(lbl) lbl.textContent = v.available ? 'ADD TO CART' : 'SOLD OUT';
    }
    /* swap to variant image */
    if(v.featured_image){
      var slide = document.querySelector('.sp-img-slide');
      if(slide){
        var img = slide.querySelector('img');
        if(img) img.src = v.featured_image.src.replace(/\.(jpg|jpeg|png|gif|webp)(\?|$)/i,'_900x.$1$2');
      }
    }
  }

  /* option button clicks */
  document.addEventListener('click', function(e){
    var btn = e.target.closest('[data-pos]');
    if(!btn) return;
    var pos = parseInt(btn.dataset.pos, 10);
    var val = btn.dataset.val;
    sel[pos] = val;
    /* mark active */
    var grp = btn.closest('.sp-tones,.sp-colors,.sp-sizes');
    if(grp) grp.querySelectorAll('[data-pos]').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    /* update color label */
    var cv = document.getElementById('sp-col-val');
    if(cv && btn.closest('.sp-colors')) cv.textContent = val;
    update(findVariant());
  });

  /* image carousel dots */
  var track = document.getElementById('sp-track');
  var dots  = document.querySelectorAll('.sp-dot');
  if(track && dots.length){
    dots.forEach(function(dot){
      dot.addEventListener('click', function(){
        var idx = parseInt(dot.dataset.idx, 10);
        track.scrollTo({ left: track.offsetWidth * idx, behavior: 'smooth' });
        dots.forEach(function(d){ d.classList.remove('active'); });
        dot.classList.add('active');
      });
    });
    /* sync dots on scroll */
    track.addEventListener('scroll', function(){
      var idx = Math.round(track.scrollLeft / track.offsetWidth);
      dots.forEach(function(d,i){ d.classList.toggle('active', i===idx); });
    }, { passive: true });
  }

  /* form loading state */
  var form = document.getElementById('sp-form');
  if(form){
    form.addEventListener('submit', function(){
      var b = document.getElementById('sp-atc');
      if(b && !b.disabled){ b.classList.add('loading'); }
    });
  }

  update(findVariant());
})();
</script>

<!-- ═══ STYLES ═══ -->
<style>
/* ── Container ────────────────────────────────────────────── */
.sp-pdp { max-width: 560px; margin: 0 auto; }

/* ── Images ───────────────────────────────────────────────── */
.sp-imgs { position: relative; }
.sp-img-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
.sp-img-track::-webkit-scrollbar { display: none; }
.sp-img-slide { flex: 0 0 100%; scroll-snap-align: start; }
.sp-img-slide img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; }
.sp-dots { display: flex; justify-content: center; gap: 6px; padding: 12px 0 4px; }
.sp-dot { width: 8px; height: 8px; border-radius: 50%; background: #ccc; border: none; cursor: pointer; padding: 0; transition: background .2s; }
.sp-dot.active { background: #1A1410; }
.sp-img-placeholder { aspect-ratio: 1/1; background: #f4f4f4; display: flex; align-items: center; justify-content: center; text-align: center; padding: 24px; color: #999; font-size: 13px; line-height: 1.6; }

/* ── Title & Price ────────────────────────────────────────── */
.sp-title-block { padding: 20px 16px 0; text-align: center; }
.sp-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(28px, 7vw, 44px); letter-spacing: 2px; color: #1A1410; margin: 0 0 6px; line-height: 1.1; }
.sp-subtitle { font-size: 14px; color: #555; margin: 0 0 12px; line-height: 1.5; }
.sp-price-row { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
.sp-price { font-family: 'Bebas Neue', sans-serif; font-size: 36px; letter-spacing: 1px; color: #1A1410; }
.sp-compare { font-size: 20px; color: #aaa; text-decoration: line-through; }
.sp-save-badge { background: #1A1410; color: #fff; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; padding: 5px 12px; }
.sp-tagline { font-size: 14px; color: #666; margin: 0 0 8px; }
.sp-stars { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 4px; }
.sp-star-icons { color: #F5A623; font-size: 15px; letter-spacing: 1px; }
.sp-star-count { font-size: 13px; color: #888; }

/* ── Bullets ──────────────────────────────────────────────── */
.sp-bullets { list-style: none; padding: 0 16px; margin: 0; display: flex; flex-direction: column; gap: 6px; }
.sp-bullets li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: #333; }
.sp-bullets li::before { content: '✓'; color: #1A1410; font-weight: 900; flex-shrink: 0; }

/* ── Bundle ───────────────────────────────────────────────── */
.sp-bundle { padding: 0 16px; }
.sp-bundle-label { font-size: 12px; font-weight: 800; letter-spacing: 2px; color: #1A1410; margin: 0 0 12px; }
.sp-bundle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.sp-bundle-item { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.sp-bundle-img { width: 100%; aspect-ratio: 1/1; object-fit: cover; }
.sp-bundle-ph { background: #f4f4f4; }
.sp-bundle-name { font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #1A1410; text-align: center; line-height: 1.3; }

/* ── Option groups ────────────────────────────────────────── */
.sp-opt-group { padding: 0 16px; }
.sp-opt-label { font-size: 11px; font-weight: 800; letter-spacing: 2px; color: #1A1410; margin: 0 0 10px; }

/* ── Skin tones ───────────────────────────────────────────── */
.sp-tones { display: flex; gap: 8px; flex-wrap: wrap; }
.sp-tone { width: 44px; height: 44px; border-radius: 50%; border: 3px solid transparent; cursor: pointer; position: relative; padding: 0; transition: transform .15s; }
.sp-tone:hover { transform: scale(1.08); }
.sp-tone.active { border-color: #1A1410; box-shadow: 0 0 0 2px #fff inset; }
.sp-tone-name { position: absolute; bottom: -18px; left: 50%; transform: translateX(-50%); font-size: 8px; font-weight: 700; letter-spacing: .5px; white-space: nowrap; color: #666; }

/* ── Colors ───────────────────────────────────────────────── */
.sp-colors { display: flex; gap: 8px; flex-wrap: wrap; }
.sp-color { width: 32px; height: 32px; border-radius: 50%; border: 3px solid transparent; cursor: pointer; padding: 0; transition: transform .15s; }
.sp-color:hover { transform: scale(1.1); }
.sp-color.active { border-color: #1A1410; box-shadow: 0 0 0 2px #fff inset; }

/* ── Size buttons ─────────────────────────────────────────── */
.sp-sizes { display: flex; gap: 8px; flex-wrap: wrap; }
.sp-size { padding: 12px 20px; border: 1.5px solid #1A1410; background: #fff; color: #1A1410; font-family: inherit; font-size: 13px; font-weight: 700; letter-spacing: .5px; cursor: pointer; transition: all .15s; white-space: nowrap; line-height: 1; min-width: 52px; text-align: center; }
.sp-size:hover { background: #f4f2ef; }
.sp-size.active { background: #1A1410; color: #fff; }

/* ── Add to Cart ──────────────────────────────────────────── */
.sp-atc-block { padding: 0 16px; }
.sp-atc { display: block; width: 100%; padding: 18px 24px; background: #1A1410; color: #fff; border: none; font-family: inherit; font-size: 13px; font-weight: 900; letter-spacing: 3px; text-transform: uppercase; cursor: pointer; transition: background .2s; text-align: center; }
.sp-atc:hover:not(:disabled) { background: #2d2520; }
.sp-atc:disabled { background: #999; cursor: default; }
.sp-atc.loading { opacity: .7; pointer-events: none; }
.sp-atc-note { font-size: 12px; color: #888; text-align: center; margin: 8px 0 0; }

/* ── What's Included ──────────────────────────────────────── */
.sp-included { padding: 0 16px; }
.sp-included-h { font-size: 11px; font-weight: 900; letter-spacing: 3px; color: #1A1410; margin: 0 0 12px; }
.sp-included-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
.sp-included-list li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: #333; }
.sp-check { color: #1A1410; font-weight: 900; }

/* ── FBT ──────────────────────────────────────────────────── */
.sp-fbt { padding: 0 16px; }
.sp-fbt-h { font-size: 11px; font-weight: 900; letter-spacing: 3px; color: #1A1410; margin: 0 0 16px; }
.sp-fbt-grid { display: flex; align-items: flex-start; gap: 0; }
.sp-fbt-plus { display: flex; align-items: center; justify-content: center; width: 32px; flex-shrink: 0; font-size: 20px; font-weight: 300; color: #1A1410; align-self: center; }
.sp-fbt-item { flex: 1; display: flex; flex-direction: column; gap: 6px; }
.sp-fbt-img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; }
.sp-fbt-ph { aspect-ratio: 1/1; background: #f4f4f4; display: block; }
.sp-fbt-name { font-size: 11px; font-weight: 700; letter-spacing: 1px; color: #1A1410; line-height: 1.3; }
.sp-fbt-price { font-size: 14px; color: #1A1410; font-weight: 600; }
.sp-fbt-btn { display: block; width: 100%; padding: 10px; border: 1.5px solid #1A1410; background: #fff; color: #1A1410; font-family: inherit; font-size: 10px; font-weight: 800; letter-spacing: 2px; text-align: center; cursor: pointer; text-decoration: none; transition: background .15s, color .15s; }
.sp-fbt-btn:hover { background: #1A1410; color: #fff; }

/* ── Trust ────────────────────────────────────────────────── */
.sp-trust { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding: 0 16px; border-top: 1px solid #f0ede8; padding-top: 20px; }
@media(max-width:400px){ .sp-trust { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
.sp-trust-item { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
.sp-trust-ico { color: #1A1410; }
.sp-trust-label { font-size: 9px; font-weight: 800; letter-spacing: 1.5px; color: #1A1410; line-height: 1.3; }
.sp-trust-sub { font-size: 9px; color: #888; line-height: 1.4; }

/* ── Reviews ──────────────────────────────────────────────── */
.sp-reviews { padding: 0 16px; }
.sp-reviews-h { font-size: 11px; font-weight: 900; letter-spacing: 3px; color: #1A1410; margin: 0 0 16px; }
.sp-reviews-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media(max-width:400px){ .sp-reviews-grid { grid-template-columns: 1fr; } }
.sp-review { background: #f8f7f5; padding: 16px; }
.sp-review-stars { font-size: 13px; letter-spacing: 1px; margin-bottom: 8px; }
.sp-review-text { font-size: 13px; color: #444; line-height: 1.6; margin: 0 0 8px; font-style: italic; }
.sp-review-name { font-size: 10px; font-weight: 700; letter-spacing: 1.5px; color: #1A1410; margin: 0; }

/* ── Spacing between blocks ───────────────────────────────── */
.sp-pdp > * + * { margin-top: 28px; }
.sp-imgs + * { margin-top: 0; }
</style>

