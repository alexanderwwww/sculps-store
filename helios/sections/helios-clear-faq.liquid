{%- comment -%} HELIOS — Clear FAQ with video. Accordion + looping product video side by side. {%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
<section class="helios" id="cfq-{{ sid }}">
<a id="faq"></a>
<style>
  #cfq-{{ sid }}{--ink:#0F1111;--mut:#565959;--line:#D5D9D9;--ok:#067D62;overflow-x:clip;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:{{ s.bg | default: '#FFFFFF' }};}
  #cfq-{{ sid }} *{box-sizing:border-box;min-width:0;}
  #cfq-{{ sid }} .wrap{max-width:1100px;margin:0 auto;padding:clamp(var(--sp-5,34px),5vw,var(--sp-6,55px)) var(--sp-4,21px);}
  #cfq-{{ sid }} .head{text-align:center;margin:0 0 24px;}
  #cfq-{{ sid }} .ey{font-size:12px;font-weight:700;color:var(--mut);}
  #cfq-{{ sid }} h2{font-size:clamp(var(--fs-md,20.4px),2.8vw,var(--fs-lg,25.9px));font-weight:800;letter-spacing:-.015em;line-height:1.2;margin:6px 0 0;color:var(--ink);}
  /* Equal flex basis rather than fr tracks behind a breakpoint: an ancestor
     was sizing these grids to their content instead of stretching them, which
     collapsed columns to whatever text happened to be in them. A declared
     basis splits the row evenly and wraps on its own. */
  #cfq-{{ sid }} .cols{display:flex !important;flex-wrap:wrap;align-items:flex-start;
    gap:clamp(18px,2.4vw,38px);width:100% !important;}
  #cfq-{{ sid }} .cols > *{flex:1 1 340px;min-width:0;max-width:100%;}
  #cfq-{{ sid }} .vid{position:relative;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#0d1117;aspect-ratio:9/12;}
  @media(max-width:859px){#cfq-{{ sid }} .vid{aspect-ratio:4/3;}}
  #cfq-{{ sid }} .vid video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
  #cfq-{{ sid }} .faqs{display:grid;gap:10px;}
  #cfq-{{ sid }} .fq{border:1px solid var(--line);border-radius:12px;background:#fff;overflow:hidden;transition:border-color .25s;}
  #cfq-{{ sid }} .fq.on{border-color:var(--ink);}
  #cfq-{{ sid }} .fq.done{border-color:rgba(6,125,98,.45);}
  #cfq-{{ sid }} .fq .q{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 15px;cursor:pointer;font-weight:700;font-size:14.5px;color:var(--ink);}
  #cfq-{{ sid }} .fq .ico{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:14px;transition:transform .3s,background .3s;}
  #cfq-{{ sid }} .fq.on .ico{transform:rotate(135deg);}
  #cfq-{{ sid }} .fq.done:not(.on) .ico{background:var(--ok);transform:none;}
  #cfq-{{ sid }} .fq .p{max-height:0;overflow:hidden;transition:max-height .35s ease;}
  #cfq-{{ sid }} .fq .p .in{padding:0 15px 14px;color:var(--mut);font-size:14px;line-height:1.6;}
  @media(prefers-reduced-motion:reduce){#cfq-{{ sid }} .fq .p{transition:none}#cfq-{{ sid }} .fq .ico{transition:none}#cfq-{{ sid }} .vid video{display:none}}
</style>
<div class="wrap">
  <div class="head"><div class="ey">{{ s.eyebrow | default: 'Straight answers' }}</div><h2>{{ s.heading | default: 'The things people actually ask.' }}</h2></div>
  <div class="cols">
    <div class="vid">
      <video src="{{ s.video_url | default: 'https://cdn.shopify.com/videos/c/vp/5a4a60a7bc3946829bd78d5c914ad5f2/5a4a60a7bc3946829bd78d5c914ad5f2.HD-720p-1.6Mbps-89935160.mp4' }}"{% if s.poster_url != blank %} poster="{{ s.poster_url }}"{% endif %} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
    </div>
    <div class="faqs" data-faqs>
      <div class="fq on"><div class="q">Does it actually move on its own, or do I paddle?<span class="ico">+</span></div><div class="p"><div class="in">It moves itself. Twin electric thrusters push you forward and let you spin 360° with the joysticks, completely hands-free. No paddling, no gas.</div></div></div>
      <div class="fq"><div class="q">Is it safe for kids?<span class="ico">+</span></div><div class="p"><div class="in">Yes. The thrusters are fully enclosed with no exposed blades, and it cruises at a gentle walking pace. Kids ride with a parent, life jackets on like any water toy.</div></div></div>
      <div class="fq"><div class="q">Will it really hold an adult and the kids?<span class="ico">+</span></div><div class="p"><div class="in">Yes, rated up to 300 lb. Room for a parent and two kids, with a padded headrest and dual cup holders.</div></div></div>
      <div class="fq"><div class="q">How long does the battery last?<span class="ico">+</span></div><div class="p"><div class="in">3-4 hours of use per charge, a whole afternoon on the water, and it recharges between sessions.</div></div></div>
      <div class="fq"><div class="q">Is it durable, or will it pop?<span class="ico">+</span></div><div class="p"><div class="in">Heavy-duty reinforced PVC, thick material built to take a full summer of kids, docks and dragging. Not a flimsy pool toy.</div></div></div>
      <div class="fq"><div class="q">How hard is it to set up?<span class="ico">+</span></div><div class="p"><div class="in">Inflate it in about 5 minutes with the included nozzle, drop it in, grab the joysticks and go. No tools.</div></div></div>
      <div class="fq"><div class="q">What exactly do I get with the 1+1 deal?<span class="ico">+</span></div><div class="p"><div class="in">Two complete Super Glides, one for you and one free, plus free tracked shipping and the 30-day money-back guarantee.</div></div></div>
      <div class="fq"><div class="q">What if I do not love it?<span class="ico">+</span></div><div class="p"><div class="in">Send it back within 30 days for a full refund. No restocking fee, no argument.</div></div></div>
    </div>
  </div>
</div>
<script>
(function(){
  var root=document.getElementById('cfq-{{ sid }}'); if(!root||root.dataset.i)return; root.dataset.i='1';
  var fqs=[].slice.call(root.querySelectorAll('.fq'));
  function setH(f){var p=f.querySelector('.p');p.style.maxHeight=f.classList.contains('on')?p.scrollHeight+'px':'0px';}
  function markDone(f){if(f.classList.contains('ever')){f.classList.add('done');f.querySelector('.ico').textContent='✓';}}
  fqs.forEach(function(f){ if(f.classList.contains('on'))f.classList.add('ever'); setH(f);
    f.querySelector('.q').addEventListener('click',function(){
      var opening=!f.classList.contains('on');
      fqs.forEach(function(o){ if(o!==f && o.classList.contains('on')){ o.classList.remove('on'); markDone(o); setH(o); } });
      if(opening){ f.classList.add('on','ever'); f.classList.remove('done'); f.querySelector('.ico').textContent='+'; }
      else { f.classList.remove('on'); markDone(f); }
      setH(f);
    });
  });
  var v=root.querySelector('video');
  if(v){v.muted=true;var pr=v.play();if(pr&&pr.catch)pr.catch(function(){});}
})();
</script>
</section>
{% schema %}
{
  "name": "HELIOS Clear FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Straight answers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The things people actually ask." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "text", "id": "video_url", "label": "Video URL", "default": "https://cdn.shopify.com/videos/c/vp/5a4a60a7bc3946829bd78d5c914ad5f2/5a4a60a7bc3946829bd78d5c914ad5f2.HD-720p-1.6Mbps-89935160.mp4" },
    { "type": "text", "id": "poster_url", "label": "Poster image URL", "default": "https://cdn.shopify.com/s/files/1/0808/6949/0929/files/preview_images/5a4a60a7bc3946829bd78d5c914ad5f2.thumbnail.0000000000.jpg?v=1785074711" }
  ],
  "presets": [{ "name": "HELIOS Clear FAQ" }]
}
{% endschema %}
