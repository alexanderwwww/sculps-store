{%- comment -%}
  HELIOS — Sticky Add-to-Cart bar, liquid glass. Appears on scroll.
  Syncs with the Buy Box selection via the helios:variant event.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- unless product -%}{%- assign product = section.settings.featured_product -%}{%- endunless -%}
{%- assign cur = product.selected_or_first_available_variant -%}
<div class="helios" id="hs-{{ sid }}">
<style>
  #hs-{{ sid }} .bar{position:fixed;left:12px;right:12px;bottom:12px;z-index:70;
    background:rgba(255,255,255,.6);
    backdrop-filter:blur(24px) saturate(190%);-webkit-backdrop-filter:blur(24px) saturate(190%);
    border:1px solid rgba(255,255,255,.65);border-radius:22px;
    box-shadow:0 18px 44px -14px rgba(6,30,46,.32), inset 0 1px 0 rgba(255,255,255,.75);
    padding:10px 12px;display:flex;align-items:center;gap:12px;
    transform:translateY(140%);transition:transform .45s cubic-bezier(.2,.8,.2,1);
    max-width:720px;margin:0 auto;}
  #hs-{{ sid }} .bar.show{transform:translateY(0);}
  #hs-{{ sid }} *{box-sizing:border-box;min-width:0;}
  #hs-{{ sid }} .info{display:flex;align-items:center;gap:11px;flex:1 1 0;}
  #hs-{{ sid }} .thumb{width:44px;height:44px;flex-shrink:0;border-radius:12px;object-fit:cover;
    border:1px solid rgba(255,255,255,.7);box-shadow:0 2px 8px rgba(6,30,46,.14);}
  #hs-{{ sid }} .name{font-weight:800;font-size:14px;line-height:1.15;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#0F1111;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
  #hs-{{ sid }} .price{font-size:13px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
  #hs-{{ sid }} .price b{font-weight:800;color:#0F1111;}
  #hs-{{ sid }} .price s{color:#565959;margin-left:5px;}
  #hs-{{ sid }} .add{flex-shrink:0;background:#0F1111;color:#fff;border:none;border-radius:100px;
    padding:13px 22px;font-weight:800;font-size:14.5px;cursor:pointer;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
    box-shadow:0 10px 24px rgba(10,18,25,.3);}
</style>
  {%- assign hs_form_id = 'hs-form-' | append: sid -%}
  {%- form 'product', product, id: hs_form_id -%}
    <input type="hidden" name="id" id="hs-vid-{{ sid }}" value="{{ cur.id }}">
    <div class="bar" id="hs-bar-{{ sid }}">
      <div class="info">
        {%- if product.featured_image -%}<img class="thumb" src="{{ product.featured_image | image_url: width: 120 }}" alt="">{%- endif -%}
        <div style="min-width:0;">
          <div class="name">{{ section.settings.label | default: product.title }}</div>
          <div class="price"><b id="hs-price-{{ sid }}">{{ cur.price | money }}</b>{% if cur.compare_at_price > cur.price %}<s id="hs-old-{{ sid }}">{{ cur.compare_at_price | money }}</s>{% endif %}</div>
        </div>
      </div>
      <button type="submit" name="add" class="add">{{ section.settings.cta_text | default: 'Add to Cart' }}</button>
    </div>
  {%- endform -%}
<script>
(function(){
  var wrap=document.getElementById('hs-{{ sid }}'); if(!wrap||wrap.dataset.init) return; wrap.dataset.init='1';
  var bar=document.getElementById('hs-bar-{{ sid }}');
  var threshold={{ section.settings.scroll_trigger | default: 640 }};
  var ticking=false;
  function onScroll(){ if(ticking)return; ticking=true; requestAnimationFrame(function(){ var y=window.scrollY||window.pageYOffset; bar.classList.toggle('show', y>threshold); ticking=false; }); }
  window.addEventListener('scroll',onScroll,{passive:true}); onScroll();
  var hid=document.getElementById('hs-vid-{{ sid }}'), pr=document.getElementById('hs-price-{{ sid }}'), ol=document.getElementById('hs-old-{{ sid }}');
  /* Same card-terminal confirm as the buy box. This bar submits a real form, so
     it plays on submit — before the browser navigates away. */
  var actx=null;
  function chime(){
    try{
      var AC=window.AudioContext||window.webkitAudioContext; if(!AC)return;
      if(!actx)actx=new AC();
      if(actx.state==='suspended')actx.resume();
      var t=actx.currentTime;
      [[880,0],[1320,0.085]].forEach(function(n){
        var o=actx.createOscillator(), g=actx.createGain();
        o.type='sine'; o.frequency.setValueAtTime(n[0],t+n[1]);
        g.gain.setValueAtTime(0.0001,t+n[1]);
        g.gain.exponentialRampToValueAtTime(0.16,t+n[1]+0.012);
        g.gain.exponentialRampToValueAtTime(0.0001,t+n[1]+0.13);
        o.connect(g); g.connect(actx.destination);
        o.start(t+n[1]); o.stop(t+n[1]+0.15);
      });
    }catch(e){}
  }
  var hsForm=document.getElementById('hs-form-{{ sid }}');
  if(hsForm)hsForm.addEventListener('submit',chime);

  window.addEventListener('helios:variant', function(e){
    if(!e.detail) return;
    if(hid && e.detail.id) hid.value=e.detail.id;
    if(pr && e.detail.price) pr.textContent=e.detail.price;
    if(ol && e.detail.compare) ol.textContent=e.detail.compare;
  });
})();
</script>
</div>
{% schema %}
{
  "name": "HELIOS Sticky ATC",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "featured_product", "label": "Product (for homepage / non-product templates)" },
    { "type": "text", "id": "label", "label": "Product label", "default": "Super Glide" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Add to Cart" },
    { "type": "range", "id": "scroll_trigger", "label": "Show after scrolling (px)", "min": 200, "max": 1600, "step": 20, "default": 640 }
  ],
  "presets": [{ "name": "HELIOS Sticky ATC" }]
}
{% endschema %}
