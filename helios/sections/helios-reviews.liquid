{%- comment -%}
  HELIOS Reviews — Facebook-comment carousel with likes/replies.
  Keeps v1 setting IDs (eyebrow, heading, rating, review_count, dist_*).
  Reviews are now EDITABLE: blocks, or the bulk textarea (pipe-delimited).
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
<section class="helios" id="hrv-{{ sid }}">
<style>
  #hrv-{{ sid }}{background:{{ s.bg }};color:#050505;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:clamp(46px,6vw,82px) 0;overflow:hidden;}
  #hrv-{{ sid }} *{box-sizing:border-box;}
  #hrv-{{ sid }} .hd{max-width:1140px;margin:0 auto clamp(26px,4vw,42px);padding:0 22px;text-align:center;}
  #hrv-{{ sid }} .eb{font-size:13px;font-weight:800;letter-spacing:.05em;color:#F5A623;margin-bottom:9px;}
  #hrv-{{ sid }} h2{font-size:clamp(27px,4.2vw,46px);font-weight:900;letter-spacing:-.025em;line-height:1.05;margin:0 0 22px;text-wrap:balance;}
  #hrv-{{ sid }} .sumwrap{display:flex;flex-wrap:wrap;gap:26px;align-items:center;justify-content:center;max-width:660px;margin:0 auto;}
  #hrv-{{ sid }} .big{text-align:center;flex:0 0 auto;}
  #hrv-{{ sid }} .big b{display:block;font-size:52px;font-weight:900;letter-spacing:-.04em;line-height:1;}
  #hrv-{{ sid }} .big .st{color:#F5A623;font-size:16px;letter-spacing:2px;display:block;margin:6px 0 4px;}
  #hrv-{{ sid }} .big .ct{font-size:13px;color:#65676B;font-weight:600;}
  #hrv-{{ sid }} .dist{flex:1;min-width:250px;display:flex;flex-direction:column;gap:6px;}
  #hrv-{{ sid }} .drow{display:flex;align-items:center;gap:10px;font-size:12.5px;color:#65676B;font-weight:700;}
  #hrv-{{ sid }} .drow .lbl{width:28px;flex:0 0 28px;text-align:right;}
  #hrv-{{ sid }} .bar{flex:1;height:9px;border-radius:100px;background:#E4E6EB;overflow:hidden;}
  #hrv-{{ sid }} .bar i{display:block;height:100%;background:#F5A623;border-radius:100px;}
  #hrv-{{ sid }} .drow .pc{width:34px;flex:0 0 34px;}

  #hrv-{{ sid }} .row{display:flex;width:max-content;gap:14px;padding:6px 0;will-change:transform;animation:hrv-{{ sid }} {{ s.speed | default: 70 }}s linear infinite;}
  #hrv-{{ sid }} .track:hover .row{animation-play-state:paused;}
  @keyframes hrv-{{ sid }}{from{transform:translateX(0);}to{transform:translateX(-50%);}}
  @media(prefers-reduced-motion:reduce){#hrv-{{ sid }} .row{animation:none;}#hrv-{{ sid }} .track{overflow-x:auto;}}

  #hrv-{{ sid }} .c{flex:0 0 auto;width:min(365px,82vw);background:#fff;border-radius:14px;padding:13px 15px 10px;box-shadow:0 1px 2px rgba(0,0,0,.13),0 8px 26px -20px rgba(0,0,0,.5);}
  #hrv-{{ sid }} .who{display:flex;align-items:flex-start;gap:9px;}
  #hrv-{{ sid }} .av{width:38px;height:38px;border-radius:50%;flex:0 0 38px;background:linear-gradient(135deg,#1877F2,#0b5ec0);color:#fff;display:grid;place-items:center;font-weight:800;font-size:16px;object-fit:cover;}
  #hrv-{{ sid }} .bub{flex:1;min-width:0;background:#F0F2F5;border-radius:18px;padding:9px 13px 10px;}
  #hrv-{{ sid }} .nmrow{display:flex;align-items:center;gap:5px;}
  #hrv-{{ sid }} .nm{font-size:13.5px;font-weight:700;line-height:1.25;}
  #hrv-{{ sid }} .tick{width:13px;height:13px;flex:0 0 13px;}
  #hrv-{{ sid }} .stars{color:#F5A623;font-size:11px;letter-spacing:1px;display:block;margin:2px 0 5px;}
  #hrv-{{ sid }} .tx{font-size:14.5px;line-height:1.4;margin:0;word-wrap:break-word;}
  #hrv-{{ sid }} .ph{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:12px;margin-top:8px;display:block;}
  #hrv-{{ sid }} .meta{display:flex;align-items:center;gap:11px;padding:6px 0 0 61px;font-size:12px;font-weight:700;color:#65676B;}
  #hrv-{{ sid }} .meta .lk{color:#1877F2;}
  #hrv-{{ sid }} .meta .dot{width:3px;height:3px;border-radius:50%;background:#65676B;opacity:.55;}
  #hrv-{{ sid }} .rx{display:inline-flex;align-items:center;margin-left:auto;background:#fff;border-radius:100px;padding:2px 8px 2px 2px;box-shadow:0 1px 3px rgba(0,0,0,.18);}
  #hrv-{{ sid }} .rc{width:18px;height:18px;border-radius:50%;display:grid;place-items:center;border:1.5px solid #fff;flex:0 0 18px;}
  #hrv-{{ sid }} .rc svg{width:10px;height:10px;display:block;}
  #hrv-{{ sid }} .rc-l{background:#1877F2;}
  #hrv-{{ sid }} .rc-h{background:#F3425F;margin-left:-6px;}
  #hrv-{{ sid }} .rn{font-size:12.5px;color:#65676B;font-weight:600;margin-left:4px;}
</style>

  <div class="hd">
    <div class="sumwrap">
      <div class="big">
        <b>{{ s.rating }}</b>
        <span class="st">★★★★★</span>
        <span class="ct">{{ s.review_count }} verified reviews</span>
      </div>
      <div class="dist">
        {%- assign ds = '5,4,3,2,1' | split: ',' -%}
        {%- for n in ds -%}
          {%- case n -%}
            {%- when '5' -%}{%- assign v = s.dist_5 -%}{%- when '4' -%}{%- assign v = s.dist_4 -%}
            {%- when '3' -%}{%- assign v = s.dist_3 -%}{%- when '2' -%}{%- assign v = s.dist_2 -%}
            {%- else -%}{%- assign v = s.dist_1 -%}
          {%- endcase -%}
          <div class="drow"><span class="lbl">{{ n }}★</span><span class="bar"><i style="width:{{ v }}%"></i></span><span class="pc">{{ v }}%</span></div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- capture cards -%}
    {%- for b in section.blocks -%}
      <div class="c" {{ b.shopify_attributes }}>
        <div class="who">
          {%- if b.settings.avatar != blank -%}<img class="av" src="{{ b.settings.avatar | image_url: width: 100 }}" alt="" loading="lazy">
          {%- else -%}<span class="av">{{ b.settings.name | slice: 0 }}</span>{%- endif -%}
          <div class="bub">
            <div class="nmrow"><span class="nm">{{ b.settings.name }}</span><svg class="tick" viewBox="0 0 24 24" fill="#1877F2"><circle cx="12" cy="12" r="12"/><path d="M17 8.5l-6.6 6.8-3.4-3.3" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <span class="stars">{% for i in (1..b.settings.rating) %}★{% endfor %}</span>
            <p class="tx">{{ b.settings.text }}</p>
            {%- if b.settings.image != blank -%}<img class="ph" src="{{ b.settings.image | image_url: width: 700 }}" alt="{{ b.settings.name | escape }}" loading="lazy">{%- endif -%}
          </div>
        </div>
        <div class="meta"><span class="lk">Like</span><i class="dot"></i><span class="lk">Reply</span><i class="dot"></i><span>{{ b.settings.location }}</span><span class="rx"><span class="rc rc-l"><svg viewBox="0 0 16 16" fill="#fff"><path d="M6.4 14H4.6a.6.6 0 0 1-.6-.6V7.2a.6.6 0 0 1 .6-.6h1.8V14zm1.2 0V7.05c.55-.2 1-.62 1.3-1.2l1.05-2.1a.9.9 0 0 1 1.7.4v1.9h2.06c.62 0 1.08.57.95 1.18l-.9 4.3A1.6 1.6 0 0 1 12.2 14H7.6z"/></svg></span><span class="rc rc-h"><svg viewBox="0 0 16 16" fill="#fff"><path d="M8 13.6l-.9-.82C4 9.99 2.1 8.27 2.1 6.15 2.1 4.43 3.45 3.1 5.17 3.1c.97 0 1.9.45 2.5 1.16l.33.39.33-.39a3.3 3.3 0 0 1 2.5-1.16c1.72 0 3.07 1.33 3.07 3.05 0 2.12-1.9 3.84-5 6.63l-.9.82z"/></svg></span><span class="rn">{{ b.settings.likes }}</span></span></div>
      </div>
    {%- endfor -%}
    {%- assign lines = s.bulk | newline_to_br | split: '<br />' -%}
    {%- for line in lines -%}
      {%- assign L = line | strip -%}
      {%- if L != blank -%}
        {%- assign p = L | split: '|' -%}
        {%- assign nm = p[0] | strip -%}
        {%- assign rt = p[1] | strip | times: 1 -%}{%- if rt < 1 -%}{%- assign rt = 5 -%}{%- endif -%}
        {%- assign tx = p[2] | strip -%}
        {%- assign lo = p[3] | strip -%}
        {%- assign lc = p[4] | strip -%}
        {%- assign im = p[5] | strip -%}
        {%- if nm != blank and tx != blank -%}
        <div class="c">
          <div class="who">
            <span class="av">{{ nm | slice: 0 }}</span>
            <div class="bub">
              <div class="nmrow"><span class="nm">{{ nm }}</span><svg class="tick" viewBox="0 0 24 24" fill="#1877F2"><circle cx="12" cy="12" r="12"/><path d="M17 8.5l-6.6 6.8-3.4-3.3" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
              <span class="stars">{% for i in (1..rt) %}★{% endfor %}</span>
              <p class="tx">{{ tx }}</p>
              {%- if im != blank -%}<img class="ph" src="{{ im }}" alt="{{ nm | escape }}" loading="lazy">{%- endif -%}
            </div>
          </div>
          <div class="meta"><span class="lk">Like</span><i class="dot"></i><span class="lk">Reply</span><i class="dot"></i><span>{{ lo }}</span><span class="rx"><span class="rc rc-l"><svg viewBox="0 0 16 16" fill="#fff"><path d="M6.4 14H4.6a.6.6 0 0 1-.6-.6V7.2a.6.6 0 0 1 .6-.6h1.8V14zm1.2 0V7.05c.55-.2 1-.62 1.3-1.2l1.05-2.1a.9.9 0 0 1 1.7.4v1.9h2.06c.62 0 1.08.57.95 1.18l-.9 4.3A1.6 1.6 0 0 1 12.2 14H7.6z"/></svg></span><span class="rc rc-h"><svg viewBox="0 0 16 16" fill="#fff"><path d="M8 13.6l-.9-.82C4 9.99 2.1 8.27 2.1 6.15 2.1 4.43 3.45 3.1 5.17 3.1c.97 0 1.9.45 2.5 1.16l.33.39.33-.39a3.3 3.3 0 0 1 2.5-1.16c1.72 0 3.07 1.33 3.07 3.05 0 2.12-1.9 3.84-5 6.63l-.9.82z"/></svg></span><span class="rn">{{ lc }}</span></span></div>
        </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  <div class="track"><div class="row">{{ cards }}{{ cards }}</div></div>
</section>
{% schema %}
{
  "name": "HELIOS Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "★ 4.8 average" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What buyers are saying." },
    { "type": "text", "id": "rating", "label": "Rating number", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "3,912" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F7F9FB" },
    { "type": "range", "id": "speed", "label": "Seconds per loop", "min": 25, "max": 160, "step": 5, "unit": "s", "default": 70 },
    { "type": "header", "content": "Star distribution (%)" },
    { "type": "range", "id": "dist_5", "label": "5 star", "min": 0, "max": 100, "step": 1, "default": 86 },
    { "type": "range", "id": "dist_4", "label": "4 star", "min": 0, "max": 100, "step": 1, "default": 11 },
    { "type": "range", "id": "dist_3", "label": "3 star", "min": 0, "max": 100, "step": 1, "default": 2 },
    { "type": "range", "id": "dist_2", "label": "2 star", "min": 0, "max": 100, "step": 1, "default": 1 },
    { "type": "range", "id": "dist_1", "label": "1 star", "min": 0, "max": 100, "step": 1, "default": 0 },
    { "type": "header", "content": "Reviews — bulk" },
    { "type": "textarea", "id": "bulk", "label": "One review per line", "info": "Name | Rating(1-5) | Text | Location | Likes | Image URL (optional)", "default": "" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Happy Customer" },
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "text", "label": "Review text" },
      { "type": "text", "id": "location", "label": "Location / date" },
      { "type": "text", "id": "likes", "label": "Like count", "default": "12" },
      { "type": "image_picker", "id": "image", "label": "Review photo" },
      { "type": "image_picker", "id": "avatar", "label": "Avatar" }
    ]}
  ],
  "presets": [{ "name": "HELIOS Reviews" }]
}
{% endschema %}
