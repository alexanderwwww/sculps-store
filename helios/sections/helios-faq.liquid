{%- comment -%}
  HELIOS — FAQ accordion (native <details>). sections/helios-faq.liquid
{%- endcomment -%}
{%- assign sid = section.id -%}
<section class="helios" id="hf-{{ sid }}">
<style>
  #hf-{{ sid }} .wrap{max-width:760px;margin:0 auto;padding:clamp(40px,7vw,80px) 22px;}
  #hf-{{ sid }} .head{text-align:center;margin:0 auto 36px;}
  #hf-{{ sid }} .ey{font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--helios-accd,#0A5E97);}
  #hf-{{ sid }} h2{font-family:'Archivo';font-weight:800;font-size:clamp(28px,4.2vw,46px);letter-spacing:-.02em;margin:12px 0 0;}
  #hf-{{ sid }} details{border-bottom:1px solid var(--helios-lins,rgba(12,26,36,.08));padding:18px 0;}
  #hf-{{ sid }} summary{list-style:none;font-family:'Archivo';font-weight:700;font-size:16px;cursor:pointer;display:flex;justify-content:space-between;gap:14px;align-items:center;}
  #hf-{{ sid }} summary::-webkit-details-marker{display:none;}
  #hf-{{ sid }} summary .pm{color:var(--helios-accd,#0A5E97);font-size:22px;font-weight:400;transition:transform .2s;}
  #hf-{{ sid }} details[open] summary .pm{transform:rotate(45deg);}
  #hf-{{ sid }} .ans{font-size:14px;color:var(--helios-mut,#56636E);margin:12px 0 0;}
</style>
<div class="wrap" id="faq" style="scroll-margin-top:84px;">
  <div class="head" data-reveal>
    {%- if section.settings.eyebrow != blank -%}<div class="ey">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
  </div>
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
        <summary>{{ block.settings.q }}<span class="pm">+</span></summary>
        <div class="ans">{{ block.settings.a }}</div>
      </details>
    {%- endfor -%}
  {%- else -%}
    {%- assign qs = "How long does the battery last?~Around 60 minutes of continuous cruising per charge, then it recharges between sessions.|How does it charge?~The removable battery pack recharges via the included charger — top it up between outings.|What's the weight limit?~Up to 300 lb. Reinforced chambers keep adults riding high and stable.|How fast does shipping take?~Order today and it ships within 24h, arriving in about 5–8 days with free shipping.|Is there a warranty?~Yes — plus a 30-day money-back guarantee. Not for you? Send it back for a full refund.|Pool or lake?~Both — any calm water: pools, lakes and gentle rivers. It packs down to travel anywhere." | split: "|" -%}
    {%- for qa in qs -%}
      {%- assign parts = qa | split: "~" -%}
      <details {% if forloop.first %}open{% endif %}>
        <summary>{{ parts[0] }}<span class="pm">+</span></summary>
        <div class="ans">{{ parts[1] }}</div>
      </details>
    {%- endfor -%}
  {%- endif -%}
</div>
</section>
{% schema %}
{
  "name": "HELIOS FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know." }
  ],
  "blocks": [
    { "type": "qa", "name": "Q&A", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "How long does the battery last?" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>Around 60 minutes of continuous cruising per charge. It recharges between sessions so you're ready for the next ride.</p>" }
    ]}
  ],
  "presets": [{
    "name": "HELIOS FAQ",
    "blocks": [
      { "type": "qa", "settings": { "q": "How long does the battery last?", "a": "<p>Around 60 minutes of continuous cruising per charge, then recharge between sessions.</p>" } },
      { "type": "qa", "settings": { "q": "How does it charge?", "a": "<p>The removable battery pack recharges via the included charger — top it up between outings.</p>" } },
      { "type": "qa", "settings": { "q": "What's the weight limit?", "a": "<p>Up to 300 lb. Reinforced chambers keep adults riding high and stable.</p>" } },
      { "type": "qa", "settings": { "q": "How fast does shipping take?", "a": "<p>Order today and it ships within 24h, arriving in about 5–8 days with free shipping.</p>" } },
      { "type": "qa", "settings": { "q": "Is there a warranty?", "a": "<p>Yes — plus a 30-day money-back guarantee. Not for you? Send it back for a full refund.</p>" } },
      { "type": "qa", "settings": { "q": "Pool or lake?", "a": "<p>Both — any calm water. Pools, lakes and gentle rivers. It packs down to travel anywhere.</p>" } }
    ]
  }]
}
{% endschema %}
