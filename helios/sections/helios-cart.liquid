{%- comment -%}
  HELIOS — slide-out cart. sections/helios-cart.liquid

  Replaces paying for a cart-drawer app. Opens whenever something is added,
  reads /cart.js so it is always the real cart, and edits quantities through
  /cart/change.js rather than a form post, so the page never reloads.

  Guards that matter, learned from the buy box:
    · every fetch checks the payload before trusting it — a 4xx from the cart
      API still resolves the promise
    · the checkout button locks on click, so a double tap cannot submit twice
    · quantity controls disable while a change is in flight, otherwise fast
      clicking races the responses and the last one home wins

  Classes are prefixed hcd- so Horizon's global stylesheet cannot reach in.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
<div class="helios" id="hcd-{{ sid }}">
<style>
  #hcd-{{ sid }}{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
  #hcd-{{ sid }} *{box-sizing:border-box;min-width:0;}
  #hcd-{{ sid }} .hcd-veil{position:fixed;inset:0;z-index:9990;background:rgba(11,14,17,.55);
    opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s;backdrop-filter:blur(2px);}
  #hcd-{{ sid }} .hcd-veil.on{opacity:1;visibility:visible;}
  #hcd-{{ sid }} .hcd-panel{position:fixed;top:0;right:0;bottom:0;z-index:9991;width:min(420px,100%);
    background:#fff;color:#0F1111;display:flex;flex-direction:column;
    transform:translateX(100%);transition:transform .34s cubic-bezier(.32,.72,0,1);
    box-shadow:-14px 0 40px rgba(0,0,0,.18);}
  #hcd-{{ sid }} .hcd-panel.on{transform:none;}

  #hcd-{{ sid }} .hcd-top{display:flex;align-items:center;justify-content:space-between;
    padding:var(--sp-4,21px);border-bottom:1px solid #E7E9E9;flex:none;}
  #hcd-{{ sid }} .hcd-title{font-size:var(--fs-base,16px);font-weight:800;letter-spacing:-.01em;}
  #hcd-{{ sid }} .hcd-x{width:34px;height:34px;border:0;background:#F0F2F2;border-radius:50%;
    cursor:pointer;font-size:19px;line-height:1;color:#0F1111;display:flex;align-items:center;
    justify-content:center;}
  #hcd-{{ sid }} .hcd-x:hover{background:#E1E5E5;}

  #hcd-{{ sid }} .hcd-ship{padding:var(--sp-3,13px) var(--sp-4,21px);background:#E3F6EC;
    color:#046B53;font-size:12.5px;font-weight:700;display:flex;align-items:center;gap:8px;flex:none;}
  #hcd-{{ sid }} .hcd-ship svg{width:16px;height:16px;flex:none;}

  #hcd-{{ sid }} .hcd-body{flex:1 1 auto;overflow-y:auto;padding:var(--sp-4,21px);}
  #hcd-{{ sid }} .hcd-line{display:flex;gap:var(--sp-3,13px);padding-bottom:var(--sp-4,21px);
    margin-bottom:var(--sp-4,21px);border-bottom:1px solid #F0F2F2;}
  #hcd-{{ sid }} .hcd-line:last-child{border-bottom:0;margin-bottom:0;}
  #hcd-{{ sid }} .hcd-thumb{flex:0 0 72px;width:72px;height:72px;border-radius:var(--r-sm,8px);
    overflow:hidden;background:#F7FAFA;border:1px solid #E7E9E9;}
  #hcd-{{ sid }} .hcd-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
  #hcd-{{ sid }} .hcd-info{flex:1 1 0;min-width:0;}
  #hcd-{{ sid }} .hcd-name{font-size:var(--fs-sm,14.1px);font-weight:700;line-height:1.3;}
  #hcd-{{ sid }} .hcd-var{font-size:12px;color:#565959;margin-top:2px;}
  #hcd-{{ sid }} .hcd-row{display:flex;align-items:center;justify-content:space-between;
    gap:var(--sp-2,8px);margin-top:var(--sp-2,8px);}
  #hcd-{{ sid }} .hcd-qty{display:inline-flex;align-items:center;border:1px solid #D5D9D9;
    border-radius:100px;overflow:hidden;}
  #hcd-{{ sid }} .hcd-qty button{width:30px;height:30px;border:0;background:#fff;cursor:pointer;
    font-size:15px;line-height:1;color:#0F1111;}
  #hcd-{{ sid }} .hcd-qty button:hover:not([disabled]){background:#F0F2F2;}
  #hcd-{{ sid }} .hcd-qty button[disabled]{opacity:.4;cursor:default;}
  #hcd-{{ sid }} .hcd-qty span{min-width:26px;text-align:center;font-size:13.5px;font-weight:700;}
  #hcd-{{ sid }} .hcd-price{font-size:var(--fs-sm,14.1px);font-weight:800;white-space:nowrap;}
  #hcd-{{ sid }} .hcd-was{display:block;font-size:11.5px;color:#565959;text-decoration:line-through;
    font-weight:400;}
  #hcd-{{ sid }} .hcd-del{background:none;border:0;padding:0;margin-top:5px;cursor:pointer;
    font-size:11.5px;color:#565959;text-decoration:underline;}

  #hcd-{{ sid }} .hcd-empty{text-align:center;padding:var(--sp-7,89px) var(--sp-4,21px);color:#565959;}
  #hcd-{{ sid }} .hcd-empty b{display:block;font-size:var(--fs-md,20.4px);color:#0F1111;
    margin-bottom:var(--sp-2,8px);letter-spacing:-.02em;}

  #hcd-{{ sid }} .hcd-foot{flex:none;border-top:1px solid #E7E9E9;padding:var(--sp-4,21px);
    background:#fff;}
  #hcd-{{ sid }} .hcd-sub{display:flex;justify-content:space-between;align-items:baseline;
    font-size:var(--fs-sm,14.1px);margin-bottom:6px;}
  #hcd-{{ sid }} .hcd-sub b{font-size:var(--fs-md,20.4px);font-weight:800;letter-spacing:-.02em;}
  #hcd-{{ sid }} .hcd-save{display:flex;justify-content:space-between;font-size:12.5px;
    color:#CC0C39;font-weight:700;margin-bottom:var(--sp-2,8px);}
  #hcd-{{ sid }} .hcd-note{font-size:11.5px;color:#565959;margin:0 0 var(--sp-3,13px);}
  #hcd-{{ sid }} .hcd-go{display:block;width:100%;background:#FFD814;color:#0F1111;
    border:1px solid #FCD200;border-radius:100px;padding:16px;font:inherit;
    font-size:16px;font-weight:800;cursor:pointer;text-align:center;}
  #hcd-{{ sid }} .hcd-go:hover:not([disabled]){background:#F7CA00;}
  #hcd-{{ sid }} .hcd-go[disabled]{opacity:.65;cursor:default;}
  #hcd-{{ sid }} .hcd-trust{display:flex;justify-content:center;gap:var(--sp-3,13px);
    margin-top:var(--sp-3,13px);font-size:11px;color:#565959;flex-wrap:wrap;}
  #hcd-{{ sid }} .hcd-trust span{display:inline-flex;align-items:center;gap:5px;}
  #hcd-{{ sid }} .hcd-trust svg{width:13px;height:13px;color:#046B53;}
  #hcd-{{ sid }} .hcd-err{font-size:12.5px;color:#B3261E;font-weight:700;margin:0 0 var(--sp-2,8px);}
  #hcd-{{ sid }} .hcd-err:empty{display:none;}
  @media(prefers-reduced-motion:reduce){
    #hcd-{{ sid }} .hcd-panel,#hcd-{{ sid }} .hcd-veil{transition:none;}
  }
</style>

  <div class="hcd-veil" data-veil></div>
  <aside class="hcd-panel" data-panel role="dialog" aria-modal="true" aria-label="Your cart">
    <div class="hcd-top">
      <span class="hcd-title">{{ s.heading | default: 'Your cart' }} <span data-count></span></span>
      <button type="button" class="hcd-x" data-close aria-label="Close cart">&times;</button>
    </div>

    {%- if s.ship_line != blank -%}
      <div class="hcd-ship">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7.5" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/></svg>
        {{ s.ship_line }}
      </div>
    {%- endif -%}

    <div class="hcd-body" data-body></div>

    <div class="hcd-foot" data-foot hidden>
      <p class="hcd-err" data-err role="status" aria-live="polite"></p>
      <div class="hcd-save" data-save hidden><span>{{ s.save_label | default: 'Discount' }}</span><span data-saveamt></span></div>
      <div class="hcd-sub"><span>{{ s.subtotal_label | default: 'Subtotal' }}</span><b data-sub></b></div>
      {%- if s.note != blank -%}<p class="hcd-note">{{ s.note }}</p>{%- endif -%}
      <button type="button" class="hcd-go" data-go>{{ s.cta | default: 'Checkout' }}</button>
      <div class="hcd-trust">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Secure checkout</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 3.5V8h-4.5"/></svg>30-day returns</span>
      </div>
    </div>
  </aside>
</div>

<script>
(function(){
  var SID='{{ sid }}', root=document.getElementById('hcd-'+SID);
  if(!root||root.dataset.on==='1')return; root.dataset.on='1';

  var veil=root.querySelector('[data-veil]'), panel=root.querySelector('[data-panel]'),
      body=root.querySelector('[data-body]'), foot=root.querySelector('[data-foot]'),
      sub=root.querySelector('[data-sub]'), cnt=root.querySelector('[data-count]'),
      go=root.querySelector('[data-go]'), err=root.querySelector('[data-err]'),
      saveRow=root.querySelector('[data-save]'), saveAmt=root.querySelector('[data-saveamt]');
  var busy=false;

  function money(c){
    return '$'+(c/100).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
  }
  function esc(v){ return String(v==null?'':v).replace(/[&<>"]/g,function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

  function open(){ veil.classList.add('on'); panel.classList.add('on');
    document.body.style.overflow='hidden'; }
  function close(){ veil.classList.remove('on'); panel.classList.remove('on');
    document.body.style.overflow=''; }

  function render(cart){
    err.textContent='';
    cnt.textContent=cart.item_count?'('+cart.item_count+')':'';
    if(!cart.item_count){
      body.innerHTML='<div class="hcd-empty"><b>{{ s.empty_title | default: "Your cart is empty" }}</b>'+
                     '{{ s.empty_text | default: "Add a Super Glide and it will show up here." }}</div>';
      foot.hidden=true; return;
    }
    var html='';
    cart.items.forEach(function(it,i){
      /* line_price is what this line actually costs after any automatic
         discount; original_line_price is before. Showing both is the only
         honest way to display a cart the merchant is discounting. */
      var cut=it.original_line_price>it.line_price;
      html+='<div class="hcd-line">'+
        '<span class="hcd-thumb">'+(it.image?'<img src="'+esc(it.image)+'" alt="">':'')+'</span>'+
        '<span class="hcd-info">'+
          '<span class="hcd-name">'+esc(it.product_title)+'</span>'+
          (it.variant_title&&it.variant_title!=='Default Title'
            ?'<span class="hcd-var">'+esc(it.variant_title)+'</span>':'')+
          '<span class="hcd-row">'+
            '<span class="hcd-qty">'+
              '<button type="button" data-dec="'+(i+1)+'" aria-label="Decrease">&minus;</button>'+
              '<span>'+it.quantity+'</span>'+
              '<button type="button" data-inc="'+(i+1)+'" aria-label="Increase">+</button>'+
            '</span>'+
            '<span class="hcd-price">'+money(it.line_price)+
              (cut?'<span class="hcd-was">'+money(it.original_line_price)+'</span>':'')+
            '</span>'+
          '</span>'+
          '<button type="button" class="hcd-del" data-del="'+(i+1)+'">Remove</button>'+
        '</span></div>';
    });
    body.innerHTML=html;
    sub.textContent=money(cart.total_price);
    var saved=cart.original_total_price-cart.total_price;
    if(saved>0){ saveRow.hidden=false; saveAmt.textContent='-'+money(saved); }
    else saveRow.hidden=true;
    foot.hidden=false;
  }

  function guard(r){
    return r.json().then(function(d){
      if(!r.ok||(d&&d.status&&d.status>=400)) throw new Error((d&&d.description)||'Cart error');
      return d;
    });
  }
  function load(show){
    return fetch('/cart.js',{headers:{Accept:'application/json'}}).then(guard)
      .then(function(c){ render(c); if(show)open(); })
      .catch(function(){ err.textContent='Could not load your cart. Refresh and try again.'; });
  }
  function change(line,qty){
    /* Lock while in flight: fast clicking otherwise races the responses and
       whichever lands last wins, which is not necessarily the last press. */
    if(busy)return; busy=true;
    root.querySelectorAll('.hcd-qty button,.hcd-del').forEach(function(b){b.disabled=true;});
    fetch('/cart/change.js',{method:'POST',
      headers:{'Content-Type':'application/json',Accept:'application/json'},
      body:JSON.stringify({line:line,quantity:qty})})
      .then(guard).then(render)
      .catch(function(e){ err.textContent=e.message||'That could not be updated.'; })
      .then(function(){ busy=false; });
  }

  body.addEventListener('click',function(e){
    var t=e.target.closest('[data-inc],[data-dec],[data-del]'); if(!t)return;
    var line, qty;
    var cur=parseInt(t.closest('.hcd-qty')?t.closest('.hcd-qty').querySelector('span').textContent:'0',10);
    if(t.hasAttribute('data-inc')){ line=+t.getAttribute('data-inc'); qty=cur+1; }
    else if(t.hasAttribute('data-dec')){ line=+t.getAttribute('data-dec'); qty=Math.max(0,cur-1); }
    else { line=+t.getAttribute('data-del'); qty=0; }
    change(line,qty);
  });

  veil.addEventListener('click',close);
  root.querySelector('[data-close]').addEventListener('click',close);
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&panel.classList.contains('on'))close();
  });

  /* One press, one checkout. The button locks immediately so a double tap on a
     slow connection cannot fire twice. */
  go.addEventListener('click',function(){
    if(go.disabled)return;
    go.disabled=true; go.textContent='{{ s.cta_busy | default: "Taking you to checkout…" }}';
    window.location='/checkout';
  });

  /* The buy box already broadcasts this after a successful add. */
  document.addEventListener('cart:refresh',function(){ load(true); });
  window.addEventListener('pageshow',function(){ load(false); });
  load(false);
})();
</script>
{% schema %}
{
  "name": "HELIOS cart drawer",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "text", "id": "ship_line", "label": "Shipping banner", "default": "Free US shipping on this order" },
    { "type": "text", "id": "save_label", "label": "Discount row label", "default": "August special" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "note", "label": "Note above the button", "default": "Taxes calculated at checkout. Shipping is free." },
    { "type": "text", "id": "cta", "label": "Checkout button", "default": "Checkout" },
    { "type": "text", "id": "cta_busy", "label": "Checkout button, pressed", "default": "Taking you to checkout…" },
    { "type": "text", "id": "empty_title", "label": "Empty title", "default": "Your cart is empty" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Add a Super Glide and it will show up here." }
  ],
  "presets": [{ "name": "HELIOS cart drawer" }]
}
{% endschema %}
