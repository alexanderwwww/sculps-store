{%- comment -%}
  HELIOS — image-led showcase.

  Deliberately light on words: one big picture per row, a short label and one
  line under it. Rows alternate sides on desktop and stack image-first on
  mobile, so the picture always leads.

  A block with no image is skipped rather than rendering an empty frame.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign shown = 0 -%}
{%- for b in section.blocks -%}{%- if b.settings.image != blank -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if shown > 0 -%}
<style>
  #hbsc-{{ section.id }}{background:var(--hb-soft,#F0F2F4);padding-block:44px 52px;}
  #hbsc-{{ section.id }} .hd{margin-bottom:26px;max-width:60ch;}
  #hbsc-{{ section.id }} .eyebrow{font-size:11px;font-weight:800;letter-spacing:.14em;
    text-transform:uppercase;color:var(--hb-blue,#0046BE);margin:0 0 8px;}
  #hbsc-{{ section.id }} .rows{display:grid;gap:18px;}
  #hbsc-{{ section.id }} .row{background:#fff;border-radius:14px;overflow:hidden;
    border:1px solid var(--hb-line-soft,#E3E7EB);display:grid;}
  #hbsc-{{ section.id }} .fig{margin:0;background:var(--hb-soft,#F0F2F4);aspect-ratio:4/3;}
  #hbsc-{{ section.id }} .fig img{width:100%;height:100%;object-fit:cover;}
  #hbsc-{{ section.id }} .txt{padding:24px;align-self:center;}
  #hbsc-{{ section.id }} .n{font-size:11px;font-weight:800;letter-spacing:.12em;
    text-transform:uppercase;color:var(--hb-muted,#5F6871);margin:0 0 8px;}
  #hbsc-{{ section.id }} .t{font-size:clamp(19px,2.6vw,25px);font-weight:800;letter-spacing:-.02em;
    line-height:1.15;margin:0;}
  #hbsc-{{ section.id }} .d{margin-top:9px;font-size:14.5px;line-height:1.55;
    color:var(--hb-muted,#5F6871);max-width:46ch;}
  #hbsc-{{ section.id }} .d:empty{display:none;}
  @media(min-width:900px){
    #hbsc-{{ section.id }} .row{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);align-items:stretch;}
    #hbsc-{{ section.id }} .fig{aspect-ratio:auto;min-height:340px;}
    #hbsc-{{ section.id }} .row.alt .fig{order:2;}
    #hbsc-{{ section.id }} .txt{padding:40px;}
  }
</style>
<div class="hb" id="hbsc-{{ section.id }}">
  <div class="hb-wrap">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="hd">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="hb-h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="rows">
      {%- assign n = 0 -%}
      {%- for b in section.blocks -%}
        {%- if b.settings.image != blank -%}
          {%- assign n = n | plus: 1 -%}
          {%- assign odd = n | modulo: 2 -%}
          <div class="row{% if odd == 0 %} alt{% endif %}" {{ b.shopify_attributes }}>
            <figure class="fig">
              <img src="{{ b.settings.image | image_url: width: 1400 }}"
                   alt="{{ b.settings.title | escape }}" loading="lazy">
            </figure>
            <div class="txt">
              <p class="n">{{ n | prepend: '0' }}</p>
              {%- if b.settings.title != blank -%}<h3 class="t">{{ b.settings.title }}</h3>{%- endif -%}
              <p class="d">{{ b.settings.text }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "HELIOS showcase",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [{ "type": "row", "name": "Row", "limit": 8, "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "text", "id": "text", "label": "One line", "info": "Keep it to a single sentence — the picture is doing the work." }
  ]}],
  "presets": [{ "name": "HELIOS showcase", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
