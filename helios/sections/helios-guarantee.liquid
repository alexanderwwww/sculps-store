{%- comment -%}HELIOS Guarantee — Amazon-style band.{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
<section class="helios" id="hg-{{ sid }}">
<style>
  #hg-{{ sid }}{background:#fff;color:#0F1111;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
  #hg-{{ sid }} *{box-sizing:border-box;}
  #hg-{{ sid }} .wrap{max-width:1000px;margin:0 auto;padding:clamp(var(--sp-4,21px),4vw,var(--sp-6,55px)) var(--sp-4,21px);}
  #hg-{{ sid }} .band{background:#F7FAFA;border:1px solid #D5D9D9;border-radius:8px;padding:clamp(var(--sp-4,21px),4vw,var(--sp-5,34px)) var(--sp-5,34px);text-align:center;}
  #hg-{{ sid }} h2{font-size:clamp(var(--fs-md,20.4px),2.4vw,var(--fs-lg,25.9px));font-weight:700;letter-spacing:-.01em;line-height:1.3;margin:0;}
  #hg-{{ sid }} .tx{font-size:14px;line-height:1.6;color:#0F1111;margin:12px auto 0;max-width:620px;}
  #hg-{{ sid }} .tx p{margin:0 0 9px;}
  #hg-{{ sid }} .tx p:last-child{margin-bottom:0;}
  #hg-{{ sid }} a.btn{display:inline-block;margin-top:20px;background:#FFD814;color:#0F1111;border:1px solid #FCD200;
    border-radius:8px;padding:11px 34px;font-size:14px;font-weight:600;text-decoration:none;}
  #hg-{{ sid }} a.btn:hover{background:#F7CA00;}
</style>
<div class="wrap">
  <div class="band">
    <h2>{{ s.heading }}</h2>
    <div class="tx">{{ s.text }}</div>
    {%- if s.cta_text != blank -%}<a class="btn" href="{{ s.cta_link | default: '#' }}">{{ s.cta_text }}</a>{%- endif -%}
  </div>
</div>
</section>
{% schema %}
{
  "name": "HELIOS Guarantee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "30-day money-back guarantee" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Take it out for 30 days. If the Super Glide doesn't make summer better, send it back for a full refund.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Get yours" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "HELIOS Guarantee" }]
}
{% endschema %}
