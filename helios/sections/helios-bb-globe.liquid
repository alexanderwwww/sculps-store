    /* Ease back to the locked view and breathe there; never free-spin. */
    var wantSpin=LOCK + (reduce?0:Math.sin(pulse*0.7)*0.035);
    var wantTilt=LOCK_TILT + (reduce?0:Math.cos(pulse*0.5)*0.015);
    spin += (wantSpin-spin)*Math.min(dt*2.4,1);
    tilt += (wantTilt-tilt)*Math.min(dt*2.4,1);
    if(target&&target.p<target.pt){
      /* Ease-in-out: the parcel pulls away, cruises, then settles onto its
         stage rather than stopping dead. */
      var gap=target.pt-target.p;
      var speed=0.18+Math.sin(Math.min(target.p/Math.max(target.pt,0.001),1)*Math.PI)*0.55;
      target.p=Math.min(target.pt, target.p+Math.max(gap*dt*1.8, dt*speed*0.5));
      if(target.p>=target.pt) target.land=1;   /* triggers the landing pop */
    }
    if(target&&target.land>0) target.land=Math.max(0,target.land-dt*1.6);
    draw(); anim=requestAnimationFrame(loop);
  }
  size(); draw();
  if(window.ResizeObserver) new ResizeObserver(function(){size();draw();}).observe(cv);
  else window.addEventListener('resize',function(){size();draw();});
  anim=requestAnimationFrame(loop);

  /* ---------- lookup ---------- */
  var form=root.querySelector('[data-form]'), input=root.querySelector('[data-in]'),
      err=root.querySelector('[data-err]'), panel=root.querySelector('[data-panel]');

  function norm(v){ return String(v||'').toUpperCase().replace(/[^A-Z0-9]/g,''); }
  function esc(v){ return String(v==null?'':v).replace(/[&<>"]/g,function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

  function show(sh){
    root.querySelector('[data-code]').textContent=sh.code;
    var st=Math.max(1,Math.min(5,parseInt(sh.stage,10)||1));
    root.querySelector('[data-pill]').textContent=STAGES[st-1].k;
    root.querySelector('[data-route]').innerHTML='Route: <b>'+esc(sh.from)+'</b> &rarr; <b>'+esc(sh.to)+'</b>';
    root.querySelector('[data-eta]').innerHTML=sh.eta?('Estimated delivery: <b>'+esc(sh.eta)+'</b>'):'';
    root.querySelector('[data-carrier]').innerHTML=sh.carrier?('Carrier: <b>'+esc(sh.carrier)+'</b>'):'';

    var n=NARR[st-1]||NARR[0];
    root.querySelector('[data-mgtitle]').textContent=n.t;
    root.querySelector('[data-mgline]').textContent=n.l;
    /* Re-created rather than reclassed, so the glyph animation restarts. */
    root.querySelector('[data-mgico]').innerHTML='<i class="g'+st+'"></i>';

    /* Package sits at the middle of the current fifth of the journey. */
    var pkg=root.querySelector('[data-flpkg]');
    var pct=((st-0.5)/5*100).toFixed(2)+'%';
    requestAnimationFrame(function(){ pkg.style.left=pct; });

    /* Destination and, if the merchant filled it, who it is for. */
    var PIN='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/></svg>';
    var CAL='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>';
    var PER='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg>';
    var dest=root.querySelector('[data-fldest]'), drow='';
    drow+='<span>'+PIN+'Delivering to <b>'+esc(sh.to)+'</b></span>';
    if(sh.eta) drow+='<span>'+CAL+(st>=5?'Delivered ':'Arrives ')+'<b>'+esc(sh.eta)+'</b></span>';
    if(sh.customer) drow+='<span>'+PER+'For <b>'+esc(sh.customer)+'</b></span>';
    dest.innerHTML=drow;
    root.querySelector('[data-flto]').classList.toggle('here', st>=5);

    var say=root.querySelector('.fl-say');
    root.querySelector('[data-flsay]').textContent=n.t;
    root.querySelector('[data-flsub]').textContent=n.l;
    /* Restart the entrance so a new lookup reads as a change, not a swap. */
    say.style.animation='none'; void say.offsetWidth; say.style.animation='';

    var tl=root.querySelector('[data-tl]'), out='';
    for(var i=0;i<5;i++){
      var cls=i<st-1?'done':(i===st-1?'now':'');
      var when=sh['d'+(i+1)]||'';
      out+='<div class="st '+cls+'" style="animation-delay:'+(i*0.07).toFixed(2)+'s">'+
           '<span class="dot"></span><div><div class="sl">'+STAGES[i].k+'</div>'+
           '<div class="sd">'+esc(when||STAGES[i].s)+'</div></div></div>';
    }
    tl.innerHTML=out;
    panel.classList.add('on');
    root.querySelector('[data-under]').classList.add('on');
    err.textContent='';

    target={ a:[parseFloat(sh.flon)||0, parseFloat(sh.flat)||0],
             b:[parseFloat(sh.tlon)||0, parseFloat(sh.tlat)||0], p:0, pt:(st-1)/4 };
    if(target.pt===0) target.pt=0.04;
    /* No re-aiming: every route is domestic, so the locked US view already
       frames both ends. */
    panel.scrollIntoView({behavior:reduce?'auto':'smooth',block:'nearest'});
  }

  function lookup(v){
    var n=norm(v);
    if(!n){ err.textContent='Enter your tracking number.'; panel.classList.remove('on'); return; }
    for(var i=0;i<SHIPS.length;i++){ if(norm(SHIPS[i].code)===n){ show(SHIPS[i]); return; } }
    panel.classList.remove('on');
    root.querySelector('[data-under]').classList.remove('on');
    target=null;
    err.textContent={{ s.not_found | default: 'We could not find that number yet. Numbers go live once the parcel is scanned, which can take up to 48 hours after your confirmation email.' | json }};
  }
  form.addEventListener('submit',function(e){ e.preventDefault(); lookup(input.value); });

  try{
    var qp=new URLSearchParams(window.location.search).get('t');
    if(qp){ input.value=qp; lookup(qp); }
  }catch(e){}
})();
</script>

