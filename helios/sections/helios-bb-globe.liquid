{%- comment -%}
  HELIOS — live tracking with a 3D globe.

  Self-contained: a rotating dot-matrix Earth drawn on a canvas, no libraries and
  no external requests. Continents are coarse polygons sampled onto a lat/lon
  grid, projected to a sphere and depth-sorted, so it stays sharp at any size and
  costs one small script instead of a 600KB globe library.

  A visitor types a HELIOS number; if it matches a shipment block the globe
  animates the route and the timeline fills in. Deep link: ?t=HELIOS289471132

  PRIVACY NOTE: block data is rendered into the page, so anything you type into a
  block is readable in the page source by anyone who looks. Keep it to status,
  city and date — never a customer's full address, phone number or email.

  The canvas is decorative: everything a visitor needs is in the text timeline,
  and the animation is switched off under prefers-reduced-motion.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #hbg-{{ section.id }}{background:var(--hb-ink,#1D252C);color:#fff;padding-block:40px 52px;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;}
  #hbg-{{ section.id }} *,#hbg-{{ section.id }} *::before{box-sizing:border-box;}
  #hbg-{{ section.id }} .wrap{width:100%;max-width:calc(var(--hb-maxw,1440px) + 48px);
    margin-inline:auto;padding-inline:var(--hb-gut,16px);}
  #hbg-{{ section.id }} .lay{display:grid;gap:28px;align-items:start;}
  #hbg-{{ section.id }} .eyebrow{font-size:11px;font-weight:800;letter-spacing:.16em;
    text-transform:uppercase;color:var(--hb-yellow,#FFE000);margin:0 0 10px;}
  #hbg-{{ section.id }} h1{font-size:clamp(24px,4vw,38px);font-weight:800;letter-spacing:-.025em;
    line-height:1.1;margin:0;}
  #hbg-{{ section.id }} .sub{margin-top:10px;font-size:14.5px;line-height:1.55;color:#AEB6BE;max-width:52ch;}

  #hbg-{{ section.id }} .form{display:flex;gap:9px;margin-top:22px;flex-wrap:wrap;}
  #hbg-{{ section.id }} input{flex:1 1 240px;min-width:0;background:#12171C;border:1px solid #38424B;
    color:#fff;border-radius:6px;padding:14px 15px;font:inherit;font-size:15.5px;letter-spacing:.04em;}
  #hbg-{{ section.id }} input:focus{outline:2px solid var(--hb-blue,#0046BE);outline-offset:1px;border-color:transparent;}
  #hbg-{{ section.id }} input::placeholder{color:#6E7982;letter-spacing:.02em;}
  #hbg-{{ section.id }} button.go{flex:0 0 auto;background:var(--hb-blue,#0046BE);color:#fff;border:0;
    border-radius:6px;padding:14px 26px;font:inherit;font-size:15.5px;font-weight:700;cursor:pointer;}
  #hbg-{{ section.id }} button.go:hover{background:#0052DE;}
  #hbg-{{ section.id }} .err{margin-top:12px;font-size:13.5px;color:#FF9E96;min-height:1em;}
  #hbg-{{ section.id }} .err:empty{display:none;}

  #hbg-{{ section.id }} .stage{position:relative;aspect-ratio:1/1;max-width:560px;margin-inline:auto;width:100%;}
  #hbg-{{ section.id }} canvas{width:100%;height:100%;display:block;}
  #hbg-{{ section.id }} .ring{display:none;}

  #hbg-{{ section.id }} .panel{margin-top:26px;background:#12171C;border:1px solid #2A333B;
    border-radius:12px;padding:20px;display:none;}
  #hbg-{{ section.id }} .panel.on{display:block;}
  #hbg-{{ section.id }} .pt{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;
    align-items:baseline;border-bottom:1px solid #2A333B;padding-bottom:14px;}
  #hbg-{{ section.id }} .code{font-size:17px;font-weight:800;letter-spacing:.05em;}
  #hbg-{{ section.id }} .pill{font-size:11.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;
    background:rgba(6,125,98,.22);color:#5BE0B8;border-radius:999px;padding:5px 12px;}
  #hbg-{{ section.id }} .meta{margin-top:12px;display:grid;gap:4px;font-size:13.5px;color:#AEB6BE;}
  #hbg-{{ section.id }} .meta b{color:#fff;font-weight:700;}

  /* Everything under the globe stays out of the way until a number is found. */
  #hbg-{{ section.id }} .under{display:none;}
  #hbg-{{ section.id }} .under.on{display:block;animation:hbgu-{{ section.id }} .45s both;}
  @keyframes hbgu-{{ section.id }}{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}
  @media(prefers-reduced-motion:reduce){#hbg-{{ section.id }} .under.on{animation:none;}}

  /* Motion-graphic status card. One animated glyph per stage, so the current
     step is legible before a word is read. */
  #hbg-{{ section.id }} .mg{display:flex;align-items:center;gap:var(--sp-3,13px);
    margin-top:var(--sp-4,21px);padding:var(--sp-3,13px) var(--sp-4,21px);
    background:linear-gradient(180deg,#161C22,#12171C);border:1px solid #2A333B;
    border-radius:var(--r-md,13px);}
  #hbg-{{ section.id }} .mg-ico{flex:none;width:46px;height:46px;border-radius:12px;
    background:#0E1319;border:1px solid #2A333B;position:relative;overflow:hidden;
    display:flex;align-items:center;justify-content:center;}
  #hbg-{{ section.id }} .mg-tx{display:flex;flex-direction:column;gap:2px;min-width:0;}
  #hbg-{{ section.id }} .mg-tx b{font-size:var(--fs-sm,14.1px);font-weight:800;letter-spacing:-.01em;}
  #hbg-{{ section.id }} .mg-tx span{font-size:12.5px;color:#8C959D;line-height:1.45;}

  /* glyph 1 — order lands in the queue */
  #hbg-{{ section.id }} .g1{width:20px;height:20px;border-radius:5px;
    border:2px solid var(--hb-blue,#0046BE);animation:g1a 1.8s ease-in-out infinite;}
  @keyframes g1a{0%,100%{transform:scale(.85);opacity:.6}50%{transform:scale(1);opacity:1}}
  /* glyph 2 — lid closing on the box */
  #hbg-{{ section.id }} .g2{width:22px;height:15px;background:#B98C4A;border-radius:2px;position:relative;}
  #hbg-{{ section.id }} .g2::before{content:'';position:absolute;left:-1px;right:-1px;top:-7px;height:7px;
    background:#E8B96B;border-radius:2px;transform-origin:bottom center;animation:g2a 1.9s ease-in-out infinite;}
  @keyframes g2a{0%,100%{transform:rotateX(70deg)}45%,65%{transform:rotateX(0)}}
  /* glyph 3 — quality check sweep */
  #hbg-{{ section.id }} .g3{width:22px;height:22px;border-radius:50%;
    border:2px solid #2A333B;border-top-color:#5BE0B8;animation:g3a 1.1s linear infinite;}
  @keyframes g3a{to{transform:rotate(360deg)}}
  /* glyph 4 — van pulling away */
  #hbg-{{ section.id }} .g4{width:24px;height:14px;background:var(--hb-yellow,#FFE000);
    border-radius:3px 5px 3px 3px;position:relative;animation:g4a 1.6s ease-in-out infinite;}
  #hbg-{{ section.id }} .g4::after{content:'';position:absolute;left:3px;right:3px;bottom:-4px;height:4px;
    border-radius:50%;background:rgba(255,224,0,.3);}
  @keyframes g4a{0%,100%{transform:translateX(-4px)}50%{transform:translateX(4px)}}
  /* glyph 5 — delivered tick */
  #hbg-{{ section.id }} .g5{width:22px;height:22px;border-radius:50%;background:#067D62;
    display:flex;align-items:center;justify-content:center;animation:g5a .5s ease-out;}
  #hbg-{{ section.id }} .g5::after{content:'';width:9px;height:5px;border-left:2.4px solid #fff;
    border-bottom:2.4px solid #fff;transform:rotate(-45deg) translate(1px,-1px);}
  @keyframes g5a{from{transform:scale(.4);opacity:0}to{transform:scale(1);opacity:1}}
  @media(prefers-reduced-motion:reduce){
    #hbg-{{ section.id }} .g1,#hbg-{{ section.id }} .g2::before,#hbg-{{ section.id }} .g3,
    #hbg-{{ section.id }} .g4,#hbg-{{ section.id }} .g5{animation:none;}
    #hbg-{{ section.id }} .g2::before{transform:rotateX(0);}
  }

  /* Stage flow under the globe. Not the timeline again — the list below is
     the record. This is one human sentence about where the order is, with a
     package moving along a flowing arrow behind it. */
  #hbg-{{ section.id }} .flow{margin-top:var(--sp-4,21px);
    background:linear-gradient(180deg,#161C22,#11161B);border:1px solid #2A333B;
    border-radius:var(--r-md,13px);padding:var(--sp-4,21px);}
  #hbg-{{ section.id }} .fl-lane{position:relative;height:44px;margin-bottom:var(--sp-3,13px);
    padding:0 26px;}
  /* The lane physically runs from us to the customer: a dot at New York, the
     home marker at their end, package travelling between. */
  #hbg-{{ section.id }} .fl-from,#hbg-{{ section.id }} .fl-to{position:absolute;top:50%;
    transform:translateY(-50%);z-index:2;}
  #hbg-{{ section.id }} .fl-from{left:0;width:11px;height:11px;border-radius:50%;
    background:#7EC4FF;box-shadow:0 0 0 3px rgba(126,196,255,.18);}
  #hbg-{{ section.id }} .fl-to{right:0;width:22px;height:22px;color:#5D666E;
    transition:color .5s;}
  #hbg-{{ section.id }} .fl-to svg{width:100%;height:100%;display:block;}
  #hbg-{{ section.id }} .fl-to.here{color:#5BE0B8;
    filter:drop-shadow(0 0 8px rgba(91,224,184,.7));}
  /* The lane itself: chevrons drifting left to right, masked to a soft fade at
     both ends so the motion has no visible start or stop. */
  #hbg-{{ section.id }} .fl-arrow{position:absolute;left:22px;right:26px;top:50%;height:6px;
    margin-top:-3px;border-radius:100px;
    background-image:repeating-linear-gradient(90deg,
      rgba(255,224,0,.55) 0 2px, rgba(255,224,0,0) 2px 9px,
      rgba(255,224,0,.28) 9px 11px, rgba(255,224,0,0) 11px 18px);
    background-size:18px 100%;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
    mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
    animation:hbgfl-{{ section.id }} 1.1s linear infinite;opacity:.9;}
  @keyframes hbgfl-{{ section.id }}{to{background-position:18px 0;}}
  #hbg-{{ section.id }} .fl-pkg{position:absolute;top:50%;left:0;width:42px;height:39px;
    margin:-21px 0 0 -21px;z-index:3;transition:left 1.2s cubic-bezier(.33,1,.68,1);
    filter:drop-shadow(0 4px 6px rgba(0,0,0,.55));
    animation:hbgbob-{{ section.id }} 1.6s ease-in-out infinite;}
  #hbg-{{ section.id }} .fl-pkg svg{width:100%;height:100%;display:block;}
  @keyframes hbgbob-{{ section.id }}{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}

  #hbg-{{ section.id }} .fl-say b{display:block;font-size:var(--fs-base,16px);font-weight:800;
    letter-spacing:-.015em;line-height:1.25;}
  #hbg-{{ section.id }} .fl-say span{display:block;font-size:13px;color:#8C959D;
    line-height:1.5;margin-top:3px;}
  #hbg-{{ section.id }} .fl-say{animation:hbgsay-{{ section.id }} .5s both;}
  /* Where it is going and who it is for, on every stage. */
  #hbg-{{ section.id }} .fl-dest{display:flex;flex-wrap:wrap;gap:6px 16px;
    margin-top:var(--sp-3,13px);padding-top:var(--sp-3,13px);border-top:1px solid #222B33;
    font-size:12.5px;color:#8C959D;}
  #hbg-{{ section.id }} .fl-dest span{display:inline-flex;align-items:center;gap:6px;}
  #hbg-{{ section.id }} .fl-dest b{color:#fff;font-weight:700;}
  #hbg-{{ section.id }} .fl-dest svg{width:13px;height:13px;flex:none;color:#5D666E;}
  @keyframes hbgsay-{{ section.id }}{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  @media(prefers-reduced-motion:reduce){
    #hbg-{{ section.id }} .fl-arrow,#hbg-{{ section.id }} .fl-pkg,
    #hbg-{{ section.id }} .fl-say{animation:none;}
    #hbg-{{ section.id }} .fl-pkg{transition:none;}
  }

  #hbg-{{ section.id }} .tl{margin-top:20px;display:grid;gap:0;}
  /* Rows flow in one after another, so the history reads as it fills. */
  #hbg-{{ section.id }} .tl .st{animation:hbgin-{{ section.id }} .45s both;}
  @keyframes hbgin-{{ section.id }}{from{opacity:0;transform:translateY(7px);}to{opacity:1;transform:none;}}
  @media(prefers-reduced-motion:reduce){
    #hbg-{{ section.id }} .tl .st{animation:none;}
    #hbg-{{ section.id }} .rail .rn.now .ri{animation:none;}
    #hbg-{{ section.id }} .rail .rb span{transition:none;}
  }
  #hbg-{{ section.id }} .st{display:grid;grid-template-columns:26px minmax(0,1fr);gap:14px;
    padding-bottom:20px;position:relative;}
  #hbg-{{ section.id }} .st:last-child{padding-bottom:0;}
  #hbg-{{ section.id }} .st::before{content:'';position:absolute;left:12px;top:20px;bottom:-2px;width:2px;
    background:#2A333B;}
  #hbg-{{ section.id }} .st:last-child::before{display:none;}
  #hbg-{{ section.id }} .st.done::before{background:var(--hb-blue,#0046BE);}
  #hbg-{{ section.id }} .dot{width:26px;height:26px;border-radius:50%;border:2px solid #38424B;
    display:grid;place-items:center;background:#12171C;position:relative;z-index:1;}
  #hbg-{{ section.id }} .st.done .dot{border-color:var(--hb-blue,#0046BE);background:var(--hb-blue,#0046BE);}
  #hbg-{{ section.id }} .st.done .dot::after{content:'';width:9px;height:5px;border-left:2px solid #fff;
    border-bottom:2px solid #fff;transform:rotate(-45deg) translate(1px,-1px);}
  #hbg-{{ section.id }} .st.now .dot{border-color:var(--hb-yellow,#FFE000);
    box-shadow:0 0 0 0 rgba(255,224,0,.55);animation:hbgp-{{ section.id }} 1.8s infinite;}
  @keyframes hbgp-{{ section.id }}{70%{box-shadow:0 0 0 12px rgba(255,224,0,0);}100%{box-shadow:0 0 0 0 rgba(255,224,0,0);}}
  #hbg-{{ section.id }} .sl{font-size:15px;font-weight:700;line-height:1.3;}
  #hbg-{{ section.id }} .sd{font-size:13px;color:#8C959D;margin-top:3px;}
  #hbg-{{ section.id }} .foot{margin-top:18px;font-size:12.5px;color:#8C959D;line-height:1.55;}

  @media(min-width:900px){
    #hbg-{{ section.id }} .lay{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;}
    #hbg-{{ section.id }} .stage{max-width:none;}
  }
  @media(prefers-reduced-motion:reduce){
    #hbg-{{ section.id }} .st.now .dot{animation:none;}
  }
</style>

<section id="hbg-{{ section.id }}">
  <div class="wrap">
    <div class="lay">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h1>{{ s.heading | default: 'Track your order' }}</h1>
        {%- if s.sub != blank -%}<p class="sub">{{ s.sub }}</p>{%- endif -%}

        <form class="form" data-form>
          <label for="hbg-in-{{ section.id }}" style="position:absolute;left:-9999px">Tracking number</label>
          <input id="hbg-in-{{ section.id }}" type="text" data-in autocomplete="off" spellcheck="false"
                 placeholder="{{ s.placeholder | default: 'HELIOS289471132' | escape }}">
          <button type="submit" class="go">{{ s.cta | default: 'Track' }}</button>
        </form>
        <p class="err" data-err role="status" aria-live="polite"></p>

        <div class="panel" data-panel>
          <div class="pt">
            <span class="code" data-code></span>
            <span class="pill" data-pill></span>
          </div>
          <div class="meta">
            <span data-route></span>
            <span data-eta></span>
            <span data-carrier></span>
          </div>
          <div class="tl" data-tl></div>
        </div>

        {%- if s.foot != blank -%}<p class="foot">{{ s.foot }}</p>{%- endif -%}
      </div>

      <div>
        <div class="stage">
          <canvas data-globe aria-hidden="true"></canvas>
          <span class="ring"></span>
        </div>

        <div class="under" data-under>
          <div class="mg" data-mg>
            <span class="mg-ico" data-mgico></span>
            <span class="mg-tx"><b data-mgtitle></b><span data-mgline></span></span>
          </div>
          <div class="flow" data-flow>
            <div class="fl-lane">
              <span class="fl-from" title="New York"></span>
              <span class="fl-arrow" data-flarrow></span>
              <span class="fl-pkg" data-flpkg>
                <svg viewBox="0 0 24 22" aria-hidden="true">
                  <path d="M12 1 23 6.5 12 12 1 6.5z" fill="#E8B96B"/>
                  <path d="M1 6.5 12 12v9L1 15.5z" fill="#B98C4A"/>
                  <path d="M23 6.5 12 12v9l11-5.5z" fill="#CFA35C"/>
                  <path d="M12 12v9" stroke="rgba(255,255,255,.55)" stroke-width="1"/>
                </svg>
              </span>
              <span class="fl-to" data-flto>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 3l9 8v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="fl-say"><b data-flsay></b><span data-flsub></span></div>
            <div class="fl-dest" data-fldest></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-ship-{{ section.id }}>
[
{%- assign n = 0 -%}
{%- for b in section.blocks -%}
  {%- if b.settings.code != blank -%}
  {%- if n > 0 -%},{%- endif -%}
  {%- assign n = n | plus: 1 -%}
  {
    "code": {{ b.settings.code | strip | upcase | json }},
    "stage": {{ b.settings.stage | default: 3 }},
    "from": {{ b.settings.from | default: 'New York, NY' | json }},
    "flon": {{ b.settings.from_lon | default: -74.006 }},
    "flat": {{ b.settings.from_lat | default: 40.713 }},
    "to": {{ b.settings.to | default: 'Los Angeles, US' | json }},
    "tlon": {{ b.settings.to_lon | default: -118.24 }},
    "tlat": {{ b.settings.to_lat | default: 34.05 }},
    "eta": {{ b.settings.eta | json }},
    "carrier": {{ b.settings.carrier | json }},
    "customer": {{ b.settings.customer | json }},
    "d1": {{ b.settings.d1 | json }}, "d2": {{ b.settings.d2 | json }},
    "d3": {{ b.settings.d3 | json }}, "d4": {{ b.settings.d4 | json }},
    "d5": {{ b.settings.d5 | json }}
  }
  {%- endif -%}
{%- endfor -%}
]
</script>

<script>
(function(){
  var ID='{{ section.id }}', root=document.getElementById('hbg-'+ID);
  if(!root||root.dataset.on==='1')return; root.dataset.on='1';

  var raw=document.querySelector('[data-ship-'+ID+']');
  var SHIPS=[]; try{ SHIPS=JSON.parse(raw.textContent)||[]; }catch(e){ SHIPS=[]; }
  /* A malformed block would break the parse above; a failed parse degrades to
     "not found" instead of taking the page down. */

  var STAGES=[
    {k:'Order placed',    s:'Payment confirmed'},
    {k:'Packed',          s:'Boxed and quality-checked'},
    {k:'In transit',      s:'Moving across the country'},
    {k:'Out for delivery',s:'On its way to your door'},
    {k:'Delivered',       s:'Handed over'}
  ];
  /* Headline + line shown on the motion card, one per stage. */
  var NARR=[
    {t:{{ s.n1_title | default: 'A human being has seen your order' | json }},
     l:{{ s.n1_line  | default: 'Someone on our team in New York picked it up. It is in the queue.' | json }}},
    {t:{{ s.n2_title | default: 'We are packing it by hand' | json }},
     l:{{ s.n2_line  | default: 'Boxed and quality-checked by a person, not a machine.' | json }}},
    {t:{{ s.n3_title | default: 'It has left New York' | json }},
     l:{{ s.n3_line  | default: 'On the road and moving toward you right now.' | json }}},
    {t:{{ s.n4_title | default: 'Out for delivery today' | json }},
     l:{{ s.n4_line  | default: 'We deliver personally. One of us is bringing it to your door.' | json }}},
    {t:{{ s.n5_title | default: 'Delivered' | json }},
     l:{{ s.n5_line  | default: 'Handed over. Go get it on the water.' | json }}}
  ];

  /* ---------- globe ---------- */
  var cv=root.querySelector('[data-globe]'), ctx=cv.getContext('2d');
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Natural Earth 110m coastlines rasterised to a 360x180 one-degree grid and
     run-length encoded — the same mask the XERO tracking globe uses. Row 0 is
     the north pole and the first run is ocean. Replaces hand-drawn polygons
