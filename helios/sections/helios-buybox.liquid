      { "type": "text", "id": "note", "label": "Note" },
      { "type": "text", "id": "tag", "label": "Floating pill text", "info": "Shown above the option. Keep the background light — the text is dark." },
      { "type": "color", "id": "tag_bg", "label": "Pill background", "default": "#39FF14" },
      { "type": "text", "id": "gift", "label": "Free gift label" },
      { "type": "text", "id": "gift_variant_id", "label": "Free gift variant ID" },
      { "type": "text", "id": "save", "label": "Save badge" },
      { "type": "text", "id": "price", "label": "Price" },
      { "type": "text", "id": "compare", "label": "Compare-at" }
    ]}
  ],
  "presets": [{ "name": "HELIOS Buy Box", "blocks": [{ "type": "bundle" }, { "type": "bundle" }, { "type": "bundle" }] }]
