{%- comment -%}
  HELIOS — photo album. sections/helios-gallery.liquid

  Rebuilt as a Facebook-style mosaic. The old version was a plain N-column grid
  of identical tiles with a dozen sizing knobs; every photo got the same box, so
  it read like a spec sheet rather than an album.

  Now the arrangement follows the photo count, the way a Facebook post does:
    1 → single wide          2 → side by side
    3 → one tall + two       4 → one tall + three
    5+ → one tall + four, and the last tile carries a +N overlay that opens
         the rest in the lightbox
  Photos beyond the visible tiles are still rendered as hidden lightbox slides,
  so nothing a merchant uploads is silently dropped.

  Click any tile for a full-screen lightbox with arrow, swipe and keyboard
  navigation. Classes are prefixed hgl- so Horizon's global stylesheet — which
  styles generic names like .grid and .wrap — cannot reach in and flatten it.

  Setting and block IDs from the old grid are kept so the template binds
  unchanged; the retired sizing knobs are simply no longer read.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign shown = 0
  for b in section.blocks
    if b.settings.image != blank
      assign shown = shown | plus: 1
    endif
  endfor
  assign cap = 5
  if shown < 5
    assign cap = shown
  endif
  assign extra = shown | minus: cap
-%}
{%- if shown > 0 or request.design_mode -%}
<section class="helios" id="hgl-{{ sid }}">
<style>
  #hgl-{{ sid }}{background:{{ s.page_bg | default: '#FFFFFF' }};color:#0F1111;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
    padding:clamp(var(--sp-5,34px),4vw,var(--sp-6,55px)) 0;}
  #hgl-{{ sid }} *{box-sizing:border-box;min-width:0;}
  #hgl-{{ sid }} .hgl-wrap{width:100%;max-width:{{ s.width | default: 1180 }}px;
    margin:0 auto;padding:0 var(--sp-4,21px);}
  #hgl-{{ sid }} .hgl-eb{font-size:var(--fs-xs,12.6px);font-weight:800;letter-spacing:.12em;
    text-transform:uppercase;color:#565959;margin-bottom:var(--sp-2,8px);}
  #hgl-{{ sid }} .hgl-h{font-size:clamp(var(--fs-lg,25.9px),3.2vw,var(--fs-xl,32.9px));
    font-weight:800;letter-spacing:-.025em;line-height:var(--lh-tight,1.236);
    margin:0 0 var(--sp-4,21px);}

  /* Mosaic. Two rows of six columns; each count gets its own spans, so the
     album is always flush with no ragged gap. */
  #hgl-{{ sid }} .hgl-m{display:grid;grid-template-columns:repeat(6,1fr);
    grid-auto-rows:1fr;gap:{{ s.gap | default: 6 }}px;}
  #hgl-{{ sid }} .hgl-t{position:relative;margin:0;overflow:hidden;padding:0;border:0;
    background:#EBEDF0;cursor:zoom-in;border-radius:{{ s.radius | default: 10 }}px;
    aspect-ratio:1/1;display:block;width:100%;}
  #hgl-{{ sid }} .hgl-t img{width:100%;height:100%;object-fit:cover;display:block;
    transition:transform .35s ease;}
  #hgl-{{ sid }} .hgl-t:hover img{transform:scale(1.04);}
  #hgl-{{ sid }} .hgl-more{position:absolute;inset:0;background:rgba(15,17,17,.55);
    color:#fff;font-size:clamp(22px,4vw,34px);font-weight:800;letter-spacing:-.02em;
    display:flex;align-items:center;justify-content:center;backdrop-filter:blur(1px);}

  #hgl-{{ sid }} .hgl-m[data-n="1"] .hgl-t{grid-column:span 6;aspect-ratio:16/9;}
  #hgl-{{ sid }} .hgl-m[data-n="2"] .hgl-t{grid-column:span 3;aspect-ratio:4/5;}
  #hgl-{{ sid }} .hgl-m[data-n="3"] .hgl-t{grid-column:span 3;aspect-ratio:1/1;}
  #hgl-{{ sid }} .hgl-m[data-n="3"] .hgl-t:first-child{grid-row:span 2;aspect-ratio:auto;}
  #hgl-{{ sid }} .hgl-m[data-n="4"] .hgl-t{grid-column:span 2;aspect-ratio:1/1;}
  #hgl-{{ sid }} .hgl-m[data-n="4"] .hgl-t:first-child{grid-column:span 6;aspect-ratio:16/9;}
  #hgl-{{ sid }} .hgl-m[data-n="5"] .hgl-t{grid-column:span 3;aspect-ratio:1/1;}
  #hgl-{{ sid }} .hgl-m[data-n="5"] .hgl-t:first-child,
  #hgl-{{ sid }} .hgl-m[data-n="5"] .hgl-t:nth-child(2){grid-column:span 3;aspect-ratio:4/3;}
  #hgl-{{ sid }} .hgl-m[data-n="5"] .hgl-t:nth-child(n+3){grid-column:span 2;}
  @media(max-width:699px){
    #hgl-{{ sid }} .hgl-m[data-n="3"] .hgl-t:first-child,
    #hgl-{{ sid }} .hgl-m[data-n="4"] .hgl-t:first-child,
    #hgl-{{ sid }} .hgl-m[data-n="5"] .hgl-t:first-child{grid-column:span 6;grid-row:auto;aspect-ratio:4/3;}
    #hgl-{{ sid }} .hgl-m[data-n="5"] .hgl-t:nth-child(2){grid-column:span 6;}
    #hgl-{{ sid }} .hgl-m[data-n="3"] .hgl-t,
    #hgl-{{ sid }} .hgl-m[data-n="4"] .hgl-t,
    #hgl-{{ sid }} .hgl-m[data-n="5"] .hgl-t{grid-column:span 3;aspect-ratio:1/1;}
  }

  /* Lightbox */
  #hgl-{{ sid }} .hgl-lb{position:fixed;inset:0;z-index:9999;display:none;
    background:rgba(8,10,12,.94);align-items:center;justify-content:center;}
  #hgl-{{ sid }} .hgl-lb.hgl-on{display:flex;}
  #hgl-{{ sid }} .hgl-lb img{max-width:92vw;max-height:86vh;object-fit:contain;
    border-radius:6px;display:block;}
  #hgl-{{ sid }} .hgl-x,#hgl-{{ sid }} .hgl-nav{position:absolute;border:0;cursor:pointer;
    background:rgba(255,255,255,.12);color:#fff;border-radius:50%;width:44px;height:44px;
    display:flex;align-items:center;justify-content:center;backdrop-filter:blur(6px);}
  #hgl-{{ sid }} .hgl-x:hover,#hgl-{{ sid }} .hgl-nav:hover{background:rgba(255,255,255,.24);}
  #hgl-{{ sid }} .hgl-x{top:18px;right:18px;font-size:22px;line-height:1;}
  #hgl-{{ sid }} .hgl-nav svg{width:20px;height:20px;}
  #hgl-{{ sid }} .hgl-prev{left:18px;} #hgl-{{ sid }} .hgl-next{right:18px;}
  #hgl-{{ sid }} .hgl-count{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);
    color:rgba(255,255,255,.85);font-size:13px;font-weight:700;letter-spacing:.04em;}
  @media(max-width:699px){
    #hgl-{{ sid }} .hgl-nav{width:38px;height:38px;}
    #hgl-{{ sid }} .hgl-prev{left:8px;} #hgl-{{ sid }} .hgl-next{right:8px;}
  }
</style>
  <div class="hgl-wrap">
    {%- if s.eyebrow != blank -%}<div class="hgl-eb">{{ s.eyebrow }}</div>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="hgl-h">{{ s.heading }}</h2>{%- endif -%}

    <div class="hgl-m" data-n="{{ cap }}" id="hgl-m-{{ sid }}">
      {%- assign i = 0 -%}
      {%- for b in section.blocks -%}
        {%- if b.settings.image != blank -%}
          {%- assign i = i | plus: 1 -%}
          {%- if i <= cap -%}
            <button type="button" class="hgl-t" data-i="{{ i }}"
                    aria-label="Open photo {{ i }}" {{ b.shopify_attributes }}>
              <img src="{{ b.settings.image | image_url: width: 1200 }}"
                   srcset="{{ b.settings.image | image_url: width: 600 }} 600w,
                           {{ b.settings.image | image_url: width: 1200 }} 1200w"
                   sizes="(min-width:700px) 590px, 100vw"
                   alt="{{ b.settings.alt | escape }}" loading="lazy">
              {%- if i == cap and extra > 0 -%}
                <span class="hgl-more">+{{ extra }}</span>
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="hgl-lb" id="hgl-lb-{{ sid }}" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button type="button" class="hgl-x" data-close aria-label="Close">&times;</button>
    <button type="button" class="hgl-nav hgl-prev" data-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <img id="hgl-lbimg-{{ sid }}" src="" alt="">
    <button type="button" class="hgl-nav hgl-next" data-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <span class="hgl-count" id="hgl-c-{{ sid }}"></span>
  </div>

  <script type="application/json" id="hgl-data-{{ sid }}">
  [{%- assign n = 0 -%}
   {%- for b in section.blocks -%}
     {%- if b.settings.image != blank -%}
       {%- if n > 0 -%},{%- endif -%}{%- assign n = n | plus: 1 -%}
       {"src":{{ b.settings.image | image_url: width: 1800 | json }},"alt":{{ b.settings.alt | json }}}
     {%- endif -%}
   {%- endfor -%}]
  </script>
</section>

<script>
(function(){
  var SID='{{ sid }}', root=document.getElementById('hgl-'+SID);
  if(!root||root.dataset.on==='1')return; root.dataset.on='1';

  var PHOTOS=[];
  try{ PHOTOS=JSON.parse(document.getElementById('hgl-data-'+SID).textContent)||[]; }catch(e){ return; }
  if(!PHOTOS.length)return;

  var lb=document.getElementById('hgl-lb-'+SID),
      img=document.getElementById('hgl-lbimg-'+SID),
      cnt=document.getElementById('hgl-c-'+SID),
      at=0;

  function show(i){
    at=(i+PHOTOS.length)%PHOTOS.length;
    img.src=PHOTOS[at].src; img.alt=PHOTOS[at].alt||'';
    cnt.textContent=(at+1)+' / '+PHOTOS.length;
  }
  function open(i){ show(i); lb.classList.add('hgl-on'); document.body.style.overflow='hidden'; }
  function close(){ lb.classList.remove('hgl-on'); document.body.style.overflow=''; }

  root.querySelectorAll('.hgl-t').forEach(function(t){
    t.addEventListener('click',function(){ open(parseInt(t.getAttribute('data-i'),10)-1); });
  });
  lb.querySelector('[data-close]').addEventListener('click',close);
  lb.querySelector('[data-prev]').addEventListener('click',function(e){e.stopPropagation();show(at-1);});
  lb.querySelector('[data-next]').addEventListener('click',function(e){e.stopPropagation();show(at+1);});
  /* Click the backdrop, not the photo itself, to dismiss. */
  lb.addEventListener('click',function(e){ if(e.target===lb)close(); });
  document.addEventListener('keydown',function(e){
    if(!lb.classList.contains('hgl-on'))return;
    if(e.key==='Escape')close();
    else if(e.key==='ArrowLeft')show(at-1);
    else if(e.key==='ArrowRight')show(at+1);
  });
  var x0=null;
  lb.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;},{passive:true});
  lb.addEventListener('touchend',function(e){
    if(x0===null)return;
    var dx=e.changedTouches[0].clientX-x0; x0=null;
    if(Math.abs(dx)>45)show(dx<0?at+1:at-1);
  },{passive:true});
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "HELIOS gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "paragraph", "content": "The layout follows how many photos you add, like a Facebook album: 1 wide, 2 side by side, 3 or 4 mosaic, 5+ shows five with a +N badge that opens the rest in the viewer." },
    { "type": "range", "id": "width", "label": "Max width", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1180 },
    { "type": "range", "id": "gap", "label": "Gap between photos", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 6 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 10 },
    { "type": "color", "id": "page_bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [{ "type": "image", "name": "Photo", "limit": 30, "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "alt", "label": "Alt text" }
  ]}],
  "presets": [{ "name": "HELIOS gallery", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
