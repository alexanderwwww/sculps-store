{%- comment -%}
  HELIOS — image gallery grid.

  Rebuilt to match the saved template settings exactly (the original body was
  uploaded as a file, so only its settings survived in templates/index.json).
  Setting and block IDs are identical, so the recovered homepage renders as-is.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign filled = 0
  for b in section.blocks
    if b.settings.image != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- if filled > 0 or request.design_mode -%}
<div class="hg" id="hg-{{ section.id }}"
     style="--hg-w:{{ s.width | default: 1300 }}px;
            --hg-cols:{{ s.cols | default: 2 }};
            --hg-cols-m:{{ s.cols_m | default: 1 }};
            --hg-ratio:{{ s.ratio | default: '1/1' }};
            --hg-ratio-m:{{ s.ratio_m | default: '1/1' }};
            --hg-pad:{{ s.pad | default: 0 }}px;
            --hg-pad-m:{{ s.pad_m | default: 0 }}px;
            --hg-gap:{{ s.gap | default: 14 }}px;
            --hg-radius:{{ s.radius | default: 8 }}px;
            --hg-page-bg:{{ s.page_bg | default: '#ffffff' }};
            --hg-tile-bg:{{ s.tile_bg | default: '#ffffff' }};
            --hg-border:{{ s.border | default: '#d5d9d9' }}">
  <div class="hg__wrap">
    {%- if s.heading != blank -%}<h2 class="hg__h">{{ s.heading }}</h2>{%- endif -%}
    <div class="hg__grid">
      {%- for b in section.blocks -%}
        {%- if b.settings.image != blank -%}
          <figure class="hg__tile" {{ b.shopify_attributes }}>
            <img src="{{ b.settings.image | image_url: width: 1400 }}"
                 srcset="{{ b.settings.image | image_url: width: 700 }} 700w,
                         {{ b.settings.image | image_url: width: 1400 }} 1400w"
                 sizes="(min-width: 750px) {{ 1300 | divided_by: s.cols | default: 650 }}px, 100vw"
                 alt="{{ b.settings.alt | escape }}" loading="lazy">
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .hg { background: var(--hg-page-bg, #fff); padding-block: var(--sp-4, 21px); }
  .hg__wrap { width: 100%; max-width: var(--hg-w, 1300px); margin-inline: auto; padding-inline: 16px; }
  .hg__h { font-size: clamp(1.4rem, 5vw, 2rem); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 14px; }
  /* Flex on a percentage basis rather than fr tracks: an ancestor was sizing
     these grids to their content instead of stretching them. calc keeps the
     tiles exactly N-up while the gap stays honest. */
  .hg__grid { display: flex; flex-wrap: wrap; gap: var(--hg-gap, 14px); width: 100%; }
  .hg__grid > * { flex: 0 0 calc((100% - (var(--hg-cols-m, 1) - 1) * var(--hg-gap, 14px)) / var(--hg-cols-m, 1));
    min-width: 0; }
  .hg__tile { margin: 0; background: var(--hg-tile-bg, #fff); border: 1px solid var(--hg-border, #d5d9d9);
    border-radius: var(--hg-radius, 8px); overflow: hidden; padding: var(--hg-pad-m, 0); }
  .hg__tile img { display: block; width: 100%; aspect-ratio: var(--hg-ratio-m, 1/1); object-fit: cover; }
  @media screen and (min-width: 750px) {
    .hg { padding-block: var(--sp-5, 34px); }
    .hg__grid > * { flex: 0 0 calc((100% - (var(--hg-cols, 2) - 1) * var(--hg-gap, 14px)) / var(--hg-cols, 2)); }
    .hg__tile { padding: var(--hg-pad, 0); }
    .hg__tile img { aspect-ratio: var(--hg-ratio, 1/1); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "HELIOS gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "width", "label": "Max width", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1300 },
    { "type": "range", "id": "cols", "label": "Columns (desktop)", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "text", "id": "cols_m", "label": "Columns (mobile)", "default": "1" },
    { "type": "text", "id": "ratio", "label": "Image ratio (desktop)", "info": "CSS aspect-ratio, e.g. 1/1 or 4/5.", "default": "1/1" },
    { "type": "text", "id": "ratio_m", "label": "Image ratio (mobile)", "default": "1/1" },
    { "type": "range", "id": "pad", "label": "Tile padding (desktop)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_m", "label": "Tile padding (mobile)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 8 },
    { "type": "color", "id": "page_bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "tile_bg", "label": "Tile background", "default": "#ffffff" },
    { "type": "color", "id": "border", "label": "Border", "default": "#d5d9d9" }
  ],
  "blocks": [{ "type": "image", "name": "Image", "limit": 12, "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "alt", "label": "Alt text" }
  ]}],
  "presets": [{ "name": "HELIOS gallery", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
