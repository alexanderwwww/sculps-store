{%- comment -%}
  HELIOS — US delivery tracking.

  We ship inside the United States only, so the map is the United States: real
  state boundaries, not a world globe with a route crossing an ocean we never
  cross. Outlines come from US Census state geometry, projected at build time
  with an Albers conic (standard parallels 29.5/45.5) and Alaska and Hawaii
  placed as insets, then simplified to about half a pixel. That means no
  projection maths and no map library at run time — just inline SVG paths that
  stay sharp at any size.

  A visitor types a HELIOS number; the destination state lights up, the route
  draws to the current stage, and the timeline fills in.
  Deep link: ?t=HELIOS289471132

  PRIVACY NOTE: block data is rendered into the page, so anything you type into
  a block is readable in the page source by anyone who looks. Keep it to status,
  city, state and date — never a customer's full address, phone or email.

  The map is decorative: everything a visitor needs is in the text timeline,
  and motion is switched off under prefers-reduced-motion.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #hbm-{{ section.id }}{background:var(--hb-ink,#1D252C);color:#fff;padding-block:40px 52px;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;}
  #hbm-{{ section.id }} *,#hbm-{{ section.id }} *::before{box-sizing:border-box;}
  #hbm-{{ section.id }} .wrap{width:100%;max-width:calc(var(--hb-maxw,1440px) + 48px);
    margin-inline:auto;padding-inline:var(--hb-gut,16px);}
  #hbm-{{ section.id }} .lay{display:flex;flex-wrap:wrap;gap:0;align-items:flex-start;}
  #hbm-{{ section.id }} .col{flex:1 1 100%;max-width:100%;min-width:0;}
  #hbm-{{ section.id }} .eyebrow{font-size:11px;font-weight:800;letter-spacing:.16em;
    text-transform:uppercase;color:var(--hb-yellow,#FFE000);margin:0 0 10px;}
  #hbm-{{ section.id }} h1{font-size:clamp(24px,4vw,38px);font-weight:800;letter-spacing:-.025em;
    line-height:1.1;margin:0;}
  #hbm-{{ section.id }} .sub{margin-top:10px;font-size:14.5px;line-height:1.55;color:#AEB6BE;max-width:52ch;}

  #hbm-{{ section.id }} .form{display:flex;gap:9px;margin-top:22px;flex-wrap:wrap;}
  #hbm-{{ section.id }} input{flex:1 1 240px;min-width:0;background:#12171C;border:1px solid #38424B;
    color:#fff;border-radius:6px;padding:14px 15px;font:inherit;font-size:15.5px;letter-spacing:.04em;}
  #hbm-{{ section.id }} input:focus{outline:2px solid var(--hb-blue,#0046BE);outline-offset:1px;
    border-color:transparent;}
  #hbm-{{ section.id }} input::placeholder{color:#6E7982;letter-spacing:.02em;}
  #hbm-{{ section.id }} button.go{flex:0 0 auto;background:var(--hb-blue,#0046BE);color:#fff;border:0;
    border-radius:6px;padding:14px 26px;font:inherit;font-size:15.5px;font-weight:700;cursor:pointer;}
  #hbm-{{ section.id }} button.go:hover{background:#0052DE;}
  #hbm-{{ section.id }} .err{margin-top:12px;font-size:13.5px;color:#FF9E96;}
  #hbm-{{ section.id }} .err:empty{display:none;}

  #hbm-{{ section.id }} .stage{background:#0E1319;border:1px solid #2A333B;border-radius:14px;
    padding:12px;}
  #hbm-{{ section.id }} svg.map{display:block;width:100%;height:auto;}
  #hbm-{{ section.id }} .st-fill{fill:#1B2530;stroke:#2E3A47;stroke-width:.7;
    stroke-linejoin:round;vector-effect:non-scaling-stroke;transition:fill .3s;}
  #hbm-{{ section.id }} .st-fill.hit{fill:var(--hb-blue,#0046BE);stroke:#7EC4FF;}
  #hbm-{{ section.id }} .route{fill:none;stroke:var(--hb-yellow,#FFE000);stroke-width:2.4;
    stroke-linecap:round;vector-effect:non-scaling-stroke;}
  #hbm-{{ section.id }} .pin-o{fill:#7EC4FF;} #hbm-{{ section.id }} .pin-d{fill:#5BE0B8;}
  #hbm-{{ section.id }} .pin-r{fill:none;stroke-width:1.4;vector-effect:non-scaling-stroke;opacity:.4;}
  #hbm-{{ section.id }} .head{fill:var(--hb-yellow,#FFE000);}
  #hbm-{{ section.id }} .head-r{fill:var(--hb-yellow,#FFE000);opacity:.35;
    animation:hbmP-{{ section.id }} 1.9s ease-out infinite;transform-origin:center;transform-box:fill-box;}
  @keyframes hbmP-{{ section.id }}{0%{transform:scale(.7);opacity:.5}70%{transform:scale(2.6);opacity:0}100%{opacity:0}}

  #hbm-{{ section.id }} .panel{margin-top:26px;background:#12171C;border:1px solid #2A333B;
    border-radius:12px;padding:20px;display:none;}
  #hbm-{{ section.id }} .panel.on{display:block;}
  #hbm-{{ section.id }} .pt{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;
    align-items:baseline;border-bottom:1px solid #2A333B;padding-bottom:14px;}
  #hbm-{{ section.id }} .code{font-size:17px;font-weight:800;letter-spacing:.05em;}
  #hbm-{{ section.id }} .pill{font-size:11.5px;font-weight:800;letter-spacing:.08em;
    text-transform:uppercase;background:rgba(6,125,98,.22);color:#5BE0B8;border-radius:999px;padding:5px 12px;}
  #hbm-{{ section.id }} .meta{margin-top:12px;display:grid;gap:4px;font-size:13.5px;color:#AEB6BE;}
  #hbm-{{ section.id }} .meta b{color:#fff;font-weight:700;}
  #hbm-{{ section.id }} .meta span:empty{display:none;}

  #hbm-{{ section.id }} .tl{margin-top:20px;display:grid;}
  #hbm-{{ section.id }} .stp{display:grid;grid-template-columns:26px minmax(0,1fr);gap:14px;
    padding-bottom:20px;position:relative;}
  #hbm-{{ section.id }} .stp:last-child{padding-bottom:0;}
  #hbm-{{ section.id }} .stp::before{content:'';position:absolute;left:12px;top:20px;bottom:-2px;
    width:2px;background:#2A333B;}
  #hbm-{{ section.id }} .stp:last-child::before{display:none;}
  #hbm-{{ section.id }} .stp.done::before{background:var(--hb-blue,#0046BE);}
  #hbm-{{ section.id }} .dot{width:26px;height:26px;border-radius:50%;border:2px solid #38424B;
    display:grid;place-items:center;background:#12171C;position:relative;z-index:1;}
  #hbm-{{ section.id }} .stp.done .dot{border-color:var(--hb-blue,#0046BE);background:var(--hb-blue,#0046BE);}
  #hbm-{{ section.id }} .stp.done .dot::after{content:'';width:9px;height:5px;border-left:2px solid #fff;
    border-bottom:2px solid #fff;transform:rotate(-45deg) translate(1px,-1px);}
  #hbm-{{ section.id }} .stp.now .dot{border-color:var(--hb-yellow,#FFE000);
    box-shadow:0 0 0 0 rgba(255,224,0,.55);animation:hbmD-{{ section.id }} 1.8s infinite;}
  @keyframes hbmD-{{ section.id }}{70%{box-shadow:0 0 0 12px rgba(255,224,0,0)}100%{box-shadow:0 0 0 0 rgba(255,224,0,0)}}
  #hbm-{{ section.id }} .sl{font-size:15px;font-weight:700;line-height:1.3;}
  #hbm-{{ section.id }} .sd{font-size:13px;color:#8C959D;margin-top:3px;}
  #hbm-{{ section.id }} .foot{margin-top:18px;font-size:12.5px;color:#8C959D;line-height:1.55;}

  @media(min-width:1000px){
    #hbm-{{ section.id }} .col{flex:0 0 50%;max-width:50%;}
    #hbm-{{ section.id }} .col.a{padding-right:28px;}
  }
  @media(prefers-reduced-motion:reduce){
    #hbm-{{ section.id }} .stp.now .dot,#hbm-{{ section.id }} .head-r{animation:none;}
  }
</style>

<section id="hbm-{{ section.id }}">
  <div class="wrap">
    <div class="lay">
      <div class="col a">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h1>{{ s.heading | default: 'Track your order' }}</h1>
        {%- if s.sub != blank -%}<p class="sub">{{ s.sub }}</p>{%- endif -%}

        <form class="form" data-form>
          <label for="hbm-in-{{ section.id }}" style="position:absolute;left:-9999px">Tracking number</label>
          <input id="hbm-in-{{ section.id }}" type="text" data-in autocomplete="off" spellcheck="false"
                 placeholder="{{ s.placeholder | default: 'HELIOS289471132' | escape }}">
          <button type="submit" class="go">{{ s.cta | default: 'Track' }}</button>
        </form>
        <p class="err" data-err role="status" aria-live="polite"></p>

        <div class="panel" data-panel>
          <div class="pt">
            <span class="code" data-code></span>
            <span class="pill" data-pill></span>
          </div>
          <div class="meta">
            <span data-route></span><span data-eta></span><span data-carrier></span>
          </div>
          <div class="tl" data-tl></div>
        </div>

        {%- if s.foot != blank -%}<p class="foot">{{ s.foot }}</p>{%- endif -%}
      </div>

      <div class="col">
        <div class="stage">
