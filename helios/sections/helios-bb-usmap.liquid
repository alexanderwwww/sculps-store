<script type="application/json" data-ship-{{ section.id }}>
[
{%- assign n = 0 -%}
{%- for b in section.blocks -%}
  {%- if b.settings.code != blank -%}
  {%- if n > 0 -%},{%- endif -%}
  {%- assign n = n | plus: 1 -%}
  {
    "code": {{ b.settings.code | strip | upcase | json }},
    "stage": {{ b.settings.stage | default: 3 }},
    "from": {{ b.settings.from | default: 'Ontario, CA' | json }},
    "flon": {{ b.settings.from_lon | default: -117.61 }},
    "flat": {{ b.settings.from_lat | default: 34.06 }},
    "to": {{ b.settings.to | default: 'Austin, TX' | json }},
    "tlon": {{ b.settings.to_lon | default: -97.74 }},
    "tlat": {{ b.settings.to_lat | default: 30.27 }},
    "state": {{ b.settings.state | json }},
    "eta": {{ b.settings.eta | json }},
    "carrier": {{ b.settings.carrier | json }},
    "d1": {{ b.settings.d1 | json }}, "d2": {{ b.settings.d2 | json }},
    "d3": {{ b.settings.d3 | json }}, "d4": {{ b.settings.d4 | json }},
    "d5": {{ b.settings.d5 | json }}
  }
  {%- endif -%}
{%- endfor -%}
]
</script>

<script>
(function(){
  var ID='{{ section.id }}', root=document.getElementById('hbm-'+ID);
  if(!root||root.dataset.on==='1')return; root.dataset.on='1';

  var raw=document.querySelector('[data-ship-'+ID+']');
  var SHIPS=[]; try{ SHIPS=JSON.parse(raw.textContent)||[]; }catch(e){ SHIPS=[]; }
  /* A malformed block would break the parse; a failed parse degrades to
     "not found" rather than taking the page down. */

  var STAGES=[
    {k:'Order placed',    s:'Payment confirmed'},
    {k:'Packed',          s:'Left our facility'},
    {k:'In transit',      s:'Moving across the country'},
    {k:'Out for delivery',s:'With the local courier'},
    {k:'Delivered',       s:'Handed over'}
  ];

  /* Albers conic equal-area, matching the projection the state paths were
     baked with, so a lat/lon lands exactly where its state is drawn. */
  var RAD=Math.PI/180;
  function albers(p0,p1,rotLon,cLon,cLat,scale,tx,ty){
    var s0=Math.sin(p0*RAD), n=(s0+Math.sin(p1*RAD))/2;
    var C=1+s0*(2*n-s0), r0=Math.sqrt(C)/n;
    function rawp(rlon,lat){
      var l=rlon*RAD*n, ph=lat*RAD, r=Math.sqrt(C-2*n*Math.sin(ph))/n;
      return [r*Math.sin(l), r0-r*Math.cos(l)];
    }
    var c=rawp(cLon,cLat);
    return function(lon,lat){
      var q=rawp(lon+rotLon,lat);
      return [tx+scale*(q[0]-c[0]), ty-scale*(q[1]-c[1])];
    };
  }
  var K=1070, TX=480, TY=250;
  var L48=albers(29.5,45.5,96,-0.6,38.7,K,TX,TY);
  var AK =albers(55,65,154,-2,58.5,K*0.35,TX-0.307*K,TY+0.201*K);
  var HI =albers(8,18,157,-3,19.9,K,TX-0.205*K,TY+0.212*K);
  function project(lon,lat){
    if(lat>50 && lon<-129) return AK(lon,lat);
    if(lat<25.5 && lon<-150) return HI(lon,lat);
    return L48(lon,lat);
  }

  var gStates=root.querySelector('[data-states]'), gRoute=root.querySelector('[data-route]');
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  [].forEach.call(gStates.children,function(p){ p.setAttribute('class','st-fill'); });

  function svg(t,a){
    var e=document.createElementNS('http://www.w3.org/2000/svg',t);
    for(var k in a) e.setAttribute(k,a[k]);
    return e;
  }
  function esc(v){ return String(v==null?'':v).replace(/[&<>"]/g,function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

  function highlight(name){
    [].forEach.call(gStates.children,function(p){
      p.setAttribute('class', name && p.getAttribute('data-s')===name ? 'st-fill hit' : 'st-fill');
    });
  }

  function drawRoute(a,b,frac){
    gRoute.textContent='';
    var mx=(a[0]+b[0])/2, my=(a[1]+b[1])/2;
    var dx=b[0]-a[0], dy=b[1]-a[1], len=Math.hypot(dx,dy)||1;
    /* Bow the arc perpendicular to the leg so it never lies flat on the line. */
    var cx=mx-dy*0.16, cy=my+dx*0.16;
    function at(t){
      var u=1-t;
      return [u*u*a[0]+2*u*t*cx+t*t*b[0], u*u*a[1]+2*u*t*cy+t*t*b[1]];
    }
    var d='M'+a[0].toFixed(1)+' '+a[1].toFixed(1);
    var N=48, lim=Math.max(1,Math.round(N*frac));
    for(var i=1;i<=lim;i++){ var q=at(i/N); d+='L'+q[0].toFixed(1)+' '+q[1].toFixed(1); }
    gRoute.appendChild(svg('path',{d:d,'class':'route','stroke-dasharray':'6 6'}));

    gRoute.appendChild(svg('circle',{cx:a[0],cy:a[1],r:7,'class':'pin-r',stroke:'#7EC4FF'}));
    gRoute.appendChild(svg('circle',{cx:a[0],cy:a[1],r:4,'class':'pin-o'}));
    gRoute.appendChild(svg('circle',{cx:b[0],cy:b[1],r:7,'class':'pin-r',stroke:'#5BE0B8'}));
    gRoute.appendChild(svg('circle',{cx:b[0],cy:b[1],r:4,'class':'pin-d'}));

    var h=at(lim/N);
    if(!reduce) gRoute.appendChild(svg('circle',{cx:h[0],cy:h[1],r:6,'class':'head-r'}));
    gRoute.appendChild(svg('circle',{cx:h[0],cy:h[1],r:5,'class':'head'}));
  }

  var form=root.querySelector('[data-form]'), input=root.querySelector('[data-in]'),
      err=root.querySelector('[data-err]'), panel=root.querySelector('[data-panel]');

  function norm(v){ return String(v||'').toUpperCase().replace(/[^A-Z0-9]/g,''); }

  function show(sh){
    var st=Math.max(1,Math.min(5,parseInt(sh.stage,10)||1));
    root.querySelector('[data-code]').textContent=sh.code;
    root.querySelector('[data-pill]').textContent=STAGES[st-1].k;
    root.querySelector('[data-route]').innerHTML='Route: <b>'+esc(sh.from)+'</b> &rarr; <b>'+esc(sh.to)+'</b>';
    root.querySelector('[data-eta]').innerHTML=sh.eta?('Estimated delivery: <b>'+esc(sh.eta)+'</b>'):'';
    root.querySelector('[data-carrier]').innerHTML=sh.carrier?('Carrier: <b>'+esc(sh.carrier)+'</b>'):'';

    var out='';
    for(var i=0;i<5;i++){
      var cls=i<st-1?'done':(i===st-1?'now':'');
      var when=sh['d'+(i+1)]||'';
      out+='<div class="stp '+cls+'"><span class="dot"></span><div><div class="sl">'+STAGES[i].k+
           '</div><div class="sd">'+esc(when||STAGES[i].s)+'</div></div></div>';
    }
    root.querySelector('[data-tl]').innerHTML=out;
    panel.classList.add('on');
    err.textContent='';

    highlight(sh.state||'');
    var a=project(parseFloat(sh.flon)||0, parseFloat(sh.flat)||0);
    var b=project(parseFloat(sh.tlon)||0, parseFloat(sh.tlat)||0);
    var target=(st-1)/4; if(target===0)target=0.05;
    if(reduce){ drawRoute(a,b,target); }
    else {
      var t0=null;
      requestAnimationFrame(function step(ts){
        if(t0===null)t0=ts;
        var f=Math.min(target,(ts-t0)/900*target);
        drawRoute(a,b,f);
        if(f<target)requestAnimationFrame(step);
      });
    }
    panel.scrollIntoView({behavior:reduce?'auto':'smooth',block:'nearest'});
  }

  function lookup(v){
    var q=norm(v);
    if(!q){ err.textContent='Enter your tracking number.'; panel.classList.remove('on'); return; }
    for(var i=0;i<SHIPS.length;i++){ if(norm(SHIPS[i].code)===q){ show(SHIPS[i]); return; } }
    panel.classList.remove('on'); highlight(''); gRoute.textContent='';
    err.textContent={{ s.not_found | default: 'We could not find that number yet. Numbers go live once the parcel is scanned, which can take up to 48 hours after your confirmation email.' | json }};
  }
  form.addEventListener('submit',function(e){ e.preventDefault(); lookup(input.value); });

  try{
    var qp=new URLSearchParams(window.location.search).get('t');
    if(qp){ input.value=qp; lookup(qp); }
  }catch(e){}
})();
</script>

{% schema %}
{
  "name": "HELIOS US tracking map",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HELIOS logistics" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your order" },
    { "type": "textarea", "id": "sub", "label": "Sub", "default": "Enter the HELIOS number from your shipping email." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "HELIOS289471132" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Track" },
    { "type": "textarea", "id": "not_found", "label": "Not-found message", "default": "We could not find that number yet. Numbers go live once the parcel is scanned, which can take up to 48 hours after your confirmation email." },
    { "type": "textarea", "id": "foot", "label": "Footnote", "default": "Questions about a delivery? Email helios.us.store@gmail.com with your order number." }
  ],
  "blocks": [{
    "type": "ship", "name": "Shipment", "limit": 80,
    "settings": [
      { "type": "paragraph", "content": "Anything here is visible in the page source. Use city, state and status only, never a full address, phone or email." },
      { "type": "text", "id": "code", "label": "Tracking number", "default": "HELIOS289471132" },
      { "type": "range", "id": "stage", "label": "Current stage", "min": 1, "max": 5, "step": 1, "default": 3,
        "info": "1 placed, 2 packed, 3 in transit, 4 out for delivery, 5 delivered" },
      { "type": "header", "content": "From" },
      { "type": "text", "id": "from", "label": "From (city, state)", "default": "Ontario, CA" },
      { "type": "text", "id": "from_lon", "label": "From longitude", "default": "-117.61" },
      { "type": "text", "id": "from_lat", "label": "From latitude", "default": "34.06" },
      { "type": "header", "content": "To" },
      { "type": "text", "id": "to", "label": "To (city, state)", "default": "Austin, TX" },
      { "type": "text", "id": "to_lon", "label": "To longitude", "default": "-97.74" },
      { "type": "text", "id": "to_lat", "label": "To latitude", "default": "30.27" },
      { "type": "text", "id": "state", "label": "Destination state", "info": "Full name, e.g. Texas. Lights that state up on the map.", "default": "Texas" },
      { "type": "header", "content": "Detail" },
      { "type": "text", "id": "eta", "label": "Estimated delivery" },
      { "type": "text", "id": "carrier", "label": "Carrier" },
      { "type": "text", "id": "d1", "label": "Date, order placed" },
      { "type": "text", "id": "d2", "label": "Date, packed" },
      { "type": "text", "id": "d3", "label": "Date, in transit" },
      { "type": "text", "id": "d4", "label": "Date, out for delivery" },
      { "type": "text", "id": "d5", "label": "Date, delivered" }
    ]
  }],
  "presets": [{ "name": "HELIOS US tracking map", "blocks": [{ "type": "ship" }] }]
}
{% endschema %}
