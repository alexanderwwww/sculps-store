{%- comment -%}
  HELIOS — UGC video wall.

  Each card takes ONE of, in priority order:
    1. an uploaded Shopify video  -> autoplays muted, loops inline
    2. a direct .mp4 URL          -> same
    3. an embed (TikTok / IG / YouTube iframe or embed code)
    4. a still image

  Uploaded and direct video autoplay muted and unmute on tap (or hover on a
  pointer device); unmuting one mutes the rest, so two clips never talk over
  each other. Playback is tied to an IntersectionObserver — a row of
  autoplaying video otherwise saturates mobile bandwidth and stalls the page.

  Handles and captions are block fields and ship empty. Only fill them in for
  clips a real person actually posted.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign n = 0
  for b in section.blocks
    if b.settings.video != blank or b.settings.video_url != blank or b.settings.embed != blank or b.settings.poster != blank
      assign n = n | plus: 1
    endif
  endfor
-%}
<style>
  #hbu-{{ sid }}{background:var(--hb-soft,#F0F2F4);padding-block:34px;overflow:hidden;
    border-block:1px solid var(--hb-line-soft,#E3E7EB);}
  #hbu-{{ sid }} .hd{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:16px;}
  #hbu-{{ sid }} .e{font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
    color:var(--hb-blue,#0046BE);}
  #hbu-{{ sid }} .vp{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;}
  #hbu-{{ sid }} .vp::-webkit-scrollbar{display:none;}
  #hbu-{{ sid }} .tr{display:flex;gap:12px;list-style:none;margin:0;padding:0 var(--hb-gut,16px) 0 0;width:max-content;}
  #hbu-{{ sid }} .c{flex:none;width:min(58vw,230px);scroll-snap-align:center;}
  #hbu-{{ sid }} .sc{position:relative;width:100%;aspect-ratio:9/16;border-radius:8px;overflow:hidden;
    background:#000;border:1px solid var(--hb-line,#C5CBD5);}
  #hbu-{{ sid }} .sc video,#hbu-{{ sid }} .sc img,#hbu-{{ sid }} .sc iframe{
    width:100%;height:100%;object-fit:cover;display:block;border:0;}
  #hbu-{{ sid }} .sc blockquote{width:100%!important;height:100%!important;margin:0!important;}
  #hbu-{{ sid }} .snd{position:absolute;right:8px;bottom:8px;width:32px;height:32px;border-radius:50%;
    border:0;background:rgba(0,0,0,.55);color:#fff;display:grid;place-items:center;cursor:pointer;padding:0;}
  #hbu-{{ sid }} .snd svg{width:16px;height:16px;}
  #hbu-{{ sid }} .cap{font-size:13px;line-height:1.45;margin-top:9px;}
  #hbu-{{ sid }} .hd2{font-size:12px;color:var(--hb-muted,#5F6871);margin-top:3px;font-weight:600;}
  #hbu-{{ sid }} .empty{border:1px dashed var(--hb-line,#C5CBD5);border-radius:6px;padding:28px 20px;
    text-align:center;background:#fff;color:var(--hb-muted,#5F6871);font-size:13.5px;}
  @media(min-width:900px){
    #hbu-{{ sid }} .tr{padding-inline:max(var(--hb-gut,16px),calc((100vw - var(--hb-maxw,1440px))/2)) 0;}
  }
</style>

<div class="hb" id="hbu-{{ sid }}">
  <div class="hb-wrap hd">
    <div>
      {%- if s.eyebrow != blank -%}<p class="e">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="hb-h2" style="margin-top:7px">{{ s.heading }}</h2>{%- endif -%}
    </div>
  </div>

  {%- if n > 0 -%}
    <div class="vp">
      <ul class="tr">
        {%- for b in section.blocks -%}
          {%- liquid
            assign has = false
            if b.settings.video != blank or b.settings.video_url != blank or b.settings.embed != blank or b.settings.poster != blank
              assign has = true
            endif
          -%}
          {%- if has -%}
            <li class="c" {{ b.shopify_attributes }}>
              <div class="sc">
                {%- if b.settings.video != blank -%}
                  {{ b.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'none' }}
                  <button type="button" class="snd" data-snd aria-label="Toggle sound">
                    <svg viewBox="0 0 24 24" fill="currentColor" data-off><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M17 9l4 6M21 9l-4 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
                  </button>
                {%- elsif b.settings.video_url != blank -%}
                  <video src="{{ b.settings.video_url }}" muted loop playsinline preload="none"
                         {% if b.settings.poster != blank %}poster="{{ b.settings.poster | image_url: width: 600 }}"{% endif %}></video>
                  <button type="button" class="snd" data-snd aria-label="Toggle sound">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M17 9l4 6M21 9l-4 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
                  </button>
                {%- elsif b.settings.embed != blank -%}
                  {{ b.settings.embed }}
                {%- elsif b.settings.embed_url != blank -%}
                  <iframe src="{{ b.settings.embed_url }}" loading="lazy" allowfullscreen
                          allow="autoplay; encrypted-media; picture-in-picture"
                          title="{{ b.settings.caption | default: 'Customer video' | escape }}"></iframe>
                {%- elsif b.settings.poster != blank -%}
                  <img src="{{ b.settings.poster | image_url: width: 600 }}"
                       alt="{{ b.settings.caption | escape }}" loading="lazy">
                {%- endif -%}
              </div>
              {%- if b.settings.caption != blank -%}<p class="cap">{{ b.settings.caption }}</p>{%- endif -%}
              {%- if b.settings.handle != blank -%}<p class="hd2">{{ b.settings.handle }}</p>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- else -%}
    <div class="hb-wrap"><div class="empty">{{ s.empty_text | default: 'Add a clip in the section settings.' }}</div></div>
  {%- endif -%}
</div>

<script>
(function(){
  var root=document.getElementById('hbu-{{ sid }}');
  if(!root||root.dataset.ready==='1')return; root.dataset.ready='1';
  var vids=[].slice.call(root.querySelectorAll('video'));
  if(!vids.length)return;

  function muteOthers(keep){ vids.forEach(function(v){ if(v!==keep){v.muted=true;} }); }

  vids.forEach(function(v){
    v.muted=true; v.setAttribute('playsinline','');
    var btn=v.parentNode.querySelector('[data-snd]');
    if(btn) btn.addEventListener('click',function(e){
      e.stopPropagation();
      if(v.muted){ muteOthers(v); v.muted=false; v.volume=1; var p=v.play(); if(p&&p.catch)p.catch(function(){}); }
      else { v.muted=true; }
    });
  });

  /* only play what is on screen */
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(en){
      en.forEach(function(x){
        var v=x.target;
        if(x.isIntersecting){ var p=v.play(); if(p&&p.catch)p.catch(function(){}); }
        else { v.pause(); v.muted=true; }
      });
    },{threshold:0.4});
    vids.forEach(function(v){ io.observe(v); });
  } else {
    vids.forEach(function(v){ var p=v.play(); if(p&&p.catch)p.catch(function(){}); });
  }
})();
</script>

{% schema %}
{
  "name": "HELIOS UGC wall",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On the water" },
    { "type": "textarea", "id": "empty_text", "label": "Empty state text" }
  ],
  "blocks": [{ "type": "clip", "name": "Clip", "limit": 10, "settings": [
    { "type": "video", "id": "video", "label": "Upload video", "info": "Vertical 9:16. Autoplays muted, unmute on tap." },
    { "type": "text", "id": "video_url", "label": "Or direct .mp4 URL" },
    { "type": "html", "id": "embed", "label": "Or embed code", "info": "Paste a TikTok / Instagram / YouTube embed snippet." },
    { "type": "text", "id": "embed_url", "label": "Or iframe URL" },
    { "type": "image_picker", "id": "poster", "label": "Poster / fallback image" },
    { "type": "text", "id": "caption", "label": "Caption", "info": "Use the poster's own words. Leave empty rather than inventing one." },
    { "type": "text", "id": "handle", "label": "Handle", "info": "Only for a clip a real account actually posted." }
  ]}],
  "presets": [{ "name": "HELIOS UGC wall", "blocks": [{ "type": "clip" }, { "type": "clip" }, { "type": "clip" }] }]
}
{% endschema %}
