{%- comment -%}
  HELIOS — what's in the box, as a carousel. sections/helios-box.liquid

  The previous version was a static checklist beside one photo. This shows the
  contents the way a buyer wants to see them: one card per item, swipeable, each
  with its own photo, so the value of the bundle is looked at rather than read.

  Scroll-snap does the paging, so it drags natively on a phone with no library
  and keeps working if the script never runs. The arrows and dots are
  progressive enhancement on top.

  All classes are prefixed hbx- so Horizon's global stylesheet, which styles
  generic names like .grid and .wrap, cannot reach in.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
<section class="helios" id="hbx-{{ sid }}">
<style>
  #hbx-{{ sid }}{background:{{ s.bg | default: '#F7FAFA' }};color:#0F1111;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
    padding:clamp(var(--sp-5,34px),4vw,var(--sp-6,55px)) 0;overflow:hidden;}
  #hbx-{{ sid }} *{box-sizing:border-box;min-width:0;}
  #hbx-{{ sid }} .hbx-wrap{width:100%;max-width:1180px;margin:0 auto;padding:0 var(--sp-4,21px);}
  #hbx-{{ sid }} .hbx-head{display:flex;align-items:flex-end;justify-content:space-between;
    gap:var(--sp-4,21px);margin-bottom:var(--sp-4,21px);}
  #hbx-{{ sid }} .hbx-eb{font-size:var(--fs-xs,12.6px);font-weight:800;letter-spacing:.12em;
    text-transform:uppercase;color:#565959;margin-bottom:var(--sp-2,8px);}
  #hbx-{{ sid }} .hbx-h{font-size:clamp(var(--fs-lg,25.9px),3.2vw,var(--fs-xl,32.9px));font-weight:800;
    letter-spacing:-.025em;line-height:var(--lh-tight,1.236);margin:0;}
  #hbx-{{ sid }} .hbx-nav{display:flex;gap:var(--sp-2,8px);flex:none;}
  #hbx-{{ sid }} .hbx-nav button{width:40px;height:40px;border-radius:50%;cursor:pointer;
    border:1px solid #C5CBD5;background:#fff;color:#0F1111;display:flex;align-items:center;
    justify-content:center;padding:0;transition:border-color .15s,opacity .15s;}
  #hbx-{{ sid }} .hbx-nav button:hover{border-color:#0F1111;}
  #hbx-{{ sid }} .hbx-nav button[disabled]{opacity:.32;cursor:default;}
  #hbx-{{ sid }} .hbx-nav svg{width:17px;height:17px;}

  /* Native scroll-snap carousel. Padding on the rail plus a scroll-padding of
     the same size keeps the first and last card flush with the page gutter. */
  #hbx-{{ sid }} .hbx-rail{display:flex;gap:var(--sp-3,13px);overflow-x:auto;
    scroll-snap-type:x mandatory;scroll-behavior:smooth;
    -webkit-overflow-scrolling:touch;scrollbar-width:none;
    padding-bottom:var(--sp-2,8px);margin-inline:calc(var(--sp-4,21px) * -1);
    padding-inline:var(--sp-4,21px);scroll-padding-inline:var(--sp-4,21px);}
  #hbx-{{ sid }} .hbx-rail::-webkit-scrollbar{display:none;}
  #hbx-{{ sid }} .hbx-card{flex:0 0 auto;width:clamp(210px,26vw,268px);scroll-snap-align:start;
    background:#fff;border:1px solid #E1E5E5;border-radius:var(--r-md,13px);overflow:hidden;
    display:flex;flex-direction:column;}
  #hbx-{{ sid }} .hbx-ph{display:block;width:100%;aspect-ratio:1/1;object-fit:cover;background:#EEF2F3;}
  #hbx-{{ sid }} .hbx-ico{width:100%;aspect-ratio:1/1;background:#EEF2F3;display:flex;
    align-items:center;justify-content:center;font-size:44px;line-height:1;}
  #hbx-{{ sid }} .hbx-bd{padding:var(--sp-3,13px) var(--sp-3,13px) var(--sp-4,21px);
    display:flex;flex-direction:column;gap:4px;flex:1 1 auto;}
  #hbx-{{ sid }} .hbx-q{align-self:flex-start;font-size:11px;font-weight:800;letter-spacing:.04em;
    color:#0F1111;background:#F0F2F2;border-radius:100px;padding:3px 9px;}
  #hbx-{{ sid }} .hbx-t{font-size:var(--fs-base,16px);font-weight:800;line-height:1.25;
    letter-spacing:-.01em;margin-top:2px;}
  #hbx-{{ sid }} .hbx-d{font-size:var(--fs-xs,12.6px);color:#565959;line-height:1.45;}

  #hbx-{{ sid }} .hbx-dots{display:flex;justify-content:center;gap:6px;margin-top:var(--sp-3,13px);}
  #hbx-{{ sid }} .hbx-dots i{width:6px;height:6px;border-radius:50%;background:#C5CBD5;
    transition:background .2s,width .2s;}
  #hbx-{{ sid }} .hbx-dots i.on{background:#0F1111;width:18px;border-radius:100px;}

  #hbx-{{ sid }} .hbx-foot{display:flex;align-items:center;gap:var(--sp-2,8px);
    margin-top:var(--sp-4,21px);font-size:var(--fs-sm,14.1px);font-weight:700;color:#046B53;}
  #hbx-{{ sid }} .hbx-foot svg{width:17px;height:17px;flex:none;}
  #hbx-{{ sid }} .hbx-note{font-size:11.5px;color:#8a9192;margin-top:var(--sp-3,13px);line-height:1.55;}
  @media(max-width:699px){
    #hbx-{{ sid }} .hbx-nav{display:none;}
    #hbx-{{ sid }} .hbx-card{width:76vw;}
  }
  @media(prefers-reduced-motion:reduce){#hbx-{{ sid }} .hbx-rail{scroll-behavior:auto;}}
</style>
  <div class="hbx-wrap">
    <div class="hbx-head">
      <div>
        {%- if s.eyebrow != blank -%}<div class="hbx-eb">{{ s.eyebrow }}</div>{%- endif -%}
        <h2 class="hbx-h">{{ s.heading | default: 'Everything in the box' }}</h2>
      </div>
      <div class="hbx-nav">
        <button type="button" data-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" data-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>

    <div class="hbx-rail" data-rail>
      {%- for b in section.blocks -%}
        <article class="hbx-card" {{ b.shopify_attributes }}>
          {%- if b.settings.image != blank -%}
            <img class="hbx-ph" src="{{ b.settings.image | image_url: width: 700 }}"
                 srcset="{{ b.settings.image | image_url: width: 400 }} 400w,
                         {{ b.settings.image | image_url: width: 700 }} 700w"
                 sizes="268px" alt="{{ b.settings.title | escape }}" loading="lazy">
          {%- else -%}
            <div class="hbx-ico" aria-hidden="true">{{ b.settings.icon }}</div>
          {%- endif -%}
          <div class="hbx-bd">
            {%- if b.settings.qty != blank -%}<span class="hbx-q">{{ b.settings.qty }}</span>{%- endif -%}
            <span class="hbx-t">{{ b.settings.title }}</span>
            {%- if b.settings.note != blank -%}<span class="hbx-d">{{ b.settings.note }}</span>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    <div class="hbx-dots" data-dots aria-hidden="true"></div>

    {%- if s.foot != blank -%}
      <p class="hbx-foot">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        {{ s.foot }}
      </p>
    {%- endif -%}
    {%- if s.note != blank -%}<p class="hbx-note">{{ s.note }}</p>{%- endif -%}
  </div>

<script>
(function(){
  var root=document.getElementById('hbx-{{ sid }}');
  if(!root||root.dataset.on==='1')return; root.dataset.on='1';
  var rail=root.querySelector('[data-rail]'),
      cards=[].slice.call(rail.children),
      dots=root.querySelector('[data-dots]'),
      prev=root.querySelector('[data-prev]'), next=root.querySelector('[data-next]');
  if(!cards.length)return;

  cards.forEach(function(){ dots.appendChild(document.createElement('i')); });

  function step(){
    /* One card plus the gap, measured rather than assumed, so the clamped card
       width and the gap token can change without touching this. */
    if(cards.length<2)return cards[0].offsetWidth;
    return cards[1].offsetLeft-cards[0].offsetLeft;
  }
  function index(){ return Math.round(rail.scrollLeft/Math.max(step(),1)); }

  function sync(){
    var i=Math.max(0,Math.min(cards.length-1,index()));
    [].forEach.call(dots.children,function(d,k){ d.classList.toggle('on',k===i); });
    /* A couple of pixels of slack: sub-pixel scroll positions would otherwise
       leave the end arrow enabled forever. */
    if(prev)prev.disabled=rail.scrollLeft<=2;
    if(next)next.disabled=rail.scrollLeft>=rail.scrollWidth-rail.clientWidth-2;
  }
  rail.addEventListener('scroll',function(){
    window.requestAnimationFrame(sync);
  },{passive:true});
  if(prev)prev.addEventListener('click',function(){ rail.scrollLeft-=step(); });
  if(next)next.addEventListener('click',function(){ rail.scrollLeft+=step(); });
  if(window.ResizeObserver) new ResizeObserver(sync).observe(rail);
  sync();
})();
</script>
</section>
{% schema %}
{
  "name": "HELIOS Box",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#F7FAFA" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No tools, no extras to buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything in the box" },
    { "type": "text", "id": "foot", "label": "Closing line", "default": "Nothing else to buy. Unbox it and go." },
    { "type": "textarea", "id": "note", "label": "Small print", "default": "Recreational leisure product. Not a life-saving device. Adult supervision required for under-16s." }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "limit": 12, "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo", "info": "Replaces the emoji on this card." },
      { "type": "text", "id": "icon", "label": "Emoji fallback", "default": "📦" },
      { "type": "text", "id": "title", "label": "Title", "default": "The lounger" },
      { "type": "text", "id": "note", "label": "Detail" },
      { "type": "text", "id": "qty", "label": "Quantity chip", "info": "e.g. × 1" }
    ]}
  ],
  "presets": [{ "name": "HELIOS Box", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] }]
}
{% endschema %}
