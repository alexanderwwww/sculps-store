{%- comment -%}HELIOS Box — what's in the box, icon grid. Amazon-simple.{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
<section class="helios" id="hbx-{{ sid }}">
<style>
  #hbx-{{ sid }}{background:{{ s.bg | default: '#FFFFFF' }};color:#0F1111;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;padding:clamp(var(--sp-5,34px),4vw,var(--sp-6,55px)) 0;}
  #hbx-{{ sid }} *{box-sizing:border-box;}
  #hbx-{{ sid }} .wrap{max-width:1000px;margin:0 auto;padding:0 18px;}
  #hbx-{{ sid }} .eb{font-size:12.5px;font-weight:700;color:#565959;margin-bottom:6px;}
  #hbx-{{ sid }} h2{font-size:clamp(var(--fs-md,20.4px),2.6vw,var(--fs-lg,25.9px));font-weight:700;
    letter-spacing:-.015em;line-height:var(--lh-tight,1.236);margin:0 0 var(--sp-4,21px);}
  /* Equal flex basis rather than fr tracks behind a breakpoint: an ancestor
     was sizing these grids to their content instead of stretching them, which
     collapsed columns to whatever text happened to be in them. A declared
     basis splits the row evenly and wraps on its own. */
  #hbx-{{ sid }} .grid{display:flex !important;flex-wrap:wrap;gap:1px;background:#D5D9D9;
    border:1px solid #D5D9D9;border-radius:8px;overflow:hidden;}
  #hbx-{{ sid }} .grid > *{flex:1 1 168px;min-width:0;}
  #hbx-{{ sid }} .c{background:#fff;padding:0 0 var(--sp-4,21px);text-align:center;}
  #hbx-{{ sid }} .c .ph{display:block;width:100%;aspect-ratio:1/1;object-fit:cover;
    background:#F7FAFA;margin-bottom:var(--sp-3,13px);}
  #hbx-{{ sid }} .c .ic{font-size:26px;line-height:1;padding-top:20px;margin-bottom:9px;}
  #hbx-{{ sid }} .c .tx{padding-inline:14px;}
  #hbx-{{ sid }} .c .t{font-size:14px;font-weight:700;line-height:1.3;}
  #hbx-{{ sid }} .c .d{font-size:12.5px;color:#565959;line-height:1.45;margin-top:4px;}
  #hbx-{{ sid }} .note{font-size:12.5px;color:#565959;margin-top:14px;line-height:1.5;}
</style>
  <div class="wrap">
    {%- if s.eyebrow != blank -%}<div class="eb">{{ s.eyebrow }}</div>{%- endif -%}
    <h2>{{ s.heading | default: 'Everything in the box' }}</h2>
    <div class="grid">
      {%- for b in section.blocks -%}
        <div class="c" {{ b.shopify_attributes }}>
          {%- if b.settings.image != blank -%}
            <img class="ph" src="{{ b.settings.image | image_url: width: 600 }}"
                 alt="{{ b.settings.title | escape }}" loading="lazy">
          {%- elsif b.settings.icon != blank -%}
            <div class="ic">{{ b.settings.icon }}</div>
          {%- endif -%}
          <div class="tx">
            <div class="t">{{ b.settings.title }}</div>
            {%- if b.settings.note != blank -%}<div class="d">{{ b.settings.note }}</div>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if s.note != blank -%}<p class="note">{{ s.note }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "HELIOS Box",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No tools, no extras to buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything in the box" },
    { "type": "textarea", "id": "note", "label": "Small print", "default": "Recreational leisure product. Not a life-saving device. Adult supervision required for under-16s." }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo", "info": "Drop a real photo here. It replaces the emoji." },
      { "type": "text", "id": "icon", "label": "Emoji fallback", "default": "🛥️" },
      { "type": "text", "id": "title", "label": "Title", "default": "The lounger" },
      { "type": "text", "id": "note", "label": "Detail" }
    ]}
  ],
  "presets": [{ "name": "HELIOS Box", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] }]
}
{% endschema %}
