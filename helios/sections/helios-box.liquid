{%- comment -%}
  HELIOS — what's in the box. sections/helios-box.liquid

  Rebuilt. The old version was four emoji tiles in a hairline grid and used the
  class names .wrap, .grid and .c — all of which Horizon's global stylesheet
  also styles, so the theme's own utilities leaked in and flattened it. Every
  class here is prefixed hbx- so nothing upstream can touch it.

  Layout: the kit photo carries the section, an itemised checklist sits beside
  it with quantity chips. With no photo set the list goes full width in two
  columns rather than leaving a hole.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
<section class="helios" id="hbx-{{ sid }}">
<style>
  #hbx-{{ sid }}{background:{{ s.bg | default: '#F7FAFA' }};color:#0F1111;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
    padding:clamp(var(--sp-5,34px),4vw,var(--sp-6,55px)) 0;}
  #hbx-{{ sid }} *{box-sizing:border-box;min-width:0;}
  #hbx-{{ sid }} .hbx-wrap{width:100%;max-width:1180px;margin:0 auto;padding:0 var(--sp-4,21px);}
  #hbx-{{ sid }} .hbx-eb{font-size:var(--fs-xs,12.6px);font-weight:800;letter-spacing:.12em;
    text-transform:uppercase;color:#565959;margin-bottom:var(--sp-2,8px);}
  #hbx-{{ sid }} .hbx-h{font-size:clamp(var(--fs-lg,25.9px),3.2vw,var(--fs-xl,32.9px));font-weight:800;
    letter-spacing:-.025em;line-height:var(--lh-tight,1.236);margin:0 0 var(--sp-5,34px);}

  #hbx-{{ sid }} .hbx-row{display:flex;flex-wrap:wrap;align-items:flex-start;gap:var(--sp-5,34px);}
  #hbx-{{ sid }} .hbx-fig{flex:1 1 380px;min-width:0;margin:0;position:relative;
    border-radius:var(--r-md,13px);overflow:hidden;background:#fff;border:1px solid #E7E9E9;}
  #hbx-{{ sid }} .hbx-fig img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;}
  #hbx-{{ sid }} .hbx-cnt{position:absolute;left:14px;bottom:14px;background:rgba(15,17,17,.86);
    color:#fff;font-size:11.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
    padding:6px 12px;border-radius:100px;backdrop-filter:blur(6px);}
  #hbx-{{ sid }} .hbx-list{flex:1 1 380px;min-width:0;display:flex;flex-direction:column;}

  #hbx-{{ sid }} .hbx-i{display:flex;align-items:center;gap:var(--sp-3,13px);
    padding:var(--sp-3,13px) 0;border-bottom:1px solid #E1E5E5;}
  #hbx-{{ sid }} .hbx-i:first-child{padding-top:0;}
  #hbx-{{ sid }} .hbx-i:last-child{border-bottom:0;}
  #hbx-{{ sid }} .hbx-th{flex:0 0 56px;width:56px;height:56px;border-radius:var(--r-sm,8px);
    overflow:hidden;background:#fff;border:1px solid #E7E9E9;display:flex;
    align-items:center;justify-content:center;font-size:24px;line-height:1;}
  #hbx-{{ sid }} .hbx-th img{width:100%;height:100%;object-fit:cover;display:block;}
  #hbx-{{ sid }} .hbx-tx{flex:1 1 0;min-width:0;}
  #hbx-{{ sid }} .hbx-t{font-size:var(--fs-base,16px);font-weight:800;line-height:1.25;
    letter-spacing:-.01em;}
  #hbx-{{ sid }} .hbx-d{font-size:var(--fs-xs,12.6px);color:#565959;line-height:1.45;margin-top:3px;}
  #hbx-{{ sid }} .hbx-q{flex:0 0 auto;font-size:12px;font-weight:800;color:#0F1111;
    background:#fff;border:1px solid #D5D9D9;border-radius:100px;padding:4px 11px;white-space:nowrap;}

  #hbx-{{ sid }} .hbx-foot{display:flex;align-items:center;gap:var(--sp-2,8px);
    margin-top:var(--sp-4,21px);padding-top:var(--sp-3,13px);border-top:1px solid #E1E5E5;
    font-size:var(--fs-sm,14.1px);font-weight:700;color:#046B53;}
  #hbx-{{ sid }} .hbx-foot svg{width:17px;height:17px;flex:none;}
  #hbx-{{ sid }} .hbx-note{font-size:11.5px;color:#8a9192;margin-top:var(--sp-4,21px);line-height:1.55;}

  /* No photo set: the checklist takes the row in two columns instead of
     leaving half the band empty. */
  #hbx-{{ sid }} .hbx-row.hbx-nofig .hbx-list{flex:1 1 100%;
    display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    column-gap:var(--sp-5,34px);}
  @media(max-width:699px){
    #hbx-{{ sid }} .hbx-row{gap:var(--sp-4,21px);}
    #hbx-{{ sid }} .hbx-th{flex-basis:46px;width:46px;height:46px;font-size:20px;}
  }
</style>
  <div class="hbx-wrap">
    {%- if s.eyebrow != blank -%}<div class="hbx-eb">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="hbx-h">{{ s.heading | default: 'Everything in the box' }}</h2>

    <div class="hbx-row{% if s.image == blank %} hbx-nofig{% endif %}">
      {%- if s.image != blank -%}
        <figure class="hbx-fig">
          <img src="{{ s.image | image_url: width: 1000 }}"
               alt="{{ s.heading | default: 'Everything in the box' | escape }}" loading="lazy">
          {%- if s.image_caption != blank -%}<span class="hbx-cnt">{{ s.image_caption }}</span>{%- endif -%}
        </figure>
      {%- endif -%}

      <div class="hbx-list">
        {%- for b in section.blocks -%}
          <div class="hbx-i" {{ b.shopify_attributes }}>
            <span class="hbx-th">
              {%- if b.settings.image != blank -%}
                <img src="{{ b.settings.image | image_url: width: 160 }}" alt="" loading="lazy">
              {%- else -%}
                {{ b.settings.icon }}
              {%- endif -%}
            </span>
            <span class="hbx-tx">
              <span class="hbx-t">{{ b.settings.title }}</span>
              {%- if b.settings.note != blank -%}<span class="hbx-d">{{ b.settings.note }}</span>{%- endif -%}
            </span>
            {%- if b.settings.qty != blank -%}<span class="hbx-q">{{ b.settings.qty }}</span>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if s.foot != blank -%}
      <p class="hbx-foot">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        {{ s.foot }}
      </p>
    {%- endif -%}
    {%- if s.note != blank -%}<p class="hbx-note">{{ s.note }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "HELIOS Box",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#F7FAFA" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No tools, no extras to buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything in the box" },
    { "type": "image_picker", "id": "image", "label": "Kit photo", "info": "One shot of everything laid out. Without it the checklist fills the row." },
    { "type": "text", "id": "image_caption", "label": "Caption chip on the photo" },
    { "type": "text", "id": "foot", "label": "Closing line", "default": "Nothing else to buy. Unbox it and go." },
    { "type": "textarea", "id": "note", "label": "Small print", "default": "Recreational leisure product. Not a life-saving device. Adult supervision required for under-16s." }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo", "info": "Replaces the emoji." },
      { "type": "text", "id": "icon", "label": "Emoji fallback", "default": "📦" },
      { "type": "text", "id": "title", "label": "Title", "default": "The lounger" },
      { "type": "text", "id": "note", "label": "Detail" },
      { "type": "text", "id": "qty", "label": "Quantity chip", "info": "e.g. × 1" }
    ]}
  ],
  "presets": [{ "name": "HELIOS Box", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] }]
}
{% endschema %}
