{%- comment -%}
  HELIOS — questions. <details> so it works with JavaScript off.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  .hbfq{background:var(--hb-bg,#fff);padding-block:34px;}
  .hbfq__h{margin-bottom:16px;}
  .hbfq__l{border-top:1px solid var(--hb-line-soft,#E3E7EB);}
  .hbfq__i{border-bottom:1px solid var(--hb-line-soft,#E3E7EB);}
  .hbfq__i summary{list-style:none;cursor:pointer;padding:15px 0;display:flex;justify-content:space-between;
    gap:16px;font-size:15px;font-weight:600;align-items:flex-start;}
  .hbfq__i summary::-webkit-details-marker{display:none;}
  .hbfq__i summary i{flex:none;position:relative;width:14px;height:14px;margin-top:4px;}
  .hbfq__i summary i::before,.hbfq__i summary i::after{content:'';position:absolute;left:0;right:0;top:6px;
    height:2px;border-radius:2px;background:var(--hb-blue,#0046BE);}
  .hbfq__i summary i::after{transform:rotate(90deg);transition:transform .2s;}
  .hbfq__i[open] summary i::after{transform:rotate(0);}
  .hbfq__a{padding-bottom:16px;font-size:14px;line-height:1.6;color:var(--hb-muted,#5F6871);max-width:76ch;}
  .hbfq__a p{margin:0 0 .6em;} .hbfq__a p:last-child{margin-bottom:0;}
</style>
{%- if section.blocks.size > 0 -%}
<div class="hb hbfq">
  <div class="hb-wrap">
    {%- if s.heading != blank -%}<h2 class="hb-h2 hbfq__h">{{ s.heading }}</h2>{%- endif -%}
    <div class="hbfq__l">
      {%- for b in section.blocks -%}
        <details class="hbfq__i"{% if forloop.first %} open{% endif %} {{ b.shopify_attributes }}>
          <summary>{{ b.settings.q }}<i aria-hidden="true"></i></summary>
          <div class="hbfq__a">{{ b.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "HELIOS questions",
  "tag": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Questions" }],
  "blocks": [{ "type": "qa", "name": "Question", "limit": 12, "settings": [
    { "type": "text", "id": "q", "label": "Question" },
    { "type": "richtext", "id": "a", "label": "Answer" }
  ]}],
  "presets": [{ "name": "HELIOS questions", "blocks": [{ "type": "qa" }, { "type": "qa" }, { "type": "qa" }] }]
}
{% endschema %}
