{%- comment -%}
  HELIOS Buy — framed bundle picker. Mobile-safe. Big price + Shop Pay
  installments row, full-bleed clickable/swipeable image carousel with
  liquid-glass arrows, three bundles with banner pills, dollar savings,
  auto free gift, AJAX add, Buy now + Apple Pay express, broadcasts to
  the sticky bar.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
{%- assign p = s.product -%}
{%- if p == blank -%}{%- assign p = product -%}{%- endif -%}
<section class="helios" id="hby-{{ sid }}">
<a id="{{ s.anchor | default: 'buy' }}"></a>
<style>
  #hby-{{ sid }}{background:{{ s.bg | default: '#FFFFFF' }};color:#0F1111;overflow-x:clip;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
  #hby-{{ sid }} *{box-sizing:border-box;min-width:0;}
  #hby-{{ sid }} .wrap{max-width:{{ s.width | default: 1200 }}px;margin:0 auto;padding:clamp(14px,2vw,26px) 16px clamp(24px,3vw,40px);}
  #hby-{{ sid }} .grid{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(16px,2.2vw,32px);}
  @media(min-width:900px){#hby-{{ sid }} .grid{grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);align-items:start;}}

  #hby-{{ sid }} .main{position:relative;width:100%;aspect-ratio:1/1;background:#fff;
    border:1px solid #D5D9D9;border-radius:12px;overflow:hidden;cursor:pointer;}
  #hby-{{ sid }} .main img{width:100%;height:100%;object-fit:cover;display:block;background:#fff;}
  @media(max-width:899px){
    #hby-{{ sid }} .gal{margin:0 -16px;}
    #hby-{{ sid }} .main{border:0;border-radius:0;}
    #hby-{{ sid }} .thumbs{padding:0 16px;}
  }
  #hby-{{ sid }} .arr{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:32px;height:32px;
    border:1px solid rgba(15,17,17,.10);border-radius:50%;cursor:pointer;display:grid;place-items:center;
    background:rgba(255,255,255,.10);backdrop-filter:blur(10px) saturate(150%);-webkit-backdrop-filter:blur(10px) saturate(150%);
    box-shadow:none;color:rgba(15,17,17,.55);padding:0;transition:color .15s,background .15s;}
  #hby-{{ sid }} .arr:hover{color:#0F1111;background:rgba(255,255,255,.30);}
  #hby-{{ sid }} .arr svg{width:14px;height:14px;display:block;}
  #hby-{{ sid }} .arr.l{left:12px;}
  #hby-{{ sid }} .arr.r{right:12px;}
  #hby-{{ sid }} .dots{position:absolute;left:0;right:0;bottom:10px;display:flex;justify-content:center;gap:5px;z-index:3;}
  #hby-{{ sid }} .dots i{width:6px;height:6px;border-radius:50%;background:rgba(15,17,17,.22);}
  #hby-{{ sid }} .dots i.on{background:#0F1111;}
  #hby-{{ sid }} .thumbs{display:flex;gap:8px;margin-top:9px;overflow-x:auto;-webkit-overflow-scrolling:touch;}
  #hby-{{ sid }} .thumbs button{flex:0 0 58px;width:58px;height:58px;padding:0;border:1px solid #D5D9D9;
    border-radius:8px;overflow:hidden;background:#fff;cursor:pointer;}
  #hby-{{ sid }} .thumbs button.on{border-color:#0F1111;border-width:2px;}
  #hby-{{ sid }} .thumbs img{width:100%;height:100%;object-fit:cover;display:block;}

  #hby-{{ sid }} h1{font-size:clamp(21px,2.7vw,27px);font-weight:800;line-height:1.24;margin:0 0 8px;letter-spacing:-.02em;overflow-wrap:break-word;color:#0F1111;}
  #hby-{{ sid }} .rt{display:flex;align-items:center;gap:7px;font-size:13px;margin-bottom:10px;flex-wrap:wrap;}
  #hby-{{ sid }} .rt .s{color:#F5A623;letter-spacing:1px;font-size:15px;}
  #hby-{{ sid }} .rt a{color:#007185;text-decoration:none;}

  #hby-{{ sid }} .price{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;padding-bottom:10px;}
  #hby-{{ sid }} .price b{font-size:clamp(32px,7vw,40px);font-weight:800;letter-spacing:-.03em;line-height:1;color:#0F1111;}
  #hby-{{ sid }} .price s{font-size:16px;color:#565959;}
  #hby-{{ sid }} .price em{font-style:normal;background:#CC0C39;color:#fff;font-size:12px;font-weight:800;
    border-radius:5px;padding:4px 9px;}
  #hby-{{ sid }} .price .per{width:100%;font-size:12.5px;color:#067D62;font-weight:700;}
  #hby-{{ sid }} .insta{display:flex;align-items:center;flex-wrap:wrap;gap:6px 8px;font-size:12.5px;color:#0F1111;
    padding-bottom:14px;margin-bottom:14px;border-bottom:1px solid #E7E9E9;}
  #hby-{{ sid }} .insta .lg{display:inline-flex;align-items:center;border-radius:5px;padding:3px 8px;
    font-size:11px;font-weight:800;letter-spacing:.01em;line-height:1;}
  #hby-{{ sid }} .insta .sp{background:#5A31F4;color:#fff;}
  #hby-{{ sid }} .insta .ap{background:#B2FCE4;color:#0F1111;}

  #hby-{{ sid }} .bl{margin:0 0 18px;padding:0;}
  #hby-{{ sid }} .bl li{list-style:none;display:flex;gap:9px;font-size:13.5px;line-height:1.45;align-items:flex-start;margin-bottom:7px;}
  #hby-{{ sid }} .bl li span{overflow-wrap:break-word;}
  #hby-{{ sid }} .bl .i{flex:0 0 17px;width:17px;height:17px;border-radius:50%;background:#067D62;color:#fff;
    font-size:10px;font-weight:900;display:grid;place-items:center;margin-top:1px;}

  #hby-{{ sid }} .frame{border:1px solid #D5D9D9;border-radius:14px;background:#fff;}
  #hby-{{ sid }} .fhead{background:#0F1111;color:#fff;display:flex;align-items:center;justify-content:space-between;
    gap:6px 12px;padding:12px 16px;font-size:13.5px;font-weight:800;letter-spacing:.02em;flex-wrap:wrap;
    border-radius:13px 13px 0 0;}
  #hby-{{ sid }} .fhead .pop{color:#FFC531;font-size:12.5px;}
  #hby-{{ sid }} .steps{display:flex;flex-wrap:wrap;gap:6px 16px;padding:11px 16px;background:#F7FAFA;
    border-bottom:1px solid #E7E9E9;font-size:12px;color:#565959;}
  #hby-{{ sid }} .steps b{color:#0F1111;font-weight:800;margin-right:3px;}
  #hby-{{ sid }} .opts{padding:12px;display:flex;flex-direction:column;gap:10px;}
  #hby-{{ sid }} .opt{position:relative;display:flex;align-items:center;gap:10px;width:100%;text-align:left;
    border:1px solid #D5D9D9;border-radius:12px;background:#fff;color:#0F1111;padding:12px 10px;cursor:pointer;
    transition:border-color .12s,box-shadow .12s;overflow:visible;}
  #hby-{{ sid }} .opt:hover{border-color:#8d9698;}
  #hby-{{ sid }} .opt.on{border-color:#0F1111;border-width:2px;padding:11px 9px;box-shadow:0 2px 10px -4px rgba(0,0,0,.18);}
  #hby-{{ sid }} .opt.hastag{margin-top:8px;}
  #hby-{{ sid }} .tagp{position:absolute;top:-10px;left:50%;transform:translateX(-50%);z-index:2;
    color:#fff;font-size:10.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;
    border-radius:100px;padding:4px 13px;white-space:nowrap;line-height:1.2;
    box-shadow:0 2px 8px rgba(0,0,0,.20);}
  #hby-{{ sid }} .dot{flex:0 0 18px;width:18px;height:18px;border-radius:50%;border:1.6px solid #8d9698;display:grid;place-items:center;}
  #hby-{{ sid }} .opt.on .dot{border-color:#0F1111;}
  #hby-{{ sid }} .opt.on .dot:after{content:'';width:9px;height:9px;border-radius:50%;background:#0F1111;}
  #hby-{{ sid }} .oim{flex:0 0 54px;width:54px;height:54px;border-radius:8px;overflow:hidden;background:#fff;border:1px solid #E7E9E9;}
  #hby-{{ sid }} .oim img{width:100%;height:100%;object-fit:contain;display:block;}
  #hby-{{ sid }} .oi{flex:1 1 0;}
  #hby-{{ sid }} .oi .t{display:block;font-size:15px;font-weight:800;line-height:1.22;letter-spacing:-.01em;overflow-wrap:break-word;color:#0F1111;}
  #hby-{{ sid }} .oi .d{display:block;font-size:12px;color:#565959;margin-top:2px;line-height:1.35;overflow-wrap:break-word;}
  #hby-{{ sid }} .oi .gift{display:inline-block;margin-top:6px;background:#E3F6EC;color:#046B53;border:1px solid #B6E5CE;
    border-radius:100px;padding:3px 9px;font-size:11px;font-weight:800;}
  #hby-{{ sid }} .op{flex:0 0 auto;max-width:42%;text-align:right;}
  #hby-{{ sid }} .op .sv{display:inline-block;background:#CC0C39;color:#fff;font-size:10.5px;font-weight:800;
    border-radius:5px;padding:3px 7px;margin-bottom:4px;}
  #hby-{{ sid }} .op .n{font-size:18px;font-weight:800;letter-spacing:-.02em;display:block;color:#0F1111;}
  #hby-{{ sid }} .op .o{font-size:12px;color:#565959;text-decoration:line-through;display:block;margin-top:2px;}

  #hby-{{ sid }} .atc{display:block;width:100%;background:#FFD814;color:#0F1111;border:1px solid #FCD200;
    border-radius:100px;padding:15px;font-size:16px;font-weight:800;cursor:pointer;margin-top:16px;transition:background .15s;}
  #hby-{{ sid }} .atc:hover{background:#F7CA00;}
  #hby-{{ sid }} .atc.ok{background:#067D62;border-color:#067D62;color:#fff;}
  #hby-{{ sid }} .xrow{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:9px;}
  #hby-{{ sid }} .xbtn{border-radius:100px;padding:13px 10px;font-size:14.5px;font-weight:800;cursor:pointer;
    text-align:center;display:flex;align-items:center;justify-content:center;gap:6px;}
  #hby-{{ sid }} .buynow{background:#fff;color:#0F1111;border:1.5px solid #0F1111;}
  #hby-{{ sid }} .buynow:hover{background:#F7FAFA;}
  #hby-{{ sid }} .apay{background:#000;color:#fff;border:1.5px solid #000;}
  #hby-{{ sid }} .apay svg{width:15px;height:18px;display:block;}
  #hby-{{ sid }} .after{display:none;margin-top:9px;}
  #hby-{{ sid }} .after.on{display:block;}
  #hby-{{ sid }} .after a{display:block;width:100%;text-align:center;background:#0F1111;color:#fff;border-radius:100px;
    padding:14px;font-size:15px;font-weight:800;text-decoration:none;}
  #hby-{{ sid }} .gifted{display:none;margin-top:9px;background:#E3F6EC;border:1px solid #B6E5CE;color:#046B53;
    border-radius:10px;padding:10px 12px;font-size:13px;font-weight:700;text-align:center;}
  #hby-{{ sid }} .gifted.on{display:block;}
  #hby-{{ sid }} .ship{font-size:13px;color:#565959;line-height:1.65;margin-top:13px;}
  #hby-{{ sid }} .ship b{color:#0F1111;}
  #hby-{{ sid }} .tr{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:#D5D9D9;
    border:1px solid #D5D9D9;border-radius:8px;overflow:hidden;margin-top:14px;}
  #hby-{{ sid }} .trc{background:#fff;padding:11px 9px;text-align:center;}
  #hby-{{ sid }} .trc .i{font-size:16px;line-height:1;margin-bottom:4px;}
  #hby-{{ sid }} .trc .t{font-size:11.5px;font-weight:700;line-height:1.3;}
  #hby-{{ sid }} .b1s{display:block;margin:14px auto 0;width:100%;max-width:{{ s.badge_w | default: 180 }}px;height:auto;}
</style>
  <div class="wrap">
    <div class="grid">
      <div class="gal">
        <div class="main" id="hby-mw-{{ sid }}">
          {%- if p != blank and p.images.size > 0 -%}
            <img id="hby-m-{{ sid }}" src="{{ p.images[0] | image_url: width: 1200 }}" alt="{{ p.title | escape }}" loading="eager">
          {%- endif -%}
          {%- if p != blank and p.images.size > 1 -%}
            <button class="arr l" type="button" id="hby-pv-{{ sid }}" aria-label="Previous image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <button class="arr r" type="button" id="hby-nx-{{ sid }}" aria-label="Next image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <div class="dots" id="hby-dt-{{ sid }}"></div>
          {%- endif -%}
        </div>
        {%- if p != blank and p.images.size > 1 -%}
          <div class="thumbs" id="hby-th-{{ sid }}">
            {%- for img in p.images limit: 9 -%}
              <button type="button" class="th{% if forloop.first %} on{% endif %}" data-src="{{ img | image_url: width: 1200 }}" aria-label="Image {{ forloop.index }}">
                <img src="{{ img | image_url: width: 150 }}" alt="" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="panel">
        <h1>{{ s.title }}</h1>
        <div class="rt">
          <span class="s">★★★★★</span><span>{{ s.rating | default: '4.8' }}</span>
          <a href="{{ s.reviews_anchor | default: '#reviews' }}">{{ s.review_count | default: '3,912' }} ratings</a>
        </div>

        <div class="price">
          <b>{{ s.big_price | default: '$259.99' }}</b>
          {%- if s.big_compare != blank -%}<s>{{ s.big_compare }}</s>{%- endif -%}
          {%- if s.big_badge != blank -%}<em>{{ s.big_badge }}</em>{%- endif -%}
          {%- if s.big_note != blank -%}<span class="per">{{ s.big_note }}</span>{%- endif -%}
        </div>
        <div class="insta">
          <span>4 interest-free payments of <b id="hby-in-{{ sid }}">$65.00</b> with</span>
          <span class="lg sp">Shop Pay</span>
          <span class="lg ap">afterpay</span>
        </div>

        <ul class="bl">
          {%- if s.b1 != blank -%}<li><span class="i">✓</span><span>{{ s.b1 }}</span></li>{%- endif -%}
          {%- if s.b2 != blank -%}<li><span class="i">✓</span><span>{{ s.b2 }}</span></li>{%- endif -%}
          {%- if s.b3 != blank -%}<li><span class="i">✓</span><span>{{ s.b3 }}</span></li>{%- endif -%}
        </ul>

        <div class="frame">
          <div class="fhead">
            <span>{{ s.deal_name | default: '2-FOR-1 SUMMER DEAL' }}</span>
            {%- if s.pop_label != blank -%}<span class="pop">★ {{ s.pop_label }}</span>{%- endif -%}
          </div>
          <div class="steps">
            <span><b>1.</b>{{ s.step1 | default: 'Pick your deal' }}</span>
            <span><b>2.</b>{{ s.step2 | default: 'Tap Add to cart' }}</span>
            <span><b>3.</b>{{ s.step3 | default: 'We ship it free' }}</span>
          </div>
          <div class="opts" id="hby-o-{{ sid }}">
            {%- for b in section.blocks -%}
              <button type="button" class="opt{% if forloop.first %} on{% endif %}{% if b.settings.tag != blank %} hastag{% endif %}"
                      data-id="{{ b.settings.variant_id }}"
                      data-gift="{{ b.settings.gift_variant_id }}"
                      data-giftname="{{ b.settings.gift | escape }}"
                      data-price="{{ b.settings.price }}"
                      data-compare="{{ b.settings.compare }}"
                      {{ b.shopify_attributes }}>
                {%- if b.settings.tag != blank -%}<span class="tagp" style="background:{{ b.settings.tag_bg | default: '#0F1111' }}">{{ b.settings.tag }}</span>{%- endif -%}
                <span class="dot"></span>
                {%- if b.settings.image != blank -%}
                  <span class="oim"><img src="{{ b.settings.image | image_url: width: 180 }}" alt="" loading="lazy"></span>
                {%- elsif p != blank and p.images.size > 0 -%}
                  <span class="oim"><img src="{{ p.images[0] | image_url: width: 180 }}" alt="" loading="lazy"></span>
                {%- endif -%}
                <span class="oi">
                  <span class="t">{{ b.settings.label }}</span>
                  {%- if b.settings.note != blank -%}<span class="d">{{ b.settings.note }}</span>{%- endif -%}
                  {%- if b.settings.gift != blank -%}<span class="gift">{{ b.settings.gift }}</span>{%- endif -%}
                </span>
                <span class="op">
                  {%- if b.settings.save != blank -%}<span class="sv">{{ b.settings.save }}</span>{%- endif -%}
                  <span class="n">{{ b.settings.price }}</span>
                  {%- if b.settings.compare != blank -%}<span class="o">{{ b.settings.compare }}</span>{%- endif -%}
                </span>
              </button>
            {%- endfor -%}
          </div>
        </div>

        <button class="atc" type="button" id="hby-a-{{ sid }}">{{ s.cta_text | default: 'Add to Cart' }}</button>
        <div class="xrow">
          <button class="xbtn buynow" type="button" id="hby-bn-{{ sid }}">{{ s.buynow_text | default: 'Buy now' }}</button>
          <button class="xbtn apay" type="button" id="hby-ap-{{ sid }}" aria-label="Apple Pay">
            <svg viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
            Pay
          </button>
        </div>
        <div class="gifted" id="hby-gf-{{ sid }}"></div>
        <div class="after" id="hby-af-{{ sid }}"><a href="{{ routes.cart_url }}">{{ s.after_text | default: 'Go to cart' }}</a></div>

        <div class="ship">{{ s.ship_html }}</div>

        <div class="tr">
          <div class="trc"><div class="i">🚚</div><div class="t">{{ s.t1 | default: 'Free shipping' }}</div></div>
          <div class="trc"><div class="i">↩️</div><div class="t">{{ s.t2 | default: '30-day returns' }}</div></div>
          <div class="trc"><div class="i">📦</div><div class="t">{{ s.t3 | default: 'Tracked' }}</div></div>
          <div class="trc"><div class="i">🔒</div><div class="t">{{ s.t4 | default: 'Secure checkout' }}</div></div>
        </div>
        {%- if s.badge_url != blank -%}
          <img class="b1s" src="{{ s.badge_url }}" alt="{{ s.badge_alt | default: '' | escape }}" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </div>
<script>
(function(){
  var root=document.getElementById('hby-{{ sid }}');if(!root||root.dataset.i)return;root.dataset.i='1';
  var box=document.getElementById('hby-o-{{ sid }}'),
      atc=document.getElementById('hby-a-{{ sid }}'),
      bn=document.getElementById('hby-bn-{{ sid }}'),
      ap=document.getElementById('hby-ap-{{ sid }}'),
      af=document.getElementById('hby-af-{{ sid }}'),
      gf=document.getElementById('hby-gf-{{ sid }}'),
      mw=document.getElementById('hby-mw-{{ sid }}'),
      main=document.getElementById('hby-m-{{ sid }}'),
      dots=document.getElementById('hby-dt-{{ sid }}'),
      inEl=document.getElementById('hby-in-{{ sid }}'),
      bigP=root.querySelector('.price b'),
      bigC=root.querySelector('.price s'),
      sel=box?box.querySelector('.opt.on'):null;

  /* ---------- gallery carousel ---------- */
  var th=[].slice.call(root.querySelectorAll('.thumbs .th')),
      srcs=th.map(function(t){return t.getAttribute('data-src');}),
      idx=0;
  function paintDots(){
    if(!dots)return;dots.innerHTML='';
    srcs.forEach(function(_,i){var d=document.createElement('i');if(i===idx)d.className='on';dots.appendChild(d);});
  }
  function goTo(i){
    if(!srcs.length)return;
    idx=(i+srcs.length)%srcs.length;
    if(main)main.src=srcs[idx];
    th.forEach(function(t,j){t.classList.toggle('on',j===idx);});
    paintDots();
  }
  th.forEach(function(t,i){t.addEventListener('click',function(){goTo(i);});});
  var pv=document.getElementById('hby-pv-{{ sid }}'),nx=document.getElementById('hby-nx-{{ sid }}');
  if(pv)pv.addEventListener('click',function(e){e.stopPropagation();goTo(idx-1);});
  if(nx)nx.addEventListener('click',function(e){e.stopPropagation();goTo(idx+1);});
  if(main)main.addEventListener('click',function(){goTo(idx+1);});
  if(mw){
    var x0=null;
    mw.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;},{passive:true});
    mw.addEventListener('touchend',function(e){
      if(x0===null)return;
      var dx=e.changedTouches[0].clientX-x0;x0=null;
      if(Math.abs(dx)>40){goTo(idx+(dx<0?1:-1));}
    },{passive:true});
  }
  paintDots();

  /* ---------- bundle selection ---------- */
  function readSel(){
    if(!sel)return{id:'',gift:'',name:''};
    return{id:sel.getAttribute('data-id')||'',gift:sel.getAttribute('data-gift')||'',name:sel.getAttribute('data-giftname')||''};
  }
  function items(){
    var c=readSel();if(!c.id)return null;
    var a=[{id:parseInt(c.id,10),quantity:1}];
    if(c.gift)a.push({id:parseInt(c.gift,10),quantity:1});
    return a;
  }
  function inst(ptxt){
    if(!inEl||!ptxt)return;
    var n=parseFloat(ptxt.replace(/[^0-9.]/g,''));
    if(n>0)inEl.textContent='$'+(n/4).toFixed(2);
  }
  function bc(){
    if(!sel)return;
    try{window.dispatchEvent(new CustomEvent('helios:variant',{detail:{
      id:sel.getAttribute('data-id')||'',
      price:sel.getAttribute('data-price')||'',
      compare:sel.getAttribute('data-compare')||''
    }}));}catch(e){}
  }

  if(box){
    box.addEventListener('click',function(e){
      var b=e.target.closest('.opt');if(!b)return;
      box.querySelectorAll('.opt').forEach(function(o){o.classList.remove('on');});
      b.classList.add('on');sel=b;
      var pvv=b.getAttribute('data-price'),cv=b.getAttribute('data-compare');
      if(bigP&&pvv)bigP.textContent=pvv;
      if(bigC){if(cv){bigC.textContent=cv;bigC.style.display='';}else{bigC.style.display='none';}}
      inst(pvv);
      bc();
    });
  }
  inst(bigP?bigP.textContent:'');
  setTimeout(bc,600);

  /* ---------- cart ---------- */
  function addCart(then){
    var a=items();if(!a){window.location='{{ routes.cart_url }}';return;}
    fetch('{{ routes.cart_add_url }}.js',{
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({items:a})
    }).then(function(r){return r.json();}).then(then).catch(function(){window.location='{{ routes.cart_url }}';});
  }

  var label=atc?atc.textContent:'';
  if(atc){
    atc.addEventListener('click',function(){
      atc.disabled=true;atc.textContent='Adding...';
      addCart(function(){
        var c=readSel();
        atc.classList.add('ok');atc.textContent='Added to cart';
        if(af)af.classList.add('on');
        if(gf&&c.gift){gf.textContent=(c.name||'Free gift')+' added to your cart, free';gf.classList.add('on');}
        atc.disabled=false;
        document.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}));
        setTimeout(function(){atc.classList.remove('ok');atc.textContent=label;},2600);
      });
    });
  }
  function express(btn){
    if(!btn)return;
    btn.addEventListener('click',function(){
      btn.disabled=true;
      addCart(function(){window.location='/checkout';});
    });
  }
  express(bn);express(ap);
})();
</script>
</section>
