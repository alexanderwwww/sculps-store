{%- comment -%}
  HELIOS — footer. Ink ground, one yellow action, quiet everything else.

  Rebuilt from the "deep-navy edition": that one ran a blue palette against the
  store's ink/yellow identity, floated animated bubbles behind the links, and
  set its wordmark in a font no template ever loaded. Setting and block IDs are
  unchanged, so existing template settings bind as-is.

  The signup form is Shopify's real customer form — it creates a customer
  tagged newsletter,footer-signup. No fake inputs.
{%- endcomment -%}
{%- assign sid = section.id -%}
<section class="helios" id="hft-{{ sid }}">
<style>
  #hft-{{ sid }} footer{background:#0F1111;color:#E8EDF2;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
  #hft-{{ sid }} *{box-sizing:border-box;min-width:0;}
  #hft-{{ sid }} .wrap{max-width:1180px;margin:0 auto;padding:0 var(--sp-4,21px);}
  #hft-{{ sid }} a{text-decoration:none;}

  #hft-{{ sid }} .trust{display:flex;flex-wrap:wrap;justify-content:center;
    gap:var(--sp-2,8px) var(--sp-5,34px);padding:var(--sp-4,21px) 0;
    border-bottom:1px solid rgba(255,255,255,.1);}
  #hft-{{ sid }} .trust span{display:inline-flex;align-items:center;gap:var(--sp-2,8px);
    font-size:var(--fs-xs,12.6px);font-weight:700;letter-spacing:.04em;text-transform:uppercase;
    color:rgba(232,237,242,.78);}
  #hft-{{ sid }} .trust svg{width:15px;height:15px;flex:none;color:#FFD814;}

  #hft-{{ sid }} .top{display:flex;flex-wrap:wrap;gap:var(--sp-5,34px) var(--sp-6,55px);
    padding:var(--sp-6,55px) 0 var(--sp-5,34px);}
  #hft-{{ sid }} .top > *{flex:1 1 160px;}
  #hft-{{ sid }} .brand{flex:1 1 240px;}
  #hft-{{ sid }} .nl{flex:1 1 280px;}

  #hft-{{ sid }} .logo{font-weight:900;font-size:var(--fs-md,20.4px);letter-spacing:.14em;color:#fff;}
  #hft-{{ sid }} .brand p{color:rgba(232,237,242,.62);font-size:var(--fs-sm,14.1px);
    margin:var(--sp-3,13px) 0 0;max-width:30ch;line-height:var(--lh-body,1.618);}
  #hft-{{ sid }} .brand .pos{margin-top:var(--sp-3,13px);font-weight:800;
    font-size:var(--fs-xs,12.6px);letter-spacing:.05em;color:#FFD814;}

  #hft-{{ sid }} h5{font-size:11px;letter-spacing:.13em;text-transform:uppercase;
    margin:0 0 var(--sp-3,13px);color:#fff;font-weight:800;}
  #hft-{{ sid }} ul{list-style:none;padding:0;margin:0;font-size:var(--fs-sm,14.1px);line-height:2.2;}
  #hft-{{ sid }} ul a{color:rgba(232,237,242,.66);}
  #hft-{{ sid }} ul a:hover{color:#fff;text-decoration:underline;text-underline-offset:3px;}

  #hft-{{ sid }} .nl .lead{font-weight:800;font-size:var(--fs-base,16px);color:#fff;
    line-height:var(--lh-tight,1.236);margin-bottom:4px;}
  #hft-{{ sid }} .nl .sub{font-size:var(--fs-xs,12.6px);color:rgba(232,237,242,.62);
    margin-bottom:var(--sp-3,13px);line-height:1.5;}
  #hft-{{ sid }} .nl-field{position:relative;margin-bottom:var(--sp-2,8px);}
  #hft-{{ sid }} .nl-tag{position:absolute;right:9px;top:50%;transform:translateY(-50%);
    font-size:10px;font-weight:800;background:rgba(255,216,20,.15);color:#FFD814;
    padding:3px 8px;border-radius:6px;}
  #hft-{{ sid }} .nl input{width:100%;border:1px solid rgba(255,255,255,.18);
    border-radius:var(--r-sm,8px);padding:var(--sp-3,13px) 78px var(--sp-3,13px) var(--sp-3,13px);
    font-size:var(--fs-sm,14.1px);background:rgba(255,255,255,.06);color:#fff;}
  #hft-{{ sid }} .nl input::placeholder{color:rgba(232,237,242,.45);}
  #hft-{{ sid }} .nl input:focus{outline:none;border-color:#FFD814;}
  #hft-{{ sid }} .nl-btn{width:100%;border:1px solid #FCD200;border-radius:100px;
    padding:var(--sp-3,13px);background:#FFD814;color:#0F1111;font-weight:800;
    font-size:var(--fs-sm,14.1px);cursor:pointer;margin-top:3px;font-family:inherit;}
  #hft-{{ sid }} .nl-btn:hover{background:#F7CA00;}
  #hft-{{ sid }} .nl-note{font-size:11px;color:rgba(232,237,242,.42);
    margin:var(--sp-2,8px) 0 0;line-height:1.5;}
  #hft-{{ sid }} .nl-ok{font-size:13px;color:#FFD814;font-weight:700;margin:0 0 var(--sp-2,8px);}

  #hft-{{ sid }} .foot{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;
    gap:var(--sp-3,13px);border-top:1px solid rgba(255,255,255,.1);
    padding:var(--sp-4,21px) 0 var(--sp-5,34px);}
  #hft-{{ sid }} .copy{font-size:11.5px;color:rgba(232,237,242,.42);}
  #hft-{{ sid }} .pays{display:flex;gap:6px;flex-wrap:wrap;}
  #hft-{{ sid }} .pays span{font-size:10px;font-weight:800;border:1px solid rgba(255,255,255,.16);
    border-radius:6px;padding:5px 9px;color:rgba(232,237,242,.62);}
  @media(max-width:699px){
    #hft-{{ sid }} .foot{justify-content:center;text-align:center;}
  }
</style>
<footer>
  <div class="wrap">

    <div class="trust">
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7.5" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/></svg>Free US shipping</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 3.5V8h-4.5"/></svg>30-day returns</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3l8 4.2v9.6L12 21l-8-4.2V7.2z"/><path d="M4 7.2l8 4.2 8-4.2M12 11.4V21"/></svg>Tracked delivery</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Secure checkout</span>
    </div>

    <div class="top">
      <div class="brand">
        <span class="logo">{{ section.settings.brand | default: 'HELIOS' }}</span>
        <p>{{ section.settings.tagline }}</p>
        <div class="pos">{{ section.settings.positioning | default: 'Motorized water gear, made simple.' }}</div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h5>{{ block.settings.heading }}</h5>
            <ul>
              {%- assign items = block.settings.links | newline_to_br | split: '<br />' -%}
              {%- for it in items -%}
                {%- assign parts = it | strip | split: '|' -%}
                {%- assign label = parts[0] | strip -%}
                {%- assign url = parts[1] | strip | default: '#' -%}
                {%- if label != blank -%}<li><a href="{{ url }}">{{ label }}</a></li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="nl">
        <div class="lead">{{ section.settings.nl_heading | default: 'Get up to 15% off your first order' }}</div>
        <div class="sub">{{ section.settings.nl_sub | default: 'Enter your email for 10% off — add your phone and get 15%.' }}</div>
        {%- form 'customer', id: 'helios-footer-signup' -%}
          {%- if form.posted_successfully? -%}
            <p class="nl-ok">You are in. Check your inbox for your code.</p>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter,footer-signup">
          <div class="nl-field">
            <input type="email" name="contact[email]" placeholder="Your email" required>
            <span class="nl-tag">10% OFF</span>
          </div>
          <div class="nl-field">
            <input type="tel" name="contact[phone]" placeholder="Your phone (optional)">
            <span class="nl-tag">15% OFF</span>
          </div>
          <button type="submit" class="nl-btn">Unlock my discount</button>
          <p class="nl-note">{{ section.settings.nl_note | default: 'By signing up you agree to receive emails/texts. Unsubscribe anytime.' }}</p>
        {%- endform -%}
      </div>
    </div>

    <div class="foot">
      <div class="copy">{{ section.settings.copyright | default: '© 2026 HELIOS' }}</div>
      <div class="pays"><span>VISA</span><span>MASTERCARD</span><span>AMEX</span><span>APPLE PAY</span><span>SHOP PAY</span><span>KLARNA</span><span>AFTERPAY</span></div>
    </div>

  </div>
</footer>
</section>
{% schema %}
{
  "name": "HELIOS Footer",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand", "default": "HELIOS" },
    { "type": "richtext", "id": "tagline", "label": "Tagline", "default": "<p>Built for real backyards. Tracked shipping on every order, 30-day returns, and a person who actually answers your email.</p>" },
    { "type": "text", "id": "positioning", "label": "Positioning line", "default": "Motorized water gear, made simple." },
    { "type": "text", "id": "rank_text", "label": "Rank badge (unused in this layout)" },
    { "type": "text", "id": "rating_text", "label": "Rating badge (unused in this layout)" },
    { "type": "text", "id": "nl_heading", "label": "Signup heading", "default": "Get up to 15% off your first order" },
    { "type": "text", "id": "nl_sub", "label": "Signup subtext", "default": "Enter your email for 10% off — add your phone and get 15%." },
    { "type": "text", "id": "nl_note", "label": "Signup fine print", "default": "By signing up you agree to receive emails/texts. Unsubscribe anytime." },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2026 HELIOS. All rights reserved." }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "textarea", "id": "links", "label": "Links (one per line — use Label | /url)", "default": "Super Glide | /products/helios-super-glide-motorized-water-lounger\nReviews | /#reviews\nQuestions | /#faq" }
    ]}
  ],
  "presets": [{
    "name": "HELIOS Footer",
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop", "links": "Super Glide | /products/helios-super-glide-motorized-water-lounger\nReviews | /#reviews\nQuestions | /#faq" } },
      { "type": "menu", "settings": { "heading": "Help", "links": "Track your order | /pages/track\nContact us | /pages/contact\nShipping policy | /pages/shipping-policy" } },
      { "type": "menu", "settings": { "heading": "Legal", "links": "Refund policy | /pages/refund-policy\nTerms of service | /pages/terms-of-service\nPrivacy policy | /policies/privacy-policy" } }
    ]
  }]
}
{% endschema %}
