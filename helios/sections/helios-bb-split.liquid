{%- comment -%}
  HELIOS — split band: questions on one side, a vertical customer clip on the other.

  Sits directly under the buy panel. The video slot takes an uploaded Shopify
  video, a direct .mp4 URL, or an embed (TikTok / Instagram / YouTube) — whichever
  is filled first wins, so a merchant never has to clear one field to use another.

  The clip autoplays muted and is bound to an IntersectionObserver so it does not
  eat mobile bandwidth while it is off screen. Tap unmutes.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  /* Wider desktop canvas for every helios-bb-* section. Kept here as well as in
     the utility bar so the page still uses the full screen if the bar is removed. */
  :root{--hb-maxw:1440px;}
  #hbs-{{ section.id }}{background:var(--hb-bg,#fff);padding-block:36px 44px;}
  #hbs-{{ section.id }} .lay{display:grid;gap:26px;align-items:start;}
  #hbs-{{ section.id }} .h{margin:0 0 4px;}
  #hbs-{{ section.id }} .eyebrow{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
    color:var(--hb-muted,#5F6871);margin:0 0 8px;}
  #hbs-{{ section.id }} .l{border-top:1px solid var(--hb-line-soft,#E3E7EB);margin-top:16px;}
  #hbs-{{ section.id }} details{border-bottom:1px solid var(--hb-line-soft,#E3E7EB);}
  #hbs-{{ section.id }} summary{list-style:none;cursor:pointer;padding:15px 0;display:flex;
    justify-content:space-between;gap:16px;font-size:15.5px;font-weight:600;align-items:flex-start;}
  #hbs-{{ section.id }} summary::-webkit-details-marker{display:none;}
  #hbs-{{ section.id }} summary i{flex:none;position:relative;width:14px;height:14px;margin-top:4px;}
  #hbs-{{ section.id }} summary i::before,#hbs-{{ section.id }} summary i::after{content:'';position:absolute;
    left:0;right:0;top:6px;height:2px;border-radius:2px;background:var(--hb-blue,#0046BE);}
  #hbs-{{ section.id }} summary i::after{transform:rotate(90deg);transition:transform .2s;}
  #hbs-{{ section.id }} details[open] summary i::after{transform:rotate(0);}
  #hbs-{{ section.id }} .a{padding-bottom:16px;font-size:14px;line-height:1.6;
    color:var(--hb-muted,#5F6871);max-width:70ch;}
  #hbs-{{ section.id }} .a p{margin:0 0 .6em;} #hbs-{{ section.id }} .a p:last-child{margin-bottom:0;}

  #hbs-{{ section.id }} .stage{position:relative;width:100%;max-width:420px;margin-inline:auto;
    aspect-ratio:9/16;border-radius:16px;overflow:hidden;background:#000;
    border:1px solid var(--hb-line,#C5CBD5);box-shadow:0 18px 40px rgba(29,37,44,.14);}
  #hbs-{{ section.id }} .stage video,#hbs-{{ section.id }} .stage img,
  #hbs-{{ section.id }} .stage iframe{width:100%;height:100%;object-fit:cover;display:block;border:0;}
  #hbs-{{ section.id }} .snd{position:absolute;right:12px;bottom:12px;z-index:3;border:0;cursor:pointer;
    width:40px;height:40px;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;display:grid;
    place-items:center;backdrop-filter:blur(4px);}
  #hbs-{{ section.id }} .snd svg{width:19px;height:19px;}
  #hbs-{{ section.id }} .cap{margin-top:12px;text-align:center;font-size:13px;color:var(--hb-muted,#5F6871);}
  #hbs-{{ section.id }} .cap:empty{display:none;}
  @media(min-width:900px){
    #hbs-{{ section.id }} .lay{grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:56px;}
    #hbs-{{ section.id }} .stage{max-width:none;}
  }
</style>

<div class="hb" id="hbs-{{ section.id }}">
  <div class="hb-wrap">
    <div class="lay">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="hb-h2 h">{{ s.heading }}</h2>{%- endif -%}
        <div class="l">
          {%- for b in section.blocks -%}
            <details{% if forloop.first %} open{% endif %} {{ b.shopify_attributes }}>
              <summary>{{ b.settings.q }}<i aria-hidden="true"></i></summary>
              <div class="a">{{ b.settings.a }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>

      <div>
        <div class="stage">
          {%- if s.video != blank -%}
            {{ s.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
            <button type="button" class="snd" data-snd aria-label="Unmute">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 9h3.5L12 5v14l-4.5-4H4z" fill="currentColor"/><path d="M16 9.5a4 4 0 0 1 0 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
          {%- elsif s.video_url != blank -%}
            <video src="{{ s.video_url }}" autoplay muted loop playsinline preload="metadata"
              {% if s.poster != blank %}poster="{{ s.poster | image_url: width: 900 }}"{% endif %}></video>
            <button type="button" class="snd" data-snd aria-label="Unmute">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 9h3.5L12 5v14l-4.5-4H4z" fill="currentColor"/><path d="M16 9.5a4 4 0 0 1 0 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
          {%- elsif s.embed != blank -%}
            {{ s.embed }}
          {%- elsif s.poster != blank -%}
            <img src="{{ s.poster | image_url: width: 900 }}" alt="{{ s.caption | escape }}" loading="lazy">
          {%- endif -%}
        </div>
        <p class="cap">{{ s.caption }}</p>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var r=document.getElementById('hbs-{{ section.id }}'); if(!r||r.dataset.on==='1')return; r.dataset.on='1';
  var v=r.querySelector('video'), b=r.querySelector('[data-snd]');
  if(!v)return;
  v.muted=true; v.setAttribute('playsinline','');
  if('IntersectionObserver' in window){
    /* Off-screen autoplay burns mobile data for nothing — only play what is visible. */
    new IntersectionObserver(function(es){es.forEach(function(e){
      if(e.isIntersecting){var p=v.play(); if(p&&p.catch)p.catch(function(){});} else v.pause();
    });},{threshold:.35}).observe(v);
  }
  if(b) b.addEventListener('click',function(){
    v.muted=!v.muted; b.style.opacity=v.muted?'1':'.55';
    b.setAttribute('aria-label',v.muted?'Unmute':'Mute');
    if(!v.muted){var p=v.play(); if(p&&p.catch)p.catch(function(){});}
  });
})();
</script>

{% schema %}
{
  "name": "HELIOS questions + clip",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "header", "content": "Clip (right side)" },
    { "type": "video", "id": "video", "label": "Upload a video" },
    { "type": "text", "id": "video_url", "label": "Or a direct .mp4 URL" },
    { "type": "html", "id": "embed", "label": "Or paste an embed", "info": "TikTok, Instagram or YouTube iframe. Used only if the fields above are empty." },
    { "type": "image_picker", "id": "poster", "label": "Poster / fallback image" },
    { "type": "text", "id": "caption", "label": "Caption under the clip" }
  ],
  "blocks": [{ "type": "qa", "name": "Question", "limit": 12, "settings": [
    { "type": "text", "id": "q", "label": "Question" },
    { "type": "richtext", "id": "a", "label": "Answer" }
  ]}],
  "presets": [{ "name": "HELIOS questions + clip", "blocks": [{ "type": "qa" }, { "type": "qa" }, { "type": "qa" }] }]
}
{% endschema %}
