{%- comment -%}HELIOS How It Works — Amazon-style three steps.{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
<section class="helios" id="hw-{{ sid }}">
<style>
  #hw-{{ sid }}{background:#fff;color:#0F1111;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
  #hw-{{ sid }} *{box-sizing:border-box;}
  #hw-{{ sid }} .wrap{max-width:1000px;margin:0 auto;padding:clamp(var(--sp-5,34px),4vw,var(--sp-6,55px)) var(--sp-4,21px);}
  #hw-{{ sid }} .eb{font-size:12.5px;font-weight:700;color:#565959;margin-bottom:6px;}
  #hw-{{ sid }} h2{font-size:19px;font-weight:700;letter-spacing:-.01em;line-height:1.3;margin:0 0 18px;}
  /* Equal flex basis rather than fr tracks behind a breakpoint: an ancestor
     was sizing these grids to their content instead of stretching them, which
     collapsed columns to whatever text happened to be in them. A declared
     basis splits the row evenly and wraps on its own. */
  #hw-{{ sid }} .grid{display:flex !important;flex-wrap:wrap;gap:1px;background:#D5D9D9;
    border:1px solid #D5D9D9;border-radius:8px;overflow:hidden;}
  #hw-{{ sid }} .grid > *{flex:1 1 240px;min-width:0;}

  #hw-{{ sid }} .st{background:#fff;padding:22px 20px;}
  #hw-{{ sid }} .n{width:26px;height:26px;border-radius:50%;background:#0F1111;color:#fff;
    font-size:13px;font-weight:700;display:grid;place-items:center;margin-bottom:11px;}
  #hw-{{ sid }} h3{font-size:15px;font-weight:700;margin:0 0 5px;line-height:1.35;}
  #hw-{{ sid }} p{font-size:14px;line-height:1.55;color:#565959;margin:0;}
</style>
<div class="wrap">
  {%- if s.eyebrow != blank -%}<div class="eb">{{ s.eyebrow }}</div>{%- endif -%}
  <h2>{{ s.heading }}</h2>
  <div class="grid">
    {%- assign steps = '1,2,3' | split: ',' -%}
    {%- for n in steps -%}
      {%- assign t = 'step' | append: n | append: '_title' -%}
      {%- assign d = 'step' | append: n | append: '_text' -%}
      <div class="st"><div class="n">{{ n }}</div><h3>{{ s[t] }}</h3><p>{{ s[d] }}</p></div>
    {%- endfor -%}
  </div>
</div>
</section>
{% schema %}
{
  "name": "HELIOS How It Works",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No tools, no assembly" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps. Then you're on the water." },
    { "type": "text", "id": "step1_title", "label": "Step 1 title", "default": "Inflate it" },
    { "type": "textarea", "id": "step1_text", "label": "Step 1 text", "default": "About five minutes with the nozzle in the box." },
    { "type": "text", "id": "step2_title", "label": "Step 2 title", "default": "Drop it in" },
    { "type": "textarea", "id": "step2_text", "label": "Step 2 text", "default": "Pool, lake, any calm water." },
    { "type": "text", "id": "step3_title", "label": "Step 3 title", "default": "Grab the joysticks" },
    { "type": "textarea", "id": "step3_text", "label": "Step 3 text", "default": "The motors do the work. You steer." }
  ],
  "presets": [{ "name": "HELIOS How It Works" }]
}
{% endschema %}
