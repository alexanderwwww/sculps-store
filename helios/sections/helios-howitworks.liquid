{%- comment -%}
  HELIOS — three steps. sections/helios-howitworks.liquid

  Rebuilt. The old version was three cells in a hairline grid using .wrap,
  .grid, .st and .n — names Horizon's global stylesheet also styles, so its
  utilities leaked in and the section rendered flat. Everything here is
  prefixed hw- so nothing upstream can reach it.

  Layout: separated cards with a large ghost numeral behind the content, a
  photo per step, and a connector line between them on desktop so the three
  read as a sequence rather than three unrelated boxes.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
<section class="helios" id="hw-{{ sid }}">
<style>
  #hw-{{ sid }}{background:{{ s.bg | default: '#FFFFFF' }};color:#0F1111;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
  #hw-{{ sid }} *{box-sizing:border-box;min-width:0;}
  #hw-{{ sid }} .hw-wrap{width:100%;max-width:1180px;margin:0 auto;
    padding:clamp(var(--sp-5,34px),4vw,var(--sp-6,55px)) var(--sp-4,21px);}
  #hw-{{ sid }} .hw-eb{font-size:var(--fs-xs,12.6px);font-weight:800;letter-spacing:.12em;
    text-transform:uppercase;color:#565959;margin-bottom:var(--sp-2,8px);}
  #hw-{{ sid }} .hw-h{font-size:clamp(var(--fs-lg,25.9px),3.2vw,var(--fs-xl,32.9px));font-weight:800;
    letter-spacing:-.025em;line-height:var(--lh-tight,1.236);margin:0 0 var(--sp-5,34px);max-width:22ch;}

  #hw-{{ sid }} .hw-row{display:flex;flex-wrap:wrap;gap:var(--sp-4,21px);position:relative;}
  #hw-{{ sid }} .hw-c{flex:1 1 260px;min-width:0;position:relative;background:#fff;
    border:1px solid #E1E5E5;border-radius:var(--r-md,13px);overflow:hidden;
    box-shadow:0 1px 2px rgba(15,17,17,.04);}
  #hw-{{ sid }} .hw-ph{display:block;width:100%;aspect-ratio:16/10;object-fit:cover;background:#F7FAFA;}
  #hw-{{ sid }} .hw-bd{position:relative;padding:var(--sp-4,21px);}
  /* Ghost numeral sits behind the copy, so the sequence reads at a glance
     without a numbered badge competing with the heading. */
  #hw-{{ sid }} .hw-ghost{position:absolute;top:2px;right:14px;font-size:64px;font-weight:900;
    line-height:1;color:#0F1111;opacity:.07;letter-spacing:-.05em;pointer-events:none;}
  #hw-{{ sid }} .hw-step{display:inline-flex;align-items:center;gap:7px;font-size:11px;
    font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#565959;
    margin-bottom:var(--sp-2,8px);}
  #hw-{{ sid }} .hw-dot{width:20px;height:20px;border-radius:50%;background:#0F1111;color:#fff;
    font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;
    letter-spacing:0;}
  #hw-{{ sid }} .hw-t{font-size:var(--fs-md,20.4px);font-weight:800;letter-spacing:-.02em;
    line-height:1.2;margin:0 0 6px;position:relative;}
  #hw-{{ sid }} .hw-d{font-size:var(--fs-sm,14.1px);line-height:var(--lh-body,1.618);
    color:#565959;margin:0;position:relative;}

  /* Connector between cards — decorative, hidden once they stack. */
  #hw-{{ sid }} .hw-c::after{content:'';position:absolute;top:50%;right:calc(var(--sp-4,21px) * -1);
    width:var(--sp-4,21px);height:2px;background:#E1E5E5;display:none;}
  @media(min-width:860px){
    #hw-{{ sid }} .hw-c::after{display:block;}
    #hw-{{ sid }} .hw-c:last-child::after{display:none;}
  }
  @media(prefers-reduced-motion:reduce){#hw-{{ sid }} .hw-c{box-shadow:none;}}
</style>
<div class="hw-wrap">
  {%- if s.eyebrow != blank -%}<div class="hw-eb">{{ s.eyebrow }}</div>{%- endif -%}
  {%- if s.heading != blank -%}<h2 class="hw-h">{{ s.heading }}</h2>{%- endif -%}
  <div class="hw-row">
    {%- assign steps = '1,2,3' | split: ',' -%}
    {%- for n in steps -%}
      {%- assign t = 'step' | append: n | append: '_title' -%}
      {%- assign d = 'step' | append: n | append: '_text' -%}
      {%- assign im = 'step' | append: n | append: '_image' -%}
      {%- if s[t] != blank -%}
        <div class="hw-c">
          {%- if s[im] != blank -%}
            <img class="hw-ph" src="{{ s[im] | image_url: width: 800 }}"
                 alt="{{ s[t] | escape }}" loading="lazy">
          {%- endif -%}
          <div class="hw-bd">
            <span class="hw-ghost" aria-hidden="true">{{ n }}</span>
            <span class="hw-step"><span class="hw-dot">{{ n }}</span>Step {{ n }}</span>
            <h3 class="hw-t">{{ s[t] }}</h3>
            <p class="hw-d">{{ s[d] }}</p>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
</section>
{% schema %}
{
  "name": "HELIOS How It Works",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No tools, no assembly" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps. Then you are on the water." },
    { "type": "header", "content": "Step 1" },
    { "type": "image_picker", "id": "step1_image", "label": "Photo" },
    { "type": "text", "id": "step1_title", "label": "Title", "default": "Inflate it" },
    { "type": "textarea", "id": "step1_text", "label": "Text" },
    { "type": "header", "content": "Step 2" },
    { "type": "image_picker", "id": "step2_image", "label": "Photo" },
    { "type": "text", "id": "step2_title", "label": "Title", "default": "Drop it in" },
    { "type": "textarea", "id": "step2_text", "label": "Text" },
    { "type": "header", "content": "Step 3" },
    { "type": "image_picker", "id": "step3_image", "label": "Photo" },
    { "type": "text", "id": "step3_title", "label": "Title", "default": "Grab the joysticks" },
    { "type": "textarea", "id": "step3_text", "label": "Text" }
  ],
  "presets": [{ "name": "HELIOS How It Works" }]
}
{% endschema %}
