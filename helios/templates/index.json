    "split": {
      "type": "helios-bb-split",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "How fast does it go?",
            "a": "<p>It is a cruising speed, not a jet ski — enough to move you across a pool or along a shoreline without paddling. The joystick gives you forward, reverse and spin.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "How long does the battery last?",
            "a": "<p>3–4 hours of use per charge. Runtime depends on rider weight, water conditions and how continuously you run the motors. The charger is in the box.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Do I need a pump?",
            "a": "<p>No. The inflation nozzle is included and setup takes about five minutes.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "What weight can it hold?",
            "a": "<p>Up to 300 lb. Above that the lounger still floats but the motors lose noticeable push.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "Can I use it in the sea?",
            "a": "<p>Yes, in calm and sheltered water. Rinse it with fresh water afterwards so salt does not sit on the motors. It is not built for surf or open water.</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "When will it arrive?",
            "a": "<p>7–10 business days in the US, with tracking emailed to you when it ships.</p>"
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "q": "What if I do not like it?",
            "a": "<p>Send it back within 30 days, unused and in the box, and we refund it. No forms and no return games.</p>"
          }
        }
      },
