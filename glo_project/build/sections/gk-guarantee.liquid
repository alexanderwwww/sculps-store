<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  #shopify-section-{{ section.id }} .g { font-family:'Inter',sans-serif; background:{{ section.settings.bg }}; padding:clamp(28px,4.4vw,56px) clamp(16px,3vw,44px); }
  #shopify-section-{{ section.id }} .card { max-width:820px; margin:0 auto; text-align:center; background:linear-gradient(165deg, rgba(255,255,255,0.92), rgba(224,236,244,0.8)); border:1px solid rgba(94,134,166,0.26); box-shadow:0 22px 50px rgba(46,74,104,0.12); border-radius:28px; padding:clamp(26px,4vw,48px) clamp(20px,4vw,44px); }
  #shopify-section-{{ section.id }} .seal { width:56px; height:56px; margin:0 auto 16px; border-radius:50%; background:rgba(74,190,140,0.16); border:1px solid rgba(74,190,140,0.4); display:flex; align-items:center; justify-content:center; }
  #shopify-section-{{ section.id }} .seal svg { width:28px; height:28px; stroke:#1F7A55; fill:none; stroke-width:1.8; }
  #shopify-section-{{ section.id }} .eyebrow { font-size:12.5px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#5E86A6; }
  #shopify-section-{{ section.id }} h2 { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.03em; font-size:clamp(1.6rem,3.4vw,2.4rem); margin:8px 0 12px; color:#111315; }
  #shopify-section-{{ section.id }} p { font-size:clamp(14.5px,1.6vw,16.5px); color:#4A5561; line-height:1.6; margin:0 auto; max-width:600px; }
  #shopify-section-{{ section.id }} .row { display:flex; flex-wrap:wrap; justify-content:center; gap:10px 22px; margin-top:20px; }
  #shopify-section-{{ section.id }} .row span { display:inline-flex; align-items:center; gap:7px; font-size:13px; font-weight:600; color:#2E4A68; }
  #shopify-section-{{ section.id }} .row span::before { content:"✓"; color:#1F7A55; }
</style>
<div class="g">
  <div class="card">
    <div class="seal"><svg viewBox="0 0 24 24"><path d="M12 2l2.6 1.9 3.2-.2.9 3.1 2.5 2-1.3 2.9 1.3 2.9-2.5 2-.9 3.1-3.2-.2L12 22l-2.6-1.7-3.2.2-.9-3.1-2.5-2 1.3-2.9L2.8 8.8l2.5-2 .9-3.1 3.2.2z"/><path d="M8.5 12.2l2.3 2.3 4.7-4.9"/></svg></div>
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.body }}</p>
    <div class="row">
      {%- if section.settings.point_1 != blank -%}<span>{{ section.settings.point_1 }}</span>{%- endif -%}
      {%- if section.settings.point_2 != blank -%}<span>{{ section.settings.point_2 }}</span>{%- endif -%}
      {%- if section.settings.point_3 != blank -%}<span>{{ section.settings.point_3 }}</span>{%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "GK Guarantee",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "risk-free" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "love your skin, or your money back" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "try glo at home for 30 nights. keep to the simple weekly routine and watch the regrowth slow down — if you're not seeing smoother skin, send it back for a full refund. no restocking games, no fine print. every device is also covered by a 2-year warranty." },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "30-night home trial" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "full money-back promise" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "2-year warranty" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F4F6F8" }
  ],
  "presets": [{ "name": "GK Guarantee" }]
}
{% endschema %}
