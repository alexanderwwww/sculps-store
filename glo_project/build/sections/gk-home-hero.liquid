{%- liquid
  assign img = 'https://raw.githubusercontent.com/alexanderwwww/sculps-store/1c672ae0a8a29459960bd5fd15e0aa7e94293c45/glo_project/build/assets'
  assign poster = section.settings.poster
  assign btn_link = section.settings.button_link
  if btn_link == blank
    assign btn_link = '/products/glo-ipl-device'
  endif
-%}
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} .gk-hero-v, #shopify-section-{{ section.id }} .gk-hero-v * { box-sizing:border-box; }
  #shopify-section-{{ section.id }} .gk-hero-v { font-family:'Inter',sans-serif; background:#fff; padding:clamp(16px,3vw,28px) clamp(12px,3vw,40px) clamp(6px,1vw,10px); }
  #shopify-section-{{ section.id }} .gk-hero-stage { position:relative; max-width:1440px; margin:0 auto; border-radius:clamp(18px,2.4vw,28px); overflow:hidden; aspect-ratio:16/10; background:#E9ECEF; }
  @media (max-width:749px){ #shopify-section-{{ section.id }} .gk-hero-stage { aspect-ratio:4/5; } }
  #shopify-section-{{ section.id }} .gk-hero-stage video, #shopify-section-{{ section.id }} .gk-hero-stage img.bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  #shopify-section-{{ section.id }} .gk-hero-scrim { position:absolute; inset:0; background:linear-gradient(180deg, rgba(17,19,21,0) 40%, rgba(17,19,21,0.55) 100%); }
  #shopify-section-{{ section.id }} .gk-hero-copy { position:absolute; left:0; right:0; bottom:0; padding:clamp(22px,4vw,52px); display:flex; flex-direction:column; gap:14px; align-items:flex-start; color:#fff; }
  #shopify-section-{{ section.id }} .gk-hero-copy .eyebrow { font-size:12.5px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; opacity:0.9; }
  #shopify-section-{{ section.id }} .gk-hero-copy h1 { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.04em; font-size:clamp(1.9rem,4.2vw,3.2rem); line-height:0.98; margin:0; max-width:15ch; }
  #shopify-section-{{ section.id }} .gk-hero-copy p { font-size:clamp(14px,1.5vw,17px); line-height:1.5; max-width:44ch; margin:0; opacity:0.95; }
  #shopify-section-{{ section.id }} .gk-hero-cta { display:flex; flex-wrap:wrap; align-items:center; gap:14px; margin-top:4px; }
  #shopify-section-{{ section.id }} .gk-hero-cta a.btn { background:#fff; color:#111315; border-radius:100px; padding:15px 30px; font-size:14px; font-weight:600; text-transform:lowercase; letter-spacing:-0.01em; text-decoration:none; }
  #shopify-section-{{ section.id }} .gk-hero-cta .rating { display:flex; align-items:center; gap:8px; color:#fff; font-size:13px; }
</style>

<div class="gk-hero-v">
  <div class="gk-hero-stage">
    {%- if section.settings.hero_video != blank -%}
      {{ section.settings.hero_video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'auto' }}
    {%- elsif section.settings.hero_video_url != blank -%}
      <video autoplay loop muted playsinline preload="auto" {% if poster %}poster="{{ poster | image_url: width: 1600 }}"{% else %}poster="{{ img }}/glo-hero.png"{% endif %}>
        <source src="{{ section.settings.hero_video_url }}" type="video/mp4">
      </video>
    {%- elsif poster != blank -%}
      <img class="bg" src="{{ poster | image_url: width: 1600 }}" alt="{{ section.settings.heading | escape }}">
    {%- else -%}
      <img class="bg" src="{{ img }}/glo-hero.png" alt="{{ section.settings.heading | escape }}">
    {%- endif -%}
    <div class="gk-hero-scrim"></div>
    <div class="gk-hero-copy">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
      <div class="gk-hero-cta">
        <a class="btn" href="{{ btn_link }}">{{ section.settings.button_label | default: 'shop glo' }}</a>
        {%- if section.settings.rating_text != blank -%}
          <span class="rating"><span style="letter-spacing:1px;">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ section.settings.rating_text }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GK Home Hero",
  "settings": [
    { "type": "video", "id": "hero_video", "label": "Hero video (upload your clip here)" },
    { "type": "url", "id": "hero_video_url", "label": "…or paste an external .mp4 URL" },
    { "type": "image_picker", "id": "poster", "label": "Poster / fallback image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "introducing glo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "smooth skin, on your schedule" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "salon-grade ipl hair removal, redesigned for home. quiet, cordless, and clinically shown to reduce regrowth in 4 weeks." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "shop glo — $129.99" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.8 · 1,240 reviews" }
  ],
  "presets": [{ "name": "GK Home Hero" }]
}
{% endschema %}
