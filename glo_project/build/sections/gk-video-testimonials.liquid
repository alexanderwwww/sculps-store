{%- liquid
  assign vbase = 'https://raw.githubusercontent.com/alexanderwwww/sculps-store/e3a9362a0c5c0dad78c02f5ab4b24b9064d5369e/glo_project/build/assets/vid'
-%}
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  #shopify-section-{{ section.id }} .s { font-family:'Inter',sans-serif; background:{{ section.settings.bg }}; padding:clamp(32px,4.4vw,60px) clamp(16px,3vw,44px); }
  #shopify-section-{{ section.id }} .wrap { max-width:1100px; margin:0 auto; text-align:center; }
  #shopify-section-{{ section.id }} .eyebrow { font-size:12.5px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#5E86A6; }
  #shopify-section-{{ section.id }} h2 { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.03em; font-size:clamp(1.5rem,3.4vw,2.4rem); margin:8px 0 clamp(22px,3vw,36px); color:#111315; }
  #shopify-section-{{ section.id }} .row { display:flex; flex-wrap:wrap; gap:clamp(18px,3vw,40px); justify-content:center; align-items:flex-start; }
  #shopify-section-{{ section.id }} .phone { width:clamp(220px,40vw,300px); }
  #shopify-section-{{ section.id }} .frame { position:relative; border-radius:44px; background:#0B0D0F; padding:10px; box-shadow:0 20px 50px rgba(46,74,104,0.22), inset 0 0 0 2px rgba(255,255,255,0.06); }
  #shopify-section-{{ section.id }} .screen { position:relative; border-radius:36px; overflow:hidden; aspect-ratio:9/19.5; background:#000; }
  #shopify-section-{{ section.id }} .screen video { width:100%; height:100%; object-fit:cover; display:block; }
  #shopify-section-{{ section.id }} .island { position:absolute; top:12px; left:50%; transform:translateX(-50%); width:34%; height:20px; background:#0B0D0F; border-radius:20px; z-index:3; }
  #shopify-section-{{ section.id }} .logo { position:absolute; top:34px; left:50%; transform:translateX(-50%); z-index:3; color:#fff; font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.03em; font-size:20px; text-shadow:0 1px 8px rgba(0,0,0,0.4); }
  #shopify-section-{{ section.id }} .logo img { height:22px; width:auto; display:block; filter:drop-shadow(0 1px 6px rgba(0,0,0,0.4)); }
  #shopify-section-{{ section.id }} .sound { position:absolute; right:12px; bottom:12px; z-index:4; width:38px; height:38px; border-radius:50%; background:rgba(11,13,15,0.55); backdrop-filter:blur(6px); border:1px solid rgba(255,255,255,0.25); display:flex; align-items:center; justify-content:center; cursor:pointer; }
  #shopify-section-{{ section.id }} .sound svg { width:18px; height:18px; fill:#fff; }
  #shopify-section-{{ section.id }} .tap { position:absolute; inset:0; z-index:2; cursor:pointer; }
  #shopify-section-{{ section.id }} .cap { margin-top:14px; font-size:13px; color:#5B6470; }
</style>
<div class="s">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="row">
      {%- for block in section.blocks -%}
        {%- liquid
          assign vsrc = ''
          if block.settings.video != blank
            assign vsrc = block.settings.video.sources | where: 'format', 'mp4' | first
            assign vsrc = vsrc.url
          endif
          if vsrc == blank and block.settings.video_url != blank
            assign vsrc = block.settings.video_url
          endif
          if vsrc == blank
            assign vsrc = vbase | append: '/' | append: block.settings.fallback
          endif
        -%}
        <div class="phone" {{ block.shopify_attributes }}>
          <div class="frame">
            <div class="screen" data-gk-screen>
              <div class="island"></div>
              <div class="logo">
                {%- if section.settings.logo != blank -%}<img src="{{ section.settings.logo | image_url: width: 160 }}" alt="glo">{%- else -%}{{ section.settings.logo_text | default: 'glo' }}{%- endif -%}
              </div>
              <video src="{{ vsrc }}" muted loop playsinline preload="metadata" data-gk-video></video>
              <div class="tap" data-gk-tap></div>
              <div class="sound" data-gk-sound aria-label="toggle sound">
                <svg viewBox="0 0 24 24" data-gk-muted><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 8l5 8M21 8l-5 8" stroke="#fff" stroke-width="1.8" fill="none"/></svg>
                <svg viewBox="0 0 24 24" data-gk-on style="display:none"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16.5 8.5a5 5 0 010 7" stroke="#fff" stroke-width="1.8" fill="none"/></svg>
              </div>
            </div>
          </div>
          {%- if block.settings.caption != blank -%}<div class="cap">{{ block.settings.caption }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
<script>
  (function(){
    var root = document.currentScript.parentElement;
    var screens = root.querySelectorAll('[data-gk-screen]');
    // autoplay muted when in view
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          var v = e.target.querySelector('[data-gk-video]');
          if(!v) return;
          if(e.isIntersecting){ v.play().catch(function(){}); } else { v.pause(); if(!v.muted){ v.muted = true; sync(e.target); } }
        });
      }, { threshold:0.5 });
      screens.forEach(function(s){ io.observe(s); });
    } else { screens.forEach(function(s){ var v=s.querySelector('[data-gk-video]'); if(v) v.play().catch(function(){}); }); }

    function sync(screen){
      var v = screen.querySelector('[data-gk-video]');
      screen.querySelector('[data-gk-muted]').style.display = v.muted ? '' : 'none';
      screen.querySelector('[data-gk-on]').style.display = v.muted ? 'none' : '';
    }
    function toggle(screen){
      var v = screen.querySelector('[data-gk-video]');
      // mute all others first
      screens.forEach(function(o){ if(o!==screen){ var ov=o.querySelector('[data-gk-video]'); if(ov){ ov.muted=true; sync(o);} } });
      v.muted = !v.muted;
      if(!v.muted){ v.play().catch(function(){}); }
      sync(screen);
    }
    screens.forEach(function(s){
      s.querySelector('[data-gk-tap]').addEventListener('click', function(){ toggle(s); });
      s.querySelector('[data-gk-sound]').addEventListener('click', function(ev){ ev.stopPropagation(); toggle(s); });
      sync(s);
    });
  })();
</script>
{% schema %}
{
  "name": "GK Video testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "real people, real glo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "watch them try it" },
    { "type": "image_picker", "id": "logo", "label": "Logo (overlay on screen)" },
    { "type": "text", "id": "logo_text", "label": "Logo text (if no image)", "default": "glo" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F4F6F8" }
  ],
  "blocks": [
    { "type": "screen", "name": "Phone screen", "settings": [
      { "type": "video", "id": "video", "label": "Video (upload)" },
      { "type": "url", "id": "video_url", "label": "…or paste .mp4 URL" },
      { "type": "text", "id": "fallback", "label": "Built-in fallback file", "default": "testimonial-1.mp4", "info": "testimonial-1.mp4 or testimonial-2.mp4" },
      { "type": "text", "id": "caption", "label": "Caption", "default": "tap for sound" }
    ] }
  ],
  "presets": [{ "name": "GK Video testimonials", "blocks": [
    { "type": "screen", "settings": { "fallback": "testimonial-1.mp4", "caption": "tap for sound" } },
    { "type": "screen", "settings": { "fallback": "testimonial-2.mp4", "caption": "tap for sound" } }
  ] }]
}
{% endschema %}
