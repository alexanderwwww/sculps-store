{%- liquid
  assign img = 'https://raw.githubusercontent.com/alexanderwwww/sculps-store/1c672ae0a8a29459960bd5fd15e0aa7e94293c45/glo_project/build/assets'
  assign photo = img | append: '/glo-detail-2.png'
  if section.settings.image != blank
    assign photo = section.settings.image | image_url: width: 900
  endif
  assign btn_link = section.settings.button_link | default: '/products/glo-ipl-device'
-%}
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  #{{ section.id }} .s { font-family:'Inter',sans-serif; color:#111315; background:{{ section.settings.bg }}; padding:clamp(26px,4vw,50px) clamp(16px,3vw,44px); }
  #{{ section.id }} .grid { max-width:1200px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:clamp(20px,3vw,44px); align-items:center; }
  #{{ section.id }} .media { border-radius:22px; overflow:hidden; background:#F4F6F8; aspect-ratio:1/1; }
  #{{ section.id }} .media img { width:100%; height:100%; object-fit:cover; display:block; }
  #{{ section.id }} .info { display:flex; flex-direction:column; gap:16px; }
  #{{ section.id }} .eyebrow { font-size:13px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:#3E5568; }
  #{{ section.id }} .big { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.035em; font-size:clamp(1.65rem,2.9vw,2.35rem); line-height:1; }
  #{{ section.id }} .info p { font-size:16px; color:#5B6470; line-height:1.6; max-width:460px; margin:0; }
  #{{ section.id }} .hl { display:flex; flex-direction:column; gap:9px; margin-top:2px; }
  #{{ section.id }} .hl div { display:flex; gap:10px; font-size:14.5px; } #{{ section.id }} .hl span { color:#3E5568; }
  #{{ section.id }} .buy { display:flex; align-items:center; gap:16px; margin-top:8px; }
  #{{ section.id }} .price { font-family:'General Sans',sans-serif; font-weight:700; font-size:24px; letter-spacing:-0.03em; }
  #{{ section.id }} .pill { display:inline-block; background:#111315; color:#fff; border-radius:100px; padding:15px 30px; font-size:14px; font-weight:600; text-transform:lowercase; letter-spacing:-0.01em; text-decoration:none; }
</style>
<div class="s">
  <div class="grid">
    <div class="media"><img src="{{ photo }}" alt="{{ section.settings.heading | escape }}"></div>
    <div class="info">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <div class="big">{{ section.settings.heading }}</div>
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
      {%- if section.settings.highlights != blank -%}
        <div class="hl">
          {%- assign lines = section.settings.highlights | newline_to_br | split: '<br />' -%}
          {%- for line in lines -%}{%- assign t = line | strip -%}{%- if t != blank -%}<div><span>—</span> {{ t }}</div>{%- endif -%}{%- endfor -%}
        </div>
      {%- endif -%}
      <div class="buy">
        {%- if section.settings.price != blank -%}<div class="price">{{ section.settings.price }}</div>{%- endif -%}
        <a href="{{ btn_link }}" class="pill">{{ section.settings.button_label | default: 'shop glo' }}</a>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "GK Featured product",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "the device" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "glo" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "a flash-sensing ipl handset with a rose-gold flash head, quiet motor, and a 40-minute battery — enough for a full-body session on one charge. one device, every zone, week after week." },
    { "type": "textarea", "id": "highlights", "label": "Highlights (one per line)", "default": "flash-sensing head, auto-fires on contact\n40-minute battery, full body on one charge\ncontact + contrast safety sensor, fda-cleared\nincludes precision razor & protective eyewear" },
    { "type": "text", "id": "price", "label": "Price", "default": "$179" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "shop glo" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "GK Featured product" }]
}
{% endschema %}
