<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  #shopify-section-{{ section.id }} .s { font-family:'Inter',sans-serif; background:{{ section.settings.bg }}; padding:clamp(30px,4.2vw,58px) clamp(16px,3vw,44px); }
  #shopify-section-{{ section.id }} .wrap { max-width:900px; margin:0 auto; text-align:center; }
  #shopify-section-{{ section.id }} .eyebrow { font-size:12.5px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#5E86A6; }
  #shopify-section-{{ section.id }} h2 { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.03em; font-size:clamp(1.6rem,3.6vw,2.6rem); line-height:1.05; margin:8px 0 6px; color:#111315; }
  #shopify-section-{{ section.id }} .sub { font-size:14.5px; color:#5B6470; margin:0 auto clamp(20px,3vw,30px); max-width:52ch; }
  #shopify-section-{{ section.id }} .note { position:relative; text-align:left; background:#FBFDFE; border:1px solid #DCE6EC; border-radius:20px; padding:clamp(22px,3vw,40px) clamp(20px,3vw,44px); box-shadow:0 10px 40px rgba(46,74,104,0.10); overflow:hidden; }
  #shopify-section-{{ section.id }} .note::before { content:""; position:absolute; inset:0; background-image:repeating-linear-gradient(#EAF1F6 0 31px, #CFE0EC 31px 32px); opacity:0.5; pointer-events:none; }
  #shopify-section-{{ section.id }} .note::after { content:""; position:absolute; top:0; bottom:0; left:clamp(40px,7vw,74px); width:1.5px; background:#F2C7D8; opacity:0.7; }
  #shopify-section-{{ section.id }} .note .inner { position:relative; }
  #shopify-section-{{ section.id }} .note .title { font-family:'Caveat',cursive; font-weight:700; font-size:clamp(30px,5vw,44px); color:#3E5568; line-height:1; margin-bottom:6px; }
  #shopify-section-{{ section.id }} .note .areas { font-family:'Caveat',cursive; font-weight:600; font-size:clamp(19px,3vw,24px); color:#6E7A86; margin-bottom:14px; }
  #shopify-section-{{ section.id }} .row { display:flex; align-items:baseline; gap:12px; font-family:'Caveat',cursive; padding:5px 0; }
  #shopify-section-{{ section.id }} .row .ph { font-weight:700; font-size:clamp(24px,3.6vw,32px); color:#2E4A68; min-width:clamp(120px,26vw,190px); }
  #shopify-section-{{ section.id }} .row .cad { font-weight:700; font-size:clamp(24px,3.6vw,32px); color:#C86A93; }
  #shopify-section-{{ section.id }} .row .det { font-weight:500; font-size:clamp(17px,2.6vw,22px); color:#6E7A86; margin-left:auto; text-align:right; }
  @media (max-width:600px){ #shopify-section-{{ section.id }} .row { flex-wrap:wrap; } #shopify-section-{{ section.id }} .row .det { margin-left:0; text-align:left; width:100%; } }
  #shopify-section-{{ section.id }} .btns { display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:22px; }
  #shopify-section-{{ section.id }} .btn { border-radius:100px; padding:14px 24px; font-family:'Inter',sans-serif; font-size:14px; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:9px; }
  #shopify-section-{{ section.id }} .btn-dl { background:#EDEFF2; color:#111315; border:1px solid rgba(17,19,21,0.10); }
  #shopify-section-{{ section.id }} .btn-dl:hover { background:#E4E7EB; }
  #shopify-section-{{ section.id }} .btn-save { background:#111315; color:#fff; border:none; }
  #shopify-section-{{ section.id }} .noteico { width:20px; height:20px; flex-shrink:0; }
  #shopify-section-{{ section.id }} .toast { margin-top:12px; font-size:13px; color:#1F7A55; min-height:18px; }
</style>
<div class="s">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<p class="sub">{{ section.settings.subtext }}</p>{%- endif -%}

    {%- capture plain -%}glo — treatment schedule for best results
{{ section.settings.areas }}
{% for block in section.blocks %}{{ block.settings.phase }}: {{ block.settings.cadence }} — {{ block.settings.detail }}
{% endfor %}tip: shave & wipe dry before each session, finish with cooling aloe gel.{%- endcapture -%}

    <div class="note" id="gk-note-{{ section.id }}">
      <div class="inner">
        <div class="title">{{ section.settings.note_title }}</div>
        {%- if section.settings.areas != blank -%}<div class="areas">{{ section.settings.areas }}</div>{%- endif -%}
        {%- for block in section.blocks -%}
          <div class="row" {{ block.shopify_attributes }}>
            <span class="ph">{{ block.settings.phase }}</span>
            <span class="cad">{{ block.settings.cadence }}</span>
            <span class="det">{{ block.settings.detail }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="btns">
      <button class="btn btn-dl" type="button" data-gk-dl data-file="{{ section.settings.file_name | default: 'glo-schedule' }}">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3v12"/><path d="M7 11l5 5 5-5"/><path d="M4 20h16"/></svg>
        {{ section.settings.dl_label | default: 'download image' }}
      </button>
      <button class="btn btn-save" type="button" data-gk-save data-text="{{ plain | escape }}" data-file="{{ section.settings.file_name | default: 'glo-schedule' }}">
        <svg class="noteico" viewBox="0 0 24 24"><rect x="1.5" y="1.5" width="21" height="21" rx="5" fill="#fff"/><path d="M1.5 6.5a5 5 0 015-5h11a5 5 0 015 5v0h-21z" fill="#FFD84D"/><rect x="1.5" y="6" width="21" height="1.6" fill="#FFD84D"/><line x1="5.5" y1="12" x2="18.5" y2="12" stroke="#C9CDD2" stroke-width="1.4"/><line x1="5.5" y1="15.5" x2="18.5" y2="15.5" stroke="#C9CDD2" stroke-width="1.4"/><line x1="5.5" y1="19" x2="13" y2="19" stroke="#C9CDD2" stroke-width="1.4"/></svg>
        {{ section.settings.button_label | default: 'save to your notes' }}
      </button>
    </div>
    <div class="toast" data-gk-toast></div>
  </div>
</div>
<script>
  (function(){
    var root = document.getElementById('gk-note-{{ section.id }}').closest('.s');
    var toast = root.querySelector('[data-gk-toast]');

    // SAVE TO NOTES (share sheet -> Notes, or clipboard + txt download)
    var saveBtn = root.querySelector('[data-gk-save]');
    saveBtn.addEventListener('click', async function(){
      var text = saveBtn.getAttribute('data-text');
      var name = (saveBtn.getAttribute('data-file') || 'glo-schedule') + '.txt';
      var file = new File([text], name, { type:'text/plain' });
      if (navigator.canShare && navigator.canShare({ files:[file] })) {
        try { await navigator.share({ files:[file], title:'glo schedule' }); return; } catch(e){}
      }
      try { await navigator.clipboard.writeText(text); if(toast) toast.textContent = 'copied — open Notes and paste ✓'; } catch(e){}
      var url = URL.createObjectURL(new Blob([text], { type:'text/plain' }));
      var a = document.createElement('a'); a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);
    });

    // DOWNLOAD IMAGE (render the note to a PNG via canvas)
    var dlBtn = root.querySelector('[data-gk-dl]');
    dlBtn.addEventListener('click', function(){
      var note = document.getElementById('gk-note-{{ section.id }}');
      var rows = [].map.call(note.querySelectorAll('.row'), function(r){
        return { ph: r.querySelector('.ph').textContent, cad: r.querySelector('.cad').textContent, det: r.querySelector('.det').textContent };
      });
      var title = note.querySelector('.title').textContent;
      var areas = (note.querySelector('.areas') || {}).textContent || '';
      var draw = function(){
        var W=1080, pad=72, lh=104, top=150;
        var H = top + 90 + rows.length*(lh+40) + 90;
        var c=document.createElement('canvas'); c.width=W; c.height=H;
        var x=c.getContext('2d');
        x.fillStyle='#FBFDFE'; x.fillRect(0,0,W,H);
        // lines
        x.strokeStyle='#CFE0EC'; x.lineWidth=1;
        for(var y=top; y<H-40; y+=lh){ x.beginPath(); x.moveTo(0,y); x.lineTo(W,y); x.stroke(); }
        // pink margin
        x.strokeStyle='#F2C7D8'; x.lineWidth=2; x.beginPath(); x.moveTo(pad+40,0); x.lineTo(pad+40,H); x.stroke();
        var lx = pad+70;
        x.textBaseline='alphabetic';
        x.fillStyle='#3E5568'; x.font="700 64px Caveat, cursive"; x.fillText(title, lx, 96);
        x.fillStyle='#6E7A86'; x.font="600 36px Caveat, cursive"; x.fillText(areas, lx, 150);
        var yy=top+80;
        rows.forEach(function(r){
          x.fillStyle='#2E4A68'; x.font="700 48px Caveat, cursive"; x.fillText(r.ph, lx, yy);
          x.fillStyle='#C86A93'; x.font="700 48px Caveat, cursive"; x.fillText(r.cad, lx+340, yy);
          x.fillStyle='#6E7A86'; x.font="500 32px Caveat, cursive"; x.fillText(r.det, lx, yy+44);
          yy += lh+40;
        });
        c.toBlob(function(blob){
          var url=URL.createObjectURL(blob);
          var a=document.createElement('a'); a.href=url; a.download=(dlBtn.getAttribute('data-file')||'glo-schedule')+'.png';
          document.body.appendChild(a); a.click(); a.remove();
          setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);
          if(toast) toast.textContent='image downloaded ✓';
        });
      };
      if (document.fonts && document.fonts.load) {
        Promise.all([document.fonts.load('700 48px Caveat'), document.fonts.load('600 36px Caveat')]).then(draw).catch(draw);
      } else { draw(); }
    });
  })();
</script>
{% schema %}
{
  "name": "GK Schedule",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "the glo protocol" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "for best results, follow exactly this schedule" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "consistency is everything with ipl. here's the exact cadence our best results followed — save it straight to your notes." },
    { "type": "text", "id": "note_title", "label": "Note title", "default": "glo schedule ✨" },
    { "type": "text", "id": "areas", "label": "Areas line", "default": "face · underarms · arms · legs · bikini" },
    { "type": "text", "id": "dl_label", "label": "Download button label", "default": "download image" },
    { "type": "text", "id": "button_label", "label": "Save button label", "default": "save to your notes" },
    { "type": "text", "id": "file_name", "label": "Download file name", "default": "glo-schedule" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    { "type": "line", "name": "Schedule line", "settings": [
      { "type": "text", "id": "phase", "label": "Phase", "default": "weeks 1–4" },
      { "type": "text", "id": "cadence", "label": "Cadence", "default": "once a week" },
      { "type": "text", "id": "detail", "label": "Detail", "default": "start at a comfortable level, build up each session" }
    ] }
  ],
  "presets": [{ "name": "GK Schedule", "blocks": [
    { "type": "line", "settings": { "phase": "weeks 1–4", "cadence": "once a week", "detail": "start low, build up each session" } },
    { "type": "line", "settings": { "phase": "weeks 5–8", "cadence": "every 2 weeks", "detail": "hair grows back finer & slower" } },
    { "type": "line", "settings": { "phase": "week 9+", "cadence": "once a month", "detail": "quick touch-ups to stay smooth" } }
  ] }]
}
{% endschema %}
