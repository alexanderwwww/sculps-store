{%- liquid
  assign img = 'https://raw.githubusercontent.com/alexanderwwww/sculps-store/1c672ae0a8a29459960bd5fd15e0aa7e94293c45/glo_project/build/assets'
  assign photo = img | append: '/glo-detail-4.png'
  if section.settings.image != blank
    assign photo = section.settings.image | image_url: width: 1400
  endif
  assign btn_link = section.settings.button_link | default: '/products/glo-ipl-device'
-%}
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  #shopify-section-{{ section.id }} .wrap { font-family:'Inter',sans-serif; padding:clamp(8px,2vw,20px) clamp(12px,3vw,40px) clamp(26px,4vw,46px); }
  #shopify-section-{{ section.id }} .eyebrow { font-size:13px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:#3E5568; }
  #shopify-section-{{ section.id }} h2 { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.035em; font-size:clamp(1.35rem,2.3vw,1.95rem); margin:0; color:#fff; }
  #shopify-section-{{ section.id }} .pill-ghost { display:inline-block; background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,0.8); border-radius:100px; padding:14px 28px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; text-decoration:none; }

  /* overlay layout */
  #shopify-section-{{ section.id }} .stage { position:relative; max-width:1200px; margin:0 auto; border-radius:26px; overflow:hidden; min-height:clamp(300px,42vw,440px); display:flex; align-items:flex-end; }
  #shopify-section-{{ section.id }} .stage img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  #shopify-section-{{ section.id }} .stage .scrim { position:absolute; inset:0; background:linear-gradient(180deg,rgba(17,19,21,0.05) 30%,rgba(17,19,21,0.6) 100%); }
  #shopify-section-{{ section.id }} .stage .copy { position:relative; padding:clamp(22px,4vw,48px); color:#fff; display:flex; flex-direction:column; gap:14px; align-items:flex-start; max-width:620px; }
  #shopify-section-{{ section.id }} .copy p { font-size:15px; line-height:1.6; opacity:0.95; margin:0; max-width:46ch; }

  /* split layout */
  #shopify-section-{{ section.id }} .split { max-width:1200px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); background:#111315; border-radius:28px; overflow:hidden; }
  #shopify-section-{{ section.id }} .split img { width:100%; height:100%; min-height:340px; object-fit:cover; display:block; }
  #shopify-section-{{ section.id }} .split .copy { display:flex; flex-direction:column; justify-content:center; gap:16px; padding:clamp(28px,5vw,64px); color:#F4F6F8; }
  #shopify-section-{{ section.id }} .split .copy p { font-size:15.5px; color:#9AA2AC; line-height:1.6; max-width:420px; margin:0; }
</style>
<div class="wrap">
  {%- if section.settings.layout == 'split' -%}
    <div class="split">
      <img src="{{ photo }}" alt="{{ section.settings.heading | escape }}">
      <div class="copy">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}<a href="{{ btn_link }}" class="pill-ghost">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
    </div>
  {%- else -%}
    <div class="stage">
      <img src="{{ photo }}" alt="{{ section.settings.heading | escape }}">
      <div class="scrim"></div>
      <div class="copy">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow" style="color:#fff;opacity:0.9;">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}<a href="{{ btn_link }}" class="pill-ghost">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "GK Editorial block",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "overlay", "label": "Image with overlay text" }, { "value": "split", "label": "Image + text side by side (dark)" } ], "default": "overlay" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "the technology" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "engineered like a beauty tool. tested like a medical device." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "a contact + contrast sensor reads your skin before every flash, so glo only fires when it's safe to. fda-cleared, dermatologist-tested, and quiet enough for a sunday morning." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "shop glo" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "GK Editorial block" }]
}
{% endschema %}
