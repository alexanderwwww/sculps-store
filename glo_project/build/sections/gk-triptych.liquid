{%- liquid
  assign img = 'https://raw.githubusercontent.com/alexanderwwww/sculps-store/1c672ae0a8a29459960bd5fd15e0aa7e94293c45/glo_project/build/assets'
  assign fallbacks = 'glo-detail-1.png,glo-detail-5.png,glo-detail-9.png' | split: ','
-%}
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  #{{ section.id }} .s { font-family:'Inter',sans-serif; background:{{ section.settings.bg }}; padding:clamp(30px,4.2vw,58px) clamp(16px,3vw,44px); }
  #{{ section.id }} .wrap { max-width:1200px; margin:0 auto; }
  #{{ section.id }} .head { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:clamp(20px,3vw,32px); }
  #{{ section.id }} .head h2 { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.035em; font-size:clamp(1.35rem,2.3vw,1.95rem); margin:0; }
  #{{ section.id }} .head a { font-size:14px; font-weight:600; color:#111315; border-bottom:1px solid #111315; text-decoration:none; }
  #{{ section.id }} .g { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(10px,2vw,22px); }
  @media (max-width:640px){ #{{ section.id }} .g { grid-template-columns:1fr; } }
  #{{ section.id }} .card { background:#F4F6F8; border-radius:20px; overflow:hidden; }
  #{{ section.id }} .card .im { aspect-ratio:1/1; } #{{ section.id }} .card img { width:100%; height:100%; object-fit:cover; display:block; }
  #{{ section.id }} .card .cap { padding:16px 18px; font-family:'General Sans',sans-serif; font-weight:600; text-transform:lowercase; letter-spacing:-0.02em; font-size:16px; }
</style>
<div class="s">
  <div class="wrap">
    <div class="head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link_url | default: '/products/glo-ipl-device' }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="g">
      {%- for block in section.blocks -%}
        {%- assign photo = fallbacks[forloop.index0] | default: 'glo-detail-1.png' -%}
        {%- assign src = img | append: '/' | append: photo -%}
        {%- if block.settings.image != blank -%}{%- assign src = block.settings.image | image_url: width: 700 -%}{%- endif -%}
        <div class="card" {{ block.shopify_attributes }}>
          <div class="im"><img src="{{ src }}" alt="{{ block.settings.caption | escape }}"></div>
          <div class="cap">{{ block.settings.caption }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "GK Triptych",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "everything in the box" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "see all photos" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    { "type": "item", "name": "Image card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "caption", "label": "Caption", "default": "the full kit" }
    ] }
  ],
  "presets": [{ "name": "GK Triptych", "blocks": [
    { "type": "item", "settings": { "caption": "the full kit" } },
    { "type": "item", "settings": { "caption": "flash caps" } },
    { "type": "item", "settings": { "caption": "the unboxing" } }
  ] }]
}
{% endschema %}
