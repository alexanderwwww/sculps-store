<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  #shopify-section-{{ section.id }} .s { font-family:'Inter',sans-serif; background:{{ section.settings.bg }}; padding:clamp(30px,4.2vw,58px) 0; overflow:hidden; }
  #shopify-section-{{ section.id }} .head { max-width:1200px; margin:0 auto clamp(18px,2.4vw,28px); padding:0 clamp(16px,3vw,44px); display:flex; align-items:flex-end; justify-content:space-between; gap:16px; flex-wrap:wrap; }
  #shopify-section-{{ section.id }} .eyebrow { font-size:12.5px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#5E86A6; }
  #shopify-section-{{ section.id }} h2 { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.03em; font-size:clamp(1.5rem,3.2vw,2.3rem); margin:8px 0 0; color:#111315; }
  #shopify-section-{{ section.id }} .nav { display:flex; gap:8px; }
  #shopify-section-{{ section.id }} .nav button { width:40px; height:40px; border-radius:50%; border:1px solid rgba(17,19,21,0.12); background:rgba(255,255,255,0.6); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); cursor:pointer; display:flex; align-items:center; justify-content:center; }
  #shopify-section-{{ section.id }} .nav svg { width:18px; height:18px; stroke:#111315; }
  #shopify-section-{{ section.id }} .track { display:flex; gap:clamp(12px,1.6vw,20px); overflow-x:auto; scroll-snap-type:x mandatory; padding:6px clamp(16px,3vw,44px) 10px; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
  #shopify-section-{{ section.id }} .track::-webkit-scrollbar { display:none; }
  #shopify-section-{{ section.id }} .card { scroll-snap-align:start; flex:0 0 clamp(280px,80vw,360px); background:linear-gradient(160deg, rgba(255,255,255,0.85), rgba(234,241,246,0.65)); border:1px solid rgba(255,255,255,0.9); box-shadow:0 2px 6px rgba(46,74,104,0.05), 0 22px 50px rgba(46,74,104,0.10); backdrop-filter:blur(16px) saturate(160%); -webkit-backdrop-filter:blur(16px) saturate(160%); border-radius:24px; padding:22px; display:flex; flex-direction:column; gap:14px; }
  #shopify-section-{{ section.id }} .card .top { display:flex; align-items:center; gap:12px; }
  #shopify-section-{{ section.id }} .card .av { width:46px; height:46px; border-radius:50%; object-fit:cover; background:#DCE6EC; flex:0 0 auto; display:flex; align-items:center; justify-content:center; font-family:'General Sans',sans-serif; font-weight:700; color:#5E86A6; }
  #shopify-section-{{ section.id }} .card .who { display:flex; flex-direction:column; }
  #shopify-section-{{ section.id }} .card .nm { font-size:14px; font-weight:700; color:#111315; }
  #shopify-section-{{ section.id }} .card .dt { font-size:12px; color:#5B6470; }
  #shopify-section-{{ section.id }} .card .vf { margin-left:auto; font-size:11px; font-weight:600; color:#1F7A55; }
  #shopify-section-{{ section.id }} .card .stars { color:#3E5568; font-size:16px; letter-spacing:2px; }
  #shopify-section-{{ section.id }} .card .body { font-size:15px; line-height:1.55; color:#111315; }
  #shopify-section-{{ section.id }} .card .photo { border-radius:14px; width:100%; aspect-ratio:4/3; object-fit:cover; }
</style>
<div class="s">
  <div class="head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="nav">
      <button type="button" data-gk-prev aria-label="previous"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button type="button" data-gk-next aria-label="next"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
  </div>
  <div class="track" data-gk-track>
    {%- for block in section.blocks -%}
      {%- assign r = block.settings.stars | plus: 0 -%}
      {%- assign initial = block.settings.name | strip | slice: 0 -%}
      <div class="card" {{ block.shopify_attributes }}>
        <div class="top">
          {%- if block.settings.avatar != blank -%}<img class="av" src="{{ block.settings.avatar | image_url: width: 120 }}" alt="">{%- else -%}<span class="av">{{ initial | upcase }}</span>{%- endif -%}
          <div class="who"><span class="nm">{{ block.settings.name }}</span><span class="dt">{{ block.settings.date }}</span></div>
          {%- if block.settings.verified -%}<span class="vf">✓ verified</span>{%- endif -%}
        </div>
        <div class="stars">{% for i in (1..5) %}{% if i <= r %}&#9733;{% else %}&#9734;{% endif %}{% endfor %}</div>
        <div class="body">{{ block.settings.text }}</div>
        {%- if block.settings.photo != blank -%}<img class="photo" src="{{ block.settings.photo | image_url: width: 700 }}" alt="">{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
<script>
  (function(){
    var root = document.getElementById('shopify-section-{{ section.id }}');
    var track = root.querySelector('[data-gk-track]');
    function step(){ var card = track.querySelector('.card'); return card ? card.offsetWidth + 20 : 320; }
    root.querySelector('[data-gk-prev]').addEventListener('click', function(){ track.scrollBy({ left:-step(), behavior:'smooth' }); });
    root.querySelector('[data-gk-next]').addEventListener('click', function(){ track.scrollBy({ left:step(), behavior:'smooth' }); });
  })();
</script>
{% schema %}
{
  "name": "GK Review carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "loved by thousands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "4.8 stars · 1,240 reviews" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F4F6F8" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "image_picker", "id": "avatar", "label": "Avatar (optional)" },
      { "type": "text", "id": "name", "label": "Name", "default": "jenna r." },
      { "type": "text", "id": "date", "label": "Date", "default": "2 weeks ago" },
      { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "checkbox", "id": "verified", "label": "Verified", "default": true },
      { "type": "textarea", "id": "text", "label": "Review", "default": "genuinely works. quiet, fast, and it doesn't hurt." },
      { "type": "image_picker", "id": "photo", "label": "Photo (optional)" }
    ] }
  ],
  "presets": [{ "name": "GK Review carousel", "blocks": [
    { "type": "review", "settings": { "name": "jenna r.", "date": "2 weeks ago", "stars": 5, "text": "shipped in 2 days and it genuinely works. quiet, fast, and i actually keep up with it because it doesn't hurt at all." } },
    { "type": "review", "settings": { "name": "monique t.", "date": "1 month ago", "stars": 5, "text": "four weeks in and my underarms are basically maintenance-only now. the flash sensor makes it foolproof." } },
    { "type": "review", "settings": { "name": "ava l.", "date": "3 weeks ago", "stars": 4, "text": "arrived fast, didn't hurt, good results on my legs. coarser hair took a little longer but so worth it." } },
    { "type": "review", "settings": { "name": "priya n.", "date": "2 months ago", "stars": 5, "text": "i do my whole body while watching tv. cancelled my salon appointments and it already paid for itself." } },
    { "type": "review", "settings": { "name": "daniela r.", "date": "5 weeks ago", "stars": 5, "text": "followed the schedule exactly and by week 4 the difference was unreal. soothing gel after and zero irritation." } },
    { "type": "review", "settings": { "name": "sophie k.", "date": "3 days ago", "stars": 5, "text": "face, underarms, legs — one device does it all, and it looks so premium on my counter." } }
  ] }]
}
{% endschema %}
