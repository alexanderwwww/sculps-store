<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  #shopify-section-{{ section.id }} .s { font-family:'Inter',sans-serif; background:{{ section.settings.bg }}; padding:clamp(34px,4.6vw,64px) 0 clamp(26px,3.4vw,44px); overflow:hidden; }
  #shopify-section-{{ section.id }} .head { max-width:900px; margin:0 auto clamp(20px,2.6vw,32px); padding:0 clamp(16px,3vw,44px); text-align:center; }
  #shopify-section-{{ section.id }} .eyebrow { font-size:12.5px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:#5E86A6; }
  #shopify-section-{{ section.id }} h2 { font-family:'General Sans',sans-serif; font-weight:700; letter-spacing:-0.02em; font-size:clamp(1.7rem,4.2vw,2.9rem); line-height:1.03; margin:10px 0 10px; color:#111315; }
  #shopify-section-{{ section.id }} .rate { display:inline-flex; align-items:center; gap:8px; font-size:14px; color:#5B6470; }
  #shopify-section-{{ section.id }} .rate .stars { color:#F5A623; font-size:16px; letter-spacing:1px; }
  #shopify-section-{{ section.id }} .rate b { color:#111315; }
  #shopify-section-{{ section.id }} .track { display:flex; gap:clamp(12px,1.6vw,20px); overflow-x:auto; scroll-snap-type:x mandatory; padding:8px clamp(16px,3vw,44px) 6px; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
  #shopify-section-{{ section.id }} .track::-webkit-scrollbar { display:none; }
  #shopify-section-{{ section.id }} .card { scroll-snap-align:center; flex:0 0 clamp(268px,82vw,340px); background:linear-gradient(165deg, rgba(255,255,255,0.9), rgba(234,241,246,0.7)); border:1px solid rgba(255,255,255,0.9); box-shadow:0 2px 6px rgba(46,74,104,0.05), 0 26px 56px rgba(46,74,104,0.12); backdrop-filter:blur(18px) saturate(160%); -webkit-backdrop-filter:blur(18px) saturate(160%); border-radius:26px; overflow:hidden; display:flex; flex-direction:column; }
  #shopify-section-{{ section.id }} .card .photo { width:100%; aspect-ratio:1/1; object-fit:cover; display:block; background:#DCE6EC; }
  #shopify-section-{{ section.id }} .card .body { padding:18px; display:flex; flex-direction:column; gap:12px; }
  #shopify-section-{{ section.id }} .card .r1 { display:flex; align-items:center; justify-content:space-between; }
  #shopify-section-{{ section.id }} .card .stars { color:#F5A623; font-size:16px; letter-spacing:2px; }
  #shopify-section-{{ section.id }} .card .vf { font-size:12px; font-weight:600; color:#1F7A55; background:rgba(31,122,85,0.10); border-radius:100px; padding:4px 10px; }
  #shopify-section-{{ section.id }} .card .tx { font-size:15px; line-height:1.5; color:#111315; }
  #shopify-section-{{ section.id }} .card .who { display:flex; align-items:center; gap:11px; }
  #shopify-section-{{ section.id }} .card .av { width:40px; height:40px; border-radius:50%; object-fit:cover; background:#5E86A6; color:#fff; display:flex; align-items:center; justify-content:center; font-family:'General Sans',sans-serif; font-weight:700; flex:0 0 auto; }
  #shopify-section-{{ section.id }} .card .nm { font-size:13.5px; font-weight:700; color:#111315; }
  #shopify-section-{{ section.id }} .card .dt { font-size:12px; color:#5B6470; }
  #shopify-section-{{ section.id }} .dots { display:flex; gap:7px; justify-content:center; margin-top:clamp(16px,2vw,22px); }
  #shopify-section-{{ section.id }} .dots button { width:8px; height:8px; border-radius:100px; border:none; background:#C6D2DC; cursor:pointer; padding:0; transition:width .25s, background .25s; }
  #shopify-section-{{ section.id }} .dots button.on { width:22px; background:#3E5568; }
  #shopify-section-{{ section.id }} .foot { text-align:center; margin-top:clamp(16px,2vw,22px); font-size:12.5px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:#5E86A6; }
</style>
<div class="s">
  <div class="head">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.rating_text != blank -%}<div class="rate"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <span>{{ section.settings.rating_text }}</span></div>{%- endif -%}
  </div>
  <div class="track" data-gk-track>
    {%- for block in section.blocks -%}
      {%- assign r = block.settings.stars | plus: 0 -%}
      {%- assign initial = block.settings.name | strip | slice: 0 -%}
      <div class="card" data-gk-card {{ block.shopify_attributes }}>
        {%- if block.settings.photo != blank -%}<img class="photo" src="{{ block.settings.photo | image_url: width: 700 }}" alt="">{%- endif -%}
        <div class="body">
          <div class="r1">
            <span class="stars">{% for i in (1..5) %}{% if i <= r %}&#9733;{% else %}&#9734;{% endif %}{% endfor %}</span>
            {%- if block.settings.verified -%}<span class="vf">&#10003; Verified</span>{%- endif -%}
          </div>
          <div class="tx">{{ block.settings.text }}</div>
          <div class="who">
            {%- if block.settings.avatar != blank -%}<img class="av" src="{{ block.settings.avatar | image_url: width: 100 }}" alt="">{%- else -%}<span class="av">{{ initial | upcase }}</span>{%- endif -%}
            <div><div class="nm">{{ block.settings.name }}</div><div class="dt">{{ block.settings.date }}</div></div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  <div class="dots" data-gk-dots></div>
  {%- if section.settings.footer_text != blank -%}<div class="foot">{{ section.settings.footer_text }}</div>{%- endif -%}
</div>
<script>
  (function(){
    var root = document.getElementById('shopify-section-{{ section.id }}');
    var track = root.querySelector('[data-gk-track]');
    var cards = root.querySelectorAll('[data-gk-card]');
    var dotsWrap = root.querySelector('[data-gk-dots]');
    if(!track || !cards.length) return;
    cards.forEach(function(_,i){
      var b=document.createElement('button'); b.type='button'; if(i===0) b.className='on';
      b.addEventListener('click', function(){ track.scrollTo({ left: cards[i].offsetLeft - track.offsetLeft, behavior:'smooth' }); });
      dotsWrap.appendChild(b);
    });
    var dots = dotsWrap.querySelectorAll('button');
    track.addEventListener('scroll', function(){
      var mid = track.scrollLeft + track.clientWidth/2, best=0, bd=1e9;
      cards.forEach(function(c,i){ var cc=c.offsetLeft - track.offsetLeft + c.offsetWidth/2; var d=Math.abs(cc-mid); if(d<bd){bd=d;best=i;} });
      dots.forEach(function(d,i){ d.classList.toggle('on', i===best); });
    }, { passive:true });
  })();
</script>
{% schema %}
{
  "name": "GK Review carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "see what our customers say" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "loved by thousands of women" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.8 · 1,240 reviews" },
    { "type": "text", "id": "footer_text", "label": "Footer text", "default": "loved on tiktok" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F4F6F8" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "image_picker", "id": "photo", "label": "Photo (top of card)" },
      { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "checkbox", "id": "verified", "label": "Verified", "default": true },
      { "type": "textarea", "id": "text", "label": "Review", "default": "arrived so fast and it genuinely works. i'm obsessed." },
      { "type": "image_picker", "id": "avatar", "label": "Avatar (optional)" },
      { "type": "text", "id": "name", "label": "Name", "default": "jenna r." },
      { "type": "text", "id": "date", "label": "Date", "default": "june 23, 2026" }
    ] }
  ],
  "presets": [{ "name": "GK Review carousel", "blocks": [
    { "type": "review", "settings": { "stars": 5, "text": "shipped in 5 days and it genuinely works. doesn't hurt at all — i actually keep up with it.", "name": "jenna r.", "date": "june 23, 2026" } },
    { "type": "review", "settings": { "stars": 5, "text": "four weeks in and my underarms are basically maintenance-only now. the flash sensor is foolproof.", "name": "monique t.", "date": "june 10, 2026" } },
    { "type": "review", "settings": { "stars": 5, "text": "cancelled my salon appointments. i do my whole body while watching tv and it paid for itself.", "name": "priya n.", "date": "may 28, 2026" } },
    { "type": "review", "settings": { "stars": 4, "text": "arrived fast, didn't hurt, great on my legs. coarser hair took a little longer but so worth it.", "name": "ava l.", "date": "may 19, 2026" } },
    { "type": "review", "settings": { "stars": 5, "text": "followed the schedule exactly and by week 4 the difference was unreal. zero irritation with the gel after.", "name": "daniela r.", "date": "may 5, 2026" } },
    { "type": "review", "settings": { "stars": 5, "text": "face, underarms, legs — one device does it all and looks so premium on my counter.", "name": "sophie k.", "date": "april 30, 2026" } }
  ] }]
}
{% endschema %}
