{%- liquid
  assign img = 'https://raw.githubusercontent.com/alexanderwwww/sculps-store/1c672ae0a8a29459960bd5fd15e0aa7e94293c45/glo_project/build/assets'
  assign p_url = '/products/glo-ipl-device'
-%}
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .gk-hb, .gk-hb * { box-sizing:border-box; }
  .gk-hb { font-family:'Inter',sans-serif; color:#111315; background:#fff; }
  .gk-hb a { text-decoration:none; }
  .gk-hb .wrap { max-width:1200px; margin:0 auto; }
  .gk-hb .eyebrow { font-size:13px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:#3E5568; }
  .gk-hb h2 { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.035em; font-size:clamp(1.35rem,2.3vw,1.95rem); margin:0; }
  .gk-hb .pill { display:inline-block; background:#111315; color:#fff; border-radius:100px; padding:15px 30px; font-size:14px; font-weight:600; text-transform:lowercase; letter-spacing:-0.01em; }
  .gk-hb .pill-ghost { display:inline-block; background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,0.8); border-radius:100px; padding:14px 28px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; }
  .gk-hb .pill-outline { display:inline-block; background:transparent; color:#111315; border:1.5px solid #111315; border-radius:100px; padding:13px 26px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; }

  /* label divider */
  .gk-label { text-align:center; padding:clamp(26px,4vw,40px) 20px; font-family:'General Sans',sans-serif; font-weight:600; text-transform:lowercase; letter-spacing:-0.01em; font-size:clamp(15px,2vw,20px); color:#5B6470; }

  /* featured */
  .gk-feat { padding:clamp(26px,4vw,50px) clamp(16px,3vw,44px); }
  .gk-feat .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:clamp(20px,3vw,44px); align-items:center; }
  .gk-feat .media { border-radius:22px; overflow:hidden; background:#F4F6F8; aspect-ratio:1/1; }
  .gk-feat .media img { width:100%; height:100%; object-fit:cover; display:block; }
  .gk-feat .info { display:flex; flex-direction:column; gap:16px; }
  .gk-feat .info .big { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.035em; font-size:clamp(1.65rem,2.9vw,2.35rem); line-height:1; }
  .gk-feat .info p { font-size:16px; color:#5B6470; line-height:1.6; max-width:460px; margin:0; }
  .gk-feat .hl { display:flex; flex-direction:column; gap:9px; margin-top:2px; }
  .gk-feat .hl div { display:flex; gap:10px; font-size:14.5px; } .gk-feat .hl span { color:#3E5568; }
  .gk-feat .buy { display:flex; align-items:center; gap:16px; margin-top:8px; }
  .gk-feat .buy .price { font-family:'General Sans',sans-serif; font-weight:700; font-size:24px; letter-spacing:-0.03em; }

  /* editorial */
  .gk-ed { padding:clamp(8px,2vw,20px) clamp(12px,3vw,40px) clamp(26px,4vw,46px); }
  .gk-ed .stage { position:relative; max-width:1200px; margin:0 auto; border-radius:26px; overflow:hidden; min-height:clamp(300px,42vw,440px); display:flex; align-items:flex-end; }
  .gk-ed .stage img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .gk-ed .stage .scrim { position:absolute; inset:0; background:linear-gradient(180deg,rgba(17,19,21,0.05) 30%,rgba(17,19,21,0.6) 100%); }
  .gk-ed .stage .copy { position:relative; padding:clamp(26px,4vw,52px); color:#fff; display:flex; flex-direction:column; gap:14px; align-items:flex-start; max-width:620px; }
  .gk-ed .stage .copy h2 { color:#fff; }
  .gk-ed .stage .copy p { font-size:15px; line-height:1.6; opacity:0.95; margin:0; max-width:46ch; }

  /* stats */
  .gk-stats-sec { padding:clamp(30px,4.2vw,58px) clamp(16px,3vw,44px); background:#F4F6F8; }
  .gk-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:clamp(20px,3vw,32px); text-align:center; }
  .gk-stat .v { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.04em; font-size:clamp(2rem,3.6vw,2.9rem); color:#3E5568; line-height:1; }
  .gk-stat .l { font-size:15px; color:#111315; max-width:220px; line-height:1.4; margin:10px auto 0; }
  .gk-note { text-align:center; font-size:12px; color:#5B6470; max-width:640px; margin:clamp(20px,3vw,34px) auto 0; line-height:1.6; }

  /* triptych */
  .gk-trip { padding:clamp(30px,4.2vw,58px) clamp(16px,3vw,44px); }
  .gk-trip .head { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:clamp(24px,3vw,36px); }
  .gk-trip .g { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(10px,2vw,22px); }
  @media (max-width:640px){ .gk-trip .g { grid-template-columns:1fr; } }
  .gk-trip .card { background:#F4F6F8; border-radius:20px; overflow:hidden; }
  .gk-trip .card .im { aspect-ratio:1/1; } .gk-trip .card img { width:100%; height:100%; object-fit:cover; display:block; }
  .gk-trip .card .cap { padding:16px 18px; font-family:'General Sans',sans-serif; font-weight:600; text-transform:lowercase; letter-spacing:-0.02em; font-size:16px; }

  /* values */
  .gk-val { padding:clamp(30px,4.2vw,58px) clamp(16px,3vw,44px); background:#F4F6F8; }
  .gk-val .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:clamp(20px,3vw,40px); align-items:center; }
  .gk-val .media { border-radius:22px; overflow:hidden; aspect-ratio:4/5; }
  .gk-val .media img { width:100%; height:100%; object-fit:cover; display:block; }
  .gk-val .statement { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.03em; font-size:clamp(1.35rem,2.4vw,1.85rem); line-height:1.1; margin:0 0 20px; }
  .gk-val details { border-top:1px solid rgba(17,19,21,0.12); padding:16px 0; }
  .gk-val summary { cursor:pointer; list-style:none; font-family:'General Sans',sans-serif; font-weight:600; text-transform:lowercase; letter-spacing:-0.01em; font-size:18px; display:flex; justify-content:space-between; }
  .gk-val summary::-webkit-details-marker{ display:none; }
  .gk-val details p { font-size:14.5px; color:#5B6470; line-height:1.6; margin:12px 0 0; }
  .gk-val .btnrow { margin-top:22px; }

  /* results (before / after) */
  .gk-results { padding:clamp(30px,4.2vw,58px) clamp(16px,3vw,44px); background:#fff; }
  .gk-results .head { text-align:center; margin-bottom:clamp(22px,3vw,36px); }
  .gk-results .head p { color:#5B6470; font-size:14.5px; margin:8px 0 0; }
  .gk-results .g { display:grid; grid-template-columns:repeat(4,1fr); gap:clamp(10px,1.4vw,16px); }
  @media (max-width:760px){ .gk-results .g { grid-template-columns:repeat(2,1fr); } }
  .gk-res-card .pair { display:grid; grid-template-columns:1fr 1fr; gap:3px; border-radius:16px; overflow:hidden; }
  .gk-res-half { position:relative; aspect-ratio:3/4; background:#E9ECEF; display:flex; align-items:center; justify-content:center; }
  .gk-res-half img { width:100%; height:100%; object-fit:cover; display:block; }
  .gk-res-half .ph { font-family:'General Sans',sans-serif; font-weight:600; text-transform:lowercase; font-size:13px; color:#9AA6B0; }
  .gk-res-half .tag { position:absolute; bottom:8px; left:8px; background:rgba(17,19,21,0.72); color:#fff; font-size:10px; font-weight:600; letter-spacing:0.02em; padding:3px 9px; border-radius:100px; }
  .gk-res-card .cap { text-align:center; margin-top:9px; font-size:12.5px; color:#5B6470; }

  /* reviews — moving marquee */
  .gk-rev { padding:clamp(30px,4.2vw,58px) 0; overflow:hidden; }
  .gk-rev h2 { padding:0 clamp(16px,3vw,44px); }
  .gk-rev .marquee { overflow:hidden; margin-top:clamp(20px,3vw,34px); -webkit-mask:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent); mask:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent); }
  .gk-rev .track { display:flex; gap:16px; width:max-content; padding:0 8px; animation:gk-marq 46s linear infinite; }
  .gk-rev .marquee:hover .track { animation-play-state:paused; }
  .gk-rev .card { flex:0 0 auto; width:300px; background:#F4F6F8; border-radius:18px; padding:22px; display:flex; flex-direction:column; gap:12px; }
  .gk-rev .card .toprow { display:flex; align-items:center; justify-content:space-between; }
  .gk-rev .card .stars { color:#3E5568; font-size:15px; letter-spacing:1px; }
  .gk-rev .card .vf { font-size:11px; font-weight:600; color:#1F7A55; }
  .gk-rev .card .body { font-size:14.5px; line-height:1.55; }
  .gk-rev .card .who { font-size:12.5px; font-weight:600; color:#5B6470; margin-top:auto; }
  @keyframes gk-marq { from{transform:translateX(0);} to{transform:translateX(-50%);} }
  @media (prefers-reduced-motion: reduce){ .gk-rev .track { animation:none; flex-wrap:wrap; width:auto; justify-content:center; } }
</style>

<div class="gk-hb">

  <div class="gk-label">quiet &middot; cordless &middot; clinically proven</div>

  <!-- FEATURED -->
  <section class="gk-feat">
    <div class="wrap grid">
      <div class="media"><img src="{{ img }}/glo-detail-2.png" alt="glo device close-up"></div>
      <div class="info">
        <div class="eyebrow">the device</div>
        <div class="big">glo</div>
        <p>a flash-sensing ipl handset with a rose-gold flash head, quiet motor, and a 40-minute battery — enough for a full-body session on one charge. one device, every zone, week after week.</p>
        <div class="hl">
          <div><span>—</span> flash-sensing head, auto-fires on contact</div>
          <div><span>—</span> 40-minute battery, full body on one charge</div>
          <div><span>—</span> contact + contrast safety sensor, fda-cleared</div>
          <div><span>—</span> includes precision razor &amp; protective eyewear</div>
        </div>
        <div class="buy">
          <div class="price">$129.99</div>
          <a href="{{ p_url }}" class="pill">shop glo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- EDITORIAL -->
  <section class="gk-ed">
    <div class="stage">
      <img src="{{ img }}/glo-detail-4.png" alt="glo flash window close-up">
      <div class="scrim"></div>
      <div class="copy">
        <div class="eyebrow" style="color:#fff;opacity:0.9;">the technology</div>
        <h2>engineered like a beauty tool.<br>tested like a medical device.</h2>
        <p>a contact + contrast sensor reads your skin before every flash, so glo only fires when it's safe to. fda-cleared, dermatologist-tested, and quiet enough for a sunday morning.</p>
        <a href="{{ p_url }}" class="pill-ghost">shop glo</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="gk-stats-sec">
    <div class="wrap">
      <div class="gk-stats">
        <div class="gk-stat"><div class="v">94%</div><div class="l">saw a visible reduction in regrowth after 4 weeks*</div></div>
        <div class="gk-stat"><div class="v">91%</div><div class="l">said skin felt noticeably smoother between sessions*</div></div>
        <div class="gk-stat"><div class="v">89%</div><div class="l">found it easier than their salon routine*</div></div>
      </div>
      <div class="gk-note">*results from an 8-week independent consumer-use study of 132 participants using glo at home, 2 sessions per week. individual results vary.</div>
    </div>
  </section>

  <!-- RESULTS (before / after) -->
  <section class="gk-results">
    <div class="wrap">
      <div class="head">
        <h2 style="text-align:center;">{{ section.settings.results_heading | default: 'smooth skin. real confidence.' }}</h2>
        {%- if section.settings.results_sub != blank -%}<p>{{ section.settings.results_sub }}</p>{%- endif -%}
      </div>
      <div class="g">
        {%- for n in (1..4) -%}
          {%- assign bkey = 'before_' | append: n -%}
          {%- assign akey = 'after_' | append: n -%}
          {%- assign ckey = 'caption_' | append: n -%}
          {%- assign bimg = section.settings[bkey] -%}
          {%- assign aimg = section.settings[akey] -%}
          {%- assign cap = section.settings[ckey] | default: 'after 4 weeks' -%}
          <div class="gk-res-card">
            <div class="pair">
              <div class="gk-res-half">
                {%- if bimg != blank -%}<img src="{{ bimg | image_url: width: 500 }}" alt="before">{%- else -%}<span class="ph">before</span>{%- endif -%}
                <span class="tag">before</span>
              </div>
              <div class="gk-res-half">
                {%- if aimg != blank -%}<img src="{{ aimg | image_url: width: 500 }}" alt="after">{%- else -%}<span class="ph">after</span>{%- endif -%}
                <span class="tag">{{ cap }}</span>
              </div>
            </div>
            <div class="cap">{{ cap }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- TRIPTYCH -->
  <section class="gk-trip">
    <div class="wrap">
      <div class="head">
        <h2>everything in the box</h2>
        <a href="{{ p_url }}#gallery" style="font-size:14px;font-weight:600;color:#111315;border-bottom:1px solid #111315;">see all photos</a>
      </div>
      <div class="g">
        <div class="card"><div class="im"><img src="{{ img }}/glo-detail-1.png" alt="the full glo kit"></div><div class="cap">the full kit</div></div>
        <div class="card"><div class="im"><img src="{{ img }}/glo-detail-5.png" alt="glo replacement caps"></div><div class="cap">flash caps</div></div>
        <div class="card"><div class="im"><img src="{{ img }}/glo-detail-9.png" alt="glo packaging"></div><div class="cap">the unboxing</div></div>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="gk-val">
    <div class="wrap grid">
      <div class="media"><img src="{{ img }}/glo-detail-3.png" alt="glo device"></div>
      <div>
        <p class="statement">we help you restore, protect, and reveal smoother skin — on your own schedule, at home.</p>
        <details open><summary><span>our mission</span></summary><p>make professional-grade hair removal something you actually own — quiet, gentle, and simple enough to keep up with for good.</p></details>
        <details><summary><span>how it works</span></summary><p>intense pulsed light targets the pigment in the hair, gradually reducing regrowth session after session. glo's sensor keeps every flash safe and even.</p></details>
        <details><summary><span>our guarantee</span></summary><p>30-night home trial and a 2-year warranty. if glo isn't for you, send it back — no drama.</p></details>
        <div class="btnrow"><a href="{{ p_url }}#how-to-use" class="pill-outline">learn more</a></div>
      </div>
    </div>
  </section>

  <!-- REVIEWS (moving marquee) -->
  <section class="gk-rev">
    <div class="wrap"><h2>what people are saying</h2></div>
    {%- capture revcards -%}
      <div class="card"><div class="toprow"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><div class="vf">&#10003; verified</div></div><div class="body">"genuinely works. quiet, fast, and i actually stick with it because it doesn't hurt."</div><div class="who">jenna r. &middot; austin, tx</div></div>
      <div class="card"><div class="toprow"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><div class="vf">&#10003; verified</div></div><div class="body">"four weeks in and my underarms are basically maintenance-only now. the flash sensor makes it foolproof."</div><div class="who">monique t. &middot; atlanta, ga</div></div>
      <div class="card"><div class="toprow"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9734;</div><div class="vf">&#10003; verified</div></div><div class="body">"good results on my legs — took a bit longer on coarser hair, but worth the patience."</div><div class="who">ava l. &middot; denver, co</div></div>
      <div class="card"><div class="toprow"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><div class="vf">&#10003; verified</div></div><div class="body">"looks and feels premium, and it's so much quieter than i expected. actually enjoy using it."</div><div class="who">sophie k. &middot; miami, fl</div></div>
      <div class="card"><div class="toprow"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><div class="vf">&#10003; verified</div></div><div class="body">"cancelled my salon appointments. paid for itself in two months and i do it on my own time."</div><div class="who">priya n. &middot; seattle, wa</div></div>
      <div class="card"><div class="toprow"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><div class="vf">&#10003; verified</div></div><div class="body">"was skeptical about an at-home device but the results speak for themselves. smooth and even."</div><div class="who">daniela r. &middot; phoenix, az</div></div>
    {%- endcapture -%}
    <div class="marquee"><div class="track">{{ revcards }}{{ revcards }}</div></div>
  </section>

</div>

{% schema %}
{
  "name": "GK Home Body",
  "settings": [
    { "type": "header", "content": "Before / after results" },
    { "type": "text", "id": "results_heading", "label": "Heading", "default": "smooth skin. real confidence." },
    { "type": "text", "id": "results_sub", "label": "Subheading", "default": "real customers, 4–8 weeks of weekly use." },
    { "type": "image_picker", "id": "before_1", "label": "Result 1 · before" },
    { "type": "image_picker", "id": "after_1", "label": "Result 1 · after" },
    { "type": "text", "id": "caption_1", "label": "Result 1 · caption", "default": "after 4 weeks" },
    { "type": "image_picker", "id": "before_2", "label": "Result 2 · before" },
    { "type": "image_picker", "id": "after_2", "label": "Result 2 · after" },
    { "type": "text", "id": "caption_2", "label": "Result 2 · caption", "default": "after 6 weeks" },
    { "type": "image_picker", "id": "before_3", "label": "Result 3 · before" },
    { "type": "image_picker", "id": "after_3", "label": "Result 3 · after" },
    { "type": "text", "id": "caption_3", "label": "Result 3 · caption", "default": "after 8 weeks" },
    { "type": "image_picker", "id": "before_4", "label": "Result 4 · before" },
    { "type": "image_picker", "id": "after_4", "label": "Result 4 · after" },
    { "type": "text", "id": "caption_4", "label": "Result 4 · caption", "default": "after 4 weeks" }
  ],
  "presets": [{ "name": "GK Home Body" }]
}
{% endschema %}
