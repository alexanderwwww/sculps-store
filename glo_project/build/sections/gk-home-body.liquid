{%- liquid
  assign img = 'https://raw.githubusercontent.com/alexanderwwww/sculps-store/1c672ae0a8a29459960bd5fd15e0aa7e94293c45/glo_project/build/assets'
  assign p_url = '/products/glo-ipl-device'
-%}
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .gk-hb, .gk-hb * { box-sizing:border-box; }
  .gk-hb { font-family:'Inter',sans-serif; color:#111315; background:#fff; }
  .gk-hb a { text-decoration:none; }
  .gk-hb .wrap { max-width:1200px; margin:0 auto; }
  .gk-hb .eyebrow { font-size:13px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:#3E5568; }
  .gk-hb h2 { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.035em; font-size:clamp(1.8rem,3.4vw,2.8rem); margin:0; }
  .gk-hb .pill { display:inline-block; background:#111315; color:#fff; border-radius:100px; padding:15px 30px; font-size:14px; font-weight:600; text-transform:lowercase; letter-spacing:-0.01em; }
  .gk-hb .pill-ghost { display:inline-block; background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,0.8); border-radius:100px; padding:14px 28px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; }
  .gk-hb .pill-outline { display:inline-block; background:transparent; color:#111315; border:1.5px solid #111315; border-radius:100px; padding:13px 26px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; }

  /* label divider */
  .gk-label { text-align:center; padding:clamp(26px,4vw,40px) 20px; font-family:'General Sans',sans-serif; font-weight:600; text-transform:lowercase; letter-spacing:-0.01em; font-size:clamp(15px,2vw,20px); color:#5B6470; }

  /* featured */
  .gk-feat { padding:clamp(40px,6vw,80px) clamp(20px,4vw,56px); }
  .gk-feat .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:clamp(28px,5vw,64px); align-items:center; }
  .gk-feat .media { border-radius:22px; overflow:hidden; background:#F4F6F8; aspect-ratio:1/1; }
  .gk-feat .media img { width:100%; height:100%; object-fit:cover; display:block; }
  .gk-feat .info { display:flex; flex-direction:column; gap:16px; }
  .gk-feat .info .big { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.035em; font-size:clamp(2.4rem,4vw,3.4rem); line-height:1; }
  .gk-feat .info p { font-size:16px; color:#5B6470; line-height:1.6; max-width:460px; margin:0; }
  .gk-feat .hl { display:flex; flex-direction:column; gap:9px; margin-top:2px; }
  .gk-feat .hl div { display:flex; gap:10px; font-size:14.5px; } .gk-feat .hl span { color:#3E5568; }
  .gk-feat .buy { display:flex; align-items:center; gap:16px; margin-top:8px; }
  .gk-feat .buy .price { font-family:'General Sans',sans-serif; font-weight:700; font-size:24px; letter-spacing:-0.03em; }

  /* editorial */
  .gk-ed { padding:clamp(8px,2vw,20px) clamp(14px,4vw,56px) clamp(40px,6vw,72px); }
  .gk-ed .stage { position:relative; max-width:1200px; margin:0 auto; border-radius:26px; overflow:hidden; min-height:clamp(420px,60vw,620px); display:flex; align-items:flex-end; }
  .gk-ed .stage img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .gk-ed .stage .scrim { position:absolute; inset:0; background:linear-gradient(180deg,rgba(17,19,21,0.05) 30%,rgba(17,19,21,0.6) 100%); }
  .gk-ed .stage .copy { position:relative; padding:clamp(26px,4vw,52px); color:#fff; display:flex; flex-direction:column; gap:14px; align-items:flex-start; max-width:620px; }
  .gk-ed .stage .copy h2 { color:#fff; }
  .gk-ed .stage .copy p { font-size:15px; line-height:1.6; opacity:0.95; margin:0; max-width:46ch; }

  /* stats */
  .gk-stats-sec { padding:clamp(48px,7vw,96px) clamp(20px,4vw,56px); background:#F4F6F8; }
  .gk-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:clamp(28px,4vw,40px); text-align:center; }
  .gk-stat .v { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.04em; font-size:clamp(3rem,6vw,4.5rem); color:#3E5568; line-height:1; }
  .gk-stat .l { font-size:15px; color:#111315; max-width:220px; line-height:1.4; margin:10px auto 0; }
  .gk-note { text-align:center; font-size:12px; color:#5B6470; max-width:640px; margin:clamp(28px,4vw,44px) auto 0; line-height:1.6; }

  /* triptych */
  .gk-trip { padding:clamp(48px,7vw,96px) clamp(20px,4vw,56px); }
  .gk-trip .head { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:clamp(24px,3vw,36px); }
  .gk-trip .g { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(10px,2vw,22px); }
  @media (max-width:640px){ .gk-trip .g { grid-template-columns:1fr; } }
  .gk-trip .card { background:#F4F6F8; border-radius:20px; overflow:hidden; }
  .gk-trip .card .im { aspect-ratio:1/1; } .gk-trip .card img { width:100%; height:100%; object-fit:cover; display:block; }
  .gk-trip .card .cap { padding:16px 18px; font-family:'General Sans',sans-serif; font-weight:600; text-transform:lowercase; letter-spacing:-0.02em; font-size:16px; }

  /* values */
  .gk-val { padding:clamp(48px,7vw,96px) clamp(20px,4vw,56px); background:#F4F6F8; }
  .gk-val .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:clamp(28px,5vw,56px); align-items:center; }
  .gk-val .media { border-radius:22px; overflow:hidden; aspect-ratio:4/5; }
  .gk-val .media img { width:100%; height:100%; object-fit:cover; display:block; }
  .gk-val .statement { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.03em; font-size:clamp(1.7rem,3vw,2.4rem); line-height:1.1; margin:0 0 20px; }
  .gk-val details { border-top:1px solid rgba(17,19,21,0.12); padding:16px 0; }
  .gk-val summary { cursor:pointer; list-style:none; font-family:'General Sans',sans-serif; font-weight:600; text-transform:lowercase; letter-spacing:-0.01em; font-size:18px; display:flex; justify-content:space-between; }
  .gk-val summary::-webkit-details-marker{ display:none; }
  .gk-val details p { font-size:14.5px; color:#5B6470; line-height:1.6; margin:12px 0 0; }
  .gk-val .btnrow { margin-top:22px; }

  /* reviews */
  .gk-rev { padding:clamp(48px,7vw,96px) clamp(20px,4vw,56px); }
  .gk-rev .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:clamp(18px,2.5vw,26px); margin-top:clamp(24px,3vw,40px); }
  .gk-rev .card { background:#F4F6F8; border-radius:18px; padding:clamp(22px,2.5vw,28px); display:flex; flex-direction:column; gap:14px; }
  .gk-rev .card .stars { color:#3E5568; font-size:15px; letter-spacing:1px; }
  .gk-rev .card .body { font-size:15.5px; line-height:1.6; }
  .gk-rev .card .who { font-size:13px; font-weight:600; color:#5B6470; }
</style>

<div class="gk-hb">

  <div class="gk-label">quiet &middot; cordless &middot; clinically proven</div>

  <!-- FEATURED -->
  <section class="gk-feat">
    <div class="wrap grid">
      <div class="media"><img src="{{ img }}/glo-detail-2.png" alt="glo device close-up"></div>
      <div class="info">
        <div class="eyebrow">the device</div>
        <div class="big">glo</div>
        <p>a flash-sensing ipl handset with a rose-gold flash head, quiet motor, and a 40-minute battery — enough for a full-body session on one charge. one device, every zone, week after week.</p>
        <div class="hl">
          <div><span>—</span> flash-sensing head, auto-fires on contact</div>
          <div><span>—</span> 40-minute battery, full body on one charge</div>
          <div><span>—</span> contact + contrast safety sensor, fda-cleared</div>
          <div><span>—</span> includes precision razor &amp; protective eyewear</div>
        </div>
        <div class="buy">
          <div class="price">$179</div>
          <a href="{{ p_url }}" class="pill">shop glo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- EDITORIAL -->
  <section class="gk-ed">
    <div class="stage">
      <img src="{{ img }}/glo-detail-4.png" alt="glo flash window close-up">
      <div class="scrim"></div>
      <div class="copy">
        <div class="eyebrow" style="color:#fff;opacity:0.9;">the technology</div>
        <h2>engineered like a beauty tool.<br>tested like a medical device.</h2>
        <p>a contact + contrast sensor reads your skin before every flash, so glo only fires when it's safe to. fda-cleared, dermatologist-tested, and quiet enough for a sunday morning.</p>
        <a href="{{ p_url }}" class="pill-ghost">shop glo</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="gk-stats-sec">
    <div class="wrap">
      <div class="gk-stats">
        <div class="gk-stat"><div class="v">94%</div><div class="l">saw a visible reduction in regrowth after 4 weeks*</div></div>
        <div class="gk-stat"><div class="v">91%</div><div class="l">said skin felt noticeably smoother between sessions*</div></div>
        <div class="gk-stat"><div class="v">89%</div><div class="l">found it easier than their salon routine*</div></div>
      </div>
      <div class="gk-note">*results from an 8-week independent consumer-use study of 132 participants using glo at home, 2 sessions per week. individual results vary.</div>
    </div>
  </section>

  <!-- TRIPTYCH -->
  <section class="gk-trip">
    <div class="wrap">
      <div class="head">
        <h2>everything in the box</h2>
        <a href="{{ p_url }}#gallery" style="font-size:14px;font-weight:600;color:#111315;border-bottom:1px solid #111315;">see all photos</a>
      </div>
      <div class="g">
        <div class="card"><div class="im"><img src="{{ img }}/glo-detail-1.png" alt="the full glo kit"></div><div class="cap">the full kit</div></div>
        <div class="card"><div class="im"><img src="{{ img }}/glo-detail-5.png" alt="glo replacement caps"></div><div class="cap">flash caps</div></div>
        <div class="card"><div class="im"><img src="{{ img }}/glo-detail-9.png" alt="glo packaging"></div><div class="cap">the unboxing</div></div>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="gk-val">
    <div class="wrap grid">
      <div class="media"><img src="{{ img }}/glo-detail-3.png" alt="glo device"></div>
      <div>
        <p class="statement">we help you restore, protect, and reveal smoother skin — on your own schedule, at home.</p>
        <details open><summary><span>our mission</span></summary><p>make professional-grade hair removal something you actually own — quiet, gentle, and simple enough to keep up with for good.</p></details>
        <details><summary><span>how it works</span></summary><p>intense pulsed light targets the pigment in the hair, gradually reducing regrowth session after session. glo's sensor keeps every flash safe and even.</p></details>
        <details><summary><span>our guarantee</span></summary><p>30-night home trial and a 2-year warranty. if glo isn't for you, send it back — no drama.</p></details>
        <div class="btnrow"><a href="{{ p_url }}#how-to-use" class="pill-outline">learn more</a></div>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="gk-rev">
    <div class="wrap">
      <h2>what people are saying</h2>
      <div class="cards">
        <div class="card"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><div class="body">"genuinely works. quiet, fast, and i actually stick with it because it doesn't hurt."</div><div class="who">jenna r.</div></div>
        <div class="card"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><div class="body">"four weeks in and my underarms are basically maintenance-only now."</div><div class="who">monique t.</div></div>
        <div class="card"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9734;</div><div class="body">"good results on my legs — took a bit longer on coarser hair, but worth the patience."</div><div class="who">ava l.</div></div>
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "GK Home Body",
  "settings": [],
  "presets": [{ "name": "GK Home Body" }]
}
{% endschema %}
