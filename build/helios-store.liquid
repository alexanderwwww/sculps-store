  [data-noscroll]::-webkit-scrollbar{display:none;width:0;height:0;}
  details>summary{list-style:none;}
  details>summary::-webkit-details-marker{display:none;}
  #helios a{text-decoration:none;}
  @keyframes heliosmq{to{transform:translateX(-50%);}}
  @keyframes heliosdrift{0%{transform:translate(0,0) scale(1);}50%{transform:translate(34px,-26px) scale(1.18);}100%{transform:translate(0,0) scale(1);}}
  @keyframes heliosfloat{0%,100%{transform:translateY(0) rotate(-2deg);}50%{transform:translateY(-18px) rotate(2deg);}}
