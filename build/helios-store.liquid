<script>
(function(){function run(){

    
    const root = document.getElementById('helios');
    if (!root) return;
    const $ = (s, c) => (c || root).querySelector(s);
    const $$ = (s, c) => Array.from((c || root).querySelectorAll(s));

    // ---- props / theming ----
    const p = {};
    if (p.accent === 'Glacier teal') {
      root.style.setProperty('--acc', '#1FA6BE');
      root.style.setProperty('--acc2', '#34C9DE');
      root.style.setProperty('--accd', '#15808F');
    }
    if (p.stockLeft != null) { const el = $('#stockLeft'); if (el) el.textContent = p.stockLeft; }

    // ---- hero video: force-mute + loop a clean window (skips on-screen logo + end comparison) ----
    const hv = $('#hero-video');
    if (hv) {
      hv.muted = true; hv.defaultMuted = true; hv.volume = 0; hv.loop = true; hv.removeAttribute('controls');
      hv.setAttribute('loop', '');
      const kick = () => { hv.muted = true; const pr = hv.play(); if (pr && pr.catch) pr.catch(() => {}); };
      // bulletproof infinite loop: restart on end + whenever paused
      hv.addEventListener('ended', () => { try { hv.currentTime = 0; } catch (e) {} kick(); });
      hv.addEventListener('pause', () => { if (!hv.ended && document.visibilityState === 'visible') kick(); });
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') kick(); });
      kick(); hv.addEventListener('canplay', kick); hv.addEventListener('loadeddata', kick);

      // ---- glass "Free USA shipping" popup over the watermark window (~5.3s–9.6s) ----
      const shipPop = $('#shipPop');
      const A = 3.0, B = 11.2;
      if (shipPop) {
        let shown = false;
        hv.addEventListener('timeupdate', () => {
          const t = hv.currentTime;
          const inWin = t >= A && t <= B;
          if (inWin && !shown) { shown = true; shipPop.style.opacity = '1'; shipPop.style.transform = 'translateY(0) scale(1)'; }
          else if (!inWin && shown) { shown = false; shipPop.style.opacity = '0'; shipPop.style.transform = 'translateY(-10px) scale(.96)'; }
        });
      }
    }

    // ---- announcement rotation ----
    const anns = $$('[data-ann]'); let ai = 0;
    if (anns.length) setInterval(() => {
      anns[ai].style.opacity = '0';
      ai = (ai + 1) % anns.length;
      anns[ai].style.opacity = '1';
    }, 3600);

    // ---- marquee duplicate ----
    const mqt = $('#mqt'); if (mqt) mqt.innerHTML += mqt.innerHTML;

    // ---- nav hover ----
    $$('[data-navlinks] a').forEach(a => {
      a.addEventListener('mouseenter', () => a.style.color = 'var(--ink)');
      a.addEventListener('mouseleave', () => a.style.color = 'var(--mut)');
    });

    // ---- comparison rows ----
    const cmp = $('[data-cmprows]');
    if (cmp) {
      const rows = [
        ['Ice-cooling plate', true, false],
        ['199 speed levels', true, false],
        ['Truly hands-free', true, false],
        ['Pocket-size & portable', true, false],
        ['USB-C / power-bank ready', true, false],
        ['Whisper-quiet motor', true, false],
      ];
      cmp.innerHTML = rows.map((r, i) => `
        <div style="display:grid;grid-template-columns:1.4fr 1fr 1fr;align-items:center;${i < rows.length - 1 ? 'border-bottom:1px solid rgba(255,255,255,.5);' : ''}">
          <div style="padding:16px 20px;font-size:14px;font-weight:600;">${r[0]}</div>
          <div style="padding:16px 14px;text-align:center;background:rgba(224,243,251,.5);color:var(--accd);font-size:18px;font-weight:800;">${r[1] ? '✓' : '—'}</div>
          <div style="padding:16px 14px;text-align:center;color:#aeb9c2;font-size:18px;font-weight:700;">${r[2] ? '✓' : '✕'}</div>
        </div>`).join('');
    }

    // ---- tiktok phones (screen only) ----
    const play = '<svg width="22" height="22" viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg>';
    const ttrow = $('#ttrow');
    if (ttrow) {
      const ttSrc = ['https://cdn.shopify.com/videos/c/vp/93c925dfd85b4cebbecc7ffc53230ec4/93c925dfd85b4cebbecc7ffc53230ec4.HD-720p-1.6Mbps-86965426.mp4', 'https://cdn.shopify.com/videos/c/vp/fab607dfcc5342c08d250f8c45137b0e/fab607dfcc5342c08d250f8c45137b0e.HD-720p-1.6Mbps-86965424.mp4', 'https://cdn.shopify.com/videos/c/vp/17d238dbd72a4e41a5f78c1a8dddf454/17d238dbd72a4e41a5f78c1a8dddf454.HD-720p-1.6Mbps-86965427.mp4'];
      ttrow.innerHTML = [0, 1, 2].map((i) => `
        <div style="flex:0 0 clamp(220px,26vw,270px);animation:heliosbob ${(6.6 + i * 0.8).toFixed(1)}s ease-in-out infinite ${(i * 0.55).toFixed(2)}s;">
          <div style="position:relative;background:#0A1219;border-radius:44px;padding:9px;box-shadow:0 38px 72px -22px rgba(6,30,46,.55),inset 0 0 0 1px rgba(255,255,255,.08);">
            <div style="position:absolute;top:9px;left:50%;transform:translateX(-50%);width:100px;height:26px;background:#0A1219;border-radius:0 0 18px 18px;z-index:4;"></div>
            <div style="position:relative;border-radius:36px;overflow:hidden;aspect-ratio:9/19.3;background:#0e1c26;">
              <video data-ttvid src="${ttSrc[i]}" muted loop autoplay playsinline style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"></video>
            </div>
          </div>
        </div>`).join('');
      $$('[data-ttvid]').forEach(v => { v.muted = true; v.defaultMuted = true; v.setAttribute('muted', ''); v.loop = true; v.setAttribute('loop', ''); v.addEventListener('ended', () => { try { v.currentTime = 0; } catch (e) {} const pr = v.play(); if (pr && pr.catch) pr.catch(() => {}); }); const pr = v.play(); if (pr && pr.catch) pr.catch(() => {}); });
    }

    // ---- 360 auto-rotate turntable ----
    const spinFrames = $$('[data-spinframe]');
    const spinStage = $('[data-spinstage]');
    if (spinFrames.length) {
      let si = 0, paused = false, baseMs = 620;
      const showFrame = (n) => spinFrames.forEach((f, k) => { f.style.opacity = k === n ? '1' : '0'; });
      showFrame(0);
      setInterval(() => { if (paused) return; si = (si + 1) % spinFrames.length; showFrame(si); }, baseMs);
      if (spinStage) {
        spinStage.addEventListener('mouseenter', () => paused = true);
        spinStage.addEventListener('mouseleave', () => paused = false);
      }
    }

    // ---- snow / ice particles in tiktok section ----
    const snow = $('[data-snow]');
    if (snow) {
      let s = '';
      for (let i = 0; i < 36; i++) {
        const sz = 2 + Math.random() * 5, left = Math.random() * 100, dur = 7 + Math.random() * 9, delay = -Math.random() * 16, op = (0.4 + Math.random() * 0.5).toFixed(2);
        s += `<span style="position:absolute;top:0;left:${left.toFixed(1)}%;width:${sz.toFixed(1)}px;height:${sz.toFixed(1)}px;border-radius:50%;background:rgba(176,214,234,${op});box-shadow:0 0 6px rgba(120,180,210,.5);animation:heliossnow ${dur.toFixed(1)}s linear infinite ${delay.toFixed(1)}s;"></span>`;
      }
      snow.innerHTML = s;
    }

    // ---- bundle + addons ----
    const opts = $$('[data-opt]');
    let base = 69.99, old = 118, label = '2 × HELIOS Fan';
    const addons = {};
    $$('[data-add]').forEach((el, i) => addons[i] = false);
    const addSum = () => $$('[data-add]').reduce((s, el, i) => s + (addons[i] ? +el.dataset.add : 0), 0);
    const addOldSum = () => $$('[data-add]').reduce((s, el, i) => s + (addons[i] ? +el.dataset.addold : 0), 0);
    const fmt = n => '$' + n.toFixed(2);
    const paint = () => {
      const t = base + addSum(), o = old + addOldSum();
      const sbp = $('#sbprice'), sbo = $('#sbold'), bt = $('#buyTotal');
      if (sbp) sbp.textContent = fmt(t);
      if (sbo) sbo.textContent = '$' + o;
      if (bt) bt.textContent = fmt(t);
    };
    opts.forEach(o => o.addEventListener('click', () => {
      opts.forEach(x => {
        const on = x === o;
        x.style.borderColor = on ? 'var(--acc)' : 'rgba(255,255,255,.5)';
        x.style.background = on ? 'rgba(224,243,251,.7)' : 'var(--g-bg2)';
        x.style.boxShadow = on ? '0 12px 30px rgba(14,124,196,.18),inset 0 1px 0 rgba(255,255,255,.8)' : 'var(--g-sh)';
        const rad = x.querySelector('[data-rad]');
        if (rad) rad.style.border = on ? '6px solid var(--acc)' : '2px solid #B6C6D2';
      });
      base = +o.dataset.price; old = +o.dataset.old; label = o.dataset.label;
      paint();
    }));
    $$('[data-add]').forEach((el, i) => el.addEventListener('click', () => {
      addons[i] = !addons[i];
      const cb = el.querySelector('[data-cb]');
      el.style.borderColor = addons[i] ? 'var(--acc)' : 'rgba(255,255,255,.45)';
      el.style.background = addons[i] ? 'rgba(224,243,251,.7)' : 'var(--g-bg2)';
      if (cb) { cb.style.background = addons[i] ? 'var(--acc)' : 'transparent'; cb.style.borderColor = addons[i] ? 'var(--acc)' : '#AEBECA'; cb.textContent = addons[i] ? '✓' : ''; }
      paint();
    }));
    paint();

    // ---- checkout ----
    const VAR = {'1 × HELIOS Fan':47931250737317,'2 × HELIOS Fan':47931250770085,'3 × HELIOS Fan':47931250802853};
    const checkout = (e) => { if (e) e.preventDefault();
      const items=[{id:(VAR[label]||47931250770085),quantity:1}];
      document.querySelectorAll('#helios [data-add]').forEach(function(el,i){ if(addons[i]&&el.dataset.variant){ items.push({id:parseInt(el.dataset.variant,10),quantity:1}); } });
      fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})}).then(r=>r.json()).then(()=>{window.location.href='/checkout';}).catch(()=>{window.location.href='/cart';}); };
    const atc = $('#atc'), atc2 = $('#atc2');
    if (atc) atc.onclick = checkout;
    if (atc2) atc2.onclick = checkout;

    // ---- newsletter ----
    const nf = $('[data-news]');
    if (nf) nf.addEventListener('submit', (e) => { e.preventDefault(); alert('You\'re in — check your inbox for 10% off.'); nf.reset(); });

    // ---- reveal ----
    const io = new IntersectionObserver(es => es.forEach(e => {
      if (e.isIntersecting) { e.target.style.opacity = '1'; e.target.style.transform = 'none'; io.unobserve(e.target); }
    }), { threshold: 0.12 });
    $$('[data-reveal]').forEach(el => io.observe(el));

    // ---- count-up ----
    const fmtNum = (n, suffix) => {
      if (suffix === '+' && n >= 1000) return (n >= 100000 ? Math.round(n / 1000) + 'K' : (n / 1000).toFixed(n % 1000 === 0 ? 0 : 1) + 'K') + '+';
      return n.toLocaleString() + (suffix || '');
    };
    const cio = new IntersectionObserver(es => es.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target; cio.unobserve(el);
      const target = +el.dataset.count, suffix = el.dataset.suffix || '', t0 = performance.now(), dur = 1400;
      const tick = (now) => {
        const k = Math.min(1, (now - t0) / dur);
        el.textContent = fmtNum(Math.round(target * (1 - Math.pow(1 - k, 3))), suffix);
        if (k < 1) requestAnimationFrame(tick); else el.textContent = fmtNum(target, suffix);
      };
      requestAnimationFrame(tick);
    }), { threshold: 0.5 });
    $$('[data-count]').forEach(el => cio.observe(el));

    // ---- magnetic buttons ----
    $$('[data-mag]').forEach(el => {
      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.transform = `translate(${((e.clientX - r.left) / r.width - .5) * 7}px, ${((e.clientY - r.top) / r.height - .5) * 7}px)`;
      });
      el.addEventListener('mouseleave', () => { el.style.transform = 'translate(0,0)'; });
    });

    // ---- card lift ----
    $$('[data-tilt]').forEach(el => {
      el.addEventListener('mouseenter', () => { el.style.transform = 'translateY(-6px)'; el.style.boxShadow = '0 30px 56px rgba(6,47,73,.18),inset 0 1px 0 rgba(255,255,255,.8)'; });
      el.addEventListener('mouseleave', () => { el.style.transform = 'none'; el.style.boxShadow = 'var(--g-sh)'; });
    });

    // ---- lifestyle cards: zoom image on hover ----
    $$('[data-life]').forEach(el => {
      const img = el.querySelector('img');
      if (!img) return;
      el.addEventListener('mouseenter', () => { img.style.transform = 'scale(1.07)'; });
      el.addEventListener('mouseleave', () => { img.style.transform = 'scale(1)'; });
    });

    // ---- product gallery: press thumbs to swap main (image OR video) + tap to zoom ----
    const galMain = $('#galMain');
    const galVideo = $('#galVideo');
    const thumbs = $$('[data-thumb]');
    let mainIsVideo = false, currentSrc = galMain ? galMain.src : '';
    const setActiveThumb = (t) => {
      thumbs.forEach(x => { x.style.borderColor = 'var(--line)'; x.style.boxShadow = 'none'; });
      t.style.borderColor = 'var(--acc)';
      t.style.boxShadow = '0 6px 16px rgba(14,124,196,.2)';
    };
    thumbs.forEach(t => t.addEventListener('click', () => {
      setActiveThumb(t);
      if (t.dataset.video) {
        mainIsVideo = true; currentSrc = t.dataset.video;
        if (galMain) galMain.style.display = 'none';
        if (galVideo) { galVideo.style.display = 'block'; galVideo.muted = true; const pr = galVideo.play(); if (pr && pr.catch) pr.catch(() => {}); }
      } else {
        mainIsVideo = false; currentSrc = t.dataset.src;
        if (galVideo) galVideo.style.display = 'none';
        if (galMain) { galMain.src = t.dataset.src; galMain.style.objectFit = t.dataset.fit || 'cover'; galMain.style.padding = t.dataset.pad || '0'; galMain.style.display = 'block'; }
      }
    }));
    // force-mute + force-loop every gallery video so they autoplay continuously
    // (the `muted`/`loop` HTML attrs don't reflect to the IDL props in DC-rendered markup)
    const forceLoopPlay = (v) => {
      if (!v) return;
      v.muted = true; v.defaultMuted = true; v.setAttribute('muted', '');
      v.loop = true; v.setAttribute('loop', '');
      v.addEventListener('ended', () => { try { v.currentTime = 0; } catch (e) {} const pr = v.play(); if (pr && pr.catch) pr.catch(() => {}); });
      const pr = v.play(); if (pr && pr.catch) pr.catch(() => {});
    };
    if (galVideo) forceLoopPlay(galVideo);
    $$('[data-thumb][data-video] video').forEach(forceLoopPlay);
    const lbVidEl = $('#lightboxVid'); if (lbVidEl) { lbVidEl.loop = true; lbVidEl.setAttribute('loop', ''); lbVidEl.muted = true; lbVidEl.addEventListener('ended', () => { try { lbVidEl.currentTime = 0; lbVidEl.play(); } catch (e) {} }); }

    const lb = $('#lightbox'), lbImg = $('#lightboxImg'), lbVid = $('#lightboxVid'), galWrap = $('[data-galmain-wrap]');
    if (lb && galWrap) {
      galWrap.addEventListener('click', () => {
        if (mainIsVideo && lbVid) {
          lbImg.style.display = 'none';
          lbVid.style.display = 'block'; lbVid.src = currentSrc; lbVid.muted = true;
          const pr = lbVid.play(); if (pr && pr.catch) pr.catch(() => {});
        } else if (lbImg) {
          if (lbVid) lbVid.style.display = 'none';
          lbImg.style.display = 'block'; lbImg.src = currentSrc || (galMain && galMain.src);
        }
        lb.style.display = 'flex'; document.body.style.overflow = 'hidden';
      });
      lb.addEventListener('click', () => { lb.style.display = 'none'; document.body.style.overflow = ''; if (lbVid) lbVid.pause(); });
    }

    // ---- hover zoom ----
    const zoom = $('[data-zoom]');
    if (zoom) {
      const wrap = zoom.parentElement;
      wrap.addEventListener('mousemove', (e) => {
        const r = wrap.getBoundingClientRect();
        zoom.style.transformOrigin = `${((e.clientX - r.left) / r.width) * 100}% ${((e.clientY - r.top) / r.height) * 100}%`;
        zoom.style.transform = 'scale(1.7)';
      });
      wrap.addEventListener('mouseleave', () => { zoom.style.transform = 'scale(1)'; });
    }

    // ---- scroll: parallax + sticky + wow sweep ----
    const sticky = $('#sticky'), wow = $('[data-wow]'), sweep = $('[data-wowsweep]'), para = $$('[data-parallax]');
    let ticking = false;
    const onScroll = () => {
      if (ticking) return; ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY || window.pageYOffset;
        para.forEach(el => { el.style.transform = `translateY(${y * (+el.dataset.speed || 0)}px)`; });
        if (sticky) sticky.style.transform = y > 720 ? 'translateY(0)' : 'translateY(115%)';
        if (wow && sweep) {
          const r = wow.getBoundingClientRect(), vh = window.innerHeight;
          const prog = Math.max(0, Math.min(1, (vh - r.top) / (vh + r.height)));
          sweep.style.transform = `translateX(${-120 + prog * 320}%)`;
        }
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ---- live nudges ----
    const lv = $('#liveViewers'), sd = $('#soldToday');
    let viewers = (p.liveBase != null ? p.liveBase : 38), sold = 217;
    setInterval(() => {
      viewers = Math.max(22, viewers + (Math.random() < 0.5 ? -1 : 1) * (1 + Math.floor(Math.random() * 3)));
      if (lv) lv.textContent = viewers;
      if (Math.random() < 0.4) { sold += 1; if (sd) sd.textContent = sold; }
    }, 3200);
  
    var _bg=document.querySelector('#helios [data-burger]'),_dw=document.querySelector('#helios [data-drawer]');
    if(_bg&&_dw){_bg.addEventListener('click',function(){_dw.style.display='block';document.body.style.overflow='hidden';});
    _dw.addEventListener('click',function(e){if(e.target===_dw||e.target.closest('[data-drawerclose]')||e.target.hasAttribute('data-dl')){_dw.style.display='none';document.body.style.overflow='';}});}

}
if(document.readyState!='loading')run();else document.addEventListener('DOMContentLoaded',run);})();
</script>
