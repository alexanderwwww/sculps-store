  @keyframes heliosspin{to{transform:rotate(360deg);}}
  @keyframes heliosspinrev{to{transform:rotate(-360deg);}}
  /* responsive — breakpoints can't be inline */
  @media(min-width:880px){
    [data-prodgrid]{grid-template-columns:1fr 1fr !important;gap:46px !important;align-items:start !important;}
    [data-prodgrid] [data-galcol]{position:sticky;top:92px;}
    [data-explgrid]{grid-template-columns:1fr 1fr !important;gap:44px !important;}
    [data-nycgrid]{grid-template-columns:1.05fr .95fr !important;}
  }
