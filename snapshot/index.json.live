    "box": {
      "type": "xero-box",
      "settings": {
        "kicker": "WHAT ARRIVES FIRST",
        "heading": "The key lands before the bike.",
        "sub": "A machined aluminium case arrives days ahead of delivery. Inside: your key and your card. Nothing else.",
        "box_open": "shopify://shop_images/hf_20260813_061722_e9160a82-caa3-4d2c-ac9f-a937ec968359.png",
        "box_card": "shopify://shop_images/hf_20260813_061727_d99b6558-44b8-422c-98ca-8eb09a3ad65a.png",
        "card_kicker": "YOUR CARD",
        "card_heading": "Milled steel. Your number on it.",
        "card_body": "Every Chiron ships with a solid steel card carrying its serial and client ID, laser-etched. Tap it into the tank once and the bike is paired to you.",
        "card_cta": "Track your build",
        "card_link": "/pages/track",
