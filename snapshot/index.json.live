    "antitheft": {
      "type": "xero-antitheft",
      "settings": {
        "kicker": "SECURITY",
        "heading": "impossible to ride without you.",
        "sub": "pairs with iphone find my app",
        "lock1_title": "Paired to one phone",
        "lock1_body": "Your steel card claims the bike once, to you. From then on it wakes for your iPhone and refuses every other device.",
        "lock2_title": "No key to copy",
        "lock2_body": "There is no barrel, no blade and no fob to clone. There is nothing on the machine to pick, drill or hotwire.",
        "lock3_title": "Dead without you",
        "lock3_body": "The design puts the lock in the controller rather than in a barrel, so cutting the loom is not intended to defeat it. This describes the design intent of the system, not an independently tested security rating.",
        "find_icon": "shopify://shop_images/Screenshot_2026-08-22_at_13.38.03.png",
        "find_title": "Designed to tell you where it is.",
        "find_body": "Planned: the Chiron reports its position to the companion app, so a stolen bike is a tracked bike. The app is in development and is not available at launch - location reporting is a design goal, not a feature you can use the day the bike arrives.",
        "payoff": "Designed to be worthless to anyone but you."
      }
    },
