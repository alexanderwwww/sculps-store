    "iphone-key": {
      "type": "xero-iphone-key",
      "settings": {
        "eyebrow": "NO KEYS. NO FOB HUNTING.",
        "heading": "Your iPhone is the key.",
        "sub": "Card in, card out, phone in. After that the bike knows your phone and nothing else will start it.",
        "step1_img": "shopify://shop_images/Screenshot_2026-08-16_at_12.41.15.png",
        "s1_title": "Cut for your phone",
        "s1_body": "A pocket milled into the tank to the exact size and thickness of an iPhone, with the charging coil built into the floor of it. Nothing clips on. Nothing sticks out.",
        "step2_img": "shopify://shop_images/Screenshot_2026-08-16_at_12.40.39.png",
        "s2_title": "Tap your card once",
        "s2_body": "Your steel card carries the bike's client ID and serial. Lay it in the pocket, the NFC reader picks it up, and the machine is claimed. Then take the card straight back out.",
        "step3_img": "shopify://shop_images/Screenshot_2026-08-21_at_18.59.29.png",
        "s3_title": "Drop your phone in",
        "s3_body": "It lies flat and flush, the magnet holds it, and it charges while you ride. From then on the bike wakes for that phone alone.",
        "payoff": "Designed around the phone you already carry.",
        "payoff_sub": "XERO is an independent company and is not affiliated with, endorsed by, or sponsored by Apple Inc. iPhone is a trademark of Apple Inc. The pocket, the magnet and the NFC handshake are designed around the iPhone you already carry. Your card and key ship days before the bike does, so you can register your ID the moment they land.",
        "cta": "Activate your ID",
        "cta_link": "/pages/activate"
      }
    },
