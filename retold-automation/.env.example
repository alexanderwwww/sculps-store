# =============================================================================
# RETOLD — environment variables (the ONE place secrets live)
# =============================================================================
# HOW TO USE THIS FILE
#   1. Copy it to a file named exactly ".env" in this same folder:
#          cp .env.example .env
#   2. Fill in the values below (each line says where to get it).
#   3. Never share or commit ".env" — it holds your passwords/keys.
#
# You do NOT need every key to start. For the Phase-1 smoke test
# (`make test-mock`) you need NOTHING here at all. Add keys as you turn on each
# real service (see the README rollout: Phase 1 -> 2 -> 3).
#
# Format is KEY=value, one per line. No quotes needed. Lines starting with # are
# comments and are ignored.
# =============================================================================


# -----------------------------------------------------------------------------
# SHOPIFY  — where the order comes from, and where we mark it shipped.
# Get these in your Shopify admin: Settings -> Apps and sales channels ->
# Develop apps -> (create an app) -> Admin API access token.
# The webhook secret is under Settings -> Notifications -> Webhooks.
# -----------------------------------------------------------------------------
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret


# -----------------------------------------------------------------------------
# AI VOICE INTERVIEWER — makes the phone calls to the parent (Component 0).
# This is what makes RETOLD fully hands-off: no human interviewer.
#   Get keys at: https://vapi.ai  -> Dashboard -> API Keys
#   You also import/buy a phone number IN Vapi (the number it calls FROM) and
#   paste its id below. See interview/README.md.
# -----------------------------------------------------------------------------
VAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
VAPI_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional — the agent's own (asking) voice. Pick a warm, clear one.
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_ID=sarah
# Optional — shared secret so only Vapi can hit your call-finished webhook.
VAPI_WEBHOOK_SECRET=
# Optional pacing knobs for a local poll-based run (n8n uses webhooks instead).
# INTERVIEW_POLL_SECS=20
# INTERVIEW_MAX_WAIT_SECS=3600


# -----------------------------------------------------------------------------
# AI / MEDIA SERVICES — the engine uses these to build the book.
# -----------------------------------------------------------------------------
# Claude (Anthropic) — writes the chapters + runs the honesty QC pass AND drives
# the live interview conversation on each call.
#   Get it at: https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the model the writer uses (defaults to a sensible Claude).
# ANTHROPIC_MODEL=claude-opus-4-20250514

# AssemblyAI — transcribes the parent's interview recording (with speaker labels).
#   Get it at: https://www.assemblyai.com  -> Dashboard -> API key
ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# fal.ai — generates the warm painterly chapter illustrations (FLUX).
#   Get it at: https://fal.ai  -> Dashboard -> Keys
FAL_KEY=xxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# PRINT-ON-DEMAND — prints and drop-ships the physical book + the voice cards.
# -----------------------------------------------------------------------------
# Lulu — prints and ships the memory book.
#   Get keys at: https://developers.lulu.com  (use SANDBOX first!)
LULU_CLIENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
LULU_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
LULU_SANDBOX=true
# The Lulu catalog code for our 8.5x8.5 premium colour book (from Lulu's docs).
# LULU_POD_PACKAGE_ID=0850X0850FCPRESS080CW444GXX

# Peecho — prints the small personalised grandchild "voice cards".
#   Get it at: https://www.peecho.com  -> API access
PEECHO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# FILM (only for the "book_film" product) — the short memory movie.
# -----------------------------------------------------------------------------
# Shotstack — renders the film from the illustrations + the real voice clips.
#   Get it at: https://shotstack.io  -> Dashboard (stage key first, then prod)
SHOTSTACK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
SHOTSTACK_ENV=stage
# Optional soft background music bed (a public URL to a licensed track).
# MUSIC_URL=

# Bunny Stream — hosts/streams the finished film (optional; if you host video).
#   Get it at: https://bunny.net  -> Stream
BUNNY_STREAM_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
BUNNY_LIBRARY_ID=xxxxxx


# -----------------------------------------------------------------------------
# EMAIL — the "your book is being made / is on its way" status emails.
# -----------------------------------------------------------------------------
# Klaviyo — receives status events that trigger the customer-facing email Flows.
#   Get it at: https://www.klaviyo.com  -> Settings -> API keys (Private key)
KLAVIYO_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# CLOUDFLARE — private storage (R2) for audio + the family voice-page worker.
#   Account ID: Cloudflare dashboard -> right sidebar.
#   R2 keys:    Cloudflare dashboard -> R2 -> Manage R2 API Tokens.
# -----------------------------------------------------------------------------
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
CF_R2_BUCKET=retold-family
CF_R2_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
CF_R2_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# The public base URL the print service reads finished PDFs/assets from
# (e.g. an R2 custom domain or public bucket URL).
R2_PUBLIC_BASE=https://assets.retold.family


# -----------------------------------------------------------------------------
# BRAND / DOMAIN
# -----------------------------------------------------------------------------
# Your family-voice-page domain. Every printed QR code points at
# https://<RETOLD_DOMAIN>/f/<token>, so this must match the deployed Worker.
RETOLD_DOMAIN=retold.family
