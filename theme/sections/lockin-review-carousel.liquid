{%- comment -%}
  lockin — social-style review carousel.

  Comment-card look: avatar, name, context line, quote. Horizontal
  scroll-snap with arrow buttons; drag/swipe native.

  Same honesty rules as everywhere else: a card marked as placeholder renders
  a clean skeleton ("Verified review — coming soon") instead of any text, so
  nothing invented ever shows. Untick the checkbox once a real, attributable
  review fills the card. No star ratings, review counts or invented
  like-counts anywhere.
{%- endcomment -%}

<div class="lk lk-section lk-rc">
  <div class="lk-container lk-rc__headRow lk-reveal">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="lk-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lk-h2 lk-rc__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="lk-rc__nav">
      <button class="lk-rc__arrow" type="button" data-lockin-rc-prev aria-label="Previous reviews">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="lk-rc__arrow" type="button" data-lockin-rc-next aria-label="Next reviews">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M8 4l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>

  <div class="lk-rc__scroller lk-reveal" data-lockin-rc tabindex="0" role="region" aria-label="{{ section.settings.heading | default: 'Reviews' | escape }}">
    <ul class="lk-rc__track">
      {%- for block in section.blocks -%}
        {%- if block.settings.is_placeholder -%}
          {%- comment -%} Reserved slot: skeleton only — no invented reviewer, no invented quote. {%- endcomment -%}
          {%- assign w = forloop.index0 | modulo: 3 -%}
          <li class="lk-rc__card lk-rc__card--pending" {{ block.shopify_attributes }}>
            <div class="lk-rc__who" aria-hidden="true">
              <span class="lk-rc__avatar lk-rc__avatar--pending"></span>
              <span class="lk-rc__whoText">
                <span class="lk-rc__bar" style="inline-size: {% case w %}{% when 0 %}44%{% when 1 %}36%{% else %}52%{% endcase %}"></span>
                <span class="lk-rc__bar lk-rc__bar--soft" style="inline-size: {% case w %}{% when 0 %}62%{% when 1 %}70%{% else %}56%{% endcase %}"></span>
              </span>
            </div>
            <div class="lk-rc__pendingBody" aria-hidden="true">
              <span class="lk-rc__bar lk-rc__bar--line"></span>
              <span class="lk-rc__bar lk-rc__bar--line" style="inline-size: {% case w %}{% when 0 %}86%{% when 1 %}92%{% else %}78%{% endcase %}"></span>
              <span class="lk-rc__bar lk-rc__bar--line" style="inline-size: {% case w %}{% when 0 %}56%{% when 1 %}44%{% else %}64%{% endcase %}"></span>
            </div>
            <p class="lk-rc__pending">
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.5"/><path d="m7 10.2 2.1 2.1L13.2 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Verified review — coming soon
            </p>
          </li>
        {%- else -%}
        <li class="lk-rc__card" {{ block.shopify_attributes }}>
          <div class="lk-rc__who">
            {%- if block.settings.avatar != blank -%}
              <img class="lk-rc__avatar" src="{{ block.settings.avatar | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">
            {%- else -%}
              {%- assign initial = block.settings.name | strip | slice: 0, 1 | upcase | default: '?' -%}
              <span class="lk-rc__avatar lk-rc__avatar--initial" aria-hidden="true">{{ initial }}</span>
            {%- endif -%}
            <span class="lk-rc__whoText">
              <span class="lk-rc__name">{{ block.settings.name }}</span>
              {%- if block.settings.context != blank -%}
                <span class="lk-rc__context">{{ block.settings.context }}</span>
              {%- endif -%}
            </span>
          </div>

          <blockquote class="lk-rc__quote"><p>{{ block.settings.quote }}</p></blockquote>

          {%- if block.settings.footer != blank -%}
            <p class="lk-rc__footer">
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 16.5S3.5 12.6 3.5 8.2c0-2 1.6-3.7 3.6-3.7 1.2 0 2.3.6 2.9 1.5.6-.9 1.7-1.5 2.9-1.5 2 0 3.6 1.7 3.6 3.7 0 4.4-6.5 8.3-6.5 8.3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              {{ block.settings.footer }}
            </p>
          {%- endif -%}
        </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  {%- if section.settings.note != blank -%}
    <div class="lk-container">
      <p class="lk-rc__note">{{ section.settings.note }}</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .lk-rc {
    overflow: hidden;
  }

  .lk-rc__headRow {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .lk-rc__heading {
    margin-top: 12px;
  }

  .lk-rc__nav {
    display: flex;
    gap: 8px;
    flex: none;
  }

  .lk-rc__arrow {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--lk-r-pill);
    border: 1px solid var(--lk-line-strong);
    background: var(--lk-paper);
    color: var(--lk-ink);
    cursor: pointer;
    transition: background-color 0.2s var(--lk-ease);
  }

  .lk-rc__arrow:hover {
    background: var(--lk-ice);
  }

  .lk-rc__arrow svg {
    inline-size: 18px;
    block-size: 18px;
  }

  .lk-rc__scroller {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: var(--lk-gutter);
  }

  .lk-rc__scroller::-webkit-scrollbar {
    display: none;
  }

  .lk-rc__track {
    display: flex;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0 var(--lk-gutter) 6px 0;
    inline-size: max-content;
  }

  .lk-rc__card {
    scroll-snap-align: start;
    inline-size: min(82vw, 360px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px 22px 20px;
    border-radius: var(--lk-r-lg);
    background: var(--lk-ice-soft);
    border: 1px solid var(--lk-line);
  }

  /* Reserved (placeholder) cards: quiet skeleton, same geometry as real cards. */
  .lk-rc__card--pending {
    background: var(--lk-paper);
  }

  .lk-rc__card--pending .lk-rc__whoText {
    gap: 7px;
    flex: 1;
  }

  .lk-rc__avatar--pending {
    background: var(--lk-ice);
  }

  .lk-rc__bar {
    display: block;
    inline-size: 100%;
    block-size: 10px;
    border-radius: var(--lk-r-pill);
    background: color-mix(in srgb, var(--lk-ink) 8%, transparent);
  }

  .lk-rc__bar--soft {
    block-size: 8px;
    background: color-mix(in srgb, var(--lk-ink) 5%, transparent);
  }

  .lk-rc__bar--line {
    block-size: 9px;
    background: color-mix(in srgb, var(--lk-ink) 6%, transparent);
  }

  .lk-rc__pendingBody {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-block: 4px 2px;
  }

  .lk-rc__pending {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--lk-muted);
  }

  .lk-rc__pending svg {
    inline-size: 15px;
    block-size: 15px;
    color: var(--lk-accent);
  }

  .lk-rc__who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lk-rc__avatar {
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--lk-r-pill);
    object-fit: cover;
    flex: none;
  }

  .lk-rc__avatar--initial {
    display: grid;
    place-items: center;
    background: var(--lk-accent);
    color: var(--lk-ink);
    font-family: var(--lk-font-head);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .lk-rc__whoText {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .lk-rc__name {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .lk-rc__context {
    font-size: 0.8125rem;
    color: var(--lk-muted);
  }

  .lk-rc__quote {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--lk-ink);
    text-wrap: pretty;
  }

  .lk-rc__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8125rem;
    color: var(--lk-muted);
  }

  .lk-rc__footer svg {
    inline-size: 16px;
    block-size: 16px;
    color: var(--lk-accent);
  }

  .lk-rc__note {
    margin-top: 22px;
    font-size: 0.8125rem;
    color: var(--lk-muted);
    max-width: 70ch;
  }

  @media screen and (min-width: 990px) {
    .lk-rc__scroller {
      padding-inline: max(var(--lk-gutter), calc((100vw - var(--lk-maxw)) / 2));
    }

    .lk-rc__card {
      inline-size: 350px;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    function init(scroller) {
      if (scroller.dataset.lockinReady === 'true') return;
      scroller.dataset.lockinReady = 'true';
      var section = scroller.closest('.shopify-section') || document;
      var step = function () {
        var card = scroller.querySelector('.lk-rc__card');
        return card ? card.getBoundingClientRect().width + 14 : 320;
      };
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var go = function (dir) {
        scroller.scrollBy({ left: dir * step(), behavior: reduce.matches ? 'auto' : 'smooth' });
      };
      section.querySelector('[data-lockin-rc-prev]')?.addEventListener('click', function () { go(-1); });
      section.querySelector('[data-lockin-rc-next]')?.addEventListener('click', function () { go(1); });
    }

    function scan() {
      document.querySelectorAll('[data-lockin-rc]').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scan);
    } else {
      scan();
    }
    document.addEventListener('shopify:section:load', scan);
  })();
</script>

{% schema %}
{
  "name": "lockin review carousel",
  "tag": "section",
  "class": "lockin-rc-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In their words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What people say."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note under the carousel",
      "info": "Clear this once real reviews fill the cards.",
      "default": "Reviews from verified customers appear here as they come in."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_placeholder",
          "label": "Reserved slot (no real review yet)",
          "info": "Renders a clean skeleton card. Untick once the fields below hold a real, verifiable customer review.",
          "default": true
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "context",
          "label": "Context line",
          "info": "e.g. Verified buyer"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar",
          "info": "Falls back to an initial."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "footer",
          "label": "Footer line",
          "info": "Optional, e.g. what they bought. No invented like-counts."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "lockin review carousel",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
