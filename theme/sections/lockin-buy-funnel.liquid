  }

  .lk-vh-input:checked + .lk-purchase__label {
    border-color: var(--lk-ink);
    background: var(--lk-ice-soft);
  }

  .lk-purchase__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .lk-purchase__name {
    font-size: 0.9375rem;
    font-weight: 600;
