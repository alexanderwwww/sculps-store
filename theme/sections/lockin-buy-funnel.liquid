  }

  .lk-bundle__soldout {
    font-size: 0.75rem;
    color: var(--lk-muted);
  }

  .lk-bundle__badge {
    position: absolute;
    top: -9px;
    left: 16px;
    right: auto;
    padding: 4px 12px;
    border-radius: var(--lk-r-pill);
    background: var(--lk-accent);
    color: var(--lk-ink);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--lk-accent) 45%, transparent);
  }

  .lk-vh-input:checked + .lk-bundle__label {
    box-shadow: 0 0 0 1.5px var(--lk-ink);
  }

  /* ---------- Sticky bar ---------- */

  .lk-stickybar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--lk-paper) 92%, transparent);
    backdrop-filter: saturate(140%) blur(16px);
    -webkit-backdrop-filter: saturate(140%) blur(16px);
    border-top: 1px solid var(--lk-line);
    padding-block: 10px;
    padding-bottom: max(10px, env(safe-area-inset-bottom));
    transform: translateY(100%);
    visibility: hidden;
    transition: transform 0.32s var(--lk-ease), visibility 0s linear 0.32s;
  }

  .lk-stickybar.is-visible {
    transform: none;
    visibility: visible;
    transition: transform 0.32s var(--lk-ease), visibility 0s linear 0s;
  }

  .lk-stickybar__inner {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .lk-stickybar__thumb {
    flex: none;
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--lk-r-sm);
    border: 1px solid var(--lk-line);
    object-fit: cover;
    background: var(--lk-ice-soft);
  }

  .lk-stickybar__info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .lk-stickybar__title {
    font-family: var(--lk-font-head);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lk-stickybar__meta {
    display: flex;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--lk-muted);
    white-space: nowrap;
  }

  .lk-stickybar .lk-stickybar__btn {
    margin-left: auto;
    flex: none;
    min-height: 46px;
    padding-inline: 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lk-stickybar {
      transition: none;
    }
  }

  /* ---------- Form ---------- */

  .lk-bf__form {
    margin-top: 24px;
  }

  .lk-bf__fieldset {
    margin: 0 0 18px;
    padding: 0;
    border: 0;
  }

  .lk-bf__legend {
    padding: 0;
    margin-bottom: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--lk-muted);
  }

  .lk-bundle__saving {
    margin-left: 8px;
    color: var(--lk-ink);
    font-weight: 600;
  }

  /* ---------- Order bump ---------- */

  .lk-bump {
    margin: 0 0 16px;
  }

  .lk-bump__label {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: var(--lk-r-md);
    border: 1.5px dashed color-mix(in srgb, var(--lk-accent) 65%, var(--lk-line));
    background: color-mix(in srgb, var(--lk-accent) 8%, var(--lk-paper));
    cursor: pointer;
    transition: border-color 0.2s var(--lk-ease), background-color 0.2s var(--lk-ease);
  }

  .lk-checkbox {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 21px;
    block-size: 21px;
    border-radius: 6px;
    border: 1.5px solid var(--lk-line-strong);
    background: var(--lk-paper);
    color: var(--lk-paper);
    transition: background-color 0.18s var(--lk-ease), border-color 0.18s var(--lk-ease);
  }

  .lk-checkbox svg {
    inline-size: 12px;
    block-size: 12px;
    opacity: 0;
    transition: opacity 0.18s var(--lk-ease);
  }

  .lk-vh-input:checked + .lk-bump__label {
    border-style: solid;
    border-color: var(--lk-ink);
    background: var(--lk-ice-soft);
  }

  .lk-vh-input:checked + .lk-bump__label .lk-checkbox {
    background: var(--lk-ink);
    border-color: var(--lk-ink);
  }

  .lk-vh-input:checked + .lk-bump__label .lk-checkbox svg {
    opacity: 1;
  }

  .lk-bump__thumb {
    flex: none;
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--lk-r-sm);
    border: 1px solid var(--lk-line);
    object-fit: cover;
    background: var(--lk-ice-soft);
  }

  .lk-bump__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .lk-bump__name {
    font-family: var(--lk-font-head);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }

  .lk-bump__meta {
    font-size: 0.8125rem;
    color: var(--lk-muted);
  }

  .lk-bump__price {
    margin-left: auto;
    flex: none;
    font-family: var(--lk-font-head);
    font-weight: 600;
    font-size: 1rem;
  }

  .lk-bf__submit {
    margin-top: 4px;
  }

  .lk-bf__reassurance {
    margin-top: 12px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--lk-muted);
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .lk-bf__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }

    .lk-bf__mediaSticky {
      position: sticky;
      top: var(--header-height, 0px);
    }

    .lk-bf__stage {
      min-block-size: calc(100svh - var(--header-height, 76px) - 90px);
      display: grid;
    }

    .lk-bf__thumbs {
      display: flex;
    }

    .lk-bf__hero {
      block-size: 100%;
      aspect-ratio: auto;
      max-block-size: none;
    }

    .lk-bf__glass {
      padding: 18px 28px 20px;
    }

    .lk-bf__panel {
      padding: 48px 56px 96px;
      justify-self: start;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    function init(root) {
      if (!root || root.dataset.lockinReady === 'true') return;
      root.dataset.lockinReady = 'true';

      var form = root.querySelector('form');
      var variantInput = root.querySelector('[data-lockin-variant-input]');
      var planInput = root.querySelector('[data-lockin-plan-input]');
      var priceEl = root.querySelector('[data-lockin-price]');
      var wasEl = root.querySelector('[data-lockin-was]');
      var saveEl = root.querySelector('[data-lockin-save]');
      var perDayEl = root.querySelector('[data-lockin-perday]');
      var liveEl = root.querySelector('[data-lockin-live]');
      var submitEl = root.querySelector('[data-lockin-submit]');
      var sentinel = root.querySelector('[data-lockin-sentinel]');

      var bundles = Array.prototype.slice.call(root.querySelectorAll('[data-lockin-bundle]'));
      var purchases = Array.prototype.slice.call(root.querySelectorAll('[data-lockin-purchase]'));

      var section = root.closest('.shopify-section') || document;
      var bar = section.querySelector('[data-lockin-stickybar]');

      function selectedBundle() {
        return bundles.filter(function (input) { return input.checked; })[0];
      }

      function selectedMode() {
        var checked = purchases.filter(function (input) { return input.checked; })[0];
        return checked ? checked.value : 'onetime';
      }

      function render() {
        var bundle = selectedBundle();
        if (!bundle) return;

        var mode = selectedMode();
        var subscribing = mode === 'subscribe';
        var price = subscribing ? bundle.dataset.priceSubscribe : bundle.dataset.priceOnetime;
        var oneTime = bundle.dataset.priceOnetime;
        var compare = bundle.dataset.compare;

        if (priceEl) priceEl.textContent = price;

        var struck = subscribing ? oneTime : compare;
        if (wasEl) {
          if (struck) {
            wasEl.textContent = struck;
            wasEl.hidden = false;
          } else {
            wasEl.hidden = true;
          }
        }

        if (saveEl) {
          var pct = subscribing
            ? parseInt(root.dataset.subDiscount || '0', 10)
            : parseInt(bundle.dataset.savePct || '0', 10);
          if (pct > 0) {
            saveEl.textContent = 'Save ' + pct + '%';
            saveEl.hidden = false;
          } else {
            saveEl.hidden = true;
          }
        }

        if (perDayEl) perDayEl.textContent = bundle.dataset.perDay ? bundle.dataset.perDay + ' / day' : '';

        bundles.forEach(function (input) {
          var id = input.dataset.variantId;
          var perBox = section.querySelector('[data-lockin-perbox-for="' + id + '"]');
          var total = section.querySelector('[data-lockin-bundleprice-for="' + id + '"]');
          if (perBox) perBox.textContent = subscribing ? input.dataset.perBoxSubscribe : input.dataset.perBoxOnetime;
          if (total) total.textContent = subscribing ? input.dataset.priceSubscribe : input.dataset.priceOnetime;
        });

        variantInput.value = bundle.dataset.variantId;

        var subscribeRadio = purchases.filter(function (input) { return input.value === 'subscribe'; })[0];
        var planId = subscribeRadio ? subscribeRadio.dataset.sellingPlan : '';
        if (subscribing && planId) {
          planInput.value = planId;
          planInput.disabled = false;
        } else {
          planInput.value = '';
          planInput.disabled = true;
        }

        if (liveEl) {
          liveEl.textContent = bundle.dataset.label + ' — ' + price + (subscribing ? ', subscription' : ', one-time');
        }

        if (bar) {
          var barLabel = bar.querySelector('[data-lockin-sticky-label]');
          var barPrice = bar.querySelector('[data-lockin-sticky-price]');
          if (barLabel) barLabel.textContent = bundle.dataset.label;
          if (barPrice) barPrice.textContent = price;
        }
      }

      bundles.concat(purchases).forEach(function (input) {
        input.addEventListener('change', render);
      });

      render();

      /* Gallery: swipeable track, dots + thumbs stay in sync. */
      var track = root.querySelector('[data-lockin-track]');
      if (track) {
        var slides = Array.prototype.slice.call(track.querySelectorAll('[data-lockin-slide]'));
        var dots = Array.prototype.slice.call(root.querySelectorAll('.lk-bf__dot'));
        var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-lockin-thumb]'));
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

        function markActive(index) {
          dots.forEach(function (dot, i) {
            dot.classList.toggle('is-active', i === index);
          });
          thumbs.forEach(function (thumb, i) {
            thumb.classList.toggle('is-active', i === index);
            thumb.setAttribute('aria-pressed', i === index ? 'true' : 'false');
          });
        }

        var raf = null;
        track.addEventListener('scroll', function () {
          if (raf) return;
          raf = requestAnimationFrame(function () {
            raf = null;
            var index = Math.round(track.scrollLeft / track.clientWidth);
            markActive(Math.max(0, Math.min(slides.length - 1, index)));
          });
        });

        thumbs.forEach(function (thumb) {
          thumb.addEventListener('click', function () {
            var index = parseInt(thumb.dataset.index || '0', 10);
            track.scrollTo({
              left: index * track.clientWidth,
              behavior: reduce.matches ? 'auto' : 'smooth',
            });
          });
        });
      }

      /* Mini-FAQ carousel arrows */
      var faqCar = root.querySelector('[data-lockin-faqcar]');
      if (faqCar) {
        var faqTrack = faqCar.querySelector('.lk-bf__faqTrack');
        var faqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        var faqStep = function () {
          var card = faqCar.querySelector('.lk-bf__faqCard');
          return card ? card.getBoundingClientRect().width + 12 : 300;
        };
        var faqGo = function (dir) {
          if (faqTrack) faqTrack.scrollBy({ left: dir * faqStep(), behavior: faqReduce.matches ? 'auto' : 'smooth' });
        };
        faqCar.querySelector('[data-lockin-faq-prev]')?.addEventListener('click', function () { faqGo(-1); });
        faqCar.querySelector('[data-lockin-faq-next]')?.addEventListener('click', function () { faqGo(1); });
      }

      /* Sticky bar: IntersectionObserver drives it, plus a scroll fallback so
         a fast jump-scroll past the sentinel can't leave it stuck. */
      if (bar && sentinel) {
        bar.hidden = false;
        bar.setAttribute('inert', '');
        var setBar = function (past) {
          bar.classList.toggle('is-visible', past);
          if (past) {
            bar.removeAttribute('inert');
          } else {
            bar.setAttribute('inert', '');
          }
        };
        var syncBar = function () {
          setBar(sentinel.getBoundingClientRect().top < 0);
        };
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(function () { syncBar(); }, { threshold: 0 }).observe(sentinel);
        }
        var barRaf = null;
        window.addEventListener('scroll', function () {
          if (barRaf) return;
          barRaf = requestAnimationFrame(function () { barRaf = null; syncBar(); });
        }, { passive: true });
        syncBar();
      }

      /* Add to cart */
      if (!form) return;
      form.addEventListener('submit', function (event) {
        if (!window.fetch) return;
        event.preventDefault();

        var buttons = [submitEl, section.querySelector('[data-lockin-sticky-submit]')].filter(Boolean);
        buttons.forEach(function (button) { button.disabled = true; });

        var addUrl = (window.Theme && Theme.routes && Theme.routes.cart_add_url) || '/cart/add';
        var cartUrl = root.dataset.cartUrl || '/cart';

        var items = [{ id: Number(variantInput.value), quantity: 1 }];
        if (planInput && !planInput.disabled && planInput.value) {
          items[0].selling_plan = Number(planInput.value);
        }
        var bump = root.querySelector('[data-lockin-bump]');
        if (bump && bump.checked) {
          items.push({ id: Number(bump.value), quantity: 1 });
        }

        fetch(addUrl + '.js', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ items: items }),
        })
          .then(function (response) {
            return response.json().then(function (data) {
              if (!response.ok) throw new Error(data.description || data.message || 'Add to cart failed');
              return data;
            });
          })
          .then(function () {
            return fetch(cartUrl + '.js', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
              .then(function (r) { return r.ok ? r.json() : null; })
              .catch(function () { return null; });
          })
          .then(function (cart) {
            if (cart) {
              document.dispatchEvent(new CustomEvent('lockin:cart:updated', { detail: { itemCount: cart.item_count } }));
            }
            var behaviour = root.dataset.afterAdd || 'drawer';
            if (behaviour === 'checkout') { window.location.href = '/checkout'; return; }
            if (behaviour === 'cart') { window.location.href = cartUrl; return; }

            var drawerComponent = document.querySelector('cart-drawer-component');
            var host = drawerComponent && drawerComponent.closest ? drawerComponent.closest('theme-drawer') : null;
            var items = document.querySelector('cart-items-component');

            Promise.resolve(items && items.fetchCartData ? items.fetchCartData() : null)
              .catch(function () {})
              .then(function () {
                if (host && typeof host.open === 'function') {
                  host.open();
                  buttons.forEach(function (button) { button.disabled = false; });
                } else {
                  window.location.href = cartUrl;
                }
              });
          })
          .catch(function (error) {
            if (liveEl) liveEl.textContent = error.message || 'Something went wrong. Please try again.';
            buttons.forEach(function (button) { button.disabled = false; });
          });
      });
    }

    function scan() {
      document.querySelectorAll('[data-lockin-buy]').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scan);
    } else {
      scan();
    }
    document.addEventListener('shopify:section:load', scan);
  })();
</script>

