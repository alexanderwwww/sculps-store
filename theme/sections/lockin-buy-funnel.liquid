    padding: 12px 14px;
    border-radius: var(--lk-r-sm);
    border: 1px dashed var(--lk-accent);
    background: color-mix(in srgb, var(--lk-accent) 10%, transparent);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--lk-ink);
  }

  .lk-bundles__list {
    display: grid;
    gap: 10px;
  }

  .lk-bundle {
    position: relative;
  }

  .lk-bundle__label {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 18px 16px;
