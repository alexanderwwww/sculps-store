      top: var(--header-height, 0px);
    }

    .lk-bf__stage {
      min-block-size: calc(100svh - var(--header-height, 76px) - 90px);
      display: grid;
    }

    .lk-bf__hero {
      block-size: 100%;
      max-block-size: none;
    }

    .lk-bf__glass {
