{%- comment -%}
  lockin — buy funnel (product page main).

  Funnel order, top to bottom:
    full-bleed product media with glass bullet pills over it
    title + description
    price
    offer banner
    small FAQ
    purchase type + bundle cards + add to cart
  plus the sticky add-to-cart bar once the funnel scrolls past.

  Bundle cards are driven by the product's own variants and labelled by
  blocks matched in order (bundle blocks only), so the mapping cannot drift.

  Subscribe pricing: with a selling plan present the option submits a real
  `selling_plan`; without one it renders disabled with a note, so no
  customer is shown a price the store cannot honour.
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product | default: product

  assign discount = section.settings.subscribe_discount
  assign remainder = 100 | minus: discount

  assign sp_group = product.selling_plan_groups | first
  assign selling_plan = sp_group.selling_plans | first
  assign has_selling_plans = false
  if selling_plan != blank
    assign has_selling_plans = true
  endif

  assign form_id = 'lockin-buy-' | append: section.id

  assign hero = section.settings.hero_image
  if hero == blank
    assign hero = product.featured_image
  endif
-%}

{%- if product == blank -%}
  {%- if request.design_mode -%}
    <div class="lk lk-section"><div class="lk-container"><p class="lk-body">Select a product in this section's settings.</p></div></div>
  {%- endif -%}
{%- else -%}
  <div
    class="lk lk-bf"
    data-lockin-buy
    data-after-add="{{ section.settings.after_add }}"
    data-cart-url="{{ routes.cart_url }}"
    data-sub-discount="{{ discount }}"
  >
    <div class="lk-bf__grid">
      {%- comment -%} ---------- Full-bleed media ---------- {%- endcomment -%}
      <div class="lk-bf__mediaCol">
        <div class="lk-bf__mediaSticky">
          <div class="lk-bf__stage">
            {%- if product.media.size > 0 -%}
              {%- comment -%} Full-bleed swipeable gallery of every product image. {%- endcomment -%}
              <div class="lk-bf__track" data-lockin-track tabindex="0" aria-label="Product images">
                {%- for media in product.media -%}
                  <div class="lk-bf__slide" data-lockin-slide>
                    <img
                      class="lk-bf__hero"
                      src="{{ media | image_url: width: 1400 }}"
                      srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1400 }} 1400w, {{ media | image_url: width: 2000 }} 2000w"
                      sizes="(min-width: 990px) 55vw, 100vw"
                      alt="{{ media.alt | default: product.title | escape }}"
                      {% if forloop.first %}
                        loading="eager"
                        fetchpriority="high"
                      {% else %}
                        loading="lazy"
                      {% endif %}
                    >
                  </div>
                {%- endfor -%}
              </div>

              {%- if product.media.size > 1 -%}
                <div class="lk-bf__dots" data-lockin-dots aria-hidden="true">
                  {%- for media in product.media -%}
                    <span class="lk-bf__dot{% if forloop.first %} is-active{% endif %}"></span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'lk-bf__hero' }}
            {%- endif -%}

            {%- comment -%} Image stays clean — benefits render in the panel below. {%- endcomment -%}
          </div>

          {%- if product.media.size > 1 -%}
            <ul class="lk-bf__thumbs" aria-label="Jump to image">
              {%- for media in product.media -%}
                <li>
                  <button
                    class="lk-bf__thumb{% if forloop.first %} is-active{% endif %}"
                    type="button"
                    data-lockin-thumb
                    data-index="{{ forloop.index0 }}"
                    aria-label="Show image {{ forloop.index }} of {{ product.media.size }}"
                    aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  >
                    <img src="{{ media | image_url: width: 200 }}" alt="" width="100" height="100" loading="lazy">
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ---------- Funnel column ---------- {%- endcomment -%}
      <div class="lk-bf__panel">
        {%- if section.settings.eyebrow != blank -%}
          <p class="lk-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h1 class="lk-bf__title">{{ section.settings.title | default: product.title }}</h1>

        {%- if section.settings.subtitle != blank -%}
          <p class="lk-bf__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- assign has_benefits = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'glass' and block.settings.text != blank -%}
            {%- assign has_benefits = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if has_benefits -%}
          <ul class="lk-bf__benefits" aria-label="Benefits">
            {%- for block in section.blocks -%}
              {%- if block.type == 'glass' and block.settings.text != blank -%}
                <li class="lk-bf__benefit" {{ block.shopify_attributes }}>
                  <span class="lk-bf__benefitTick" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none"><path d="m3.5 8.4 3 3L12.8 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  {{ block.settings.text }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- assign has_badges = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' and block.settings.label != blank -%}{%- assign has_badges = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_badges -%}
          <ul class="lk-pills lk-bf__pills">
            {%- for block in section.blocks -%}
              {%- if block.type == 'badge' and block.settings.label != blank -%}
                <li class="lk-pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} ---------- Price ---------- {%- endcomment -%}
        <div class="lk-bf__priceRow">
          <span class="lk-bf__price" data-lockin-price>
            {{- product.selected_or_first_available_variant.price | money -}}
          </span>
          <s class="lk-bf__was" data-lockin-was hidden></s>
          <span class="lk-bf__save" data-lockin-save hidden></span>
          {%- if section.settings.offer_pill != blank -%}
            <span class="lk-bf__offerPill">{{ section.settings.offer_pill }}</span>
          {%- endif -%}
          <span class="lk-bf__perday" data-lockin-perday></span>
        </div>
        {%- if section.settings.offer_text != blank -%}
          <p class="lk-bf__offerLine">{{ section.settings.offer_text }}</p>
        {%- endif -%}
        <p class="lk-bf__liveNote" data-lockin-live aria-live="polite"></p>

        {%- comment -%} ---------- Small FAQ ---------- {%- endcomment -%}
        {%- assign has_minifaq = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' and block.settings.question != blank -%}{%- assign has_minifaq = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_minifaq -%}
          <div class="lk-bf__faqCar" data-lockin-faqcar>
            <ul class="lk-bf__faqTrack">
              {%- for block in section.blocks -%}
                {%- if block.type == 'faq' and block.settings.question != blank -%}
                  <li class="lk-bf__faqCard" {{ block.shopify_attributes }}>
                    <p class="lk-bf__faqQ">{{ block.settings.question }}</p>
                    <p class="lk-bf__faqA">{{ block.settings.answer }}</p>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            <div class="lk-bf__faqNav" aria-hidden="true">
              <button class="lk-bf__faqArrow" type="button" data-lockin-faq-prev aria-label="Previous question">
                <svg viewBox="0 0 20 20" fill="none"><path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="lk-bf__faqArrow" type="button" data-lockin-faq-next aria-label="Next question">
                <svg viewBox="0 0 20 20" fill="none"><path d="M8 4l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} ---------- Bundles + purchase ---------- {%- endcomment -%}
        {%- form 'product', product, id: form_id, class: 'lk-bf__form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-lockin-variant-input>
          <input type="hidden" name="selling_plan" value="" data-lockin-plan-input disabled>
          <input type="hidden" name="quantity" value="1">

          {%- comment -%}
            The subscribe/one-time chooser renders only when the product has a
            real selling plan — a disabled option is buy-box noise. It appears
            automatically the moment a subscriptions app adds a plan.
          {%- endcomment -%}
          {%- if has_selling_plans -%}
            <fieldset class="lk-bf__fieldset lk-purchase">
              <legend class="lk-bf__legend">{{ section.settings.purchase_legend }}</legend>
              <div class="lk-purchase__options">
                <div class="lk-purchase__option">
                  <input
                    class="lk-vh-input"
                    type="radio"
                    name="lockin-purchase-type"
                    id="{{ section.id }}-sub"
                    value="subscribe"
                    data-lockin-purchase="subscribe"
                    data-selling-plan="{{ selling_plan.id }}"
                  >
                  <label class="lk-purchase__label" for="{{ section.id }}-sub">
                    <span class="lk-radio" aria-hidden="true"></span>
                    <span class="lk-purchase__text">
                      <span class="lk-purchase__name">{{ section.settings.subscribe_label }}</span>
                      <span class="lk-purchase__meta">{{ section.settings.subscribe_note }}</span>
                    </span>
                    <span class="lk-purchase__tag">Save {{ discount }}%</span>
                  </label>
                </div>
                <div class="lk-purchase__option">
                  <input
                    class="lk-vh-input"
                    type="radio"
                    name="lockin-purchase-type"
                    id="{{ section.id }}-once"
                    value="onetime"
                    data-lockin-purchase="onetime"
                    checked
                  >
                  <label class="lk-purchase__label" for="{{ section.id }}-once">
                    <span class="lk-radio" aria-hidden="true"></span>
                    <span class="lk-purchase__text">
                      <span class="lk-purchase__name">{{ section.settings.onetime_label }}</span>
                      <span class="lk-purchase__meta">{{ section.settings.onetime_note }}</span>
                    </span>
                  </label>
                </div>
              </div>
            </fieldset>
          {%- elsif request.design_mode -%}
            <p class="lk-editor-todo">
              <strong>Subscriptions hidden.</strong>
              No selling plan on this product yet, so the subscribe/one-time chooser is not shown
              to customers. Install a subscriptions app and add a {{ discount }}% plan — the
              chooser appears automatically.
            </p>
          {%- endif -%}

          <fieldset class="lk-bf__fieldset lk-bundles">
            <legend class="lk-bf__legend">{{ section.settings.bundle_legend }}</legend>
            <div class="lk-bundles__steps" aria-hidden="true">
              <span><b>1</b> Pick your supply</span>
              <span><b>2</b> Add to cart</span>
              <span><b>3</b> Ships free on 3+ months</span>
            </div>
            <div class="lk-bundles__list">
              {%- for variant in product.variants -%}
                {%- liquid
                  # Match the nth variant to the nth block of type "bundle".
                  assign want = forloop.index
                  assign seen = 0
                  assign block = blank
                  for candidate in section.blocks
                    if candidate.type == 'bundle'
                      assign seen = seen | plus: 1
                      if seen == want
                        assign block = candidate
                        break
                      endif
                    endif
                  endfor

                  assign months = block.settings.months | default: forloop.index
                  if months < 1
                    assign months = 1
                  endif
                  assign days = months | times: 30

                  assign sub_price = 0
                  if has_selling_plans
                    for allocation in variant.selling_plan_allocations
                      if allocation.selling_plan_id == selling_plan.id
                        assign sub_price = allocation.price
                      endif
                    endfor
                  endif
                  if sub_price == 0
                    assign sub_price = variant.price | times: remainder | divided_by: 100
                  endif

                  assign per_box = variant.price | divided_by: months
                  assign per_box_sub = sub_price | divided_by: months
                  assign per_day = variant.price | divided_by: days

                  assign save_pct = 0
                  assign save_amt = 0
                  if variant.compare_at_price > variant.price
                    assign save_pct = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                    assign save_amt = variant.compare_at_price | minus: variant.price
                  endif
                -%}
                <div class="lk-bundle">
                  <input
                    class="lk-vh-input"
                    type="radio"
                    name="lockin-bundle"
                    id="{{ section.id }}-v{{ variant.id }}"
                    value="{{ variant.id }}"
                    data-lockin-bundle
                    data-variant-id="{{ variant.id }}"
                    data-available="{{ variant.available }}"
                    data-price-onetime="{{ variant.price | money }}"
                    data-price-subscribe="{{ sub_price | money }}"
                    data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                    data-per-box-onetime="{{ per_box | money }}"
                    data-per-box-subscribe="{{ per_box_sub | money }}"
                    data-per-day="{{ per_day | money }}"
                    data-save-pct="{{ save_pct }}"
                    data-label="{{ block.settings.label | default: variant.title | escape }}"
                    {% if forloop.index == section.settings.default_bundle %}checked{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                  <label class="lk-bundle__label" for="{{ section.id }}-v{{ variant.id }}">
                    <span class="lk-radio" aria-hidden="true"></span>
                    {%- if product.featured_image -%}
                      <img class="lk-bundle__thumb" src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="46" height="46" loading="lazy">
                    {%- endif -%}
                    <span class="lk-bundle__main">
                      <span class="lk-bundle__name">{{ block.settings.label | default: variant.title }}</span>
                      <span class="lk-bundle__sub">{{ block.settings.sublabel | default: variant.title }}</span>
                      <span class="lk-bundle__perbox">
                        <span data-lockin-perbox-for="{{ variant.id }}">{{ per_box | money }}</span>
                        {{ section.settings.per_box_suffix }}
                      </span>
                    </span>
                    <span class="lk-bundle__pricing">
                      {%- if save_amt > 0 -%}
                        <span class="lk-bundle__saveamt">Save {{ save_amt | money }}</span>
                      {%- endif -%}
                      {%- if variant.compare_at_price > variant.price -%}
                        <s class="lk-bundle__was">{{ variant.compare_at_price | money }}</s>
                      {%- endif -%}
                      <span class="lk-bundle__now" data-lockin-bundleprice-for="{{ variant.id }}">
                        {{- variant.price | money -}}
                      </span>
                      {%- unless variant.available -%}
                        <span class="lk-bundle__soldout">Sold out</span>
                      {%- endunless -%}
                    </span>
                    {%- if block.settings.badge != blank -%}
                      <span class="lk-bundle__badge">{{ block.settings.badge }}</span>
                    {%- endif -%}
                  </label>
                </div>
              {%- endfor -%}
            </div>
          </fieldset>

          {%- comment -%}
            Order bump: one-tap add-on. Renders only when the boost product is
            active and purchasable — a checkbox that charges for a draft or
            out-of-stock product would be a chargeback machine.
          {%- endcomment -%}
          {%- assign boost = section.settings.boost_product -%}
          {%- assign boost_variant = boost.selected_or_first_available_variant -%}
          {%- if boost != blank and boost_variant != blank and boost_variant.available -%}
            <div class="lk-bump">
              <input
                class="lk-vh-input"
                type="checkbox"
                id="{{ section.id }}-bump"
                value="{{ boost_variant.id }}"
                data-lockin-bump
              >
              <label class="lk-bump__label" for="{{ section.id }}-bump">
                <span class="lk-checkbox" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none"><path d="m3.5 8.4 3 3L12.8 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {%- if boost.featured_image -%}
                  <img class="lk-bump__thumb" src="{{ boost.featured_image | image_url: width: 120 }}" alt="" width="44" height="44" loading="lazy">
                {%- endif -%}
                <span class="lk-bump__text">
                  <span class="lk-bump__name">{{ section.settings.boost_label | default: boost.title }}</span>
                  {%- if section.settings.boost_note != blank -%}
                    <span class="lk-bump__meta">{{ section.settings.boost_note }}</span>
                  {%- endif -%}
                </span>
                <span class="lk-bump__price">+{{ boost_variant.price | money }}</span>
              </label>
            </div>
          {%- elsif request.design_mode -%}
            <p class="lk-editor-todo">
              <strong>Boost hidden.</strong>
              Select an <em>active, in-stock</em> product under Boost add-on in this
              section's settings — the one-tap add appears here automatically.
            </p>
          {%- endif -%}

          <button class="lk-btn lk-btn--primary lk-btn--block lk-bf__submit" type="submit" data-lockin-submit>
            {{ section.settings.submit_label }}
          </button>

          {%- if section.settings.reassurance != blank -%}
            <p class="lk-bf__reassurance">{{ section.settings.reassurance }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <span class="lk-bf__sentinel" data-lockin-sentinel aria-hidden="true"></span>
  </div>

  {%- comment -%} ---------- Sticky bar ---------- {%- endcomment -%}
  <div class="lk lk-stickybar" data-lockin-stickybar hidden>
    <div class="lk-container lk-stickybar__inner">
      {%- if product.featured_image -%}
        <img
          class="lk-stickybar__thumb"
          src="{{ product.featured_image | image_url: width: 120 }}"
          alt=""
          width="48"
          height="48"
          loading="lazy"
        >
      {%- endif -%}
      <div class="lk-stickybar__info">
        <span class="lk-stickybar__title">{{ section.settings.title | default: product.title }}</span>
        <span class="lk-stickybar__meta">
          <span data-lockin-sticky-label></span>
          <span class="lk-stickybar__dot" aria-hidden="true">·</span>
          <span data-lockin-sticky-price></span>
        </span>
      </div>
      <button
        class="lk-btn lk-btn--primary lk-stickybar__btn"
        type="submit"
        form="{{ form_id }}"
        data-lockin-sticky-submit
      >
        {{ section.settings.submit_label }}
      </button>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .lk-bf {
    background: var(--lk-paper);
  }

  .lk-bf__grid {
    display: grid;
  }

  /* ---------- Full-bleed media ---------- */

  .lk-bf__stage {
    position: relative;
    background: var(--lk-ice-soft);
    overflow: hidden;
  }

  /* Swipeable full-bleed gallery. */
  .lk-bf__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .lk-bf__track::-webkit-scrollbar {
    display: none;
  }

  .lk-bf__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Square on phones so title + price sit near the fold. */
  .lk-bf__hero {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 1 / 1;
    max-block-size: 62svh;
    object-fit: cover;
  }

  .lk-bf__dots {
    position: absolute;
    inset-inline: 0;
    bottom: 8px;
    display: flex;
    justify-content: center;
    gap: 6px;
    pointer-events: none;
    z-index: 2;
  }

  .lk-bf__dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: var(--lk-r-pill);
    background: color-mix(in srgb, var(--lk-paper) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--lk-ink) 25%, transparent);
    transition: background-color 0.2s var(--lk-ease), transform 0.2s var(--lk-ease);
  }

  .lk-bf__dot.is-active {
    background: var(--lk-ink);
    transform: scale(1.2);
  }

  /* Bold benefit checklist under the title — the sell, in four words each. */
  .lk-bf__benefits {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 14px;
  }

  .lk-bf__benefit {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--lk-ink);
    line-height: 1.25;
    min-width: 0;
  }

  .lk-bf__benefitTick {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 22px;
    block-size: 22px;
    border-radius: var(--lk-r-pill);
    background: var(--lk-accent);
    color: var(--lk-ink);
  }

  .lk-bf__benefitTick svg {
    inline-size: 13px;
    block-size: 13px;
  }

  /* Dots carry the position on phones; thumbnails are desktop chrome. */
  .lk-bf__thumbs {
    display: none;
    gap: 10px;
    margin: 0;
    padding: 12px var(--lk-gutter);
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .lk-bf__thumbs::-webkit-scrollbar {
    display: none;
  }

  .lk-bf__thumb {
    inline-size: 64px;
    block-size: 64px;
    padding: 0;
    border-radius: var(--lk-r-sm);
    border: 1px solid var(--lk-line);
    background: var(--lk-ice-soft);
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s var(--lk-ease);
  }

  .lk-bf__thumb.is-active {
    border-color: var(--lk-ink);
  }

  .lk-bf__thumb img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* ---------- Funnel column ---------- */

  .lk-bf__panel {
    padding: 26px var(--lk-gutter) 56px;
    max-width: 620px;
  }

  .lk-bf__title {
    font-family: var(--lk-font-head);
    font-weight: 600;
    font-size: clamp(1.9rem, 6.6vw, 2.7rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 12px 0 0;
    text-wrap: balance;
  }

  .lk-bf__subtitle {
    margin-top: 12px;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--lk-muted);
    text-wrap: pretty;
  }

  .lk-bf__pills {
    margin-top: 16px;
  }

  .lk-bf__priceRow {
    margin-top: 22px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .lk-bf__price {
    font-family: var(--lk-font-head);
    font-weight: 600;
    font-size: 2rem;
    letter-spacing: -0.025em;
  }

  .lk-bf__was {
    font-size: 1.0625rem;
    color: var(--lk-muted);
  }

  .lk-bf__save {
    align-self: center;
    padding: 5px 11px;
    border-radius: var(--lk-r-pill);
    background: var(--lk-accent);
    color: var(--lk-ink);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .lk-bf__perday {
    font-size: 0.875rem;
    color: var(--lk-muted);
  }

  .lk-bf__liveNote {
    margin-top: 4px;
    font-size: 0.8125rem;
    color: var(--lk-muted);
    min-height: 1.2em;
  }

  /* ---------- Offer ---------- */

  /* Small pill by the price — outline style so it reads distinct from SAVE %. */
  .lk-bf__offerPill {
    align-self: center;
    padding: 4px 10px;
    border-radius: var(--lk-r-pill);
    border: 1.5px solid var(--lk-ink);
    color: var(--lk-ink);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .lk-bf__offerLine {
    margin-top: 8px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--lk-muted);
  }

  /* ---------- Small FAQ carousel ---------- */

  .lk-bf__faqCar {
    margin-top: 20px;
  }

  .lk-bf__faqTrack {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .lk-bf__faqTrack::-webkit-scrollbar {
    display: none;
  }

  .lk-bf__faqCard {
    flex: 0 0 min(80%, 300px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 18px 20px;
    border-radius: var(--lk-r-md);
    border: 1px solid var(--lk-line);
    background: var(--lk-ice-soft);
  }

  .lk-bf__faqQ {
    font-family: var(--lk-font-head);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--lk-ink);
  }

  .lk-bf__faqA {
    font-size: 0.875rem;
    line-height: 1.58;
    color: var(--lk-muted);
    text-wrap: pretty;
  }

  .lk-bf__faqNav {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .lk-bf__faqArrow {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    border-radius: var(--lk-r-pill);
    border: 1px solid var(--lk-line-strong);
    background: var(--lk-paper);
    color: var(--lk-ink);
    cursor: pointer;
    transition: background-color 0.2s var(--lk-ease);
  }

  .lk-bf__faqArrow:hover {
    background: var(--lk-ice);
  }

  .lk-bf__faqArrow svg {
    inline-size: 16px;
    block-size: 16px;
  }

  /* ---------- Form controls (self-contained copies of the lk control kit,
     so this section styles correctly on its own) ---------- */

  .lk-vh-input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .lk-radio {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 21px;
    block-size: 21px;
    border-radius: var(--lk-r-pill);
    border: 1.5px solid var(--lk-line-strong);
    background: var(--lk-paper);
    transition: border-color 0.2s var(--lk-ease);
  }

  .lk-radio::after {
    content: '';
    inline-size: 10px;
    block-size: 10px;
    border-radius: var(--lk-r-pill);
    background: var(--lk-ink);
    transform: scale(0);
    transition: transform 0.18s var(--lk-ease);
  }

  .lk-vh-input:checked + label .lk-radio {
    border-color: var(--lk-ink);
  }

  .lk-vh-input:checked + label .lk-radio::after {
    transform: scale(1);
  }

  .lk-vh-input:focus-visible + label {
    outline: 2px solid var(--lk-accent);
    outline-offset: 3px;
  }

  .lk-vh-input:disabled + label {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .lk-purchase__options {
    display: grid;
    gap: 10px;
  }

  .lk-purchase__label {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 16px;
    border-radius: var(--lk-r-md);
    border: 1.5px solid var(--lk-line);
    background: var(--lk-paper);
    cursor: pointer;
    transition: border-color 0.2s var(--lk-ease), background-color 0.2s var(--lk-ease);
  }

  .lk-vh-input:checked + .lk-purchase__label {
    border-color: var(--lk-ink);
    background: var(--lk-ice-soft);
  }

  .lk-purchase__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .lk-purchase__name {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .lk-purchase__meta {
    font-size: 0.8125rem;
    color: var(--lk-muted);
  }

  .lk-purchase__tag {
    margin-left: auto;
    flex: none;
    padding: 5px 11px;
    border-radius: var(--lk-r-pill);
    background: var(--lk-accent);
    color: var(--lk-ink);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .lk-purchase__pending {
    margin-top: 10px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--lk-muted);
  }

  .lk-editor-todo {
    margin-top: 10px;
    padding: 12px 14px;
    border-radius: var(--lk-r-sm);
    border: 1px dashed var(--lk-accent);
    background: color-mix(in srgb, var(--lk-accent) 10%, transparent);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--lk-ink);
  }

  .lk-bundles__steps {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 2px 0 12px;
    font-size: 0.78rem;
    color: var(--lk-muted);
  }

  .lk-bundles__steps span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .lk-bundles__steps b {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--lk-ink);
    color: var(--lk-paper);
    font-size: 0.66rem;
    font-weight: 700;
  }

  .lk-bundles__list {
    display: grid;
    gap: 10px;
  }

  .lk-bundle {
    position: relative;
  }

  .lk-bundle__thumb {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    object-fit: cover;
    background: var(--lk-ice-soft);
    border: 1px solid var(--lk-line);
  }

  .lk-bundle__saveamt {
    align-self: flex-end;
    background: #C0392B;
    color: #fff;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 2px 8px;
    border-radius: 999px;
    margin-bottom: 2px;
    white-space: nowrap;
  }

  .lk-bundle__label {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 18px 16px;
    border-radius: var(--lk-r-md);
    border: 1.5px solid var(--lk-line);
    background: var(--lk-paper);
    cursor: pointer;
    transition: border-color 0.2s var(--lk-ease), background-color 0.2s var(--lk-ease);
  }

  .lk-vh-input:checked + .lk-bundle__label {
    border-color: var(--lk-ink);
    background: var(--lk-ice-soft);
  }

  .lk-bundle__main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .lk-bundle__name {
    font-family: var(--lk-font-head);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .lk-bundle__sub,
  .lk-bundle__perbox {
    font-size: 0.8125rem;
    color: var(--lk-muted);
  }

  .lk-bundle__pricing {
    margin-left: auto;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
