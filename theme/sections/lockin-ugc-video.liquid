{%- comment -%}
  lockin — UGC video screen.

  One embedded video (YouTube or Vimeo), framed like a phone screen.
  Renders nothing on the live site until a video URL is set — an empty
  player frame is dummy data. Made for the doctor/spokesperson video.
{%- endcomment -%}

{%- liquid
  assign v = section.settings.video_url
-%}
{%- if v != blank or request.design_mode -%}
<div class="lk lk-section lk-uv">
  <div class="lk-container lk-uv__inner">
    <div class="lk-uv__copy lk-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lk-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lk-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="lk-uv__body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    {%- if v != blank -%}
      <div class="lk-uv__screen{% if section.settings.ratio == 'landscape' %} lk-uv__screen--wide{% endif %} lk-reveal">
        {%- if v.type == 'youtube' -%}
          <iframe
            class="lk-uv__frame"
            src="https://www.youtube-nocookie.com/embed/{{ v.id }}?rel=0&modestbranding=1"
            title="{{ section.settings.heading | default: 'lockin video' | escape }}"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        {%- elsif v.type == 'vimeo' -%}
          <iframe
            class="lk-uv__frame"
            src="https://player.vimeo.com/video/{{ v.id }}?dnt=1"
            title="{{ section.settings.heading | default: 'lockin video' | escape }}"
            loading="lazy"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        {%- endif -%}
      </div>
    {%- else -%}
      <p class="lk-editor-todo">
        <strong>Hidden on the live site.</strong>
        Paste a YouTube or Vimeo link in this section's settings — the video screen
        appears to customers the moment a link is set.
      </p>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .lk-uv {
    background: var(--lk-ice-soft);
  }

  .lk-uv__inner {
    display: grid;
    gap: 26px;
  }

  .lk-uv__copy .lk-h2 {
    margin-top: 12px;
  }

  .lk-uv__body {
    margin-top: 12px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--lk-muted);
    max-width: 46ch;
    text-wrap: pretty;
  }

  /* Phone-screen frame: vertical by default, UGC-style. */
  .lk-uv__screen {
    position: relative;
    inline-size: min(100%, 360px);
    margin-inline: auto;
    aspect-ratio: 9 / 16;
    border-radius: var(--lk-r-lg);
    overflow: hidden;
    background: var(--lk-ink);
    border: 1px solid var(--lk-line-strong);
    box-shadow: 0 24px 60px -28px color-mix(in srgb, var(--lk-ink) 45%, transparent);
  }

  .lk-uv__screen--wide {
    inline-size: 100%;
    max-inline-size: 720px;
    aspect-ratio: 16 / 9;
  }

  .lk-uv__frame {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
  }

  @media screen and (min-width: 990px) {
    .lk-uv__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "lockin ugc video",
  "tag": "section",
  "class": "lockin-uv-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Watch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The science, explained."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Ninety seconds on why your energy dips — and what actually fixes it."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video (YouTube or Vimeo)",
      "accept": ["youtube", "vimeo"],
      "info": "The section is hidden on the live site until this is set."
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Screen shape",
      "options": [
        { "value": "portrait", "label": "Vertical (9:16, UGC style)" },
        { "value": "landscape", "label": "Wide (16:9)" }
      ],
      "default": "portrait"
    }
  ],
  "presets": [
    {
      "name": "lockin ugc video"
    }
  ]
}
{% endschema %}
