    "mechanism": {
      "type": "lockin-mechanism",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "tag": "NR 300mg",
            "title": "Raise the raw material",
            "body": "<p>Nicotinamide riboside is a precursor your cells convert into NAD+. Supplying the precursor is the practical route to raising NAD+, because NAD+ itself is too large to cross into the cell intact.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "tag": "PQQ 20mg · CoQ10 100mg",
            "title": "Support the machinery that uses it",
            "body": "<p>NAD+ is spent inside the mitochondria. PQQ is studied for mitochondrial biogenesis, and CoQ10 as ubiquinol sits directly in the electron transport chain where ATP is produced.</p>"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "tag": "KSM-66 300mg",
            "title": "Keep cortisol from undoing it",
            "body": "<p>Sustained cortisol works against steady energy. KSM-66 ashwagandha at the full studied dose is included for healthy cortisol balance — it is the reason the energy reads as calm rather than wired.</p>"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3"
      ],
      "settings": {
        "eyebrow": "Inside the cell",
        "heading": "Three steps, one dose.",
        "body": "lockin does not add energy to your system. It supports the machinery that makes energy in the first place."
      }
    },
