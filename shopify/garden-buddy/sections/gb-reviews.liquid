{%- comment -%}
  GARDEN BUDDY — reviews. Real blocks only, otherwise the honest empty state.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'
  assign review_n = 0
  for block in section.blocks
    if block.type == 'review'
      assign review_n = review_n | plus: 1
    endif
  endfor
-%}

<div class="gb gb-pb">

  <section class="gb-sec gb-sec--brown gb-rev" id="reviews">
    <div class="gb-wrap">
      <div class="gb-head gb-head--center">
        {%- if s.rev_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.rev_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.rev_heading }}</h2>
        {%- if s.rev_sub != blank -%}<p class="gb-lede">{{ s.rev_sub | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>

      {%- if review_n > 0 -%}
        <ul class="gb-rev__row">
          {%- for block in section.blocks -%}
            {%- if block.type != 'review' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            <li class="gb-fb" {{ block.shopify_attributes }}>
              <div class="gb-fb__head">
                <span class="gb-fb__av">
                  {%- if b.avatar != blank -%}
                    <img src="{{ b.avatar | image_url: width: 128 }}" alt="{{ b.avatar.alt | default: b.name | escape }}" width="48" height="48" loading="lazy">
                  {%- elsif b.name != blank -%}
                    <span aria-hidden="true">{{ b.name | strip | slice: 0 | upcase }}</span>
                  {%- else -%}
                    <span aria-hidden="true">&nbsp;</span>
                  {%- endif -%}
                </span>
                <span class="gb-fb__who">
                  {%- if b.name != blank -%}<b>{{ b.name | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</b>{%- endif -%}
                  {%- if b.ago != blank -%}<small>{{ b.ago | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</small>{%- endif -%}
                </span>
                <span class="gb-fb__fb" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.07A12 12 0 1 0 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.96h-1.51c-1.49 0-1.96.93-1.96 1.88v2.27h3.33l-.53 3.49h-2.8V24A12 12 0 0 0 24 12.07z"/></svg>
                </span>
              </div>

              {%- if b.text != blank -%}
                <p class="gb-fb__text">{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close | newline_to_br }}</p>
              {%- endif -%}

              {%- if b.photo != blank -%}
                <img class="gb-fb__photo" src="{{ b.photo | image_url: width: 800 }}" alt="{{ b.photo.alt | escape }}" width="{{ b.photo.width }}" height="{{ b.photo.height }}" loading="lazy">
              {%- endif -%}

              {%- if b.reactions != blank or b.comments != blank -%}
                <div class="gb-fb__meta">
                  {%- if b.reactions != blank -%}
                    <span class="gb-fb__react">
                      <span class="gb-fb__dots" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#1877F2"/><path d="M7.6 10.8h2v6.2h-2z" fill="#fff"/><path d="M10.2 17V11l2.6-4a1.2 1.2 0 0 1 2.2.9l-.6 2.5h2.6a1.2 1.2 0 0 1 1.2 1.5l-.9 4a1.5 1.5 0 0 1-1.5 1.1z" fill="#fff"/></svg>
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#F3425F"/><path d="M12 18.2l-4.7-4.5a3 3 0 0 1 4.7-3.5 3 3 0 0 1 4.7 3.5z" fill="#fff"/></svg>
                      </span>
                      <span>{{ b.reactions | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>
                    </span>
                  {%- endif -%}
                  {%- if b.comments != blank -%}
                    <span class="gb-fb__cmt">{{ b.comments | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="gb-fb__bar" aria-hidden="true">
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 10.5h-2a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2z"/><path d="M6.5 10.5l3.6-6.2a1.6 1.6 0 0 1 3 1.1l-.9 3.6h4.4a1.7 1.7 0 0 1 1.6 2.1l-1.3 5.6a2 2 0 0 1-2 1.6H6.5z"/></svg>Like</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 12.2c0 4-3.8 7.2-8.5 7.2a10 10 0 0 1-2.7-.4l-4.8 1.6 1.6-3.9a6.8 6.8 0 0 1-2.1-4.5C4 8.2 7.8 5 12 5s8.5 3.2 8.5 7.2z"/></svg>Comment</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5v6a1.5 1.5 0 0 0 1.5 1.5h13a1.5 1.5 0 0 0 1.5-1.5v-6"/><path d="M12 15.5V4"/><path d="M8 7.6L12 3.8l4 3.8"/></svg>Share</span>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="gb-rev__empty">
          <p><b>{{ s.rev_empty_title }}</b></p>
          <p>{{ s.rev_empty_text }}</p>
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-sec{padding:clamp(56px,7vw,100px) 0}
.gb-pb .gb-head{display:grid;gap:10px;margin-bottom:clamp(34px,4.5vw,60px)}
.gb-pb .gb-head--tight{margin-bottom:0}
.gb-pb .gb-head--center{justify-items:center;text-align:center}
.gb-pb .gb-head--center .gb-lede{max-width:52ch;text-align:center}
.gb-pb .gb-h2{font-family:var(--font-h);font-weight:700;text-transform:uppercase;
  font-size:clamp(30px,4.4vw,52px);line-height:1.06;letter-spacing:-.01em;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h2{color:var(--brown-ink)}
.gb-pb .gb-sec--night .gb-h2{color:var(--night-ink)}
.gb-pb .gb-lede{font-size:clamp(18px,1.8vw,21px);line-height:1.6;max-width:46ch;color:var(--dim);margin-top:4px}
.gb-pb .gb-eyebrow{font-size:14px;letter-spacing:.16em;margin-bottom:4px}
.gb-pb .gb-h3{font-family:var(--font-h);font-size:clamp(21px,2.1vw,26px);line-height:1.18;margin:0 0 8px;font-weight:800;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h3,.gb-pb .gb-sec--night .gb-h3{color:inherit}
.gb-pb .gb-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.gb-pb .gb-table-wrap{overflow-x:auto}
.gb-pb a:focus-visible,.gb-pb summary:focus-visible,.gb-pb button:focus-visible{outline:3px solid var(--leaf);outline-offset:3px;border-radius:6px}
.gb-pb .gb-sec--night a:focus-visible,.gb-pb .gb-sec--brown a:focus-visible{outline-color:var(--lime)}
.gb-pb svg{width:100%;height:100%;display:block}
.gb-pb .gb-btn{min-height:60px;font-size:19px;padding:0 34px}

/* ——— reviews — facebook-post cards ——— */
.gb-pb .gb-rev__row{list-style:none;margin:0;padding:0 var(--pad);display:grid;gap:20px;
  grid-auto-flow:column;grid-auto-columns:min(86vw,380px);overflow-x:auto;scroll-snap-type:x mandatory;
  margin-inline:calc(var(--pad) * -1);padding-block:4px 16px}
.gb-pb .gb-rev__row > *{scroll-snap-align:start}
@media(min-width:1000px){
  .gb-pb .gb-rev__row{grid-auto-flow:row;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-columns:auto;
    overflow:visible;margin-inline:0;padding-inline:0}
}
.gb-pb .gb-fb{background:var(--paper);color:var(--ink);border-radius:18px;padding:20px 20px 10px;display:flex;flex-direction:column;gap:14px}
.gb-pb .gb-fb__head{display:grid;grid-template-columns:56px 1fr 24px;gap:12px;align-items:center}
.gb-pb .gb-fb__av{width:56px;height:56px;border-radius:50%;overflow:hidden;background:var(--sand);
  display:grid;place-items:center;font-family:var(--font-h);font-weight:800;font-size:23px;color:var(--dim)}
.gb-pb .gb-fb__av img{width:100%;height:100%;object-fit:cover}
.gb-pb .gb-fb__who{display:grid;gap:2px;min-width:0}
.gb-pb .gb-fb__who b{font-size:19px;font-weight:800}
.gb-pb .gb-fb__who small{font-size:15px;color:var(--dim)}
.gb-pb .gb-fb__fb{width:24px;height:24px}
.gb-pb .gb-fb__text{font-size:19px;line-height:1.55}
.gb-pb .gb-fb__photo{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px}
.gb-pb .gb-fb__meta{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:16px;color:var(--dim)}
.gb-pb .gb-fb__react{display:flex;align-items:center;gap:7px}
.gb-pb .gb-fb__dots{display:flex}
.gb-pb .gb-fb__dots svg{width:21px;height:21px;border-radius:50%;box-shadow:0 0 0 2px var(--paper)}
.gb-pb .gb-fb__dots svg + svg{margin-left:-6px}
.gb-pb .gb-fb__cmt{margin-left:auto}
.gb-pb .gb-fb__bar{margin-top:auto;display:grid;grid-template-columns:repeat(3,1fr);
  border-top:1px solid var(--rule);padding-top:6px}
.gb-pb .gb-fb__bar span{display:flex;align-items:center;justify-content:center;gap:8px;min-height:48px;
  color:var(--dim);font-size:16px;font-weight:700}
.gb-pb .gb-fb__bar svg{width:20px;height:20px;flex:0 0 20px}
.gb-pb .gb-rev__empty{max-width:60ch;margin:0 auto;text-align:center;display:grid;gap:10px;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:var(--radius);padding:32px 34px}
.gb-pb .gb-rev__empty b{font-size:22px;color:var(--lime)}
.gb-pb .gb-rev__empty p{color:rgba(255,255,255,.84);font-size:18px;line-height:1.6}
{% endstylesheet %}

{% schema %}
{
  "name": "GB Reviews",
  "tag": "section",
  "class": "gb-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add review blocks only for real, verifiable customer reviews. Without any, the honest empty state shows. Never invent a name, a date, a count or a photo."
    },
    {
      "type": "text",
      "id": "rev_eyebrow",
      "label": "Eyebrow",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "rev_heading",
      "label": "Heading",
      "default": "Real People. Real Results."
    },
    {
      "type": "text",
      "id": "rev_sub",
      "label": "Sub-line",
      "default": "Posted by people who bought one."
    },
    {
      "type": "text",
      "id": "rev_empty_title",
      "label": "Empty-state title",
      "default": "Reviews go live once the first orders land."
    },
    {
      "type": "textarea",
      "id": "rev_empty_text",
      "label": "Empty-state text",
      "default": "We are a new shop. We will post real reviews from real orders here, good and bad, and nothing else."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review (real only)",
      "settings": [
        {
          "type": "paragraph",
          "content": "Real customer, real order. Never invent a name, date, photo or count. Leave a field empty and it will not render."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "ago",
          "label": "Posted"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "reactions",
          "label": "Reaction count"
        },
        {
          "type": "text",
          "id": "comments",
          "label": "Comments line"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GB Reviews"
    }
  ]
}
{% endschema %}
