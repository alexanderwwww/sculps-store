{%- comment -%}
  GARDEN BUDDY — four-up trust strip.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'
-%}

<div class="gb gb-pb">

  <section class="gb-sec gb-sec--sand gb-trust">
    <div class="gb-wrap">
      <ul class="gb-trust__list">
        {%- for i in (1..4) -%}
          {%- assign tk = 'strip_' | append: i | append: '_title' -%}
          {%- assign xk = 'strip_' | append: i | append: '_text' -%}
          {%- if s[tk] != blank -%}
            <li class="gb-trust__item">
              <span class="gb-trust__ico" aria-hidden="true">
                {%- case i -%}
                  {%- when 1 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 6.5h11v9h-11z"/><path d="M12.5 10h4l3 3v2.5h-7z"/><circle cx="6" cy="17.5" r="2"/><circle cx="16.5" cy="17.5" r="2"/></svg>
                  {%- when 2 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l7.5 3v5.7c0 4.6-3.1 8.4-7.5 10.3C7.6 19.6 4.5 15.8 4.5 11.2V5.5z"/><path d="M8.6 11.8l2.4 2.4 4.4-4.6"/></svg>
                  {%- when 3 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10.5" rx="2.2"/><path d="M8 10V7.2a4 4 0 0 1 8 0V10"/><path d="M12 14v2.6"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="2.5" y="13.5" width="4" height="6.5" rx="1.8"/><rect x="17.5" y="13.5" width="4" height="6.5" rx="1.8"/><path d="M19.5 20v.4a2.6 2.6 0 0 1-2.6 2.6H13"/></svg>
                {%- endcase -%}
              </span>
              <span class="gb-trust__txt">
                <b>{{ s[tk] | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</b>
                {%- if s[xk] != blank -%}<span>{{ s[xk] | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>{%- endif -%}
              </span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-sec{padding:clamp(56px,7vw,100px) 0}
.gb-pb .gb-head{display:grid;gap:10px;margin-bottom:clamp(34px,4.5vw,60px)}
.gb-pb .gb-head--tight{margin-bottom:0}
.gb-pb .gb-head--center{justify-items:center;text-align:center}
.gb-pb .gb-head--center .gb-lede{max-width:52ch;text-align:center}
.gb-pb .gb-h2{font-family:var(--font-h);font-weight:700;text-transform:uppercase;
  font-size:clamp(30px,4.4vw,52px);line-height:1.06;letter-spacing:-.01em;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h2{color:var(--brown-ink)}
.gb-pb .gb-sec--night .gb-h2{color:var(--night-ink)}
.gb-pb .gb-lede{font-size:clamp(18px,1.8vw,21px);line-height:1.6;max-width:46ch;color:var(--dim);margin-top:4px}
.gb-pb .gb-eyebrow{font-size:14px;letter-spacing:.16em;margin-bottom:4px}
.gb-pb .gb-h3{font-family:var(--font-h);font-size:clamp(21px,2.1vw,26px);line-height:1.18;margin:0 0 8px;font-weight:800;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h3,.gb-pb .gb-sec--night .gb-h3{color:inherit}
.gb-pb .gb-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.gb-pb .gb-table-wrap{overflow-x:auto}
.gb-pb a:focus-visible,.gb-pb summary:focus-visible,.gb-pb button:focus-visible{outline:3px solid var(--leaf);outline-offset:3px;border-radius:6px}
.gb-pb .gb-sec--night a:focus-visible,.gb-pb .gb-sec--brown a:focus-visible{outline-color:var(--lime)}
.gb-pb svg{width:100%;height:100%;display:block}
.gb-pb .gb-btn{min-height:60px;font-size:19px;padding:0 34px}

/* ——— trust strip ——— */
.gb-pb .gb-trust{padding:clamp(26px,3.4vw,38px) 0}
.gb-pb .gb-trust__list{list-style:none;margin:0;padding:0;display:grid;gap:22px 30px;grid-template-columns:repeat(2,minmax(0,1fr))}
@media(min-width:900px){.gb-pb .gb-trust__list{grid-template-columns:repeat(4,minmax(0,1fr))}}
.gb-pb .gb-trust__item{display:flex;gap:14px;align-items:flex-start;min-height:48px}
.gb-pb .gb-trust__ico{flex:0 0 36px;width:36px;height:36px;color:var(--leaf);margin-top:1px}
.gb-pb .gb-trust__txt{display:grid;gap:2px}
.gb-pb .gb-trust__txt b{font-size:19px;font-weight:800;color:var(--ink);line-height:1.25}
.gb-pb .gb-trust__txt span{color:var(--dim);font-size:17px;line-height:1.45}
{% endstylesheet %}

