{%- comment -%}
  GARDEN BUDDY — the FAQ accordion.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'
  assign faq_n = 0
  for block in section.blocks
    if block.type == 'faq'
      assign faq_n = faq_n | plus: 1
    endif
  endfor
-%}

<div class="gb gb-pb">

  {%- if faq_n > 0 -%}
  <section class="gb-sec gb-faq-sec" id="faq">
    <div class="gb-wrap">
      <div class="gb-faq">
        {%- if s.faq_heading != blank -%}<h3 class="gb-faq__h">{{ s.faq_heading }}</h3>{%- endif -%}
        <div class="gb-faq__list">
          {%- for block in section.blocks -%}
            {%- if block.type != 'faq' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            <details class="gb-faq__item" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ b.question | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>
                <i aria-hidden="true"></i>
              </summary>
              <p>{{ b.answer | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
  {%- endif -%}
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-sec{padding:clamp(56px,7vw,100px) 0}
.gb-pb .gb-head{display:grid;gap:10px;margin-bottom:clamp(34px,4.5vw,60px)}
.gb-pb .gb-head--tight{margin-bottom:0}
.gb-pb .gb-head--center{justify-items:center;text-align:center}
.gb-pb .gb-head--center .gb-lede{max-width:52ch;text-align:center}
.gb-pb .gb-h2{font-family:var(--font-h);font-weight:700;text-transform:uppercase;
  font-size:clamp(30px,4.4vw,52px);line-height:1.06;letter-spacing:-.01em;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h2{color:var(--brown-ink)}
.gb-pb .gb-sec--night .gb-h2{color:var(--night-ink)}
.gb-pb .gb-lede{font-size:clamp(18px,1.8vw,21px);line-height:1.6;max-width:46ch;color:var(--dim);margin-top:4px}
.gb-pb .gb-eyebrow{font-size:14px;letter-spacing:.16em;margin-bottom:4px}
.gb-pb .gb-h3{font-family:var(--font-h);font-size:clamp(21px,2.1vw,26px);line-height:1.18;margin:0 0 8px;font-weight:800;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h3,.gb-pb .gb-sec--night .gb-h3{color:inherit}
.gb-pb .gb-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.gb-pb .gb-table-wrap{overflow-x:auto}
.gb-pb a:focus-visible,.gb-pb summary:focus-visible,.gb-pb button:focus-visible{outline:3px solid var(--leaf);outline-offset:3px;border-radius:6px}
.gb-pb .gb-sec--night a:focus-visible,.gb-pb .gb-sec--brown a:focus-visible{outline-color:var(--lime)}
.gb-pb svg{width:100%;height:100%;display:block}
.gb-pb .gb-btn{min-height:60px;font-size:19px;padding:0 34px}

/* ——— FAQ ——— */
.gb-pb .gb-faq{width:100%;max-width:940px;margin:0 auto}
.gb-pb .gb-faq__h{font-family:var(--font-h);font-size:clamp(24px,2.6vw,32px);font-weight:800;
  text-transform:uppercase;color:var(--brown);margin:0 0 18px}
.gb-pb .gb-faq__list{display:grid;gap:12px}
.gb-pb .gb-faq__item{background:var(--paper);border:1px solid var(--rule);border-radius:var(--radius);padding:0 24px}
.gb-pb .gb-faq__item summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:18px;
  min-height:68px;padding:14px 0;font-weight:800;font-size:clamp(18px,1.8vw,21px);line-height:1.35}
.gb-pb .gb-faq__item summary::-webkit-details-marker{display:none}
.gb-pb .gb-faq__item summary span{flex:1}
.gb-pb .gb-faq__item summary i{flex:0 0 34px;width:34px;height:34px;border-radius:50%;background:var(--sand);
  position:relative;transition:transform .18s ease}
.gb-pb .gb-faq__item summary i::before,.gb-pb .gb-faq__item summary i::after{content:"";position:absolute;
  left:50%;top:50%;background:var(--ink);border-radius:2px;transform:translate(-50%,-50%)}
.gb-pb .gb-faq__item summary i::before{width:16px;height:2.5px}
.gb-pb .gb-faq__item summary i::after{width:2.5px;height:16px}
.gb-pb .gb-faq__item[open] summary i{transform:rotate(45deg)}
.gb-pb .gb-faq__item p{padding:0 0 22px;color:var(--dim);max-width:64ch;font-size:18px;line-height:1.6}
@media(prefers-reduced-motion:reduce){.gb-pb .gb-faq__item summary i{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "GB FAQ",
  "tag": "section",
  "class": "gb-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Anything written as [ LIKE THIS ] shows as a placeholder until you replace it. Nothing here is invented."
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "FAQ heading",
      "default": "Questions people ask"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How much weight does it hold?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "The frame is rated to [ WEIGHT CAPACITY ]."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GB FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How much weight does it hold?",
            "answer": "The frame is rated to [ WEIGHT CAPACITY ]."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How heavy is it?",
            "answer": "[ WEIGHT ]. Light enough to carry by the handle in one hand."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is there any assembly?",
            "answer": "None. It arrives assembled. Take it out of the box and unfold it."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Does it stay shut when I use it as a stool?",
            "answer": "Yes. A snap-lock holds the frame shut when it is flipped. It clicks when it is locked."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Will it sink into soft soil?",
            "answer": "The feet are wide, so it sits well on lawn and on beds. On very soft ground, set it on the path or the grass edge."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I leave it outside?",
            "answer": "The frame is steel and handles weather. Bring the pad in when rain is coming so it does not soak through."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How does shipping work?",
            "answer": "Free shipping in the US. Most orders arrive in [ DELIVERY WINDOW ]."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "Send it back within 30 days for a refund."
          }
        }
      ]
    }
  ]
}
{% endschema %}
