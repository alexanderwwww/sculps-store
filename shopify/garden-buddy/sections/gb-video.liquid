{%- comment -%}
  GARDEN BUDDY — UGC video rows. Three alternating rows under the buy box.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'
-%}

<div class="gb gb-pb">

  <section class="gb-sec gb-ugc" id="watch">
    <div class="gb-wrap">
      <div class="gb-ugc__head">
        {%- if s.ugc_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.ugc_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.ugc_heading }}</h2>
        {%- if s.ugc_text != blank -%}<p class="gb-lede">{{ s.ugc_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>

      <div class="gb-ugc__grid">
        <div class="gb-ugc__rows">
          {%- for i in (1..3) -%}
            {%- liquid
              assign vkey  = 'ugc_video_' | append: i
              assign skey  = 'ugc_src_' | append: i
              assign ukey  = 'ugc_url_' | append: i
              assign pskey = 'ugc_poster_' | append: i
              assign tkey  = 'ugc_title_' | append: i
              assign ckey  = 'ugc_caption_' | append: i
              assign pkey  = 'ugc_ph_' | append: i
              assign flip  = i | modulo: 2
            -%}
            {%- if s[vkey] != blank or s[ukey] != blank or s[skey] != blank or s[pkey] != blank -%}
            <div class="gb-ugc__row{% if flip == 0 %} gb-ugc__row--flip{% endif %}">
              <figure class="gb-ugc__media">
                {%- if s[vkey] != blank -%}
                  {{ s[vkey] | video_tag: image_size: '900x', autoplay: true, loop: true, muted: true, playsinline: true, controls: true, class: 'gb-ugc__vid' }}
                {%- elsif s[ukey] != blank -%}
                  <div class="gb-ugc__frame">{{ s[ukey] | external_video_tag: class: 'gb-ugc__vid', loading: 'lazy' }}</div>
                {%- elsif s[skey] != blank -%}
                  <video class="gb-ugc__vid" autoplay loop muted playsinline controls preload="metadata"{% if s[pskey] != blank %} poster="{{ s[pskey] | image_url: width: 900 }}"{% endif %}>
                    <source src="{{ s[skey] }}" type="video/mp4">
                  </video>
                {%- else -%}
                  <div class="gb-ph gb-ugc__ph"><span>{{ s[pkey] }}<small>Upload a clip in the theme editor</small></span></div>
                {%- endif -%}
              </figure>
              <div class="gb-ugc__say">
                <span class="gb-ugc__n" aria-hidden="true">{{ i }}</span>
                {%- if s[tkey] != blank -%}<p class="gb-ugc__title">{{ s[tkey] | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
                {%- if s[ckey] != blank -%}<p class="gb-ugc__cap">{{ s[ckey] | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
              </div>
            </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-sec{padding:clamp(56px,7vw,100px) 0}
.gb-pb .gb-head{display:grid;gap:10px;margin-bottom:clamp(34px,4.5vw,60px)}
.gb-pb .gb-head--tight{margin-bottom:0}
.gb-pb .gb-head--center{justify-items:center;text-align:center}
.gb-pb .gb-head--center .gb-lede{max-width:52ch;text-align:center}
.gb-pb .gb-h2{font-family:var(--font-h);font-weight:700;text-transform:uppercase;
  font-size:clamp(30px,4.4vw,52px);line-height:1.06;letter-spacing:-.01em;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h2{color:var(--brown-ink)}
.gb-pb .gb-sec--night .gb-h2{color:var(--night-ink)}
.gb-pb .gb-lede{font-size:clamp(18px,1.8vw,21px);line-height:1.6;max-width:46ch;color:var(--dim);margin-top:4px}
.gb-pb .gb-eyebrow{font-size:14px;letter-spacing:.16em;margin-bottom:4px}
.gb-pb .gb-h3{font-family:var(--font-h);font-size:clamp(21px,2.1vw,26px);line-height:1.18;margin:0 0 8px;font-weight:800;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h3,.gb-pb .gb-sec--night .gb-h3{color:inherit}
.gb-pb .gb-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.gb-pb .gb-table-wrap{overflow-x:auto}
.gb-pb a:focus-visible,.gb-pb summary:focus-visible,.gb-pb button:focus-visible{outline:3px solid var(--leaf);outline-offset:3px;border-radius:6px}
.gb-pb .gb-sec--night a:focus-visible,.gb-pb .gb-sec--brown a:focus-visible{outline-color:var(--lime)}
.gb-pb svg{width:100%;height:100%;display:block}
.gb-pb .gb-btn{min-height:60px;font-size:19px;padding:0 34px}

/* ——— UGC video rows ——— */
.gb-pb .gb-ugc__head{text-align:center;max-width:56ch;margin:0 auto clamp(28px,4vw,48px)}
.gb-pb .gb-ugc__head .gb-lede{margin-inline:auto}
.gb-pb .gb-ugc__grid{display:grid;gap:clamp(28px,4vw,56px);align-items:start}
.gb-pb .gb-ugc__rows{display:grid;gap:clamp(36px,5vw,72px)}
.gb-pb .gb-ugc__row{display:grid;gap:clamp(20px,3vw,48px);align-items:center}
@media(min-width:860px){
  .gb-pb .gb-ugc__row{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  .gb-pb .gb-ugc__row--flip .gb-ugc__media{order:2}
}
.gb-pb .gb-ugc__media{margin:0;width:100%}
.gb-pb .gb-ugc__frame{position:relative;width:100%;aspect-ratio:1;border-radius:20px;overflow:hidden;background:var(--sand);box-shadow:0 14px 40px rgba(42,29,17,.18)}
.gb-pb .gb-ugc__frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.gb-pb .gb-ugc__media video,.gb-pb .gb-ugc__ph{width:100%;aspect-ratio:1;border-radius:20px;overflow:hidden;background:var(--sand);box-shadow:0 14px 40px rgba(42,29,17,.18);object-fit:cover;display:block}
.gb-pb .gb-ugc__say{display:grid;gap:12px;justify-items:start}
.gb-pb .gb-ugc__n{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:var(--lime);color:var(--lime-ink);font-family:var(--font-h);font-weight:700;font-size:21px}
.gb-pb .gb-ugc__title{margin:0;font-family:var(--font-h);font-weight:700;font-size:clamp(28px,3.6vw,44px);line-height:1.1;letter-spacing:-.02em;color:var(--brown);text-wrap:balance}
.gb-pb .gb-ugc__cap{margin:0;font-size:clamp(17px,1.6vw,20px);line-height:1.6;color:var(--dim);max-width:40ch}
{% endstylesheet %}

