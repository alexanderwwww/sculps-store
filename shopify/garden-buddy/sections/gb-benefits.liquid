{%- comment -%}
  GARDEN BUDDY — benefits — photo left, items right.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'
  assign benefit_n = 0
  for block in section.blocks
    if block.type == 'benefit'
      assign benefit_n = benefit_n | plus: 1
    endif
  endfor
-%}

<div class="gb gb-pb">

  {%- if benefit_n > 0 or s.ben_heading != blank -%}
  <section class="gb-sec gb-ben" id="benefits">
    <div class="gb-wrap">
      <div class="gb-head">
        {%- if s.ben_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.ben_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.ben_heading }}</h2>
        {%- if s.ben_text != blank -%}<p class="gb-lede">{{ s.ben_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>
      <div class="gb-ben__in gb-rise">
        <div class="gb-ben__shot">
          {%- if s.ben_image != blank -%}
            <img src="{{ s.ben_image | image_url: width: 1200 }}" alt="{{ s.ben_image.alt | default: s.ben_heading | escape }}" width="{{ s.ben_image.width }}" height="{{ s.ben_image.height }}" loading="lazy" decoding="async">
          {%- else -%}
            <div class="gb-ph"><span>{{ s.ben_placeholder | default: 'Photo: the kneeler in use' }}<small>Wide shot, 4:3</small></span></div>
          {%- endif -%}
        </div>
        <ul class="gb-ben__list">
          {%- for block in section.blocks -%}
            {%- if block.type != 'benefit' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            <li class="gb-ben__item" {{ block.shopify_attributes }}>
              <span class="gb-ben__ico" aria-hidden="true">
                {%- case b.icon -%}
                  {%- when 'infinity' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8.6 12c-1.5 2.3-2.6 3.2-4.1 3.2A3.2 3.2 0 0 1 4.5 8.8C7 8.8 8.4 12 12 12s5-3.2 7.5-3.2a3.2 3.2 0 0 1 0 6.4c-1.5 0-2.6-.9-4.1-3.2"/></svg>
                  {%- when 'layers' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2l8.5 4.3-8.5 4.3L3.5 7.5z"/><path d="M3.5 12.2l8.5 4.3 8.5-4.3"/><path d="M3.5 16.6l8.5 4.2 8.5-4.2"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l7.5 3v5.7c0 4.6-3.1 8.4-7.5 10.3C7.6 19.6 4.5 15.8 4.5 11.2V5.5z"/><path d="M8.6 11.8l2.4 2.4 4.4-4.6"/></svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.4l-7-6.6a4.4 4.4 0 0 1 7-5.2 4.4 4.4 0 0 1 7 5.2z"/></svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M12 7.2V12l3.2 2"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-5 2-9 7-11-1 6-3.4 9.3-7 11z"/><path d="M12 21C7.5 20 4 16 4 10.5 4 6.5 6.5 4 9.5 4c2.6 0 4.3 1.8 4.9 4"/></svg>
                {%- endcase -%}
              </span>
              <h3 class="gb-h3">{{ b.title | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</h3>
              <p>{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>
  {%- endif -%}
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-sec{padding:clamp(56px,7vw,100px) 0}
.gb-pb .gb-head{display:grid;gap:10px;margin-bottom:clamp(34px,4.5vw,60px)}
.gb-pb .gb-head--tight{margin-bottom:0}
.gb-pb .gb-head--center{justify-items:center;text-align:center}
.gb-pb .gb-head--center .gb-lede{max-width:52ch;text-align:center}
.gb-pb .gb-h2{font-family:var(--font-h);font-weight:700;text-transform:uppercase;
  font-size:clamp(30px,4.4vw,52px);line-height:1.06;letter-spacing:-.01em;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h2{color:var(--brown-ink)}
.gb-pb .gb-sec--night .gb-h2{color:var(--night-ink)}
.gb-pb .gb-lede{font-size:clamp(18px,1.8vw,21px);line-height:1.6;max-width:46ch;color:var(--dim);margin-top:4px}
.gb-pb .gb-eyebrow{font-size:14px;letter-spacing:.16em;margin-bottom:4px}
.gb-pb .gb-h3{font-family:var(--font-h);font-size:clamp(21px,2.1vw,26px);line-height:1.18;margin:0 0 8px;font-weight:800;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h3,.gb-pb .gb-sec--night .gb-h3{color:inherit}
.gb-pb .gb-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.gb-pb .gb-table-wrap{overflow-x:auto}
.gb-pb a:focus-visible,.gb-pb summary:focus-visible,.gb-pb button:focus-visible{outline:3px solid var(--leaf);outline-offset:3px;border-radius:6px}
.gb-pb .gb-sec--night a:focus-visible,.gb-pb .gb-sec--brown a:focus-visible{outline-color:var(--lime)}
.gb-pb svg{width:100%;height:100%;display:block}
.gb-pb .gb-btn{min-height:60px;font-size:19px;padding:0 34px}

/* ——— benefits ——— */
.gb-pb .gb-ben__in{display:grid;gap:clamp(30px,4.5vw,64px);align-items:center}
@media(min-width:900px){.gb-pb .gb-ben__in{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
.gb-pb .gb-ben__shot{border-radius:24px;overflow:hidden;background:var(--sand);aspect-ratio:4/3}
.gb-pb .gb-ben__shot img{width:100%;height:100%;object-fit:cover}
.gb-pb .gb-ben__shot .gb-ph{height:100%;border-radius:0;font-size:16px}
.gb-pb .gb-ben__list{list-style:none;margin:0;padding:0;display:grid;gap:clamp(26px,3.4vw,38px)}
.gb-pb .gb-ben__ico{display:block;width:44px;height:44px;color:var(--leaf);margin-bottom:14px}
.gb-pb .gb-ben__item p{color:var(--dim);max-width:46ch;font-size:clamp(18px,1.8vw,20px);line-height:1.6}

/* entrance. JS adds data-gb-anim, so with no JS everything is simply visible. */
.gb-pb[data-gb-anim] .gb-rise{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.3,1)}
.gb-pb[data-gb-anim] .gb-rise--late{transition-delay:.12s}
.gb-pb[data-gb-anim] .gb-rise.is-in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  .gb-pb[data-gb-anim] .gb-rise{opacity:1;transform:none;transition:none}
}
{% endstylesheet %}

{% javascript %}
  (function () {
    var run = function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return;
      var io = window.__gbRiseIO;
      if (!io) {
        io = window.__gbRiseIO = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
          });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
      }
      Array.prototype.forEach.call(document.querySelectorAll('.gb-pb'), function (root) {
        root.setAttribute('data-gb-anim', '');
        Array.prototype.forEach.call(root.querySelectorAll('.gb-rise'), function (el) {
          if (el.hasAttribute('data-gb-seen')) return;
          el.setAttribute('data-gb-seen', '');
          io.observe(el);
        });
      });
    };
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', run); } else { run(); }
    document.addEventListener('shopify:section:load', run);
  }());
{% endjavascript %}

{% schema %}
{
  "name": "GB Benefits",
  "tag": "section",
  "class": "gb-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Anything written as [ LIKE THIS ] shows as a placeholder until you replace it. Nothing here is invented."
    },
    {
      "type": "text",
      "id": "ben_eyebrow",
      "label": "Eyebrow",
      "default": "Why people keep one"
    },
    {
      "type": "text",
      "id": "ben_heading",
      "label": "Heading",
      "default": "Kneel. Flip. Sit."
    },
    {
      "type": "textarea",
      "id": "ben_text",
      "label": "Text",
      "default": "One frame does the whole job. Pad side up to kneel, flipped over to sit."
    },
    {
      "type": "image_picker",
      "id": "ben_image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "ben_placeholder",
      "label": "Empty photo label",
      "default": "Photo: the kneeler in use"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kneeler and stool in one"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Pad side up to kneel. Flip it over and it is a seat."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "infinity",
          "options": [
            {
              "value": "infinity",
              "label": "Infinity"
            },
            {
              "value": "layers",
              "label": "Layers"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "clock",
              "label": "Clock"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GB Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "infinity",
            "title": "Kneel one way, sit the other",
            "text": "Pad side up to kneel. Flip it over and the frame is a seat at bed height."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Handles to stand up",
            "text": "Getting down is easy. The steel handles give you something solid to push on."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "layers",
            "title": "Arrives assembled, folds flat",
            "text": "Open the box and unfold it. Folded, it hangs on a nail in the shed."
          }
        }
      ]
    }
  ]
}
{% endschema %}
