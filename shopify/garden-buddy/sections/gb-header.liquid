{%- comment -%}
  GARDEN BUDDY — trust bar + sticky main header.
  Big tap targets, 16px+ text. Mobile menu is a plain details/summary.
{%- endcomment -%}

{%- liquid
  assign menu = linklists[section.settings.link_list]
  assign wordmark = section.settings.wordmark | default: 'GARDEN BUDDY'
  assign cta_label = section.settings.cta_label | default: 'Order Now'
  assign cta_url = section.settings.cta_url | default: routes.all_products_collection_url
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=Caveat:wght@600;700&display=swap">
{{ 'gb.css' | asset_url | stylesheet_tag }}

<div class="gb gb-hdr-sec">

  {%- if section.settings.show_bar -%}
    <div class="gb-tbar">
      <ul class="gb-wrap gb-tbar__row">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1.5 6.5h11v9h-11z"/><path d="M12.5 9.5h4.6l2.9 3v3h-7.5z"/><circle cx="6" cy="17.5" r="2"/><circle cx="16.5" cy="17.5" r="2"/></svg>
          <span>{{ section.settings.bar_text_1 | escape }}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2.5l7.5 3v6c0 4.6-3.1 8.4-7.5 10-4.4-1.6-7.5-5.4-7.5-10v-6z"/><path d="M8.6 11.8l2.4 2.4 4.4-4.6"/></svg>
          <span>{{ section.settings.bar_text_2 | escape }}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 14v-2.5a7.5 7.5 0 0 1 15 0V14"/><path d="M4.5 12.5h2V18h-2a1.5 1.5 0 0 1-1.5-1.5v-2.5a1.5 1.5 0 0 1 1.5-1.5z"/><path d="M19.5 12.5h-2V18h2a1.5 1.5 0 0 0 1.5-1.5v-2.5a1.5 1.5 0 0 0-1.5-1.5z"/><path d="M19 18v.8a2.7 2.7 0 0 1-2.7 2.7H13"/></svg>
          <span>{{ section.settings.bar_text_3 | escape }}</span>
        </li>
      </ul>
    </div>
  {%- endif -%}

  <header class="gb-hdr">
    <div class="gb-wrap gb-hdr__in">

      <details class="gb-hdr__menu">
        <summary class="gb-hdr__burger" aria-label="Menu">
          <svg class="gb-hdr__ico gb-hdr__ico--open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="gb-hdr__ico gb-hdr__ico--close" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </summary>
        <nav class="gb-hdr__mnav" aria-label="Main, mobile">
          {%- for link in menu.links -%}
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- endfor -%}
          {%- if section.settings.show_search -%}
            <a href="{{ routes.search_url }}">Search</a>
          {%- endif -%}
        </nav>
      </details>

      <a class="gb-hdr__logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 600 | image_tag: alt: shop.name, class: 'gb-hdr__logo-img', loading: 'eager', widths: '200, 300, 460, 600' }}
        {%- else -%}
          <span class="gb-hdr__wordmark">{{ wordmark | escape }}</span>
        {%- endif -%}
      </a>

      <nav class="gb-hdr__nav" aria-label="Main">
        {%- for link in menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      </nav>

      <div class="gb-hdr__right">
        {%- if section.settings.show_search -%}
          <a class="gb-hdr__icon-link" href="{{ routes.search_url }}" aria-label="Search">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
          </a>
        {%- endif -%}
        <a class="gb-hdr__cart" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l1 14H5L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
          <span class="gb-hdr__count" data-gb-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
        <a class="gb-hdr__cta" href="{{ cta_url }}">
          <span class="gb-hdr__cta-txt">{{ cta_label | escape }}</span>
        </a>
      </div>

    </div>
  </header>
</div>

{% stylesheet %}
.shopify-section:has(> .gb-hdr-sec){position:sticky;top:0;z-index:50}
.gb-hdr-sec :focus-visible{outline:3px solid var(--lime);outline-offset:2px;border-radius:6px}
/* trust bar */
.gb-hdr-sec .gb-tbar{background:var(--night);color:var(--night-ink)}
.gb-hdr-sec .gb-tbar__row{list-style:none;margin:0;display:flex;align-items:center;justify-content:space-between;gap:22px;padding-block:10px}
.gb-hdr-sec .gb-tbar__row li{display:inline-flex;align-items:center;gap:9px;font-size:14px;font-weight:600;letter-spacing:.03em;text-transform:uppercase;white-space:nowrap;line-height:1.2}
.gb-hdr-sec .gb-tbar__row svg{width:19px;height:19px;flex:0 0 19px;color:var(--lime)}
@media(max-width:860px){
  .gb-hdr-sec .gb-tbar__row{justify-content:flex-start;gap:26px;overflow-x:auto;flex-wrap:nowrap;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .gb-hdr-sec .gb-tbar__row::-webkit-scrollbar{display:none}
  .gb-hdr-sec .gb-tbar__row li{font-size:13px}
}
/* main header */
.gb-hdr-sec .gb-hdr{position:relative;background:var(--paper);border-bottom:1px solid var(--rule)}
.gb-hdr-sec .gb-hdr__in{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;min-height:70px}
@media(min-width:960px){.gb-hdr-sec .gb-hdr__in{min-height:84px;gap:28px}}
/* logo */
.gb-hdr-sec .gb-hdr__logo{display:inline-flex;align-items:center;min-height:48px;text-decoration:none;color:var(--ink);justify-self:center}
@media(min-width:960px){.gb-hdr-sec .gb-hdr__logo{justify-self:start;order:-1}}
.gb-hdr-sec .gb-hdr__logo-img{height:38px;width:auto}
@media(min-width:960px){.gb-hdr-sec .gb-hdr__logo-img{height:46px}}
.gb-hdr-sec .gb-hdr__wordmark{font-family:var(--font-h);font-weight:800;font-size:clamp(20px,2.2vw,26px);letter-spacing:-.01em;line-height:1;white-space:nowrap;color:var(--ink)}
/* nav */
.gb-hdr-sec .gb-hdr__nav{display:none;gap:32px;justify-content:center;font-size:16px;font-weight:600}
.gb-hdr-sec .gb-hdr__nav a{display:inline-flex;align-items:center;min-height:48px;text-decoration:none;color:var(--ink);border-bottom:3px solid transparent}
.gb-hdr-sec .gb-hdr__nav a:hover,.gb-hdr-sec .gb-hdr__nav a[aria-current]{border-bottom-color:var(--lime)}
@media(min-width:960px){.gb-hdr-sec .gb-hdr__nav{display:flex}}
/* right actions */
.gb-hdr-sec .gb-hdr__right{display:flex;align-items:center;gap:6px;justify-self:end}
.gb-hdr-sec .gb-hdr__icon-link,.gb-hdr-sec .gb-hdr__cart{position:relative;display:inline-flex;align-items:center;justify-content:center;min-width:48px;min-height:48px;border-radius:12px;text-decoration:none;color:var(--ink)}
.gb-hdr-sec .gb-hdr__icon-link:hover,.gb-hdr-sec .gb-hdr__cart:hover{background:var(--sand)}
.gb-hdr-sec .gb-hdr__count{position:absolute;top:4px;right:2px;display:inline-flex;align-items:center;justify-content:center;min-width:21px;height:21px;padding:0 6px;border-radius:11px;background:var(--lime);color:var(--lime-ink);font-size:12.5px;font-weight:800;line-height:1}
.gb-hdr-sec .gb-hdr__count[hidden]{display:none}
.gb-hdr-sec .gb-hdr__cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;min-width:48px;padding:0 22px;margin-left:6px;border-radius:999px;background:var(--lime);color:var(--lime-ink);font-family:var(--font-b);font-size:16px;font-weight:700;text-decoration:none;white-space:nowrap}
.gb-hdr-sec .gb-hdr__cta:hover{background:var(--lime-2)}
.gb-hdr-sec .gb-hdr__cta:active{transform:translateY(1px)}
@media(max-width:400px){.gb-hdr-sec .gb-hdr__cta{padding:0;width:48px}.gb-hdr-sec .gb-hdr__cta-txt{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .gb-hdr-sec .gb-hdr__cta::after{content:"";width:20px;height:20px;background:var(--lime-ink);-webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14M13 6l6 6-6 6'/></svg>") center/contain no-repeat;mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14M13 6l6 6-6 6'/></svg>") center/contain no-repeat}}
/* mobile menu: details/summary */
.gb-hdr-sec .gb-hdr__menu{position:static}
.gb-hdr-sec .gb-hdr__burger{display:inline-flex;align-items:center;justify-content:center;min-width:48px;min-height:48px;margin-left:-8px;border-radius:12px;cursor:pointer;list-style:none;color:var(--ink)}
.gb-hdr-sec .gb-hdr__burger::-webkit-details-marker{display:none}
.gb-hdr-sec .gb-hdr__burger:hover{background:var(--sand)}
.gb-hdr-sec .gb-hdr__ico--close{display:none}
.gb-hdr-sec .gb-hdr__menu[open] .gb-hdr__ico--open{display:none}
.gb-hdr-sec .gb-hdr__menu[open] .gb-hdr__ico--close{display:block}
.gb-hdr-sec .gb-hdr__mnav{position:absolute;left:0;right:0;top:100%;z-index:2;display:grid;padding:6px var(--pad) 18px;background:var(--paper);border-bottom:1px solid var(--rule);box-shadow:0 14px 30px rgba(15,42,24,.16)}
.gb-hdr-sec .gb-hdr__mnav a{display:flex;align-items:center;min-height:56px;border-bottom:1px solid var(--rule);text-decoration:none;color:var(--ink);font-size:18px;font-weight:600}
.gb-hdr-sec .gb-hdr__mnav a[aria-current]{box-shadow:inset 3px 0 0 var(--lime);padding-left:12px}
@media(min-width:960px){.gb-hdr-sec .gb-hdr__menu{display:none}}
{% endstylesheet %}

{% javascript %}
(function () {
  function init(root) {
    if (root.dataset.gbInit) return;
    root.dataset.gbInit = '1';
    var count = root.querySelector('[data-gb-count]');
    var details = root.querySelector('details');
    if (details) {
      document.addEventListener('click', function (e) {
        if (details.open && !details.contains(e.target)) details.open = false;
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && details.open) details.open = false;
      });
    }
    function refresh() {
      if (!count) return;
      fetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (c) { count.textContent = c.item_count; count.hidden = c.item_count === 0; })
        .catch(function () {});
    }
    window.addEventListener('pageshow', function (e) { if (e.persisted) refresh(); });
    document.addEventListener('cart:update', refresh);
  }
  function boot() { document.querySelectorAll('.gb-hdr-sec').forEach(init); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  document.addEventListener('shopify:section:load', boot);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Garden Buddy header",
  "settings": [
    { "type": "header", "content": "Trust bar" },
    { "type": "checkbox", "id": "show_bar", "label": "Show the trust bar", "default": true },
    { "type": "text", "id": "bar_text_1", "label": "Item 1 (truck)", "default": "Free Shipping" },
    { "type": "text", "id": "bar_text_2", "label": "Item 2 (shield)", "default": "30-Day Money Back Guarantee" },
    { "type": "text", "id": "bar_text_3", "label": "Item 3 (headset)", "default": "24/7 Support" },
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "wordmark", "label": "Wordmark text", "default": "GARDEN BUDDY", "info": "Used when no logo image is set." },
    { "type": "header", "content": "Menu" },
    { "type": "link_list", "id": "link_list", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": false },
    { "type": "header", "content": "Order button" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Order Now" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ]
}
{% endschema %}
