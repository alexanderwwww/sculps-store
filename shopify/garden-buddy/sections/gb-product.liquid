{%- comment -%}
  GARDEN BUDDY — product buy box.
  Pack (1 Kneeler / Kneeler + Tool Set / 2 Kneelers + Tool Set) x Color (Blue / Brown).
  Prices, compare-at and availability ALWAYS come from the variants. Nothing is hardcoded.
  Anything written as [ LIKE THIS ] in a text setting renders as a highlighted fill span.
  No ratings, review counts or urgency are rendered unless the merchant types them in.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'
  assign tool_set = all_products['garden-tool-set']

  comment
    Work out which option is the pack and which is the colour by name, so the
    section keeps working if the merchant reorders options in admin.
  endcomment
  assign pack_idx = 0
  assign color_idx = 1
  for opt in product.options_with_values
    assign nm = opt.name | downcase
    if nm contains 'colo'
      assign color_idx = forloop.index0
    elsif nm contains 'pack' or nm contains 'quant' or nm contains 'size'
      assign pack_idx = forloop.index0
    endif
  endfor
  assign packs = product.options_with_values[pack_idx].values
  assign colors = product.options_with_values[color_idx].values
  if product.options.size < 2
    assign colors = '' | split: ','
  endif

  comment
    Preselect: URL ?variant= wins. Else the 2nd pack in the first colour when it is
    in stock (that is the card carrying the flag). Else first available.
  endcomment
  assign selected = blank
  if product.selected_variant
    assign selected = product.selected_variant
  elsif packs.size >= 2
    assign first_color = colors[0]
    for v in product.variants
      if v.options[pack_idx] == packs[1] and v.available
        if colors.size == 0 or v.options[color_idx] == first_color
          assign selected = v
          break
        endif
      endif
    endfor
  endif
  if selected == blank
    assign selected = product.selected_or_first_available_variant
  endif
  if selected == blank
    assign selected = product.variants | first
  endif

  assign sel_pack = selected.options[pack_idx]
  assign sel_color = selected.options[color_idx]

  assign subtitle = s.subtitle
  if subtitle == blank
    assign subtitle = product.description | split: '</p>' | first | strip_html | strip
  endif

  assign ph_captions = 'Clean product shot|Kneeling, in the garden|Flipped into a stool|Folded flat, carried by the handle|Pad and pouches, close|The tool set, laid out' | split: '|'
  assign media_n = product.media.size
  assign ph_pad = 6 | minus: media_n
-%}

<div class="gb gb-product" data-gb-product>
  <div class="gb-wrap gb-product__grid">

    {%- comment -%} ============ GALLERY ============ {%- endcomment -%}
    <div class="gb-gal">
      <div class="gb-gal__stage">

        <div class="gb-gal__frame">
          <div class="gb-gal__track" data-gb-track aria-label="Product photos">
            {%- for media in product.media -%}
              <div class="gb-gal__slide" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'video' -%}
                    {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, image_size: '1200x' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag }}
                  {%- else -%}
                    <img
                      src="{{ media | image_url: width: 1400 }}"
                      srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1400 }} 1400w"
                      sizes="(min-width: 1000px) 50vw, 100vw"
                      alt="{{ media.alt | default: product.title | escape }}"
                      width="{{ media.width | default: 1400 }}" height="{{ media.height | default: 1400 }}"
                      {% unless forloop.first %}loading="lazy"{% endunless %}>
                {%- endcase -%}
              </div>
            {%- endfor -%}
            {%- if ph_pad > 0 -%}
              {%- for i in (1..ph_pad) -%}
                {%- assign ph_i = media_n | plus: forloop.index0 | modulo: 6 -%}
                <div class="gb-gal__slide" data-media-id="ph{{ i }}">
                  <div class="gb-ph gb-gal__ph"><span>{{ ph_captions[ph_i] }}<small>Photo coming</small></span></div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>


          <button type="button" class="gb-gal__arrow gb-gal__arrow--prev" data-gb-prev aria-label="Previous photo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button type="button" class="gb-gal__arrow gb-gal__arrow--next" data-gb-next aria-label="Next photo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>

        <div class="gb-gal__dots" data-gb-dots role="tablist" aria-label="Choose a photo">
          {%- assign dot_n = media_n | plus: ph_pad -%}
          {%- for i in (1..dot_n) -%}
            <button type="button" class="gb-gal__dot" role="tab" data-gb-dot="{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Photo {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      </div>


    </div>

    {%- comment -%} ============ BUY COLUMN ============ {%- endcomment -%}
    <div class="gb-buy" id="gb-buy">
      {%- comment -%} No default rating. Blank unless the merchant types real numbers. {%- endcomment -%}
      {%- if s.rating_text != blank or s.rating_count != blank -%}
        <p class="gb-rating">
          <span class="gb-rating__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5L2.6 9.4l6.5-.9z"/></svg>
            {%- endfor -%}
          </span>
          {%- if s.rating_text != blank -%}<span class="gb-rating__txt">{{ s.rating_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>{%- endif -%}
          {%- if s.rating_count != blank -%}<span class="gb-rating__count">{{ s.rating_count | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>{%- endif -%}
        </p>
      {%- endif -%}

      <h1 class="gb-h1 gb-buy__title">{{ product.title }}</h1>

      {%- if subtitle != blank -%}
        <p class="gb-buy__sub">{{ subtitle | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
      {%- endif -%}

      {%- liquid
        assign hero_save = 0
        if selected.compare_at_price > selected.price
          assign hero_save = selected.compare_at_price | minus: selected.price | times: 100 | divided_by: selected.compare_at_price
        endif
      -%}
      <p class="gb-price" data-gb-hero>
        <span class="gb-price__now" data-gb-hero-now>{{ selected.price | money }}</span>
        <s class="gb-price__was" data-gb-hero-was {% if hero_save <= 0 %}hidden{% endif %}>{{ selected.compare_at_price | money }}</s>
        <span class="gb-price__off" data-gb-hero-off {% if hero_save <= 0 %}hidden{% endif %}>{{ hero_save }}% off</span>
      </p>

      <ul class="gb-buy__bullets">
        {%- for i in (1..3) -%}
          {%- assign key = 'bullet_' | append: i -%}
          {%- assign line = s[key] -%}
          {%- if line != blank -%}
            <li class="gb-check">{{ line | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- form 'product', product, id: 'gb-form', class: 'gb-form' -%}
        <input type="hidden" name="id" value="{{ selected.id }}" data-gb-variant-id>

        {%- if colors.size > 0 -%}
          <div class="gb-field">
            <p class="gb-field__label">Color: <b data-gb-color-name>{{ sel_color }}</b></p>
            <div class="gb-swatches" role="group" aria-label="Color">
              {%- for c in colors -%}
                {%- assign cl = c | downcase -%}
                {%- assign hex = 'var(--dim)' -%}
                {%- if cl contains 'blue' -%}{%- assign hex = '#1F3A6E' -%}
                {%- elsif cl contains 'brown' -%}{%- assign hex = '#6B4F35' -%}
                {%- elsif cl contains 'green' -%}{%- assign hex = 'var(--leaf)' -%}
                {%- elsif cl contains 'black' -%}{%- assign hex = 'var(--ink)' -%}
                {%- endif -%}
                <button type="button" class="gb-swatch" data-gb-color="{{ c | escape }}" aria-pressed="{% if c == sel_color %}true{% else %}false{% endif %}" aria-label="{{ c | escape }}">
                  <span class="gb-swatch__chip" style="background:{{ hex }}" aria-hidden="true"><span class="gb-swatch__tick"></span></span>
                  <span class="gb-swatch__name">{{ c }}</span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="gb-field">
          <p class="gb-field__label gb-field__label--big">{{ s.pick_label | default: 'Choose Your Bundle' }}</p>
          <div class="gb-packs" role="radiogroup" aria-label="{{ s.pick_label | default: 'Choose Your Bundle' | escape }}">
            {%- for pack in packs -%}
              {%- liquid
                assign pv = blank
                for v in product.variants
                  if v.options[pack_idx] == pack
                    if colors.size == 0 or v.options[color_idx] == sel_color
                      assign pv = v
                      break
                    endif
                  endif
                endfor
                assign n = pack | split: ' ' | first | plus: 0
                if n < 1
                  assign n = 1
                endif
                assign has_set = false
                if pack contains 'Tool Set'
                  assign has_set = true
                endif
                assign save = 0
                if pv != blank and pv.compare_at_price > pv.price
                  assign save = pv.compare_at_price | minus: pv.price
                endif
                assign is_sel = false
                if pack == sel_pack
                  assign is_sel = true
                endif
                assign avail = false
                if pv != blank and pv.available
                  assign avail = true
                endif
                assign flag = ''
                if forloop.index == 2
                  assign flag = s.flag_2
                endif
                assign incl = pack
                if n > 1
                  assign incl = n | append: ' Garden Buddies'
                else
                  assign incl = '1 Garden Buddy'
                endif
                if has_set
                  assign incl = incl | append: ' + the tool set'
                endif
              -%}
              <label class="gb-pack{% if is_sel %} is-selected{% endif %}{% unless avail %} is-soldout{% endunless %}{% if flag != blank %} is-flagged{% endif %}" data-gb-pack="{{ pack | escape }}" data-units="{{ n }}" data-variant-id="{{ pv.id }}">
                <input type="radio" name="gb-pack" value="{{ pack | escape }}" {% if is_sel %}checked{% endif %} class="gb-pack__radio">
                {%- if flag != blank -%}<span class="gb-pack__flag">{{ flag }}</span>{%- endif -%}
                <span class="gb-pack__head">
                  <span class="gb-pack__mark" aria-hidden="true"></span>
                  <span class="gb-pack__body">
                    <span class="gb-pack__name">{{ pack }}</span>
                    <span class="gb-pack__incl">{{ incl }}</span>
                    <span class="gb-pack__each" data-gb-each>{% if n > 1 and pv != blank %}{{ pv.price | divided_by: n | money }} each{% endif %}</span>
                  </span>
                  <span class="gb-pack__price">
                    <s class="gb-pack__was" data-gb-was {% if save <= 0 %}hidden{% endif %}>{% if save > 0 %}{{ pv.compare_at_price | money }}{% endif %}</s>
                    <span class="gb-pack__now" data-gb-now>{% if pv != blank %}{{ pv.price | money }}{% endif %}</span>
                    <span class="gb-pack__save" data-gb-save {% if save <= 0 %}hidden{% endif %}>{% if save > 0 %}Save {{ save | money }}{% endif %}</span>
                    <span class="gb-pack__so" data-gb-so {% if avail %}hidden{% endif %}>Sold out</span>
                  </span>
                </span>
                {%- liquid
                  assign imgkey = 'pack_img_' | append: forloop.index
                  assign pack_img = s[imgkey]
                  if pack_img == blank
                    assign pack_img = pv.featured_media
                  endif
                -%}
                {%- if pack_img != blank or has_set -%}
                  <span class="gb-pack__extra">
                    {%- if pack_img != blank -%}<img src="{{ pack_img | image_url: width: 200 }}" alt="" width="72" height="72" loading="lazy">
                    {%- elsif s.set_thumb != blank -%}<img src="{{ s.set_thumb | image_url: width: 200 }}" alt="" width="72" height="72" loading="lazy">
                    {%- else -%}<span class="gb-pack__extra-ph" aria-hidden="true"></span>{%- endif -%}
                    <span class="gb-pack__extra-txt">{%- if has_set -%}<b>+ {{ tool_set.title | default: 'Garden Tool Set' }}</b> {{ s.set_blurb | default: 'A separate 10-piece set: folding stool, tool bag, six steel tools, claw gloves and a sprayer.' }}{%- endif -%}</span>
                  </span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        </div>

        <button type="submit" class="gb-buy__add" data-gb-add {% unless selected.available %}disabled{% endunless %}>
          <svg class="gb-buy__cart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 3.5h2.2l2.3 11.2h10.3"/><path d="M6.4 6.6h14l-1.6 6.4H7.7"/><circle cx="9.5" cy="19.2" r="1.5"/><circle cx="17.5" cy="19.2" r="1.5"/></svg>
          <span data-gb-add-label>{% if selected.available %}Add to cart{% else %}Sold out{% endif %}</span>
          <span class="gb-buy__dot" aria-hidden="true">&middot;</span>
          <span data-gb-add-price>{{ selected.price | money }}</span>
        </button>

        {%- if s.show_buy_now -%}
          <div class="gb-buy__dyn">{{ form | payment_button }}</div>
        {%- endif -%}

        <ul class="gb-trust">
          {%- for i in (1..3) -%}
            {%- assign key = 'trust_' | append: i -%}
            {%- assign line = s[key] -%}
            {%- if line != blank -%}
              <li>
                <span class="gb-trust__ic" aria-hidden="true">
                  {%- if i == 1 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 10h4l3 3v2.5h-7z"/><circle cx="6.5" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/></svg>
                  {%- elsif i == 2 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.4-3 8.1-7 10-4-1.9-7-5.6-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
                  {%- endif -%}
                </span>
                <span>{{ line | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if shop.enabled_payment_types.size > 0 -%}
          <div class="gb-pay" aria-label="Accepted payment methods">
            {% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}
          </div>
        {%- endif -%}
      {%- endform -%}

      {%- assign usp_n = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'usp' -%}{%- assign usp_n = usp_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if usp_n > 0 or s.brand_logo != blank -%}
        <div class="gb-brand">
          <div class="gb-brand__mark">
            {%- if s.brand_logo != blank -%}
              <img src="{{ s.brand_logo | image_url: width: 460 }}" alt="{{ shop.name | escape }}" width="230" height="auto" loading="lazy">
            {%- else -%}
              <span class="gb-brand__word">Garden Buddy</span>
            {%- endif -%}
          </div>
          {%- if usp_n > 0 -%}
            <ul class="gb-brand__list">
              {%- for block in section.blocks -%}
                {%- if block.type != 'usp' -%}{%- continue -%}{%- endif -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.label | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if s.brand_line != blank -%}
            <p class="gb-brand__line gb-script">{{ s.brand_line }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-gb-config>
    {
      "moneyFormat": {{ shop.money_format | json }},
      "packIdx": {{ pack_idx }},
      "colorIdx": {{ color_idx }},
      "selectedId": {{ selected.id | json }},
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id | json }},
            "price": {{ v.price | json }},
            "compare_at_price": {{ v.compare_at_price | json }},
            "available": {{ v.available | json }},
            "option1": {{ v.option1 | json }},
            "option2": {{ v.option2 | json }},
            "options": {{ v.options | json }},
            "featured_media_id": {{ v.featured_media.id | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>

{% stylesheet %}
.gb-product{padding:clamp(16px,3vw,40px) 0 clamp(40px,5vw,64px)}
.gb-product p{margin:0}
.gb-product .gb-product__grid{display:grid;gap:clamp(18px,2.4vw,36px)}
@media(min-width:1000px){.gb-product .gb-product__grid{grid-template-columns:minmax(0,55fr) minmax(400px,45fr);align-items:start}}

/* ===== gallery ===== */
.gb-product .gb-gal{display:grid;gap:12px}
@media(min-width:1000px){.gb-product .gb-gal{position:sticky;top:84px}}
.gb-product .gb-gal__stage{display:grid;gap:14px}


.gb-product .gb-gal__frame{position:relative;border-radius:var(--radius);overflow:hidden;background:var(--sand)}
.gb-product .gb-gal__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;aspect-ratio:1}
.gb-product .gb-gal__track::-webkit-scrollbar{display:none}
.gb-product .gb-gal__track:focus-visible{outline:3px solid var(--leaf);outline-offset:-3px}
.gb-product .gb-gal__slide{position:relative;flex:0 0 100%;scroll-snap-align:start;aspect-ratio:1}
.gb-product .gb-gal__slide img,.gb-product .gb-gal__slide video,.gb-product .gb-gal__slide iframe,.gb-product .gb-gal__slide model-viewer{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:0}
.gb-product .gb-gal__ph{position:absolute;inset:0;font-size:16px}

/* overlays */

.gb-product .gb-gal__arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:32px;height:32px;border-radius:50%;border:0;display:grid;place-items:center;cursor:pointer;background:var(--paper);color:var(--brown);opacity:.12;box-shadow:none;transition:opacity .15s}
.gb-product .gb-gal__arrow:hover,.gb-product .gb-gal__arrow:focus-visible{opacity:.85}
.gb-product .gb-gal__frame:hover .gb-gal__arrow{opacity:.45}
.gb-product .gb-gal__arrow svg{width:17px;height:17px}
.gb-product .gb-gal__arrow:hover{background:#fff}
.gb-product .gb-gal__arrow:focus-visible{outline:3px solid var(--leaf);outline-offset:2px}
.gb-product .gb-gal__arrow--prev{left:12px}.gb-product .gb-gal__arrow--next{right:12px}
@media(min-width:1000px){.gb-product .gb-gal__arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:32px;height:32px;border-radius:50%;border:0;display:grid;place-items:center;cursor:pointer;background:var(--paper);color:var(--brown);opacity:.12;box-shadow:none;transition:opacity .15s}}

.gb-product .gb-gal__dots{display:flex;gap:9px;justify-content:center;flex-wrap:wrap;padding-top:4px}
.gb-product .gb-gal__dot{width:11px;height:11px;padding:0;border-radius:50%;border:2px solid var(--brown);background:transparent;cursor:pointer;transition:background .15s,transform .15s}
.gb-product .gb-gal__dot[aria-selected="true"]{background:var(--lime);border-color:var(--brown);transform:scale(1.25)}
.gb-product .gb-gal__dot:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
@media(max-width:999px){.gb-product .gb-gal__frame{margin-inline:calc(-1 * var(--pad));border-radius:0}}

.gb-product .gb-price{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin:0}
.gb-product .gb-price__now{font-family:var(--font-h);font-weight:700;font-size:clamp(34px,4.4vw,46px);line-height:1;letter-spacing:-.02em;color:var(--brown)}
.gb-product .gb-price__was{font-size:21px;font-weight:600;color:var(--dim)}
.gb-product .gb-price__off{background:var(--lime);color:var(--lime-ink);font-size:15px;font-weight:800;letter-spacing:.03em;padding:6px 13px;border-radius:999px}
.gb-product .gb-price__was[hidden],.gb-product .gb-price__off[hidden]{display:none}
.gb-product .gb-brand{margin-top:14px;background:var(--night);border-radius:16px;padding:22px 24px;display:grid;gap:14px;justify-items:center;text-align:center;border-bottom:5px solid var(--yellow)}
.gb-product .gb-brand__mark img{width:min(230px,60%);height:auto}
.gb-product .gb-brand__word{font-family:var(--font-h);font-weight:700;font-size:26px;color:var(--yellow)}
.gb-product .gb-brand__list{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px}
.gb-product .gb-brand__list li{display:flex;align-items:center;gap:9px;color:var(--night-ink);font-size:15.5px;font-weight:600}
.gb-product .gb-brand__list li::before{content:"";flex:0 0 18px;width:18px;height:18px;border-radius:50%;background:var(--lime) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2312290C' stroke-width='3.6' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.5l4.2 4.2L19 7'/></svg>") center/11px no-repeat}
.gb-product .gb-brand__line{margin:0;color:var(--yellow);font-size:23px}

/* ===== buy column ===== */
.gb-product .gb-buy{display:grid;gap:12px;align-content:start}
@media(min-width:1000px){.gb-product .gb-buy{position:sticky;top:96px}}
.gb-product .gb-buy__title{margin:0}
.gb-product .gb-buy__sub{color:var(--dim);font-size:17px;max-width:52ch}
.gb-product .gb-rating{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:15px;font-weight:700;color:var(--dim)}
.gb-product .gb-rating__stars{display:inline-flex;gap:2px;color:var(--yellow)}
.gb-product .gb-rating__stars svg{width:19px;height:19px}
.gb-product .gb-rating__txt{color:var(--ink)}
.gb-product .gb-buy__bullets{list-style:none;margin:0;padding:0;display:grid;gap:7px}
.gb-product .gb-form{display:grid;gap:14px}
.gb-product .gb-field{display:grid;gap:9px}
.gb-product .gb-field__label{font-weight:800;font-size:16px;letter-spacing:.01em}
.gb-product .gb-field__label b{font-weight:600;color:var(--dim)}
.gb-product .gb-field__label--big{font-family:var(--font-h);font-size:22px;font-weight:700;letter-spacing:-.01em}

.gb-product .gb-swatches{display:flex;gap:12px;flex-wrap:wrap}
.gb-product .gb-swatch{display:inline-flex;align-items:center;gap:12px;min-height:48px;padding:0 18px 0 6px;border-radius:999px;border:2px solid var(--rule);background:var(--paper);color:var(--ink);font-family:var(--font-h);font-weight:700;font-size:17px;cursor:pointer;transition:border-color .15s,box-shadow .15s}
.gb-product .gb-swatch__chip{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;box-shadow:inset 0 0 0 2px rgba(255,255,255,.4)}
.gb-product .gb-swatch__tick{width:20px;height:20px;background:no-repeat center/20px url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3.6' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.5l4.2 4.2L19 7'/></svg>");opacity:0}
.gb-product .gb-swatch[aria-pressed="true"]{border-color:var(--night)}
.gb-product .gb-swatch[aria-pressed="true"] .gb-swatch__chip{box-shadow:0 0 0 3px var(--night)}
.gb-product .gb-swatch[aria-pressed="true"] .gb-swatch__tick{opacity:1}
.gb-product .gb-swatch:focus-visible{outline:3px solid var(--leaf);outline-offset:3px}

/* ===== bundle cards: brown ground, lime selection ===== */
.gb-product .gb-packs{display:grid;gap:11px}
.gb-product .gb-pack{position:relative;display:grid;gap:12px;padding:18px 20px;background:var(--paper);color:var(--ink);border:3px solid var(--brown);border-radius:14px;cursor:pointer;transition:border-color .15s,box-shadow .15s}
.gb-product .gb-pack.is-flagged{margin-top:12px}
.gb-product .gb-pack:hover{box-shadow:0 4px 16px rgba(15,42,24,.18)}
.gb-product .gb-pack.is-selected{border-color:var(--brown);box-shadow:0 0 0 5px var(--lime),0 6px 18px rgba(42,29,17,.18)}
.gb-product .gb-pack > *{position:relative;z-index:1}

.gb-product .gb-pack__flag{position:absolute;z-index:2;top:-15px;left:18px;background:var(--lime);color:var(--lime-ink);font-family:var(--font-h);font-weight:800;font-size:13px;letter-spacing:.09em;text-transform:uppercase;padding:5px 14px;border-radius:999px}

.gb-product .gb-pack__radio{position:absolute;opacity:0;width:1px;height:1px;margin:0}
.gb-product .gb-pack__radio:focus-visible ~ .gb-pack__head .gb-pack__mark{outline:3px solid var(--lime);outline-offset:3px}
.gb-product .gb-pack__head{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;min-height:48px}
.gb-product .gb-pack__mark{width:28px;height:28px;border-radius:50%;border:2px solid var(--brown);display:grid;place-items:center;background:var(--paper)}
.gb-product .gb-pack.is-selected .gb-pack__mark{border-color:var(--brown);background:var(--brown)}
.gb-product .gb-pack.is-selected .gb-pack__mark::after{content:"";width:14px;height:14px;border-radius:50%;background:var(--lime)}
.gb-product .gb-pack__body{display:grid;gap:2px;min-width:0}
.gb-product .gb-pack__name{font-family:var(--font-h);font-weight:700;font-size:20px;line-height:1.2;color:var(--brown)}
.gb-product .gb-pack__incl,.gb-product .gb-pack__each{color:var(--dim);font-size:14.5px;line-height:1.35}
.gb-product .gb-pack__each:empty{display:none}

.gb-product .gb-pack__price{display:grid;justify-items:end;gap:4px;text-align:right}
.gb-product .gb-pack__now{font-family:var(--font-h);font-weight:700;font-size:26px;line-height:1;letter-spacing:-.01em;color:var(--brown)}
.gb-product .gb-pack__was{color:var(--dim);font-size:15px;font-weight:600}
.gb-product .gb-pack__save{display:inline-block;background:var(--lime);color:var(--lime-ink);font-size:12.5px;font-weight:800;letter-spacing:.04em;padding:4px 11px;border-radius:999px}
.gb-product .gb-pack__so{font-size:14px;font-weight:800;color:var(--dim);text-transform:uppercase;letter-spacing:.08em}
.gb-product .gb-pack.is-soldout{cursor:not-allowed;opacity:.55}
.gb-product .gb-pack.is-soldout .gb-pack__now{text-decoration:line-through}

.gb-product .gb-pack__extra{display:flex;gap:12px;align-items:center;padding:12px;background:var(--sand);border:1px solid var(--sand-2);border-radius:10px;font-size:14.5px;line-height:1.45;color:rgba(246,238,226,.8)}
.gb-product .gb-pack__extra img,.gb-product .gb-pack__extra-ph{flex:0 0 72px;width:72px;height:72px;border-radius:8px;object-fit:cover;background:var(--paper)}
.gb-product .gb-pack__extra-ph{background:repeating-linear-gradient(135deg,var(--sand-2) 0 8px,var(--sand) 8px 16px);box-shadow:inset 0 0 0 2px var(--brown);display:block}
.gb-product .gb-pack__extra b{display:block;font-family:var(--font-h);font-weight:700;color:var(--brown);font-size:16px}

/* add to cart */
.gb-product .gb-buy__add{width:100%;min-height:62px;display:flex;align-items:center;justify-content:center;gap:10px;border:0;border-radius:999px;background:var(--lime);color:var(--lime-ink);font-family:var(--font-h);font-size:20px;font-weight:800;letter-spacing:.01em;cursor:pointer;transition:background .15s,transform .05s}
.gb-product .gb-buy__add:hover{background:var(--lime-2)}
.gb-product .gb-buy__add:active{transform:translateY(1px)}
.gb-product .gb-buy__add[disabled]{opacity:.55;cursor:not-allowed}
.gb-product .gb-buy__add:focus-visible{outline:3px solid var(--night);outline-offset:3px}
.gb-product .gb-buy__dyn{margin-top:10px}
.gb-product .gb-buy__dyn .shopify-payment-button__button{min-height:60px;border-radius:999px;font-family:var(--font-b);font-weight:800;font-size:19px;background:var(--night);color:#fff}
.gb-product .gb-buy__dyn .shopify-payment-button__button--unbranded{background:var(--night);color:#fff}
.gb-product .gb-buy__dyn .shopify-payment-button__button--unbranded:hover:not([disabled]){background:var(--brown)}
.gb-product .gb-buy__dyn .shopify-payment-button__more-options{margin-top:8px;color:var(--dim);font-size:15px;text-decoration:underline}
.gb-product .gb-buy__cart{width:24px;height:24px;flex:0 0 24px}
.gb-product .gb-buy__dot{opacity:.6}

.gb-product .gb-trust{list-style:none;margin:0;padding:0;display:flex;gap:10px 20px;flex-wrap:wrap;justify-content:space-between;color:var(--dim);font-size:14.5px;font-weight:700}
.gb-product .gb-trust li{display:flex;gap:8px;align-items:center}
.gb-product .gb-trust__ic{display:grid;place-items:center;color:var(--leaf)}
.gb-product .gb-trust__ic svg{width:22px;height:22px}
.gb-product .gb-pay{display:flex;flex-wrap:wrap;gap:8px;align-items:center;opacity:.85}
.gb-product .gb-pay svg{width:40px;height:26px}

@media(max-width:520px){
  .gb-product .gb-pack__head{grid-template-columns:auto 1fr;row-gap:10px}
  .gb-product .gb-pack__price{grid-column:1 / -1;justify-items:start;text-align:left}
  .gb-product .gb-trust{justify-content:flex-start}
}
@media(prefers-reduced-motion:reduce){
  .gb-product .gb-pack,.gb-product .gb-swatch,.gb-product .gb-buy__add,.gb-product .gb-gal__arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:32px;height:32px;border-radius:50%;border:0;display:grid;place-items:center;cursor:pointer;background:var(--paper);color:var(--brown);opacity:.12;box-shadow:none;transition:opacity .15s}
  .gb-product .gb-buy__add:active{transform:none}
}
{% endstylesheet %}

{% javascript %}
(function () {
  function formatMoney(cents, format) {
    if (typeof cents === 'string') cents = cents.replace('.', '');
    cents = parseInt(cents, 10) || 0;
    format = format || '${{amount}}';
    var re = /\{\{\s*(\w+)\s*\}\}/;
    var m = format.match(re);
    var key = m ? m[1] : 'amount';
    function num(n, precision, thousands, decimal) {
      var s = (Math.abs(n) / 100).toFixed(precision).split('.');
      s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, thousands);
      return (n < 0 ? '-' : '') + (s[1] ? s[0] + decimal + s[1] : s[0]);
    }
    var v;
    switch (key) {
      case 'amount_no_decimals': v = num(cents, 0, ',', '.'); break;
      case 'amount_with_comma_separator': v = num(cents, 2, '.', ','); break;
      case 'amount_no_decimals_with_comma_separator': v = num(cents, 0, '.', ','); break;
      case 'amount_with_apostrophe_separator': v = num(cents, 2, "'", '.'); break;
      case 'amount_no_decimals_with_space_separator': v = num(cents, 0, ' ', '.'); break;
      case 'amount_with_space_separator': v = num(cents, 2, ' ', ','); break;
      case 'amount_with_period_and_space_separator': v = num(cents, 2, ' ', '.'); break;
      default: v = num(cents, 2, ',', '.');
    }
    return format.replace(re, v);
  }

  function init(root) {
    if (root.dataset.gbReady) return;
    root.dataset.gbReady = '1';
    var cfgEl = root.querySelector('[data-gb-config]');
    var cfg = {};
    try { cfg = JSON.parse(cfgEl.textContent); } catch (e) { cfg = { variants: [] }; }
    var money = function (c) { return formatMoney(c, cfg.moneyFormat); };
    var $ = function (s) { return root.querySelector(s); };
    var $$ = function (s) { return Array.prototype.slice.call(root.querySelectorAll(s)); };
    var pIdx = cfg.packIdx || 0, cIdx = cfg.colorIdx == null ? 1 : cfg.colorIdx;
    var variants = cfg.variants || [];

    var idInput = $('[data-gb-variant-id]');
    var addBtn = $('[data-gb-add]');
    var form = root.querySelector('#gb-form');
    if (form) {
      form.addEventListener('submit', function (ev) {
        if (!window.fetch) return;
        ev.preventDefault();
        var label = addLabel ? addLabel.textContent : '';
        if (addBtn) { addBtn.disabled = true; }
        if (addLabel) addLabel.textContent = 'Adding\u2026';
        fetch('/cart/add.js', { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
          .then(function (r) { if (!r.ok) throw new Error('add failed'); return r.json(); })
          .then(function () { window.location.href = '/cart'; })
          .catch(function () { form.submit(); })
          .finally(function () {
            if (addBtn) addBtn.disabled = false;
            if (addLabel && label) addLabel.textContent = label;
          });
      });
    }
    var addLabel = $('[data-gb-add-label]');
    var addPrice = $('[data-gb-add-price]');
    var heroNow = $('[data-gb-hero-now]'), heroWas = $('[data-gb-hero-was]'), heroOff = $('[data-gb-hero-off]');
    var swatches = $$('[data-gb-color]');
    var packs = $$('[data-gb-pack]');
    var colorName = $('[data-gb-color-name]');

    var state = { color: null, pack: null };
    var sel = variants.filter(function (v) { return String(v.id) === String(cfg.selectedId); })[0] || variants[0];
    if (sel) { state.color = sel.options[cIdx]; state.pack = sel.options[pIdx]; }

    function find(color, pack) {
      return variants.filter(function (v) {
        return v.options[pIdx] === pack && (color == null || v.options[cIdx] === color);
      })[0] || null;
    }

    function renderPacks() {
      packs.forEach(function (card) {
        var pack = card.dataset.gbPack;
        var units = parseInt(card.dataset.units, 10) || 1;
        var v = find(state.color, pack);
        var now = card.querySelector('[data-gb-now]');
        var was = card.querySelector('[data-gb-was]');
        var save = card.querySelector('[data-gb-save]');
        var each = card.querySelector('[data-gb-each]');
        var so = card.querySelector('[data-gb-so]');
        card.dataset.variantId = v ? v.id : '';
        var avail = !!(v && v.available);
        card.classList.toggle('is-soldout', !avail);
        if (so) so.hidden = avail;
        if (!v) { if (now) now.textContent = ''; if (was) was.hidden = true; if (save) save.hidden = true; if (each) each.textContent = ''; return; }
        if (now) now.textContent = money(v.price);
        var saved = v.compare_at_price && v.compare_at_price > v.price ? v.compare_at_price - v.price : 0;
        if (was) { was.hidden = !saved; was.textContent = saved ? money(v.compare_at_price) : ''; }
        if (save) { save.hidden = !saved; save.textContent = saved ? 'Save ' + money(saved) : ''; }
        if (each) each.textContent = units > 1 ? money(Math.round(v.price / units)) + ' each' : '';
      });
    }

    function renderSelection() {
      var v = find(state.color, state.pack);
      packs.forEach(function (card) {
        var on = card.dataset.gbPack === state.pack;
        card.classList.toggle('is-selected', on);
        var r = card.querySelector('input[type="radio"]');
        if (r) r.checked = on;
      });
      swatches.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.gbColor === state.color)); });
      if (colorName && state.color) colorName.textContent = state.color;
      if (!v) { if (addBtn) addBtn.disabled = true; if (addLabel) addLabel.textContent = 'Unavailable'; if (addPrice) addPrice.textContent = ''; return; }
      if (idInput) idInput.value = v.id;
      if (addBtn) addBtn.disabled = !v.available;
      if (addLabel) addLabel.textContent = v.available ? 'Add to cart' : 'Sold out';
      if (addPrice) addPrice.textContent = money(v.price);
      if (heroNow) heroNow.textContent = money(v.price);
      var off = (v.compare_at_price && v.compare_at_price > v.price)
        ? Math.round((v.compare_at_price - v.price) * 100 / v.compare_at_price) : 0;
      if (heroWas) { heroWas.hidden = !off; heroWas.textContent = off ? money(v.compare_at_price) : ''; }
      if (heroOff) { heroOff.hidden = !off; heroOff.textContent = off ? off + '% off' : ''; }
      try {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', v.id);
        window.history.replaceState({}, '', url.toString());
      } catch (e) {}
      /* deliberately no goToMedia here: the gallery stays on image 1 until the visitor moves it */
    }

    function pickPack(pack) { state.pack = pack; renderSelection(); }
    function pickColor(color) {
      state.color = color;
      renderPacks();
      var v = find(color, state.pack);
      if (!v || !v.available) {
        var alt = variants.filter(function (x) { return x.options[cIdx] === color && x.available; })[0];
        if (alt) state.pack = alt.options[pIdx];
      }
      renderSelection();
    }

    swatches.forEach(function (b) { b.addEventListener('click', function () { pickColor(b.dataset.gbColor); }); });
    packs.forEach(function (card) {
      var r = card.querySelector('input[type="radio"]');
      if (r) r.addEventListener('change', function () { if (r.checked) pickPack(card.dataset.gbPack); });
      card.addEventListener('click', function () { pickPack(card.dataset.gbPack); });
    });

    /* gallery */
    var track = $('[data-gb-track]');
    var slides = $$('.gb-gal__slide');
    var dots = $$('[data-gb-dot]');
    function goTo(i) {
      if (!track || !slides.length) return;
      i = (i + slides.length) % slides.length;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: track.clientWidth * i, behavior: reduce ? 'auto' : 'smooth' });
      dots.forEach(function (d, k) { d.setAttribute('aria-selected', String(k === i)); });
    }
    function current() { return track ? Math.round(track.scrollLeft / Math.max(1, track.clientWidth)) : 0; }
    function goToMedia(id) {
      var idx = -1;
      slides.forEach(function (sl, k) { if (sl.dataset.mediaId === String(id)) idx = k; });
      if (idx > -1) goTo(idx);
    }
    var prev = $('[data-gb-prev]'), next = $('[data-gb-next]');
    if (prev) prev.addEventListener('click', function () { goTo(current() - 1); });
    if (next) next.addEventListener('click', function () { goTo(current() + 1); });
    dots.forEach(function (d, k) { d.addEventListener('click', function () { goTo(k); }); });

    function current() { return track ? Math.round(track.scrollLeft / Math.max(track.clientWidth, 1)) : 0; }
    if (track) {
      var syncing;
      track.addEventListener('scroll', function () {
        clearTimeout(syncing);
        syncing = setTimeout(function () {
          var i = current();
          dots.forEach(function (d, k) { d.setAttribute('aria-selected', String(k === i)); });
        }, 80);
      });
      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current() - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current() + 1); }
      });
      track.setAttribute('tabindex', '0');
    }

    renderPacks();
    renderSelection();
  }

  function boot() { Array.prototype.forEach.call(document.querySelectorAll('[data-gb-product]'), init); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  document.addEventListener('shopify:section:load', boot);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Garden Buddy buy box",
  "tag": "section",
  "class": "gb-section",
  "max_blocks": 5,
  "settings": [
    { "type": "header", "content": "Photo overlays" },
    { "type": "paragraph", "content": "Anything written as [ LIKE THIS ] shows as a highlighted placeholder until you replace it. Leave a field blank to hide it." },
    { "type": "header", "content": "Rating (optional)" },
    { "type": "paragraph", "content": "Leave both blank until you have real reviews. Never enter numbers you cannot back up." },
    { "type": "text", "id": "rating_text", "label": "Rating text" },
    { "type": "text", "id": "rating_count", "label": "Review count" },
    { "type": "header", "content": "Description" },
    { "type": "textarea", "id": "subtitle", "label": "Short intro line", "info": "Falls back to the first paragraph of the product description." },
    { "type": "header", "content": "Bullets" },
    { "type": "text", "id": "bullet_1", "label": "Bullet 1", "default": "Reduces knee and back strain" },
    { "type": "text", "id": "bullet_2", "label": "Bullet 2", "default": "Thick, comfortable cushioning" },
    { "type": "text", "id": "bullet_3", "label": "Bullet 3", "default": "Foldable and lightweight design" },
    { "type": "text", "id": "bullet_4", "label": "Bullet 4", "default": "Complete tool set included in the bundles" },
    { "type": "text", "id": "bullet_5", "label": "Bullet 5", "default": "Storage bag included in the bundles" },
    { "type": "header", "content": "Bundles" },
    { "type": "text", "id": "pick_label", "label": "Heading above cards", "default": "Choose Your Bundle" },
    { "type": "text", "id": "flag_2", "label": "Flag on the 2nd card", "default": "Our pick", "info": "Our opinion only. No bestseller or popularity claims." },
    { "type": "header", "content": "Brand block under the buy box" },
    { "type": "image_picker", "id": "brand_logo", "label": "Logo" },
    { "type": "text", "id": "brand_line", "label": "Handwritten line", "default": "A happier garden starts here." },
    { "type": "checkbox", "id": "show_buy_now", "label": "Show Buy Now button", "default": true, "info": "Shopify's own express checkout. It shows Shop Pay, Apple Pay or Google Pay depending on the visitor." },
    { "type": "header", "content": "Bundle card images" },
    { "type": "image_picker", "id": "pack_img_1", "label": "Bundle 1 image" },
    { "type": "image_picker", "id": "pack_img_2", "label": "Bundle 2 image" },
    { "type": "image_picker", "id": "pack_img_3", "label": "Bundle 3 image" },
    { "type": "image_picker", "id": "set_thumb", "label": "Fallback tool set image" },
    { "type": "text", "id": "set_blurb", "label": "Tool set line on cards", "default": "A separate 10-piece set: folding stool, tool bag, six steel tools, claw gloves and a sprayer." },
    { "type": "header", "content": "Trust row" },
    { "type": "text", "id": "trust_1", "label": "Line 1", "default": "Free Shipping" },
    { "type": "text", "id": "trust_2", "label": "Line 2", "default": "30-Day Guarantee" },
    { "type": "text", "id": "trust_3", "label": "Line 3", "default": "Secure Checkout" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Feature icon",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Reduces knee & back pain" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "kneel",
          "options": [
            { "value": "kneel", "label": "Kneel" },
            { "value": "shield", "label": "Shield" },
            { "value": "cushion", "label": "Cushion" },
            { "value": "tools", "label": "Tools" },
            { "value": "carry", "label": "Carry" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Garden Buddy buy box",
      "blocks": [
        { "type": "usp", "settings": { "label": "Reduces knee & back pain", "icon": "kneel" } },
        { "type": "usp", "settings": { "label": "Sturdy & stable", "icon": "shield" } },
        { "type": "usp", "settings": { "label": "Thick comfortable pad", "icon": "cushion" } },
        { "type": "usp", "settings": { "label": "Complete tool set", "icon": "tools" } },
        { "type": "usp", "settings": { "label": "Easy to carry & store", "icon": "carry" } }
      ]
    }
  ]
}
{% endschema %}
