{%- comment -%}
  GARDEN BUDDY — buy box, above the fold.
  Pack (1 Kneeler / Kneeler + Tool Set / 2 Kneelers + Tool Set) x Color (Blue / Brown). Cards are one per pack value, read from the variants.
  Prices, compare-at and availability come from the variants. Nothing is hardcoded.
  Anything written as [ LIKE THIS ] in a text setting renders as a highlighted fill span.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'
  assign tool_set = all_products['garden-tool-set']

  comment
    Work out which option is the pack and which is the colour by name, so the
    section keeps working if the merchant reorders options in admin.
  endcomment
  assign pack_idx = 0
  assign color_idx = 1
  for opt in product.options_with_values
    assign nm = opt.name | downcase
    if nm contains 'colo'
      assign color_idx = forloop.index0
    elsif nm contains 'pack' or nm contains 'quant' or nm contains 'size'
      assign pack_idx = forloop.index0
    endif
  endfor
  assign packs = product.options_with_values[pack_idx].values
  assign colors = product.options_with_values[color_idx].values
  if product.options.size < 2
    assign colors = '' | split: ','
  endif

  comment
    Preselect: URL ?variant= wins. Else the 2nd pack in the first colour when it is
    in stock (that is the card flagged as our pick). Else first available.
  endcomment
  assign selected = blank
  if product.selected_variant
    assign selected = product.selected_variant
  elsif packs.size >= 2
    assign first_color = colors[0]
    for v in product.variants
      if v.options[pack_idx] == packs[1] and v.available
        if colors.size == 0 or v.options[color_idx] == first_color
          assign selected = v
          break
        endif
      endif
    endfor
  endif
  if selected == blank
    assign selected = product.selected_or_first_available_variant
  endif
  if selected == blank
    assign selected = product.variants | first
  endif

  assign sel_pack = selected.options[pack_idx]
  assign sel_color = selected.options[color_idx]
  assign eyebrow = product.type | default: 'Garden kneeler seat'
  assign ph_captions = 'Clean product shot|Kneeling, in the garden|Flipped into a stool|Folded flat, carried by the handle|Pad and pouches, close' | split: '|'
  assign media_n = product.media.size
  assign ph_pad = 5 | minus: media_n
-%}

<div class="gb gb-product" data-gb-product>
  <div class="gb-wrap gb-product__grid">

    {%- comment -%} ============ GALLERY ============ {%- endcomment -%}
    <div class="gb-gal">
      <div class="gb-gal__frame">
        <div class="gb-gal__track" data-gb-track aria-label="Product photos">
          {%- for media in product.media -%}
            <div class="gb-gal__slide" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'video' -%}
                  {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, image_size: '1200x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag }}
                {%- else -%}
                  <img
                    src="{{ media | image_url: width: 1400 }}"
                    srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1400 }} 1400w"
                    sizes="(min-width: 1000px) 55vw, 100vw"
                    alt="{{ media.alt | default: product.title | escape }}"
                    width="{{ media.width | default: 1400 }}" height="{{ media.height | default: 1400 }}"
                    {% unless forloop.first %}loading="lazy"{% endunless %}>
              {%- endcase -%}
            </div>
          {%- endfor -%}
          {%- if ph_pad > 0 -%}
            {%- for i in (1..ph_pad) -%}
              {%- assign ph_i = media_n | plus: forloop.index0 | modulo: 5 -%}
              <div class="gb-gal__slide" data-media-id="ph{{ i }}">
                <div class="gb-ph gb-gal__ph"><span>{{ ph_captions[ph_i] }}<small>Photo coming</small></span></div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <button type="button" class="gb-gal__arrow gb-gal__arrow--prev" data-gb-prev aria-label="Previous photo">&#8249;</button>
        <button type="button" class="gb-gal__arrow gb-gal__arrow--next" data-gb-next aria-label="Next photo">&#8250;</button>
      </div>

      <div class="gb-gal__thumbs" role="tablist" aria-label="Choose a photo">
        {%- for media in product.media -%}
          <button type="button" class="gb-gal__thumb" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-media-id="{{ media.id }}" aria-label="{{ media.alt | default: product.title | escape }}">
            <img src="{{ media.preview_image | image_url: width: 160 }}" alt="" width="160" height="160" loading="lazy">
          </button>
        {%- endfor -%}
        {%- if ph_pad > 0 -%}
          {%- for i in (1..ph_pad) -%}
            {%- assign n = media_n | plus: forloop.index -%}
            <button type="button" class="gb-gal__thumb gb-gal__thumb--ph" role="tab" aria-selected="{% if n == 1 %}true{% else %}false{% endif %}" data-media-id="ph{{ i }}" aria-label="Photo {{ n }} coming">{{ n }}</button>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ============ BUY COLUMN ============ {%- endcomment -%}
    <div class="gb-buy" id="gb-buy">
      <p class="gb-eyebrow">{{ eyebrow }}</p>
      <h1 class="gb-h1">{{ product.title }}</h1>

      <ul class="gb-buy__bullets">
        {%- for i in (1..3) -%}
          {%- assign key = 'bullet_' | append: i -%}
          {%- assign line = s[key] -%}
          {%- if line != blank -%}
            <li class="gb-check">{{ line | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- form 'product', product, id: 'gb-form', class: 'gb-form' -%}
        <input type="hidden" name="id" value="{{ selected.id }}" data-gb-variant-id>

        {%- if colors.size > 0 -%}
          <div class="gb-field">
            <p class="gb-field__label">Colour: <b data-gb-color-name>{{ sel_color }}</b></p>
            <div class="gb-swatches" role="group" aria-label="Colour">
              {%- for c in colors -%}
                {%- assign cl = c | downcase -%}
                {%- assign hex = '#B9B1A2' -%}
                {%- if cl contains 'blue' -%}{%- assign hex = '#1F3A6E' -%}
                {%- elsif cl contains 'brown' -%}{%- assign hex = '#6B4F35' -%}
                {%- elsif cl contains 'green' -%}{%- assign hex = '#4F8A2E' -%}
                {%- elsif cl contains 'black' -%}{%- assign hex = '#2B2419' -%}
                {%- endif -%}
                <button type="button" class="gb-swatch" data-gb-color="{{ c | escape }}" aria-pressed="{% if c == sel_color %}true{% else %}false{% endif %}">
                  <span class="gb-swatch__chip" style="background:{{ hex }}" aria-hidden="true"><span class="gb-swatch__tick"></span></span>
                  <span class="gb-swatch__name">{{ c }}</span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="gb-field">
          <p class="gb-field__label">{{ s.pick_label | default: 'Pick your bundle' }}</p>
          <div class="gb-packs" role="radiogroup" aria-label="{{ s.pick_label | default: 'Pick your bundle' | escape }}">
            {%- for pack in packs -%}
              {%- liquid
                assign pv = blank
                for v in product.variants
                  if v.options[pack_idx] == pack
                    if colors.size == 0 or v.options[color_idx] == sel_color
                      assign pv = v
                      break
                    endif
                  endif
                endfor
                assign n = pack | split: ' ' | first | plus: 0
                if n < 1 or pack contains '+'
                  assign n = 1
                endif
                assign has_set = false
                if pack contains 'Tool Set'
                  assign has_set = true
                endif
                assign save = 0
                if pv != blank and pv.compare_at_price > pv.price
                  assign save = pv.compare_at_price | minus: pv.price
                endif
                assign is_sel = false
                if pack == sel_pack
                  assign is_sel = true
                endif
                assign avail = false
                if pv != blank and pv.available
                  assign avail = true
                endif
                assign flag = ''
                if forloop.index == 2
                  assign flag = s.flag_2
                endif
              -%}
              <label class="gb-pack{% if is_sel %} is-selected{% endif %}{% unless avail %} is-soldout{% endunless %}" data-gb-pack="{{ pack | escape }}" data-units="{{ n }}" data-variant-id="{{ pv.id }}">
                <input type="radio" name="gb-pack" value="{{ pack | escape }}" {% if is_sel %}checked{% endif %} class="gb-pack__radio">
                {%- if flag != blank -%}<span class="gb-pack__flag">{{ flag }}</span>{%- endif -%}
                <span class="gb-pack__head">
                  <span class="gb-pack__mark" aria-hidden="true"></span>
                  <span class="gb-pack__body">
                    <span class="gb-pack__name">{{ pack }}</span>
                    <span class="gb-pack__each" data-gb-each>{% if n > 1 and pv != blank %}{{ pv.price | divided_by: n | money }} each{% endif %}</span>
                  </span>
                  <span class="gb-pack__price">
                    <span class="gb-pack__now" data-gb-now>{% if pv != blank %}{{ pv.price | money }}{% endif %}</span>
                    <s class="gb-pack__was" data-gb-was {% if save <= 0 %}hidden{% endif %}>{% if save > 0 %}{{ pv.compare_at_price | money }}{% endif %}</s>
                    <span class="gb-pill gb-pack__save" data-gb-save {% if save <= 0 %}hidden{% endif %}>{% if save > 0 %}Save {{ save | money }}{% endif %}</span>
                    <span class="gb-pack__so" data-gb-so {% if avail %}hidden{% endif %}>Sold out</span>
                  </span>
                </span>
                {%- if has_set -%}
                  <span class="gb-pack__extra">
                    {%- if tool_set.featured_image -%}<img src="{{ tool_set.featured_image | image_url: width: 160 }}" alt="{{ tool_set.title | escape }}" width="72" height="72" loading="lazy">{%- else -%}<span class="gb-pack__extra-ph" aria-hidden="true"></span>{%- endif -%}
                    <span class="gb-pack__extra-txt"><b>+ {{ tool_set.title | default: 'Garden Tool Set' }}</b> {{ s.set_blurb | default: 'A separate 10-piece set: folding stool, tool bag, six steel tools, claw gloves and a sprayer.' }}</span>
                  </span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        </div>

        <button type="submit" class="gb-btn gb-btn--accent gb-buy__add" data-gb-add {% unless selected.available %}disabled{% endunless %}>
          <span data-gb-add-label>{% if selected.available %}Add to cart{% else %}Sold out{% endif %}</span>
          <span class="gb-buy__dot" aria-hidden="true">&middot;</span>
          <span data-gb-add-price>{{ selected.price | money }}</span>
        </button>

        <ul class="gb-trust">
          {%- for i in (1..3) -%}
            {%- assign key = 'trust_' | append: i -%}
            {%- assign line = s[key] -%}
            {%- if line != blank -%}
              <li>{{ line | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endform -%}
    </div>
  </div>

  <script type="application/json" data-gb-config>
    {
      "moneyFormat": {{ shop.money_format | json }},
      "packIdx": {{ pack_idx }},
      "colorIdx": {{ color_idx }},
      "selectedId": {{ selected.id | json }},
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id | json }},
            "price": {{ v.price | json }},
            "compare_at_price": {{ v.compare_at_price | json }},
            "available": {{ v.available | json }},
            "option1": {{ v.option1 | json }},
            "option2": {{ v.option2 | json }},
            "options": {{ v.options | json }},
            "featured_media_id": {{ v.featured_media.id | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>

{% stylesheet %}
.gb-product{padding:clamp(16px,3vw,40px) 0 clamp(40px,5vw,64px)}
.gb-product p{margin:0}
.gb-product .gb-product__grid{display:grid;gap:clamp(22px,4vw,56px)}
@media(min-width:1000px){.gb-product .gb-product__grid{grid-template-columns:minmax(0,1.1fr) minmax(400px,.9fr);align-items:start}}

/* gallery */
.gb-product .gb-gal{display:grid;gap:10px}
@media(min-width:1000px){.gb-product .gb-gal{position:sticky;top:84px}}
.gb-product .gb-gal__frame{position:relative;border-radius:var(--radius);overflow:hidden;background:var(--stone)}
.gb-product .gb-gal__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;aspect-ratio:1}
.gb-product .gb-gal__track::-webkit-scrollbar{display:none}
.gb-product .gb-gal__slide{position:relative;flex:0 0 100%;scroll-snap-align:start;aspect-ratio:1}
.gb-product .gb-gal__slide img,.gb-product .gb-gal__slide video,.gb-product .gb-gal__slide iframe,.gb-product .gb-gal__slide model-viewer{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:0}
.gb-product .gb-gal__ph{position:absolute;inset:0;font-size:16px}
.gb-product .gb-gal__arrow{position:absolute;top:50%;transform:translateY(-50%);width:48px;height:48px;border-radius:50%;border:0;background:rgba(255,255,255,.92);color:var(--ink);font-size:30px;line-height:1;cursor:pointer;box-shadow:0 2px 10px rgba(43,36,25,.18);display:grid;place-items:center;padding:0 0 3px}
.gb-product .gb-gal__arrow:hover{background:#fff}
.gb-product .gb-gal__arrow--prev{left:12px}.gb-product .gb-gal__arrow--next{right:12px}
.gb-product .gb-gal__thumbs{display:flex;gap:8px;flex-wrap:wrap}
.gb-product .gb-gal__thumb{flex:0 0 64px;width:64px;height:64px;padding:0;border-radius:8px;border:2px solid transparent;background:var(--stone);overflow:hidden;cursor:pointer;display:grid;place-items:center;font-weight:800;color:var(--bark);font-size:14px}
.gb-product .gb-gal__thumb img{width:100%;height:100%;object-fit:cover}
.gb-product .gb-gal__thumb[aria-selected="true"]{border-color:var(--accent)}
@media(max-width:999px){
  .gb-product .gb-gal__frame{margin-inline:calc(-1 * var(--pad));border-radius:0}
  .gb-product .gb-gal__thumbs{justify-content:center}
  .gb-product .gb-gal__thumb{flex-basis:52px;width:52px;height:52px}
}

/* buy column */
.gb-product .gb-buy{display:grid;gap:22px}
.gb-product .gb-buy__bullets{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.gb-product .gb-form{display:grid;gap:22px}
.gb-product .gb-field{display:grid;gap:10px}
.gb-product .gb-field__label{font-weight:800;font-size:15px;letter-spacing:.02em}
.gb-product .gb-field__label b{font-weight:600;color:var(--dim)}

.gb-product .gb-swatches{display:flex;gap:12px;flex-wrap:wrap}
.gb-product .gb-swatch{display:inline-flex;align-items:center;gap:12px;min-height:56px;padding:0 20px 0 12px;border-radius:999px;border:3px solid var(--stone-2);background:#fff;color:var(--ink);font-family:var(--font-h);font-weight:800;font-size:17px;cursor:pointer;transition:border-color .15s,box-shadow .15s}
.gb-product .gb-swatch__chip{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;box-shadow:inset 0 0 0 2px rgba(255,255,255,.45),0 1px 2px rgba(43,36,25,.35)}
.gb-product .gb-swatch__tick{width:18px;height:18px;background:no-repeat center/18px url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3.6' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.5l4.2 4.2L19 7'/></svg>");opacity:0}
.gb-product .gb-swatch[aria-pressed="true"]{border-color:var(--brown);box-shadow:0 2px 0 var(--brown)}
.gb-product .gb-swatch[aria-pressed="true"] .gb-swatch__tick{opacity:1}
.gb-product .gb-swatch:focus-visible{outline:3px solid var(--brown);outline-offset:3px}

/* ===== bundle cards: deep brown ground, yellow money ===== */
.gb-product .gb-packs{display:grid;gap:14px}
.gb-product .gb-pack{position:relative;display:grid;gap:12px;padding:20px 20px 18px;background:var(--brown-2);color:var(--brown-ink);border:3px solid rgba(246,238,226,.16);border-radius:16px;cursor:pointer;box-shadow:0 6px 18px rgba(43,36,25,.22);transition:border-color .15s,box-shadow .15s,transform .1s}
.gb-product .gb-pack::before{content:"";position:absolute;inset:0;border-radius:13px;background:rgba(251,247,238,.16);pointer-events:none;transition:opacity .15s}
.gb-product .gb-pack.is-selected::before{opacity:0}
.gb-product .gb-pack.is-selected{border-color:var(--yellow);box-shadow:0 0 0 6px rgba(255,199,44,.28),0 10px 26px rgba(43,36,25,.3)}
.gb-product .gb-pack:hover{border-color:rgba(255,199,44,.6)}
.gb-product .gb-pack > *{position:relative;z-index:1}

.gb-product .gb-pack__flag{position:absolute;z-index:2;top:-14px;left:18px;background:var(--yellow);color:var(--yellow-ink);font-family:var(--font-h);font-weight:800;font-size:13px;letter-spacing:.1em;text-transform:uppercase;padding:6px 14px;border-radius:8px;box-shadow:0 3px 0 var(--yellow-2)}

.gb-product .gb-pack__radio{position:absolute;opacity:0;width:1px;height:1px;margin:0}
.gb-product .gb-pack__radio:focus-visible ~ .gb-pack__head .gb-pack__mark{outline:3px solid var(--yellow);outline-offset:3px}
.gb-product .gb-pack__head{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;min-height:48px}
.gb-product .gb-pack__mark{width:28px;height:28px;border-radius:50%;border:3px solid rgba(246,238,226,.6);display:grid;place-items:center}
.gb-product .gb-pack.is-selected .gb-pack__mark{border-color:var(--yellow)}
.gb-product .gb-pack.is-selected .gb-pack__mark::after{content:"";width:14px;height:14px;border-radius:50%;background:var(--yellow)}
.gb-product .gb-pack__body{display:grid;gap:2px;min-width:0}
.gb-product .gb-pack__name{font-family:var(--font-h);font-weight:800;font-size:20px;line-height:1.2;color:var(--brown-ink)}
.gb-product .gb-pack__each{color:#D9CBB8;font-size:15px}
.gb-product .gb-pack__each:empty{display:none}

.gb-product .gb-pack__price{display:grid;justify-items:end;gap:4px;text-align:right}
.gb-product .gb-pack__now{font-family:var(--font-h);font-weight:800;font-size:30px;line-height:1;letter-spacing:-.01em;color:var(--yellow)}
.gb-product .gb-pack__was{color:#C9BAA6;font-size:15px;font-weight:600}
.gb-product .gb-pack__save{background:var(--yellow);color:var(--yellow-ink);font-size:13px;font-weight:800;letter-spacing:.04em;padding:5px 12px;border-radius:6px;transform:rotate(-2deg);box-shadow:0 2px 0 var(--yellow-2)}
.gb-product .gb-pack__so{font-family:var(--font-h);font-size:14px;font-weight:800;color:var(--brown-ink);text-transform:uppercase;letter-spacing:.08em}
.gb-product .gb-pack.is-soldout .gb-pack__now{text-decoration:line-through;color:#D9CBB8}
.gb-product .gb-pack.is-soldout{cursor:not-allowed;box-shadow:none}
.gb-product .gb-pack.is-soldout::before{opacity:1}

.gb-product .gb-pack__extra{display:flex;gap:12px;align-items:center;padding:12px;background:#3E2C1B;border:1px solid rgba(246,238,226,.14);border-radius:12px;font-size:15px;line-height:1.4;color:#E4D7C6}
.gb-product .gb-pack__extra img,.gb-product .gb-pack__extra-ph{flex:0 0 60px;width:60px;height:60px;border-radius:10px;object-fit:cover}
.gb-product .gb-pack__extra-ph{background:repeating-linear-gradient(135deg,#4A3623 0 8px,#3E2C1B 8px 16px);box-shadow:inset 0 0 0 2px var(--yellow);display:block}
.gb-product .gb-pack__extra b{display:block;font-family:var(--font-h);font-weight:800;color:var(--yellow);font-size:16px}

.gb-product .gb-trust{list-style:none;margin:0;padding:0;display:flex;gap:6px 18px;flex-wrap:wrap;color:var(--dim);font-size:15px;font-weight:600}
.gb-product .gb-trust li{display:flex;gap:8px;align-items:center}
.gb-product .gb-trust li::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--leaf);flex:0 0 8px}

@media(max-width:520px){
  .gb-product .gb-pack__head{grid-template-columns:auto 1fr;row-gap:10px}
  .gb-product .gb-pack__price{grid-column:1 / -1;justify-items:start;text-align:left}
}
@media(prefers-reduced-motion:reduce){
  .gb-product .gb-pack,.gb-product .gb-swatch,.gb-product .gb-pack::before,.gb-product .gb-buy__add{transition:none}
  .gb-product .gb-pack__save{transform:none}
}

.gb-product .gb-buy__add{width:100%;min-height:60px;font-family:var(--font-h);font-size:20px;font-weight:800;letter-spacing:.01em;box-shadow:0 4px 0 var(--accent-2)}
.gb-product .gb-buy__add:focus-visible{outline:3px solid var(--brown);outline-offset:3px}
.gb-product .gb-buy__dot{opacity:.7}
{% endstylesheet %}

{% javascript %}
(function () {
  function formatMoney(cents, format) {
    if (typeof cents === 'string') cents = cents.replace('.', '');
    cents = parseInt(cents, 10) || 0;
    format = format || '${{amount}}';
    var re = /\{\{\s*(\w+)\s*\}\}/;
    var m = format.match(re);
    var key = m ? m[1] : 'amount';
    function num(n, precision, thousands, decimal) {
      var s = (Math.abs(n) / 100).toFixed(precision).split('.');
      s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, thousands);
      return (n < 0 ? '-' : '') + (s[1] ? s[0] + decimal + s[1] : s[0]);
    }
    var v;
    switch (key) {
      case 'amount_no_decimals': v = num(cents, 0, ',', '.'); break;
      case 'amount_with_comma_separator': v = num(cents, 2, '.', ','); break;
      case 'amount_no_decimals_with_comma_separator': v = num(cents, 0, '.', ','); break;
      case 'amount_with_apostrophe_separator': v = num(cents, 2, "'", '.'); break;
      case 'amount_no_decimals_with_space_separator': v = num(cents, 0, ' ', '.'); break;
      case 'amount_with_space_separator': v = num(cents, 2, ' ', ','); break;
      case 'amount_with_period_and_space_separator': v = num(cents, 2, ' ', '.'); break;
      default: v = num(cents, 2, ',', '.');
    }
    return format.replace(re, v);
  }

  function init(root) {
    if (root.dataset.gbReady) return;
    root.dataset.gbReady = '1';
    var cfgEl = root.querySelector('[data-gb-config]');
    var cfg = {};
    try { cfg = JSON.parse(cfgEl.textContent); } catch (e) { cfg = { variants: [] }; }
    var money = function (c) { return formatMoney(c, cfg.moneyFormat); };
    var $ = function (s) { return root.querySelector(s); };
    var $$ = function (s) { return Array.prototype.slice.call(root.querySelectorAll(s)); };
    var pIdx = cfg.packIdx || 0, cIdx = cfg.colorIdx == null ? 1 : cfg.colorIdx;
    var variants = cfg.variants || [];

    var idInput = $('[data-gb-variant-id]');
    var addBtn = $('[data-gb-add]');
    var addLabel = $('[data-gb-add-label]');
    var addPrice = $('[data-gb-add-price]');
    var swatches = $$('[data-gb-color]');
    var packs = $$('[data-gb-pack]');
    var colorName = $('[data-gb-color-name]');

    var state = { color: null, pack: null };
    var sel = variants.filter(function (v) { return String(v.id) === String(cfg.selectedId); })[0] || variants[0];
    if (sel) { state.color = sel.options[cIdx]; state.pack = sel.options[pIdx]; }

    function find(color, pack) {
      return variants.filter(function (v) {
        return v.options[pIdx] === pack && (color == null || v.options[cIdx] === color);
      })[0] || null;
    }

    function renderPacks() {
      packs.forEach(function (card) {
        var pack = card.dataset.gbPack;
        var units = parseInt(card.dataset.units, 10) || 1;
        var v = find(state.color, pack);
        var now = card.querySelector('[data-gb-now]');
        var was = card.querySelector('[data-gb-was]');
        var save = card.querySelector('[data-gb-save]');
        var each = card.querySelector('[data-gb-each]');
        var so = card.querySelector('[data-gb-so]');
        card.dataset.variantId = v ? v.id : '';
        var avail = !!(v && v.available);
        card.classList.toggle('is-soldout', !avail);
        if (so) so.hidden = avail;
        if (!v) { if (now) now.textContent = ''; if (was) was.hidden = true; if (save) save.hidden = true; if (each) each.textContent = ''; return; }
        if (now) now.textContent = money(v.price);
        var saved = v.compare_at_price && v.compare_at_price > v.price ? v.compare_at_price - v.price : 0;
        if (was) { was.hidden = !saved; was.textContent = saved ? money(v.compare_at_price) : ''; }
        if (save) { save.hidden = !saved; save.textContent = saved ? 'Save ' + money(saved) : ''; }
        if (each) each.textContent = units > 1 ? money(Math.round(v.price / units)) + ' each' : '';
      });
    }

    function renderSelection() {
      var v = find(state.color, state.pack);
      packs.forEach(function (card) {
        var on = card.dataset.gbPack === state.pack;
        card.classList.toggle('is-selected', on);
        var r = card.querySelector('input[type="radio"]');
        if (r) r.checked = on;
      });
      swatches.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.gbColor === state.color)); });
      if (colorName && state.color) colorName.textContent = state.color;
      if (!v) { if (addBtn) addBtn.disabled = true; if (addLabel) addLabel.textContent = 'Unavailable'; if (addPrice) addPrice.textContent = ''; return; }
      if (idInput) idInput.value = v.id;
      if (addBtn) addBtn.disabled = !v.available;
      if (addLabel) addLabel.textContent = v.available ? 'Add to cart' : 'Sold out';
      if (addPrice) addPrice.textContent = money(v.price);
      try {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', v.id);
        window.history.replaceState({}, '', url.toString());
      } catch (e) {}
      if (v.featured_media_id) goToMedia(v.featured_media_id);
    }

    function pickPack(pack) { state.pack = pack; renderSelection(); }
    function pickColor(color) {
      state.color = color;
      renderPacks();
      var v = find(color, state.pack);
      if (!v || !v.available) {
        var alt = variants.filter(function (x) { return x.options[cIdx] === color && x.available; })[0];
        if (alt) state.pack = alt.options[pIdx];
      }
      renderSelection();
    }

    swatches.forEach(function (b) { b.addEventListener('click', function () { pickColor(b.dataset.gbColor); }); });
    packs.forEach(function (card) {
      var r = card.querySelector('input[type="radio"]');
      if (r) r.addEventListener('change', function () { if (r.checked) pickPack(card.dataset.gbPack); });
      card.addEventListener('click', function () { pickPack(card.dataset.gbPack); });
    });

    /* gallery */
    var track = $('[data-gb-track]');
    var slides = $$('.gb-gal__slide');
    var thumbs = $$('.gb-gal__thumb');
    function goTo(i) {
      if (!track || !slides.length) return;
      i = (i + slides.length) % slides.length;
      track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' });
      thumbs.forEach(function (t, k) { t.setAttribute('aria-selected', String(k === i)); });
    }
    function current() { return track ? Math.round(track.scrollLeft / Math.max(1, track.clientWidth)) : 0; }
    function goToMedia(id) {
      var idx = -1;
      slides.forEach(function (sl, k) { if (sl.dataset.mediaId === String(id)) idx = k; });
      if (idx > -1) goTo(idx);
    }
    var prev = $('[data-gb-prev]'), next = $('[data-gb-next]');
    if (prev) prev.addEventListener('click', function () { goTo(current() - 1); });
    if (next) next.addEventListener('click', function () { goTo(current() + 1); });
    thumbs.forEach(function (t) { t.addEventListener('click', function () { goToMedia(t.dataset.mediaId); }); });
    if (track) {
      var syncing;
      track.addEventListener('scroll', function () {
        clearTimeout(syncing);
        syncing = setTimeout(function () {
          var i = current();
          thumbs.forEach(function (t, k) { t.setAttribute('aria-selected', String(k === i)); });
        }, 80);
      });
      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current() - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current() + 1); }
      });
      track.setAttribute('tabindex', '0');
    }

    renderPacks();
    renderSelection();
  }

  function boot() { Array.prototype.forEach.call(document.querySelectorAll('[data-gb-product]'), init); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  document.addEventListener('shopify:section:load', boot);
})();
{% endjavascript %}

