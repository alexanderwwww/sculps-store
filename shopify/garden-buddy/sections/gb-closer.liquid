{%- comment -%}
  GARDEN BUDDY — the closing band.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'
-%}

<div class="gb gb-pb">

  {%- if s.closer_heading != blank or s.closer_button != blank -%}
  <section class="gb-sec gb-sec--night gb-closer">
    <div class="gb-wrap gb-closer__in">
      <div>
        <h2 class="gb-h2">{{ s.closer_heading }}</h2>
        {%- if s.closer_text != blank -%}<p class="gb-lede">{{ s.closer_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>
      {%- if s.closer_button != blank -%}
        {%- if s.closer_url != blank -%}
          <a class="gb-btn gb-btn--lime" href="{{ s.closer_url }}">{{ s.closer_button }}</a>
        {%- else -%}
          <a class="gb-btn gb-btn--lime" href="#gb-buy" data-gb-scroll>{{ s.closer_button }}</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-sec{padding:clamp(56px,7vw,100px) 0}
.gb-pb .gb-head{display:grid;gap:10px;margin-bottom:clamp(34px,4.5vw,60px)}
.gb-pb .gb-head--tight{margin-bottom:0}
.gb-pb .gb-head--center{justify-items:center;text-align:center}
.gb-pb .gb-head--center .gb-lede{max-width:52ch;text-align:center}
.gb-pb .gb-h2{font-family:var(--font-h);font-weight:700;text-transform:uppercase;
  font-size:clamp(30px,4.4vw,52px);line-height:1.06;letter-spacing:-.01em;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h2{color:var(--brown-ink)}
.gb-pb .gb-sec--night .gb-h2{color:var(--night-ink)}
.gb-pb .gb-lede{font-size:clamp(18px,1.8vw,21px);line-height:1.6;max-width:46ch;color:var(--dim);margin-top:4px}
.gb-pb .gb-eyebrow{font-size:14px;letter-spacing:.16em;margin-bottom:4px}
.gb-pb .gb-h3{font-family:var(--font-h);font-size:clamp(21px,2.1vw,26px);line-height:1.18;margin:0 0 8px;font-weight:800;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h3,.gb-pb .gb-sec--night .gb-h3{color:inherit}
.gb-pb .gb-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.gb-pb .gb-table-wrap{overflow-x:auto}
.gb-pb a:focus-visible,.gb-pb summary:focus-visible,.gb-pb button:focus-visible{outline:3px solid var(--leaf);outline-offset:3px;border-radius:6px}
.gb-pb .gb-sec--night a:focus-visible,.gb-pb .gb-sec--brown a:focus-visible{outline-color:var(--lime)}
.gb-pb svg{width:100%;height:100%;display:block}
.gb-pb .gb-btn{min-height:60px;font-size:19px;padding:0 34px}

/* ——— closer ——— */
.gb-pb .gb-closer__in{display:grid;gap:28px;align-items:center}
@media(min-width:820px){.gb-pb .gb-closer__in{grid-template-columns:1fr auto}}
{% endstylesheet %}

{% javascript %}
  (function () {
    if (document.documentElement.hasAttribute('data-gb-scroll-init')) return;
    document.documentElement.setAttribute('data-gb-scroll-init', '');
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-gb-scroll]');
      if (!a) return;
      var t = document.querySelector(a.getAttribute('href'));
      if (!t) return;
      e.preventDefault();
      t.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }());
{% endjavascript %}

{% schema %}
{
  "name": "GB Closer",
  "tag": "section",
  "class": "gb-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Anything written as [ LIKE THIS ] shows as a placeholder until you replace it. Nothing here is invented."
    },
    {
      "type": "text",
      "id": "closer_heading",
      "label": "Heading",
      "default": "Your knees will notice by Saturday."
    },
    {
      "type": "textarea",
      "id": "closer_text",
      "label": "Text",
      "default": "Free US shipping. 30 days to send it back if it is not for you."
    },
    {
      "type": "text",
      "id": "closer_button",
      "label": "Button",
      "default": "Pick your bundle"
    },
    {
      "type": "url",
      "id": "closer_url",
      "label": "Button link",
      "info": "Leave empty to scroll to the buy box."
    }
  ],
  "presets": [
    {
      "name": "GB Closer"
    }
  ]
}
{% endschema %}
