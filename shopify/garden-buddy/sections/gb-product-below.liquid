{%- comment -%}
  GARDEN BUDDY — everything under the buy box. One section.
  Bands: trust strip > benefits > reviews > the set > product features > better/FAQ > who > box + specs > closer.
  Every empty image slot renders a .gb-ph tile. Anything written as [ LIKE THIS ] renders as a fill span.
  Reviews: nothing is invented. No review blocks and no defaults anywhere. Empty = honest empty state.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'

  assign step_n = 0
  assign benefit_n = 0
  assign feature_n = 0
  assign compare_n = 0
  assign who_n = 0
  assign box_n = 0
  assign review_n = 0
  assign faq_n = 0
  assign spec_n = 0
  assign tool_n = 0
  for block in section.blocks
    case block.type
      when 'step'
        assign step_n = step_n | plus: 1
      when 'benefit'
        assign benefit_n = benefit_n | plus: 1
      when 'feature'
        assign feature_n = feature_n | plus: 1
      when 'compare'
        assign compare_n = compare_n | plus: 1
      when 'who'
        assign who_n = who_n | plus: 1
      when 'box_item'
        assign box_n = box_n | plus: 1
      when 'review'
        assign review_n = review_n | plus: 1
      when 'faq'
        assign faq_n = faq_n | plus: 1
      when 'spec'
        assign spec_n = spec_n | plus: 1
      when 'tool'
        assign tool_n = tool_n | plus: 1
    endcase
  endfor
-%}

<div class="gb gb-pb">

  {%- comment -%} 1. Trust strip {%- endcomment -%}
  <section class="gb-sec gb-sec--sand gb-trust">
    <div class="gb-wrap">
      <ul class="gb-trust__list">
        {%- for i in (1..4) -%}
          {%- assign tk = 'strip_' | append: i | append: '_title' -%}
          {%- assign xk = 'strip_' | append: i | append: '_text' -%}
          {%- if s[tk] != blank -%}
            <li class="gb-trust__item">
              <span class="gb-trust__ico" aria-hidden="true">
                {%- case i -%}
                  {%- when 1 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 6.5h11v9h-11z"/><path d="M12.5 10h4l3 3v2.5h-7z"/><circle cx="6" cy="17.5" r="2"/><circle cx="16.5" cy="17.5" r="2"/></svg>
                  {%- when 2 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l7.5 3v5.7c0 4.6-3.1 8.4-7.5 10.3C7.6 19.6 4.5 15.8 4.5 11.2V5.5z"/><path d="M8.6 11.8l2.4 2.4 4.4-4.6"/></svg>
                  {%- when 3 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10.5" rx="2.2"/><path d="M8 10V7.2a4 4 0 0 1 8 0V10"/><path d="M12 14v2.6"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="2.5" y="13.5" width="4" height="6.5" rx="1.8"/><rect x="17.5" y="13.5" width="4" height="6.5" rx="1.8"/><path d="M19.5 20v.4a2.6 2.6 0 0 1-2.6 2.6H13"/></svg>
                {%- endcase -%}
              </span>
              <span class="gb-trust__txt">
                <b>{{ s[tk] | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</b>
                {%- if s[xk] != blank -%}<span>{{ s[xk] | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>{%- endif -%}
              </span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%} 2. Benefits — photo left, three items right {%- endcomment -%}
  {%- if benefit_n > 0 or s.ben_heading != blank -%}
  <section class="gb-sec gb-ben" id="benefits">
    <div class="gb-wrap">
      <div class="gb-head">
        {%- if s.ben_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.ben_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.ben_heading }}</h2>
        {%- if s.ben_text != blank -%}<p class="gb-lede">{{ s.ben_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>
      <div class="gb-ben__in gb-rise">
        <div class="gb-ben__shot">
          {%- if s.ben_image != blank -%}
            <img src="{{ s.ben_image | image_url: width: 1200 }}" alt="{{ s.ben_image.alt | default: s.ben_heading | escape }}" width="{{ s.ben_image.width }}" height="{{ s.ben_image.height }}" loading="lazy" decoding="async">
          {%- else -%}
            <div class="gb-ph"><span>{{ s.ben_placeholder | default: 'Photo: the kneeler in use' }}<small>Wide shot, 4:3</small></span></div>
          {%- endif -%}
        </div>
        <ul class="gb-ben__list">
          {%- for block in section.blocks -%}
            {%- if block.type != 'benefit' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            <li class="gb-ben__item" {{ block.shopify_attributes }}>
              <span class="gb-ben__ico" aria-hidden="true">
                {%- case b.icon -%}
                  {%- when 'infinity' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8.6 12c-1.5 2.3-2.6 3.2-4.1 3.2A3.2 3.2 0 0 1 4.5 8.8C7 8.8 8.4 12 12 12s5-3.2 7.5-3.2a3.2 3.2 0 0 1 0 6.4c-1.5 0-2.6-.9-4.1-3.2"/></svg>
                  {%- when 'layers' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2l8.5 4.3-8.5 4.3L3.5 7.5z"/><path d="M3.5 12.2l8.5 4.3 8.5-4.3"/><path d="M3.5 16.6l8.5 4.2 8.5-4.2"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l7.5 3v5.7c0 4.6-3.1 8.4-7.5 10.3C7.6 19.6 4.5 15.8 4.5 11.2V5.5z"/><path d="M8.6 11.8l2.4 2.4 4.4-4.6"/></svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.4l-7-6.6a4.4 4.4 0 0 1 7-5.2 4.4 4.4 0 0 1 7 5.2z"/></svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M12 7.2V12l3.2 2"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-5 2-9 7-11-1 6-3.4 9.3-7 11z"/><path d="M12 21C7.5 20 4 16 4 10.5 4 6.5 6.5 4 9.5 4c2.6 0 4.3 1.8 4.9 4"/></svg>
                {%- endcase -%}
              </span>
              <h3 class="gb-h3">{{ b.title | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</h3>
              <p>{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 3. Reviews. Real blocks only. Otherwise the honest empty state. {%- endcomment -%}
  <section class="gb-sec gb-sec--brown gb-rev" id="reviews">
    <div class="gb-wrap">
      <div class="gb-head gb-head--center">
        {%- if s.rev_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.rev_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.rev_heading }}</h2>
        {%- if s.rev_sub != blank -%}<p class="gb-lede">{{ s.rev_sub | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>

      {%- if review_n > 0 -%}
        <ul class="gb-rev__row">
          {%- for block in section.blocks -%}
            {%- if block.type != 'review' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            <li class="gb-fb" {{ block.shopify_attributes }}>
              <div class="gb-fb__head">
                <span class="gb-fb__av">
                  {%- if b.avatar != blank -%}
                    <img src="{{ b.avatar | image_url: width: 128 }}" alt="{{ b.avatar.alt | default: b.name | escape }}" width="48" height="48" loading="lazy">
                  {%- elsif b.name != blank -%}
                    <span aria-hidden="true">{{ b.name | strip | slice: 0 | upcase }}</span>
                  {%- else -%}
                    <span aria-hidden="true">&nbsp;</span>
                  {%- endif -%}
                </span>
                <span class="gb-fb__who">
                  {%- if b.name != blank -%}<b>{{ b.name | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</b>{%- endif -%}
                  {%- if b.ago != blank -%}<small>{{ b.ago | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</small>{%- endif -%}
                </span>
                <span class="gb-fb__fb" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.07A12 12 0 1 0 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.96h-1.51c-1.49 0-1.96.93-1.96 1.88v2.27h3.33l-.53 3.49h-2.8V24A12 12 0 0 0 24 12.07z"/></svg>
                </span>
              </div>

              {%- if b.text != blank -%}
                <p class="gb-fb__text">{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close | newline_to_br }}</p>
              {%- endif -%}

              {%- if b.photo != blank -%}
                <img class="gb-fb__photo" src="{{ b.photo | image_url: width: 800 }}" alt="{{ b.photo.alt | escape }}" width="{{ b.photo.width }}" height="{{ b.photo.height }}" loading="lazy">
              {%- endif -%}

              {%- if b.reactions != blank or b.comments != blank -%}
                <div class="gb-fb__meta">
                  {%- if b.reactions != blank -%}
                    <span class="gb-fb__react">
                      <span class="gb-fb__dots" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#1877F2"/><path d="M7.6 10.8h2v6.2h-2z" fill="#fff"/><path d="M10.2 17V11l2.6-4a1.2 1.2 0 0 1 2.2.9l-.6 2.5h2.6a1.2 1.2 0 0 1 1.2 1.5l-.9 4a1.5 1.5 0 0 1-1.5 1.1z" fill="#fff"/></svg>
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#F3425F"/><path d="M12 18.2l-4.7-4.5a3 3 0 0 1 4.7-3.5 3 3 0 0 1 4.7 3.5z" fill="#fff"/></svg>
                      </span>
                      <span>{{ b.reactions | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>
                    </span>
                  {%- endif -%}
                  {%- if b.comments != blank -%}
                    <span class="gb-fb__cmt">{{ b.comments | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="gb-fb__bar" aria-hidden="true">
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 10.5h-2a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2z"/><path d="M6.5 10.5l3.6-6.2a1.6 1.6 0 0 1 3 1.1l-.9 3.6h4.4a1.7 1.7 0 0 1 1.6 2.1l-1.3 5.6a2 2 0 0 1-2 1.6H6.5z"/></svg>Like</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 12.2c0 4-3.8 7.2-8.5 7.2a10 10 0 0 1-2.7-.4l-4.8 1.6 1.6-3.9a6.8 6.8 0 0 1-2.1-4.5C4 8.2 7.8 5 12 5s8.5 3.2 8.5 7.2z"/></svg>Comment</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5v6a1.5 1.5 0 0 0 1.5 1.5h13a1.5 1.5 0 0 0 1.5-1.5v-6"/><path d="M12 15.5V4"/><path d="M8 7.6L12 3.8l4 3.8"/></svg>Share</span>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="gb-rev__empty">
          <p><b>{{ s.rev_empty_title }}</b></p>
          <p>{{ s.rev_empty_text }}</p>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} 4. The tool set — bundle only {%- endcomment -%}
  {%- if s.set_heading != blank or tool_n > 0 -%}
  <section class="gb-sec gb-set" id="tool-set">
    <div class="gb-wrap">
      <div class="gb-head gb-head--center">
        {%- if s.set_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.set_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.set_heading }}</h2>
        {%- if s.set_text != blank -%}<p class="gb-lede">{{ s.set_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>

      {%- if tool_n > 0 -%}
        <div class="gb-set__card gb-rise">
          <ul class="gb-set__row">
            {%- for block in section.blocks -%}
              {%- if block.type != 'tool' -%}{%- continue -%}{%- endif -%}
              {%- assign b = block.settings -%}
              <li class="gb-tool" {{ block.shopify_attributes }}>
                <div class="gb-tool__shot">
                  {%- if b.image != blank -%}
                    <img src="{{ b.image | image_url: width: 500 }}" alt="{{ b.image.alt | default: b.name | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy" decoding="async">
                  {%- else -%}
                    <div class="gb-ph"><span>{{ b.placeholder | default: 'Photo' }}</span></div>
                  {%- endif -%}
                </div>
                <p class="gb-tool__chip">{{ b.name | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
                {%- if b.size != blank -%}<p class="gb-tool__size">{{ b.size | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="gb-set__foot">
        {%- if s.set_note != blank -%}<p class="gb-set__note">{{ s.set_note | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
        {%- if s.set_button != blank -%}<a class="gb-btn gb-btn--lime" href="#gb-buy" data-gb-scroll>{{ s.set_button }}</a>{%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 5. Product features — big photo with script caption, 2x3 grid of rows {%- endcomment -%}
  {%- if feature_n > 0 -%}
  <section class="gb-sec gb-pf" id="features">
    <div class="gb-wrap">
      <div class="gb-head">
        {%- if s.pf_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.pf_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.pf_heading }}</h2>
      </div>
      <div class="gb-pf__in">
        <figure class="gb-pf__media gb-rise">
          <div class="gb-pf__shot">
            {%- if s.pf_image != blank -%}
              <img src="{{ s.pf_image | image_url: width: 1200 }}" alt="{{ s.pf_image.alt | default: s.pf_heading | escape }}" width="{{ s.pf_image.width }}" height="{{ s.pf_image.height }}" loading="lazy" decoding="async">
            {%- else -%}
              <div class="gb-ph"><span>{{ s.pf_placeholder | default: 'Photo: the kneeler, three-quarter view' }}<small>Portrait, plain ground</small></span></div>
            {%- endif -%}
            <svg class="gb-pf__arrow" viewBox="0 0 120 90" fill="none" aria-hidden="true"><path d="M6 82C10 44 34 16 74 12" stroke="currentColor" stroke-width="5" stroke-linecap="round"/><path d="M58 6l18 6-13 13" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- if s.pf_caption != blank -%}
              <figcaption class="gb-pf__cap">
                <span class="gb-script">{{ s.pf_caption | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>
                {%- if s.pf_caption_sub != blank -%}<small>{{ s.pf_caption_sub | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</small>{%- endif -%}
              </figcaption>
            {%- endif -%}
          </div>
        </figure>

        <ul class="gb-pf__grid gb-rise gb-rise--late">
          {%- for block in section.blocks -%}
            {%- if block.type != 'feature' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            <li class="gb-pf__item" {{ block.shopify_attributes }}>
              <span class="gb-pf__ico" aria-hidden="true">
                {%- case b.icon -%}
                  {%- when 'infinity' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8.6 12c-1.5 2.3-2.6 3.2-4.1 3.2A3.2 3.2 0 0 1 4.5 8.8C7 8.8 8.4 12 12 12s5-3.2 7.5-3.2a3.2 3.2 0 0 1 0 6.4c-1.5 0-2.6-.9-4.1-3.2"/></svg>
                  {%- when 'layers' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2l8.5 4.3-8.5 4.3L3.5 7.5z"/><path d="M3.5 12.2l8.5 4.3 8.5-4.3"/><path d="M3.5 16.6l8.5 4.2 8.5-4.2"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l7.5 3v5.7c0 4.6-3.1 8.4-7.5 10.3C7.6 19.6 4.5 15.8 4.5 11.2V5.5z"/><path d="M8.6 11.8l2.4 2.4 4.4-4.6"/></svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.4l-7-6.6a4.4 4.4 0 0 1 7-5.2 4.4 4.4 0 0 1 7 5.2z"/></svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M12 7.2V12l3.2 2"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-5 2-9 7-11-1 6-3.4 9.3-7 11z"/><path d="M12 21C7.5 20 4 16 4 10.5 4 6.5 6.5 4 9.5 4c2.6 0 4.3 1.8 4.9 4"/></svg>
                {%- endcase -%}
              </span>
              <div>
                <h3 class="gb-h3">{{ b.heading | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</h3>
                <p>{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 6. What makes it better — table left, FAQ right {%- endcomment -%}
  {%- if compare_n > 0 or faq_n > 0 -%}
  <section class="gb-sec gb-better" id="compare">
    <div class="gb-wrap">
      <div class="gb-head">
        {%- if s.cmp_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.cmp_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.cmp_heading }}</h2>
      </div>
      <div class="gb-better__in">
        {%- if compare_n > 0 -%}
        <div class="gb-table-wrap">
          <table class="gb-cmp">
            <thead>
              <tr>
                <th scope="col"><span class="gb-visually-hidden">Feature</span></th>
                <th scope="col" class="is-us">{{ s.cmp_col_1 }}</th>
                <th scope="col">{{ s.cmp_col_2 }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for block in section.blocks -%}
                {%- if block.type != 'compare' -%}{%- continue -%}{%- endif -%}
                {%- assign b = block.settings -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row">{{ b.label | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</th>
                  {%- for i in (1..2) -%}
                    {%- assign vk = 'v' | append: i -%}
                    {%- assign val = b[vk] | strip -%}
                    {%- assign vl = val | downcase -%}
                    <td{% if i == 1 %} class="is-us"{% endif %}>
                      {%- if vl == 'yes' -%}
                        <span class="gb-yes" role="img" aria-label="Yes"></span>
                      {%- elsif vl == 'no' -%}
                        <span class="gb-no" role="img" aria-label="No"></span>
                      {%- else -%}
                        {{ val | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        {%- endif -%}

        {%- if faq_n > 0 -%}
        <div class="gb-faq" id="faq">
          {%- if s.faq_heading != blank -%}<h3 class="gb-faq__h">{{ s.faq_heading }}</h3>{%- endif -%}
          <div class="gb-faq__list">
            {%- for block in section.blocks -%}
              {%- if block.type != 'faq' -%}{%- continue -%}{%- endif -%}
              {%- assign b = block.settings -%}
              <details class="gb-faq__item" {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ b.question | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>
                  <i aria-hidden="true"></i>
                </summary>
                <p>{{ b.answer | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
              </details>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 6b. Who it's for {%- endcomment -%}
  {%- if who_n > 0 -%}
  <section class="gb-sec gb-sec--sand" id="who">
    <div class="gb-wrap">
      <div class="gb-head">
        {%- if s.who_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.who_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.who_heading }}</h2>
      </div>
      <div class="gb-who">
        {%- for block in section.blocks -%}
          {%- if block.type != 'who' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          <div class="gb-card gb-who__card" {{ block.shopify_attributes }}>
            <h3 class="gb-h3">{{ b.heading | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</h3>
            <p>{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 6c. How you use it — kept for step blocks, hidden when there are none {%- endcomment -%}
  {%- if step_n > 0 -%}
  <section class="gb-sec" id="how">
    <div class="gb-wrap">
      <div class="gb-head">
        {%- if s.how_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.how_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.how_heading }}</h2>
      </div>
      <ol class="gb-steps">
        {%- assign k = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'step' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          {%- assign k = k | plus: 1 -%}
          <li class="gb-card gb-step" {{ block.shopify_attributes }}>
            <div class="gb-step__shot">
              {%- if b.image != blank -%}
                <img src="{{ b.image | image_url: width: 900 }}" alt="{{ b.image.alt | default: b.heading | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy">
              {%- else -%}
                <div class="gb-ph"><span>{{ b.placeholder | default: 'Add a photo' }}</span></div>
              {%- endif -%}
            </div>
            <div class="gb-step__body">
              <span class="gb-step__num">{{ k }}</span>
              <h3 class="gb-h3">{{ b.heading | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</h3>
              <p>{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 7. In the box + specs {%- endcomment -%}
  {%- if box_n > 0 or spec_n > 0 -%}
  <section class="gb-sec gb-sec--sand gb-detail" id="specs">
    <div class="gb-wrap gb-detail__in">
      {%- if box_n > 0 -%}
      <div class="gb-box" id="box">
        <div class="gb-head gb-head--tight">
          {%- if s.box_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.box_eyebrow }}</p>{%- endif -%}
          <h2 class="gb-h2">{{ s.box_heading }}</h2>
          {%- if s.box_text != blank -%}<p class="gb-lede">{{ s.box_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
        </div>
        <ul class="gb-box__list">
          {%- for block in section.blocks -%}
            {%- if block.type != 'box_item' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            <li class="gb-check" {{ block.shopify_attributes }}>
              <span>{{ b.name | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}{%- if b.note != blank -%}<small>{{ b.note | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</small>{%- endif -%}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
      {%- endif -%}

      {%- if spec_n > 0 -%}
      <div class="gb-specs">
        <div class="gb-head gb-head--tight">
          {%- if s.spec_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.spec_eyebrow }}</p>{%- endif -%}
          <h2 class="gb-h2">{{ s.spec_heading }}</h2>
        </div>
        <div class="gb-table-wrap">
          <table class="gb-spec">
            <tbody>
              {%- for block in section.blocks -%}
                {%- if block.type != 'spec' -%}{%- continue -%}{%- endif -%}
                {%- assign b = block.settings -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row">{{ b.label | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</th>
                  <td>{%- if b.value != blank -%}{{ b.value | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}{%- else -%}<span class="gb-fill">[ CONFIRM ]</span>{%- endif -%}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 8. Closer {%- endcomment -%}
  {%- if s.closer_heading != blank or s.closer_button != blank -%}
  <section class="gb-sec gb-sec--night gb-closer">
    <div class="gb-wrap gb-closer__in">
      <div>
        <h2 class="gb-h2">{{ s.closer_heading }}</h2>
        {%- if s.closer_text != blank -%}<p class="gb-lede">{{ s.closer_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>
      {%- if s.closer_button != blank -%}
        {%- if s.closer_url != blank -%}
          <a class="gb-btn gb-btn--lime" href="{{ s.closer_url }}">{{ s.closer_button }}</a>
        {%- else -%}
          <a class="gb-btn gb-btn--lime" href="#gb-buy" data-gb-scroll>{{ s.closer_button }}</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-head{display:grid;gap:6px;margin-bottom:clamp(26px,3.5vw,44px)}
.gb-pb .gb-head--tight{margin-bottom:18px}
.gb-pb .gb-head--center{justify-items:center;text-align:center}
.gb-pb .gb-head--center .gb-lede{max-width:60ch;text-align:center}
.gb-pb .gb-h3{font-family:var(--font-h);font-size:clamp(19px,1.8vw,22px);line-height:1.2;margin:0 0 6px;font-weight:800}
.gb-pb .gb-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.gb-pb .gb-table-wrap{overflow-x:auto}
.gb-pb a:focus-visible,.gb-pb summary:focus-visible,.gb-pb button:focus-visible{outline:3px solid var(--leaf);outline-offset:3px;border-radius:6px}
.gb-pb .gb-sec--night a:focus-visible,.gb-pb .gb-sec--brown a:focus-visible{outline-color:var(--lime)}
.gb-pb svg{width:100%;height:100%;display:block}

/* 1. trust strip */
.gb-pb .gb-trust{padding:clamp(20px,3vw,30px) 0}
.gb-pb .gb-trust__list{list-style:none;margin:0;padding:0;display:grid;gap:18px 26px;grid-template-columns:repeat(2,minmax(0,1fr))}
@media(min-width:900px){.gb-pb .gb-trust__list{grid-template-columns:repeat(4,minmax(0,1fr))}}
.gb-pb .gb-trust__item{display:flex;gap:12px;align-items:flex-start;min-height:48px}
.gb-pb .gb-trust__ico{flex:0 0 30px;width:30px;height:30px;color:var(--leaf);margin-top:1px}
.gb-pb .gb-trust__txt{display:grid;gap:1px}
.gb-pb .gb-trust__txt b{font-size:17px;font-weight:800;color:var(--ink)}
.gb-pb .gb-trust__txt span{color:var(--dim);font-size:15px;line-height:1.4}

/* 2. benefits */
.gb-pb .gb-ben__in{display:grid;gap:clamp(26px,4vw,56px);align-items:center}
@media(min-width:900px){.gb-pb .gb-ben__in{grid-template-columns:minmax(0,1.05fr) minmax(0,1fr)}}
.gb-pb .gb-ben__shot{border-radius:20px;overflow:hidden;background:var(--sand);aspect-ratio:4/3}
.gb-pb .gb-ben__shot img{width:100%;height:100%;object-fit:cover}
.gb-pb .gb-ben__shot .gb-ph{height:100%;border-radius:0}
.gb-pb .gb-ben__list{list-style:none;margin:0;padding:0;display:grid;gap:clamp(20px,3vw,30px)}
.gb-pb .gb-ben__ico{display:block;width:38px;height:38px;color:var(--leaf);margin-bottom:12px}
.gb-pb .gb-ben__item p{color:var(--dim);max-width:44ch}

/* 3. reviews — facebook-post cards */
.gb-pb .gb-rev__row{list-style:none;margin:0;padding:0 var(--pad);display:grid;gap:16px;
  grid-auto-flow:column;grid-auto-columns:min(84vw,320px);overflow-x:auto;scroll-snap-type:x mandatory;
  margin-inline:calc(var(--pad) * -1);padding-block:4px 14px}
.gb-pb .gb-rev__row > *{scroll-snap-align:start}
@media(min-width:1000px){
  .gb-pb .gb-rev__row{grid-auto-flow:row;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-columns:auto;
    overflow:visible;margin-inline:0;padding-inline:0}
}
.gb-pb .gb-fb{background:var(--paper);color:var(--ink);border-radius:16px;padding:16px 16px 8px;display:flex;flex-direction:column;gap:12px}
.gb-pb .gb-fb__head{display:grid;grid-template-columns:48px 1fr 22px;gap:10px;align-items:center}
.gb-pb .gb-fb__av{width:48px;height:48px;border-radius:50%;overflow:hidden;background:var(--sand);
  display:grid;place-items:center;font-family:var(--font-h);font-weight:800;font-size:20px;color:var(--dim)}
.gb-pb .gb-fb__av img{width:100%;height:100%;object-fit:cover}
.gb-pb .gb-fb__who{display:grid;gap:1px;min-width:0}
.gb-pb .gb-fb__who b{font-size:16.5px;font-weight:800}
.gb-pb .gb-fb__who small{font-size:13.5px;color:var(--dim)}
.gb-pb .gb-fb__fb{width:22px;height:22px}
.gb-pb .gb-fb__text{font-size:17px;line-height:1.5}
.gb-pb .gb-fb__photo{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:12px}
.gb-pb .gb-fb__meta{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:14.5px;color:var(--dim)}
.gb-pb .gb-fb__react{display:flex;align-items:center;gap:6px}
.gb-pb .gb-fb__dots{display:flex}
.gb-pb .gb-fb__dots svg{width:19px;height:19px;border-radius:50%;box-shadow:0 0 0 2px var(--paper)}
.gb-pb .gb-fb__dots svg + svg{margin-left:-6px}
.gb-pb .gb-fb__cmt{margin-left:auto}
.gb-pb .gb-fb__bar{margin-top:auto;display:grid;grid-template-columns:repeat(3,1fr);
  border-top:1px solid var(--rule);padding-top:6px}
.gb-pb .gb-fb__bar span{display:flex;align-items:center;justify-content:center;gap:6px;min-height:44px;
  color:var(--dim);font-size:14.5px;font-weight:700}
.gb-pb .gb-fb__bar svg{width:18px;height:18px;flex:0 0 18px}
.gb-pb .gb-rev__empty{max-width:62ch;margin:0 auto;text-align:center;display:grid;gap:8px;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:var(--radius);padding:26px 28px}
.gb-pb .gb-rev__empty b{font-size:19px;color:var(--lime)}
.gb-pb .gb-rev__empty p{color:rgba(255,255,255,.8)}

/* 4. the set */
.gb-pb .gb-set__card{background:var(--paper);border:1px solid var(--rule);border-radius:20px;
  padding:18px;box-shadow:0 10px 30px rgba(28,35,24,.06)}
.gb-pb .gb-set__row{list-style:none;margin:0;padding:0;display:grid;gap:14px;
  grid-auto-flow:column;grid-auto-columns:minmax(140px,1fr);overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px}
.gb-pb .gb-set__row > *{scroll-snap-align:start}
.gb-pb .gb-tool{display:grid;gap:8px;align-content:start;justify-items:center;text-align:center}
.gb-pb .gb-tool__shot{width:100%;aspect-ratio:1;border-radius:12px;overflow:hidden;background:var(--sand)}
.gb-pb .gb-tool__shot img{width:100%;height:100%;object-fit:cover}
.gb-pb .gb-tool__shot .gb-ph{height:100%;border-radius:0;font-size:12px;padding:8px}
.gb-pb .gb-tool__chip{background:var(--night);color:var(--night-ink);border-radius:999px;
  padding:7px 14px;font-size:14px;font-weight:800;line-height:1.2}
.gb-pb .gb-tool__size{font-size:13.5px;color:var(--dim)}
.gb-pb .gb-set__foot{display:grid;gap:18px;justify-items:center;text-align:center;margin-top:clamp(24px,3vw,36px)}
.gb-pb .gb-set__note{color:var(--dim);font-size:16px;max-width:58ch}

/* 5. product features */
.gb-pb .gb-pf__in{display:grid;gap:clamp(28px,4vw,60px);align-items:center}
@media(min-width:900px){.gb-pb .gb-pf__in{grid-template-columns:minmax(0,1fr) minmax(0,1.05fr)}}
.gb-pb .gb-pf__media{margin:0}
.gb-pb .gb-pf__shot{position:relative;border-radius:20px;overflow:hidden;background:var(--sand);aspect-ratio:4/5}
.gb-pb .gb-pf__shot > img{width:100%;height:100%;object-fit:cover}
.gb-pb .gb-pf__shot .gb-ph{height:100%;border-radius:0}
.gb-pb .gb-pf__arrow{position:absolute;right:14px;top:16px;width:clamp(74px,12vw,112px);height:auto;color:var(--lime)}
.gb-pb .gb-pf__cap{position:absolute;left:16px;bottom:16px;right:16px;
  background:rgba(15,42,24,.86);color:var(--night-ink);border-radius:14px;padding:12px 16px;display:grid;gap:2px}
.gb-pb .gb-pf__cap .gb-script{font-size:clamp(24px,3vw,32px);color:var(--lime)}
.gb-pb .gb-pf__cap small{font-size:14.5px;color:rgba(255,255,255,.82)}
.gb-pb .gb-pf__grid{list-style:none;margin:0;padding:0;display:grid;gap:clamp(18px,2.4vw,26px)}
@media(min-width:600px){.gb-pb .gb-pf__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.gb-pb .gb-pf__item{display:flex;gap:14px;align-items:flex-start}
.gb-pb .gb-pf__ico{flex:0 0 46px;width:46px;height:46px;border-radius:50%;padding:11px;
  background:var(--lime-soft);color:var(--leaf)}
.gb-pb .gb-pf__item p{color:var(--dim);font-size:16px;max-width:34ch}

/* 6. better — compare + faq */
.gb-pb .gb-better__in{display:grid;gap:clamp(26px,4vw,52px);align-items:start}
@media(min-width:960px){.gb-pb .gb-better__in{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
.gb-pb .gb-cmp{width:100%;min-width:340px;border-collapse:separate;border-spacing:0;background:var(--paper);
  border:1px solid var(--rule);border-radius:var(--radius);overflow:hidden}
.gb-pb .gb-cmp th,.gb-pb .gb-cmp td{padding:16px 16px;text-align:center;border-bottom:1px solid var(--rule);font-size:16px}
.gb-pb .gb-cmp tbody tr:last-child th,.gb-pb .gb-cmp tbody tr:last-child td{border-bottom:0}
.gb-pb .gb-cmp thead th{font-family:var(--font-h);font-size:15px;font-weight:800;color:var(--dim);background:var(--sand)}
.gb-pb .gb-cmp thead th.is-us{color:var(--lime-ink);background:var(--lime-soft)}
.gb-pb .gb-cmp tbody th{text-align:left;font-weight:700;font-size:16px}
.gb-pb .gb-cmp td.is-us{background:var(--lime-soft)}
.gb-pb .gb-yes,.gb-pb .gb-no{display:inline-block;width:26px;height:26px;border-radius:50%;vertical-align:middle}
.gb-pb .gb-yes{background:var(--leaf) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3.2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.5l4.2 4.2L19 7'/></svg>") center/15px no-repeat}
.gb-pb .gb-no{background:var(--sand-2) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235D6657' stroke-width='3' stroke-linecap='round'><path d='M7 7l10 10M17 7L7 17'/></svg>") center/13px no-repeat}
.gb-pb .gb-faq__h{font-family:var(--font-h);font-size:clamp(21px,2.2vw,26px);font-weight:800;margin:0 0 14px}
.gb-pb .gb-faq__list{display:grid;gap:10px}
.gb-pb .gb-faq__item{background:var(--paper);border:1px solid var(--rule);border-radius:var(--radius);padding:0 20px}
.gb-pb .gb-faq__item summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:16px;
  min-height:62px;padding:12px 0;font-weight:800;font-size:17.5px}
.gb-pb .gb-faq__item summary::-webkit-details-marker{display:none}
.gb-pb .gb-faq__item summary span{flex:1}
.gb-pb .gb-faq__item summary i{flex:0 0 30px;width:30px;height:30px;border-radius:50%;background:var(--lime-soft);
  position:relative;transition:transform .18s ease}
.gb-pb .gb-faq__item summary i::before,.gb-pb .gb-faq__item summary i::after{content:"";position:absolute;
  left:50%;top:50%;background:var(--lime-ink);border-radius:2px;transform:translate(-50%,-50%)}
.gb-pb .gb-faq__item summary i::before{width:14px;height:2.5px}
.gb-pb .gb-faq__item summary i::after{width:2.5px;height:14px}
.gb-pb .gb-faq__item[open] summary i{transform:rotate(45deg)}
.gb-pb .gb-faq__item p{padding:0 0 20px;color:var(--dim);max-width:60ch}
@media(prefers-reduced-motion:reduce){.gb-pb .gb-faq__item summary i{transition:none}}

/* 6b. who */
.gb-pb .gb-who{display:grid;gap:18px}
@media(min-width:800px){.gb-pb .gb-who{grid-template-columns:repeat(3,1fr)}}
.gb-pb .gb-who__card{padding:24px 24px 26px}
.gb-pb .gb-who__card p{color:var(--dim)}

/* 6c. steps */
.gb-pb .gb-steps{list-style:none;margin:0;padding:0;display:grid;gap:18px}
@media(min-width:800px){.gb-pb .gb-steps{grid-template-columns:repeat(3,1fr)}}
.gb-pb .gb-step{overflow:hidden}
.gb-pb .gb-step__shot{aspect-ratio:4/3;background:var(--sand)}
.gb-pb .gb-step__shot img{width:100%;height:100%;object-fit:cover}
.gb-pb .gb-step__shot .gb-ph{height:100%;border-radius:0}
.gb-pb .gb-step__body{padding:20px 22px 24px}
.gb-pb .gb-step__num{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%;
  background:var(--lime);color:var(--lime-ink);font-weight:800;margin-bottom:12px}
.gb-pb .gb-step__body p{color:var(--dim)}

/* 7. box + specs */
.gb-pb .gb-detail__in{display:grid;gap:clamp(26px,4vw,56px);align-items:start}
@media(min-width:900px){.gb-pb .gb-detail__in{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr)}}
.gb-pb .gb-box__list{list-style:none;margin:0;padding:0;display:grid;gap:14px}
.gb-pb .gb-box__list li{font-size:17.5px}
.gb-pb .gb-box__list small{display:block;font-weight:500;color:var(--dim);font-size:15px}
.gb-pb .gb-spec{width:100%;border-collapse:separate;border-spacing:0;background:var(--paper);
  border:1px solid var(--rule);border-radius:var(--radius);overflow:hidden}
.gb-pb .gb-spec th,.gb-pb .gb-spec td{padding:15px 20px;border-bottom:1px solid var(--rule);text-align:left;font-size:16px;vertical-align:top}
.gb-pb .gb-spec tr:last-child th,.gb-pb .gb-spec tr:last-child td{border-bottom:0}
.gb-pb .gb-spec th{width:38%;color:var(--dim);font-weight:700}

/* 8. closer */
.gb-pb .gb-closer .gb-h2{color:var(--night-ink)}
.gb-pb .gb-closer__in{display:grid;gap:22px;align-items:center}
@media(min-width:820px){.gb-pb .gb-closer__in{grid-template-columns:1fr auto}}

/* entrance. JS adds data-gb-anim, so with no JS everything is simply visible. */
.gb-pb[data-gb-anim] .gb-rise{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.3,1)}
.gb-pb[data-gb-anim] .gb-rise--late{transition-delay:.12s}
.gb-pb[data-gb-anim] .gb-rise.is-in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  .gb-pb[data-gb-anim] .gb-rise{opacity:1;transform:none;transition:none}
}
{% endstylesheet %}

<script>
  (function () {
    var roots = document.querySelectorAll('.gb-pb');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (roots.length && !reduce && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
      Array.prototype.forEach.call(roots, function (root) {
        root.setAttribute('data-gb-anim', '');
        Array.prototype.forEach.call(root.querySelectorAll('.gb-rise'), function (el) { io.observe(el); });
      });
    }
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-gb-scroll]');
      if (!a) return;
      var t = document.querySelector(a.getAttribute('href'));
      if (!t) return;
      e.preventDefault();
      t.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
