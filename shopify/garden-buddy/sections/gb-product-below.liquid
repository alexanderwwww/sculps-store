{%- comment -%}
  GARDEN BUDDY — everything under the buy box. One section, blocks in order:
  benefit strip (settings) > steps > features > compare > who > box > reviews > faq > specs > closer.
  Every empty image or video slot renders a .gb-ph tile with its placeholder text.
  Anything written as [ LIKE THIS ] renders as a highlighted fill span.
  Reviews: nothing is invented. No review blocks = honest empty state.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'

  assign step_n = 0
  assign feature_n = 0
  assign compare_n = 0
  assign who_n = 0
  assign box_n = 0
  assign review_n = 0
  assign faq_n = 0
  assign spec_n = 0
  for block in section.blocks
    case block.type
      when 'step'
        assign step_n = step_n | plus: 1
      when 'feature'
        assign feature_n = feature_n | plus: 1
      when 'compare'
        assign compare_n = compare_n | plus: 1
      when 'who'
        assign who_n = who_n | plus: 1
      when 'box_item'
        assign box_n = box_n | plus: 1
      when 'review'
        assign review_n = review_n | plus: 1
      when 'faq'
        assign faq_n = faq_n | plus: 1
      when 'spec'
        assign spec_n = spec_n | plus: 1
    endcase
  endfor
-%}

<div class="gb gb-pb">

  {%- comment -%} a. Benefit strip {%- endcomment -%}
  <section class="gb-sec gb-sec--stone gb-strip">
    <div class="gb-wrap">
      <ul class="gb-strip__list">
        {%- for i in (1..4) -%}
          {%- assign tk = 'strip_' | append: i | append: '_title' -%}
          {%- assign xk = 'strip_' | append: i | append: '_text' -%}
          {%- if s[tk] != blank -%}
            <li class="gb-strip__item">
              <b>{{ s[tk] | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</b>
              {%- if s[xk] != blank -%}<span>{{ s[xk] | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%} b. How you use it {%- endcomment -%}
  {%- if step_n > 0 -%}
  <section class="gb-sec" id="how">
    <div class="gb-wrap">
      <div class="gb-head">
        <p class="gb-eyebrow">{{ s.how_eyebrow }}</p>
        <h2 class="gb-h2">{{ s.how_heading }}</h2>
      </div>
      <ol class="gb-steps">
        {%- assign k = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'step' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          {%- assign k = k | plus: 1 -%}
          <li class="gb-step gb-card" {{ block.shopify_attributes }}>
            <div class="gb-slot gb-slot--tall">
              {%- if b.video != blank -%}
                {{ b.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'gb-slot__media' }}
              {%- elsif b.video_url != blank -%}
                {%- if b.video_url.type == 'youtube' -%}
                  <iframe class="gb-slot__media" src="https://www.youtube.com/embed/{{ b.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ b.video_url.id }}&controls=0&playsinline=1&rel=0" title="{{ b.heading | escape }}" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                {%- else -%}
                  <iframe class="gb-slot__media" src="https://player.vimeo.com/video/{{ b.video_url.id }}?autoplay=1&muted=1&loop=1&background=1" title="{{ b.heading | escape }}" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                {%- endif -%}
              {%- elsif b.image != blank -%}
                <img class="gb-slot__media" src="{{ b.image | image_url: width: 1000 }}" alt="{{ b.image.alt | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy">
              {%- else -%}
                <div class="gb-ph gb-slot__media"><span>{{ b.placeholder | default: 'Add a clip or photo' }}<small>Clip or photo</small></span></div>
              {%- endif -%}
            </div>
            <div class="gb-step__body">
              <span class="gb-step__num">{{ k }}</span>
              <h3 class="gb-h3">{{ b.heading }}</h3>
              <p>{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} c. Feature rows {%- endcomment -%}
  {%- if feature_n > 0 -%}
  <section class="gb-sec gb-sec--stone" id="features">
    <div class="gb-wrap gb-features">
      {%- assign k = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'feature' -%}{%- continue -%}{%- endif -%}
        {%- assign b = block.settings -%}
        {%- assign k = k | plus: 1 -%}
        {%- assign flip = k | modulo: 2 -%}
        <div class="gb-feature{% if flip == 0 %} gb-feature--flip{% endif %}" {{ block.shopify_attributes }}>
          <div class="gb-slot gb-slot--square">
            {%- if b.image != blank -%}
              <img class="gb-slot__media" src="{{ b.image | image_url: width: 1200 }}" alt="{{ b.image.alt | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy">
            {%- else -%}
              <div class="gb-ph gb-slot__media"><span>{{ b.placeholder | default: 'Add a photo' }}<small>Photo</small></span></div>
            {%- endif -%}
          </div>
          <div class="gb-feature__body">
            {%- if b.eyebrow != blank -%}<p class="gb-eyebrow">{{ b.eyebrow }}</p>{%- endif -%}
            <h2 class="gb-h2">{{ b.heading }}</h2>
            <p class="gb-lede">{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} d. Comparison table {%- endcomment -%}
  {%- if compare_n > 0 -%}
  <section class="gb-sec" id="compare">
    <div class="gb-wrap">
      <div class="gb-head">
        <p class="gb-eyebrow">{{ s.cmp_eyebrow }}</p>
        <h2 class="gb-h2">{{ s.cmp_heading }}</h2>
      </div>
      <div class="gb-table-wrap">
        <table class="gb-cmp">
          <thead>
            <tr>
              <th scope="col"><span class="gb-visually-hidden">Feature</span></th>
              <th scope="col" class="is-us">{{ s.cmp_col_1 }}</th>
              <th scope="col">{{ s.cmp_col_2 }}</th>
              <th scope="col">{{ s.cmp_col_3 }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type != 'compare' -%}{%- continue -%}{%- endif -%}
              {%- assign b = block.settings -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ b.label }}</th>
                {%- for i in (1..3) -%}
                  {%- assign vk = 'v' | append: i -%}
                  {%- assign val = b[vk] | strip -%}
                  {%- assign vl = val | downcase -%}
                  <td{% if i == 1 %} class="is-us"{% endif %}>
                    {%- if vl == 'yes' -%}
                      <span class="gb-yes" aria-label="Yes"></span>
                    {%- elsif vl == 'no' -%}
                      <span class="gb-no" aria-label="No"></span>
                    {%- else -%}
                      {{ val | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} e. Who it's for {%- endcomment -%}
  {%- if who_n > 0 -%}
  <section class="gb-sec gb-sec--stone" id="who">
    <div class="gb-wrap">
      <div class="gb-head">
        <p class="gb-eyebrow">{{ s.who_eyebrow }}</p>
        <h2 class="gb-h2">{{ s.who_heading }}</h2>
      </div>
      <div class="gb-who">
        {%- for block in section.blocks -%}
          {%- if block.type != 'who' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          <div class="gb-card gb-who__card" {{ block.shopify_attributes }}>
            <h3 class="gb-h3">{{ b.heading }}</h3>
            <p>{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} f. What's in the box {%- endcomment -%}
  {%- if box_n > 0 -%}
  <section class="gb-sec" id="box">
    <div class="gb-wrap gb-box">
      <div class="gb-head gb-head--tight">
        <p class="gb-eyebrow">{{ s.box_eyebrow }}</p>
        <h2 class="gb-h2">{{ s.box_heading }}</h2>
        {%- if s.box_text != blank -%}<p class="gb-lede">{{ s.box_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>
      <ul class="gb-box__list">
        {%- for block in section.blocks -%}
          {%- if block.type != 'box_item' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          <li class="gb-check" {{ block.shopify_attributes }}>
            <span>{{ b.name | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}{%- if b.note != blank -%}<small>{{ b.note | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</small>{%- endif -%}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} g. Reviews. Real blocks only. Otherwise the honest empty state. {%- endcomment -%}
  <section class="gb-sec gb-sec--stone" id="reviews">
    <div class="gb-wrap">
      <div class="gb-head">
        <p class="gb-eyebrow">{{ s.rev_eyebrow }}</p>
        <h2 class="gb-h2">{{ s.rev_heading }}</h2>
      </div>
      {%- if review_n > 0 -%}
        <div class="gb-rev">
          {%- for block in section.blocks -%}
            {%- if block.type != 'review' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            {%- assign stars = b.stars | plus: 0 -%}
            <article class="gb-card gb-rev__card" {{ block.shopify_attributes }}>
              {%- if b.photo != blank -%}
                <img class="gb-rev__photo" src="{{ b.photo | image_url: width: 800 }}" alt="{{ b.photo.alt | escape }}" width="{{ b.photo.width }}" height="{{ b.photo.height }}" loading="lazy">
              {%- endif -%}
              <div class="gb-rev__body">
                <span class="gb-rev__stars" role="img" aria-label="{{ stars }} out of 5 stars">
                  {%- for i in (1..5) -%}<i{% if i <= stars %} class="on"{% endif %}></i>{%- endfor -%}
                </span>
                <p class="gb-rev__text">{{ b.text }}</p>
                <p class="gb-rev__who"><b>{{ b.name }}</b>{%- if b.place != blank -%}<span>{{ b.place }}</span>{%- endif -%}</p>
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="gb-card gb-rev__empty">
          <p><b>{{ s.rev_empty_title }}</b></p>
          <p>{{ s.rev_empty_text }}</p>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} h. FAQ {%- endcomment -%}
  {%- if faq_n > 0 -%}
  <section class="gb-sec" id="faq">
    <div class="gb-wrap gb-faq">
      <div class="gb-head gb-head--tight">
        <p class="gb-eyebrow">{{ s.faq_eyebrow }}</p>
        <h2 class="gb-h2">{{ s.faq_heading }}</h2>
      </div>
      <div class="gb-faq__list">
        {%- for block in section.blocks -%}
          {%- if block.type != 'faq' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          <details class="gb-faq__item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
            <summary>{{ b.question }}</summary>
            <p>{{ b.answer | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} i. Specs {%- endcomment -%}
  {%- if spec_n > 0 -%}
  <section class="gb-sec gb-sec--stone" id="specs">
    <div class="gb-wrap gb-specs">
      <div class="gb-head gb-head--tight">
        <p class="gb-eyebrow">{{ s.spec_eyebrow }}</p>
        <h2 class="gb-h2">{{ s.spec_heading }}</h2>
      </div>
      <div class="gb-table-wrap">
        <table class="gb-spec">
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type != 'spec' -%}{%- continue -%}{%- endif -%}
              {%- assign b = block.settings -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ b.label }}</th>
                <td>{%- if b.value != blank -%}{{ b.value | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}{%- else -%}<span class="gb-fill">[ CONFIRM ]</span>{%- endif -%}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} j. Closer {%- endcomment -%}
  <section class="gb-sec gb-sec--tan gb-closer">
    <div class="gb-wrap gb-closer__inner">
      <div>
        <h2 class="gb-h2">{{ s.closer_heading }}</h2>
        {%- if s.closer_text != blank -%}<p class="gb-lede">{{ s.closer_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>
      {%- if s.closer_url != blank -%}<a class="gb-btn gb-btn--accent" href="{{ s.closer_url }}">{{ s.closer_button }}</a>{%- else -%}<a class="gb-btn gb-btn--accent" href="#gb-buy" data-gb-scroll>{{ s.closer_button }}</a>{%- endif -%}
    </div>
  </section>
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-head{display:grid;gap:4px;margin-bottom:clamp(26px,3.5vw,44px)}
.gb-pb .gb-head--tight{margin-bottom:0}
.gb-pb .gb-h3{font-size:clamp(20px,2vw,24px);line-height:1.15;margin:0 0 8px;font-weight:800}
.gb-pb .gb-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.gb-pb .gb-table-wrap{overflow-x:auto}

/* slots */
.gb-pb .gb-slot{position:relative;overflow:hidden;border-radius:var(--radius);background:var(--stone)}
.gb-pb .gb-slot--tall{aspect-ratio:4/5}
.gb-pb .gb-slot--square{aspect-ratio:1}
.gb-pb .gb-slot__media,.gb-pb .gb-slot video,.gb-pb .gb-slot iframe{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:0;display:block}
.gb-pb .gb-slot .gb-ph{border-radius:0}

/* a. strip */
.gb-pb .gb-strip{padding:clamp(22px,3vw,34px) 0}
.gb-pb .gb-strip__list{list-style:none;margin:0;padding:0;display:grid;gap:18px;grid-template-columns:repeat(2,1fr)}
@media(min-width:800px){.gb-pb .gb-strip__list{grid-template-columns:repeat(4,1fr)}}
.gb-pb .gb-strip__item{display:grid;gap:2px;padding-left:14px;border-left:3px solid var(--leaf)}
.gb-pb .gb-strip__item b{font-size:17px}
.gb-pb .gb-strip__item span{color:var(--dim);font-size:15px}

/* b. steps */
.gb-pb .gb-steps{list-style:none;margin:0;padding:0;display:grid;gap:18px}
@media(min-width:800px){.gb-pb .gb-steps{grid-template-columns:repeat(3,1fr)}}
.gb-pb .gb-step{overflow:hidden;display:grid}
.gb-pb .gb-step .gb-slot{border-radius:0}
.gb-pb .gb-step__body{padding:20px 22px 24px;position:relative}
.gb-pb .gb-step__num{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--accent);color:#fff;font-weight:800;margin-bottom:12px}
.gb-pb .gb-step__body p{color:var(--dim)}

/* c. features */
.gb-pb .gb-features{display:grid;gap:clamp(40px,6vw,80px)}
.gb-pb .gb-feature{display:grid;gap:clamp(20px,3vw,48px);align-items:center}
@media(min-width:900px){
  .gb-pb .gb-feature{grid-template-columns:1fr 1fr}
  .gb-pb .gb-feature--flip .gb-slot{order:2}
}
.gb-pb .gb-feature__body .gb-lede{max-width:48ch}

/* d. compare */
.gb-pb .gb-cmp{width:100%;min-width:560px;border-collapse:separate;border-spacing:0;background:#fff;border:1px solid var(--rule);border-radius:var(--radius);overflow:hidden}
.gb-pb .gb-cmp th,.gb-pb .gb-cmp td{padding:16px 18px;text-align:center;border-bottom:1px solid var(--rule);font-size:16px}
.gb-pb .gb-cmp tbody tr:last-child th,.gb-pb .gb-cmp tbody tr:last-child td{border-bottom:0}
.gb-pb .gb-cmp thead th{font-size:14px;letter-spacing:.04em;text-transform:uppercase;color:var(--dim);background:var(--stone)}
.gb-pb .gb-cmp thead th.is-us{color:var(--bark-2);background:var(--lettuce)}
.gb-pb .gb-cmp tbody th{text-align:left;font-weight:700}
.gb-pb .gb-cmp td.is-us{background:rgba(207,231,166,.35);font-weight:700}
.gb-pb .gb-yes,.gb-pb .gb-no{display:inline-block;width:26px;height:26px;border-radius:50%;vertical-align:middle}
.gb-pb .gb-yes{background:var(--leaf) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3.2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.5l4.2 4.2L19 7'/></svg>") center/15px no-repeat}
.gb-pb .gb-no{background:var(--stone-2) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236B6255' stroke-width='3' stroke-linecap='round'><path d='M7 12h10'/></svg>") center/14px no-repeat}

/* e. who */
.gb-pb .gb-who{display:grid;gap:18px}
@media(min-width:800px){.gb-pb .gb-who{grid-template-columns:repeat(3,1fr)}}
.gb-pb .gb-who__card{padding:26px 26px 28px}
.gb-pb .gb-who__card p{color:var(--dim)}

/* f. box */
.gb-pb .gb-box{display:grid;gap:clamp(20px,3vw,48px)}
@media(min-width:900px){.gb-pb .gb-box{grid-template-columns:.9fr 1.1fr;align-items:start}}
.gb-pb .gb-box__list{list-style:none;margin:0;padding:0;display:grid;gap:14px}
.gb-pb .gb-box__list li{font-size:18px}
.gb-pb .gb-box__list small{display:block;font-weight:500;color:var(--dim);font-size:15px}

/* g. reviews */
.gb-pb .gb-rev{display:grid;gap:18px}
@media(min-width:800px){.gb-pb .gb-rev{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}}
.gb-pb .gb-rev__card{overflow:hidden;display:grid}
.gb-pb .gb-rev__photo{width:100%;aspect-ratio:4/3;object-fit:cover}
.gb-pb .gb-rev__body{padding:20px 22px 24px;display:grid;gap:10px}
.gb-pb .gb-rev__stars i{display:inline-block;width:18px;height:18px;margin-right:2px;background:var(--stone-2);clip-path:polygon(50% 0,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}
.gb-pb .gb-rev__stars i.on{background:var(--accent)}
.gb-pb .gb-rev__who{color:var(--dim);font-size:15px}
.gb-pb .gb-rev__who span::before{content:" · "}
.gb-pb .gb-rev__empty{padding:28px 30px;display:grid;gap:6px;max-width:60ch;color:var(--dim)}
.gb-pb .gb-rev__empty b{color:var(--ink);font-size:19px}

/* h. faq */
.gb-pb .gb-faq{display:grid;gap:clamp(20px,3vw,48px)}
@media(min-width:900px){.gb-pb .gb-faq{grid-template-columns:.8fr 1.2fr;align-items:start}}
.gb-pb .gb-faq__list{display:grid;gap:10px}
.gb-pb .gb-faq__item{background:#fff;border:1px solid var(--rule);border-radius:var(--radius);padding:0 22px}
.gb-pb .gb-faq__item summary{cursor:pointer;list-style:none;padding:18px 34px 18px 0;font-weight:800;font-size:18px;position:relative}
.gb-pb .gb-faq__item summary::-webkit-details-marker{display:none}
.gb-pb .gb-faq__item summary::after{content:"+";position:absolute;right:0;top:50%;transform:translateY(-50%);width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--stone);color:var(--bark-2);font-weight:800}
.gb-pb .gb-faq__item[open] summary::after{content:"\2212"}
.gb-pb .gb-faq__item p{padding:0 0 20px;color:var(--dim);max-width:60ch}

/* i. specs */
.gb-pb .gb-specs{display:grid;gap:clamp(20px,3vw,48px)}
@media(min-width:900px){.gb-pb .gb-specs{grid-template-columns:.8fr 1.2fr;align-items:start}}
.gb-pb .gb-spec{width:100%;border-collapse:separate;border-spacing:0;background:#fff;border:1px solid var(--rule);border-radius:var(--radius);overflow:hidden}
.gb-pb .gb-spec th,.gb-pb .gb-spec td{padding:15px 20px;border-bottom:1px solid var(--rule);text-align:left;font-size:16px;vertical-align:top}
.gb-pb .gb-spec tr:last-child th,.gb-pb .gb-spec tr:last-child td{border-bottom:0}
.gb-pb .gb-spec th{width:38%;color:var(--dim);font-weight:700}

/* j. closer */
.gb-pb .gb-closer{border-top:0;color:var(--bark-2)}
.gb-pb .gb-closer .gb-h2{color:var(--bark-2)}
.gb-pb .gb-closer .gb-lede{color:var(--bark-2);opacity:.85}
.gb-pb .gb-closer__inner{display:grid;gap:22px;align-items:center}
@media(min-width:800px){.gb-pb .gb-closer__inner{grid-template-columns:1fr auto}}
{% endstylesheet %}

<script>
  (function () {
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-gb-scroll]');
      if (!a) return;
      var t = document.querySelector(a.getAttribute('href'));
