.gb-pb .gb-set__note{color:#C0AE99;font-size:16px;max-width:52ch}

/* entrance. JS adds data-gb-anim, so with no JS everything is simply visible. */
.gb-pb[data-gb-anim] .gb-rise{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.3,1)}
.gb-pb[data-gb-anim] .gb-rise--late{transition-delay:.12s}
.gb-pb[data-gb-anim] .gb-rise.is-in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  .gb-pb[data-gb-anim] .gb-rise{opacity:1;transform:none;transition:none}
}

/* d. compare */
.gb-pb .gb-cmp{width:100%;min-width:560px;border-collapse:separate;border-spacing:0;background:#fff;border:1px solid var(--rule);border-radius:var(--radius);overflow:hidden}
.gb-pb .gb-cmp th,.gb-pb .gb-cmp td{padding:16px 18px;text-align:center;border-bottom:1px solid var(--rule);font-size:16px}
.gb-pb .gb-cmp tbody tr:last-child th,.gb-pb .gb-cmp tbody tr:last-child td{border-bottom:0}
.gb-pb .gb-cmp thead th{font-size:14px;letter-spacing:.04em;text-transform:uppercase;color:var(--dim);background:var(--stone)}
.gb-pb .gb-cmp thead th.is-us{color:var(--bark-2);background:var(--lettuce)}
.gb-pb .gb-cmp tbody th{text-align:left;font-weight:700}
.gb-pb .gb-cmp td.is-us{background:rgba(207,231,166,.35);font-weight:700}
.gb-pb .gb-yes,.gb-pb .gb-no{display:inline-block;width:26px;height:26px;border-radius:50%;vertical-align:middle}
.gb-pb .gb-yes{background:var(--leaf) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3.2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.5l4.2 4.2L19 7'/></svg>") center/15px no-repeat}
.gb-pb .gb-no{background:var(--stone-2) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236B6255' stroke-width='3' stroke-linecap='round'><path d='M7 12h10'/></svg>") center/14px no-repeat}

/* e. who */
.gb-pb .gb-who{display:grid;gap:18px}
@media(min-width:800px){.gb-pb .gb-who{grid-template-columns:repeat(3,1fr)}}
.gb-pb .gb-who__card{padding:26px 26px 28px}
.gb-pb .gb-who__card p{color:var(--dim)}

/* f. box */
.gb-pb .gb-box{display:grid;gap:clamp(20px,3vw,48px)}
@media(min-width:900px){.gb-pb .gb-box{grid-template-columns:.9fr 1.1fr;align-items:start}}
.gb-pb .gb-box__list{list-style:none;margin:0;padding:0;display:grid;gap:14px}
.gb-pb .gb-box__list li{font-size:18px}
.gb-pb .gb-box__list small{display:block;font-weight:500;color:var(--dim);font-size:15px}

/* g. reviews */
.gb-pb .gb-rev{display:grid;gap:18px}
@media(min-width:800px){.gb-pb .gb-rev{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}}
.gb-pb .gb-rev__card{overflow:hidden;display:grid}
.gb-pb .gb-rev__photo{width:100%;aspect-ratio:4/3;object-fit:cover}
.gb-pb .gb-rev__body{padding:20px 22px 24px;display:grid;gap:10px}
.gb-pb .gb-rev__stars i{display:inline-block;width:18px;height:18px;margin-right:2px;background:var(--stone-2);clip-path:polygon(50% 0,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}
.gb-pb .gb-rev__stars i.on{background:var(--accent)}
.gb-pb .gb-rev__who{color:var(--dim);font-size:15px}
.gb-pb .gb-rev__who span::before{content:" · "}
.gb-pb .gb-rev__empty{padding:28px 30px;display:grid;gap:6px;max-width:60ch;color:var(--dim)}
.gb-pb .gb-rev__empty b{color:var(--ink);font-size:19px}

/* h. faq */
.gb-pb .gb-faq{display:grid;gap:clamp(20px,3vw,48px)}
@media(min-width:900px){.gb-pb .gb-faq{grid-template-columns:.8fr 1.2fr;align-items:start}}
.gb-pb .gb-faq__list{display:grid;gap:10px}
.gb-pb .gb-faq__item{background:#fff;border:1px solid var(--rule);border-radius:var(--radius);padding:0 22px}
.gb-pb .gb-faq__item summary{cursor:pointer;list-style:none;padding:18px 34px 18px 0;font-weight:800;font-size:18px;position:relative}
.gb-pb .gb-faq__item summary::-webkit-details-marker{display:none}
.gb-pb .gb-faq__item summary::after{content:"+";position:absolute;right:0;top:50%;transform:translateY(-50%);width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--stone);color:var(--bark-2);font-weight:800}
.gb-pb .gb-faq__item[open] summary::after{content:"\2212"}
.gb-pb .gb-faq__item p{padding:0 0 20px;color:var(--dim);max-width:60ch}

/* i. specs */
.gb-pb .gb-specs{display:grid;gap:clamp(20px,3vw,48px)}
@media(min-width:900px){.gb-pb .gb-specs{grid-template-columns:.8fr 1.2fr;align-items:start}}
.gb-pb .gb-spec{width:100%;border-collapse:separate;border-spacing:0;background:#fff;border:1px solid var(--rule);border-radius:var(--radius);overflow:hidden}
.gb-pb .gb-spec th,.gb-pb .gb-spec td{padding:15px 20px;border-bottom:1px solid var(--rule);text-align:left;font-size:16px;vertical-align:top}
.gb-pb .gb-spec tr:last-child th,.gb-pb .gb-spec tr:last-child td{border-bottom:0}
.gb-pb .gb-spec th{width:38%;color:var(--dim);font-weight:700}

/* j. closer */
.gb-pb .gb-closer{border-top:0;color:var(--bark-2)}
.gb-pb .gb-closer .gb-h2{color:var(--bark-2)}
.gb-pb .gb-closer .gb-lede{color:var(--bark-2);opacity:.85}
.gb-pb .gb-closer__inner{display:grid;gap:22px;align-items:center}
@media(min-width:800px){.gb-pb .gb-closer__inner{grid-template-columns:1fr auto}}
{% endstylesheet %}

<script>
  (function () {
    var roots = document.querySelectorAll('.gb-pb');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (roots.length && !reduce && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
      Array.prototype.forEach.call(roots, function (root) {
        root.setAttribute('data-gb-anim', '');
        Array.prototype.forEach.call(root.querySelectorAll('.gb-rise'), function (el) { io.observe(el); });
      });
    }
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-gb-scroll]');
      if (!a) return;
      var t = document.querySelector(a.getAttribute('href'));
      if (!t) return;
      e.preventDefault();
      t.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

