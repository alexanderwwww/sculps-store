.gb-pb .gb-sec--brown .gb-feat__h{color:var(--brown-ink)}
.gb-pb .gb-feat__body .gb-lede{max-width:46ch;margin:0;font-size:clamp(17px,1.5vw,19px)}
.gb-pb .gb-feat__pts{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:10px;width:100%;max-width:46ch}
.gb-pb .gb-feat__pt{display:block}
.gb-pb .gb-feat__pt .gb-check{min-height:48px;align-items:center;padding:11px 18px 11px 15px;border-radius:14px;
  background:#fff;border:1px solid var(--rule);box-shadow:0 2px 0 rgba(43,36,25,.05);font-size:16.5px;line-height:1.4}
