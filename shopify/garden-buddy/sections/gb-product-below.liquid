  .gb-pb .gb-feat__stamp{min-width:60px;height:60px;font-size:25px;top:-16px;left:-10px}
}

/* c2. the tool set — bundle only. Loudest band on the page. */
.gb-pb .gb-set{background:var(--brown-2);color:var(--brown-ink);border-top:1px solid rgba(255,255,255,.12)}
.gb-pb .gb-set .gb-lede{color:#D8CBBA}
.gb-pb .gb-set__top{display:grid;gap:clamp(26px,4vw,56px);align-items:center}
@media(min-width:860px){.gb-pb .gb-set__top{grid-template-columns:minmax(0,1fr) minmax(0,.9fr)}}
.gb-pb .gb-set__intro{display:grid;gap:14px;justify-items:start}
.gb-pb .gb-set__h{font-family:var(--font-h);font-size:clamp(30px,4.2vw,50px);line-height:1.04;letter-spacing:-.025em;margin:0;font-weight:800;color:var(--brown-ink);text-wrap:balance;
  border-left:8px solid var(--yellow);padding-left:18px}
.gb-pb .gb-set__hero{border-radius:22px;overflow:hidden;background:#4A3624;border:8px solid #4A3624;box-shadow:0 22px 60px rgba(0,0,0,.45)}
.gb-pb .gb-set__hero img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:14px}
.gb-pb .gb-set__hero .gb-ph{aspect-ratio:4/3;border-radius:14px}
.gb-pb .gb-set__grid{list-style:none;margin:clamp(28px,4vw,52px) 0 0;padding:0;display:grid;gap:14px;grid-template-columns:repeat(2,minmax(0,1fr))}
