@media(min-width:960px){.gb-pb .gb-set__grid{grid-template-columns:repeat(5,minmax(0,1fr))}}
.gb-pb .gb-tool{background:#4A3624;border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:12px 12px 16px;display:grid;gap:8px;align-content:start}
.gb-pb .gb-tool__shot{border-radius:11px;overflow:hidden;background:#5B4430;aspect-ratio:1}
.gb-pb .gb-tool__shot img{width:100%;height:100%;object-fit:cover;display:block}
.gb-pb .gb-tool__shot .gb-ph{height:100%;border-radius:0;font-size:12px;padding:8px}
.gb-pb .gb-tool__name{font-family:var(--font-h);font-weight:800;font-size:17px;line-height:1.2;color:var(--brown-ink)}
