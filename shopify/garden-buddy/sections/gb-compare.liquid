{%- comment -%}
  GARDEN BUDDY — the comparison table.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'
  assign compare_n = 0
  for block in section.blocks
    if block.type == 'compare'
      assign compare_n = compare_n | plus: 1
    endif
  endfor
-%}

<div class="gb gb-pb">

  {%- if compare_n > 0 -%}
  <section class="gb-sec gb-better" id="compare">
    <div class="gb-wrap">
      <div class="gb-head gb-head--center">
        {%- if s.cmp_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.cmp_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.cmp_heading }}</h2>
      </div>
      <div class="gb-better__in">
        <div class="gb-table-wrap gb-rise">
          <table class="gb-cmp">
            <thead>
              <tr>
                <th scope="col"><span class="gb-visually-hidden">Feature</span></th>
                <th scope="col" class="is-us">{{ s.cmp_col_1 }}</th>
                <th scope="col">{{ s.cmp_col_2 }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for block in section.blocks -%}
                {%- if block.type != 'compare' -%}{%- continue -%}{%- endif -%}
                {%- assign b = block.settings -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row">{{ b.label | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</th>
                  {%- for i in (1..2) -%}
                    {%- assign vk = 'v' | append: i -%}
                    {%- assign val = b[vk] | strip -%}
                    {%- assign vl = val | downcase -%}
                    <td{% if i == 1 %} class="is-us"{% endif %}>
                      {%- if vl == 'yes' -%}
                        <span class="gb-yes" role="img" aria-label="Yes"></span>
                      {%- elsif vl == 'no' -%}
                        <span class="gb-no" role="img" aria-label="No"></span>
                      {%- else -%}
                        <span class="gb-cmp__txt">{{ val | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</span>
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
  {%- endif -%}
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-sec{padding:clamp(56px,7vw,100px) 0}
.gb-pb .gb-head{display:grid;gap:10px;margin-bottom:clamp(34px,4.5vw,60px)}
.gb-pb .gb-head--tight{margin-bottom:0}
.gb-pb .gb-head--center{justify-items:center;text-align:center}
.gb-pb .gb-head--center .gb-lede{max-width:52ch;text-align:center}
.gb-pb .gb-h2{font-family:var(--font-h);font-weight:700;text-transform:uppercase;
  font-size:clamp(30px,4.4vw,52px);line-height:1.06;letter-spacing:-.01em;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h2{color:var(--brown-ink)}
.gb-pb .gb-sec--night .gb-h2{color:var(--night-ink)}
.gb-pb .gb-lede{font-size:clamp(18px,1.8vw,21px);line-height:1.6;max-width:46ch;color:var(--dim);margin-top:4px}
.gb-pb .gb-eyebrow{font-size:14px;letter-spacing:.16em;margin-bottom:4px}
.gb-pb .gb-h3{font-family:var(--font-h);font-size:clamp(21px,2.1vw,26px);line-height:1.18;margin:0 0 8px;font-weight:800;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h3,.gb-pb .gb-sec--night .gb-h3{color:inherit}
.gb-pb .gb-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.gb-pb .gb-table-wrap{overflow-x:auto}
.gb-pb a:focus-visible,.gb-pb summary:focus-visible,.gb-pb button:focus-visible{outline:3px solid var(--leaf);outline-offset:3px;border-radius:6px}
.gb-pb .gb-sec--night a:focus-visible,.gb-pb .gb-sec--brown a:focus-visible{outline-color:var(--lime)}
.gb-pb svg{width:100%;height:100%;display:block}
.gb-pb .gb-btn{min-height:60px;font-size:19px;padding:0 34px}

/* ——— the comparison table ——— */
.gb-pb .gb-better__in{display:grid;gap:clamp(40px,5vw,72px)}
.gb-pb .gb-cmp{width:100%;max-width:940px;margin:0 auto;min-width:340px;
  border-collapse:separate;border-spacing:0}
.gb-pb .gb-cmp th,.gb-pb .gb-cmp td{padding:18px 16px;text-align:center;font-size:clamp(18px,1.7vw,20px);height:64px}
.gb-pb .gb-cmp thead th{font-family:var(--font-h);font-weight:800;text-transform:uppercase;
  font-size:clamp(15px,1.5vw,18px);letter-spacing:.04em;color:var(--dim);background:transparent;padding-bottom:14px}
.gb-pb .gb-cmp thead th.is-us{font-size:clamp(18px,2vw,24px);letter-spacing:.02em;
  color:var(--brown-ink);background:var(--brown);border-radius:18px 18px 0 0;padding:22px 16px}
.gb-pb .gb-cmp tbody th{text-align:left;font-weight:700;color:var(--ink);width:44%}
.gb-pb .gb-cmp tbody tr:nth-child(odd) th,
.gb-pb .gb-cmp tbody tr:nth-child(odd) td:not(.is-us){background:var(--sand)}
.gb-pb .gb-cmp tbody tr:nth-child(even) th,
.gb-pb .gb-cmp tbody tr:nth-child(even) td:not(.is-us){background:var(--paper)}
.gb-pb .gb-cmp tbody th{border-radius:12px 0 0 12px;padding-left:20px}
.gb-pb .gb-cmp td.is-us{background:var(--brown);color:var(--brown-ink);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.10)}
.gb-pb .gb-cmp tbody tr:last-child td.is-us{border-radius:0 0 18px 18px}
.gb-pb .gb-cmp .gb-cmp__txt{font-weight:800;color:var(--ink)}
.gb-pb .gb-cmp td.is-us .gb-cmp__txt{color:var(--brown-ink)}
.gb-pb .gb-yes,.gb-pb .gb-no{display:inline-block;width:36px;height:36px;border-radius:50%;vertical-align:middle}
.gb-pb .gb-yes{background:var(--lime) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2312290C' stroke-width='3.4' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.5l4.2 4.2L19 7'/></svg>") center/21px no-repeat}
.gb-pb .gb-no{background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235D6657' stroke-width='3' stroke-linecap='round'><path d='M7 7l10 10M17 7L7 17'/></svg>") center/17px no-repeat;
  box-shadow:inset 0 0 0 2px var(--sand-2)}
.gb-pb .gb-cmp td.is-us .gb-no{box-shadow:inset 0 0 0 2px rgba(255,255,255,.4);
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23F6EEE2' stroke-width='3' stroke-linecap='round'><path d='M7 7l10 10M17 7L7 17'/></svg>")}

/* entrance. JS adds data-gb-anim, so with no JS everything is simply visible. */
.gb-pb[data-gb-anim] .gb-rise{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.3,1)}
.gb-pb[data-gb-anim] .gb-rise--late{transition-delay:.12s}
.gb-pb[data-gb-anim] .gb-rise.is-in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  .gb-pb[data-gb-anim] .gb-rise{opacity:1;transform:none;transition:none}
}
{% endstylesheet %}

{% javascript %}
  (function () {
    var run = function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return;
      var io = window.__gbRiseIO;
      if (!io) {
        io = window.__gbRiseIO = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
          });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
      }
      Array.prototype.forEach.call(document.querySelectorAll('.gb-pb'), function (root) {
        root.setAttribute('data-gb-anim', '');
        Array.prototype.forEach.call(root.querySelectorAll('.gb-rise'), function (el) {
          if (el.hasAttribute('data-gb-seen')) return;
          el.setAttribute('data-gb-seen', '');
          io.observe(el);
        });
      });
    };
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', run); } else { run(); }
    document.addEventListener('shopify:section:load', run);
  }());
{% endjavascript %}

{% schema %}
{
  "name": "GB Comparison",
  "tag": "section",
  "class": "gb-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Anything written as [ LIKE THIS ] shows as a placeholder until you replace it. Nothing here is invented."
    },
    {
      "type": "text",
      "id": "cmp_eyebrow",
      "label": "Eyebrow",
      "default": "Compare"
    },
    {
      "type": "text",
      "id": "cmp_heading",
      "label": "Heading",
      "default": "What makes Garden Buddy better"
    },
    {
      "type": "text",
      "id": "cmp_col_1",
      "label": "Column 1 (this product)",
      "default": "Garden Buddy"
    },
    {
      "type": "text",
      "id": "cmp_col_2",
      "label": "Column 2",
      "default": "Others"
    }
  ],
  "blocks": [
    {
      "type": "compare",
      "name": "Compare row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Kneels and sits"
        },
        {
          "type": "text",
          "id": "v1",
          "label": "Garden Buddy",
          "default": "yes",
          "info": "yes, no, or short text"
        },
        {
          "type": "text",
          "id": "v2",
          "label": "Others",
          "default": "no"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GB Comparison",
      "blocks": [
        {
          "type": "compare",
          "settings": {
            "label": "Kneels and sits",
            "v1": "yes",
            "v2": "no"
          }
        },
        {
          "type": "compare",
          "settings": {
            "label": "Handles to push up on",
            "v1": "yes",
            "v2": "no"
          }
        },
        {
          "type": "compare",
          "settings": {
            "label": "10-piece tool set included",
            "v1": "yes",
            "v2": "no"
          }
        },
        {
          "type": "compare",
          "settings": {
            "label": "Folding stool included",
            "v1": "yes",
            "v2": "no"
          }
        },
        {
          "type": "compare",
          "settings": {
            "label": "Tool bag with pockets",
            "v1": "yes",
            "v2": "no"
          }
        },
        {
          "type": "compare",
          "settings": {
            "label": "Arrives assembled",
            "v1": "yes",
            "v2": "no"
          }
        },
        {
          "type": "compare",
          "settings": {
            "label": "Detachable pad",
            "v1": "yes",
            "v2": "no"
          }
        },
        {
          "type": "compare",
          "settings": {
            "label": "Folds flat for storage",
            "v1": "yes",
            "v2": "yes"
          }
        }
      ]
    }
  ]
}
{% endschema %}
