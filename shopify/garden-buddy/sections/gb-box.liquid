{%- comment -%}
  GARDEN BUDDY — what's in the box.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'
  assign box_n = 0
  for block in section.blocks
    if block.type == 'box_item'
      assign box_n = box_n | plus: 1
    endif
  endfor
-%}

<div class="gb gb-pb">

  {%- if box_n > 0 -%}
  <section class="gb-sec gb-sec--sand gb-detail" id="box">
    <div class="gb-wrap">
      <div class="gb-box">
        <div class="gb-head gb-head--tight">
          {%- if s.box_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.box_eyebrow }}</p>{%- endif -%}
          <h2 class="gb-h2">{{ s.box_heading }}</h2>
          {%- if s.box_text != blank -%}<p class="gb-lede">{{ s.box_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
        </div>
        <ul class="gb-box__list">
          {%- for block in section.blocks -%}
            {%- if block.type != 'box_item' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            <li class="gb-check" {{ block.shopify_attributes }}>
              <span>{{ b.name | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}{%- if b.note != blank -%}<small>{{ b.note | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</small>{%- endif -%}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>
  {%- endif -%}
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-sec{padding:clamp(56px,7vw,100px) 0}
.gb-pb .gb-head{display:grid;gap:10px;margin-bottom:clamp(34px,4.5vw,60px)}
.gb-pb .gb-head--tight{margin-bottom:0}
.gb-pb .gb-head--center{justify-items:center;text-align:center}
.gb-pb .gb-head--center .gb-lede{max-width:52ch;text-align:center}
.gb-pb .gb-h2{font-family:var(--font-h);font-weight:700;text-transform:uppercase;
  font-size:clamp(30px,4.4vw,52px);line-height:1.06;letter-spacing:-.01em;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h2{color:var(--brown-ink)}
.gb-pb .gb-sec--night .gb-h2{color:var(--night-ink)}
.gb-pb .gb-lede{font-size:clamp(18px,1.8vw,21px);line-height:1.6;max-width:46ch;color:var(--dim);margin-top:4px}
.gb-pb .gb-eyebrow{font-size:14px;letter-spacing:.16em;margin-bottom:4px}
.gb-pb .gb-h3{font-family:var(--font-h);font-size:clamp(21px,2.1vw,26px);line-height:1.18;margin:0 0 8px;font-weight:800;color:var(--brown)}
.gb-pb .gb-sec--brown .gb-h3,.gb-pb .gb-sec--night .gb-h3{color:inherit}
.gb-pb .gb-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.gb-pb .gb-table-wrap{overflow-x:auto}
.gb-pb a:focus-visible,.gb-pb summary:focus-visible,.gb-pb button:focus-visible{outline:3px solid var(--leaf);outline-offset:3px;border-radius:6px}
.gb-pb .gb-sec--night a:focus-visible,.gb-pb .gb-sec--brown a:focus-visible{outline-color:var(--lime)}
.gb-pb svg{width:100%;height:100%;display:block}
.gb-pb .gb-btn{min-height:60px;font-size:19px;padding:0 34px}

/* ——— in the box ——— */
.gb-pb .gb-box__list{list-style:none;margin:0;padding:0;display:grid;gap:18px;margin-top:26px}
.gb-pb .gb-box__list li{font-size:20px;line-height:1.4}
.gb-pb .gb-box__list small{display:block;font-weight:500;color:var(--dim);font-size:17px;margin-top:2px}
{% endstylesheet %}

{% schema %}
{
  "name": "GB In the box",
  "tag": "section",
  "class": "gb-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Anything written as [ LIKE THIS ] shows as a placeholder until you replace it. Nothing here is invented."
    },
    {
      "type": "text",
      "id": "box_eyebrow",
      "label": "Eyebrow",
      "default": "In the box"
    },
    {
      "type": "text",
      "id": "box_heading",
      "label": "Heading",
      "default": "What arrives."
    },
    {
      "type": "textarea",
      "id": "box_text",
      "label": "Note",
      "default": "Everything listed here comes in the box. Nothing to assemble."
    }
  ],
  "blocks": [
    {
      "type": "box_item",
      "name": "Box item",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Item",
          "default": "Kneeler seat, assembled"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GB In the box",
      "blocks": [
        {
          "type": "box_item",
          "settings": {
            "name": "Kneeler seat, assembled"
          }
        },
        {
          "type": "box_item",
          "settings": {
            "name": "Detachable foam pad"
          }
        },
        {
          "type": "box_item",
          "settings": {
            "name": "Tool pouch",
            "note": "[ CONFIRM INCLUDED ]"
          }
        },
        {
          "type": "box_item",
          "settings": {
            "name": "[ GLOVES — CONFIRM INCLUDED ]"
          }
        }
      ]
    }
  ]
}
{% endschema %}
