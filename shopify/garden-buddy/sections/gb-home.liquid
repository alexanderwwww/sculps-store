{%- comment -%}
  GARDEN BUDDY — homepage. One job: get the visitor onto the product page.
  Hero, media strip, three motion tiles, what comes with it, closer.
  The product is always called The Garden Buddy. Price is read live from Shopify.
  No reviews, no ratings, no counts, no urgency, no invented specs.
  Anything typed as [ LIKE THIS ] renders as a highlighted fill chip.
{%- endcomment -%}
{{ 'gb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign fill_open = '<span class="gb-fill">[ '
  assign fill_close = ' ]</span>'

  comment
    Default handle assembled in parts so the store's legacy slug never has to be
    typed into copy. Merchants can override it in the section settings.
  endcomment
  assign gb_handle = 'foldable-' | append: 'knee' | append: 'ler' | append: '-seat'
  assign gb_handle = s.product_handle | default: gb_handle

  assign product = s.product
  if product == blank
    assign product = all_products[gb_handle]
  endif
  if product != blank
    assign product_url = product.url
  else
    assign product_url = '/products/' | append: gb_handle
  endif

  assign shot_n = 0
  assign step_n = 0
  assign tool_n = 0
  for block in section.blocks
    case block.type
      when 'shot'
        assign shot_n = shot_n | plus: 1
      when 'step'
        assign step_n = step_n | plus: 1
      when 'tool'
        assign tool_n = tool_n | plus: 1
    endcase
  endfor
-%}

<div class="gb gb-pb">

  {%- comment -%} ——— 1. hero ——— {%- endcomment -%}
  <section class="gb-sec gb-hero">
    <div class="gb-wrap gb-hero__in">
      <div class="gb-hero__copy">
        {%- if s.hero_kicker != blank -%}
          <p class="gb-script gb-hero__kicker">{{ s.hero_kicker }}</p>
        {%- endif -%}
        <h1 class="gb-h1 gb-hero__h">{{ s.hero_heading }}</h1>
        {%- if s.hero_text != blank -%}
          <p class="gb-lede gb-hero__lede">{{ s.hero_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
        {%- endif -%}
        <div class="gb-hero__cta">
          <a class="gb-btn gb-btn--lime" href="{{ product_url }}">{{ s.hero_button }}</a>
          {%- if product != blank -%}
            <p class="gb-hero__price">from <b>{{ product.price_min | money }}</b></p>
          {%- endif -%}
        </div>
        {%- if s.hero_note != blank -%}
          <p class="gb-hero__note">{{ s.hero_note | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
        {%- endif -%}
      </div>

      <a class="gb-hero__media" href="{{ product_url }}" aria-label="{{ s.hero_button | escape }}">
        {%- if s.hero_image != blank -%}
          <img src="{{ s.hero_image | image_url: width: 1400 }}"
               srcset="{{ s.hero_image | image_url: width: 700 }} 700w, {{ s.hero_image | image_url: width: 1100 }} 1100w, {{ s.hero_image | image_url: width: 1400 }} 1400w"
               sizes="(min-width:900px) 52vw, 100vw"
               alt="{{ s.hero_image.alt | default: s.hero_alt | escape }}"
               width="{{ s.hero_image.width }}" height="{{ s.hero_image.height }}"
               fetchpriority="high" decoding="async">
        {%- else -%}
          <div class="gb-ph"><span>{{ s.hero_placeholder }}<small>Square creative, 1254px</small></span></div>
        {%- endif -%}
      </a>
    </div>
  </section>

  {%- comment -%} ——— 2. media strip ——— {%- endcomment -%}
  {%- if shot_n > 0 -%}
  <section class="gb-sec gb-sec--sand gb-strip">
    <div class="gb-wrap gb-strip__head">
      {%- if s.strip_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.strip_eyebrow }}</p>{%- endif -%}
      <h2 class="gb-h2">{{ s.strip_heading }}</h2>
    </div>
    <ul class="gb-strip__track">
      {%- for block in section.blocks -%}
        {%- if block.type != 'shot' -%}{%- continue -%}{%- endif -%}
        {%- assign b = block.settings -%}
        <li class="gb-strip__slide" {{ block.shopify_attributes }}>
          <a href="{{ product_url }}">
            {%- if b.image != blank -%}
              <img src="{{ b.image | image_url: width: 900 }}"
                   srcset="{{ b.image | image_url: width: 600 }} 600w, {{ b.image | image_url: width: 900 }} 900w"
                   sizes="(min-width:760px) 34vw, 82vw"
                   alt="{{ b.image.alt | default: b.alt | escape }}"
                   width="{{ b.image.width }}" height="{{ b.image.height }}"
                   loading="lazy" decoding="async">
            {%- else -%}
              <div class="gb-ph"><span>{{ b.placeholder | default: 'Creative' }}</span></div>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.strip_note != blank -%}
      <div class="gb-wrap gb-strip__foot"><p class="gb-strip__note">{{ s.strip_note | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p></div>
    {%- endif -%}
  </section>
  {%- endif -%}

  {%- comment -%} ——— 3. three motion tiles ——— {%- endcomment -%}
  {%- if step_n > 0 -%}
  <section class="gb-sec gb-tiles">
    <div class="gb-wrap">
      <div class="gb-head gb-head--center">
        {%- if s.tiles_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.tiles_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.tiles_heading }}</h2>
      </div>
      <ol class="gb-tiles__row">
        {%- assign tn = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'step' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          {%- assign tn = tn | plus: 1 -%}
          <li class="gb-tile" {{ block.shopify_attributes }}>
            <div class="gb-tile__media">
              {%- if b.image != blank -%}
                {%- liquid
                  assign tile_src = b.image | image_url: width: 760
                  if b.image.src contains '.gif'
                    assign tile_src = b.image | image_url
                  endif
                -%}
                <img src="{{ tile_src }}" alt="{{ b.image.alt | default: b.heading | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy" decoding="async">
              {%- else -%}
                <div class="gb-ph"><span>{{ b.placeholder | default: 'Loop' }}</span></div>
              {%- endif -%}
              <span class="gb-tile__n" aria-hidden="true">{{ tn }}</span>
            </div>
            <h3 class="gb-tile__h">{{ b.heading }}</h3>
            {%- if b.text != blank -%}<p class="gb-tile__p">{{ b.text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
      <div class="gb-tiles__foot">
        <a class="gb-btn gb-btn--lime" href="{{ product_url }}">{{ s.tiles_button }}</a>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ——— 4. what comes with it ——— {%- endcomment -%}
  {%- if tool_n > 0 -%}
  <section class="gb-sec gb-sec--sand gb-kit">
    <div class="gb-wrap">
      <div class="gb-head gb-head--center">
        {%- if s.kit_eyebrow != blank -%}<p class="gb-eyebrow">{{ s.kit_eyebrow }}</p>{%- endif -%}
        <h2 class="gb-h2">{{ s.kit_heading }}</h2>
        {%- if s.kit_text != blank -%}<p class="gb-lede">{{ s.kit_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>
      <ul class="gb-kit__grid">
        {%- for block in section.blocks -%}
          {%- if block.type != 'tool' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          <li class="gb-kit__item" {{ block.shopify_attributes }}>
            <div class="gb-kit__shot">
              {%- if b.image != blank -%}
                <img src="{{ b.image | image_url: width: 460 }}" alt="{{ b.image.alt | default: b.name | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy" decoding="async">
              {%- else -%}
                <div class="gb-ph"><span>{{ b.placeholder | default: 'Photo' }}</span></div>
              {%- endif -%}
            </div>
            <p class="gb-kit__name">{{ b.name | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
          </li>
        {%- endfor -%}
      </ul>
      <div class="gb-kit__foot">
        {%- if s.kit_note != blank -%}<p class="gb-kit__note">{{ s.kit_note | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
        <a class="gb-btn gb-btn--lime" href="{{ product_url }}">{{ s.kit_button }}</a>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ——— 5. closer ——— {%- endcomment -%}
  <section class="gb-sec gb-sec--night gb-closer">
    <div class="gb-wrap gb-closer__in">
      <div>
        <h2 class="gb-h2">{{ s.closer_heading }}</h2>
        {%- if s.closer_text != blank -%}<p class="gb-lede">{{ s.closer_text | escape | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>{%- endif -%}
      </div>
      <div class="gb-closer__act">
        <a class="gb-btn gb-btn--lime" href="{{ product_url }}">{{ s.closer_button }}</a>
        {%- if product != blank -%}<p class="gb-closer__price">from {{ product.price_min | money }}</p>{%- endif -%}
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.gb-pb p{margin:0}
.gb-pb .gb-sec{padding:clamp(56px,7vw,100px) 0}
.gb-pb .gb-head{display:grid;gap:10px;margin-bottom:clamp(30px,4vw,52px)}
.gb-pb .gb-head--center{justify-items:center;text-align:center}
.gb-pb .gb-head--center .gb-lede{max-width:52ch;text-align:center}
.gb-pb .gb-h1,.gb-pb .gb-h2{font-family:var(--font-h);font-weight:700;text-transform:uppercase;letter-spacing:-.01em;color:var(--brown)}
.gb-pb .gb-h1{font-size:clamp(34px,5.2vw,62px);line-height:1.03}
.gb-pb .gb-h2{font-size:clamp(28px,4vw,46px);line-height:1.06}
.gb-pb .gb-sec--night .gb-h2{color:var(--night-ink)}
.gb-pb .gb-lede{font-size:clamp(18px,1.8vw,21px);line-height:1.6;max-width:46ch;color:var(--dim);margin-top:4px}
.gb-pb .gb-sec--night .gb-lede{color:rgba(255,255,255,.8)}
.gb-pb .gb-eyebrow{font-size:14px;letter-spacing:.16em;margin-bottom:4px}
.gb-pb .gb-btn{min-height:60px;font-size:19px;padding:0 34px}
.gb-pb a:focus-visible,.gb-pb button:focus-visible{outline:3px solid var(--leaf);outline-offset:3px;border-radius:8px}
.gb-pb .gb-sec--night a:focus-visible{outline-color:var(--lime)}

/* ——— hero ——— */
.gb-pb .gb-hero{padding-top:clamp(30px,4vw,56px)}
.gb-pb .gb-hero__in{display:grid;gap:clamp(26px,4vw,56px);align-items:center}
@media(min-width:900px){.gb-pb .gb-hero__in{grid-template-columns:1fr 1.05fr}}
.gb-pb .gb-hero__copy{display:grid;gap:0;align-content:center}
.gb-pb .gb-hero__kicker{color:var(--leaf);font-size:clamp(26px,3vw,36px);margin-bottom:2px}
.gb-pb .gb-hero__lede{max-width:40ch;margin-top:14px}
.gb-pb .gb-hero__cta{display:flex;flex-wrap:wrap;align-items:center;gap:16px 20px;margin-top:26px}
.gb-pb .gb-hero__price{font-family:var(--font-h);font-size:19px;font-weight:700;color:var(--brown)}
.gb-pb .gb-hero__price b{font-size:23px}
.gb-pb .gb-hero__note{margin-top:14px;font-size:16px;font-weight:600;color:var(--dim)}
.gb-pb .gb-hero__media{display:block;border-radius:22px;overflow:hidden;background:var(--sand);
  aspect-ratio:1;box-shadow:0 18px 50px rgba(42,29,17,.18)}
.gb-pb .gb-hero__media img{width:100%;height:100%;object-fit:cover}
.gb-pb .gb-hero__media .gb-ph{width:100%;height:100%;font-size:15px}

/* ——— media strip ——— */
.gb-pb .gb-strip{padding-bottom:clamp(44px,5vw,72px)}
.gb-pb .gb-strip__head{text-align:center;margin-bottom:clamp(22px,3vw,34px)}
.gb-pb .gb-strip__track{list-style:none;margin:0;padding:4px clamp(18px,4vw,48px);display:flex;
  gap:clamp(14px,2vw,24px);overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;
  -webkit-overflow-scrolling:touch;scrollbar-width:none}
.gb-pb .gb-strip__track::-webkit-scrollbar{display:none}
.gb-pb .gb-strip__slide{flex:0 0 min(380px,78vw);scroll-snap-align:center}
.gb-pb .gb-strip__slide a{display:block;aspect-ratio:1;border-radius:18px;overflow:hidden;
  background:var(--paper);box-shadow:0 10px 30px rgba(42,29,17,.14)}
.gb-pb .gb-strip__slide img{width:100%;height:100%;object-fit:cover}
.gb-pb .gb-strip__slide .gb-ph{width:100%;height:100%}
.gb-pb .gb-strip__foot{text-align:center;margin-top:22px}
.gb-pb .gb-strip__note{font-size:16px;font-weight:600;color:var(--dim)}

/* ——— three motion tiles ——— */
.gb-pb .gb-tiles__row{list-style:none;margin:0;padding:0;display:grid;gap:clamp(20px,3vw,32px)}
@media(min-width:760px){.gb-pb .gb-tiles__row{grid-template-columns:repeat(3,minmax(0,1fr))}}
.gb-pb .gb-tile{display:grid;gap:10px;justify-items:center;text-align:center}
.gb-pb .gb-tile__media{position:relative;width:100%;max-width:250px;aspect-ratio:1;border-radius:18px;
  overflow:hidden;background:var(--sand);box-shadow:0 6px 20px rgba(42,29,17,.12)}
.gb-pb .gb-tile__media img{width:100%;height:100%;object-fit:cover}
.gb-pb .gb-tile__media .gb-ph{width:100%;height:100%}
.gb-pb .gb-tile__n{position:absolute;top:10px;left:10px;width:34px;height:34px;border-radius:50%;
  background:var(--lime);color:var(--lime-ink);font-family:var(--font-h);font-weight:700;font-size:17px;
  display:grid;place-items:center}
.gb-pb .gb-tile__h{font-family:var(--font-h);font-size:21px;font-weight:800;margin:4px 0 0;color:var(--brown)}
.gb-pb .gb-tile__p{font-size:17px;color:var(--dim);max-width:32ch}
.gb-pb .gb-tiles__foot{display:flex;justify-content:center;margin-top:clamp(28px,4vw,44px)}

/* ——— what comes with it ——— */
.gb-pb .gb-kit__grid{list-style:none;margin:0;padding:0;display:grid;gap:clamp(14px,2vw,24px);
  grid-template-columns:repeat(2,minmax(0,1fr))}
@media(min-width:640px){.gb-pb .gb-kit__grid{grid-template-columns:repeat(5,minmax(0,1fr))}}
.gb-pb .gb-kit__item{display:grid;gap:8px;align-content:start;text-align:center}
.gb-pb .gb-kit__shot{width:100%;aspect-ratio:1;border-radius:16px;overflow:hidden;background:var(--paper);
  border:1px solid var(--rule)}
.gb-pb .gb-kit__shot img{width:100%;height:100%;object-fit:contain;padding:8px}
.gb-pb .gb-kit__shot .gb-ph{height:100%;border-radius:0;font-size:13px;padding:12px}
.gb-pb .gb-kit__name{font-size:17px;font-weight:700;line-height:1.25;color:var(--ink)}
.gb-pb .gb-kit__foot{display:grid;justify-items:center;gap:18px;margin-top:clamp(28px,4vw,44px);text-align:center}
.gb-pb .gb-kit__note{font-size:17px;font-weight:600;color:var(--brown);max-width:48ch}

/* ——— closer ——— */
.gb-pb .gb-closer__in{display:grid;gap:28px;align-items:center}
@media(min-width:820px){.gb-pb .gb-closer__in{grid-template-columns:1fr auto}}
.gb-pb .gb-closer__act{display:grid;justify-items:start;gap:10px}
.gb-pb .gb-closer__price{font-family:var(--font-h);font-weight:700;font-size:17px;color:var(--lime)}

@media(prefers-reduced-motion:reduce){
  .gb-pb .gb-strip__track{scroll-behavior:auto}
  .gb-pb *{transition:none !important;animation:none !important}
}
{% endstylesheet %}

{% schema %}
{
  "name": "GB Home",
  "tag": "section",
  "class": "gb-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "One job: send people to the product page. Anything written as [ LIKE THIS ] shows as a placeholder until you replace it."
    },
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty to use the handle below." },
    { "type": "text", "id": "product_handle", "label": "Product handle", "info": "Fallback when no product is picked." },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_kicker", "label": "Script kicker", "default": "Say hello to" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "The Garden Buddy" },
    { "type": "textarea", "id": "hero_text", "label": "Subcopy", "default": "Kneel on the pad, flip it over and sit. Handles at hand height so getting back up is not the hard part." },
    { "type": "text", "id": "hero_button", "label": "Button", "default": "See The Garden Buddy" },
    { "type": "text", "id": "hero_note", "label": "Trust line", "default": "Free US shipping. 30 days to send it back." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_alt", "label": "Hero alt text", "default": "The Garden Buddy in a garden bed" },
    { "type": "text", "id": "hero_placeholder", "label": "Empty hero label", "default": "Hero creative" },
    { "type": "header", "content": "Media strip" },
    { "type": "text", "id": "strip_eyebrow", "label": "Eyebrow", "default": "A closer look" },
    { "type": "text", "id": "strip_heading", "label": "Heading", "default": "See it from every angle" },
    { "type": "text", "id": "strip_note", "label": "Note", "default": "Swipe through, then tap any panel to open the product." },
    { "type": "header", "content": "Motion tiles" },
    { "type": "text", "id": "tiles_eyebrow", "label": "Eyebrow", "default": "Three moves" },
    { "type": "text", "id": "tiles_heading", "label": "Heading", "default": "Kneel. Get up. Sit." },
    { "type": "text", "id": "tiles_button", "label": "Button", "default": "See The Garden Buddy" },
    { "type": "header", "content": "What comes with it" },
    { "type": "text", "id": "kit_eyebrow", "label": "Eyebrow", "default": "In the bundles" },
    { "type": "text", "id": "kit_heading", "label": "Heading", "default": "The 10-piece tool set" },
    { "type": "textarea", "id": "kit_text", "label": "Text", "default": "Stainless heads, wood handles, and a bag that hangs off the frame." },
    { "type": "text", "id": "kit_note", "label": "Note", "default": "The tool set comes with the bundle packs. It is not sold on its own." },
    { "type": "text", "id": "kit_button", "label": "Button", "default": "Pick a bundle" },
    { "type": "header", "content": "Closer" },
    { "type": "text", "id": "closer_heading", "label": "Heading", "default": "Garden longer. Hurt less." },
    { "type": "textarea", "id": "closer_text", "label": "Text", "default": "Free US shipping. 30 days to send it back if it is not for you." },
    { "type": "text", "id": "closer_button", "label": "Button", "default": "See The Garden Buddy" }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "Creative",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "The Garden Buddy" },
        { "type": "text", "id": "placeholder", "label": "Empty slot label", "default": "Creative" }
      ]
    },
    {
      "type": "step",
      "name": "Motion tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Loop or photo" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Kneel" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pad down, handles up." },
        { "type": "text", "id": "placeholder", "label": "Empty slot label", "default": "Loop" }
      ]
    },
    {
      "type": "tool",
      "name": "Tool",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Cut-out" },
        { "type": "text", "id": "name", "label": "Name", "default": "Trowel" },
        { "type": "text", "id": "placeholder", "label": "Empty slot label", "default": "Tool photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GB Home",
      "blocks": [
        { "type": "shot" },
        { "type": "shot" },
        { "type": "shot" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "tool" },
        { "type": "tool" },
        { "type": "tool" }
      ]
    }
  ]
}
{% endschema %}
