      },
      "blocks": {
        "head": {
          "type": "text",
          "settings": {
            "text": "<p>Everything people ask before ordering.</p>",
            "alignment": "left",
            "type_preset": "h2",
            "width": "fit-content",
            "font": "var(--font-heading--family)",
            "padding-block-end": 8,
            "font_size": "2.25rem"
