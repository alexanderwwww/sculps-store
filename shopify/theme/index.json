                    "type_preset": "h4",
                    "width": "fit-content",
                    "font": "var(--font-heading--family)",
                    "font_size": "1.0625rem"
                  }
                },
                "a": {
                  "type": "text",
                  "settings": {
                    "text": "<p>The reapers handle rain. Standing water, snow and freezing conditions they do not. The swings are fabric, so light rain only. Keep the projector under a porch roof.</p>",
                    "alignment": "left",
                    "type_preset": "rte",
                    "width": "fit-content",
                    "font": "var(--font-body--family)",
                    "font_size": "0.9375rem",
