{%- comment -%}
  THE BLACK REAPER — announcement bar + sticky header.
  Ported from reaper.html (.bar / .hdr) and assets/store.js (tick()).
  The cutoff is the real shipping deadline. Do not move it to make urgency.
{%- endcomment -%}

{%- liquid
  assign menu = linklists[section.settings.link_list]

  assign wm = section.settings.wordmark | default: 'THE BLACK REAPER' | strip
  assign wm_parts = wm | split: ' '
  assign wm_last = wm_parts | last
  assign wm_n = wm_parts.size | minus: 1
  assign wm_head = wm_parts | slice: 0, wm_n | join: ' '

  comment
    Single source of truth is the global theme setting (settings.cutoff_iso / settings.cutoff_label).
    The section copies are a fallback only until config/settings_schema.json carries them.
  endcomment
  assign cutoff_iso = settings.cutoff_iso | default: section.settings.cutoff_iso
  assign cutoff_label = settings.cutoff_label | default: section.settings.cutoff_label
  assign cutoff_short = settings.cutoff_short | default: section.settings.cutoff_short

  assign cutoff_ts = cutoff_iso | date: '%s' | plus: 0
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign past_cutoff = false
  if cutoff_ts > 0 and now_ts > cutoff_ts
    assign past_cutoff = true
  endif
-%}

{{ 'tbr.css' | asset_url | stylesheet_tag }}

<div class="tbr tbr-hdr-sec"
     data-cutoff="{{ cutoff_iso | escape }}"
     data-after="{{ section.settings.bar_after | escape }}"
     data-cart-url="{{ routes.cart_url }}.js">

  {%- if section.settings.show_bar -%}
    <div class="tbr-bar" data-tbr-bar>
      <div class="tbr-bar__in">
        {%- if past_cutoff -%}
          <span class="tbr-bar__msg" data-tbr-bar-msg>{{ section.settings.bar_after | escape }}</span>
        {%- else -%}
          <span class="tbr-bar__msg tbr-bar__msg--long" data-tbr-bar-msg>Order by <b>{{ cutoff_label | escape }}</b> to get it before Halloween.</span>
          <span class="tbr-bar__msg tbr-bar__msg--short" data-tbr-bar-msg aria-hidden="true">Order by <b>{{ cutoff_short | escape }}</b> for Halloween</span>
          <span class="tbr-bar__clock" data-tbr-clock aria-live="off"><span data-tbr-clock-n></span><span class="tbr-bar__left"> left</span></span>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <header class="tbr-hdr">
    <div class="tbr-wrap tbr-hdr__in">

      <button class="tbr-hdr__burger" type="button" aria-expanded="false" aria-controls="tbr-mnav-{{ section.id }}" data-tbr-burger>
        <span></span><span></span><span></span>
        <span class="tbr-vh">Menu</span>
      </button>

      <a class="tbr-hdr__logo" href="{{ routes.root_url }}">
        {%- if wm_head != blank %}{{ wm_head | escape }} {% endif -%}<i>{{ wm_last | escape }}</i>
      </a>

      <nav class="tbr-hdr__nav" aria-label="Main">
        {%- for link in menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      </nav>

      <div class="tbr-hdr__right">
        {%- if section.settings.note != blank -%}
          <span class="tbr-hdr__note">{{ section.settings.note | escape }}</span>
        {%- endif -%}
        <a class="tbr-hdr__cart" href="{{ routes.cart_url }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l1 14H5L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
          <span>Cart</span>
          <span class="tbr-hdr__count" data-tbr-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      </div>

    </div>

    <nav id="tbr-mnav-{{ section.id }}" class="tbr-hdr__mnav" aria-label="Main, mobile" data-tbr-mnav hidden>
      {%- for link in menu.links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endfor -%}
      {%- if section.settings.note != blank -%}
        <small>{{ section.settings.note | escape }}</small>
      {%- endif -%}
    </nav>
  </header>

</div>

{% stylesheet %}
.tbr-hdr-sec{--night:var(--night);--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.tbr-hdr-wrap,.shopify-section:has(> .tbr-hdr-sec){position:sticky;top:calc(-1 * var(--tbr-bar-h,0px));z-index:50}
.tbr-hdr-sec .tbr-vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* announcement bar */
.tbr-hdr-sec .tbr-bar{background:var(--night);color:var(--ink);overflow:hidden}
.tbr-hdr-sec .tbr-bar__in{display:flex;flex-wrap:wrap;gap:4px 16px;align-items:center;justify-content:center;padding:10px var(--pad);text-align:center;font-size:13.5px;line-height:1.4}
.tbr-hdr-sec .tbr-bar__in b{color:var(--accent);font-weight:600}
.tbr-hdr-sec .tbr-bar__clock{font-family:var(--mono);font-size:12.5px;font-variant-numeric:tabular-nums;color:var(--accent);letter-spacing:.02em}
.tbr-hdr-sec .tbr-bar__clock.is-empty,.tbr-hdr-sec .tbr-bar__clock:has([data-tbr-clock-n]:empty){display:none}
.tbr-hdr-sec .tbr-bar__msg--short{display:none}
@media(max-width:639.98px){
  .tbr-hdr-sec .tbr-bar__in{flex-wrap:nowrap;white-space:nowrap;gap:0 10px;padding:9px 14px;font-size:13px}
  .tbr-hdr-sec .tbr-bar__msg--long{display:none}
  .tbr-hdr-sec .tbr-bar__msg--short{display:inline}
  .tbr-hdr-sec .tbr-bar__clock{font-size:12px}
  .tbr-hdr-sec .tbr-bar__left{display:none}
}

/* header */
.tbr-hdr-sec .tbr-hdr{position:relative;background:var(--paper);border-bottom:1px solid var(--rule)}
.tbr-hdr-sec .tbr-hdr__in{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;height:60px}
@media(min-width:960px){.tbr-hdr-sec .tbr-hdr__in{grid-template-columns:1fr auto 1fr;height:64px}}

.tbr-hdr-sec .tbr-hdr__burger{display:inline-flex;flex-direction:column;justify-content:center;gap:5px;width:44px;height:44px;margin-left:-10px;padding:0 11px;background:none;border:0;border-radius:4px;cursor:pointer;color:var(--ink)}
.tbr-hdr-sec .tbr-hdr__burger span:not(.tbr-vh){display:block;height:2px;background:currentColor;border-radius:1px;transition:transform .2s,opacity .2s}
.tbr-hdr-sec .tbr-hdr__burger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.tbr-hdr-sec .tbr-hdr__burger[aria-expanded="true"] span:nth-child(2){opacity:0}
.tbr-hdr-sec .tbr-hdr__burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
@media(min-width:960px){.tbr-hdr-sec .tbr-hdr__burger{display:none}}

.tbr-hdr-sec .tbr-hdr__logo{justify-self:center;font-weight:800;font-size:18px;letter-spacing:-.03em;text-decoration:none;color:var(--ink);white-space:nowrap}
.tbr-hdr-sec .tbr-hdr__logo i{font-style:normal;color:var(--gold)}
@media(min-width:960px){.tbr-hdr-sec .tbr-hdr__logo{justify-self:start}}

.tbr-hdr-sec .tbr-hdr__nav{display:none;gap:26px;font-size:14px;color:var(--dim)}
.tbr-hdr-sec .tbr-hdr__nav a{text-decoration:none;color:inherit}
.tbr-hdr-sec .tbr-hdr__nav a:hover,.tbr-hdr-sec .tbr-hdr__nav a[aria-current]{color:var(--gold)}
@media(min-width:960px){.tbr-hdr-sec .tbr-hdr__nav{display:flex}}

.tbr-hdr-sec .tbr-hdr__right{display:flex;align-items:center;gap:18px;justify-self:end}
.tbr-hdr-sec .tbr-hdr__note{display:none;font-size:12.5px;color:var(--dim);white-space:nowrap}
@media(min-width:640px){.tbr-hdr-sec .tbr-hdr__note{display:block}}
.tbr-hdr-sec .tbr-hdr__cart{display:inline-flex;align-items:center;gap:7px;min-height:44px;padding:0 4px;text-decoration:none;color:var(--ink);font-size:14px;font-weight:700}
.tbr-hdr-sec .tbr-hdr__cart:hover{color:var(--gold)}
.tbr-hdr-sec .tbr-hdr__count{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 6px;border-radius:10px;background:var(--accent);color:var(--accent-ink);font-size:11.5px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1}
.tbr-hdr-sec .tbr-hdr__count[hidden]{display:none}

/* mobile dropdown */
.tbr-hdr-sec .tbr-hdr__mnav{position:absolute;left:0;right:0;top:100%;display:grid;padding:4px var(--pad) 16px;background:var(--paper);border-bottom:1px solid var(--rule);box-shadow:0 14px 30px rgba(13,13,15,.12)}
.tbr-hdr-sec .tbr-hdr__mnav[hidden]{display:none}
.tbr-hdr-sec .tbr-hdr__mnav a{padding:13px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:var(--ink);font-size:16px;font-weight:600}
.tbr-hdr-sec .tbr-hdr__mnav a[aria-current]{color:var(--gold)}
.tbr-hdr-sec .tbr-hdr__mnav small{display:block;padding-top:12px;font-size:12.5px;color:var(--dim)}
@media(min-width:960px){.tbr-hdr-sec .tbr-hdr__mnav{display:none!important}}
@media(prefers-reduced-motion:reduce){.tbr-hdr-sec *{transition:none!important}}
{% endstylesheet %}

{% javascript %}
(function () {
  function pad(n) { return String(n).padStart(2, '0'); }

  function init(root) {
    if (root.dataset.tbrInit) return;
    root.dataset.tbrInit = '1';

    /* ---------- countdown to the real cutoff ---------- */
    var clock = root.querySelector('[data-tbr-clock]');
    var clockN = root.querySelector('[data-tbr-clock-n]');
    var msgs = root.querySelectorAll('[data-tbr-bar-msg]');
    var iso = root.getAttribute('data-cutoff');
    var after = root.getAttribute('data-after') || 'Halloween delivery cutoff has passed';
    var cutoff = iso ? new Date(iso) : null;
    var timer;

    function tick() {
      if (!clock || !cutoff || isNaN(cutoff)) return;
      var ms = cutoff - Date.now();
      if (ms <= 0) {
        msgs.forEach(function (m) { m.textContent = after; });
        clock.textContent = '';
        clock.classList.add('is-empty');
        clearInterval(timer);
        return;
      }
      var d = Math.floor(ms / 864e5),
          h = Math.floor(ms % 864e5 / 36e5),
          m = Math.floor(ms % 36e5 / 6e4),
          s = Math.floor(ms % 6e4 / 1e3);
      (clockN || clock).textContent = d + 'd ' + pad(h) + 'h ' + pad(m) + 'm ' + pad(s) + 's';
    }
    tick();
    timer = setInterval(tick, 1000);

    /* ---------- sticky offset: the bar scrolls away, the header stays ---------- */
    var bar = root.querySelector('[data-tbr-bar]');
    var wrap = root.parentElement && root.parentElement.classList.contains('shopify-section') ? root.parentElement : root;
    function measure() { wrap.style.setProperty('--tbr-bar-h', (bar ? bar.offsetHeight : 0) + 'px'); }
    measure();
    if (bar && 'ResizeObserver' in window) new ResizeObserver(measure).observe(bar);
    else window.addEventListener('resize', measure);

    /* ---------- hamburger ---------- */
    var btn = root.querySelector('[data-tbr-burger]');
    var mnav = root.querySelector('[data-tbr-mnav]');
    if (btn && mnav) {
      var set = function (open) {
        mnav.hidden = !open;
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      btn.addEventListener('click', function () { set(mnav.hidden); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !mnav.hidden) { set(false); btn.focus(); }
      });
      document.addEventListener('click', function (e) {
        if (!mnav.hidden && !root.contains(e.target)) set(false);
      });
    }

    /* ---------- cart count: refresh on back/forward and on cart events ---------- */
    var count = root.querySelector('[data-tbr-count]');
    var cartUrl = root.getAttribute('data-cart-url') || '/cart.js';
    function refresh() {
      if (!count) return;
      fetch(cartUrl, { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (c) {
          count.textContent = c.item_count;
          count.hidden = c.item_count === 0;
        })
        .catch(function () {});
    }
    window.addEventListener('pageshow', function (e) { if (e.persisted) refresh(); });
    document.addEventListener('cart:update', refresh);
    document.addEventListener('tbr:cart', refresh);
  }

  function boot() { document.querySelectorAll('.tbr-hdr-sec').forEach(init); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  document.addEventListener('shopify:section:load', boot);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Black Reaper header",
  "class": "tbr-hdr-wrap",
  "settings": [
    { "type": "header", "content": "Wordmark" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "THE BLACK REAPER", "info": "The last word is set in gold. Not tied to the shop name." },
    { "type": "link_list", "id": "link_list", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "note", "label": "Right-side note", "default": "Free US shipping · 30-day returns", "info": "Hidden on small screens." },

    { "type": "header", "content": "Announcement bar" },
    { "type": "checkbox", "id": "show_bar", "label": "Show the bar", "default": true },
    { "type": "paragraph", "content": "The cutoff should be set once in Theme settings (cutoff_iso, cutoff_label, cutoff_short). The fields below are only used when those are empty." },
    { "type": "text", "id": "cutoff_iso", "label": "Cutoff instant (ISO 8601 with offset) — fallback", "default": "2026-10-20T23:59:59-04:00", "info": "Real deadline. The countdown runs to this exact moment. Do not move it to make urgency." },
    { "type": "text", "id": "cutoff_label", "label": "Cutoff, as words — fallback", "default": "Tuesday, October 20" },
    { "type": "text", "id": "cutoff_short", "label": "Cutoff, short (mobile) — fallback", "default": "Oct 20" },
    { "type": "text", "id": "bar_after", "label": "Text after the cutoff", "default": "Halloween delivery cutoff has passed — still shipping in 24h" }
  ]
}
{% endschema %}
