{%- liquid
  assign s = section.settings
  assign reaper = all_products['the-black-reaper']
  assign projector = all_products['the-haunted-projector']
  assign swing = all_products['the-lighted-ghost-swing']
  assign coll = collections['halloween-2026']
  assign handle = product.handle
  assign design = request.design_mode
  assign fill_open = '<span class="tbr-fill">[ '
  assign fill_close = ' ]</span>'

  comment
    Cutoff. Real deadline. past_cutoff is computed exactly as tbr-product.liquid does it.
  endcomment
  assign cutoff_ts = s.cutoff_iso | date: '%s' | plus: 0
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign past_cutoff = false
  if cutoff_ts > 0 and now_ts > cutoff_ts
    assign past_cutoff = true
  endif
  assign cutoff = s.cutoff_label | default: 'Tuesday, October 20'

  comment
    Per-product defaults. One template serves all three products, so nothing
    Reaper-specific may live in the schema defaults. Anything left blank in the
    editor falls back to the copy for the product being viewed. A product that
    is none of the three gets no strip and no how-it-works copy.
  endcomment
  assign d_strip = ''
  assign d_how_eyebrow = ''
  assign d_how_heading = ''
  assign d_how_text = ''
  assign d_react_eyebrow = ''
  assign d_react_heading = ''
  assign d_react_text = ''
  assign d_deal_eyebrow = ''
  assign d_deal_heading = ''
  assign d_deal_text = ''
  assign d_deal_button = ''
  assign d_box_sub = ''
  assign d_box_foot = ''
  assign d_spec_a = product.title
  assign d_spec_b = ''
  assign d_faq_cap = ''

  case handle
  when 'the-black-reaper'
    assign d_strip = "4 minutes to set up|Push the stake in the ground. That's it.||Charges itself|Sun by day, lights at dusk, off by morning.||Silent|No motor, no speaker, nothing to fail.||Built for outdoors|Rated [ IP RATING ] for autumn weather."
    assign d_how_eyebrow = 'Setup'
    assign d_how_heading = "Stake it in. That's the whole setup."
    assign d_how_text = 'No outlet, no extension cord, no timer to program, no tools.'
    assign d_react_eyebrow = 'See it running'
    assign d_react_heading = 'The neighbors are going to lose it.'
    assign d_react_text = 'Real footage from real yards. Nothing here is a render and nothing is enhanced. What you see is what shows up on your lawn.'
    assign d_deal_eyebrow = 'The Halloween Special'
    assign d_deal_heading = 'Souls on the lawn.|Shadows on the house.'
    assign d_deal_text = 'The reapers own the ground. The projector takes the wall. Together the whole property is the decoration, not one object in the middle of it.'
    assign d_deal_button = 'Get the bundle'
    assign d_box_sub = 'Per reaper. The bundle adds the projector kit.'
    assign d_box_foot = "No batteries, no adapter, no app. The reaper is solar and needs nothing you don't already have in the yard."
    assign d_spec_a = 'The Black Reaper'
    assign d_spec_b = 'Haunted Projector, bundle only'
    assign d_faq_cap = 'Setup, start to finish. Unedited, one take, from box to lit. If you only watch one thing on this page, watch this.'
  when 'the-haunted-projector'
    assign d_strip = 'Under a minute|Place it, plug it in, pick a scene.||Auto-focus|No focus wheel to fight with in the dark.||Covers a whole facade|[ IMAGE SIZE ] at [ DISTANCE ].||Needs an outlet|Mains powered, [ CABLE LENGTH ] cable.'
    assign d_how_eyebrow = 'Setup'
    assign d_how_heading = 'Three moves and the house is haunted.'
    assign d_how_text = 'The projector is the one thing here that does need power. Everything else about it is instant.'
    assign d_react_eyebrow = 'See it running'
    assign d_react_heading = 'It reads from the street.'
    assign d_react_text = "That's the whole test for a projector. If it washes out at twenty feet it's a toy. Filmed from the sidewalk, no enhancement."
    assign d_deal_eyebrow = 'The Halloween Special'
    assign d_deal_heading = 'The house and the lawn,|not one or the other.'
    assign d_deal_text = "The projector owns the wall. The reapers own the ground. Run them together and there is no part of the property that isn't doing something."
    assign d_deal_button = 'Get the bundle'
    assign d_box_sub = 'Per projector.'
    assign d_spec_a = 'Haunted Projector'
    assign d_faq_cap = 'Porch to projection, one take. Unedited. This is the whole setup, in real time.'
  when 'the-lighted-ghost-swing'
    assign d_strip = 'About a minute|Loop the rope over a branch. Done.||110 cm tall|37 cm wide. Reads clearly from the sidewalk.||Lights from within|Ghost and pumpkin both glow. [ POWER: SOLAR / BATTERY ]||Light enough for a branch|[ WEIGHT ]'
    assign d_how_eyebrow = 'Setup'
    assign d_how_heading = "Find a branch. That's the hard part."
    assign d_how_text = 'No stake, no outlet, no tools. It weighs almost nothing.'
    assign d_react_eyebrow = 'See it running'
    assign d_react_heading = 'The soft one in a yard full of hard ones.'
    assign d_react_text = "Every yard needs one thing that isn't trying to scare a six-year-old. This is it, and it's the one people photograph."
    assign d_deal_eyebrow = 'Why people buy all three'
    assign d_deal_heading = 'Ground, air and the house.'
    assign d_deal_text = "The reapers hold the lawn. The swings fill the trees. The projector takes the wall. A yard with all three levels working doesn't look decorated. It looks staged."
    assign d_deal_button = 'See all three'
    assign d_box_sub = 'Per swing.'
    assign d_spec_a = 'Lighted Ghost Swing'
    assign d_faq_cap = 'Branch to lit, one take. Unedited.'
  endcase

  assign strip_defaults = d_strip | split: '||'
  assign how_eyebrow = s.how_eyebrow | default: d_how_eyebrow
  assign how_heading = s.how_heading | default: d_how_heading
  assign how_text = s.how_text | default: d_how_text
  assign react_eyebrow = s.react_eyebrow | default: d_react_eyebrow
  assign react_heading = s.react_heading | default: d_react_heading
  assign react_text = s.react_text | default: d_react_text
  assign deal_eyebrow = s.deal_eyebrow | default: d_deal_eyebrow
  assign deal_text = s.deal_text | default: d_deal_text
  assign deal_button = s.deal_button | default: d_deal_button
  assign box_sub = s.box_sub | default: d_box_sub
  assign box_foot = s.box_foot | default: d_box_foot
  assign spec_group_a = s.spec_group_a | default: d_spec_a
  assign spec_group_b = s.spec_group_b | default: d_spec_b
  assign faq_media_caption = s.faq_media_caption | default: d_faq_cap
  if s.deal_heading != blank
    assign deal_heading = s.deal_heading | newline_to_br
  else
    assign deal_heading = d_deal_heading | replace: '|', '<br>'
  endif

  comment
    Count the blocks that apply to this product, and whether any of them carries media.
    Blocks carry a shown_on setting: 'all' or a product handle.
  endcomment
  assign step_n = 0
  assign step_media = false
  assign react_n = 0
  assign react_media = false
  assign closeup_n = 0
  assign closeup_media = false
  assign box_n = 0
  assign review_n = 0
  assign faq_n = 0
  assign spec_n = 0
  assign spec_blank = false
  assign spec_has_a = false
  assign spec_has_b = false
  for block in section.blocks
    assign b = block.settings
    if b.shown_on != blank and b.shown_on != 'all' and b.shown_on != handle
      continue
    endif
    assign has_media = false
    if b.video != blank or b.video_url != blank or b.image != blank
      assign has_media = true
    endif
    case block.type
    when 'step'
      assign step_n = step_n | plus: 1
      if has_media
        assign step_media = true
      endif
    when 'reaction'
      assign react_n = react_n | plus: 1
      if has_media
        assign react_media = true
      endif
    when 'closeup'
      assign closeup_n = closeup_n | plus: 1
      if has_media
        assign closeup_media = true
      endif
    when 'box_item'
      assign box_n = box_n | plus: 1
    when 'review'
      assign review_n = review_n | plus: 1
    when 'faq'
      assign faq_n = faq_n | plus: 1
    when 'spec'
      assign spec_n = spec_n | plus: 1
      if b.value == blank
        assign spec_blank = true
      endif
      if b.group == 'projector'
        assign spec_has_b = true
      else
        assign spec_has_a = true
      endif
    endcase
  endfor

  assign faq_has_media = false
  if s.faq_video != blank or s.faq_video_url != blank or s.faq_image != blank
    assign faq_has_media = true
  endif

  comment
    The bundle variant is the only place the bundle saving exists. Link to it, not near it.
  endcomment
  assign bundle_variant = blank
  for v in reaper.variants
    if v.title contains 'Projector'
      assign bundle_variant = v
    endif
  endfor
  assign two_reapers = reaper.price_min | times: 2

  assign deal_select = blank
  if s.deal_url != blank
    assign deal_href = s.deal_url
  elsif handle == 'the-black-reaper'
    assign deal_href = '#tbr-product-form'
    if bundle_variant != blank
      assign deal_select = bundle_variant.id
    endif
  elsif handle == 'the-lighted-ghost-swing'
    assign deal_href = coll.url | default: '/collections/all'
  elsif bundle_variant != blank
    assign deal_href = reaper.url | append: '?variant=' | append: bundle_variant.id
  else
    assign deal_href = reaper.url
  endif
-%}

<div class="tbr tbr-pb">

  {%- comment -%} 1. Trust strip. Only renders for a product that has strip copy. {%- endcomment -%}
  {%- assign strip_count = 0 -%}
  {%- capture strip_html -%}
    {%- for i in (1..4) -%}
      {%- assign k_title = 'strip_' | append: i | append: '_title' -%}
      {%- assign k_text = 'strip_' | append: i | append: '_text' -%}
      {%- assign st_title = s[k_title] -%}
      {%- assign st_text = s[k_text] -%}
      {%- if st_title == blank -%}
        {%- assign pair = strip_defaults[forloop.index0] | split: '|' -%}
        {%- assign st_title = pair[0] -%}
        {%- assign st_text = pair[1] -%}
      {%- endif -%}
      {%- if st_title != blank -%}
        {%- assign strip_count = strip_count | plus: 1 -%}
        <div><b>{{ st_title }}</b>{{ st_text | replace: '[ ', fill_open | replace: ' ]', fill_close }}</div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if strip_count > 0 -%}
  <section class="tbr-strip">
    <div class="tbr-wrap tbr-strip__in">{{ strip_html }}</div>
  </section>
  {%- endif -%}

  {%- comment -%} 2. How it works. Steps keep their text; the media slot only shows with media, or in the editor. {%- endcomment -%}
  {%- if step_n > 0 -%}
  <section class="tbr-sec tbr-sec--alt" id="how">
    <div class="tbr-wrap">
      {%- if how_eyebrow != blank -%}<p class="tbr-eyebrow">{{ how_eyebrow }}</p>{%- endif -%}
      {%- if how_heading != blank -%}<h2 class="tbr-h2">{{ how_heading }}</h2>{%- endif -%}
      {%- if how_text != blank -%}<p class="tbr-lede tbr-lede--block">{{ how_text }}</p>{%- endif -%}
      <div class="tbr-steps">
        {%- assign step_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'step' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          {%- if b.shown_on != blank and b.shown_on != 'all' and b.shown_on != handle -%}{%- continue -%}{%- endif -%}
          {%- assign step_i = step_i | plus: 1 -%}
          {%- assign has_media = false -%}
          {%- if b.video != blank or b.video_url != blank or b.image != blank -%}{%- assign has_media = true -%}{%- endif -%}
          <article class="tbr-step" {{ block.shopify_attributes }}>
            {%- if has_media or design -%}
            <div class="tbr-slot tbr-slot--43{% unless has_media %} tbr-slot--empty{% endunless %}">
              {%- if b.video != blank -%}
                {{ b.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'tbr-slot__media' }}
              {%- elsif b.video_url != blank -%}
                {%- if b.video_url.type == 'youtube' -%}
                  <iframe class="tbr-slot__media" src="https://www.youtube.com/embed/{{ b.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ b.video_url.id }}&controls=0&playsinline=1&rel=0" title="{{ b.heading | escape }}" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                {%- else -%}
                  <iframe class="tbr-slot__media" src="https://player.vimeo.com/video/{{ b.video_url.id }}?autoplay=1&muted=1&loop=1&background=1" title="{{ b.heading | escape }}" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                {%- endif -%}
              {%- elsif b.image != blank -%}
                <img class="tbr-slot__media" src="{{ b.image | image_url: width: 1200 }}" alt="{{ b.image.alt | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy">
              {%- else -%}
                <span>{{ b.placeholder | default: 'Add a clip or photo' }}</span>
              {%- endif -%}
            </div>
            {%- endif -%}
            <span class="tbr-step__n">Step {{ step_i | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ b.heading }}</h3>
            <p>{{ b.text | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 3. See it running. Hidden on the storefront until at least one clip is real. {%- endcomment -%}
  {%- if react_media or design and react_n > 0 -%}
  <section class="tbr-sec" id="reactions">
    <div class="tbr-wrap">
      {%- if react_eyebrow != blank -%}<p class="tbr-eyebrow">{{ react_eyebrow }}</p>{%- endif -%}
      {%- if react_heading != blank -%}<h2 class="tbr-h2">{{ react_heading }}</h2>{%- endif -%}
      {%- if react_text != blank -%}<p class="tbr-lede tbr-lede--block">{{ react_text }}</p>{%- endif -%}
      <div class="tbr-react">
        {%- for block in section.blocks -%}
          {%- if block.type != 'reaction' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          {%- if b.shown_on != blank and b.shown_on != 'all' and b.shown_on != handle -%}{%- continue -%}{%- endif -%}
          {%- assign has_media = false -%}
          {%- if b.video != blank or b.video_url != blank or b.image != blank -%}{%- assign has_media = true -%}{%- endif -%}
          {%- if has_media == false and design == false -%}{%- continue -%}{%- endif -%}
          <figure class="tbr-react__item" {{ block.shopify_attributes }}>
            <div class="tbr-slot tbr-slot--916{% unless has_media %} tbr-slot--empty{% endunless %}">
              {%- if b.video != blank -%}
                {{ b.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'tbr-slot__media' }}
              {%- elsif b.video_url != blank -%}
                {%- if b.video_url.type == 'youtube' -%}
                  <iframe class="tbr-slot__media" src="https://www.youtube.com/embed/{{ b.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ b.video_url.id }}&controls=0&playsinline=1&rel=0" title="{{ b.caption | escape }}" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                {%- else -%}
                  <iframe class="tbr-slot__media" src="https://player.vimeo.com/video/{{ b.video_url.id }}?autoplay=1&muted=1&loop=1&background=1" title="{{ b.caption | escape }}" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                {%- endif -%}
              {%- elsif b.image != blank -%}
                <img class="tbr-slot__media" src="{{ b.image | image_url: width: 900 }}" alt="{{ b.image.alt | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy">
              {%- else -%}
                <span>{{ b.caption | default: 'Add a vertical clip' }}</span>
              {%- endif -%}
            </div>
            {%- if has_media and b.caption != blank -%}
              <figcaption>{{ b.caption }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 4. Bundle band. On the swing page it is a three-product band, not a bundle: no bundle exists for it. {%- endcomment -%}
  {%- if deal_button != blank -%}
  <section class="tbr-deal" id="bundle">
    {%- if s.deal_image != blank -%}
      <img class="tbr-deal__img" src="{{ s.deal_image | image_url: width: 2000 }}" alt="" width="{{ s.deal_image.width }}" height="{{ s.deal_image.height }}" loading="lazy">
    {%- elsif projector.featured_image -%}
      <img class="tbr-deal__img" src="{{ projector.featured_image | image_url: width: 2000 }}" alt="" width="2000" height="2000" loading="lazy">
    {%- endif -%}
    <div class="tbr-deal__shade"></div>
    <div class="tbr-wrap tbr-deal__in">
      <div class="tbr-deal__copy">
        {%- if deal_eyebrow != blank -%}<p class="tbr-eyebrow tbr-eyebrow--light">{{ deal_eyebrow }}</p>{%- endif -%}
        {%- if deal_heading != blank -%}<h2 class="tbr-h2 tbr-h2--light">{{ deal_heading }}</h2>{%- endif -%}
        {%- if deal_text != blank -%}<p class="tbr-deal__p">{{ deal_text }}</p>{%- endif -%}

        {%- if s.deal_show_prices -%}
          {%- if handle == 'the-lighted-ghost-swing' -%}
            <div class="tbr-deal__list">
              <div><span>Ground</span><span>{{ reaper.title }}</span><span>{{ reaper.price_min | money }}</span></div>
              <div><span>Air</span><span>{{ swing.title }}</span><span>{{ swing.price_min | money }}</span></div>
              <div><span>House</span><span>{{ projector.title }}</span><span>{{ projector.price_min | money }}</span></div>
            </div>
          {%- else -%}
            <div class="tbr-deal__list">
              <div><span>&times;2</span><span>{{ reaper.title }}, solar soul lantern</span><span>{{ two_reapers | money }}</span></div>
              <div><span>&times;1</span><span>{{ projector.title }}, plug-in, auto-focus</span><span>{{ projector.price_min | money }}</span></div>
            </div>
            {%- if bundle_variant != blank -%}
              <div class="tbr-deal__sum">
                <b>{{ bundle_variant.price | money }}</b>
                {%- if bundle_variant.compare_at_price > bundle_variant.price -%}
                  <s>{{ bundle_variant.compare_at_price | money }}</s>
                  <em>Save {{ bundle_variant.compare_at_price | minus: bundle_variant.price | money_without_trailing_zeros }}</em>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}

        {%- if s.deal_note != blank -%}<p class="tbr-deal__note">{{ s.deal_note }}</p>{%- endif -%}
        <a class="tbr-btn tbr-btn--accent" href="{{ deal_href }}"{% if deal_select != blank %} data-tbr-select="{{ deal_select }}"{% endif %}>{{ deal_button }}</a>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 5. Close-ups + What's in the box {%- endcomment -%}
  {%- assign show_closeups = false -%}
  {%- if closeup_media -%}{%- assign show_closeups = true -%}{%- endif -%}
  {%- if design and closeup_n > 0 -%}{%- assign show_closeups = true -%}{%- endif -%}
  {%- if show_closeups or box_n > 0 -%}
  <section class="tbr-sec" id="detail">
    <div class="tbr-wrap">
      <div class="tbr-head">
        <div>
          <p class="tbr-eyebrow">{{ s.detail_eyebrow }}</p>
          <h2 class="tbr-h2">{{ s.detail_heading }}</h2>
        </div>
        {%- if s.detail_text != blank -%}<p class="tbr-lede">{{ s.detail_text }}</p>{%- endif -%}
      </div>

      <div class="tbr-detail{% if box_n == 0 %} tbr-detail--solo{% endif %}{% unless show_closeups %} tbr-detail--boxonly{% endunless %}">
        {%- if show_closeups -%}
        <div class="tbr-closeups">
          {%- assign closeup_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'closeup' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            {%- if b.shown_on != blank and b.shown_on != 'all' and b.shown_on != handle -%}{%- continue -%}{%- endif -%}
            {%- if b.image == blank and design == false -%}{%- continue -%}{%- endif -%}
            {%- assign closeup_i = closeup_i | plus: 1 -%}
            <figure class="tbr-closeups__fig{% if closeup_i == 1 %} tbr-closeups__fig--wide{% endif %}" {{ block.shopify_attributes }}>
              <div class="tbr-slot{% if closeup_i == 1 %} tbr-slot--169{% else %} tbr-slot--11{% endif %}{% if b.image == blank %} tbr-slot--empty{% endif %}">
                {%- if b.image != blank -%}
                  <img class="tbr-slot__media" src="{{ b.image | image_url: width: 1400 }}" alt="{{ b.image.alt | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy">
                {%- else -%}
                  <span>{{ b.placeholder | default: 'Add a photo' }}</span>
                {%- endif -%}
              </div>
              {%- if b.title != blank or b.caption != blank -%}
                <figcaption>{%- if b.title != blank -%}<b>{{ b.title }}</b>{%- endif -%}{{ b.caption | replace: '[ ', fill_open | replace: ' ]', fill_close }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
        {%- endif -%}

        {%- if box_n > 0 -%}
        <aside class="tbr-box">
          <h3>{{ s.box_heading }}</h3>
          {%- if box_sub != blank -%}<p class="tbr-box__sub">{{ box_sub }}</p>{%- endif -%}
          <ul>
            {%- assign box_i = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type != 'box_item' -%}{%- continue -%}{%- endif -%}
              {%- assign b = block.settings -%}
              {%- if b.shown_on != blank and b.shown_on != 'all' and b.shown_on != handle -%}{%- continue -%}{%- endif -%}
              {%- assign box_i = box_i | plus: 1 -%}
              <li {{ block.shopify_attributes }}>
                <span class="tbr-box__n">{{ box_i | prepend: '0' | slice: -2, 2 }}</span>
                <span>{{ b.name }}{%- if b.note != blank -%}<small>{{ b.note | replace: '[ ', fill_open | replace: ' ]', fill_close }}</small>{%- endif -%}</span>
              </li>
            {%- endfor -%}
          </ul>
          {%- if box_foot != blank -%}<p class="tbr-box__foot">{{ box_foot }}</p>{%- endif -%}
        </aside>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 6. Reviews. Nothing renders unless real review blocks exist for this product. {%- endcomment -%}
  {%- if review_n > 0 -%}
  <section class="tbr-sec tbr-sec--alt" id="reviews">
    <div class="tbr-wrap">
      <div class="tbr-head">
        <div>
          <p class="tbr-eyebrow">{{ s.rev_eyebrow }}</p>
          <h2 class="tbr-h2">{{ s.rev_heading }}</h2>
        </div>
        {%- if s.rev_text != blank -%}<p class="tbr-lede">{{ s.rev_text }}</p>{%- endif -%}
      </div>
      <div class="tbr-rev">
        {%- for block in section.blocks -%}
          {%- if block.type != 'review' -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          {%- if b.shown_on != blank and b.shown_on != 'all' and b.shown_on != handle -%}{%- continue -%}{%- endif -%}
          {%- assign stars = b.stars | plus: 0 -%}
          <article class="tbr-rev__card" {{ block.shopify_attributes }}>
            {%- if b.photo != blank -%}
              <img class="tbr-rev__photo" src="{{ b.photo | image_url: width: 800 }}" alt="{{ b.photo.alt | escape }}" width="{{ b.photo.width }}" height="{{ b.photo.height }}" loading="lazy">
            {%- endif -%}
            <div class="tbr-rev__body">
              <span class="tbr-rev__stars" aria-label="{{ stars }} out of 5">
                {%- for i in (1..5) -%}<i{% if i <= stars %} class="on"{% endif %}></i>{%- endfor -%}
              </span>
              <p class="tbr-rev__text">{{ b.text }}</p>
              <p class="tbr-rev__who">
                <b>{{ b.name }}</b>
                {%- if b.place != blank -%}<span>{{ b.place }}</span>{%- endif -%}
                {%- if b.verified -%}<em>Verified order</em>{%- endif -%}
              </p>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 7. FAQ + UGC. The media column only exists once there is media, or in the editor. {%- endcomment -%}
  {%- if faq_n > 0 -%}
  {%- assign show_faq_media = false -%}
  {%- if faq_has_media or design -%}{%- assign show_faq_media = true -%}{%- endif -%}
  <section class="tbr-sec" id="faq">
    <div class="tbr-wrap">
      <p class="tbr-eyebrow">{{ s.faq_eyebrow }}</p>
      <h2 class="tbr-h2">{{ s.faq_heading }}</h2>

      <div class="tbr-faqgrid{% unless show_faq_media %} tbr-faqgrid--nomedia{% endunless %}">
        {%- if show_faq_media -%}
        <div class="tbr-faqgrid__media">
          <div class="tbr-slot tbr-slot--916{% unless faq_has_media %} tbr-slot--empty{% endunless %}">
            {%- if s.faq_video != blank -%}
              {{ s.faq_video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, class: 'tbr-slot__media' }}
            {%- elsif s.faq_video_url != blank -%}
              {%- if s.faq_video_url.type == 'youtube' -%}
                <iframe class="tbr-slot__media" src="https://www.youtube.com/embed/{{ s.faq_video_url.id }}?playsinline=1&rel=0" title="{{ s.faq_media_placeholder | escape }}" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen></iframe>
              {%- else -%}
                <iframe class="tbr-slot__media" src="https://player.vimeo.com/video/{{ s.faq_video_url.id }}" title="{{ s.faq_media_placeholder | escape }}" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen></iframe>
              {%- endif -%}
            {%- elsif s.faq_image != blank -%}
              <img class="tbr-slot__media" src="{{ s.faq_image | image_url: width: 900 }}" alt="{{ s.faq_image.alt | escape }}" width="{{ s.faq_image.width }}" height="{{ s.faq_image.height }}" loading="lazy">
            {%- else -%}
              <span>{{ s.faq_media_placeholder }}</span>
            {%- endif -%}
          </div>
          {%- if faq_has_media and faq_media_caption != blank -%}<p class="tbr-faqgrid__cap">{{ faq_media_caption }}</p>{%- endif -%}
        </div>
        {%- endif -%}

        <div class="tbr-faq">
          {%- assign faq_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'faq' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            {%- if b.shown_on != blank and b.shown_on != 'all' and b.shown_on != handle -%}{%- continue -%}{%- endif -%}
            {%- assign faq_i = faq_i | plus: 1 -%}
            {%- assign answer = b.answer -%}
            {%- if past_cutoff and answer contains '[[cutoff]]' -%}
              {%- assign answer = s.faq_after_cutoff -%}
            {%- endif -%}
            <details {% if faq_i == 1 %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ b.question }}<i></i></summary>
              <p>{{ answer | replace: '[[cutoff]]', cutoff | replace: '[ ', fill_open | replace: ' ]', fill_close }}</p>
            </details>
          {%- endfor -%}
        </div>
      </div>
      {%- if s.faq_link_label != blank -%}
        <a class="tbr-btn tbr-btn--dark" href="{{ s.faq_link | default: '/pages/faq' }}">{{ s.faq_link_label }}</a>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 8. Specs {%- endcomment -%}
  {%- if spec_n > 0 -%}
  <section class="tbr-sec tbr-sec--alt" id="specs">
    <div class="tbr-wrap">
      <p class="tbr-eyebrow">{{ s.spec_eyebrow }}</p>
      <h2 class="tbr-h2">{{ s.spec_heading }}</h2>
      {%- if spec_blank and s.spec_note != blank -%}<p class="tbr-spec__note">{{ s.spec_note }}</p>{%- endif -%}

      <div class="tbr-spec{% if spec_has_a == false or spec_has_b == false %} tbr-spec--solo{% endif %}">
        {%- if spec_has_a -%}
        <div>
          {%- if spec_group_a != blank -%}<p class="tbr-spec__h">{{ spec_group_a }}</p>{%- endif -%}
          <table class="tbr-spec__table"><tbody>
            {%- for block in section.blocks -%}
              {%- if block.type != 'spec' -%}{%- continue -%}{%- endif -%}
              {%- assign b = block.settings -%}
              {%- if b.shown_on != blank and b.shown_on != 'all' and b.shown_on != handle -%}{%- continue -%}{%- endif -%}
              {%- if b.group == 'projector' -%}{%- continue -%}{%- endif -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ b.label }}</th>
                <td>{%- if b.value != blank -%}{{ b.value | replace: '[ ', fill_open | replace: ' ]', fill_close }}{%- else -%}<span class="tbr-fill">[ FILL ]</span>{%- endif -%}</td>
              </tr>
            {%- endfor -%}
          </tbody></table>
        </div>
        {%- endif -%}

        {%- if spec_has_b -%}
        <div>
          {%- if spec_group_b != blank -%}<p class="tbr-spec__h">{{ spec_group_b }}</p>{%- endif -%}
          <table class="tbr-spec__table"><tbody>
            {%- for block in section.blocks -%}
              {%- if block.type != 'spec' -%}{%- continue -%}{%- endif -%}
              {%- assign b = block.settings -%}
              {%- if b.shown_on != blank and b.shown_on != 'all' and b.shown_on != handle -%}{%- continue -%}{%- endif -%}
              {%- if b.group != 'projector' -%}{%- continue -%}{%- endif -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ b.label }}</th>
                <td>{%- if b.value != blank -%}{{ b.value | replace: '[ ', fill_open | replace: ' ]', fill_close }}{%- else -%}<span class="tbr-fill">[ FILL ]</span>{%- endif -%}</td>
              </tr>
            {%- endfor -%}
          </tbody></table>
        </div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 9. Closer {%- endcomment -%}
  <section class="tbr-closer">
    {%- if s.closer_image != blank -%}
      <img class="tbr-closer__img" src="{{ s.closer_image | image_url: width: 2000 }}" alt="" width="{{ s.closer_image.width }}" height="{{ s.closer_image.height }}" loading="lazy">
    {%- elsif product.featured_image -%}
      <img class="tbr-closer__img" src="{{ product.featured_image | image_url: width: 2000 }}" alt="" width="2000" height="2000" loading="lazy">
    {%- endif -%}
    <div class="tbr-closer__shade"></div>
    <div class="tbr-wrap tbr-closer__in">
      <h2 class="tbr-h2 tbr-h2--light">{{ s.closer_heading }}</h2>
      <p>{{ s.closer_text }}</p>
      <a class="tbr-btn tbr-btn--accent" href="{{ s.closer_url | default: '#tbr-product-form' }}">{{ s.closer_button }}</a>
      {%- if past_cutoff -%}
        <small>{{ s.closer_note_after }}</small>
      {%- else -%}
        <small>{{ s.closer_note | replace: '[[cutoff]]', cutoff }}</small>
      {%- endif -%}
    </div>
  </section>

</div>

{% stylesheet %}
.tbr-pb .tbr-slot{position:relative;width:100%;overflow:hidden;border-radius:6px;background:var(--paper);display:grid;place-items:center;text-align:center;color:var(--dim);font-size:11px;line-height:1.7;letter-spacing:.05em;text-transform:uppercase;padding:0}
.tbr-pb .tbr-slot--empty{border:1px dashed #CFCAC2;padding:20px}
.tbr-pb .tbr-slot--empty span{max-width:26ch}
.tbr-pb .tbr-slot--43{aspect-ratio:4/3}
.tbr-pb .tbr-slot--916{aspect-ratio:9/16}
.tbr-pb .tbr-slot--169{aspect-ratio:16/9}
.tbr-pb .tbr-slot--11{aspect-ratio:1}
.tbr-pb .tbr-slot__media,.tbr-pb .tbr-slot video,.tbr-pb .tbr-slot iframe{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:0;display:block}
.tbr-pb .tbr-fill{color:var(--gold);border:1px dashed var(--gold);background:var(--paper);padding:1px 6px;border-radius:3px;font-size:.88em;font-weight:600;letter-spacing:.02em;white-space:nowrap}

.tbr-pb .tbr-step .tbr-slot{border-radius:5px}

.tbr-pb .tbr-react{display:grid;gap:12px;margin-top:34px;grid-template-columns:repeat(2,1fr)}
@media(min-width:760px){.tbr-pb .tbr-react{grid-template-columns:repeat(4,1fr)} }
.tbr-pb .tbr-react__item{margin:0;display:grid;gap:8px}
.tbr-pb .tbr-react__item figcaption{font-size:12.5px;color:var(--dim)}

.tbr-pb .tbr-deal__note{color:#96948E;font-size:13px;margin:-8px 0 22px}

.tbr-pb .tbr-detail{display:grid;gap:clamp(26px,4vw,48px);margin-top:36px;align-items:start}
@media(min-width:940px){.tbr-pb .tbr-detail{grid-template-columns:1.25fr .75fr}.tbr-pb .tbr-detail--solo{grid-template-columns:1fr}.tbr-pb .tbr-detail--boxonly{grid-template-columns:1fr;max-width:560px} }
.tbr-pb .tbr-detail--boxonly .tbr-box{position:static}
.tbr-pb .tbr-closeups{display:grid;gap:12px;grid-template-columns:repeat(2,1fr)}
.tbr-pb .tbr-closeups__fig{margin:0;display:grid;gap:8px}
.tbr-pb .tbr-closeups__fig--wide{grid-column:1 / -1}
.tbr-pb .tbr-closeups figcaption{font-size:12.5px;color:var(--dim);line-height:1.5}
.tbr-pb .tbr-closeups figcaption b{display:block;color:var(--ink);font-weight:700;font-size:13.5px}

.tbr-pb .tbr-box{background:#fff;border:1px solid var(--rule);border-radius:10px;padding:24px;position:sticky;top:96px}
.tbr-pb .tbr-box h3{font-size:19px;margin:0 0 4px;letter-spacing:-.01em;font-weight:700}
.tbr-pb .tbr-box__sub{font-size:13px;color:var(--dim);margin:0 0 16px}
.tbr-pb .tbr-box ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--rule)}
.tbr-pb .tbr-box li{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:baseline;padding:12px 0;border-bottom:1px solid var(--rule);font-size:14.5px;font-weight:600}
.tbr-pb .tbr-box__n{font-size:12px;color:var(--gold);font-weight:700;letter-spacing:.06em}
.tbr-pb .tbr-box li small{display:block;color:var(--dim);font-size:12.5px;margin-top:2px;font-weight:400}
.tbr-pb .tbr-box__foot{margin:16px 0 0;font-size:12.5px;color:var(--dim);line-height:1.6}

.tbr-pb .tbr-rev{display:grid;gap:14px;margin-top:32px;grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}
.tbr-pb .tbr-rev__card{background:#fff;border:1px solid var(--rule);border-radius:10px;overflow:hidden;display:grid;align-content:start}
.tbr-pb .tbr-rev__photo{width:100%;aspect-ratio:4/3;object-fit:cover}
.tbr-pb .tbr-rev__body{padding:18px 20px 20px;display:grid;gap:10px}
.tbr-pb .tbr-rev__stars{display:inline-flex;gap:3px}
.tbr-pb .tbr-rev__stars i{width:14px;height:14px;background:var(--rule);clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}
.tbr-pb .tbr-rev__stars i.on{background:var(--ink)}
.tbr-pb .tbr-rev__text{margin:0;font-size:14.5px;color:var(--ink);line-height:1.55}
.tbr-pb .tbr-rev__who{margin:0;font-size:12.5px;color:var(--dim);display:flex;flex-wrap:wrap;gap:6px 10px;align-items:baseline}
.tbr-pb .tbr-rev__who b{color:var(--ink)}
.tbr-pb .tbr-rev__who em{font-style:normal;font-weight:700;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--gold)}

.tbr-pb .tbr-faqgrid{display:grid;gap:clamp(24px,4vw,44px);margin-top:36px;align-items:start}
@media(min-width:940px){.tbr-pb .tbr-faqgrid{grid-template-columns:minmax(260px,.68fr) 1.32fr}.tbr-pb .tbr-faqgrid--nomedia{grid-template-columns:1fr}.tbr-pb .tbr-faqgrid__media{position:sticky;top:96px} }
.tbr-pb .tbr-faqgrid__media{display:grid;gap:12px}
.tbr-pb .tbr-faqgrid__media .tbr-slot{border-radius:10px}
.tbr-pb .tbr-faqgrid__cap{margin:0;font-size:13.5px;color:var(--dim);line-height:1.55}
.tbr-pb .tbr-faqgrid__cap b{color:var(--ink)}
.tbr-pb .tbr-faqgrid .tbr-faq{margin-top:0}

.tbr-pb .tbr-spec__note{margin:14px 0 0;font-size:12.5px;color:var(--gold);font-weight:600}
.tbr-pb .tbr-spec{display:grid;gap:26px;margin-top:30px}
@media(min-width:900px){.tbr-pb .tbr-spec{grid-template-columns:1fr 1fr;align-items:start}.tbr-pb .tbr-spec--solo{grid-template-columns:1fr;max-width:680px} }
.tbr-pb .tbr-spec__h{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);margin:0 0 10px;font-weight:700}
.tbr-pb .tbr-spec__table{width:100%;border-collapse:separate;border-spacing:0;background:#fff;border:1px solid var(--rule);border-radius:8px;overflow:hidden}
.tbr-pb .tbr-spec__table tr+tr th,.tbr-pb .tbr-spec__table tr+tr td{border-top:1px solid var(--rule)}
.tbr-pb .tbr-spec__table th{text-align:left;font-weight:500;font-size:13.5px;color:var(--dim);padding:13px 16px;width:46%;vertical-align:top;background:var(--paper)}
.tbr-pb .tbr-spec__table td{padding:13px 16px;font-size:14px;color:var(--ink)}

.tbr-pb .tbr-closer__in{position:relative}
{% endstylesheet %}

{% javascript %}
/* "Get the bundle" on the Reaper page: jump to the buy box AND pick the bundle tier.
   The tier radios in tbr-product listen for 'change', so firing it re-renders the box. */
document.addEventListener('click', function (e) {
  var a = e.target.closest ? e.target.closest('[data-tbr-select]') : null;
  if (!a) return;
  var id = a.getAttribute('data-tbr-select');
  var r = document.querySelector('[data-tbr-tier][value="' + id + '"]');
  if (r && !r.disabled && !r.checked) {
    r.checked = true;
    r.dispatchEvent(new Event('change', { bubbles: true }));
  }
});
{% endjavascript %}

