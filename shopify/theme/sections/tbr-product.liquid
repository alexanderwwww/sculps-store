{% schema %}
{
  "name": "Black Reaper product",
  "tag": "section",
  "class": "tbr-product-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Shipping cutoff" },
    { "type": "text", "id": "cutoff_iso", "label": "Cutoff instant (ISO 8601 with offset)", "default": "2026-10-20T23:59:59-04:00", "info": "Real deadline. The countdown runs to this exact moment. Do not move it to make urgency." },
    { "type": "text", "id": "cutoff_label", "label": "Cutoff, as words", "default": "Tuesday, October 20" },
    { "type": "header", "content": "Delivery window" },
    { "type": "checkbox", "id": "show_eta", "label": "Show delivery window", "default": false, "info": "Only tick once the carrier has given you transit times. The row hides itself after the cutoff, when the window runs past Oct 31, and on sold-out options." },
    { "type": "text", "id": "eta_min_days", "label": "Fastest transit, days", "info": "Confirm with the carrier. Whole number." },
    { "type": "text", "id": "eta_max_days", "label": "Slowest transit, days", "info": "Confirm with the carrier. Whole number." },
    { "type": "header", "content": "Copy" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle fallback", "info": "Used only when the product has no custom.subtitle metafield. Leave blank to use the first paragraph of the description." },
    { "type": "text", "id": "pick_label", "label": "Options label", "default": "Choose your setup" },
    { "type": "text", "id": "flag_2", "label": "Flag on the 2nd option", "default": "Our pick", "info": "An opinion, not a statistic. No 'most popular' or 'bestseller' until there is order data to back it." },
    { "type": "text", "id": "flag_3", "label": "Flag on the 3rd option", "info": "Leave blank. The Halloween Special ribbon and the Save pill already do the job." },
    { "type": "text", "id": "stock_text", "label": "Stock line", "default": "In stock", "info": "Keep this to In stock. Do not type quantities or urgency; availability comes from Shopify." },
    { "type": "text", "id": "ships_text", "label": "Dispatch line", "default": "Ships within 24 hours" },
    { "type": "text", "id": "free_text", "label": "Shipping line", "default": "Free US shipping" },
    { "type": "checkbox", "id": "real_footage_confirmed", "label": "Show the 'Real footage only' row", "default": false, "info": "Tick only when every image and clip on the page is an unedited photo or video of the shipped unit." },
    { "type": "header", "content": "Add-ons: one line each" },
    { "type": "text", "id": "why_reaper", "label": "Why add the Reaper", "default": "One more figure. The streams cross." },
    { "type": "text", "id": "why_projector", "label": "Why add the Projector", "default": "Takes the house while the reapers take the lawn." },
    { "type": "text", "id": "why_swing", "label": "Why add the Ghost Swing", "default": "Hangs from a branch. Fills the empty half of the yard." }
  ],
  "blocks": [
    {
      "type": "included",
      "name": "You get (per variant)",
      "settings": [
        { "type": "select", "id": "position", "label": "Variant position", "default": "1", "options": [
          { "value": "1", "label": "1st variant" },
          { "value": "2", "label": "2nd variant" },
          { "value": "3", "label": "3rd variant" }
        ] },
        { "type": "product", "id": "only_for", "label": "Only for this product", "info": "Leave empty to apply to every product using this template." },
        { "type": "text", "id": "hint", "label": "Short hint under the title", "info": "The per-unit price is added in front automatically for multi-packs." },
        { "type": "text", "id": "text", "label": "You get", "info": "Separate items with a middle dot. Unknown values in [ BRACKETS ] are highlighted as placeholders." }
      ]
    },
    {
      "type": "assurance",
      "name": "Assurance row",
      "settings": [
        { "type": "product", "id": "only_for", "label": "Only for this product" },
        { "type": "text", "id": "title", "label": "Bold lead", "default": "30-day returns." },
        { "type": "text", "id": "text", "label": "Text", "default": "Doesn't look how you hoped? Send it back, we refund it." }
      ]
    }
  ],
  "presets": [{ "name": "Black Reaper product" }]
}
