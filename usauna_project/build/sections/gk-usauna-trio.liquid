<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  #shopify-section-{{ section.id }} .s { font-family:'Inter',sans-serif; background:{{ section.settings.bg }}; padding:clamp(30px,4.2vw,58px) clamp(16px,3vw,44px); }
  #shopify-section-{{ section.id }} .wrap { max-width:1200px; margin:0 auto; }
  #shopify-section-{{ section.id }} .head { text-align:center; margin-bottom:clamp(24px,3vw,40px); }
  #shopify-section-{{ section.id }} .eyebrow { font-size:12.5px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#7c4e22; }
  #shopify-section-{{ section.id }} h2 { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.03em; font-size:clamp(1.6rem,3.6vw,2.6rem); line-height:1.05; margin:8px 0 6px; color:#111315; }
  #shopify-section-{{ section.id }} .sub { font-size:14.5px; color:#5B6470; margin:0 auto; max-width:56ch; }
  #shopify-section-{{ section.id }} .g { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(12px,1.8vw,22px); }
  @media (max-width:820px){ #shopify-section-{{ section.id }} .g { grid-template-columns:1fr; max-width:480px; margin:0 auto; } }
  #shopify-section-{{ section.id }} .card { background:#fff; border:1px solid rgba(17,19,21,0.06); border-radius:26px; overflow:hidden; box-shadow:0 2px 4px rgba(74,58,32,0.04), 0 16px 40px rgba(74,58,32,0.08); display:flex; flex-direction:column; }
  #shopify-section-{{ section.id }} .card .im { position:relative; aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; }
  #shopify-section-{{ section.id }} .card.c1 .im { background:linear-gradient(165deg,#f7efe2,#eaddc6); }
  #shopify-section-{{ section.id }} .card.c2 .im { background:linear-gradient(165deg,#e9f2f6,#d3e5ee); }
  #shopify-section-{{ section.id }} .card.c3 .im { background:linear-gradient(165deg,#f6ebe8,#ecd7d2); }
  #shopify-section-{{ section.id }} .card .im svg { width:62%; height:auto; display:block; }
  #shopify-section-{{ section.id }} .tx { padding:clamp(18px,2.2vw,26px); display:flex; flex-direction:column; gap:8px; flex:1; }
  #shopify-section-{{ section.id }} .tx .t { font-family:'General Sans',sans-serif; font-weight:700; text-transform:lowercase; letter-spacing:-0.02em; font-size:21px; color:#111315; }
  #shopify-section-{{ section.id }} .tx .tag { font-size:11.5px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#7c4e22; }
  #shopify-section-{{ section.id }} .tx .d { font-size:14.5px; color:#5B6470; line-height:1.55; }
  #shopify-section-{{ section.id }} .tx ul { list-style:none; margin:4px 0 0; padding:0; }
  #shopify-section-{{ section.id }} .tx ul li { font-size:13.5px; color:#3d4750; padding:4px 0 4px 20px; position:relative; }
  #shopify-section-{{ section.id }} .tx ul li::before { content:"✓"; position:absolute; left:0; color:#1F7A55; font-weight:700; }
  #shopify-section-{{ section.id }} .pr { margin-top:auto; padding-top:12px; font-size:15.5px; font-weight:700; color:#111315; }
  #shopify-section-{{ section.id }} .pr small { display:block; font-weight:400; color:#5B6470; font-size:12.5px; margin-top:2px; }
</style>
<div class="s">
  <div class="wrap">
    <div class="head">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}<p class="sub">{{ section.settings.subtext }}</p>{%- endif -%}
    </div>
    <div class="g">
      <div class="card c1">
        <div class="im">
          <svg viewBox="0 0 330 300" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="165" cy="286" rx="140" ry="10" fill="#000" opacity=".08"/>
            <rect x="35" y="20" width="260" height="264" rx="14" fill="#2b2620"/>
            <rect x="43" y="28" width="244" height="248" rx="9" fill="#3a332a"/>
            <rect x="52" y="36" width="60" height="232" fill="#b98a4e"/>
            <rect x="218" y="36" width="60" height="232" fill="#b98a4e"/>
            <g stroke="#2b2620" stroke-width="1" opacity=".3">
              <line x1="52" y1="76" x2="112" y2="76"/><line x1="52" y1="116" x2="112" y2="116"/><line x1="52" y1="156" x2="112" y2="156"/><line x1="52" y1="196" x2="112" y2="196"/><line x1="52" y1="236" x2="112" y2="236"/>
              <line x1="218" y1="76" x2="278" y2="76"/><line x1="218" y1="116" x2="278" y2="116"/><line x1="218" y1="156" x2="278" y2="156"/><line x1="218" y1="196" x2="278" y2="196"/><line x1="218" y1="236" x2="278" y2="236"/>
            </g>
            <rect x="118" y="36" width="94" height="232" rx="4" fill="#171310"/>
            <rect x="124" y="42" width="82" height="220" rx="3" fill="#2c2418"/>
            <ellipse cx="165" cy="118" rx="44" ry="50" fill="#ffd9a0" opacity=".6"/>
            <rect x="128" y="150" width="74" height="68" rx="4" fill="#c58a45"/>
            <rect x="196" y="140" width="5" height="32" rx="2.5" fill="#e8e2d4"/>
          </svg>
        </div>
        <div class="tx">
          <div class="t">{{ section.settings.t1 | default: 'the sauna' }}</div>
          <div class="tag">{{ section.settings.g1 | default: 'canadian red cedar' }}</div>
          <div class="d">{{ section.settings.d1 | default: 'a deep, full-spectrum heat that loosens tight muscles and melts the day off your shoulders.' }}</div>
          <ul><li>seats 2 people</li><li>traditional heater, plug-in</li><li>assembles in an afternoon</li></ul>
          <div class="pr">{{ section.settings.p1 | default: '$3,499' }} <small>{{ section.settings.pm1 | default: 'or $97/mo. at 0% apr' }}</small></div>
        </div>
      </div>
      <div class="card c2">
        <div class="im">
          <svg viewBox="0 0 240 190" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="120" cy="178" rx="100" ry="8" fill="#000" opacity=".07"/>
            <rect x="20" y="58" width="200" height="112" rx="20" fill="#8a5c2c"/>
            <rect x="26" y="64" width="188" height="100" rx="16" fill="#a9773f"/>
            <g stroke="#8a5c2c" stroke-width="1.5" opacity=".5">
              <line x1="52" y1="66" x2="52" y2="162"/><line x1="80" y1="66" x2="80" y2="162"/><line x1="108" y1="66" x2="108" y2="162"/><line x1="136" y1="66" x2="136" y2="162"/><line x1="164" y1="66" x2="164" y2="162"/><line x1="192" y1="66" x2="192" y2="162"/>
            </g>
            <rect x="34" y="72" width="172" height="14" rx="7" fill="#c99a5e"/>
            <ellipse cx="120" cy="85" rx="82" ry="14" fill="#8FC6E8"/>
            <ellipse cx="120" cy="83" rx="82" ry="13" fill="#AEE0F7"/>
            <path d="M56 83 q16 -5 32 0 t32 0 t32 0 t32 0" stroke="#fff" stroke-width="2.5" fill="none" opacity=".8"/>
            <rect x="198" y="112" width="30" height="44" rx="7" fill="#d6cdb8"/>
            <rect x="203" y="118" width="20" height="5" rx="2.5" fill="#b3a98f"/>
            <rect x="203" y="127" width="20" height="5" rx="2.5" fill="#b3a98f"/>
          </svg>
        </div>
        <div class="tx">
          <div class="t">{{ section.settings.t2 | default: 'the cold plunge' }}</div>
          <div class="tag">{{ section.settings.g2 | default: 'insulated cedar tub + chiller' }}</div>
          <div class="d">{{ section.settings.d2 | default: 'sixty seconds that wake you up better than coffee. you set the temperature, you set the pace.' }}</div>
          <ul><li>1–2 person, cedar exterior</li><li>chiller: 37°f–104°f</li><li>filtration + easy drain</li></ul>
          <div class="pr">{{ section.settings.p2 | default: '$1,999' }} <small>{{ section.settings.pm2 | default: '$1,399 in the big three' }}</small></div>
        </div>
      </div>
      <div class="card c3">
        <div class="im">
          <svg viewBox="0 0 150 230" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="75" cy="220" rx="52" ry="7" fill="#000" opacity=".07"/>
            <rect x="70" y="150" width="10" height="62" rx="5" fill="#c7c0b4"/>
            <rect x="42" y="206" width="66" height="9" rx="4.5" fill="#d6cdb8"/>
            <rect x="30" y="10" width="90" height="150" rx="14" fill="#1d1d1f"/>
            <rect x="37" y="17" width="76" height="136" rx="9" fill="#2a080c"/>
            <g fill="#ff5a4e">
              <circle cx="53" cy="34" r="5"/><circle cx="75" cy="34" r="5"/><circle cx="97" cy="34" r="5"/>
              <circle cx="53" cy="58" r="5"/><circle cx="75" cy="58" r="5"/><circle cx="97" cy="58" r="5"/>
              <circle cx="53" cy="82" r="5"/><circle cx="75" cy="82" r="5"/><circle cx="97" cy="82" r="5"/>
              <circle cx="53" cy="106" r="5"/><circle cx="75" cy="106" r="5"/><circle cx="97" cy="106" r="5"/>
              <circle cx="53" cy="130" r="5"/><circle cx="75" cy="130" r="5"/><circle cx="97" cy="130" r="5"/>
            </g>
            <rect x="37" y="17" width="76" height="136" rx="9" fill="url(#url-glow-{{ section.id }})"/>
            <defs><radialGradient id="url-glow-{{ section.id }}" cx=".5" cy=".5" r=".7"><stop offset="0" stop-color="#ff6a5e" stop-opacity=".45"/><stop offset="1" stop-color="#ff6a5e" stop-opacity="0"/></radialGradient></defs>
          </svg>
        </div>
        <div class="tx">
          <div class="t">{{ section.settings.t3 | default: 'the red light' }}</div>
          <div class="tag">{{ section.settings.g3 | default: '660nm + 850nm full body' }}</div>
          <div class="d">{{ section.settings.d3 | default: 'the gentle wind-down that finishes every session — and turns a habit into the best part of your day.' }}</div>
          <ul><li>full-body panel + stand</li><li>red + near-infrared</li><li>timer &amp; adjustable angle</li></ul>
          <div class="pr">{{ section.settings.p3 | default: '$1,199' }} <small>{{ section.settings.pm3 | default: '$599 in the big three' }}</small></div>
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "USAUNA Trio",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "the ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "three tools. one ritual. fifteen minutes a day." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "used together, heat, cold, and light are how athletes, executives, and grandparents recover faster, sleep deeper, and keep doing what they love." },
    { "type": "text", "id": "t1", "label": "Card 1 title", "default": "the sauna" },
    { "type": "text", "id": "g1", "label": "Card 1 tag", "default": "canadian red cedar" },
    { "type": "textarea", "id": "d1", "label": "Card 1 body", "default": "a deep, full-spectrum heat that loosens tight muscles and melts the day off your shoulders." },
    { "type": "text", "id": "p1", "label": "Card 1 price", "default": "$3,499" },
    { "type": "text", "id": "pm1", "label": "Card 1 price note", "default": "or $97/mo. at 0% apr" },
    { "type": "text", "id": "t2", "label": "Card 2 title", "default": "the cold plunge" },
    { "type": "text", "id": "g2", "label": "Card 2 tag", "default": "insulated cedar tub + chiller" },
    { "type": "textarea", "id": "d2", "label": "Card 2 body", "default": "sixty seconds that wake you up better than coffee. you set the temperature, you set the pace." },
    { "type": "text", "id": "p2", "label": "Card 2 price", "default": "$1,999" },
    { "type": "text", "id": "pm2", "label": "Card 2 price note", "default": "$1,399 in the big three" },
    { "type": "text", "id": "t3", "label": "Card 3 title", "default": "the red light" },
    { "type": "text", "id": "g3", "label": "Card 3 tag", "default": "660nm + 850nm full body" },
    { "type": "textarea", "id": "d3", "label": "Card 3 body", "default": "the gentle wind-down that finishes every session — and turns a habit into the best part of your day." },
    { "type": "text", "id": "p3", "label": "Card 3 price", "default": "$1,199" },
    { "type": "text", "id": "pm3", "label": "Card 3 price note", "default": "$599 in the big three" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "USAUNA Trio" }]
}
{% endschema %}
