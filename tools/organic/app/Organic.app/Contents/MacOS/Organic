#!/bin/bash
# Organic — the launcher.
#
# Three jobs: make sure the Mac has what it needs (node, Chrome, the Command
# Line Tools), build the window once, then start the worker and hand the
# process over to the window. `exec` at the end is deliberate: the window
# keeps this process id, which is the one Launch Services started from the
# bundle, so the Dock shows the bundle's icon and Cmd-Q quits the right thing.
set -u

HERE="$(cd "$(dirname "$0")/../Resources" && pwd)"
APP_ROOT="$(cd "$HERE/../.." && pwd)"
SUPPORT="$HOME/Library/Application Support/Organic"
LOG="$SUPPORT/log/organic.log"
mkdir -p "$SUPPORT/chrome" "$SUPPORT/worker" "$SUPPORT/bin" "$SUPPORT/log"
# Every crew line lands in the log; kept to one generation past 8 MB.
if [ -f "$LOG" ] && [ "$(stat -f%z "$LOG" 2>/dev/null || echo 0)" -gt 8000000 ]; then mv -f "$LOG" "$LOG.1"; fi

# launchd's PATH has none of Homebrew in it. Every "node is not installed"
# alert the old app ever showed was this line missing.
export PATH="/opt/homebrew/bin:/usr/local/bin:/opt/homebrew/sbin:$PATH"

say() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }
alert() {
  say "ALERT: $1"
  /usr/bin/osascript -e 'on run argv' -e 'display alert "Organic" message (item 1 of argv)' -e 'end run' "$1" >/dev/null 2>&1
}

say "open — bundle at $APP_ROOT"

# --- what the Mac needs --------------------------------------------------
if ! command -v node >/dev/null 2>&1; then
  alert "Node is not installed. In Terminal: brew install node — then open Organic again."
  exit 1
fi
# Google Chrome is no longer needed for the work — the app has its own browser
# — but the fallback window (when Swift cannot build) is still a Chrome window,
# so this is where it is found rather than something to refuse to start over.
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Swift is how the native window gets built, once. It is not required to
# run: if it is missing or broken, the app still opens (see below).
SWIFTC="$(xcrun -f swiftc 2>/dev/null || true)"
[ -x "$SWIFTC" ] || SWIFTC=""

# --- the worker, installed beside itself ----------------------------------
# The bundle's build; a live push writes a higher one into worker/BUILD and
# this must never copy over it.
BUNDLE_BUILD=10
RUNTIME_BUILD=0
if [ -f "$SUPPORT/worker/BUILD" ]; then
  RUNTIME_BUILD="$(tr -dc '0-9' < "$SUPPORT/worker/BUILD")"
  RUNTIME_BUILD="${RUNTIME_BUILD:-0}"
fi
if [ "$RUNTIME_BUILD" -lt "$BUNDLE_BUILD" ] || [ ! -f "$SUPPORT/worker/main.mjs" ]; then
  cp -R "$HERE/worker/." "$SUPPORT/worker/"
  echo "$BUNDLE_BUILD" > "$SUPPORT/worker/BUILD"
  say "installed build $BUNDLE_BUILD from the bundle"
else
  say "running build $RUNTIME_BUILD"
fi

# The dependencies are installed by the worker's own runner, below, AFTER the
# window is up. It used to happen here, before anything was on screen: the
# Dock icon bounced with nothing to look at, and a slow npm made it bounce
# for a minute. Nothing Alex waits for happens without a window saying so.
needs_deps() {
  [ ! -f "$SUPPORT/worker/node_modules/playwright/package.json" ] || [ ! -f "$SUPPORT/worker/node_modules/ws/package.json" ]
}

# The watchdog: if this run never reaches the window, say why, once. A silent
# bouncing icon is the one failure that tells nobody anything.
rm -f "$SUPPORT/.window"
(
  sleep 75
  if [ ! -f "$SUPPORT/.window" ]; then
    /usr/bin/osascript -e 'on run argv' -e 'display alert "Organic" message (item 1 of argv)' -e 'end run' \
      "Still setting up after a minute. Last lines of the log: $(tail -4 "$LOG" | tr '\n' ' ')" >/dev/null 2>&1
  fi
) &
WATCHDOG=$!

# --- the window, built once ------------------------------------------------
# Keyed on the source, so a changed main.swift is rebuilt and an unchanged one
# never is.
SHELL_KEY="$(md5 -q "$HERE/Shell/main.swift" 2>/dev/null || md5sum "$HERE/Shell/main.swift" | cut -c1-32)"
SHELL_BIN="$SUPPORT/bin/OrganicShell-$SHELL_KEY"

# Where the macOS SDK is.
#
# `swiftc` on its own found no SDK on Alex's Mac and died with "unable to
# load standard library for target x86_64-apple-macosx15.0". With only the
# Command Line Tools installed — no Xcode — swiftc has to be TOLD which SDK
# to build against; and when xcode-select points at an Xcode that is not
# there, xcrun answers nothing at all. So: ask xcrun, then look where the
# Command Line Tools and Xcode each keep it.
find_sdk() {
  local sdk
  sdk="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)"
  [ -n "$sdk" ] && [ -d "$sdk" ] && { printf '%s' "$sdk"; return 0; }
  for candidate in \
    /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk \
    /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk; do
    [ -d "$candidate" ] && { printf '%s' "$candidate"; return 0; }
  done
  return 1
}

# Run something with a ceiling on it. macOS has no `timeout`, and a build
# step that hangs forever is what a bouncing Dock icon actually is.
run_bounded() {
  local secs="$1"; shift
  "$@" >> "$LOG" 2>&1 &
  local pid=$! waited=0
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1
    waited=$((waited + 1))
    if [ "$waited" -ge "$secs" ]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      say "gave up on: $1 (over ${secs}s)"
      return 124
    fi
  done
  wait "$pid"
}

build_window() {
  [ -n "$SWIFTC" ] || return 1
  local sdk arch
  sdk="$(find_sdk || true)"
  arch="$(uname -m)"
  # If xcode-select is pointing somewhere broken, the Command Line Tools are
  # still a complete developer dir on their own.
  if [ -z "$sdk" ] && [ -d /Library/Developer/CommandLineTools ]; then
    export DEVELOPER_DIR=/Library/Developer/CommandLineTools
    sdk="$(find_sdk || true)"
    SWIFTC="$(xcrun -f swiftc 2>/dev/null || printf '%s' "$SWIFTC")"
  fi
  # Most specific first, then looser. Each attempt says why it failed.
  if [ -n "$sdk" ]; then
    say "building the window (sdk $sdk, $arch)"
    run_bounded 60 "$SWIFTC" -O -sdk "$sdk" -target "$arch-apple-macosx12.0" \
      -framework Cocoa -framework WebKit -o "$SHELL_BIN" "$HERE/Shell/main.swift" && return 0
    run_bounded 60 "$SWIFTC" -O -sdk "$sdk" \
      -framework Cocoa -framework WebKit -o "$SHELL_BIN" "$HERE/Shell/main.swift" && return 0
  else
    say "building the window (no sdk found)"
  fi
  run_bounded 60 "$SWIFTC" -O -framework Cocoa -framework WebKit -o "$SHELL_BIN" "$HERE/Shell/main.swift" && return 0
  return 1
}

SHELL_STARTED="$(date +%s)"
if [ ! -x "$SHELL_BIN" ] && ! build_window; then
  rm -f "$SHELL_BIN"
  say "the native window could not be built — using the fallback window"
elif [ -x "$SHELL_BIN" ]; then
  say "the window is ready ($(( $(date +%s) - SHELL_STARTED ))s)"
fi

# --- run --------------------------------------------------------------------
PORT="$(node -e 'const s=require("net").createServer();s.listen(0,"127.0.0.1",()=>{console.log(s.address().port);s.close()})')"
export ORGANIC_PORT="$PORT"
export ORGANIC_PARENT_PID="$$"
export ORGANIC_HOME="$SUPPORT"
# The app brings its own browser now, so the download is the point rather
# than something to skip: Alex's own Chrome cannot be borrowed without macOS
# handing the launch to the copy he already has open.
export PLAYWRIGHT_BROWSERS_PATH="$SUPPORT/browser"

# The worker, restarted on 75 (it updated itself) and left alone otherwise.
# It watches the window's pid and exits when the window is gone.
#
# A pushed build that dies within its first half minute is put aside: the
# bundle's build is copied back, the bad number is written to worker/BAD so
# the worker never pulls it again, and the worker is started once more.
(
  cd "$SUPPORT/worker" || exit 1
  if needs_deps; then
    say "installing dependencies"
    say "this takes a minute the first time — it is fetching its own browser"
    if ! run_bounded 900 npm install --no-audit --no-fund; then
      /usr/bin/osascript -e 'on run argv' -e 'display alert "Organic" message (item 1 of argv)' -e 'end run' \
        "Could not install what the worker needs. Last lines of the log: $(tail -3 "$LOG" | tr '\n' ' ')" >/dev/null 2>&1
      exit 1
    fi
    say "dependencies installed"
  fi
  recovered=0
  while :; do
    started=$(date +%s)
    node main.mjs >> "$LOG" 2>&1
    code=$?
    if [ "$code" -eq 75 ]; then say "worker restarting on a new build"; continue; fi
    running="$(tr -dc '0-9' < "$SUPPORT/worker/BUILD" 2>/dev/null)"; running="${running:-0}"
    if [ "$code" -ne 0 ] && [ "$recovered" -eq 0 ] && [ "$running" -gt "$BUNDLE_BUILD" ] && [ $(( $(date +%s) - started )) -lt 30 ]; then
      recovered=1
      say "build $running died at start (code $code) — back to the bundled build $BUNDLE_BUILD"
      echo "$running" > "$SUPPORT/worker/BAD"
      cp -R "$HERE/worker/." "$SUPPORT/worker/"
      echo "$BUNDLE_BUILD" > "$SUPPORT/worker/BUILD"
      /usr/bin/osascript -e 'on run argv' -e 'display alert "Organic" message (item 1 of argv)' -e 'end run' \
        "Build $running would not start, so Organic is back on its bundled build. Tell Claude: the last push is bad." >/dev/null 2>&1
      continue
    fi
    if [ "$code" -ne 0 ] && kill -0 "$ORGANIC_PARENT_PID" 2>/dev/null; then
      /usr/bin/osascript -e 'on run argv' -e 'display alert "Organic" message (item 1 of argv)' -e 'end run' \
        "The worker stopped (code $code). Last lines of the log: $(tail -3 "$LOG" | tr '\n' ' ')" >/dev/null 2>&1
    fi
    break
  done
) &

say "window on http://127.0.0.1:$PORT/"
: > "$SUPPORT/.window"
kill "$WATCHDOG" 2>/dev/null || true

if [ -x "$SHELL_BIN" ]; then
  exec "$SHELL_BIN" "http://127.0.0.1:$PORT/" "$HERE/AppIcon.icns"
fi

# The fallback window.
#
# Swift could not build, and an app that will not open is worth nothing. So
# the window is a Chrome window in app mode instead: its own profile, no
# tabs, no address bar, nothing but our page. It is the same app behind it —
# the worker, the screens, the crew — drawn in a window that does not look
# like a browser. Said once, so Alex knows which window he is looking at and
# how to get the native one.
say "opening the fallback window"
/usr/bin/osascript -e 'on run argv' -e 'display alert "Organic" message (item 1 of argv)' -e 'end run' \
  "Opening in the fallback window: Apple's build tools could not build the native one. The app works the same. To get the native window, run this once in Terminal and open Organic again:   xcode-select --install" >/dev/null 2>&1 &
if [ ! -x "${ORGANIC_CHROME:-$CHROME}" ]; then
  alert "The window could not be built and Google Chrome is not installed to fall back to. In Terminal: xcode-select --install — then open Organic again."
  exit 1
fi
exec "${ORGANIC_CHROME:-$CHROME}" \
  --app="http://127.0.0.1:$PORT/" \
  --user-data-dir="$SUPPORT/window" \
  --window-size=1280,820 \
  --no-first-run --no-default-browser-check --disable-extensions \
  --disable-component-extensions-with-background-pages --disable-default-apps \
  --disable-sync --no-service-autorun --password-store=basic \
  --disable-search-engine-choice-screen
