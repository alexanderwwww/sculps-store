#!/bin/bash
#
# The launcher.
#
# Three jobs: check what is missing and say which thing rather than failing
# halfway, install the runtime beside itself on first launch, and restart the
# runner when it exits 75 — which is how a self-update lands without Alex
# downloading anything.

set -u
HERE="$(cd "$(dirname "$0")/../Resources" && pwd)"
HOME_DIR="$HOME/Library/Application Support/OrganicX"
RUNTIME="$HOME_DIR/runtime"
LOG="$HOME_DIR/organicx.log"

mkdir -p "$RUNTIME" "$HOME_DIR/scratch"

say() { printf '%s\n' "$1" | tee -a "$LOG"; }

# An alert rather than a silent exit: a double-clicked app that does nothing
# is indistinguishable from a broken one.
bail() {
  say "$1"
  # The text is handed to AppleScript as an argument, not spliced into the
  # script: a quote inside a log line used to break the script and the alert
  # silently never appeared — which is the one thing an alert must not do.
  /usr/bin/osascript -e 'on run argv' -e 'display alert "OrganicX" message (item 1 of argv)' -e 'end run' "$1" >/dev/null 2>&1
  exit 1
}

# --- where the tools actually are ---------------------------------------
#
# A double-clicked .app inherits launchd's PATH, which is
# /usr/bin:/bin:/usr/sbin:/sbin and nothing else. Homebrew is not on it. So
# node, ffmpeg and yt-dlp are all invisible to this script even though they
# are sitting right there and work fine in Terminal — and the honest-looking
# alert this used to print ("Node is not installed") was simply wrong.
#
# Apple Silicon puts Homebrew in /opt/homebrew, Intel in /usr/local, and a
# version manager puts node somewhere else again. Look in all of them.
export PATH="/opt/homebrew/bin:/usr/local/bin:/opt/homebrew/sbin:$PATH"
if command -v brew >/dev/null 2>&1; then
  export PATH="$(brew --prefix)/bin:$PATH"
fi
# nvm, fnm, volta and asdf each keep node somewhere of their own. Sourcing the
# login shell picks up whichever one is in use without guessing at it.
# Probed in a subshell, never sourced into this one. An rc file that touches
# an unset variable — $ZSH_VERSION, $PS1, most of oh-my-zsh — under this
# script's set -u aborted the whole launcher with nothing logged and no alert.
if ! command -v node >/dev/null 2>&1; then
  for rc in "$HOME/.zprofile" "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.profile"; do
    [ -f "$rc" ] || continue
    found=$(bash -c ". \"$rc\" >/dev/null 2>&1; command -v node" 2>/dev/null || true)
    if [ -n "$found" ]; then export PATH="$(dirname "$found"):$PATH"; break; fi
  done
fi
for guess in "$HOME/.volta/bin" "$HOME/.local/bin" "$HOME/n/bin"; do
  [ -d "$guess" ] && export PATH="$guess:$PATH"
done

# --- what has to be here -----------------------------------------------
command -v node >/dev/null 2>&1 || bail "Cannot find node. It may be installed but not on this app's PATH — open Terminal, run: which node — and send me what it prints."

# Built with a leading space and trimmed, so the line that comes out is one
# somebody can actually copy. The first cut printed "brew installffmpeg
# yt-dlp", which is a command that fails — an instruction that does not work
# when followed is worse than no instruction.
#
# ffmpeg and yt-dlp are NOT required to start.
#
# They are for pulling clips and cutting them, which is the third thing this
# app does. Connecting accounts and warming them — the part that has to start
# weeks before anything else — needs neither. Refusing to open over them meant
# the app would not run at all for a job it was perfectly capable of doing,
# which is the wrong trade by a mile.
#
# So it says what is missing, writes it down, and opens. The pieces that
# genuinely need them check for them at the point of use.
MISSING=""
command -v ffmpeg >/dev/null 2>&1 || MISSING="$MISSING ffmpeg"
command -v yt-dlp >/dev/null 2>&1 || MISSING="$MISSING yt-dlp"
MISSING="${MISSING# }"
export OX_MISSING_TOOLS="$MISSING"
if [ -n "$MISSING" ]; then
  say "Not installed: $MISSING — connecting and warming work without them."
  say "PATH searched: $PATH"
  say "brew: $(command -v brew || echo 'not found')"
fi

# What was actually found, so a wrong answer is debuggable rather than a
# mystery. This goes in the log every launch.
say "node $(node --version 2>/dev/null) at $(command -v node)"
for tool in ffmpeg yt-dlp; do
  where=$(command -v "$tool" 2>/dev/null)
  [ -n "$where" ] && say "$tool at $where"
done

if [ -z "${OX_CHROME:-}" ] && [ ! -d "/Applications/Google Chrome.app" ]; then
  bail "Google Chrome is not in /Applications. Install it, or set OX_CHROME to where it is."
fi

# There used to be a DATABASE_URL check here, and a .env file to put it in.
# Both are gone: the app's memory is reached through the control plane, which
# holds the credential. A Mac app that drives a browser has no business
# holding a database password, and "put this file here" is a step somebody
# gets wrong — it was the last thing stopping this from opening.

# --- first launch installs the runtime beside itself --------------------
# Committing to the repo alone and calling it shipped is false: the .app runs
# what is in Application Support, not what is in the checkout. The wand cost a
# day to exactly that.
# The bundle's own build number. A live push writes a higher one into
# $RUNTIME/BUILD, and this must not copy over it — otherwise the next restart
# silently undoes the fix that was just shipped, which is the worst kind of
# bug: it works, then it does not, and nothing changed.
BUNDLE_BUILD=9
RUNTIME_BUILD=0
if [ -f "$RUNTIME/BUILD" ]; then
  RUNTIME_BUILD=$(tr -dc '0-9' < "$RUNTIME/BUILD" 2>/dev/null)
  RUNTIME_BUILD=${RUNTIME_BUILD:-0}
fi

if [ "$RUNTIME_BUILD" -lt "$BUNDLE_BUILD" ] || [ ! -f "$RUNTIME/ox.mjs" ]; then
  # Everything in Resources, not a list somebody has to remember to update.
  #
  # The list was human.mjs score.mjs browser.mjs db.mjs ox.mjs research.mjs
  # package.json — and it had fallen two files behind. panel.mjs and
  # skills.mjs were never copied, so a clean install died on
  # "Cannot find module './panel.mjs'" before it drew anything. A list of
  # filenames maintained by hand drifts the moment a file is added, and the
  # failure lands on whoever installs next rather than whoever forgot.
  for f in "$HERE"/*.mjs "$HERE"/package.json; do
    [ -f "$f" ] && cp "$f" "$RUNTIME/$(basename "$f")"
  done
  echo "$BUNDLE_BUILD" > "$RUNTIME/BUILD"
  say "Installed build $BUNDLE_BUILD from the bundle."

  # The Dock keeps drawing the icon it cached for the previous copy of this
  # app, keyed on bundle id and version, and it does not look again on its
  # own. Once per new bundle: re-register this bundle with Launch Services,
  # bump the folder's mtime so Finder re-reads it, and restart the Dock so
  # it draws the icon that is actually in Resources. Nothing else on the
  # machine is touched, and it only runs the first time a build opens.
  APP_ROOT="$(cd "$HERE/../.." && pwd)"
  LSREG=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
  [ -x "$LSREG" ] && "$LSREG" -f "$APP_ROOT" >/dev/null 2>&1 || true
  touch "$APP_ROOT" "$APP_ROOT/Contents/Info.plist" 2>/dev/null || true
  rm -rf "$HOME/Library/Caches/com.apple.iconservices.store" 2>/dev/null || true
  killall Dock 2>/dev/null || true
else
  say "Running build $RUNTIME_BUILD (shipped without a download)."
fi

cd "$RUNTIME" || bail "Could not open $RUNTIME"
# Playwright would otherwise download its own copies of Chromium, Firefox and
# WebKit — several hundred megabytes on a first launch, all of it wasted,
# because this drives the real Chrome over a debugging port and never starts a
# bundled browser.
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
export PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1

# Gated on the one package that matters being actually present, not on the
# folder existing. A network drop mid-install left a half-empty node_modules
# that passed the old check, and every launch after that died on "Cannot
# find package 'playwright'" — silently.
if [ ! -f node_modules/playwright/package.json ]; then
  say "First launch — fetching what it needs. A minute or so."
  if ! npm install --omit=dev --no-audit --no-fund >>"$LOG" 2>&1; then
    bail "Could not fetch what it needs. The last lines of $LOG say why: $(tail -3 "$LOG" | tr '\n' ' ')"
  fi
  say "Ready."
fi

# --- run, and restart on a self-update ----------------------------------
while true; do
  node ox.mjs >>"$LOG" 2>&1
  code=$?
  if [ $code -eq 75 ]; then
    say "New build installed. Restarting."
    continue
  fi
  # Any other exit is a crash, and a crash has to be seen. Exiting quietly
  # here was the exact "double-clicked, nothing happened" this launcher's
  # header says it exists to prevent.
  if [ $code -ne 0 ]; then
    bail "OrganicX stopped (code $code). Last lines of the log: $(tail -3 "$LOG" | tr '\n' ' ')"
  fi
  exit 0
done
