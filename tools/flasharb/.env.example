# flasharb settings. Copy to .env and change what you need. PUBLIC address only, never a private key.
WALLET_PUBKEY=25x7yeU4DnQdYKWENjCMzSY24oq38zxJXrFEtmKfVX6s
RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_API_KEY=            # optional; lite-api works without one (about 100 requests/minute)
JUPITER_RATE_PER_MIN=90

# Sizes (USDC). TRADE_SIZE_USDC is the headline and the size `npm run simulate` builds.
TRADE_SIZE_USDC=100000
COMPARE_SIZES_USDC=1000,10000,1000000

# Tokens are discovered live from Jupiter's verified list. PAIRS narrows to symbols/mints (empty = all that pass).
PAIRS=
MIN_TOKEN_LIQUIDITY_USD=5000000
MAX_TOKENS=10
# lst = staked-SOL tokens: they trade against SOL, not USDC (measured: their single-DEX USDC legs had no route)
EXCLUDE_TAGS=jup-lend-earn,yb,lst
ALLOW_TOKEN_2022=false

# DEXes are discovered live per token. Set DEXES (Jupiter labels) to pin a list instead.
DEXES=
MAX_DEXES_PER_TOKEN=8

SLIPPAGE_BPS=10
MAX_ACCOUNTS_PER_SWAP=24
VERIFY_TOP_K=3
MIN_NET_PROFIT_USDC=0
COMPUTE_UNIT_LIMIT=600000
COMPUTE_UNIT_PRICE_MICROLAMPORTS=50000
SCAN_INTERVAL_MS=15000
