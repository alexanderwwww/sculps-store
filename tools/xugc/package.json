{
  "name": "xugc",
  "productName": "XUGC",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Your own UGC video studio: product + avatar + script, made on rented GPUs you control.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.mjs && node test/app.test.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "us.blackreaper.xugc",
    "productName": "XUGC",
    "files": ["main.js", "preload.js", "engine.js", "store.js", "renderer/**", "assets/**"],
    "mac": {
      "category": "public.app-category.video",
      "icon": "assets/AppIcon.icns",
      "target": [{ "target": "dir", "arch": ["x64"] }]
    }
  }
}
