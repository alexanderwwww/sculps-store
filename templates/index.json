        "q2": {
          "type": "qa",
          "settings": {
            "q": "How much torque?",
            "a": "980 Nm at the rear wheel, with 82 hp peak. There is no gearbox between the motor and the road, so all of it arrives the moment you touch the throttle."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "What does it weigh?",
            "a": "104 kg, all in. A single-piece cast frame carries the pack, so there is no subframe underneath adding weight back."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "How far does it go?",
            "a": "An 8.4 kWh ASTRA ULTIMUM pack, good for a long day of trail riding. A second pack swaps in tool-free in about eleven seconds, which is the closest thing there is to unlimited range."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "How long does it charge?",
            "a": "About 55 minutes from empty to full, and the pack holds over 80% of its capacity after 1,500 cycles."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "How does the key work?",
            "a": "There is no key. A steel card ships with the bike and pairs it to you once. After that your iPhone lies flat in the tank pocket, charges while you ride, and is the only thing that will wake the machine."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "q": "What if someone tries to take it?",
            "a": "It stays locked, the same way your phone does in somebody else's hand. Without the paired device it will not start, and you can see where it is from your iPhone."
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "q": "What comes with it?",
            "a": "The bike, its charger, the wireless key and your steel owner card. At checkout you can add a spare wireless key, and you can choose the configuration that includes ten years of replacement cover."
          }
        },
        "q9": {
          "type": "qa",
          "settings": {
            "q": "What is 10-Year Replacement?",
            "a": "A second configuration of the bike rather than an add-on. Choose it at checkout and for ten years from delivery we replace the whole machine rather than repair it. Full terms are on the refund and terms pages."
          }
        },
        "q10": {
          "type": "qa",
          "settings": {
            "q": "When does it ship?",
            "a": "Four to six weeks. Your key case arrives days before the bike does, and you can follow the build the whole way from the tracking page."
          }
        },
        "q11": {
          "type": "qa",
          "settings": {
            "q": "How is it delivered?",
            "a": "By us, in person, to your door. No carriers, no depots, no freight terminal, and shipping is free."
          }
        },
        "q12": {
          "type": "qa",
          "settings": {
            "q": "What servicing does it need?",
            "a": "None scheduled. No oil, no chain, no filters, no valve clearances. Tyres and brake pads."
          }
        }
