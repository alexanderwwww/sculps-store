<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% comment %} HELIOS — global 4OFJULY promo toast: renders on every page (incl. cart), editor-proof {% endcomment %}
    {% unless template.suffix == 'super-glide' %}{% section 'helios-promo-toast' %}{% endunless %}

    {% comment %} HELIOS — cart recovery banner: returning visitor with items left in cart -> one-tap 20% off {% endcomment %}
    {% unless template.name == 'cart' %}
    <div id="helios-cartback">
    <style>
      #helios-cartback .cbk{position:fixed;top:14px;left:50%;transform:translate(-50%,-160%);z-index:85;display:flex;align-items:center;gap:11px;max-width:min(560px,calc(100vw - 24px));background:#0A0E12;color:#fff;border:1px solid rgba(16,201,126,.4);border-radius:100px;padding:9px 10px 9px 16px;box-shadow:0 20px 44px -14px rgba(10,14,18,.6),0 8px 30px -8px rgba(16,201,126,.25);font-family:'Archivo',system-ui,sans-serif;transition:transform .5s cubic-bezier(.3,.9,.3,1);cursor:pointer;}
      #helios-cartback .cbk.in{transform:translate(-50%,0);}
      #helios-cartback .cbk .tx{font-size:12.5px;font-weight:700;line-height:1.3;min-width:0;}
      #helios-cartback .cbk .tx b{color:#10C97E;font-weight:900;}
      #helios-cartback .cbk .go{flex:0 0 auto;background:#10C97E;color:#06281B;font-weight:900;font-size:12.5px;padding:9px 15px;border-radius:100px;white-space:nowrap;}
      #helios-cartback .cbk .x{flex:0 0 auto;background:rgba(255,255,255,.12);border:none;width:26px;height:26px;border-radius:50%;color:#B9C2CB;font-size:13px;line-height:1;cursor:pointer;}
      @media(max-width:560px){#helios-cartback .cbk .tx{font-size:11.5px;}#helios-cartback .cbk .go{font-size:11.5px;padding:8px 12px;}}
    </style>
    <div class="cbk" id="helios-cartback-bar" role="button" tabindex="0" aria-label="Return to your cart with 20% off">
      <span class="tx">🛒 Your cart's still here — <b>extra 20% OFF</b> to finish up</span>
      <span class="go">Claim &amp; checkout →</span>
      <button class="x" data-cbx aria-label="Dismiss">✕</button>
    </div>
    <script>
    (function(){
      var root=document.getElementById('helios-cartback'); if(!root||root.dataset.i)return; root.dataset.i='1';
      var bar=document.getElementById('helios-cartback-bar');
      function ss(k){ try{return sessionStorage.getItem(k);}catch(e){return null;} }
      function sset(k,v){ try{sessionStorage.setItem(k,v);}catch(e){} }
      var fresh=!ss('h_active'); sset('h_active','1'); // only fire on the FIRST page of a returning session
      if(!fresh || ss('h_cbk')==='1') return;
      fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(function(c){
        if(!c || !c.item_count) return;
        var gp=document.getElementById('helios-giftpop-ov');
        setTimeout(function(){
          if(gp && gp.classList.contains('in')) return; // never stack on the gift popup
          var pt=document.querySelector('[id^="helios-promo"], .helios-promo-toast'); if(pt) pt.style.display='none';
          bar.classList.add('in');
          setTimeout(function(){ bar.classList.remove('in'); }, 14000);
        }, 2200);
      }).catch(function(){});
      bar.addEventListener('click',function(e){
        if(e.target.closest('[data-cbx]')){ bar.classList.remove('in'); sset('h_cbk','1'); return; }
        sset('h_cbk','1'); bar.querySelector('.go').textContent='Applying 20% off…';
        window.location.href='/discount/COMEBACK20?redirect=%2Fcart';
      });
    })();
    </script>
    </div>
    {% endunless %}

    {% comment %} HELIOS — FREE Jet Ski + Pump gift popup (3+ gliders). Pops after add-to-cart and on the cart page. {% endcomment %}
    {% unless template.suffix == 'jetski-oto' or template.suffix == 'waverider' %}
    <div id="helios-giftpop">
    <style>
      #helios-giftpop .ov{position:fixed;inset:0;z-index:120;display:grid;place-items:center;padding:18px;background:rgba(6,16,26,.6);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);opacity:0;pointer-events:none;transition:opacity .3s ease;}
      #helios-giftpop .ov.in{opacity:1;pointer-events:auto;}
      #helios-giftpop .pop{width:100%;max-width:392px;background:#fff;border-radius:24px;overflow:hidden;position:relative;box-shadow:0 40px 90px -24px rgba(6,30,52,.6);transform:translateY(26px) scale(.96);transition:transform .5s cubic-bezier(.2,.9,.3,1.2);font-family:'Archivo',system-ui,sans-serif;color:#0C1A24;}
      #helios-giftpop .ov.in .pop{transform:none;}
      #helios-giftpop .x{position:absolute;top:12px;right:12px;z-index:3;width:30px;height:30px;border-radius:50%;border:none;background:rgba(255,255,255,.85);cursor:pointer;font-size:15px;color:#33424d;}
      #helios-giftpop .vid{width:100%;aspect-ratio:16/11;object-fit:cover;display:block;background:#000;}
      #helios-giftpop .bd{padding:18px 22px 20px;text-align:center;}
      #helios-giftpop .ey{font-size:11px;font-weight:900;letter-spacing:.13em;text-transform:uppercase;color:#0A5E97;}
      #helios-giftpop h2{font-family:'Archivo';font-weight:900;font-size:25px;line-height:1.04;letter-spacing:-.02em;margin:7px 0 6px;}
      #helios-giftpop h2 .g{color:#0A5E97;}
      #helios-giftpop .sub{font-size:13px;color:#5A6B79;font-weight:600;line-height:1.45;margin-bottom:13px;}
      #helios-giftpop .sub b{color:#0C1A24;}
      #helios-giftpop .val{display:flex;align-items:center;justify-content:center;gap:10px;border:2px dashed rgba(14,124,196,.45);background:#F2FAFF;border-radius:12px;padding:10px;margin-bottom:13px;}
      #helios-giftpop .val .lab{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#5A6B79;}
      #helios-giftpop .val s{font-size:15px;font-weight:700;color:#93a1ad;}
      #helios-giftpop .val .now{font-family:'Archivo';font-weight:900;font-size:19px;letter-spacing:.04em;color:#0E9F6E;}
      #helios-giftpop .btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;border:none;cursor:pointer;background:#0A1219;color:#fff;font-family:'Archivo';font-weight:900;font-size:15.5px;padding:15px;border-radius:13px;box-shadow:0 14px 28px -12px rgba(10,18,25,.6);}
      #helios-giftpop .btn .p{color:#10C97E;}
      #helios-giftpop .btn[disabled]{opacity:.6;cursor:default;}
      #helios-giftpop .btn2{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;border:1.5px solid rgba(12,26,36,.2);cursor:pointer;background:#fff;color:#0C1A24;font-family:'Archivo';font-weight:800;font-size:13.5px;padding:12px;border-radius:13px;margin-top:9px;}
      #helios-giftpop .btn2 s{color:#9aa8b4;font-weight:600;}
      #helios-giftpop .later{display:block;width:100%;background:none;border:none;cursor:pointer;color:#90a1ae;font-family:'Archivo';font-weight:700;font-size:12px;margin-top:10px;text-decoration:underline;}
      #helios-giftpop .fine{font-size:10.5px;color:#9aa8b4;margin-top:10px;font-weight:600;}
    </style>
      <div class="ov" id="helios-giftpop-ov">
        <div class="pop">
          <button class="x" data-close aria-label="Close">✕</button>
          <video class="vid" autoplay muted loop playsinline preload="auto">
            <source src="https://cdn.shopify.com/videos/c/vp/6e6519ea877d4866ba801895c0765bfc/6e6519ea877d4866ba801895c0765bfc.HD-720p-4.5Mbps-87645145.mp4" type="video/mp4">
          </video>
          <div class="bd" data-mode-b>
            <div class="ey">🎁 Free gifts · 3-glide offer</div>
            <h2>FREE <span class="g">Jet Ski</span> + FREE Pump</h2>
            <div class="sub">Make it <b>3 Super Glides</b> and we ship the Floatie Jet Ski <b>and</b> the cordless rapid pump with your order — <b>both completely free</b>.</div>
            <div class="val"><span class="lab">Gift value</span><s>$409.98</s><span class="now">FREE</span></div>
            <button class="btn" data-upgrade>Upgrade to 3 gliders — $351.99 <span class="p">→</span></button>
            <button class="btn2" data-pump>Just add the pump — $39.99 <s>$59.99</s></button>
            <button class="later" data-close>No thanks, keep my order</button>
            <div class="fine">Gifts added automatically · free shipping · 30-day money-back</div>
          </div>
          <div class="bd" data-mode-a style="display:none">
            <div class="ey">🎉 Unlocked — your order qualifies</div>
            <h2>Your FREE <span class="g">Jet Ski</span> + Pump</h2>
            <div class="sub">You're getting 3+ gliders, so the Floatie Jet Ski and the cordless rapid pump are <b>on us</b>. One tap — both drop into your cart at <b>$0.00</b>.</div>
            <div class="val"><span class="lab">Gift value</span><s>$409.98</s><span class="now">FREE</span></div>
            <button class="btn" data-claim>Claim my FREE Jet Ski + Pump <span class="p">→</span></button>
            <button class="later" data-close>No thanks</button>
            <div class="fine">$409.98 of gear · $0.00 today · ships with your order</div>
          </div>
        </div>
      </div>
    <script>
    (function(){
      var root=document.getElementById('helios-giftpop'); if(!root||root.dataset.init)return; root.dataset.init='1';
      var IS_CART={% if template.name == 'cart' %}true{% else %}false{% endif %};
      var TIERQ=[47935890849957,47935890882725]; // 3-pack, 4-pack Super Glide
      var GIFTS=[48001507197093,48001507262629]; // FREE Jet Ski, FREE Pump
      var PUMP=48001507131557, DISC='SUPERGLIDEIT', UP3='47935890849957';
      var ov=document.getElementById('helios-giftpop-ov');
      var bA=root.querySelector('[data-mode-a]'), bB=root.querySelector('[data-mode-b]');
      var acted=false, mode='b';
      function ss(k){ try{return sessionStorage.getItem(k);}catch(e){return null;} }
      function sset(k,v){ try{sessionStorage.setItem(k,v);}catch(e){} }
      function open(m){ mode=m; bA.style.display=(m==='a')?'':'none'; bB.style.display=(m==='b')?'':'none'; ov.classList.add('in'); var v=root.querySelector('video'); if(v){ var p=v.play(); if(p&&p.catch)p.catch(function(){}); } }
      function close(){ ov.classList.remove('in'); }
      function dismiss(){ close(); sset(mode==='a'?'hgp_a':'hgp_b','1'); }
      function getCart(cb){ fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(cb).catch(function(){}); }
      function addItems(ids,cb,fail){ fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:ids.map(function(id){return {id:id,quantity:1};})})}).then(function(r){ if(!r.ok)throw 0; return r.json(); }).then(cb).catch(fail); }
      function evaluate(){
        getCart(function(c){
          var items=(c&&c.items)||[]; if(!items.length) return;
          var ids=items.map(function(i){ return i.variant_id; });
          var qual=TIERQ.some(function(t){ return ids.indexOf(t)>-1; });
          var SGLOW=[47945658269861,47935890817189]; // 1-pack / 2-pack gliders — only these get the upgrade pitch
          var hasLowGlider=SGLOW.some(function(t){ return ids.indexOf(t)>-1; });
          var missing=GIFTS.filter(function(g){ return ids.indexOf(g)===-1; });
          if(qual && missing.length){
            if(ss('hgp_a')==='1' && !IS_CART) return; // cart page always re-offers unclaimed gifts
            root.dataset.missing=missing.join(','); open('a');
          } else if(!qual && hasLowGlider){
            if(ss('hgp_b')==='1') return;
            var n=parseInt(ss('hgp_bc')||'0',10); if(n>=2) return; sset('hgp_bc',''+(n+1));
            open('b');
          }
        });
      }
      // Trigger 1 — cart page: evaluate right away
      if(IS_CART){ setTimeout(evaluate, 500); }
      // Trigger 2 — anything added to cart via ajax -> evaluate shortly after
      function onAdd(){ if(acted) return; setTimeout(evaluate, 1200); }
      try{
        var _f=window.fetch;
        if(_f){ window.fetch=function(u,o){ try{ var url=(typeof u==='string')?u:((u&&u.url)||''); if(url.indexOf('/cart/add')>-1) onAdd(); }catch(e){} return _f.apply(this,arguments); }; }
        var _xo=XMLHttpRequest.prototype.open, _xs=XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.open=function(m,u){ this.__hu=u; return _xo.apply(this,arguments); };
        XMLHttpRequest.prototype.send=function(b){ try{ if(this.__hu&&((''+this.__hu).indexOf('/cart/add')>-1)) onAdd(); }catch(e){} return _xs.apply(this,arguments); };
      }catch(e){}
      root.querySelectorAll('[data-close]').forEach(function(b){ b.addEventListener('click',dismiss); });
      ov.addEventListener('click',function(e){ if(e.target===ov) dismiss(); });
      root.querySelector('[data-claim]').addEventListener('click',function(){
        var btn=this; if(btn.disabled) return; acted=true; btn.disabled=true; btn.textContent='Adding your gifts…';
        var miss=(root.dataset.missing||'').split(',').filter(Boolean).map(Number); if(!miss.length){ close(); return; }
        addItems(miss,function(){ btn.textContent='🎉 Added — both FREE'; sset('hgp_a','1'); setTimeout(function(){ if(IS_CART){ location.reload(); } else { close(); } }, 900); },
          function(){ btn.disabled=false; btn.textContent='Try again — claim my FREE gifts'; acted=false; });
      });
      root.querySelector('[data-upgrade]').addEventListener('click',function(){
        acted=true; sset('hgp_b','1'); this.disabled=true; this.textContent='Upgrading your order…';
        window.location.href='/cart/'+UP3+':1,'+GIFTS[0]+':1,'+GIFTS[1]+':1?discount='+DISC;
      });
      root.querySelector('[data-pump]').addEventListener('click',function(){
        var btn=this; acted=true; sset('hgp_b','1'); btn.textContent='Adding the pump…';
        addItems([PUMP],function(){ btn.textContent='✓ Pump added — $39.99'; setTimeout(function(){ if(IS_CART){ location.reload(); } else { close(); } }, 900); },
          function(){ btn.textContent='Try again — add the pump $39.99'; acted=false; });
      });
    })();
    </script>
    </div>
    {% endunless %}
  </body>
  {% if additional_checkout_buttons %}
<div style="display: none !important">
    {{ content_for_additional_checkout_buttons }}
</div>
{% endif %}

</html>
