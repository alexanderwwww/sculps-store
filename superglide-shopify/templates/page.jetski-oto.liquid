{% layout none %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>HELIOS — Rider's Offer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root{ --ink:#0C1A24; --mut:#5A6B79; --line:#E4EDF3; --acc:#0E7CC4; --accd:#0A5E97; --grn:#138a5e; --green:#10C97E; --red:#E23744; --black:#0A1219; }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
  body{font-family:'Archivo',system-ui,sans-serif;color:var(--ink);
    background:radial-gradient(120% 90% at 50% 0%,#F2F8FC,#E7F0F7);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:30px 16px;}
  .stage{display:flex;align-items:center;gap:54px;max-width:1040px;width:100%;justify-content:center;}
  /* ===== phone column = title on top of phone ===== */
  .phonecol{order:1;flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:20px;}
  .bigtitle{text-align:center;text-transform:uppercase;font-weight:900;line-height:.92;letter-spacing:-.02em;}
  .bigtitle .l{font-size:clamp(30px,3.4vw,42px);}
  .bigtitle .g{color:var(--accd);}
  .bigtitle .s{display:block;margin-top:9px;font-size:13px;font-weight:700;letter-spacing:0;text-transform:none;color:var(--mut);}
  /* ===== iPhone (video only) ===== */
  .phone{position:relative;flex:0 0 auto;width:312px;aspect-ratio:9/19.3;background:#0a0e13;border-radius:50px;padding:12px;
    box-shadow:0 60px 100px -34px rgba(10,30,50,.55), inset 0 0 0 2px #2b333b;}
  .phone::before,.phone::after{content:"";position:absolute;left:-3px;width:3px;border-radius:3px 0 0 3px;background:#1b2228;}
  .phone::before{top:120px;height:54px;} .phone::after{top:188px;height:54px;}
  .pwr{position:absolute;right:-3px;top:150px;width:3px;height:76px;border-radius:0 3px 3px 0;background:#1b2228;}
  .screen{position:relative;width:100%;height:100%;border-radius:38px;overflow:hidden;background:#000;}
  .island{position:absolute;top:11px;left:50%;transform:translateX(-50%);width:96px;height:27px;background:#000;border-radius:18px;z-index:6;}
  .screen video{width:100%;height:100%;object-fit:cover;display:block;}
  .otitle{position:absolute;top:0;left:0;right:0;z-index:4;text-align:center;padding:48px 14px 26px;
    background:linear-gradient(180deg,rgba(0,0,0,.6),rgba(0,0,0,0));
    font-weight:900;font-size:21px;letter-spacing:.04em;color:#fff;text-transform:uppercase;line-height:1.05;text-shadow:0 2px 12px rgba(0,0,0,.5);}
  .othanks{position:absolute;bottom:0;left:0;right:0;z-index:4;text-align:center;padding:30px 14px 22px;
    background:linear-gradient(0deg,rgba(0,0,0,.62),rgba(0,0,0,0));font-weight:800;font-size:13px;color:#fff;letter-spacing:.02em;}
  .sound{position:absolute;left:50%;transform:translateX(-50%);bottom:54px;display:flex;align-items:center;gap:6px;cursor:pointer;z-index:5;
    background:rgba(255,255,255,.16);backdrop-filter:blur(8px);color:#fff;font-weight:800;font-size:12px;border:1px solid rgba(255,255,255,.3);padding:8px 13px;border-radius:30px;}
  /* ===== offer ===== */
  .offer{flex:0 1 480px;order:2;background:#fff;border:1px solid var(--line);border-radius:24px;padding:26px 28px 24px;
    box-shadow:0 40px 90px -40px rgba(10,40,66,.4);}
  .mtitle{display:none;}
  .conf{display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:800;color:var(--grn);margin-bottom:10px;}
  .conf .k{width:16px;height:16px;border-radius:50%;background:var(--grn);color:#fff;display:grid;place-items:center;font-size:9px;}
  .ey{font-size:11px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;color:var(--accd);}
  h1{font-weight:900;font-size:clamp(25px,3.1vw,32px);line-height:1.02;letter-spacing:-.025em;margin:6px 0 7px;}
  .rate{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--mut);font-weight:600;margin-bottom:14px;}
  .rate .st{color:#f5a623;letter-spacing:1px;}
  /* product gallery (above bundles) */
  .pg{margin-bottom:16px;}
  .pmain{width:100%;aspect-ratio:4/3;border-radius:14px;overflow:hidden;background:#eef4f8;border:1px solid var(--line);}
  .pmain img{width:100%;height:100%;object-fit:cover;display:block;}
  .pthumbs{display:flex;gap:8px;margin-top:8px;}
  .pthumbs button{flex:1;aspect-ratio:1/1;border-radius:10px;overflow:hidden;border:2px solid var(--line);background:#eef4f8;cursor:pointer;padding:0;}
  .pthumbs button.on{border-color:var(--acc);}
  .pthumbs img{width:100%;height:100%;object-fit:cover;display:block;}
  /* tiers */
  .tiers{display:flex;flex-direction:column;gap:9px;}
  .tier{display:flex;align-items:center;gap:12px;padding:13px 14px;border:2px solid var(--line);border-radius:14px;cursor:pointer;position:relative;transition:.15s;}
  .tier.sel{border-color:var(--acc);background:#F2FAFF;}
  .radio{width:20px;height:20px;border-radius:50%;border:2px solid #c7d6e0;flex:0 0 20px;display:grid;place-items:center;}
  .tier.sel .radio{border-color:var(--acc);}
  .tier.sel .radio::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--acc);}
  .tl{flex:1;min-width:0;}
  .tl .t{font-weight:800;font-size:15px;}
  .tl .s{font-size:12px;color:var(--mut);font-weight:600;margin-top:1px;}
  .tp{display:flex;flex-direction:column;align-items:flex-end;gap:3px;}
  .tp .n{font-weight:900;font-size:17px;}
  .tp .off{font-size:9.5px;font-weight:900;color:#fff;background:var(--red);padding:2px 7px;border-radius:20px;}
  .pop{position:absolute;top:-9px;right:12px;background:var(--acc);color:#fff;font-size:9.5px;font-weight:900;letter-spacing:.05em;text-transform:uppercase;padding:3px 8px;border-radius:20px;}
  .applied{display:flex;align-items:center;justify-content:center;gap:8px;margin:16px 0 0;font-weight:900;font-size:12.5px;color:#7a4d00;background:linear-gradient(90deg,#FFE7B5,#FFD37A);padding:9px;border-radius:11px;}
  .buy{display:flex;flex-direction:column;align-items:center;gap:3px;width:100%;border:none;cursor:pointer;background:var(--black);color:#fff;font-family:'Archivo';padding:16px;border-radius:16px;margin-top:9px;box-shadow:0 18px 36px -14px rgba(10,18,25,.6);transition:transform .12s;}
  .buy:active{transform:scale(.99);}
  .buy .l1{font-weight:900;font-size:16px;letter-spacing:-.01em;}
  .buy .payrow{display:flex;align-items:baseline;gap:12px;margin-top:2px;}
  .buy .payrow s{font-size:18px;color:#7d8b96;font-weight:700;}
  .buy .payrow .pay{font-size:38px;font-weight:900;letter-spacing:-.03em;color:var(--green);line-height:1;text-shadow:0 0 26px rgba(16,201,126,.45);}
  .buy .tagoff{font-size:11px;font-weight:900;letter-spacing:.06em;color:#04131e;background:var(--green);padding:3px 9px;border-radius:20px;margin-top:6px;}
  .trust{display:flex;align-items:center;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:13px;}
  .trust span{font-size:11px;color:var(--mut);font-weight:700;}
  .once{text-align:center;font-size:11px;color:var(--accd);font-weight:800;margin-top:13px;}
  .decline{display:block;width:100%;text-align:center;background:none;border:none;cursor:pointer;color:#90a1ae;font-family:'Archivo';font-weight:700;font-size:12.5px;margin-top:8px;text-decoration:underline;text-underline-offset:3px;}
  /* ===== MOBILE: [title + phone] on top, then product, then bundles ===== */
  @media(max-width:860px){
    body{padding:0;background:#fff;align-items:flex-start;}
    .stage{flex-direction:column;gap:0;max-width:560px;}
    .phonecol{order:1;width:100%;gap:14px;padding:26px 18px 4px;}
    .bigtitle .l{font-size:33px;}
    .phone{width:248px;}
    .phone::before,.phone::after,.pwr{display:none;}
    .offer{order:2;flex:none;width:100%;border:0;border-radius:0;box-shadow:none;padding:18px 18px 30px;}
    .ey{display:none;}
    .conf{margin-top:4px;}
  }
</style>
</head>
<body>
<div class="stage">
  <div class="phonecol">
    <div class="bigtitle"><span class="l">One-time<br><span class="g">offer only</span></span><span class="s">50% off the HELIOS Jet Ski — only on this order</span></div>
    <div class="phone">
      <div class="pwr"></div>
      <div class="screen">
        <div class="island"></div>
        <video id="vid" autoplay muted loop playsinline preload="auto">
          <source src="https://cdn.shopify.com/videos/c/vp/6e6519ea877d4866ba801895c0765bfc/6e6519ea877d4866ba801895c0765bfc.HD-720p-4.5Mbps-87645145.mp4" type="video/mp4">
          <source src="https://cdn.shopify.com/videos/c/vp/6e6519ea877d4866ba801895c0765bfc/6e6519ea877d4866ba801895c0765bfc.SD-480p-1.5Mbps-87645145.mp4" type="video/mp4">
        </video>
        <button class="sound" id="sound">🔊 Tap for sound</button>
        <div class="othanks">Thanks for choosing HELIOS 🌊</div>
      </div>
    </div>
  </div>

  <div class="offer">
    <div class="conf"><span class="k">✓</span> ORDER CONFIRMED — payment complete</div>
    <div class="ey">One-time rider's offer</div>
    <h1>HELIOS Jet Ski Pro</h1>
    <div class="rate"><span class="st">★★★★★</span> <b style="color:var(--ink)">4.8</b> · 1,240 riders · 25 km/h · 2-hr battery</div>

    <div class="pg">
      <div class="pmain"><img id="pmain" src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/a7b05a36-528c-44ca-8a1a-7a9add23058b.png?v=1782714655" alt="HELIOS Jet Ski"></div>
      <div class="pthumbs" id="pthumbs">
        <button class="on"><img src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/a7b05a36-528c-44ca-8a1a-7a9add23058b.png?v=1782714655" alt=""></button>
        <button><img src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/47dc11ca-3353-4ed4-8275-40acf8fa5523.png?v=1782714656" alt=""></button>
        <button><img src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/cd2aeedb-4378-48c1-bcab-5b7a5aa6b319.png?v=1782715284" alt=""></button>
        <button><img src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/bf3d9cd7-1cd6-43a1-b5ec-aca96cc17d42.png?v=1782715284" alt=""></button>
        <button><img src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/1f5c6e20-e5ac-4087-9a79-afe9d999db05.png?v=1782715856" alt=""></button>
      </div>
    </div>

    <div class="tiers" id="tiers">
      <div class="tier sel" data-was="249.99" data-now="125.00" data-variant="47951634923685">
        <span class="radio"></span>
        <div class="tl"><div class="t">1 Jet Ski</div><div class="s">Just me — try it out</div></div>
        <div class="tp"><div class="n">$249.99</div><span class="off">50% OFF</span></div>
      </div>
      <div class="tier" data-was="459.99" data-now="229.99" data-variant="47951634956453">
        <span class="pop">Most popular</span>
        <span class="radio"></span>
        <div class="tl"><div class="t">2 Jet Skis</div><div class="s">Race a friend</div></div>
        <div class="tp"><div class="n">$459.99</div><span class="off">50% OFF</span></div>
      </div>
      <div class="tier" data-was="689.99" data-now="344.99" data-variant="47951634989221">
        <span class="pop" style="background:#138a5e">Best value</span>
        <span class="radio"></span>
        <div class="tl"><div class="t">3 Jet Skis</div><div class="s">The whole crew</div></div>
        <div class="tp"><div class="n">$689.99</div><span class="off">50% OFF</span></div>
      </div>
    </div>

    <div class="applied">⚡ 50% RIDER'S DISCOUNT — APPLIED AT CHECKOUT</div>
    <button class="buy" id="buy">
      <span class="l1">Add to my order →</span>
      <span class="payrow"><s id="bw">$249.99</s><span class="pay" id="bn">$125.00</span></span>
      <span class="tagoff">YOU SAVE <span id="bs">$125</span> — 50% OFF</span>
    </button>
    <div class="trust"><span>🔒 One tap</span><span>🚚 Free shipping</span><span>🛡 30-day refund</span><span>📦 Ships together</span></div>
    <div class="once">★ Exclusive to this order — this price won't appear again</div>
    <button class="decline">No thanks, I'll skip the jet ski</button>
  </div>
</div>
<script>
  var v=document.getElementById('vid'), s=document.getElementById('sound');
  function unmute(){v.muted=false;v.play();s.style.display='none';}
  s.onclick=function(e){e.stopPropagation();unmute();}; v.addEventListener('click',function(){if(v.muted)unmute();});
  // product gallery thumbs
  var pmain=document.getElementById('pmain'), thumbs=document.querySelectorAll('#pthumbs button');
  thumbs.forEach(function(b){b.addEventListener('click',function(){thumbs.forEach(function(x){x.classList.remove('on');});b.classList.add('on');pmain.src=b.querySelector('img').src;});});
  // tiers
  var tiers=document.querySelectorAll('.tier'), bw=document.getElementById('bw'), bn=document.getElementById('bn'), bs=document.getElementById('bs');
  var variant='47951634923685';
  tiers.forEach(function(t){t.addEventListener('click',function(){
    tiers.forEach(function(x){x.classList.remove('sel');}); t.classList.add('sel');
    var was=parseFloat(t.dataset.was), now=parseFloat(t.dataset.now); variant=t.dataset.variant;
    bw.textContent='$'+was.toFixed(2); bn.textContent='$'+now.toFixed(2); bs.textContent='$'+Math.round(was-now);
  });});
  // functional buy → add jet ski to cart with the 50% discount, go to checkout
  document.getElementById('buy').addEventListener('click',function(){
    window.location.href='/cart/'+variant+':1?discount=RIDER50';
  });
  document.querySelector('.decline').addEventListener('click',function(){ window.location.href='/'; });
</script>
</body>
</html>
