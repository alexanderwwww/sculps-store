{% layout none %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>HELIOS — Rider's Offer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root{ --ink:#0C1A24; --mut:#5A6B79; --line:#E4EDF3; --acc:#0E7CC4; --accd:#0A5E97; --grn:#138a5e; --red:#E23744; --black:#0A1219; }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
  body{font-family:'Archivo',system-ui,sans-serif;color:var(--ink);
    background:linear-gradient(180deg,#F7FBFE,#EDF4FA);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:22px 14px;}
  .card{width:100%;max-width:1000px;background:#fff;border:1px solid var(--line);border-radius:26px;overflow:hidden;
    box-shadow:0 40px 90px -36px rgba(10,40,66,.35);display:grid;grid-template-columns:minmax(0,46%) 1fr;}
  /* gallery */
  .gal{position:relative;background:#eef4f8;}
  .track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;height:100%;}
  .track::-webkit-scrollbar{display:none;}
  .slide{flex:0 0 100%;scroll-snap-align:center;aspect-ratio:1/1;position:relative;}
  .slide video,.slide img{width:100%;height:100%;object-fit:cover;display:block;}
  .tk{position:absolute;top:12px;left:12px;display:flex;align-items:center;gap:6px;font-size:10px;font-weight:800;color:#fff;
    background:rgba(10,18,25,.5);backdrop-filter:blur(6px);padding:5px 9px;border-radius:20px;z-index:2;}
  .tk .d{width:6px;height:6px;border-radius:50%;background:#ff4d6d;}
  .sound{position:absolute;left:12px;bottom:12px;display:flex;align-items:center;gap:6px;cursor:pointer;z-index:2;
    background:rgba(10,18,25,.62);backdrop-filter:blur(8px);color:#fff;font-weight:800;font-size:12px;border:none;padding:8px 12px;border-radius:30px;}
  .dots{position:absolute;left:0;right:0;bottom:12px;display:flex;gap:6px;justify-content:center;z-index:2;pointer-events:none;}
  .dots i{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.55);transition:.2s;}
  .dots i.on{background:#fff;width:18px;border-radius:4px;}
  /* offer */
  .offer{padding:28px 30px 26px;}
  .conf{display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:800;color:var(--grn);margin-bottom:11px;}
  .conf .k{width:16px;height:16px;border-radius:50%;background:var(--grn);color:#fff;display:grid;place-items:center;font-size:9px;}
  .ey{font-size:11px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;color:var(--accd);}
  h1{font-weight:900;font-size:clamp(25px,3.2vw,32px);line-height:1.03;letter-spacing:-.025em;margin:6px 0 8px;}
  .rate{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--mut);font-weight:600;margin-bottom:16px;}
  .rate .st{color:#f5a623;letter-spacing:1px;}
  .tiers{display:flex;flex-direction:column;gap:9px;}
  .tier{display:flex;align-items:center;gap:12px;padding:13px 14px;border:2px solid var(--line);border-radius:14px;cursor:pointer;position:relative;transition:.15s;}
  .tier.sel{border-color:var(--acc);background:#F2FAFF;}
  .radio{width:20px;height:20px;border-radius:50%;border:2px solid #c7d6e0;flex:0 0 20px;display:grid;place-items:center;}
  .tier.sel .radio{border-color:var(--acc);}
  .tier.sel .radio::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--acc);}
  .tl{flex:1;min-width:0;}
  .tl .t{font-weight:800;font-size:15px;}
  .tl .s{font-size:12px;color:var(--mut);font-weight:600;margin-top:1px;}
  .tp{display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex:0 0 auto;}
  .tp .n{font-weight:900;font-size:17px;}
  .tp .off{font-size:9.5px;font-weight:900;letter-spacing:.04em;color:#fff;background:var(--red);padding:2px 7px;border-radius:20px;}
  .pop{position:absolute;top:-9px;right:12px;background:var(--acc);color:#fff;font-size:9.5px;font-weight:900;letter-spacing:.05em;text-transform:uppercase;padding:3px 8px;border-radius:20px;}
  /* applied + cta */
  .applied{display:flex;align-items:center;justify-content:center;gap:8px;margin:16px 0 0;font-weight:900;font-size:12.5px;letter-spacing:.03em;
    color:#7a4d00;background:linear-gradient(90deg,#FFE7B5,#FFD37A);padding:9px;border-radius:11px;}
  .buy{display:flex;flex-direction:column;align-items:center;gap:2px;width:100%;border:none;cursor:pointer;
    background:var(--black);color:#fff;font-family:'Archivo';font-weight:900;padding:15px;border-radius:14px;margin-top:9px;
    box-shadow:0 16px 32px -14px rgba(10,18,25,.55);transition:transform .12s;}
  .buy:active{transform:scale(.99);}
  .buy .l1{font-size:16px;letter-spacing:-.01em;}
  .buy .l2{font-size:13px;font-weight:800;opacity:.95;}
  .buy .l2 s{opacity:.6;font-weight:700;margin-right:6px;}
  .buy .l2 b{color:#8ff0c4;}
  .trust{display:flex;align-items:center;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:13px;}
  .trust span{font-size:11px;color:var(--mut);font-weight:700;}
  .once{text-align:center;font-size:11px;color:var(--accd);font-weight:800;margin-top:13px;}
  .decline{display:block;width:100%;text-align:center;background:none;border:none;cursor:pointer;color:#90a1ae;font-family:'Archivo';font-weight:700;font-size:12.5px;margin-top:8px;text-decoration:underline;text-underline-offset:3px;}
  /* ---------- PHONE: separate, vertical product page ---------- */
  @media(max-width:760px){
    body{padding:0;align-items:flex-start;background:#fff;}
    .card{grid-template-columns:1fr;max-width:520px;border:0;border-radius:0;box-shadow:none;min-height:100vh;}
    .slide{aspect-ratio:1/1;}
    .offer{padding:20px 18px 30px;}
    h1{font-size:25px;}
  }
</style>
</head>
<body>
<div class="card">
  <div class="gal">
    <div class="track" id="track">
      <div class="slide">
        <div class="tk"><span class="d"></span> AS SEEN ON TIKTOK</div>
        <video id="vid" autoplay muted loop playsinline preload="auto">
          <source src="https://cdn.shopify.com/videos/c/vp/6e6519ea877d4866ba801895c0765bfc/6e6519ea877d4866ba801895c0765bfc.HD-720p-4.5Mbps-87645145.mp4" type="video/mp4">
          <source src="https://cdn.shopify.com/videos/c/vp/6e6519ea877d4866ba801895c0765bfc/6e6519ea877d4866ba801895c0765bfc.SD-480p-1.5Mbps-87645145.mp4" type="video/mp4">
        </video>
        <button class="sound" id="sound">🔊 Tap for sound</button>
      </div>
      <div class="slide"><img src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/a7b05a36-528c-44ca-8a1a-7a9add23058b.png?v=1782714655" alt="Jet Ski"></div>
      <div class="slide"><img src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/47dc11ca-3353-4ed4-8275-40acf8fa5523.png?v=1782714656" alt="Jet Ski"></div>
      <div class="slide"><img src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/cd2aeedb-4378-48c1-bcab-5b7a5aa6b319.png?v=1782715284" alt="Jet Ski"></div>
      <div class="slide"><img src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/bf3d9cd7-1cd6-43a1-b5ec-aca96cc17d42.png?v=1782715284" alt="Jet Ski"></div>
      <div class="slide"><img src="https://cdn.shopify.com/s/files/1/0769/8320/6053/files/1f5c6e20-e5ac-4087-9a79-afe9d999db05.png?v=1782715856" alt="Jet Ski"></div>
    </div>
    <div class="dots" id="dots"></div>
  </div>

  <div class="offer">
    <div class="conf"><span class="k">✓</span> ORDER CONFIRMED — payment complete</div>
    <div class="ey">One-time rider's offer</div>
    <h1>HELIOS Jet Ski Pro</h1>
    <div class="rate"><span class="st">★★★★★</span> <b style="color:var(--ink)">4.8</b> · 1,240 riders · 25 km/h · 2-hr battery</div>

    <div class="tiers" id="tiers">
      <div class="tier sel" data-was="199.99" data-now="99.99" data-q="1">
        <span class="radio"></span>
        <div class="tl"><div class="t">1 Jet Ski</div><div class="s">Just me — try it out</div></div>
        <div class="tp"><div class="n">$199.99</div><span class="off">50% OFF</span></div>
      </div>
      <div class="tier" data-was="349.99" data-now="174.99" data-q="2">
        <span class="pop">Most popular</span>
        <span class="radio"></span>
        <div class="tl"><div class="t">2 Jet Skis</div><div class="s">Race a friend</div></div>
        <div class="tp"><div class="n">$349.99</div><span class="off">50% OFF</span></div>
      </div>
      <div class="tier" data-was="479.99" data-now="239.99" data-q="3">
        <span class="pop" style="background:#138a5e">Best value</span>
        <span class="radio"></span>
        <div class="tl"><div class="t">3 Jet Skis</div><div class="s">The whole crew</div></div>
        <div class="tp"><div class="n">$479.99</div><span class="off">50% OFF</span></div>
      </div>
    </div>

    <div class="applied">⚡ 50% RIDER'S DISCOUNT — APPLIED AT CHECKOUT</div>
    <button class="buy" id="buy">
      <span class="l1">Add to my order →</span>
      <span class="l2"><s id="bw">$199.99</s> <b id="bn">You pay $99.99</b></span>
    </button>
    <div class="trust"><span>🔒 One tap</span><span>🚚 Free shipping</span><span>🛡 30-day refund</span><span>📦 Ships together</span></div>
    <div class="once">★ Exclusive to this order — this price won't appear again</div>
    <button class="decline">No thanks, I'll skip the jet ski</button>
  </div>
</div>
<script>
  // gallery dots + sound
  var track=document.getElementById('track'), slides=track.querySelectorAll('.slide'), dots=document.getElementById('dots');
  slides.forEach(function(_,i){var d=document.createElement('i');if(i===0)d.className='on';dots.appendChild(d);});
  var di=dots.querySelectorAll('i');
  track.addEventListener('scroll',function(){var i=Math.round(track.scrollLeft/track.clientWidth);di.forEach(function(d,j){d.classList.toggle('on',j===i);});});
  var v=document.getElementById('vid'), s=document.getElementById('sound');
  function unmute(){v.muted=false;v.play();s.style.display='none';}
  s.onclick=function(e){e.stopPropagation();unmute();}; v.addEventListener('click',function(){if(v.muted)unmute();});
  // tiers — real price stays on row, half price revealed on the button
  var tiers=document.querySelectorAll('.tier'), bw=document.getElementById('bw'), bn=document.getElementById('bn');
  tiers.forEach(function(t){t.addEventListener('click',function(){
    tiers.forEach(function(x){x.classList.remove('sel');}); t.classList.add('sel');
    bw.textContent='$'+parseFloat(t.dataset.was).toFixed(2);
    bn.textContent='You pay $'+parseFloat(t.dataset.now).toFixed(2);
  });});
</script>
</body>
</html>
