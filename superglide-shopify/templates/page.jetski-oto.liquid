{% layout none %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>HELIOS — Rider's Offer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root{ --ink:#0C1A24; --mut:#5A6B79; --line:#E4EDF3; --acc:#0E7CC4; --acc2:#16A6D6; --accd:#0A5E97; --grn:#138a5e; --black:#0A1219; }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
  body{font-family:'Archivo',system-ui,sans-serif;color:var(--ink);
    background:linear-gradient(180deg,#F7FBFE,#EEF5FA);min-height:100vh;
    display:flex;align-items:center;justify-content:center;padding:24px 16px;}
  .card{width:100%;max-width:980px;background:#fff;border:1px solid var(--line);border-radius:26px;overflow:hidden;
    box-shadow:0 40px 90px -36px rgba(10,40,66,.35);display:grid;grid-template-columns:minmax(0,40%) 1fr;}
  /* video side */
  .media{position:relative;background:#0b1622;}
  .media video{width:100%;height:100%;object-fit:cover;display:block;min-height:340px;}
  .sound{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);display:flex;align-items:center;gap:7px;cursor:pointer;
    background:rgba(10,18,25,.62);backdrop-filter:blur(8px);color:#fff;font-weight:800;font-size:12.5px;border:none;
    padding:9px 14px;border-radius:30px;box-shadow:0 8px 22px rgba(0,0,0,.3);}
  .tk{position:absolute;top:13px;left:13px;display:flex;align-items:center;gap:6px;font-size:10.5px;font-weight:800;color:#fff;
    background:rgba(10,18,25,.5);backdrop-filter:blur(6px);padding:5px 10px;border-radius:20px;}
  .tk .d{width:6px;height:6px;border-radius:50%;background:#ff4d6d;}
  /* offer side */
  .offer{padding:30px 30px 26px;}
  .conf{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:800;color:var(--grn);margin-bottom:12px;}
  .conf .k{width:16px;height:16px;border-radius:50%;background:var(--grn);color:#fff;display:grid;place-items:center;font-size:9px;}
  .ey{font-size:11.5px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;color:var(--accd);}
  h1{font-weight:900;font-size:clamp(26px,3.4vw,34px);line-height:1.04;letter-spacing:-.025em;margin:7px 0 9px;}
  .rate{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--mut);font-weight:600;margin-bottom:16px;}
  .rate .st{color:#f5a623;letter-spacing:1px;}
  /* tiers */
  .tiers{display:flex;flex-direction:column;gap:9px;}
  .tier{display:flex;align-items:center;gap:13px;padding:13px 14px;border:2px solid var(--line);border-radius:14px;cursor:pointer;
    transition:border-color .15s, background .15s;position:relative;}
  .tier.sel{border-color:var(--acc);background:#F2FAFF;}
  .radio{width:20px;height:20px;border-radius:50%;border:2px solid #c7d6e0;flex:0 0 20px;display:grid;place-items:center;}
  .tier.sel .radio{border-color:var(--acc);}
  .tier.sel .radio::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--acc);}
  .tl{flex:1;min-width:0;}
  .tl .t{font-weight:800;font-size:15px;}
  .tl .s{font-size:12px;color:var(--mut);font-weight:600;margin-top:1px;}
  .tp{text-align:right;flex:0 0 auto;}
  .tp .n{font-weight:900;font-size:16px;}
  .tp .c{font-size:12px;color:var(--mut);text-decoration:line-through;}
  .pop{position:absolute;top:-9px;right:12px;background:var(--acc);color:#fff;font-size:9.5px;font-weight:900;letter-spacing:.06em;
    text-transform:uppercase;padding:3px 8px;border-radius:20px;}
  .pill50{position:absolute;top:-9px;left:12px;background:#FFE6B0;color:#7a4d00;font-size:9.5px;font-weight:900;padding:3px 8px;border-radius:20px;}
  /* total + cta */
  .total{display:flex;align-items:baseline;gap:11px;margin:18px 0 4px;}
  .total .now{font-weight:900;font-size:40px;letter-spacing:-.03em;line-height:1;}
  .total .was{font-size:18px;color:var(--mut);text-decoration:line-through;font-weight:700;}
  .total .save{font-size:12px;font-weight:900;color:var(--grn);background:rgba(19,138,94,.1);padding:4px 9px;border-radius:20px;align-self:center;}
  .buy{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;border:none;cursor:pointer;
    background:var(--black);color:#fff;font-family:'Archivo';font-weight:900;font-size:17px;letter-spacing:-.01em;
    padding:18px;border-radius:14px;margin-top:14px;box-shadow:0 16px 32px -14px rgba(10,18,25,.55);transition:transform .12s;}
  .buy:active{transform:scale(.99);}
  .trust{display:flex;align-items:center;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:13px;}
  .trust span{font-size:11.5px;color:var(--mut);font-weight:700;}
  .once{text-align:center;font-size:11.5px;color:var(--accd);font-weight:800;margin-top:14px;}
  .decline{display:block;width:100%;text-align:center;background:none;border:none;cursor:pointer;color:#90a1ae;
    font-family:'Archivo';font-weight:700;font-size:12.5px;margin-top:9px;text-decoration:underline;text-underline-offset:3px;}
  @media(max-width:760px){
    .card{grid-template-columns:1fr;max-width:460px;}
    .media video{min-height:0;height:42vh;}
    .offer{padding:22px 20px 22px;}
    h1{font-size:27px;}
  }
</style>
</head>
<body>
<div class="card">
  <div class="media">
    <div class="tk"><span class="d"></span> AS SEEN ON TIKTOK</div>
    <video id="vid" autoplay muted loop playsinline preload="auto">
      <source src="https://cdn.shopify.com/videos/c/vp/6e6519ea877d4866ba801895c0765bfc/6e6519ea877d4866ba801895c0765bfc.HD-720p-4.5Mbps-87645145.mp4" type="video/mp4">
      <source src="https://cdn.shopify.com/videos/c/vp/6e6519ea877d4866ba801895c0765bfc/6e6519ea877d4866ba801895c0765bfc.SD-480p-1.5Mbps-87645145.mp4" type="video/mp4">
    </video>
    <button class="sound" id="sound">🔊 Tap for sound</button>
  </div>

  <div class="offer">
    <div class="conf"><span class="k">✓</span> ORDER CONFIRMED — payment complete</div>
    <div class="ey">One-time rider's offer</div>
    <h1>Add the HELIOS Jet&nbsp;Ski<br>at <span style="color:var(--accd)">50% off</span></h1>
    <div class="rate"><span class="st">★★★★★</span> <b style="color:var(--ink)">4.8</b> · 1,240 riders · 25 km/h · 2-hr battery</div>

    <div class="tiers" id="tiers">
      <div class="tier sel" data-now="99.99" data-was="199.99" data-label="1 Jet Ski">
        <span class="pill50">50% OFF</span>
        <span class="radio"></span>
        <div class="tl"><div class="t">1 Jet Ski</div><div class="s">Just me — try it out</div></div>
        <div class="tp"><div class="n">$99.99</div><div class="c">$199.99</div></div>
      </div>
      <div class="tier" data-now="199.98" data-was="399.98" data-label="2 Jet Skis">
        <span class="pop">Most popular</span>
        <span class="radio"></span>
        <div class="tl"><div class="t">2 Jet Skis</div><div class="s">Race a friend</div></div>
        <div class="tp"><div class="n">$199.98</div><div class="c">$399.98</div></div>
      </div>
      <div class="tier" data-now="299.97" data-was="599.97" data-label="3 Jet Skis">
        <span class="pop" style="background:#138a5e">Best value</span>
        <span class="radio"></span>
        <div class="tl"><div class="t">3 Jet Skis</div><div class="s">The whole crew</div></div>
        <div class="tp"><div class="n">$299.97</div><div class="c">$599.97</div></div>
      </div>
    </div>

    <div class="total">
      <span class="now" id="big">$99.99</span>
      <span class="was" id="bigwas">$199.99</span>
      <span class="save" id="bigsave">You save $100</span>
    </div>

    <button class="buy" id="buy">Add to my order · <span id="btnp">$99.99</span> →</button>
    <div class="trust"><span>🔒 One tap</span><span>🚚 Free shipping</span><span>🛡 30-day refund</span><span>📦 Ships with your order</span></div>
    <div class="once">★ Exclusive to this order — this price won't appear again</div>
    <button class="decline">No thanks, I'll skip the jet ski</button>
  </div>
</div>
<script>
  // sound
  var v=document.getElementById('vid'), s=document.getElementById('sound');
  function unmute(){ v.muted=false; v.play(); s.style.display='none'; }
  s.onclick=unmute; v.addEventListener('click',function(){ if(v.muted)unmute(); });
  // tier select
  var tiers=document.querySelectorAll('.tier'), big=document.getElementById('big'), bw=document.getElementById('bigwas'),
      bs=document.getElementById('bigsave'), bp=document.getElementById('btnp');
  tiers.forEach(function(t){ t.addEventListener('click',function(){
    tiers.forEach(function(x){x.classList.remove('sel');}); t.classList.add('sel');
    var n=parseFloat(t.dataset.now), w=parseFloat(t.dataset.was);
    big.textContent='$'+n.toFixed(2); bw.textContent='$'+w.toFixed(2);
    bs.textContent='You save $'+Math.round(w-n); bp.textContent='$'+n.toFixed(2);
  });});
</script>
</body>
</html>
