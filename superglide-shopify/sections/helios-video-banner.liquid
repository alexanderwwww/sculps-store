{%- comment -%}
  HELIOS — Full-width video/image banner with headline overlay.
  sections/helios-video-banner.liquid
{%- endcomment -%}
{%- assign sid = section.id -%}
<section class="helios" id="hv-{{ sid }}">
<style>
  #hv-{{ sid }} .hv-wrap{max-width:1280px;margin:0 auto;padding:clamp(20px,3vw,40px) 16px;}
  #hv-{{ sid }} .hv-band{position:relative;border-radius:28px;overflow:hidden;min-height:clamp(360px,52vw,560px);background:linear-gradient(135deg,var(--helios-ocean1,#062F49),var(--helios-ocean2,#0E6FA8) 60%,var(--helios-ocean3,#2FB6D6));box-shadow:var(--helios-g-shlg,0 26px 60px -18px rgba(6,47,73,.3));}
  #hv-{{ sid }} .hv-band > img,#hv-{{ sid }} .hv-band > video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;}
  #hv-{{ sid }} .hv-scrim{position:absolute;inset:0;background:linear-gradient(0deg,rgba(6,30,46,.74),rgba(6,30,46,.12) 55%,rgba(6,30,46,.3));z-index:1;}
  #hv-{{ sid }} .hv-in{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(28px,5vw,56px);color:#fff;}
  #hv-{{ sid }} .hv-ey{font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.85);}
  #hv-{{ sid }} .hv-h{font-family:'Archivo';font-weight:900;font-size:clamp(30px,5.4vw,64px);line-height:.98;letter-spacing:-.02em;margin:10px 0 0;max-width:16ch;text-shadow:0 8px 40px rgba(0,15,30,.4);}
  #hv-{{ sid }} .hv-cta{align-self:flex-start;display:inline-flex;align-items:center;gap:9px;margin-top:22px;background:#fff;color:var(--helios-accd,#0A5E97);border-radius:14px;padding:15px 28px;font-family:'Archivo';font-weight:800;font-size:15px;box-shadow:0 16px 34px rgba(0,20,40,.3);}
</style>
<div class="hv-wrap">
  <div class="hv-band" data-reveal>
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1600x' }}
    {%- elsif section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="1600" height="900">
    {%- endif -%}
    <div class="hv-scrim"></div>
    <div class="hv-in">
      {%- if section.settings.eyebrow != blank -%}<div class="hv-ey">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 class="hv-h">{{ section.settings.heading }}</h2>
      {%- if section.settings.cta_text != blank -%}<a class="hv-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} →</a>{%- endif -%}
    </div>
  </div>
</div>
</section>
{% schema %}
{
  "name": "HELIOS Video Banner",
  "tag": "section",
  "settings": [
    { "type": "video", "id": "video", "label": "Background video (autoplay muted loop)" },
    { "type": "image_picker", "id": "image", "label": "Fallback / poster image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dual electric thrusters" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Lounging just became a competition." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Claim yours" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "HELIOS Video Banner" }]
}
{% endschema %}
