{%- comment -%} HELIOS — TikTok testimonials (3 phones desktop / swipe carousel mobile) {%- endcomment -%}
{%- assign sid = section.id -%}
<div class="helios" id="ht-{{ sid }}" style="--acc:#0E7CC4;--acc2:#16A6D6;--accd:#0A5E97;--ink:#0C1A24;--mut:#56636E;font-family:'Inter',system-ui,sans-serif;">
<style>
  #ht-{{ sid }} .ht-wrap{max-width:1040px;margin:0 auto;padding:clamp(46px,7vw,90px) 22px;}
  #ht-{{ sid }} .ht-head{text-align:center;max-width:640px;margin:0 auto 32px;}
  #ht-{{ sid }} .ht-ey{font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--accd);}
  #ht-{{ sid }} .ht-h{font-family:'Archivo',sans-serif;font-weight:800;font-size:clamp(28px,4.5vw,48px);letter-spacing:-.02em;margin:10px 0 0;color:var(--ink);}
  #ht-{{ sid }} .ht-sub{color:var(--mut);font-size:13.5px;margin-top:10px;}
  #ht-{{ sid }} .ht-grid{display:flex;gap:18px;justify-content:center;align-items:flex-start;}
  #ht-{{ sid }} .ht-phone{position:relative;flex:0 0 230px;width:230px;background:#0A1219;border-radius:30px;padding:7px;box-shadow:0 24px 50px -18px rgba(6,30,46,.5);}
  #ht-{{ sid }} .ht-notch{position:absolute;top:7px;left:50%;transform:translateX(-50%);width:80px;height:18px;background:#0A1219;border-radius:0 0 13px 13px;z-index:5;}
  #ht-{{ sid }} .ht-screen{position:relative;border-radius:24px;overflow:hidden;aspect-ratio:9/18;background:#11202b;}
  #ht-{{ sid }} .ht-screen video,#ht-{{ sid }} .ht-screen img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  #ht-{{ sid }} .ht-cap{position:absolute;left:11px;right:11px;bottom:11px;z-index:3;color:#fff;font-size:12px;line-height:1.3;text-shadow:0 1px 8px rgba(0,0,0,.8);pointer-events:none;}
  #ht-{{ sid }} .ht-cap b{font-weight:800;}
  #ht-{{ sid }} .ht-sound{position:absolute;top:11px;right:11px;z-index:6;width:32px;height:32px;border-radius:50%;background:rgba(0,0,0,.5);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:grid;place-items:center;color:#fff;font-size:14px;cursor:pointer;border:none;}
  #ht-{{ sid }} .ht-ph{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;color:#9fb6c4;font-size:12px;}
  #ht-{{ sid }} .ht-dots{display:none;gap:7px;justify-content:center;margin-top:18px;}
  #ht-{{ sid }} .ht-dots button{width:8px;height:8px;border-radius:50%;border:none;background:rgba(12,26,36,.2);padding:0;cursor:pointer;transition:.25s;}
  #ht-{{ sid }} .ht-dots button.on{background:var(--acc);transform:scale(1.3);}
  @media(max-width:760px){
    #ht-{{ sid }} .ht-grid{overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;padding:2px 14px;scroll-padding-left:14px;scrollbar-width:none;-webkit-overflow-scrolling:touch;justify-content:flex-start;}
    #ht-{{ sid }} .ht-grid::-webkit-scrollbar{display:none;}
    #ht-{{ sid }} .ht-phone{flex:0 0 80vw;width:80vw;scroll-snap-align:start;}
    #ht-{{ sid }} .ht-dots{display:flex;}
  }
</style>
<div class="ht-wrap">
  <div class="ht-head">
    <div class="ht-ey">{{ section.settings.eyebrow | default: 'Loved on TikTok' }}</div>
    <h2 class="ht-h">{{ section.settings.heading | default: "It's a whole vibe." }}</h2>
    <p class="ht-sub">Sound on hover (desktop) · tap a clip (mobile)</p>
  </div>
  <div class="ht-grid" id="ht-grid-{{ sid }}">
    {%- for block in section.blocks -%}
      <div class="ht-phone" {{ block.shopify_attributes }}>
        <div class="ht-notch"></div>
        <div class="ht-screen">
          {%- if block.settings.video != blank -%}
            <video data-htv muted loop autoplay playsinline preload="metadata"{% if block.settings.poster != blank %} poster="{{ block.settings.poster | image_url: width: 600 }}"{% endif %}>{%- for s in block.settings.video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}</video>
            <button class="ht-sound" data-htsound aria-label="Toggle sound">🔇</button>
          {%- elsif block.settings.poster != blank -%}
            <img src="{{ block.settings.poster | image_url: width: 600 }}" alt="{{ block.settings.handle | escape }}">
          {%- else -%}
            <div class="ht-ph"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polygon points="5 3 19 12 5 21 5 3"/></svg>add a clip</div>
          {%- endif -%}
          {%- if block.settings.handle != blank -%}<div class="ht-cap"><b>{{ block.settings.handle }}</b><br>{{ block.settings.caption }}</div>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
  <div class="ht-dots" id="ht-dots-{{ sid }}"></div>
</div>
<script>
(function(){
  var r=document.getElementById('ht-{{ sid }}'); if(!r||r.dataset.i)return; r.dataset.i='1';
  var grid=document.getElementById('ht-grid-{{ sid }}');
  if(grid){requestAnimationFrame(function(){try{grid.scrollLeft=0;}catch(e){}});}
  var phones=[].slice.call(r.querySelectorAll('.ht-phone'));
  var vids=[].slice.call(r.querySelectorAll('[data-htv]'));
  var touch=!!(window.matchMedia&&window.matchMedia('(hover:none)').matches);
  function icon(v,on){var b=v.parentElement.querySelector('[data-htsound]');if(b)b.textContent=on?'🔊':'🔇';}
  function muteAll(except){vids.forEach(function(v){if(v!==except){v.muted=true;icon(v,false);}});}
  vids.forEach(function(v){v.muted=true;var p=v.play();if(p&&p.catch)p.catch(function(){});
    var ph=v.closest('.ht-phone');
    if(!touch&&ph){ph.addEventListener('mouseenter',function(){muteAll(v);v.muted=false;v.volume=1;icon(v,true);var q=v.play();if(q&&q.catch)q.catch(function(){});});ph.addEventListener('mouseleave',function(){v.muted=true;icon(v,false);});}
    var b=v.parentElement.querySelector('[data-htsound]');
    if(b)b.addEventListener('click',function(e){e.stopPropagation();if(v.muted){muteAll(v);v.muted=false;v.volume=1;var q=v.play();if(q&&q.catch)q.catch(function(){});icon(v,true);}else{v.muted=true;icon(v,false);}});
  });
  // mobile dots
  var dots=document.getElementById('ht-dots-{{ sid }}');
  if(dots&&phones.length){dots.innerHTML=phones.map(function(_,i){return '<button'+(i===0?' class="on"':'')+'></button>';}).join('');
    var ds=[].slice.call(dots.children);
    ds.forEach(function(d,i){d.addEventListener('click',function(){var p=phones[i];grid.scrollTo({left:p.offsetLeft-(grid.clientWidth-p.clientWidth)/2,behavior:'smooth'});});});
    var t;grid.addEventListener('scroll',function(){clearTimeout(t);t=setTimeout(function(){var c=grid.scrollLeft+grid.clientWidth/2,best=0,bd=1e9;phones.forEach(function(p,i){var cc=p.offsetLeft+p.clientWidth/2,dd=Math.abs(cc-c);if(dd<bd){bd=dd;best=i;}});ds.forEach(function(d,i){d.className=i===best?'on':'';});},60);},{passive:true});}
})();
</script>
</div>
{% schema %}
{"name":"HELIOS TikTok","tag":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Loved on TikTok"},{"type":"text","id":"heading","label":"Heading","default":"It's a whole vibe."}],"blocks":[{"type":"clip","name":"UGC clip","settings":[{"type":"video","id":"video","label":"Vertical video"},{"type":"image_picker","id":"poster","label":"Poster image (optional)"},{"type":"text","id":"handle","label":"Handle","default":"@lakedays"},{"type":"text","id":"caption","label":"Caption","default":"we raced till the batteries died 🌊"}]}],"max_blocks":6,"presets":[{"name":"HELIOS TikTok","blocks":[{"type":"clip","settings":{"handle":"@lakedays","caption":"we raced till the batteries died 🌊"}},{"type":"clip","settings":{"handle":"@poolboy","caption":"best $200 I've spent all summer 🔥"}},{"type":"clip","settings":{"handle":"@summercrew","caption":"whole family wants one now 😂"}}]}]}
{% endschema %}
