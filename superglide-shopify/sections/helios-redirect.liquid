{%- comment -%}
  HELIOS — hard redirect. Used to retire the old product funnels: any product page
  assigned this template is sent straight to the legit funnel (Home / a product page).
  sections/helios-redirect.liquid
{%- endcomment -%}
{%- assign target = section.settings.url | default: '/' -%}
{%- if request.design_mode -%}
  {%- comment -%} Editor only: don't navigate away, just explain. {%- endcomment -%}
  <div style="min-height:50vh;display:grid;place-items:center;font-family:'Archivo',sans-serif;color:#0C1A24;text-align:center;padding:40px 16px;">
    <div style="max-width:420px;">
      <div style="font-family:'Archivo',sans-serif;font-weight:800;font-size:18px;">↪ Old funnel retired</div>
      <p style="margin-top:10px;font-size:13.5px;opacity:.75;">On the live store this page instantly redirects to <b>{{ target }}</b>. This message only shows here in the editor so you can still work on it.</p>
    </div>
  </div>
{%- else -%}
  {%- comment -%} Live: fire immediately, no visible flash. {%- endcomment -%}
  <script>(function(){var t={{ target | json }};try{var s=window.location.search;if(s){t+=(t.indexOf('?')>-1?'&':'?')+s.slice(1);}}catch(e){}window.location.replace(t);})();</script>
  <noscript><meta http-equiv="refresh" content="0;url={{ target }}"></noscript>
  <div style="min-height:60vh;display:grid;place-items:center;">
    <a href="{{ target }}" style="font-family:'Archivo',sans-serif;color:#0E7CC4;font-weight:800;text-decoration:none;opacity:.0;">Continue →</a>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "HELIOS Redirect",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "url", "label": "Redirect to", "default": "/", "info": "Where this old product page should send visitors (e.g. / for Home)." }
  ],
  "presets": [{ "name": "HELIOS Redirect" }]
}
{% endschema %}
