{%- comment -%}
  HELIOS — iPhone-notification-style discount toast (liquid glass).
  Pops up GENTLY from the bottom (above the sticky Add-to-Cart bar), tap-to-copy,
  auto-dismiss, once per session. Floats (position:fixed) so it never blocks the funnel.
  Clear glass — color lives only on the edges (blue top-left → amber bottom-right).
  sections/helios-promo-toast.liquid
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- if section.settings.enabled -%}
{%- assign vpos = section.settings.vpos | default: 'bottom' -%}
{%- assign off = section.settings.offset | default: 120 -%}
{%- assign off_d = section.settings.offset_desktop | default: 100 -%}
{%- if vpos == 'top' -%}{%- assign hide_tf = 'translateY(-220%)' -%}{%- else -%}{%- assign hide_tf = 'translateY(220%)' -%}{%- endif -%}
<div class="helios" id="pt-{{ sid }}">
<style>
  #pt-{{ sid }}-toast{position:fixed;left:50%;{{ vpos }}:{{ off }}px;
    transform:translateX(-50%) {{ hide_tf }};z-index:78;
    width:min(92vw,372px);cursor:pointer;opacity:0;
    transition:transform .72s cubic-bezier(.22,.61,.36,1),opacity .55s ease;
    -webkit-tap-highlight-color:transparent;}
  #pt-{{ sid }}-toast.in{transform:translateX(-50%) translateY(0);opacity:1;}
  @media(min-width:760px){
    #pt-{{ sid }}-toast{left:auto;right:20px;{{ vpos }}:{{ off_d }}px;
      transform:translateX(0) {{ hide_tf }};}
    #pt-{{ sid }}-toast.in{transform:translateX(0) translateY(0);}
  }
  /* the glass — clear, no colour in the body */
  #pt-{{ sid }} .g{position:relative;display:flex;align-items:center;gap:13px;padding:13px 15px;border-radius:22px;overflow:hidden;
    background:rgba(255,255,255,.10);
    backdrop-filter:blur(30px) saturate(200%) brightness(1.06);-webkit-backdrop-filter:blur(30px) saturate(200%) brightness(1.06);
    box-shadow:0 22px 60px -16px rgba(8,20,35,.55), inset 0 1px 0 rgba(255,255,255,.7), inset 0 -1px 0 rgba(255,255,255,.18);}
  /* colour ONLY on the edge: a 1.5px gradient ring, blue at top-left → clear → amber at bottom-right */
  #pt-{{ sid }} .g::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1.5px;pointer-events:none;
    background:linear-gradient(135deg,
      rgba(96,176,255,.95) 0%, rgba(96,176,255,.35) 16%,
      rgba(255,255,255,.45) 42%, rgba(255,255,255,.45) 58%,
      rgba(255,193,92,.35) 84%, rgba(255,193,92,.95) 100%);
    -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;mask-composite:exclude;}
  /* faint diagonal sheen sweeping the top-left, fades fast */
  #pt-{{ sid }} .shine{position:absolute;inset:0;pointer-events:none;border-radius:inherit;
    background:linear-gradient(118deg,rgba(255,255,255,.45) 0%,rgba(255,255,255,0) 20%);}
  #pt-{{ sid }} .ic{position:relative;z-index:2;width:42px;height:42px;flex:0 0 42px;border-radius:13px;display:grid;place-items:center;font-size:20px;
    background:linear-gradient(135deg,#0E7CC4,#16A6D6);box-shadow:0 6px 16px rgba(14,124,196,.42), inset 0 1px 0 rgba(255,255,255,.4);}
  #pt-{{ sid }} .tx{position:relative;z-index:2;flex:1;min-width:0;color:#0B1722;}
  #pt-{{ sid }} .tx .h{font-family:'Archivo',sans-serif;font-weight:800;font-size:14px;line-height:1.15;text-shadow:0 1px 0 rgba(255,255,255,.4);}
  #pt-{{ sid }} .tx .s{font-size:12px;color:#2c3a45;margin-top:2px;}
  #pt-{{ sid }} .tx .code{display:inline-flex;align-items:center;gap:6px;margin-top:6px;font-family:'Archivo',sans-serif;font-weight:800;font-size:13px;letter-spacing:.06em;color:#0A5E97;background:rgba(255,255,255,.5);border:1px dashed rgba(14,124,196,.55);border-radius:9px;padding:4px 9px;}
  #pt-{{ sid }} .x{position:relative;z-index:2;flex:0 0 auto;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;color:#2c3a45;background:rgba(255,255,255,.42);font-size:13px;border:none;cursor:pointer;}
  @media(prefers-reduced-motion:reduce){ #pt-{{ sid }}-toast{transition:opacity .4s ease;} }
</style>
  <div id="pt-{{ sid }}-toast" role="button" aria-label="Copy discount code">
    <div class="g">
      <span class="shine"></span>
      <div class="ic">🎉</div>
      <div class="tx">
        <div class="h">{{ section.settings.headline }}</div>
        <div class="s">{{ section.settings.subtext }}</div>
        <span class="code" data-code>{{ section.settings.code }} <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg></span>
      </div>
      <button class="x" data-x aria-label="Dismiss">✕</button>
    </div>
  </div>
<script>
(function(){
  var root=document.getElementById('pt-{{ sid }}'); if(!root||root.dataset.init)return; root.dataset.init='1';
  var toast=document.getElementById('pt-{{ sid }}-toast');
  var code={{ section.settings.code | json }};
  var key='helios_pt_{{ sid }}';
  try{ if(sessionStorage.getItem(key)==='1') return; }catch(e){}
  var hideT;
  function show(){ toast.classList.add('in'); hideT=setTimeout(hide,{{ section.settings.auto_hide | default: 9 | times: 1000 }}); }
  function hide(){ toast.classList.remove('in'); try{sessionStorage.setItem(key,'1');}catch(e){} }
  setTimeout(show,{{ section.settings.delay | default: 1500 }});
  toast.querySelector('[data-x]').addEventListener('click',function(e){ e.stopPropagation(); clearTimeout(hideT); hide(); });
  toast.addEventListener('click',function(){
    var done=function(){ var c=toast.querySelector('[data-code]'); var html=c.innerHTML; c.textContent='✓ Copied '+code+'!'; clearTimeout(hideT); setTimeout(function(){ c.innerHTML=html; },1600); setTimeout(hide,2200); };
    if(navigator.clipboard){ navigator.clipboard.writeText(code).then(done).catch(done); } else done();
  });
})();
</script>
</div>
{%- endif -%}
{% schema %}
{
  "name": "HELIOS Promo Toast",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show promo toast", "default": true },
    { "type": "header", "content": "Position — drag to place it" },
    { "type": "select", "id": "vpos", "label": "Anchor", "options": [ { "value": "top", "label": "From the top" }, { "value": "bottom", "label": "From the bottom" } ], "default": "bottom" },
    { "type": "range", "id": "offset", "label": "Distance from edge — mobile", "min": 8, "max": 600, "step": 4, "unit": "px", "default": 200 },
    { "type": "range", "id": "offset_desktop", "label": "Distance from edge — desktop", "min": 8, "max": 600, "step": 4, "unit": "px", "default": 120 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "🎉 4th of July — $20 OFF" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Tap to copy your code" },
    { "type": "text", "id": "code", "label": "Discount code", "default": "4OFJULY" },
    { "type": "range", "id": "delay", "label": "Delay before showing (ms)", "min": 0, "max": 6000, "step": 250, "default": 1500 },
    { "type": "range", "id": "auto_hide", "label": "Auto-hide after (seconds)", "min": 4, "max": 20, "step": 1, "default": 9 }
  ],
  "presets": [{ "name": "HELIOS Promo Toast" }]
}
{% endschema %}
