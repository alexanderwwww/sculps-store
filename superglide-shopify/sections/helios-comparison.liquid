{%- comment -%}
  HELIOS — Comparison table (Super Glide vs ordinary float).
  sections/helios-comparison.liquid
{%- endcomment -%}
{%- assign sid = section.id -%}
<section class="helios" id="hc-{{ sid }}">
<style>
  #hc-{{ sid }} .wrap{max-width:900px;margin:0 auto;padding:clamp(40px,7vw,88px) 22px;}
  #hc-{{ sid }} .head{text-align:center;max-width:640px;margin:0 auto 40px;}
  #hc-{{ sid }} .ey{font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--helios-accd,#0A5E97);}
  #hc-{{ sid }} h2{font-family:'Archivo';font-weight:800;font-size:clamp(28px,4.2vw,46px);letter-spacing:-.02em;margin:12px 0 0;}
  #hc-{{ sid }} .tbl{border:var(--helios-g-bd,1px solid rgba(255,255,255,.65));border-radius:22px;overflow:hidden;background:var(--helios-g-bg,rgba(255,255,255,.55));backdrop-filter:var(--helios-g-blur);box-shadow:var(--helios-g-sh);}
  #hc-{{ sid }} .row{display:grid;grid-template-columns:1.5fr 1fr 1fr;align-items:center;}
  #hc-{{ sid }} .row + .row{border-top:1px solid var(--helios-lins,rgba(12,26,36,.08));}
  #hc-{{ sid }} .hr{background:rgba(255,255,255,.45);}
  #hc-{{ sid }} .c{padding:15px 16px;font-size:14px;}
  #hc-{{ sid }} .feat{font-weight:600;}
  #hc-{{ sid }} .us{text-align:center;background:rgba(14,124,196,.08);color:var(--helios-accd,#0A5E97);font-size:18px;font-weight:800;}
  #hc-{{ sid }} .them{text-align:center;color:#b7c2cb;font-size:18px;font-weight:700;}
  #hc-{{ sid }} .hcell{font-family:'Archivo';font-weight:900;font-size:15px;text-align:center;}
  #hc-{{ sid }} .hcell.us{color:var(--helios-accd,#0A5E97);}
  #hc-{{ sid }} .hcell.them{color:var(--helios-mut,#56636E);}
</style>
<div class="wrap">
  <div class="head">
    {%- if section.settings.eyebrow != blank -%}<div class="ey">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="tbl" data-reveal>
    <div class="row hr">
      <div class="c feat" style="color:var(--helios-mut,#56636E);font-weight:700;font-size:13px;">Feature</div>
      <div class="c hcell us">{{ section.settings.us_label | default: 'HELIOS' }}</div>
      <div class="c hcell them">{{ section.settings.them_label | default: 'Ordinary float' }}</div>
    </div>
    {%- for block in section.blocks -%}
      <div class="row" {{ block.shopify_attributes }}>
        <div class="c feat">{{ block.settings.feature }}</div>
        <div class="c us">{% if block.settings.us %}✓{% else %}—{% endif %}</div>
        <div class="c them">{% if block.settings.them %}✓{% else %}✕{% endif %}</div>
      </div>
    {%- endfor -%}
  </div>
</div>
</section>
{% schema %}
{
  "name": "HELIOS Comparison",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HELIOS vs an ordinary float." },
    { "type": "text", "id": "us_label", "label": "Our column", "default": "HELIOS" },
    { "type": "text", "id": "them_label", "label": "Their column", "default": "Ordinary float" }
  ],
  "blocks": [
    { "type": "row", "name": "Comparison row", "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Motorized propulsion" },
      { "type": "checkbox", "id": "us", "label": "HELIOS has it", "default": true },
      { "type": "checkbox", "id": "them", "label": "Ordinary float has it", "default": false }
    ]}
  ],
  "presets": [{
    "name": "HELIOS Comparison",
    "blocks": [
      { "type": "row", "settings": { "feature": "Motorized — no paddling", "us": true, "them": false } },
      { "type": "row", "settings": { "feature": "360° joystick steering", "us": true, "them": false } },
      { "type": "row", "settings": { "feature": "Pop-up UPF50+ canopy", "us": true, "them": false } },
      { "type": "row", "settings": { "feature": "Dual cup holders", "us": true, "them": false } },
      { "type": "row", "settings": { "feature": "Cushioned backrest + headrest", "us": true, "them": false } },
      { "type": "row", "settings": { "feature": "Holds up to 300 lb", "us": true, "them": false } }
    ]
  }]
}
{% endschema %}
