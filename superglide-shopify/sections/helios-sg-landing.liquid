#mk .cb{flex:0 0 auto;display:flex;gap:8px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:100px;padding:6px 16px 6px 6px;box-shadow:0 8px 22px -14px rgba(15,27,45,.3)}
