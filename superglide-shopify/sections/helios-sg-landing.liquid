{%- comment -%} HELIOS Super Glide — v3: motion, memory-wall, rich dad duo, finale band, sticky buy bar, ETA, ATC carries discount. Theme provides header/announcement/footer. {%- endcomment -%}
<style>
body{overflow-x:clip}
#mk{--bg:#fff;--alt:#F5F6F8;--ink:#0E1116;--mut:#5C6672;--line:#E5E7EB;--ok:#16A34A;--grn:#10C97E;--star:#F5A623;--glass:rgba(22,163,74,.10);
  position:relative;width:100vw;margin-left:calc(50% - 50vw);
  background:var(--bg);color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;overflow-x:clip}
#mk *{box-sizing:border-box}
#mk .media,#mk .panel{min-width:0;max-width:100%}
#mk img{max-width:100%;display:block}
#mk a{text-decoration:none;color:inherit}
#mk .wrap{max-width:1040px;margin:0 auto;padding:0 18px}
#mk h2{font-size:clamp(21px,2.6vw,29px);font-weight:800;letter-spacing:-.02em;line-height:1.14;margin:0}
#mk .eyebrow{font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink)}
#mk .stars{color:var(--star);letter-spacing:1.5px}
/* scroll reveal */
#mk .rv{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
#mk .rv.in{opacity:1;transform:none}
/* title — word stagger + green shimmer */
#mk .ptitle{text-align:center;padding:24px 18px 4px;max-width:780px;margin:0 auto}
#mk .ptitle h1{font-weight:800;font-size:clamp(19px,4.6vw,36px);line-height:1.14;letter-spacing:-.022em;margin:0;text-wrap:balance}
#mk .ptitle .w{display:inline-block;opacity:0;transform:translateY(14px);transition:opacity .55s ease,transform .55s ease;transition-delay:calc(var(--i)*45ms)}
#mk .ptitle.go .w{opacity:1;transform:none}
#mk .ptitle .it .w{background:linear-gradient(90deg,#137a3e,#10C97E,#0e9e63,#137a3e);background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:mkshim 5.5s linear infinite}
@keyframes mkshim{to{background-position:220% 0}}
#mk .tstrip{display:flex;gap:7px 18px;justify-content:center;flex-wrap:wrap;margin:12px auto 0;font-size:12.5px;color:var(--mut);font-weight:600}
#mk .tstrip b{color:var(--ink)}
/* BUY BOX */
#mk .buy{display:grid;grid-template-columns:1fr;gap:22px;padding:14px 0 8px}
@media(min-width:900px){#mk .buy{grid-template-columns:1fr 1.5fr;gap:34px;align-items:start}}
@media(max-width:899px){#mk .media{order:2}#mk .panel{order:1}}
#mk .phone{position:relative;width:min(300px,82vw);margin:0 auto;aspect-ratio:9/16;border-radius:26px;overflow:hidden;background:#0E1116;border:1px solid var(--line);box-shadow:0 30px 60px -34px rgba(14,17,22,.6);animation:mkbob 6.5s ease-in-out infinite}
@keyframes mkbob{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
#mk .phone img,#mk .phone video{width:100%;height:100%;object-fit:cover}
#mk .phone .snd{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);background:rgba(255,255,255,.2);color:#fff;font-size:11px;font-weight:700;padding:5px 12px;border-radius:100px;border:1px solid rgba(255,255,255,.3);cursor:pointer;white-space:nowrap}
#mk .seefull{display:flex;align-items:center;justify-content:center;gap:8px;max-width:300px;margin:16px auto 0;text-align:center;background:#fff;border:2px solid var(--ink);color:var(--ink);font-weight:800;font-size:15px;padding:14px;border-radius:100px;box-shadow:0 10px 24px -14px rgba(14,17,22,.4);transition:background .15s,transform .15s}
#mk .seefull:hover{background:#F4F5F6;transform:translateY(-1px)}
#mk .seefull .ar{display:inline-block;animation:mknudge 1.8s ease-in-out infinite}
@keyframes mknudge{0%,100%{transform:translateX(0)}50%{transform:translateX(5px)}}
/* fast-shipping chips under video */
#mk .smar{overflow:hidden;-webkit-mask:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);margin-top:16px;max-width:340px;margin-left:auto;margin-right:auto}
#mk .smar .row{display:flex;gap:8px;width:max-content;padding:4px 2px;animation:mkcm 40s linear infinite}
#mk .sc{flex:0 0 auto;display:flex;gap:6px;align-items:center;background:var(--glass);border:1px solid rgba(22,163,74,.28);border-radius:100px;padding:5px 12px;font-size:11.5px;font-weight:700;color:#137a3e;white-space:nowrap}
/* gallery */
#mk .gal{display:flex;gap:9px;align-items:flex-start}
#mk .gthumbs{display:flex;flex-direction:column;gap:8px;flex:0 0 auto}
#mk .gth{width:52px;aspect-ratio:1/1;border-radius:9px;overflow:hidden;border:1.5px solid var(--line);cursor:pointer;opacity:.5;transition:opacity .2s,border-color .2s;background:var(--alt)}
#mk .gth.on{opacity:1;border-color:var(--ink)}
#mk .gth img{width:100%;height:100%;object-fit:cover}
#mk .gmain{flex:1;min-width:0;position:relative;aspect-ratio:1/1;max-height:370px;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--alt);cursor:zoom-in}
#mk .gmain img{width:100%;height:100%;object-fit:cover}
#mk .gmain .zoom{position:absolute;bottom:9px;right:9px;background:rgba(14,17,22,.7);color:#fff;font-size:10px;font-weight:700;padding:3px 8px;border-radius:7px}
@media(max-width:899px){#mk .gal{flex-direction:column-reverse}#mk .gthumbs{flex-direction:row;overflow-x:auto;width:100%;scrollbar-width:none}#mk .gthumbs::-webkit-scrollbar{display:none}#mk .gth{flex:0 0 auto;width:56px}#mk .gmain{max-height:none;width:100%}}
#mk .ptl{font-size:20px;font-weight:800;letter-spacing:-.01em;margin:15px 0 0}
#mk .social{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:6px 0 0;font-size:13px;color:var(--mut)}
#mk .social b{color:var(--ink)}
#mk .pills{display:flex;flex-wrap:wrap;gap:7px;margin:13px 0 0}
#mk .pill{display:inline-flex;align-items:center;gap:6px;background:var(--glass);border:1px solid rgba(22,163,74,.30);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:#137a3e;font-size:12px;font-weight:700;padding:6px 11px;border-radius:100px}
#mk .pill .c{color:var(--ok);font-weight:900}
#mk .opts{display:grid;gap:9px;margin-top:16px}
#mk .opt{display:flex;align-items:center;gap:11px;padding:12px 13px;border:1.5px solid var(--line);border-radius:13px;cursor:pointer;position:relative;background:#fff}
#mk .opt.on{border-color:var(--ink);border-width:2px;background:#FAFBFC}
#mk .opt .radio{width:20px;height:20px;border-radius:50%;border:2px solid #C4CDD8;flex:0 0 auto}
#mk .opt.on .radio{border:6.5px solid var(--ink)}
#mk .opt .pic{width:40px;height:40px;border-radius:8px;object-fit:cover;flex:0 0 auto;border:1px solid var(--line)}
#mk .opt .lbl{flex:1;min-width:0}
#mk .opt .lbl b{display:block;font-size:14px;font-weight:800}
#mk .opt .lbl span{font-size:12px;color:var(--mut)}
#mk .opt .pr{text-align:right;flex:0 0 auto}
#mk .opt .pr b{font-size:15px;font-weight:800}
#mk .opt .pr s{display:block;font-size:11.5px;color:#9AA6B2}
#mk .opt .tag{position:absolute;top:-9px;left:13px;font-size:9px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:#fff;background:var(--ink);padding:3px 8px;border-radius:20px}
#mk .dbn{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:14px;background:linear-gradient(90deg,#FFE9B0,#FFD36B,#FFE9B0);color:#5A3E00;font-size:12px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;padding:9px 12px;border-radius:12px}
#mk .ob{background:#0A0E12;border-radius:18px;padding:18px 16px;text-align:center;margin-top:10px;cursor:pointer;transition:transform .12s,box-shadow .2s}
#mk .ob:hover{transform:translateY(-2px);box-shadow:0 16px 34px -14px rgba(10,14,18,.55)}
#mk .ob:active{transform:translateY(0)}
#mk .ob .hh{font-weight:800;font-size:15px;color:#fff}
#mk .ob .pl{display:flex;align-items:baseline;justify-content:center;gap:11px;margin-top:5px}
#mk .ob .pl s{font-size:18px;color:rgba(255,255,255,.42);font-weight:700}
#mk .ob .pl b{font-weight:900;font-size:38px;color:var(--grn);line-height:1;letter-spacing:-.02em}
#mk .ob .sv{display:inline-block;margin-top:9px;font-size:12px;font-weight:800;color:#06281B;background:var(--grn);padding:5px 13px;border-radius:100px}
#mk .cta{display:block;width:100%;text-align:center;margin-top:10px;background:var(--grn);color:#06281B;font-size:17px;font-weight:900;padding:17px;border:none;border-radius:100px;cursor:pointer;position:relative;overflow:hidden;box-shadow:0 16px 34px -12px rgba(16,201,126,.55);transition:box-shadow .2s,transform .15s}
#mk .cta:hover{transform:translateY(-1px);box-shadow:0 20px 40px -12px rgba(16,201,126,.65)}
#mk .cta .gp{color:#06281B;font-weight:900}
#mk .cta:after{content:'';position:absolute;top:0;left:-60%;width:36%;height:100%;background:linear-gradient(105deg,transparent,rgba(255,255,255,.14),transparent);animation:mksheen 3.4s ease-in-out infinite}
@keyframes mksheen{0%{left:-60%}55%{left:130%}100%{left:130%}}
#mk .cta small{display:block;font-weight:600;font-size:11.5px;opacity:.75;margin-top:3px}
#mk .eta{display:flex;align-items:center;justify-content:center;gap:7px;margin-top:11px;font-size:12.5px;font-weight:700;color:var(--ink)}
#mk .eta .dot{width:8px;height:8px;border-radius:50%;background:var(--grn);animation:mkpulse 1.8s ease-in-out infinite}
@keyframes mkpulse{0%,100%{box-shadow:0 0 0 0 rgba(16,201,126,.5)}50%{box-shadow:0 0 0 6px rgba(16,201,126,0)}}
#mk .coupon{text-align:center;margin-top:9px;font-size:12px;color:#137a3e;font-weight:700}
#mk .guar{display:flex;gap:8px 16px;justify-content:center;flex-wrap:wrap;margin-top:9px;font-size:12px;color:var(--mut);font-weight:600}
#mk .pays{display:flex;gap:6px;justify-content:center;margin-top:9px;flex-wrap:wrap}
#mk .pays span{font-size:9.5px;font-weight:700;color:var(--mut);border:1px solid var(--line);border-radius:5px;padding:3px 7px;letter-spacing:.03em}
/* sections */
#mk .sec{padding-top:44px;padding-bottom:44px}
#mk .sec.alt{background:var(--alt)}
#mk .sec .head{text-align:center;max-width:640px;margin:0 auto 24px}
#mk .sec .head h2{margin-top:7px}
/* FAQ */
#mk .faqs{max-width:720px;margin:0 auto;display:grid;gap:10px}
#mk .fq{border:1px solid var(--line);border-radius:12px;background:#fff;overflow:hidden;transition:border-color .25s}
#mk .fq.on{border-color:var(--ink)}
#mk .fq.done{border-color:rgba(22,163,74,.4)}
#mk .fq .q{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 16px;cursor:pointer;font-weight:700;font-size:14.5px}
#mk .fq .ico{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:14px;transition:transform .3s,background .3s}
#mk .fq.on .ico{transform:rotate(135deg)}
#mk .fq.done:not(.on) .ico{background:var(--ok);transform:none}
#mk .fq .p{max-height:0;overflow:hidden;transition:max-height .35s ease}
#mk .fq .p .in{padding:0 16px 15px;color:var(--mut);font-size:13.5px}
/* reviews — swipeable glass carousel (homepage style) */
#mk .rvtrack{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:6px 4px 10px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
#mk .rvtrack::-webkit-scrollbar{display:none}
#mk .rvc{scroll-snap-align:center;flex:0 0 84%;display:flex;flex-direction:column;gap:11px;background:rgba(255,255,255,.62);border:1px solid rgba(255,255,255,.75);backdrop-filter:blur(18px) saturate(160%);-webkit-backdrop-filter:blur(18px) saturate(160%);border-radius:20px;padding:16px;box-shadow:0 18px 44px -20px rgba(15,27,45,.32)}
@media(min-width:560px){#mk .rvc{flex-basis:48%}}
@media(min-width:880px){#mk .rvc{flex-basis:calc(33.333% - 11px)}}
#mk .rvc>img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:13px}
#mk .rvc .rtop{display:flex;align-items:center;justify-content:space-between}
#mk .rvc p{font-size:13.5px;color:#2B3A4A;margin:0;line-height:1.5}
#mk .rvc .rby{display:flex;align-items:center;gap:9px;margin-top:auto}
#mk .rvc .rav{width:32px;height:32px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-weight:700;font-size:12px;flex:0 0 auto}
#mk .rvc .rnm{font-size:12.5px;font-weight:700}
#mk .rvc .rnm span{display:block;color:var(--mut);font-weight:500;font-size:11px}
#mk .rvc .rvf{margin-left:auto;font-size:10.5px;font-weight:700;color:var(--ok);background:var(--glass);padding:3px 8px;border-radius:20px}
#mk .rdots{display:flex;gap:6px;justify-content:center;margin-top:14px}
#mk .rdot{width:7px;height:7px;border-radius:50%;background:rgba(14,17,22,.18);transition:all .25s;cursor:pointer;border:none;padding:0}
#mk .rdot.on{background:var(--ink);width:20px;border-radius:4px}
/* flowing comments — two rows, opposite directions */
#mk .cmar{overflow:hidden;-webkit-mask:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);margin-top:22px}
#mk .cmar .row{display:flex;gap:9px;width:max-content;padding:5px 4px;animation:mkcm 58s linear infinite}
#mk .cmar .rb{animation:mkcm2 48s linear infinite}
#mk .cmar:hover .row{animation-play-state:paused}
#mk .cb{flex:0 0 auto;display:flex;gap:8px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:100px;padding:5px 15px 5px 5px;box-shadow:0 8px 22px -16px rgba(15,27,45,.3)}
#mk .cb .av{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:800;font-size:11px;flex:0 0 auto}
#mk .cb .tx{font-size:13px;white-space:nowrap}
#mk .cb .tx b{font-weight:700}
@keyframes mkcm{to{transform:translateX(-50%)}}
@keyframes mkcm2{from{transform:translateX(-50%)}to{transform:translateX(0)}}
/* MEMORY WALL (scrapbook) */
#mk .memsec{background:#F8F5EF}
#mk .mem{display:grid;grid-template-columns:repeat(2,1fr);gap:22px 14px;max-width:960px;margin:0 auto;padding-top:8px}
@media(min-width:760px){#mk .mem{grid-template-columns:repeat(3,1fr);gap:32px 24px}#mk .mem .pol:nth-child(3n+2){transform:rotate(var(--r,0deg)) translateY(18px)}}
#mk .pol{position:relative;background:#fff;border:1px solid #EAE4D8;border-radius:4px;padding:10px 10px 34px;box-shadow:0 14px 30px -18px rgba(60,50,30,.35);transform:rotate(var(--r,0deg));transition:transform .35s ease,box-shadow .35s ease;cursor:pointer}
#mk .pol:hover{transform:rotate(0deg) translateY(-6px) scale(1.03);box-shadow:0 30px 55px -22px rgba(60,50,30,.45);z-index:2}
#mk .pol:before{content:'';position:absolute;top:-10px;left:50%;width:72px;height:22px;transform:translateX(-50%) rotate(var(--tr,-2deg));background:rgba(255,238,170,.6);border:1px solid rgba(180,160,90,.25);box-shadow:0 2px 5px rgba(0,0,0,.08);z-index:3}
#mk .pol .shot{overflow:hidden;border-radius:2px}
#mk .pol .shot img{width:100%;aspect-ratio:1/1;object-fit:cover;transition:transform .5s ease}
#mk .pol:hover .shot img{transform:scale(1.06)}
#mk .pol .cap{position:absolute;left:0;right:0;bottom:9px;text-align:center;font-family:Georgia,serif;font-style:italic;font-size:13px;color:#4a4436}
#mk .pol.ctap .shot{display:grid;place-items:center;aspect-ratio:1/1;border:2px dashed #CFC6B4;background:#FCFAF5;text-align:center}
#mk .pol.ctap .plus{font-size:46px;font-weight:300;color:#B9AE97;line-height:1}
#mk .pol.ctap .txt{margin-top:10px;font-size:13px;font-weight:700;color:#6b6252;padding:0 16px}
@media(min-width:760px){#mk .pol.ctap{grid-column:2}}
@media(max-width:759px){#mk .pol.ctap{grid-column:1/-1;max-width:330px;width:100%;margin:0 auto}}
/* DAD duo */
#mk .dad{display:grid;grid-template-columns:1fr;gap:26px;align-items:center;max-width:980px;margin:0 auto}
@media(min-width:860px){#mk .dad{grid-template-columns:1.1fr 1fr}}
#mk .duo{display:flex;gap:14px;justify-content:center;align-items:center}
#mk .duo .phone{width:min(218px,42vw);margin:0;animation:none}
#mk .duo .phone:first-child{transform:rotate(-3deg)}
#mk .duo .phone:last-child{transform:rotate(2.5deg)}
#mk .dad .tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}
#mk .dad .tags span{font-size:12px;font-weight:700;color:var(--ink);background:rgba(14,17,22,.06);padding:5px 10px;border-radius:100px}
#mk .dad .q{margin:14px 0 0;padding-left:13px;border-left:3px solid var(--grn);font-family:Georgia,serif;font-style:italic;font-size:14.5px;color:#3d4a56}
/* education */
#mk .spec{max-width:720px;margin:16px auto 0;display:grid;grid-template-columns:1fr;gap:9px}
@media(min-width:640px){#mk .spec{grid-template-columns:1fr 1fr}}
#mk .spec div{display:flex;gap:9px;font-size:13.5px;background:#fff;border:1px solid var(--line);border-radius:11px;padding:12px 14px}
#mk .spec b{color:var(--ok);flex:0 0 auto;font-weight:900}
/* FINALE band */
#mk .finale{background:#0A0E12;color:#fff;text-align:center;overflow:hidden;position:relative}
#mk .finale h2{color:#fff;font-size:clamp(24px,3.4vw,38px)}
#mk .finale .sub2{color:rgba(255,255,255,.65);margin:12px auto 0;max-width:36ch;font-size:15px}
#mk .finale .btn{display:inline-block;margin-top:22px;background:var(--grn);color:#06281B;font-size:16.5px;font-weight:900;padding:16px 36px;border-radius:100px;cursor:pointer;box-shadow:0 18px 40px -14px rgba(16,201,126,.6);transition:transform .15s}
#mk .finale .btn:hover{transform:translateY(-2px)}
#mk .fbadges{display:flex;gap:10px 22px;justify-content:center;flex-wrap:wrap;margin-top:24px;font-size:12px;color:rgba(255,255,255,.6);font-weight:600}
#mk .brand{font-weight:900;letter-spacing:.1em;font-size:clamp(58px,13vw,170px);line-height:1;margin-top:34px;background:linear-gradient(100deg,#0E7C64 0%,#10C97E 30%,#8CF5CB 50%,#10C97E 70%,#0E7C64 100%);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:mkshim 7s linear infinite;user-select:none}
#mk .wave{height:5px;max-width:420px;margin:26px auto 0;border-radius:10px;background:linear-gradient(90deg,transparent,#10C97E,transparent);background-size:60% 100%;background-repeat:no-repeat;animation:mkwave 3.2s ease-in-out infinite alternate}
@keyframes mkwave{from{background-position:-40% 0}to{background-position:140% 0}}
/* sticky buy bar */
#mkstick{position:fixed;left:12px;right:12px;bottom:12px;z-index:80;max-width:560px;margin:0 auto;background:#0A0E12;border-radius:100px;padding:8px 8px 8px 8px;display:flex;align-items:center;gap:10px;box-shadow:0 20px 44px -14px rgba(10,14,18,.6),0 8px 30px -8px rgba(16,201,126,.3);transform:translateY(160%);transition:transform .4s ease}
#mkstick.show{transform:none}
#mkstick .th{width:40px;height:40px;border-radius:50%;object-fit:cover;flex:0 0 auto;border:2px solid rgba(255,255,255,.2)}
#mkstick .l{min-width:0}
#mkstick .l b{display:block;color:#fff;font-size:12.5px;font-weight:800;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#mkstick .l span{color:var(--grn);font-size:12px;font-weight:800}
#mkstick button{margin-left:auto;flex:0 0 auto;background:var(--grn);color:#06281B;border:none;font-size:13.5px;font-weight:900;padding:12px 20px;border-radius:100px;cursor:pointer}
/* lightbox */
#mk .lb{position:fixed;inset:0;z-index:100;background:rgba(10,12,15,.93);display:none;align-items:center;justify-content:center;padding:20px}
#mk .lb.on{display:flex}
#mk .lb img{max-width:92vw;max-height:82vh;border-radius:14px}
#mk .lb .x{position:absolute;top:14px;right:18px;color:#fff;font-size:32px;cursor:pointer;line-height:1}
#mk .lb .nav{position:absolute;top:50%;transform:translateY(-50%);color:#fff;font-size:44px;cursor:pointer;padding:8px 14px;user-select:none}
#mk .lb .prev{left:6px}
#mk .lb .next{right:6px}
@media(prefers-reduced-motion:reduce){
  #mk .cta:after,#mk .phone,#mk .eta .dot,#mk .seefull .ar,#mk .brand,#mk .wave,#mk .ptitle .it .w{animation:none}
  #mk .rv,#mk .ptitle .w{opacity:1;transform:none;transition:none}
}
</style>
