<script>
(function(){
  var root=document.getElementById('mk'); if(!root||root.dataset.i)return; root.dataset.i='1';
  var DISC='SUPERGLIDEIT', sel='47935890817189', busy=false;
  // UGC sound
  [].slice.call(root.querySelectorAll('.phone .snd')).forEach(function(b){
    var v=document.getElementById(b.getAttribute('data-v')); if(!v)return;
    var u=function(){v.muted=!v.muted;b.textContent=v.muted?'Tap for sound':'Tap to mute';var p=v.play();if(p&&p.catch)p.catch(function(){});};
    v.addEventListener('click',u); b.addEventListener('click',u);
  });
  // gallery
  var gthumbs=[].slice.call(document.querySelectorAll('#gthumbs .gth'));
  var gimgs=gthumbs.map(function(t){return t.getAttribute('data-src');});
  var gmainImg=document.getElementById('gmainimg'), gi=0;
  function setG(i){gi=(i%gimgs.length+gimgs.length)%gimgs.length;gmainImg.src=gimgs[gi];gthumbs.forEach(function(x,j){x.classList.toggle('on',j===gi);});}
  gthumbs.forEach(function(t,i){t.addEventListener('click',function(){setG(i);});});
  // lightbox
  var lb=document.getElementById('lb'),lbimg=document.getElementById('lbimg');
  document.getElementById('gmain').addEventListener('click',function(){lbimg.src=gimgs[gi];lb.classList.add('on');});
  [].slice.call(document.querySelectorAll('#ootw img')).forEach(function(im){im.addEventListener('click',function(){lbimg.src=im.src;lb.classList.add('on');});});
  document.getElementById('lbx').addEventListener('click',function(){lb.classList.remove('on');});
  lb.addEventListener('click',function(e){if(e.target===lb)lb.classList.remove('on');});
  document.getElementById('lbp').addEventListener('click',function(e){e.stopPropagation();setG(gi-1);lbimg.src=gimgs[gi];});
  document.getElementById('lbn').addEventListener('click',function(e){e.stopPropagation();setG(gi+1);lbimg.src=gimgs[gi];});
  document.addEventListener('keydown',function(e){if(!lb.classList.contains('on'))return;if(e.key==='Escape')lb.classList.remove('on');if(e.key==='ArrowLeft'){setG(gi-1);lbimg.src=gimgs[gi];}if(e.key==='ArrowRight'){setG(gi+1);lbimg.src=gimgs[gi];}});
  // bundles
  var opts=[].slice.call(document.querySelectorAll('#opts .opt'));
  var ctap=document.getElementById('ctap'), ctasv=document.getElementById('ctasv'), ctalbl=document.getElementById('ctalbl');
  var LBL={ '47935890882725':'Get 2 + 2 now', '47935890817189':'Get it 1 + 1 now', '47945658269861':'Get yours now' };
  opts.forEach(function(o){o.addEventListener('click',function(){
    opts.forEach(function(x){x.classList.remove('on');}); o.classList.add('on');
    sel=o.getAttribute('data-vid');
    if(ctap)ctap.textContent=o.getAttribute('data-p');
    if(ctalbl)ctalbl.textContent=LBL[sel]||'Get it now';
    if(ctasv)ctasv.textContent=o.getAttribute('data-sv')+' · 12% code applies at checkout';
  });});
  // add to cart (stays in flow: adds, then opens cart)
  function addThen(dest,fallback){
    if(busy)return; busy=true;
    try{
      fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:parseInt(sel,10),quantity:1}]})})
        .then(function(r){ if(!r.ok)throw 0; window.location.href=dest; })
        .catch(function(){ busy=false; window.location.href=fallback; });
    }catch(e){ busy=false; window.location.href=fallback; }
  }
  var atc=document.getElementById('atc');
  if(atc)atc.addEventListener('click',function(){ addThen('/cart','/cart/'+sel+':1'); });
  var cta=document.getElementById('cta');
  if(cta)cta.addEventListener('click',function(){ addThen('/discount/'+DISC+'?redirect=%2Fcheckout','/cart/'+sel+':1?discount='+DISC); });
  // scroll-to-buy links
  [].slice.call(root.querySelectorAll('.tocart')).forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();var t=document.getElementById('buytop');if(t)t.scrollIntoView({behavior:'smooth'});});});
  // FAQ — accordion + green check on answered
  var fqs=[].slice.call(document.querySelectorAll('#faqs .fq'));
  function setH(f){var p=f.querySelector('.p');p.style.maxHeight=f.classList.contains('on')?p.scrollHeight+'px':'0px';}
  function markDone(f){if(f.classList.contains('ever')){f.classList.add('done');f.querySelector('.ico').textContent='✓';}}
  fqs.forEach(function(f){ if(f.classList.contains('on'))f.classList.add('ever'); setH(f);
    f.querySelector('.q').addEventListener('click',function(){
      var opening=!f.classList.contains('on');
      fqs.forEach(function(o){ if(o!==f && o.classList.contains('on')){ o.classList.remove('on'); markDone(o); setH(o); } });
      if(opening){ f.classList.add('on','ever'); f.classList.remove('done'); f.querySelector('.ico').textContent='+'; }
      else { f.classList.remove('on'); markDone(f); }
      setH(f);
    });
  });
  var cr=document.getElementById('crow'); if(cr)cr.innerHTML+=cr.innerHTML;
})();
</script>
