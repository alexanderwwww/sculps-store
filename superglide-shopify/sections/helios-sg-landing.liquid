<script>
(function(){
  var root=document.getElementById('mk'); if(!root||root.dataset.i)return; root.dataset.i='1';
  // gallery
  var gmain=document.getElementById('gmain'), thumbs=[].slice.call(document.querySelectorAll('#gthumbs .gthumb'));
  thumbs.forEach(function(t){t.addEventListener('click',function(){thumbs.forEach(function(x){x.classList.remove('on');});t.classList.add('on');gmain.innerHTML='<img src="'+t.getAttribute('data-src')+'" alt="HELIOS Super Glide">';});});
  // offer + checkout
  var opts=[].slice.call(document.querySelectorAll('#offer .opt'));
  var cta=document.getElementById('cta'), ctap=document.getElementById('ctap'), ctasv=document.getElementById('ctasv');
  var sel='47935890817189', DISC='SUPERGLIDEIT', busy=false;
  opts.forEach(function(o){o.addEventListener('click',function(){
    opts.forEach(function(x){x.classList.remove('on');}); o.classList.add('on');
    sel=o.getAttribute('data-vid');
    if(ctap)ctap.textContent=o.getAttribute('data-p');
    if(ctasv)ctasv.textContent=o.getAttribute('data-sv')+' · 12% code applies at checkout';
  });});
  function checkout(){
    if(busy)return; busy=true;
    var back='/cart/'+sel+':1?discount='+DISC;
    try{
      fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:parseInt(sel,10),quantity:1}]})})
        .then(function(r){ if(!r.ok)throw 0; window.location.href='/discount/'+DISC+'?redirect=%2Fcheckout'; })
        .catch(function(){ busy=false; window.location.href=back; });
    }catch(e){ busy=false; window.location.href=back; }
  }
  if(cta)cta.addEventListener('click',checkout);
  var fc=document.getElementById('finalcta');
  if(fc)fc.addEventListener('click',function(e){e.preventDefault();document.getElementById('offer').scrollIntoView({behavior:'smooth'});});
})();
</script>
