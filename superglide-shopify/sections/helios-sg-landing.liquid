  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;overflow:hidden}
#mk *{box-sizing:border-box}
#mk img{max-width:100%;display:block}
#mk a{text-decoration:none;color:inherit}
#mk .wrap{max-width:1180px;margin:0 auto;padding:0 20px}
#mk h1{font-size:clamp(26px,3.4vw,42px);font-weight:800;letter-spacing:-.025em;line-height:1.08;margin:0}
#mk h2{font-size:clamp(23px,3vw,34px);font-weight:800;letter-spacing:-.02em;line-height:1.14;margin:0}
#mk .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--acc)}
#mk .stars{color:var(--star);letter-spacing:1.5px}
/* PAGE TITLE (emotional hero) */
#mk .ptitle{text-align:center;padding:44px 20px 6px;max-width:900px;margin:0 auto}
#mk .ptitle h1{font-size:clamp(27px,3.8vw,46px)}
#mk .ptitle .hl{color:var(--acc)}
/* ABOVE THE FOLD */
#mk .fold{display:grid;grid-template-columns:1fr;gap:30px;padding:26px 0 10px}
@media(min-width:940px){#mk .fold{grid-template-columns:1fr 1fr;gap:52px;padding:34px 0 20px;align-items:start}}
/* gallery */
#mk .gmain{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--alt);aspect-ratio:1/1}
#mk .gmain img,#mk .gmain video{width:100%;height:100%;object-fit:cover;display:block}
#mk .gthumbs{display:flex;gap:10px;margin-top:12px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
#mk .gthumbs::-webkit-scrollbar{display:none}
#mk .gthumb{position:relative;flex:0 0 auto;width:68px;aspect-ratio:1/1;border:2px solid var(--line);border-radius:11px;overflow:hidden;cursor:pointer;background:var(--alt)}
#mk .gthumb.on{border-color:var(--ink)}
#mk .gthumb img{width:100%;height:100%;object-fit:cover}
#mk .gthumb .pv{position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-size:18px;background:rgba(0,0,0,.22);text-shadow:0 1px 4px rgba(0,0,0,.6)}
/* two UGC video screens (Mark's red rectangles) */
#mk .ugc2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:16px}
#mk .ugc{position:relative;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:#000;aspect-ratio:9/16}
#mk .ugc video{width:100%;height:100%;object-fit:cover;display:block}
#mk .ugc .snd{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);background:rgba(255,255,255,.22);color:#fff;font-size:11.5px;font-weight:700;padding:6px 12px;border-radius:100px;border:1px solid rgba(255,255,255,.3);cursor:pointer;white-space:nowrap}
/* offer column */
#mk .rev{display:flex;align-items:center;gap:8px;margin:14px 0 0;font-size:14px;color:var(--mut);flex-wrap:wrap}
#mk .rev b{color:var(--ink)}
#mk .sub{font-size:clamp(16px,1.6vw,19px);color:var(--mut);margin:14px 0 0;max-width:52ch}
#mk .sub b{color:var(--ink);font-weight:600}
#mk .bul{list-style:none;padding:0;margin:20px 0 0;display:grid;gap:11px}
#mk .bul li{display:flex;gap:11px;align-items:flex-start;font-size:15.5px}
#mk .bul .ic{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:rgba(22,163,74,.12);color:var(--ok);display:grid;place-items:center;font-size:12px;font-weight:800;margin-top:1px}
/* offer box */
#mk .offerbox{margin-top:24px;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 18px 44px -28px rgba(15,27,45,.4)}
