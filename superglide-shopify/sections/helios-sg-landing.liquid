    var v=document.getElementById(b.getAttribute('data-v')); if(!v)return;
    var u=function(){v.muted=!v.muted;b.textContent=v.muted?'Tap for sound':'Tap to mute';var p=v.play();if(p&&p.catch)p.catch(function(){});};
    v.addEventListener('click',u); b.addEventListener('click',u);
  });
  // gallery
  var gthumbs=[].slice.call(document.querySelectorAll('#gthumbs .gth'));
  var gimgs=gthumbs.map(function(t){return t.getAttribute('data-src');});
  var gmainImg=document.getElementById('gmainimg'), gi=0;
  function setG(i){gi=(i%gimgs.length+gimgs.length)%gimgs.length;gmainImg.src=gimgs[gi];gthumbs.forEach(function(x,j){x.classList.toggle('on',j===gi);});}
  gthumbs.forEach(function(t,i){t.addEventListener('click',function(){setG(i);});});
  // lightbox (gallery + memory wall)
  var lb=document.getElementById('lb'),lbimg=document.getElementById('lbimg');
  document.getElementById('gmain').addEventListener('click',function(){lbimg.src=gimgs[gi];lb.classList.add('on');});
  [].slice.call(root.querySelectorAll('.pol img')).forEach(function(im){im.parentNode.addEventListener('click',function(){lbimg.src=im.src;lb.classList.add('on');});});
  document.getElementById('lbx').addEventListener('click',function(){lb.classList.remove('on');});
  lb.addEventListener('click',function(e){if(e.target===lb)lb.classList.remove('on');});
  document.getElementById('lbp').addEventListener('click',function(e){e.stopPropagation();setG(gi-1);lbimg.src=gimgs[gi];});
  document.getElementById('lbn').addEventListener('click',function(e){e.stopPropagation();setG(gi+1);lbimg.src=gimgs[gi];});
  document.addEventListener('keydown',function(e){if(!lb.classList.contains('on'))return;if(e.key==='Escape')lb.classList.remove('on');if(e.key==='ArrowLeft'){setG(gi-1);lbimg.src=gimgs[gi];}if(e.key==='ArrowRight'){setG(gi+1);lbimg.src=gimgs[gi];}});
  // bundles
  var opts=[].slice.call(document.querySelectorAll('#opts .opt'));
  var ctalbl=document.getElementById('ctalbl');
  var obc=document.getElementById('obc'), obp=document.getElementById('obp'), obs=document.getElementById('obs');
  var stp=document.getElementById('stp'), stlbl=document.getElementById('stlbl');
  var LBL={ '47935890882725':'Add 2 + 2 to cart', '47935890817189':'Add 1 + 1 to cart', '47945658269861':'Add to cart' };
  var SLBL={ '47935890882725':'SuperGlide Pro · 2+2 FREE', '47935890817189':'SuperGlide Pro · 1+1 FREE', '47945658269861':'SuperGlide Pro · single' };
  opts.forEach(function(o){o.addEventListener('click',function(){
    opts.forEach(function(x){x.classList.remove('on');}); o.classList.add('on');
    sel=o.getAttribute('data-vid');
    if(ctalbl)ctalbl.textContent=LBL[sel]||'Get it now';
    if(obc)obc.textContent=o.getAttribute('data-c');
    if(obp)obp.textContent=o.getAttribute('data-p');
    if(obs)obs.textContent=o.getAttribute('data-sv2');
    if(stp)stp.textContent=o.getAttribute('data-p');
    if(stlbl)stlbl.textContent=SLBL[sel]||'SuperGlide Pro';
  });});
  // buy actions — BOTH paths carry the discount (fixes cart abandon)
  function addThen(dest,fallback){
    if(busy)return; busy=true;
    try{
      fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:parseInt(sel,10),quantity:1}]})})
        .then(function(r){ if(!r.ok)throw 0; window.location.href=dest; })
        .catch(function(){ busy=false; window.location.href=fallback; });
    }catch(e){ busy=false; window.location.href=fallback; }
  }
  var cta=document.getElementById('cta');
  if(cta)cta.addEventListener('click',function(){ addThen('/discount/'+DISC+'?redirect=%2Fcart','/cart/'+sel+':1?discount='+DISC); });
  var sgob=document.getElementById('sgob');
  if(sgob){ sgob.addEventListener('click',function(){ addThen('/discount/'+DISC+'?redirect=%2Fcart','/cart/'+sel+':1?discount='+DISC); });
    sgob.addEventListener('keydown',function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); sgob.click(); } }); }
  var stbtn=document.getElementById('stbtn');
  if(stbtn)stbtn.addEventListener('click',function(){ addThen('/discount/'+DISC+'?redirect=%2Fcheckout','/cart/'+sel+':1?discount='+DISC); });
  // sticky bar visibility
  var stick=document.getElementById('mkstick'), buyEl=document.getElementById('buytop');
  function onScroll(){ if(!buyEl)return; var r=buyEl.getBoundingClientRect(); stick.classList.toggle('show', r.bottom<0); }
  window.addEventListener('scroll',onScroll,{passive:true}); onScroll();
  // scroll-to-buy links
  [].slice.call(root.querySelectorAll('.tocart')).forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();if(buyEl)buyEl.scrollIntoView({behavior:'smooth'});});});
  // FAQ — accordion + green check on answered
  var fqs=[].slice.call(document.querySelectorAll('#faqs .fq'));
  function setH(f){var p=f.querySelector('.p');p.style.maxHeight=f.classList.contains('on')?p.scrollHeight+'px':'0px';}
  function markDone(f){if(f.classList.contains('ever')){f.classList.add('done');f.querySelector('.ico').textContent='✓';}}
  fqs.forEach(function(f){ if(f.classList.contains('on'))f.classList.add('ever'); setH(f);
    f.querySelector('.q').addEventListener('click',function(){
      var opening=!f.classList.contains('on');
      fqs.forEach(function(o){ if(o!==f && o.classList.contains('on')){ o.classList.remove('on'); markDone(o); setH(o); } });
      if(opening){ f.classList.add('on','ever'); f.classList.remove('done'); f.querySelector('.ico').textContent='+'; }
      else { f.classList.remove('on'); markDone(f); }
      setH(f);
    });
  });
  // review carousel — dots + auto-glide
  var rtrack=document.getElementById('rvtrack'), rdots=document.getElementById('rdots');
  if(rtrack&&rdots){
    var rcards=[].slice.call(rtrack.querySelectorAll('.rvc')), ri=0, rauto=null, rhold=false;
    rdots.innerHTML=''; rcards.forEach(function(c,i){var d=document.createElement('button');d.className='rdot'+(i===0?' on':'');d.setAttribute('aria-label','Review '+(i+1));rdots.appendChild(d);});
    var rds=[].slice.call(rdots.children);
    function rgo(i,smooth){ri=(i%rcards.length+rcards.length)%rcards.length;rtrack.scrollTo({left:rcards[ri].offsetLeft-rtrack.offsetLeft,behavior:smooth===false?'auto':'smooth'});}
    if('IntersectionObserver' in window){
      var rio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting&&e.intersectionRatio>=0.6){var i=rcards.indexOf(e.target);ri=i;rds.forEach(function(d,j){d.classList.toggle('on',j===i);});}});},{root:rtrack,threshold:[0.6]});
      rcards.forEach(function(c){rio.observe(c);});
    }
    rds.forEach(function(d,i){d.addEventListener('click',function(){rhold=true;rgo(i);setTimeout(function(){rhold=false;},9000);});});
    function rpause(){rhold=true;clearTimeout(rtrack._rt);rtrack._rt=setTimeout(function(){rhold=false;},9000);}
    ['pointerdown','touchstart','wheel'].forEach(function(ev){rtrack.addEventListener(ev,rpause,{passive:true});});
    if(!reduce){rauto=setInterval(function(){if(rhold)return;if(document.hidden)return;rgo(ri+1);},4500);}
  }
  // marquees
  ['crow','crow2','srow'].forEach(function(i){var e=document.getElementById(i);if(e)e.innerHTML+=e.innerHTML;});
})();
</script>
