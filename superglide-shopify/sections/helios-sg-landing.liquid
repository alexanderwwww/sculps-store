{%- comment -%} HELIOS Super Glide — sales page built to Mark's framework (clean minimal style).
  Above fold: carousel + headline + subhead + 4 bullets + offer/CTA + risk reversal + FAQ.
  Below fold: testimonials that handle objections, then education (authority + how it works). {%- endcomment -%}
<style>
#mk{--bg:#ffffff;--alt:#F4F7FB;--ink:#0F1B2D;--mut:#5A6B7B;--line:#E3E8EF;--acc:#0E7CC4;--accd:#0B5E9E;--ok:#16A34A;--star:#F5A623;
  margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);background:var(--bg);color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;overflow:hidden}
#mk *{box-sizing:border-box}
#mk img{max-width:100%;display:block}
#mk a{text-decoration:none;color:inherit}
#mk .wrap{max-width:1180px;margin:0 auto;padding:0 20px}
#mk h1{font-size:clamp(28px,3.6vw,44px);font-weight:800;letter-spacing:-.025em;line-height:1.08;margin:0}
#mk h2{font-size:clamp(24px,3vw,34px);font-weight:800;letter-spacing:-.02em;line-height:1.14;margin:0}
#mk .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--acc)}
#mk .stars{color:var(--star);letter-spacing:1.5px}
/* ABOVE THE FOLD */
#mk .fold{display:grid;grid-template-columns:1fr;gap:30px;padding:34px 0 10px}
@media(min-width:940px){#mk .fold{grid-template-columns:1fr 1fr;gap:52px;padding:52px 0 20px;align-items:start}}
/* gallery */
#mk .gmain{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--alt);aspect-ratio:1/1}
#mk .gmain img{width:100%;height:100%;object-fit:cover}
#mk .gthumbs{display:flex;gap:10px;margin-top:12px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
#mk .gthumbs::-webkit-scrollbar{display:none}
#mk .gthumb{flex:0 0 auto;width:70px;aspect-ratio:1/1;border:2px solid var(--line);border-radius:11px;overflow:hidden;cursor:pointer;background:var(--alt)}
#mk .gthumb.on{border-color:var(--ink)}
#mk .gthumb img{width:100%;height:100%;object-fit:cover}
@media(min-width:940px){#mk .gallery{position:sticky;top:16px}}
/* offer column */
#mk .rev{display:flex;align-items:center;gap:8px;margin:14px 0 0;font-size:14px;color:var(--mut)}
#mk .rev b{color:var(--ink)}
#mk .sub{font-size:clamp(16px,1.6vw,19px);color:var(--mut);margin:14px 0 0;max-width:52ch}
#mk .sub b{color:var(--ink);font-weight:600}
#mk .bul{list-style:none;padding:0;margin:20px 0 0;display:grid;gap:11px}
#mk .bul li{display:flex;gap:11px;align-items:flex-start;font-size:15.5px}
#mk .bul .ic{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:rgba(22,163,74,.12);color:var(--ok);display:grid;place-items:center;font-size:12px;font-weight:800;margin-top:1px}
/* offer box */
#mk .offer{margin-top:26px;border:1px solid var(--line);border-radius:18px;overflow:hidden}
#mk .opt{display:flex;align-items:center;gap:13px;padding:15px 16px;border-top:1px solid var(--line);cursor:pointer;position:relative;background:#fff;transition:background .15s}
#mk .opt:first-child{border-top:none}
#mk .opt.on{background:#F1F8FE;box-shadow:inset 3px 0 0 var(--acc)}
#mk .opt .radio{width:22px;height:22px;border-radius:50%;border:2px solid #C4CDD8;flex:0 0 auto}
#mk .opt.on .radio{border:7px solid var(--acc)}
#mk .opt .lbl{flex:1;min-width:0}
#mk .opt .lbl b{display:block;font-size:15.5px;font-weight:700}
#mk .opt .lbl span{font-size:13px;color:var(--mut)}
#mk .opt .pr{text-align:right;flex:0 0 auto}
#mk .opt .pr b{font-size:16px;font-weight:800}
#mk .opt .pr s{display:block;font-size:12.5px;color:#9AA6B2}
#mk .opt .tag{position:absolute;top:-9px;left:16px;font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:#fff;background:var(--acc);padding:3px 9px;border-radius:20px}
#mk .cta{display:block;width:100%;text-align:center;margin-top:16px;background:var(--acc);color:#fff;font-size:17px;font-weight:800;padding:17px;border:none;border-radius:12px;cursor:pointer;transition:background .15s,transform .15s;box-shadow:0 12px 26px -12px rgba(14,124,196,.6)}
#mk .cta:hover{background:var(--accd);transform:translateY(-1px)}
#mk .cta small{display:block;font-weight:600;font-size:12.5px;opacity:.85;margin-top:3px}
/* risk reversal */
#mk .risk{display:flex;align-items:flex-start;gap:11px;margin-top:16px;padding:14px 16px;border:1px solid var(--line);border-radius:12px;background:var(--alt);font-size:13.5px;color:var(--mut)}
#mk .risk .ic{font-size:20px;line-height:1;flex:0 0 auto}
#mk .risk b{color:var(--ink)}
#mk .pays{display:flex;gap:7px;justify-content:center;margin-top:12px;flex-wrap:wrap}
#mk .pays span{font-size:10px;font-weight:700;color:var(--mut);border:1px solid var(--line);border-radius:5px;padding:4px 8px}
/* faq (above fold, right column) */
#mk .faq{margin-top:22px}
#mk .faq .q{border:1px solid var(--line);border-radius:12px;margin-top:9px;overflow:hidden;background:#fff}
#mk .faq summary{list-style:none;cursor:pointer;padding:15px 16px;font-weight:700;font-size:14.5px;display:flex;justify-content:space-between;align-items:center;gap:12px}
#mk .faq summary::-webkit-details-marker{display:none}
#mk .faq summary .pm{color:var(--acc);font-size:20px;line-height:1;flex:0 0 auto;transition:transform .2s}
#mk .faq .q[open] summary .pm{transform:rotate(45deg)}
#mk .faq .a{padding:0 16px 15px;color:var(--mut);font-size:14px}
/* SECTIONS below fold */
#mk .sec{padding:52px 0}
#mk .sec.alt{background:var(--alt)}
#mk .sec .head{text-align:center;max-width:640px;margin:0 auto 30px}
#mk .sec .head h2{margin-top:8px}
/* testimonials */
#mk .tg{display:grid;grid-template-columns:1fr;gap:18px}
@media(min-width:780px){#mk .tg{grid-template-columns:1fr 1fr 1fr}}
#mk .tc{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 10px 30px -20px rgba(15,27,45,.35)}
#mk .tc>img{width:100%;aspect-ratio:4/3;object-fit:cover}
#mk .tc .body{padding:16px}
#mk .tc .obj{font-size:12.5px;font-weight:700;color:var(--acc);margin:2px 0 6px}
#mk .tc p{font-size:14px;color:#2B3A4A;margin:0;line-height:1.5}
#mk .tc .by{display:flex;align-items:center;gap:10px;margin-top:13px}
#mk .tc .av{width:34px;height:34px;border-radius:50%;background:var(--acc);color:#fff;display:grid;place-items:center;font-weight:700;font-size:13px;flex:0 0 auto}
#mk .tc .nm{font-size:13px;font-weight:700}
#mk .tc .nm span{display:block;color:var(--mut);font-weight:500;font-size:11.5px}
#mk .tc .vf{margin-left:auto;font-size:11px;font-weight:700;color:var(--ok);background:rgba(22,163,74,.1);padding:3px 9px;border-radius:20px}
/* education */
#mk .steps{display:grid;grid-template-columns:1fr;gap:16px;margin-top:8px}
@media(min-width:760px){#mk .steps{grid-template-columns:1fr 1fr 1fr}}
#mk .step{background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px 22px;text-align:center}
#mk .step .n{width:36px;height:36px;border-radius:50%;background:var(--acc);color:#fff;font-weight:800;display:grid;place-items:center;margin:0 auto 12px}
#mk .step b{font-size:16px;font-weight:800}
#mk .step p{color:var(--mut);font-size:14px;margin:7px 0 0}
#mk .auth{max-width:900px;margin:26px auto 0;display:grid;grid-template-columns:1fr;gap:20px;align-items:center}
@media(min-width:820px){#mk .auth{grid-template-columns:1fr 1fr}}
#mk .auth img{border-radius:16px;border:1px solid var(--line);width:100%;aspect-ratio:4/3;object-fit:cover;background:var(--alt)}
#mk .auth h3{font-size:20px;font-weight:800;margin:0 0 8px}
#mk .auth p{color:var(--mut);font-size:15px;margin:0 0 12px}
#mk .spec{list-style:none;padding:0;margin:0;display:grid;gap:8px}
#mk .spec li{display:flex;gap:9px;font-size:14px}
#mk .spec b{color:var(--ok);flex:0 0 auto;font-weight:800}
/* final cta */
#mk .final{text-align:center;padding:56px 0}
#mk .final .btn{display:inline-block;margin-top:20px;background:var(--acc);color:#fff;font-size:17px;font-weight:800;padding:16px 34px;border-radius:12px;box-shadow:0 12px 26px -12px rgba(14,124,196,.6);cursor:pointer}
#mk .final .btn:hover{background:var(--accd)}
</style>
