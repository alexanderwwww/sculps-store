#mk .final{text-align:center;padding:56px 0}
#mk .final .btn{display:inline-block;margin-top:20px;background:var(--buy);color:#08221A;font-size:17px;font-weight:800;padding:16px 34px;border-radius:100px;box-shadow:0 14px 30px -12px rgba(16,201,126,.55);cursor:pointer}
