#mk .offerbox .desc{font-size:14px;color:var(--mut);margin:5px 0 0}
#mk .offerbox .rev{margin:8px 0 14px}
#mk .opts{display:grid;gap:10px}
#mk .opt{display:flex;align-items:center;gap:12px;padding:13px 14px;border:1.5px solid var(--line);border-radius:14px;cursor:pointer;position:relative;transition:border-color .15s,background .15s}
#mk .opt.on{border-color:var(--ink);border-width:2px;background:#FAFBFC}
#mk .opt .radio{width:21px;height:21px;border-radius:50%;border:2px solid #C4CDD8;flex:0 0 auto}
#mk .opt.on .radio{border:6.5px solid var(--ink)}
#mk .opt .pic{width:42px;height:42px;border-radius:9px;object-fit:cover;flex:0 0 auto;background:var(--alt);border:1px solid var(--line)}
#mk .opt .lbl{flex:1;min-width:0}
#mk .opt .lbl b{display:block;font-size:14.5px;font-weight:800}
#mk .opt .lbl span{font-size:12.5px;color:var(--mut)}
#mk .opt .pr{text-align:right;flex:0 0 auto}
#mk .opt .pr b{font-size:15.5px;font-weight:800}
#mk .opt .pr s{display:block;font-size:12px;color:#9AA6B2}
#mk .opt .tag{position:absolute;top:-9px;left:14px;font-size:9.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:#fff;background:var(--acc);padding:3px 9px;border-radius:20px}
#mk .cta{display:block;width:100%;text-align:center;margin-top:14px;background:var(--buy);color:#08221A;font-size:17px;font-weight:800;padding:17px;border:none;border-radius:100px;cursor:pointer;transition:background .15s,transform .15s;box-shadow:0 14px 30px -12px rgba(16,201,126,.55)}
#mk .cta:hover{background:var(--buyd);transform:translateY(-1px)}
#mk .cta small{display:block;font-weight:600;font-size:12px;opacity:.8;margin-top:3px}
#mk .coupon{display:flex;align-items:center;justify-content:center;gap:7px;margin-top:11px;font-size:12.5px;color:var(--ok);font-weight:700;text-align:center}
#mk .risk{display:flex;align-items:flex-start;gap:10px;margin-top:16px;padding:13px 15px;border:1px solid var(--line);border-radius:12px;background:var(--alt);font-size:13.5px;color:var(--mut)}
#mk .risk .ic{font-size:19px;line-height:1;flex:0 0 auto}
#mk .risk b{color:var(--ink)}
/* faq */
#mk .faq{margin-top:22px}
