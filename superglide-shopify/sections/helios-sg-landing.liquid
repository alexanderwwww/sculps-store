#mk .cb .tx{font-size:13.5px;white-space:nowrap}
#mk .cb .tx b{font-weight:700}
@keyframes mkcm{to{transform:translateX(-50%)}}
@keyframes mkcm2{from{transform:translateX(-50%)}to{transform:translateX(0)}}
/* dad section */
#mk .dad{display:grid;grid-template-columns:1fr;gap:26px;align-items:center;max-width:1000px;margin:0 auto}
