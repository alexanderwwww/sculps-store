{%- comment -%} HELIOS — Clear FAQ (green-check motion accordion). Standalone, reusable. {%- endcomment -%}
{%- assign sid = section.id -%}
<section class="helios" id="cfq-{{ sid }}">
<style>
  #cfq-{{ sid }}{--ink:#0E1116;--mut:#5C6672;--line:#E5E7EB;--ok:#16A34A;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}
  #cfq-{{ sid }} .wrap{max-width:760px;margin:0 auto;padding:clamp(34px,5vw,58px) 18px}
  #cfq-{{ sid }} .head{text-align:center;margin:0 0 24px}
  #cfq-{{ sid }} .ey{font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink)}
  #cfq-{{ sid }} h2{font-size:clamp(21px,2.6vw,30px);font-weight:800;letter-spacing:-.02em;line-height:1.14;margin:7px 0 0;color:var(--ink)}
  #cfq-{{ sid }} .faqs{display:grid;gap:10px}
  #cfq-{{ sid }} .fq{border:1px solid var(--line);border-radius:12px;background:#fff;overflow:hidden;transition:border-color .25s}
  #cfq-{{ sid }} .fq.on{border-color:var(--ink)}
  #cfq-{{ sid }} .fq.done{border-color:rgba(22,163,74,.4)}
  #cfq-{{ sid }} .fq .q{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 16px;cursor:pointer;font-weight:700;font-size:14.5px;color:var(--ink)}
  #cfq-{{ sid }} .fq .ico{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:14px;transition:transform .3s,background .3s}
  #cfq-{{ sid }} .fq.on .ico{transform:rotate(135deg)}
  #cfq-{{ sid }} .fq.done:not(.on) .ico{background:var(--ok);transform:none}
  #cfq-{{ sid }} .fq .p{max-height:0;overflow:hidden;transition:max-height .35s ease}
  #cfq-{{ sid }} .fq .p .in{padding:0 16px 15px;color:var(--mut);font-size:13.5px;line-height:1.55}
  @media(prefers-reduced-motion:reduce){#cfq-{{ sid }} .fq .p{transition:none}#cfq-{{ sid }} .fq .ico{transition:none}}
</style>
<div class="wrap">
  <div class="head"><div class="ey">{{ section.settings.eyebrow | default: 'Clear answers' }}</div><h2>{{ section.settings.heading | default: "Everything you're wondering." }}</h2></div>
  <div class="faqs" data-faqs>
    <div class="fq on"><div class="q">Does it actually move on its own, or do I paddle?<span class="ico">+</span></div><div class="p"><div class="in">It moves itself. Twin electric thrusters push you forward and let you spin 360° with the joysticks — completely hands-free. No paddling, no gas, no motorboat.</div></div></div>
    <div class="fq"><div class="q">Is it safe for kids?<span class="ico">+</span></div><div class="p"><div class="in">Yes — the thrusters are fully enclosed with no exposed blades, and it cruises at a gentle walking pace. Kids ride with a parent up to the 300 lb capacity, life jackets on like any water toy.</div></div></div>
    <div class="fq"><div class="q">Will it really hold an adult + the kids?<span class="ico">+</span></div><div class="p"><div class="in">Yes — rated up to 300 lb. Room for a parent and two kids, with a padded headrest, backrest and dual cup holders.</div></div></div>
    <div class="fq"><div class="q">How long does the battery last?<span class="ico">+</span></div><div class="p"><div class="in">About 2 hours of continuous cruising per charge — a whole afternoon on the water — and it recharges between sessions.</div></div></div>
    <div class="fq"><div class="q">Is it durable, or will it pop?<span class="ico">+</span></div><div class="p"><div class="in">Heavy-duty marine-grade reinforced PVC — thick, tough material built to take a full summer of kids, docks and dragging. Not a flimsy pool toy.</div></div></div>
    <div class="fq"><div class="q">How hard is it to set up?<span class="ico">+</span></div><div class="p"><div class="in">Inflate it in about 5 minutes with the included nozzle, drop it in, grab the joysticks and go. No tools.</div></div></div>
    <div class="fq"><div class="q">What exactly do I get with the 1+1 deal?<span class="ico">+</span></div><div class="p"><div class="in">Two complete Super Glides — one for you, one free for the family — plus free shipping and the 30-day money-back guarantee. The 12% code applies itself at checkout.</div></div></div>
    <div class="fq"><div class="q">What if I don't love it?<span class="ico">+</span></div><div class="p"><div class="in">Send it back within 30 days for a full refund. No hassle — the risk is entirely ours.</div></div></div>
  </div>
</div>
<script>
(function(){
  var root=document.getElementById('cfq-{{ sid }}'); if(!root||root.dataset.i)return; root.dataset.i='1';
  var fqs=[].slice.call(root.querySelectorAll('.fq'));
  function setH(f){var p=f.querySelector('.p');p.style.maxHeight=f.classList.contains('on')?p.scrollHeight+'px':'0px';}
  function markDone(f){if(f.classList.contains('ever')){f.classList.add('done');f.querySelector('.ico').textContent='✓';}}
  fqs.forEach(function(f){ if(f.classList.contains('on'))f.classList.add('ever'); setH(f);
    f.querySelector('.q').addEventListener('click',function(){
      var opening=!f.classList.contains('on');
      fqs.forEach(function(o){ if(o!==f && o.classList.contains('on')){ o.classList.remove('on'); markDone(o); setH(o); } });
      if(opening){ f.classList.add('on','ever'); f.classList.remove('done'); f.querySelector('.ico').textContent='+'; }
      else { f.classList.remove('on'); markDone(f); }
      setH(f);
    });
  });
})();
</script>
</section>
{% schema %}
{
  "name": "HELIOS Clear FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Clear answers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you're wondering." }
  ],
  "presets": [{ "name": "HELIOS Clear FAQ" }]
}
{% endschema %}
