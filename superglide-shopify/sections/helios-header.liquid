{%- assign sid = section.id -%}
<div class="helios" id="hd-{{ sid }}" style="--ocean1:#062F49;--acc:#0E7CC4;--acc2:#16A6D6;--accd:#0A5E97;--ink:#0C1A24;--ink2:#0A1219;--mut:#56636E;font-family:'Inter',system-ui,sans-serif;">
<style>
  #hd-{{ sid }} .hd-bar{position:sticky;top:0;z-index:60;background:rgba(238,246,250,.78);backdrop-filter:blur(20px) saturate(165%);-webkit-backdrop-filter:blur(20px) saturate(165%);border-bottom:1px solid rgba(255,255,255,.55);box-shadow:0 1px 0 rgba(6,47,73,.04);}
  #hd-{{ sid }} .hd-in{display:flex;align-items:center;gap:14px;max-width:1200px;margin:0 auto;padding:13px 20px;}
  #hd-{{ sid }} .hd-nav{display:flex;gap:26px;font-size:13.5px;font-weight:600;flex:1;}
  #hd-{{ sid }} .hd-nav a{color:var(--mut);text-decoration:none;transition:color .2s;}
  #hd-{{ sid }} .hd-nav a:hover{color:var(--ink);}
  #hd-{{ sid }} .hd-logo{flex:1;text-align:center;font-family:'Archivo',sans-serif;font-weight:900;letter-spacing:.14em;font-size:23px;color:var(--ink2);text-decoration:none;}
  #hd-{{ sid }} .hd-right{flex:1;display:flex;justify-content:flex-end;}
  #hd-{{ sid }} .hd-cart{position:relative;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;background:rgba(255,255,255,.7);border:1px solid rgba(6,47,73,.10);border-radius:14px;color:var(--ink2);text-decoration:none;transition:transform .18s,background .18s;box-shadow:0 2px 8px rgba(6,47,73,.06);}
  #hd-{{ sid }} .hd-cart:hover{background:#fff;transform:translateY(-1px);}
  #hd-{{ sid }} .hd-cart svg{width:20px;height:20px;}
  #hd-{{ sid }} .hd-cart svg:not(.hd-cart-ico){display:none!important;}
  #hd-{{ sid }} .hd-cart-ct{position:absolute;top:-6px;right:-6px;min-width:19px;height:19px;padding:0 5px;display:grid;place-items:center;background:#0A2A4A;color:#fff;font-family:'Archivo',sans-serif;font-weight:800;font-size:11px;line-height:1;border-radius:20px;border:2px solid rgba(238,246,250,.95);}
  #hd-{{ sid }} .hd-burger{display:none;flex-direction:column;gap:4.5px;width:26px;background:none;border:none;cursor:pointer;padding:4px;}
  #hd-{{ sid }} .hd-burger span{display:block;height:2.5px;width:100%;background:var(--ink);border-radius:2px;}
  #hd-{{ sid }} .hd-drawer{position:fixed;inset:0;z-index:90;background:rgba(8,28,44,.5);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:none;}
  #hd-{{ sid }} .hd-drawer.open{display:block;}
  #hd-{{ sid }} .hd-panel{position:absolute;top:0;left:0;bottom:0;width:80%;max-width:330px;background:rgba(255,255,255,.98);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);padding:22px 20px;display:flex;flex-direction:column;}
  #hd-{{ sid }} .hd-panel a{padding:15px 4px;font-family:'Archivo',sans-serif;font-weight:700;font-size:16px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(12,26,36,.08);}
  #hd-{{ sid }} .hd-x{background:none;border:none;font-size:28px;line-height:1;cursor:pointer;color:var(--ink);align-self:flex-end;margin-bottom:8px;}
  @media(max-width:760px){#hd-{{ sid }} .hd-nav{display:none;}#hd-{{ sid }} .hd-burger{display:flex;}#hd-{{ sid }} .hd-logo{text-align:left;}}
</style>
<header class="hd-bar">
  <div class="hd-in">
    <button class="hd-burger" data-hdburger aria-label="Menu"><span></span><span></span><span></span></button>
    <nav class="hd-nav">
      <a href="{{ section.settings.l1_url | default: '#buy' }}">{{ section.settings.l1 | default: 'Shop' }}</a>
      <a href="{{ section.settings.l2_url | default: '#reviews' }}">{{ section.settings.l2 | default: 'Reviews' }}</a>
      <a href="{{ section.settings.l3_url | default: '#faq' }}">{{ section.settings.l3 | default: 'FAQ' }}</a>
      <a href="{{ section.settings.l4_url | default: '/pages/contact' }}">{{ section.settings.l4 | default: 'Contact' }}</a>
    </nav>
    <a href="/" class="hd-logo">{{ section.settings.logo_text | default: 'HELIOS' }}</a>
    <div class="hd-right"><a href="/cart" class="hd-cart" aria-label="Cart"><svg class="hd-cart-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>{% if cart.item_count > 0 %}<span class="hd-cart-ct">{{ cart.item_count }}</span>{% endif %}</a></div>
  </div>
</header>
<div class="hd-drawer" data-hddrawer>
  <div class="hd-panel">
    <button class="hd-x" data-hdclose aria-label="Close">&times;</button>
    <a href="/">Home</a>
    <a href="{{ section.settings.l1_url | default: '#buy' }}">{{ section.settings.l1 | default: 'Shop' }}</a>
    <a href="{{ section.settings.l2_url | default: '#reviews' }}">{{ section.settings.l2 | default: 'Reviews' }}</a>
    <a href="{{ section.settings.l3_url | default: '#faq' }}">{{ section.settings.l3 | default: 'FAQ' }}</a>
    <a href="{{ section.settings.l4_url | default: '/pages/contact' }}">{{ section.settings.l4 | default: 'Contact' }}</a>
    <a href="/cart">Cart ({{ cart.item_count }})</a>
  </div>
</div>
<script>
(function(){var r=document.getElementById('hd-{{ sid }}');if(!r||r.dataset.i)return;r.dataset.i='1';
var b=r.querySelector('[data-hdburger]'),d=r.querySelector('[data-hddrawer]');
if(b&&d){b.addEventListener('click',function(){d.classList.add('open');document.body.style.overflow='hidden';});
d.addEventListener('click',function(e){if(e.target===d||e.target.closest('[data-hdclose]')||e.target.tagName==='A'){d.classList.remove('open');document.body.style.overflow='';}});}
var cart=r.querySelector('.hd-cart');
if(cart){var clean=function(){var x=cart.querySelectorAll('svg:not(.hd-cart-ico)');for(var i=0;i<x.length;i++){if(x[i].parentNode)x[i].parentNode.removeChild(x[i]);}};clean();try{new MutationObserver(clean).observe(cart,{childList:true,subtree:true});}catch(e){}}
})();
</script>
</div>
{% schema %}
{"name":"HELIOS Header","tag":"section","settings":[{"type":"text","id":"logo_text","label":"Logo text","default":"HELIOS"},{"type":"text","id":"l1","label":"Link 1","default":"Shop"},{"type":"text","id":"l1_url","label":"Link 1 URL","default":"#buy"},{"type":"text","id":"l2","label":"Link 2","default":"Reviews"},{"type":"text","id":"l2_url","label":"Link 2 URL","default":"#reviews"},{"type":"text","id":"l3","label":"Link 3","default":"FAQ"},{"type":"text","id":"l3_url","label":"Link 3 URL","default":"#faq"},{"type":"text","id":"l4","label":"Link 4","default":"Contact"},{"type":"text","id":"l4_url","label":"Link 4 URL","default":"/pages/contact"}],"presets":[{"name":"HELIOS Header"}]}
{% endschema %}
