{%- comment -%}
  HELIOS — Announcement bar (liquid glass + reflections + scrolling offer).
  sections/helios-announcement.liquid
{%- endcomment -%}
{%- assign sid = section.id -%}
{% render 'helios-base' %}
<section class="helios" id="ha-{{ sid }}">
<style>
  #ha-{{ sid }} .ha{position:relative;height:46px;overflow:hidden;background:linear-gradient(180deg,rgba(13,62,94,.92),rgba(8,40,62,.92));backdrop-filter:var(--helios-g-blur,blur(20px) saturate(165%));-webkit-backdrop-filter:var(--helios-g-blur,blur(20px) saturate(165%));border-bottom:1px solid rgba(255,255,255,.16);box-shadow:inset 0 1px 0 rgba(255,255,255,.35),inset 0 -10px 18px -10px rgba(0,0,0,.5);color:#EAF6FB;}
  #ha-{{ sid }} .ha-spec{position:absolute;top:0;left:0;right:0;height:55%;background:linear-gradient(180deg,rgba(255,255,255,.4),rgba(255,255,255,0));pointer-events:none;z-index:2;}
  #ha-{{ sid }} .ha-glare{position:absolute;top:0;bottom:0;left:0;width:34%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);transform:skewX(-18deg);animation:helios-sheen 5.5s ease-in-out infinite;pointer-events:none;z-index:3;mix-blend-mode:screen;}
  #ha-{{ sid }} .ha-mq{position:absolute;inset:0;display:flex;align-items:center;white-space:nowrap;z-index:1;animation:helios-mq 22s linear infinite;font-size:12.5px;font-weight:700;letter-spacing:.04em;}
  #ha-{{ sid }} .ha-mq span{display:inline-flex;align-items:center;gap:8px;padding:0 26px;}
  #ha-{{ sid }} .ha-mq b{font-family:'Archivo';font-weight:900;letter-spacing:.06em;}
</style>
<div class="ha">
  <span class="ha-spec"></span><span class="ha-glare"></span>
  <div class="ha-mq">
    <span>{{ section.settings.message }}</span>
    <span>{{ section.settings.message }}</span>
    <span>{{ section.settings.message }}</span>
  </div>
</div>
</section>
{% schema %}
{
  "name": "HELIOS Announcement",
  "tag": "section",
  "settings": [
    { "type": "richtext", "id": "message", "label": "Message (HTML allowed)", "default": "<p>🌊 12% OFF SITE-WIDE — code <b>SUPERGLIDEIT</b> · 🚚 FREE SHIPPING · 🛡 30-DAY MONEY-BACK ·</p>" }
  ],
  "presets": [{ "name": "HELIOS Announcement" }]
}
{% endschema %}
