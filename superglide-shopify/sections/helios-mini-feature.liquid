{%- comment -%} HELIOS — Mini Glide feature band. sections/helios-mini-feature.liquid {%- endcomment -%}
{%- assign sid = section.id -%}
<div class="helios" id="hm-{{ sid }}" style="--acc:#0E7CC4;--acc2:#16A6D6;--accd:#0A5E97;--ink:#0C1A24;--mut:#56636E;font-family:'Inter',system-ui,sans-serif;">
<style>
  #hm-{{ sid }} .mg-wrap{max-width:1200px;margin:0 auto;padding:clamp(18px,3vw,40px) 22px;}
  #hm-{{ sid }} .mg-card{display:grid;grid-template-columns:1fr;border-radius:28px;overflow:hidden;box-shadow:0 26px 60px -18px rgba(6,47,73,.3);background:linear-gradient(135deg,#0A1219,#13232E 78%);}
  @media(min-width:760px){#hm-{{ sid }} .mg-card{grid-template-columns:1.02fr .98fr;}}
  #hm-{{ sid }} .mg-media{position:relative;min-height:clamp(300px,64vw,470px);background:#0e1c26;}
  #hm-{{ sid }} .mg-media img,#hm-{{ sid }} .mg-media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  #hm-{{ sid }} .mg-badge{position:absolute;top:16px;left:16px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.4);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:#fff;border-radius:30px;padding:8px 14px;font-family:'Archivo',sans-serif;font-weight:800;font-size:13px;}
  #hm-{{ sid }} .mg-ph{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:#9fb6c4;font-size:12px;text-align:center;padding:24px;}
  #hm-{{ sid }} .mg-copy{padding:clamp(28px,4vw,56px);color:#fff;display:flex;flex-direction:column;justify-content:center;}
  #hm-{{ sid }} .mg-ey{font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:rgba(190,225,245,.9);}
  #hm-{{ sid }} .mg-h{font-family:'Archivo',sans-serif;font-weight:900;font-size:clamp(28px,4.4vw,52px);line-height:.98;letter-spacing:-.02em;margin:14px 0 0;}
  #hm-{{ sid }} .mg-p{font-size:clamp(15px,1.7vw,18px);color:rgba(230,242,250,.92);margin:14px 0 0;max-width:46ch;}
  #hm-{{ sid }} .mg-chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px;}
  #hm-{{ sid }} .mg-chip{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.28);border-radius:30px;padding:8px 13px;font-size:12.5px;font-weight:700;}
  #hm-{{ sid }} .mg-price{display:flex;align-items:baseline;gap:10px;margin-top:22px;}
  #hm-{{ sid }} .mg-price b{font-family:'Archivo',sans-serif;font-weight:900;font-size:30px;}
  #hm-{{ sid }} .mg-price s{color:rgba(230,242,250,.6);font-size:16px;}
  #hm-{{ sid }} .mg-cta{align-self:flex-start;display:inline-flex;align-items:center;gap:9px;margin-top:20px;background:#fff;color:var(--accd);border-radius:14px;padding:15px 30px;font-family:'Archivo',sans-serif;font-weight:800;font-size:16px;text-decoration:none;box-shadow:0 16px 34px rgba(0,20,40,.3);}
</style>
<section class="mg-wrap">
  <div class="mg-card" data-reveal>
    <div class="mg-media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1200x' }}
      {%- elsif section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="HELIOS Mini Glide" loading="lazy">
      {%- else -%}
        <div class="mg-ph">🌀<div>Add Mini Glide photo/video<br>(Customize → this section)</div></div>
      {%- endif -%}
      <span class="mg-badge">{{ section.settings.badge | default: 'New · Single seat' }}</span>
    </div>
    <div class="mg-copy">
      <div class="mg-ey">{{ section.settings.eyebrow | default: 'Going solo?' }}</div>
      <h2 class="mg-h">{{ section.settings.heading | default: 'Meet the Mini Glide.' }}</h2>
      <p class="mg-p">{{ section.settings.body | default: 'Same dual-motor, joystick-steer magic — built for one. Lighter, packs smaller, and glides you around the pool hands-free. The easiest way to get on the water.' }}</p>
      <div class="mg-chips">
        <span class="mg-chip">⚡ Motorized</span><span class="mg-chip">🎮 Joystick steer</span><span class="mg-chip">🪶 Packs small</span>
      </div>
      <div class="mg-price"><b>{{ section.settings.price | default: '$129.99' }}</b><s>{{ section.settings.compare | default: '$229' }}</s></div>
      <a class="mg-cta" href="{{ section.settings.cta_link | default: '#buy' }}" data-gomini>{{ section.settings.cta_text | default: 'Shop the Mini Glide' }} →</a>
    </div>
  </div>
</section>
<script>
(function(){var r=document.getElementById('hm-{{ sid }}');if(!r||r.dataset.i)return;r.dataset.i='1';
var c=r.querySelector('[data-gomini]');
if(c)c.addEventListener('click',function(){var p=document.querySelector('[data-pick="mini"]');if(p){setTimeout(function(){p.click();},420);}});
})();
</script>
</div>
{% schema %}
{"name":"HELIOS Mini Feature","tag":"section","settings":[{"type":"video","id":"video","label":"Video"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"badge","label":"Badge","default":"New · Single seat"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Going solo?"},{"type":"text","id":"heading","label":"Heading","default":"Meet the Mini Glide."},{"type":"textarea","id":"body","label":"Body","default":"Same dual-motor, joystick-steer magic — built for one. Lighter, packs smaller, and glides you around the pool hands-free. The easiest way to get on the water."},{"type":"text","id":"price","label":"Price","default":"$129.99"},{"type":"text","id":"compare","label":"Compare price","default":"$229"},{"type":"text","id":"cta_text","label":"Button text","default":"Shop the Mini Glide"},{"type":"url","id":"cta_link","label":"Button link","default":"#buy"}],"presets":[{"name":"HELIOS Mini Feature"}]}
{% endschema %}
