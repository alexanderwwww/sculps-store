{%- comment -%}
  HELIOS Buy Box — v2, coded from scratch on the KURU blueprint.
  Left: thumb rail + big square image + review strip + check strip.
  Right: crumb, stars, title+price, pills, bold sub, best-for, variant toggle, bundles, ATC, Buy Now.
  Below: FAQ + UGC phone video. All exact-pay pricing (x0.88), gift auto-add on 3/4-pack.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign product = all_products[section.settings.featured_product] | default: product -%}
{%- assign cur = product.selected_or_first_available_variant -%}
{%- assign scp = cur.price | times: 0.88 | round -%}
<section class="helios" id="hb-{{ sid }}">
<style>
  #hb-{{ sid }}{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111;background:#fff;}
  #hb-{{ sid }} *{box-sizing:border-box;}
  #hb-{{ sid }} .k-wrap{max-width:1180px;margin:0 auto;padding:26px 22px;display:grid;grid-template-columns:1fr;gap:30px;align-items:start;}
  @media(min-width:880px){#hb-{{ sid }} .k-wrap{grid-template-columns:1.08fr .92fr;gap:38px;}}
  /* LEFT */
  #hb-{{ sid }} .k-gal{display:flex;gap:12px;}
  #hb-{{ sid }} .k-rail{display:flex;flex-direction:column;gap:8px;width:56px;flex:0 0 56px;max-height:600px;overflow-y:auto;scrollbar-width:none;}
  #hb-{{ sid }} .k-rail::-webkit-scrollbar{display:none;}
  #hb-{{ sid }} .k-th{width:56px;height:56px;flex:0 0 auto;border:1.5px solid #E3E3E1;border-radius:9px;background:#fff;overflow:hidden;cursor:pointer;padding:0;position:relative;}
  #hb-{{ sid }} .k-th img{width:100%;height:100%;object-fit:cover;display:block;}
  #hb-{{ sid }} .k-th.sel{border:2px solid #0A0D11;}
  #hb-{{ sid }} .k-th .vk{position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-size:15px;text-shadow:0 1px 5px rgba(0,0,0,.6);}
  #hb-{{ sid }} .k-stage{flex:1;min-width:0;position:relative;aspect-ratio:1/1;background:#F5F6F4;border-radius:8px;overflow:hidden;}
  #hb-{{ sid }} .k-stage img,#hb-{{ sid }} .k-stage video{width:100%;height:100%;object-fit:cover;display:block;}
  #hb-{{ sid }} .k-bs{position:absolute;top:12px;right:12px;background:#0A0D11;color:#fff;font-size:11px;font-weight:700;padding:5px 11px;border-radius:20px;z-index:2;}
  #hb-{{ sid }} .k-ar{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:32px;height:32px;border-radius:50%;background:#fff;border:1px solid #E3E3E1;display:grid;place-items:center;font-size:16px;cursor:pointer;z-index:2;}
  #hb-{{ sid }} .k-quote{display:flex;align-items:center;gap:12px;background:#F7F7F5;border-radius:8px;padding:13px 16px;margin-top:12px;font-size:13.5px;}
  #hb-{{ sid }} .k-quote .st{letter-spacing:2px;font-size:12px;color:#111;flex:0 0 auto;}
  #hb-{{ sid }} .k-quote b{font-weight:700;}
  #hb-{{ sid }} .k-quote .who{margin-left:auto;color:#666;font-size:12.5px;flex:0 0 auto;}
  #hb-{{ sid }} .k-check{display:block;text-align:center;background:#EDF7EF;border-radius:8px;padding:11px;margin-top:8px;font-size:13px;color:#2E5A3C;font-weight:600;text-decoration:none;}
  #hb-{{ sid }} .k-val{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px;}
  #hb-{{ sid }} .k-vitem{border:1px solid #E6E6E4;border-radius:10px;padding:13px 10px;text-align:center;background:#fff;}
  #hb-{{ sid }} .k-vitem b{display:block;font-size:18px;font-weight:800;color:#0A0D11;}
  #hb-{{ sid }} .k-vitem span{font-size:11px;color:#777;line-height:1.3;display:block;margin-top:3px;}
  #hb-{{ sid }} .k-dpills{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px;justify-content:center;}
  #hb-{{ sid }} .k-dpills span{font-size:12px;font-weight:600;color:#2E5A3C;background:#EDF7EF;border-radius:100px;padding:6px 11px;}
  #hb-{{ sid }} .k-motion{margin-top:18px;text-align:center;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:19px;color:#3d4a56;opacity:0;transition:opacity 1.1s ease;min-height:28px;}
  #hb-{{ sid }} .k-motion.in{opacity:1;}
  @media(prefers-reduced-motion:reduce){#hb-{{ sid }} .k-motion{opacity:1!important;transition:none;}}
  /* RIGHT */
  #hb-{{ sid }} .k-crumb{font-size:9.5px;letter-spacing:.08em;color:#999;font-weight:600;margin-bottom:10px;text-transform:uppercase;}
  #hb-{{ sid }} .k-stars{font-size:13px;color:#111;margin-bottom:6px;text-decoration:none;display:block;}
  #hb-{{ sid }} .k-stars span{letter-spacing:1px;color:#f5a623;}
  #hb-{{ sid }} .k-trow{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;}
  #hb-{{ sid }} .k-trow h1{font-size:clamp(24px,2.6vw,30px);font-weight:800;margin:0;letter-spacing:.01em;}
  #hb-{{ sid }} .k-price{text-align:right;white-space:nowrap;padding-top:3px;}
  #hb-{{ sid }} .k-price b{font-size:22px;font-weight:700;display:block;}
  #hb-{{ sid }} .k-price s{font-size:12.5px;color:#b3b3b1;}
  #hb-{{ sid }} .k-price .sv{display:block;font-size:11.5px;font-weight:700;color:#16a34a;}
  #hb-{{ sid }} .k-pills{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 12px;}
  #hb-{{ sid }} .k-pill{font-size:11px;font-weight:700;background:#F4F1E8;border-radius:6px;padding:5px 9px;color:#4d4a3a;}
  #hb-{{ sid }} .k-desc{font-size:14px;font-weight:700;line-height:1.45;margin-bottom:8px;}
  #hb-{{ sid }} .k-desc p{margin:0;display:inline;}
  #hb-{{ sid }} .k-best{font-size:13px;color:#555;margin-bottom:14px;}
  #hb-{{ sid }} .k-best b{color:#111;}
  #hb-{{ sid }} .k-seg{display:flex;background:#F1F1EF;border:1px solid #E3E3E1;border-radius:100px;padding:4px;margin-bottom:16px;}
  #hb-{{ sid }} .k-seg button{flex:1;text-align:center;padding:11px;font-size:14px;font-weight:700;border-radius:100px;color:#333;background:transparent;border:1.5px solid transparent;cursor:pointer;font-family:inherit;}
  #hb-{{ sid }} .k-seg button.on{background:#fff;border-color:#111;color:#111;}
  #hb-{{ sid }} .k-lbl{font-size:11px;font-weight:800;letter-spacing:.07em;margin:0 0 10px;color:#0A0D11;text-transform:uppercase;}
  #hb-{{ sid }} .k-tier{display:flex;align-items:center;gap:11px;border:1.5px solid #E4E4E2;border-radius:13px;padding:12px 14px;margin-bottom:9px;position:relative;cursor:pointer;background:#fff;}
  #hb-{{ sid }} .k-tier.sel{border:2px solid #0A0D11;background:#F6FBF8;}
  #hb-{{ sid }} .k-badge{position:absolute;top:-9px;left:14px;background:#0A0D11;color:#fff;font-size:9px;font-weight:700;letter-spacing:.03em;padding:3px 9px;border-radius:12px;text-transform:uppercase;}
  #hb-{{ sid }} .k-rad{width:19px;height:19px;flex:0 0 auto;border-radius:50%;border:2px solid #C9C9C7;background:#fff;}
  #hb-{{ sid }} .k-tier.sel .k-rad{border:6px solid #0A0D11;}
  #hb-{{ sid }} .k-tin{flex:1;min-width:0;}
  #hb-{{ sid }} .k-tin b{display:block;font-size:14.5px;}
  #hb-{{ sid }} .k-tin span{display:block;font-size:12px;color:#777;}
  #hb-{{ sid }} .k-tp{text-align:right;flex:0 0 auto;display:flex;flex-direction:column;align-items:flex-end;gap:1px;}
  #hb-{{ sid }} .k-tp b{display:block;font-size:16.5px;font-weight:800;}
  #hb-{{ sid }} .k-tp s{font-size:11.5px;color:#bbb;}
  #hb-{{ sid }} .k-off{display:inline-block;background:#E11D48;color:#fff;font-size:9.5px;font-weight:800;letter-spacing:.02em;padding:2px 7px;border-radius:6px;}
  #hb-{{ sid }} .k-per{display:block;font-size:11px;color:#9aa3ab;margin-top:1px;}
  #hb-{{ sid }} .k-gift{display:inline-block;font-size:10px;font-weight:800;color:#06281B;background:linear-gradient(90deg,#7CF5C2,#10C97E);padding:1px 7px;border-radius:100px;margin-top:2px;}
  #hb-{{ sid }} .k-atc{width:100%;background:#0A0D11;border:none;color:#fff;font-size:16px;font-weight:800;padding:16px;border-radius:100px;margin-top:12px;cursor:pointer;font-family:inherit;}
  #hb-{{ sid }} .k-atc[disabled]{opacity:.5;cursor:default;}
  #hb-{{ sid }} .k-buynow{width:100%;background:#F1F1EF;border:none;color:#111;font-size:14.5px;font-weight:700;padding:14px;border-radius:100px;margin-top:9px;cursor:pointer;font-family:inherit;}
  /* FAQ + phone */
  #hb-{{ sid }} .k-faq{max-width:1180px;margin:8px auto 0;padding:34px 22px 14px;display:grid;grid-template-columns:1fr;gap:26px;border-top:1px solid #EDEDEA;}
  @media(min-width:880px){#hb-{{ sid }} .k-faq{grid-template-columns:.78fr 1.22fr;gap:46px;align-items:center;}}
  #hb-{{ sid }} .k-phone{justify-self:center;position:relative;width:min(270px,76vw);aspect-ratio:9/16;border-radius:42px;overflow:hidden;background:#0E1116;border:9px solid #17181C;box-shadow:0 28px 56px -28px rgba(10,13,17,.5),inset 0 0 0 2px #2A2B31;}
  #hb-{{ sid }} .k-phone::before{content:'';position:absolute;top:10px;left:50%;transform:translateX(-50%);width:80px;height:22px;background:#0B0B0E;border-radius:14px;z-index:5;}
  #hb-{{ sid }} .k-phone video{width:100%;height:100%;object-fit:cover;display:block;}
  #hb-{{ sid }} .k-phone .tag{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);background:rgba(255,255,255,.2);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);color:#fff;font-size:11px;font-weight:700;padding:5px 12px;border-radius:100px;border:1px solid rgba(255,255,255,.3);white-space:nowrap;z-index:6;}
  #hb-{{ sid }} .k-fh{font-size:clamp(20px,2.3vw,27px);font-weight:800;margin:0 0 4px;letter-spacing:-.01em;}
  #hb-{{ sid }} .k-fsub{font-size:14px;color:#6b6b6b;margin:0 0 14px;}
  #hb-{{ sid }} .k-fq{border-bottom:1px solid #E6E6E6;}
  #hb-{{ sid }} .k-fq .q{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:15px 2px;cursor:pointer;font-weight:700;font-size:15.5px;}
  #hb-{{ sid }} .k-fq .ic{flex:0 0 auto;width:24px;height:24px;border-radius:50%;border:1.5px solid #C9CFC9;display:grid;place-items:center;font-size:16px;line-height:1;color:#1f5c3d;transition:transform .3s;}
  #hb-{{ sid }} .k-fq.on .ic{transform:rotate(45deg);background:#1f5c3d;color:#fff;border-color:#1f5c3d;}
  #hb-{{ sid }} .k-fq .a{max-height:0;overflow:hidden;transition:max-height .3s ease;}
  #hb-{{ sid }} .k-fq .a p{margin:0;padding:0 2px 15px;font-size:14px;line-height:1.6;color:#5b6470;}
  /* sticky bar */
  #hb-stk-{{ sid }}{position:fixed;left:14px;right:82px;bottom:16px;z-index:9998;display:flex;align-items:center;gap:11px;padding:8px 9px 8px 12px;background:rgba(255,255,255,.92);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid #E5E5E3;border-radius:26px;box-shadow:0 16px 36px rgba(6,30,46,.18);transform:translateY(calc(100% + 30px));transition:transform .4s cubic-bezier(.2,.8,.2,1);}
  #hb-stk-{{ sid }}.show{transform:translateY(0);}
  #hb-stk-{{ sid }} img{width:40px;height:40px;border-radius:12px;object-fit:cover;}
  #hb-stk-{{ sid }} .n{font-weight:800;font-size:13.5px;line-height:1.15;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  #hb-stk-{{ sid }} .p{font-weight:800;font-size:13px;}
  #hb-stk-{{ sid }} .i{flex:1;min-width:0;}
  #hb-stk-{{ sid }} button{flex:0 0 auto;background:#0A0D11;color:#fff;border:none;border-radius:30px;padding:13px 21px;font-weight:800;font-size:14px;cursor:pointer;font-family:inherit;}
  @media(max-width:879px){#hb-{{ sid }} .k-gal{flex-direction:column-reverse;}#hb-{{ sid }} .k-rail{flex-direction:row;width:100%;flex:none;max-height:none;overflow-x:auto;}#hb-{{ sid }} .k-trow{flex-direction:column;gap:4px;}#hb-{{ sid }} .k-price{text-align:left;display:flex;align-items:baseline;gap:9px;}#hb-{{ sid }} .k-price .sv{display:inline;}}
</style>

<div class="k-wrap" id="buy" style="scroll-margin-top:84px;">
  <div>
    <div class="k-gal">
      <div class="k-rail" id="k-rail-{{ sid }}">
        {%- assign vposter = '' -%}
        {%- if section.settings.lead_video != blank and section.settings.lead_video.preview_image != blank -%}{%- assign vposter = section.settings.lead_video.preview_image | image_url: width: 220 -%}{%- endif -%}
        {%- for img in product.images limit: 9 -%}
          <button type="button" class="k-th{% if forloop.first %} sel{% endif %}" data-kind="img" data-src="{{ img | image_url: width: 900 }}"><img src="{{ img | image_url: width: 220 }}" alt="{{ product.title | escape }}" loading="lazy"></button>
          {%- if forloop.first and section.settings.lead_video != blank -%}
          <button type="button" class="k-th" data-kind="vid">{% if vposter != '' %}<img src="{{ vposter }}" alt="video">{% endif %}<span class="vk">▶</span></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="k-stage" id="k-stage-{{ sid }}">
        <img id="k-main-{{ sid }}" src="{{ product.featured_image | default: section.settings.lead_image | image_url: width: 1100 }}" alt="{{ product.title | escape }}">
        {%- if section.settings.lead_video != blank -%}
        <video id="k-vid-{{ sid }}" style="display:none;" muted loop playsinline preload="metadata"{% if section.settings.lead_video.preview_image != blank %} poster="{{ section.settings.lead_video.preview_image | image_url: width: 900 }}"{% endif %}>{%- for src in section.settings.lead_video.sources -%}<source src="{{ src.url }}" type="{{ src.mime_type }}">{%- endfor -%}</video>
        {%- endif -%}
        <span class="k-bs">Best Seller</span>
        <button type="button" class="k-ar" data-knext aria-label="Next image">›</button>
      </div>
    </div>
    <div class="k-quote"><span class="st">★★★★★</span><span><b>5 stars for summer!</b> My son will NOT get off this thing.</span><span class="who">elena d.</span></div>
    <a class="k-check" href="#k-faq-{{ sid }}">Is the Super Glide right for your family? Let's check →</a>
    <div class="k-val">
      <div class="k-vitem"><b>#1</b><span>Motorized lounger in the USA</span></div>
      <div class="k-vitem"><b>21,600+</b><span>sold to happy families</span></div>
      <div class="k-vitem"><b>30-Day</b><span>money-back guarantee</span></div>
    </div>
    <div class="k-dpills">
      <span>✓ Holds 300 lb</span><span>✓ ~2 h per charge</span><span>✓ Inflates in ~5 min</span><span>✓ Easy joysticks</span><span>✓ Pool · lake · river</span>
    </div>
    <div class="k-motion" id="k-motion-{{ sid }}">You only get so many summers.</div>
  </div>

  <div>
    <div class="k-crumb">Home &rsaquo; Water Loungers &rsaquo; Super Glide</div>
    <a class="k-stars" href="#reviews"><span>★★★★★</span> <b>{{ section.settings.rating | default: '4.8' }}</b> ({{ section.settings.review_count | default: '3,912' }} reviews)</a>
    <div class="k-trow">
      <h1 id="k-title-{{ sid }}">{{ section.settings.title | default: 'HELIOS Super Glide' }}</h1>
      <div class="k-price">
        <b id="k-price-{{ sid }}">{{ scp | money }}</b>
        <s id="k-cmp-{{ sid }}"{% unless cur.compare_at_price > cur.price %} style="display:none"{% endunless %}>{{ cur.compare_at_price | money }}</s>
        <span class="sv" id="k-save-{{ sid }}"{% unless cur.compare_at_price > cur.price %} style="display:none"{% endunless %}>You save {{ cur.compare_at_price | minus: scp | money }}</span>
      </div>
    </div>
    <div class="k-pills"><span class="k-pill">☀ Summer Sale — up to 63% OFF</span><span class="k-pill">🛡 30-Day Money-Back</span></div>
    <div class="k-desc">A motorized water lounger — because summer memories don't make themselves.</div>
    <div class="k-best"><b>Best for:</b> Pool Days, Lake Weekends, The Grandkids, Everyday</div>

    {%- assign hb_form_id = 'k-form-' | append: sid -%}
    {%- form 'product', product, id: hb_form_id -%}
      <input type="hidden" name="id" id="k-vidin-{{ sid }}" value="{{ cur.id }}">
      {%- if section.settings.show_picker -%}
      <div class="k-seg" id="k-seg-{{ sid }}">
        <button type="button" class="on" data-pick="double">Super Glide</button>
        <button type="button" data-pick="mini">Mini Glide</button>
      </div>
      {%- endif -%}
      <div class="k-lbl">Pick Your Bundle</div>
      <div id="k-tiers-{{ sid }}">
        {%- if section.settings.show_picker -%}
        {%- for v in product.variants -%}
          {%- if v.title contains 'Mini' -%}
            {%- assign mqty = 1 -%}{%- assign msub = 'Single seat · most affordable' -%}{%- assign mbadge = '' -%}{%- assign msel = '' -%}
            {%- if v.title contains '2' -%}{%- assign mqty = 2 -%}{%- assign msub = 'BUY 1 GET 1 50% OFF · race a friend' -%}{%- assign mbadge = 'Most popular' -%}{%- assign msel = ' sel' -%}{%- endif -%}
            {%- if v.title contains '3' -%}{%- assign mqty = 3 -%}{%- assign msub = 'Best value · the whole crew' -%}{%- assign mbadge = 'Best value' -%}{%- endif -%}
            <div class="k-tier{{ msel }}" data-tier="mini" style="display:none;" data-vid="{{ v.id }}" data-price="{{ v.price }}" data-compare="{{ v.compare_at_price | default: 0 }}">
              {%- if mbadge != blank -%}<span class="k-badge">{{ mbadge }}</span>{%- endif -%}
              <span class="k-rad"></span>
              {%- assign mpaid = v.price | times: 0.88 | round -%}
              {%- assign mper = mpaid | divided_by: mqty -%}
              <div class="k-tin"><b>{{ mqty }} × Mini Glide</b><span>{{ msub }}</span><span class="k-per">{{ mper | money }} each</span></div>
              <div class="k-tp">{% if v.compare_at_price > mpaid %}<em class="k-off">{{ v.compare_at_price | minus: mpaid | times: 100 | divided_by: v.compare_at_price }}% OFF</em>{% endif %}<b>{{ mpaid | money }}</b>{% if v.compare_at_price > v.price %}<s>{{ v.compare_at_price | money }}</s>{% endif %}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'bundle' -%}
            {%- assign vid = block.settings.variant_id | times: 1 -%}
            {%- assign bv = blank -%}
            {%- for v in product.variants -%}{%- if v.id == vid -%}{%- assign bv = v -%}{%- endif -%}{%- endfor -%}
            {%- assign tprice = bv.price | default: block.settings.fallback_price | plus: 0 -%}
            {%- assign tcompare = bv.compare_at_price | default: block.settings.fallback_compare | plus: 0 -%}
            {%- assign qty = block.settings.qty | default: 1 -%}
            {%- assign paid = tprice | times: 0.88 | round -%}
            {%- assign perunit = paid | divided_by: qty -%}
            <div class="k-tier{% if block.settings.preselect %} sel{% endif %}" data-tier="double" data-vid="{{ bv.id | default: vid }}" data-price="{{ tprice }}" data-compare="{{ tcompare }}" {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}<span class="k-badge">{{ block.settings.badge }}</span>{%- endif -%}
              <span class="k-rad"></span>
              <div class="k-tin"><b>{{ block.settings.label | default: bv.title }}</b>{% if block.settings.sublabel != blank %}<span>{{ block.settings.sublabel }}</span>{% endif %}{% if qty >= 3 %}<span class="k-gift">🎁 FREE Jet Ski &amp; Pump included</span>{% endif %}<span class="k-per">{{ perunit | money }} each</span></div>
              <div class="k-tp">{% if tcompare > paid %}<em class="k-off">{{ tcompare | minus: paid | times: 100 | divided_by: tcompare }}% OFF</em>{% endif %}<b>{{ paid | money }}</b>{% if tcompare > tprice %}<s>{{ tcompare | money }}</s>{% endif %}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button type="submit" name="add" class="k-atc" id="k-atc-{{ sid }}" {% unless cur.available %}disabled{% endunless %}>🛒 {{ section.settings.cta_text | default: 'Add to Cart' }} →</button>
      <button type="button" class="k-buynow" id="k-buynow-{{ sid }}" {% unless cur.available %}disabled{% endunless %}>Buy Now</button>
    {%- endform -%}
  </div>
</div>

<div class="k-faq" id="k-faq-{{ sid }}">
  <div class="k-phone"><video src="https://cdn.shopify.com/videos/c/o/v/a9eb5029ae0d4f0e817fb55493545906.mp4" muted loop playsinline autoplay preload="metadata"></video><span class="tag">▶ Real families, real water</span></div>
  <div>
    <h2 class="k-fh">Everything you're wondering, answered.</h2>
    <div class="k-fsub">Honest answers — watch it in action while you read.</div>
    <div class="k-fq on"><div class="q">Does it really move on its own?<span class="ic">+</span></div><div class="a"><p>Yes — twin quiet electric motors push you forward and let you spin 360° with the joysticks. No paddling, no gas, no motorboat. Completely hands-free.</p></div></div>
    <div class="k-fq"><div class="q">Is it safe for kids?<span class="ic">+</span></div><div class="a"><p>Yes — the motors are fully enclosed with no exposed blades, and it cruises at a gentle walking pace. Kids ride with a parent up to the 300 lb capacity, life jackets on.</p></div></div>
    <div class="k-fq"><div class="q">How long does the battery last?<span class="ic">+</span></div><div class="a"><p>About 2 hours of continuous cruising per charge — a whole afternoon on the water — and it recharges between sessions.</p></div></div>
    <div class="k-fq"><div class="q">How hard is it to set up?<span class="ic">+</span></div><div class="a"><p>Inflate it in about 5 minutes with the included nozzle, drop it in, grab the joysticks and go. No tools.</p></div></div>
    <div class="k-fq"><div class="q">What if I don't love it?<span class="ic">+</span></div><div class="a"><p>Send it back within 30 days for a full refund. No hassle — the risk is entirely ours.</p></div></div>
  </div>
</div>
</section>

<div id="hb-stk-{{ sid }}" aria-hidden="true">
  {%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="">{%- endif -%}
  <div class="i"><div class="n">{{ section.settings.title | default: 'HELIOS Super Glide' }}</div><div class="p" id="k-stkp-{{ sid }}">{{ scp | money }}</div></div>
  <button type="button" id="k-stka-{{ sid }}">Add to cart</button>
</div>

<script>
(function(){
  var root=document.getElementById('hb-{{ sid }}'); if(!root||root.dataset.i)return; root.dataset.i='1';
  var DISC='{{ section.settings.discount_code }}';
  var HGT={'47935890849957':1,'47935890882725':1}, GIFTS=[48001507197093,48001507262629];
  var money=function(c){return '{{ shop.money_format | strip_html }}'.replace(/\{\{\s*amount\s*\}\}/,(c/100).toFixed(2)).replace(/\{\{\s*amount_no_decimals\s*\}\}/,Math.round(c/100));};

  /* gallery: thumbs swap the main image / video */
  var rail=document.getElementById('k-rail-{{ sid }}');
  var main=document.getElementById('k-main-{{ sid }}');
  var vid=document.getElementById('k-vid-{{ sid }}');
  var ths=[].slice.call(rail.querySelectorAll('.k-th')), ki=0;
  function kshow(i){
    ki=(i%ths.length+ths.length)%ths.length;
    ths.forEach(function(t,j){t.classList.toggle('sel',j===ki);});
    var t=ths[ki];
    if(t.dataset.kind==='vid'&&vid){ main.style.display='none'; vid.style.display='block'; var p=vid.play(); if(p&&p.catch)p.catch(function(){}); }
    else { if(vid){vid.pause(); vid.style.display='none';} main.style.display='block'; if(t.dataset.src) main.src=t.dataset.src; }
  }
  ths.forEach(function(t,i){t.addEventListener('click',function(){kshow(i);});});
  var nx=root.querySelector('[data-knext]'); if(nx)nx.addEventListener('click',function(){kshow(ki+1);});

  /* tiers */
  var hid=document.getElementById('k-vidin-{{ sid }}');
  var priceEl=document.getElementById('k-price-{{ sid }}'), cmpEl=document.getElementById('k-cmp-{{ sid }}'), saveEl=document.getElementById('k-save-{{ sid }}'), stkp=document.getElementById('k-stkp-{{ sid }}');
  var tiersBox=document.getElementById('k-tiers-{{ sid }}');
  function tiers(){return [].slice.call(tiersBox.querySelectorAll('.k-tier'));}
  function pick(t){
    tiers().forEach(function(x){x.classList.remove('sel');}); t.classList.add('sel');
    hid.value=t.dataset.vid;
    var p=Math.round(parseInt(t.dataset.price,10)*0.88), c=parseInt(t.dataset.compare,10)||0;
    if(priceEl)priceEl.textContent=money(p);
    if(stkp)stkp.textContent=money(p);
    if(cmpEl){ if(c>p){cmpEl.style.display='';cmpEl.textContent=money(c);} else cmpEl.style.display='none'; }
    if(saveEl){ if(c>p){saveEl.style.display='';saveEl.textContent='You save '+money(c-p);} else saveEl.style.display='none'; }
  }
  tiers().forEach(function(t){t.addEventListener('click',function(){pick(t);});});

  /* Super/Mini toggle */
  var seg=document.getElementById('k-seg-{{ sid }}');
  var title=document.getElementById('k-title-{{ sid }}');
  if(seg){ [].slice.call(seg.querySelectorAll('button')).forEach(function(b){
    b.addEventListener('click',function(){
      [].slice.call(seg.querySelectorAll('button')).forEach(function(x){x.classList.remove('on');}); b.classList.add('on');
      var mode=b.dataset.pick;
      if(title) title.textContent = mode==='mini' ? 'HELIOS Mini Glide' : '{{ section.settings.title | default: 'HELIOS Super Glide' }}';
      tiers().forEach(function(t){ t.style.display = (t.dataset.tier===mode)?'':'none'; });
      var first=tiers().filter(function(t){return t.dataset.tier===mode;})[0];
      if(first) pick(first);
    });
  }); tiers().forEach(function(t){ t.style.display=(t.dataset.tier==='double')?'':'none'; }); }

  /* add to cart: fetch add (+gifts on 3/4-pack), then discount redirect */
  function items(){
    var arr=[{id:parseInt(hid.value,10),quantity:1}];
    if(HGT[hid.value]) GIFTS.forEach(function(g){arr.push({id:g,quantity:1});});
    return arr;
  }
  function addThen(dest,btn){
    var t=btn.textContent; btn.disabled=true; btn.textContent='Adding…';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items()})})
      .then(function(r){ if(!r.ok)throw 0; window.location.href=dest; })
      .catch(function(){ btn.disabled=false; btn.textContent=t; window.location.href='/cart/'+hid.value+':1'+(DISC?('?discount='+DISC):''); });
  }
  var form=document.getElementById('k-form-{{ sid }}');
  var atc=document.getElementById('k-atc-{{ sid }}');
  if(form&&atc){ form.addEventListener('submit',function(e){ e.preventDefault(); addThen(DISC?('/discount/'+DISC+'?redirect=%2Fcart'):'/cart',atc); }); }
  var bn=document.getElementById('k-buynow-{{ sid }}');
  if(bn) bn.addEventListener('click',function(){ addThen(DISC?('/discount/'+DISC+'?redirect=%2Fcheckout'):'/checkout',bn); });

  /* sticky bar */
  var stk=document.getElementById('hb-stk-{{ sid }}');
  if(stk){ if(stk.parentNode!==document.body)document.body.appendChild(stk);
    if('IntersectionObserver' in window && atc){ new IntersectionObserver(function(es){es.forEach(function(en){stk.classList.toggle('show',!en.isIntersecting);});},{threshold:0}).observe(atc); }
    var ska=document.getElementById('k-stka-{{ sid }}'); if(ska)ska.addEventListener('click',function(){ addThen(DISC?('/discount/'+DISC+'?redirect=%2Fcart'):'/cart',ska); });
  }

  /* FAQ accordion + phone autoplay */
  var fr=document.getElementById('k-faq-{{ sid }}');
  if(fr){ var fqs=[].slice.call(fr.querySelectorAll('.k-fq'));
    function setH(f){var a=f.querySelector('.a');a.style.maxHeight=f.classList.contains('on')?a.scrollHeight+'px':'0px';}
    fqs.forEach(function(f){setH(f);f.querySelector('.q').addEventListener('click',function(){var op=!f.classList.contains('on');fqs.forEach(function(o){o.classList.remove('on');setH(o);});if(op)f.classList.add('on');setH(f);});});
    var pv=fr.querySelector('.k-phone video'); if(pv){var pp=pv.play(); if(pp&&pp.catch)pp.catch(function(){});}
  }

  /* rotating emotional title — appears and disappears */
  var mo=document.getElementById('k-motion-{{ sid }}');
  if(mo && !(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches)){
    var lines=["You only get so many summers.","Feel like summer again.","Make this the summer they tell their kids about."], mi=0;
    (function cyc(){ mo.classList.add('in'); setTimeout(function(){ mo.classList.remove('in'); setTimeout(function(){ mi=(mi+1)%lines.length; mo.textContent=lines[mi]; cyc(); },1200); },4200); })();
  } else if(mo){ mo.classList.add('in'); }
})();
</script>

