{%- comment -%}
============================================================================
  HELIOS SUPER GLIDE — BUY BOX  (product-first, conversion-optimized)
  Drop into: sections/helios-buy-box.liquid  →  add to product template.
  ----------------------------------------------------------------------------
  • Real Shopify buy form: {% form 'product', product %} + {{ form | payment_button }}
    renders Apple Pay / Shop Pay / Google Pay express buttons.
  • Bundle tiers = section BLOCKS, each pointing at a REAL variant ID, so each
    tier adds the correct variant. Prices pulled live via {{ variant.price | money }}.
  • Lead media = demo video (autoplay muted loop playsinline, poster fallback),
    with gallery thumbs below. Hero video vs image is a setting (A/B).
  • Countdown (per-session, honest), low-stock, live viewers, recent-purchase toasts.
  HOW TO WIRE VARIANTS:
    Online Store → Theme editor → this section → each "Bundle tier" block →
    paste the numeric Variant ID (Products → variant → the number at the end of
    the admin URL …/variants/<ID>). qty = how many units that variant represents.
============================================================================
{%- endcomment -%}

{%- unless product -%}{%- assign product = section.settings.featured_product -%}{%- endunless -%}
{%- assign cur = product.selected_or_first_available_variant -%}
{%- assign sid = section.id -%}

<section class="helios helios-buy" id="hb-{{ sid }}">
<style>
  #hb-{{ sid }} .hb-wrap{max-width:1200px;margin:0 auto;padding:clamp(16px,3vw,40px) 22px clamp(32px,5vw,56px);}
  #hb-{{ sid }} .hb-grid{display:grid;grid-template-columns:1fr;gap:30px;}
  @media(min-width:880px){
    #hb-{{ sid }} .hb-grid{grid-template-columns:1.04fr .96fr;gap:46px;align-items:start;}
    #hb-{{ sid }} .hb-gallery{position:sticky;top:90px;}
  }
  #hb-{{ sid }} .hb-stage{position:relative;display:flex;overflow-x:auto;overflow-y:hidden;touch-action:pan-x;scroll-snap-type:x mandatory;scroll-behavior:smooth;border-radius:24px;background:linear-gradient(160deg,#EAF6FB,#D6ECF5);border:var(--helios-g-bd,1px solid rgba(255,255,255,.65));box-shadow:var(--helios-g-shlg,0 26px 60px -18px rgba(6,47,73,.3));aspect-ratio:1/1;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;}
  #hb-{{ sid }} .hb-cell{flex:0 0 100%;scroll-snap-align:center;display:grid;place-items:center;position:relative;height:100%;overflow:hidden;}
  #hb-{{ sid }} .hb-stage::-webkit-scrollbar{display:none;}
  @media(max-width:879px){ #hb-{{ sid }} .hb-stage{aspect-ratio:4/3;} }
  #hb-{{ sid }} .hb-cell{flex:0 0 100%;scroll-snap-align:center;display:grid;place-items:center;position:relative;}
  #hb-{{ sid }} .hb-cell > img,#hb-{{ sid }} .hb-cell > video{width:100%;height:100%;object-fit:contain;display:block;}
  #hb-{{ sid }} .hb-dots{display:flex;gap:6px;justify-content:center;margin-top:11px;min-height:7px;}
  #hb-{{ sid }} .hb-dot{width:7px;height:7px;border-radius:50%;background:rgba(12,26,36,.18);transition:.2s;}
  #hb-{{ sid }} .hb-dot.on{background:var(--helios-acc,#0E7CC4);width:20px;border-radius:4px;}
  #hb-{{ sid }} .hb-pk{flex:1;display:flex;align-items:center;gap:11px;text-align:left;cursor:pointer;border:2px solid rgba(12,26,36,.14);background:#fff;border-radius:14px;padding:10px 13px;transition:.18s;}
  #hb-{{ sid }} .hb-pk .hb-pkimg{flex:0 0 46px;width:46px;height:46px;border-radius:10px;object-fit:cover;background:linear-gradient(160deg,#EAF6FB,#D6ECF5);}
  #hb-{{ sid }} .hb-pk .hb-pktx{display:flex;flex-direction:column;min-width:0;}
  #hb-{{ sid }} .hb-pk b{display:block;font-family:'Archivo',sans-serif;font-weight:800;font-size:14px;color:var(--helios-ink,#0C1A24);}
  #hb-{{ sid }} .hb-pk span{font-size:11.5px;color:var(--helios-mut,#56636E);}
  #hb-{{ sid }} .hb-pk.on{background:#0A1219;border-color:#0A1219;box-shadow:0 12px 26px rgba(6,30,46,.30);}
  #hb-{{ sid }} .hb-pk.on b{color:#fff;}
  #hb-{{ sid }} .hb-pk.on span{color:rgba(255,255,255,.72);}
  #hb-{{ sid }} .hb-thumbs{display:flex;gap:11px;overflow-x:auto;margin-top:14px;padding-bottom:6px;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
  #hb-{{ sid }} .hb-thumbs::-webkit-scrollbar{display:none;}
  #hb-{{ sid }} .hb-thumb{position:relative;padding:0;flex:0 0 clamp(74px,23%,104px);aspect-ratio:1/1;border:1.5px solid rgba(12,26,36,.10);border-radius:15px;overflow:hidden;cursor:pointer;background:linear-gradient(160deg,#F4FAFD,#E6F1F8);transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;}
  #hb-{{ sid }} .hb-thumb:hover{transform:translateY(-2px);border-color:rgba(14,124,196,.5);box-shadow:0 8px 18px rgba(14,124,196,.18);}
  #hb-{{ sid }} .hb-thumb.sel{border:2px solid var(--helios-acc,#0E7CC4);box-shadow:0 0 0 3px rgba(14,124,196,.15),0 8px 18px rgba(14,124,196,.22);}
  #hb-{{ sid }} .hb-thumb img,#hb-{{ sid }} .hb-thumb video{width:100%;height:100%;object-fit:cover;display:block;}
  #hb-{{ sid }} .hb-ey{display:inline-flex;align-items:center;gap:7px;background:#0C1A24;color:#fff;font-size:11.5px;font-weight:700;padding:7px 13px;border-radius:30px;margin-bottom:14px;}
  #hb-{{ sid }} h1{font-weight:800;font-size:clamp(28px,4.4vw,42px);line-height:1.04;letter-spacing:-.02em;margin:0;}
  #hb-{{ sid }} .hb-sub{color:var(--helios-mut,#56636E);font-size:15.5px;margin:9px 0 0;}
  #hb-{{ sid }} .hb-rate{display:flex;align-items:center;gap:8px;margin:13px 0 16px;font-size:13px;color:var(--helios-mut,#56636E);}
  #hb-{{ sid }} .hb-price{display:flex;align-items:baseline;gap:12px;margin-bottom:8px;flex-wrap:wrap;}
  #hb-{{ sid }} .hb-price b{font-weight:900;font-size:34px;color:var(--helios-ink2,#0A1219);}
  #hb-{{ sid }} .hb-price s{font-size:18px;color:var(--helios-mut,#56636E);}
  #hb-{{ sid }} .hb-save{font-size:11.5px;font-weight:800;letter-spacing:.04em;color:#fff;background:#1aa86b;padding:5px 10px;border-radius:30px;}
  #hb-{{ sid }} .hb-chips{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 2px;}
  #hb-{{ sid }} .hb-chip{font-size:11.5px;font-weight:700;color:var(--helios-ink,#0C1A24);background:rgba(14,124,196,.08);border:1px solid rgba(14,124,196,.16);border-radius:30px;padding:5px 10px;white-space:nowrap;}
  #hb-{{ sid }} .hb-timer{display:inline-flex;align-items:center;gap:7px;font-family:'Archivo';font-weight:800;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--helios-accd,#0A5E97);background:var(--helios-g-bg,rgba(255,255,255,.55));border:var(--helios-g-bd2,1px solid rgba(255,255,255,.45));backdrop-filter:var(--helios-g-blur);padding:7px 12px;border-radius:9px;margin-bottom:16px;}
  #hb-{{ sid }} .hb-tier{display:flex;align-items:center;gap:14px;border:2px solid var(--helios-line,rgba(255,255,255,.6));border-radius:18px;padding:16px 17px;cursor:pointer;position:relative;background:var(--helios-g-bg2,rgba(255,255,255,.4));backdrop-filter:var(--helios-g-blur);transition:.2s;margin-bottom:11px;}
  #hb-{{ sid }} .hb-tier.sel{border-color:var(--helios-acc,#0E7CC4);background:var(--helios-g-bg,rgba(255,255,255,.55));box-shadow:0 10px 26px rgba(14,124,196,.16);}
  #hb-{{ sid }} .hb-radio{width:22px;height:22px;border-radius:50%;border:2px solid #B7C7D2;flex-shrink:0;transition:.2s;}
  #hb-{{ sid }} .hb-tier.sel .hb-radio{border:6px solid var(--helios-acc,#0E7CC4);}
  #hb-{{ sid }} .hb-badge{position:absolute;top:-11px;right:16px;font-size:9.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:#fff;padding:4px 10px;border-radius:20px;}
  #hb-{{ sid }} .hb-tiername{font-family:'Archivo';font-weight:700;font-size:16px;}
  #hb-{{ sid }} .hb-tiersub{display:block;font-size:12.5px;color:var(--helios-accd,#0A5E97);font-weight:700;}
  #hb-{{ sid }} .hb-tierper{display:block;font-size:11.5px;color:var(--helios-mut,#56636E);font-weight:500;}
  #hb-{{ sid }} .hb-tierprice{text-align:right;}
  #hb-{{ sid }} .hb-tierprice b{font-family:'Archivo';font-weight:800;font-size:18px;}
  #hb-{{ sid }} .hb-tierprice s{display:block;font-size:12px;color:var(--helios-mut,#56636E);}
  #hb-{{ sid }} .hb-tiersave{display:block;font-size:11px;font-weight:800;color:#1aa86b;}
  #hb-{{ sid }} .hb-add{position:relative;overflow:hidden;display:flex;width:100%;align-items:center;justify-content:center;gap:9px;background:#0A1219;color:#fff;border:none;border-radius:16px;padding:18px;font-family:'Archivo';font-weight:800;font-size:17px;cursor:pointer;box-shadow:0 16px 34px rgba(10,18,25,.30);transition:transform .15s;margin-top:6px;}
  #hb-{{ sid }} .hb-add:hover{transform:translateY(-1px);}
  #hb-{{ sid }} .hb-add .hb-sheen{position:absolute;top:0;left:0;width:40%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);animation:helios-sheen 4.5s ease-in-out infinite;}
  #hb-{{ sid }} .hb-pay{margin-top:11px;}
  #hb-{{ sid }} .hb-pay .shopify-payment-button__button{border-radius:14px !important;font-family:'Archivo',sans-serif !important;font-weight:800 !important;}
  #hb-{{ sid }} .hb-code{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;margin-top:11px;background:var(--helios-g-bg,rgba(255,255,255,.55));border:1px dashed var(--helios-acc,#0E7CC4);backdrop-filter:var(--helios-g-blur);border-radius:13px;padding:12px 15px;cursor:pointer;transition:.2s;}
  #hb-{{ sid }} .hb-code b{font-family:'Archivo';font-weight:800;font-size:14px;color:var(--helios-accd,#0A5E97);letter-spacing:.04em;display:inline-flex;gap:8px;align-items:center;}
  #hb-{{ sid }} .hb-trust{display:flex;align-items:center;gap:8px;justify-content:center;margin-top:14px;font-size:12.5px;color:var(--helios-mut,#56636E);text-align:center;flex-wrap:wrap;}
  #hb-{{ sid }} .hb-pays{display:flex;gap:7px;justify-content:center;margin-top:12px;opacity:.72;flex-wrap:wrap;}
  #hb-{{ sid }} .hb-pays span{font-size:10px;font-weight:700;border:1px solid var(--helios-lins,rgba(12,26,36,.08));border-radius:6px;padding:4px 8px;color:var(--helios-mut,#56636E);}
  #hb-{{ sid }} .hb-eta{display:flex;align-items:center;gap:8px;justify-content:center;margin-top:13px;font-size:12.5px;color:var(--helios-ink,#0C1A24);font-weight:600;text-align:center;}
  #hb-{{ sid }} .hb-stock{margin-top:14px;background:var(--helios-g-bg,rgba(255,255,255,.55));border:var(--helios-g-bd2,1px solid rgba(255,255,255,.45));border-radius:13px;padding:12px 14px;font-size:12.5px;color:var(--helios-accd,#0A5E97);font-weight:600;}
  #hb-{{ sid }} .hb-stockbar{height:6px;background:#CFE7F5;border-radius:6px;margin-top:9px;overflow:hidden;}
  #hb-{{ sid }} .hb-stockbar i{display:block;height:100%;width:78%;background:linear-gradient(90deg,var(--helios-acc,#0E7CC4),var(--helios-teal,#2FC1D6));border-radius:6px;}
  #hb-{{ sid }} .hb-live{display:flex;align-items:center;gap:8px;justify-content:center;margin-top:12px;font-size:12px;color:var(--helios-mut,#56636E);}
  #hb-{{ sid }} .hb-dot{width:8px;height:8px;border-radius:50%;background:#1aa86b;animation:helios-pulse 1.6s ease-in-out infinite;}
  #hb-toast-{{ sid }}{position:fixed;left:16px;bottom:18px;z-index:120;display:flex;align-items:center;gap:11px;background:rgba(255,255,255,.86);backdrop-filter:var(--helios-g-blur);border:var(--helios-g-bd,1px solid rgba(255,255,255,.65));box-shadow:var(--helios-g-sh);border-radius:14px;padding:11px 15px 11px 12px;max-width:300px;opacity:0;pointer-events:none;transition:opacity .3s;}
  #hb-toast-{{ sid }}.show{opacity:1;animation:helios-toastin .4s ease;}
  #hb-toast-{{ sid }} .hb-tt-em{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--helios-acc,#0E7CC4),var(--helios-acc2,#16A6D6));display:grid;place-items:center;font-size:16px;flex-shrink:0;}
</style>

<div class="hb-wrap" id="buy" style="scroll-margin-top:84px;">
  <div class="hb-grid">

    {%- comment -%} ---------- GALLERY (double) ---------- {%- endcomment -%}
    <div class="hb-gallery" data-gal="double">
      <div class="hb-stage" id="hb-stage-{{ sid }}" data-track>
        {%- assign mainimg = product.featured_image | default: section.settings.lead_image -%}
        {%- assign nimg = product.images.size -%}
        {%- if nimg > 0 -%}
          {%- for img in product.images -%}
            <div class="hb-cell" data-slide="{{ forloop.index0 }}"><img src="{{ img | image_url: width: 700 }}" srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1000 }} 1000w" sizes="(min-width:880px) 540px, 92vw" width="1000" height="1000" alt="{{ product.title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async"{% if forloop.first %} fetchpriority="high"{% endif %}></div>
          {%- endfor -%}
        {%- elsif mainimg != blank -%}
          <div class="hb-cell" data-slide="0"><img src="{{ mainimg | image_url: width: 700 }}" srcset="{{ mainimg | image_url: width: 400 }} 400w, {{ mainimg | image_url: width: 700 }} 700w, {{ mainimg | image_url: width: 1000 }} 1000w" sizes="(min-width:880px) 540px, 92vw" width="1000" height="1000" alt="{{ product.title | escape }}" loading="eager" fetchpriority="high"></div>
        {%- endif -%}
        {%- if section.settings.lead_video != blank -%}
          <div class="hb-cell" data-slide="vid"><video muted loop playsinline preload="none"{% if section.settings.lead_video.preview_image != blank %} poster="{{ section.settings.lead_video.preview_image | image_url: width: 700 }}"{% endif %}>{%- for s in section.settings.lead_video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}</video></div>
        {%- endif -%}
        {%- if nimg == 0 and mainimg == blank and section.settings.lead_video == blank -%}
          <div class="hb-cell" data-slide="0"><div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;color:var(--helios-mut,#56636E);padding:24px;"><span style="width:58px;height:58px;border-radius:50%;background:rgba(14,124,196,.10);display:grid;place-items:center;color:var(--helios-accd,#0A5E97);"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="m21 16-4.5-4.5L7 21"/></svg></span><div style="font-family:'Archivo',sans-serif;font-weight:700;font-size:14px;color:var(--helios-ink,#0C1A24);">Add your demo video or photos</div><div style="font-size:12px;opacity:.75;">Product → Media · the first one shows here</div></div></div>
        {%- endif -%}
      </div>
      <div class="hb-dots" data-dots></div>
      <div class="hb-thumbs">
        {%- comment -%} product images first (Product → Media), min 4 slots {%- endcomment -%}
        {%- assign nimg = product.images.size -%}
        {%- if nimg < 4 -%}{%- assign slotcount = 4 -%}{%- else -%}{%- assign slotcount = nimg -%}{%- endif -%}
        {%- for n in (1..slotcount) -%}
          {%- assign idx = n | minus: 1 -%}
          {%- assign img = product.images[idx] -%}
          {%- if img != blank -%}
            <button type="button" class="hb-thumb{% if forloop.first %} sel{% endif %}" data-goto="{{ idx }}"><img src="{{ img | image_url: width: 220 }}" alt="{{ product.title | escape }}" loading="lazy"></button>
          {%- else -%}
            <button type="button" class="hb-thumb" aria-hidden="true"><span style="display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;color:var(--helios-mut,#56636E);font-size:11px;gap:3px;opacity:.7;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>img</span></button>
          {%- endif -%}
        {%- endfor -%}
        {%- comment -%} demo video LAST {%- endcomment -%}
        {%- if section.settings.lead_video != blank -%}
        <button type="button" class="hb-thumb" data-goto="vid">
          {%- if section.settings.lead_video.preview_image != blank -%}<img src="{{ section.settings.lead_video.preview_image | image_url: width: 220 }}" alt="demo"><span style="position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-size:18px;text-shadow:0 1px 6px rgba(0,0,0,.6);">▶</span>{%- else -%}<span style="display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;color:var(--helios-accd,#0A5E97);font-size:11px;gap:3px;">▶<span style="opacity:.7;">video</span></span>{%- endif -%}
        </button>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- GALLERY (mini) ---------- {%- endcomment -%}
    <div class="hb-gallery" data-gal="mini" style="display:none;">
      <div class="hb-stage" data-track>
        {%- assign mhas = false -%}
        {%- for i in (1..4) -%}
          {%- case i -%}{%- when 1 -%}{%- assign mi = section.settings.mini_image_1 -%}{%- when 2 -%}{%- assign mi = section.settings.mini_image_2 -%}{%- when 3 -%}{%- assign mi = section.settings.mini_image_3 -%}{%- when 4 -%}{%- assign mi = section.settings.mini_image_4 -%}{%- endcase -%}
          {%- if mi != blank -%}<div class="hb-cell" data-slide="{{ i }}"><img src="{{ mi | image_url: width: 700 }}" srcset="{{ mi | image_url: width: 400 }} 400w, {{ mi | image_url: width: 700 }} 700w, {{ mi | image_url: width: 1000 }} 1000w" sizes="(min-width:880px) 540px, 92vw" width="1000" height="1000" alt="Super Glide Mini" loading="{% unless mhas %}eager{% else %}lazy{% endunless %}" decoding="async"></div>{%- assign mhas = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if section.settings.mini_video_1 != blank -%}<div class="hb-cell" data-slide="v1"><video muted loop playsinline preload="none"{% if section.settings.mini_video_1.preview_image != blank %} poster="{{ section.settings.mini_video_1.preview_image | image_url: width: 700 }}"{% endif %}>{%- for s in section.settings.mini_video_1.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}</video></div>{%- assign mhas = true -%}{%- endif -%}
        {%- if section.settings.mini_video_2 != blank -%}<div class="hb-cell" data-slide="v2"><video muted loop playsinline preload="none"{% if section.settings.mini_video_2.preview_image != blank %} poster="{{ section.settings.mini_video_2.preview_image | image_url: width: 700 }}"{% endif %}>{%- for s in section.settings.mini_video_2.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}</video></div>{%- endif -%}
        {%- unless mhas -%}<div class="hb-cell" data-slide="1"><div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--helios-mut,#56636E);padding:24px;text-align:center;"><span style="width:52px;height:52px;border-radius:50%;background:rgba(14,124,196,.10);display:grid;place-items:center;color:var(--helios-accd,#0A5E97);">🌀</span><div style="font-family:'Archivo',sans-serif;font-weight:700;font-size:14px;color:var(--helios-ink,#0C1A24);">Add Mini media</div><div style="font-size:12px;opacity:.75;">Customize → Mini media (2 videos + images)</div></div></div>{%- endunless -%}
      </div>
      <div class="hb-dots" data-dots></div>
      <div class="hb-thumbs">
        {%- for i in (1..4) -%}
          {%- case i -%}{%- when 1 -%}{%- assign mi = section.settings.mini_image_1 -%}{%- when 2 -%}{%- assign mi = section.settings.mini_image_2 -%}{%- when 3 -%}{%- assign mi = section.settings.mini_image_3 -%}{%- when 4 -%}{%- assign mi = section.settings.mini_image_4 -%}{%- endcase -%}
          {%- if mi != blank -%}
            <button type="button" class="hb-thumb{% if forloop.first %} sel{% endif %}" data-goto="{{ i }}"><img src="{{ mi | image_url: width: 220 }}" alt="Super Glide Mini" loading="lazy"></button>
          {%- else -%}
            <button type="button" class="hb-thumb" aria-hidden="true"><span style="display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;color:var(--helios-mut,#56636E);font-size:11px;gap:3px;opacity:.7;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>img</span></button>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.mini_video_1 != blank -%}<button type="button" class="hb-thumb" data-goto="v1">{%- if section.settings.mini_video_1.preview_image != blank -%}<img src="{{ section.settings.mini_video_1.preview_image | image_url: width: 220 }}" alt="video"><span style="position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-size:18px;text-shadow:0 1px 6px rgba(0,0,0,.6);">▶</span>{%- else -%}<span style="display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;color:var(--helios-accd,#0A5E97);font-size:11px;gap:3px;">▶<span style="opacity:.7;">video</span></span>{%- endif -%}</button>{%- endif -%}
        {%- if section.settings.mini_video_2 != blank -%}<button type="button" class="hb-thumb" data-goto="v2">{%- if section.settings.mini_video_2.preview_image != blank -%}<img src="{{ section.settings.mini_video_2.preview_image | image_url: width: 220 }}" alt="video 2"><span style="position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-size:18px;text-shadow:0 1px 6px rgba(0,0,0,.6);">▶</span>{%- else -%}<span style="display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;color:var(--helios-accd,#0A5E97);font-size:11px;gap:3px;">▶<span style="opacity:.7;">video 2</span></span>{%- endif -%}</button>{%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- BUY ---------- {%- endcomment -%}
    <div class="hb-buy">
      {%- if section.settings.tiktok_badge -%}<span class="hb-ey">▶ As seen on <b style="color:#25f4ee;">TikTok</b></span>{%- endif -%}
      <h1 id="hb-title-{{ sid }}" data-double="{{ section.settings.title | default: 'HELIOS Super Glide' }}" data-mini="HELIOS Mini Glide">{{ section.settings.title | default: 'HELIOS Super Glide' }}</h1>
      <p class="hb-sub">{{ section.settings.subtitle | default: 'Kick back, grab the joysticks, and glide across the water. No paddling — just cruise.' }}</p>
      <div class="hb-rate">
        <span style="color:#f5a623;letter-spacing:1px;">★★★★★</span>
        <b style="color:var(--helios-ink,#0C1A24);">{{ section.settings.rating | default: '4.8' }}</b> ·
        <span>{{ section.settings.review_count | default: '3,912' }}+ reviews</span>
      </div>

      <div class="hb-price">
        <b id="hb-price-{{ sid }}">{{ cur.price | money }}</b>
        {%- if cur.compare_at_price > cur.price -%}<s id="hb-cmp-{{ sid }}">{{ cur.compare_at_price | money }}</s>{%- endif -%}
        <span class="hb-save" id="hb-savepct-{{ sid }}"></span>
      </div>

      <div class="hb-chips">
        <span class="hb-chip">★ {{ section.settings.review_count | default: '3,912' }} reviews</span>
        <span class="hb-chip">🛟 Glides hands-free</span>
        <span class="hb-chip">👨‍👩‍👧 Fits the whole family</span>
        <span class="hb-chip">🚚 Free shipping</span>
        <span class="hb-chip">🛡 30-day returns</span>
      </div>

      {%- if section.settings.show_countdown -%}
        <div class="hb-timer">⚡ Flash sale ends <span id="hb-cd-{{ sid }}">--:--:--</span></div>
      {%- endif -%}

      {%- comment -%} variant picker (Super Glide / Mini) — sits right above the pack options {%- endcomment -%}
      <div class="hb-picker" style="display:flex;gap:9px;margin:8px 0 14px;">
        {%- assign pk_dbl = product.featured_image | default: section.settings.lead_image -%}
        <button type="button" data-pick="double" class="hb-pk on">
          {%- if pk_dbl != blank -%}<img class="hb-pkimg" src="{{ pk_dbl | image_url: width: 120 }}" alt="Super Glide">{%- endif -%}
          <span class="hb-pktx"><b>Super Glide</b><span>Double · 2 seats</span></span>
        </button>
        {%- assign pk_mini = section.settings.mini_image_1 -%}
        <button type="button" data-pick="mini" class="hb-pk">
          {%- if pk_mini != blank -%}<img class="hb-pkimg" src="{{ pk_mini | image_url: width: 120 }}" alt="Mini Glide">{%- endif -%}
          <span class="hb-pktx"><b>Mini Glide</b><span>Single · 1 seat</span></span>
        </button>
      </div>

      {%- comment -%} ========== REAL SHOPIFY FORM ========== {%- endcomment -%}
      {%- assign hb_form_id = 'hb-form-' | append: sid -%}
      {%- form 'product', product, id: hb_form_id -%}
        <input type="hidden" name="id" id="hb-vid-{{ sid }}" value="{{ cur.id }}">

        <div class="hb-tiers" id="hb-tiers-{{ sid }}">
          {%- comment -%} auto Mini tier (single-seat variant) {%- endcomment -%}
          {%- for v in product.variants -%}
            {%- if v.title contains 'Mini' -%}
              {%- assign mqty = 1 -%}{%- assign msub = 'Single seat · most affordable' -%}{%- assign mbadge = '' -%}{%- assign msel = '' -%}
              {%- if v.title contains '2' -%}{%- assign mqty = 2 -%}{%- assign msub = 'BUY 1 GET 1 50% OFF · race a friend' -%}{%- assign mbadge = 'Most popular' -%}{%- assign msel = ' sel' -%}{%- endif -%}
              {%- if v.title contains '3' -%}{%- assign mqty = 3 -%}{%- assign msub = 'Best value · the whole crew' -%}{%- assign mbadge = 'Best value' -%}{%- endif -%}
              {%- assign mper = v.price | divided_by: mqty -%}
              <label class="hb-tier{{ msel }}" data-tier="mini" style="display:none;" data-vid="{{ v.id }}" data-price="{{ v.price }}" data-compare="{{ v.compare_at_price }}">
                {%- if mbadge != blank -%}<span class="hb-badge" style="background:{% if mbadge == 'Best value' %}var(--helios-teal,#2FC1D6){% else %}linear-gradient(135deg,var(--helios-acc,#0E7CC4),var(--helios-acc2,#16A6D6)){% endif %};">{{ mbadge }}</span>{%- endif -%}
                <span class="hb-radio"></span>
                <div style="flex:1;">
                  <span class="hb-tiername">{{ mqty }} × Mini Glide</span>
                  <span class="hb-tiersub">{{ msub }}</span>
                  <span class="hb-tierper">{{ mper | money }} / glider</span>
                </div>
                <div class="hb-tierprice">
                  <b>{{ v.price | money }}</b>
                  {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
                  {%- if v.compare_at_price > v.price -%}{%- assign msv = v.compare_at_price | minus: v.price -%}<span class="hb-tiersave">You save {{ msv | money }}</span>{%- endif -%}
                </div>
              </label>
            {%- endif -%}
          {%- endfor -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'bundle' -%}
              {%- assign vid = block.settings.variant_id | times: 1 -%}
              {%- assign bv = blank -%}
              {%- for v in product.variants -%}{%- if v.id == vid -%}{%- assign bv = v -%}{%- endif -%}{%- endfor -%}
              {%- assign qty = block.settings.qty | default: 1 -%}
              {%- assign tprice = bv.price | default: block.settings.fallback_price -%}
              {%- assign tcompare = bv.compare_at_price | default: block.settings.fallback_compare -%}
              {%- assign saveamt = tcompare | minus: tprice -%}
              {%- assign perunit = tprice | divided_by: qty -%}
              <label class="hb-tier{% if block.settings.preselect %} sel{% endif %}" data-tier="double"
                     data-vid="{{ bv.id | default: vid }}" data-price="{{ tprice }}" data-compare="{{ tcompare }}"
                     {{ block.shopify_attributes }}>
                {%- if block.settings.badge != blank -%}
                  <span class="hb-badge" style="background:{% if block.settings.badge_style == 'teal' %}var(--helios-teal,#2FC1D6){% else %}linear-gradient(135deg,var(--helios-acc,#0E7CC4),var(--helios-acc2,#16A6D6)){% endif %};">{{ block.settings.badge }}</span>
                {%- endif -%}
                <span class="hb-radio"></span>
                <div style="flex:1;">
                  <span class="hb-tiername">{{ block.settings.label | default: bv.title }}</span>
                  {%- if block.settings.sublabel != blank -%}<span class="hb-tiersub">{{ block.settings.sublabel }}</span>{%- endif -%}
                  <span class="hb-tierper">{{ perunit | money }} / lounger</span>
                </div>
                <div class="hb-tierprice">
                  <b>{{ tprice | money }}</b>
                  {%- if tcompare > tprice -%}<s>{{ tcompare | money }}</s>{%- endif -%}
                  {%- if saveamt > 0 -%}<span class="hb-tiersave">You save {{ saveamt | money }}</span>{%- endif -%}
                </div>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <button type="submit" name="add" class="hb-add" {% unless cur.available %}disabled{% endunless %}>
          <span style="position:relative;z-index:2;">{{ section.settings.cta_text | default: 'Add to Cart' }} · <span class="hb-total" id="hb-total-{{ sid }}">{{ cur.price | money }}</span> →</span>
          <span class="hb-sheen"></span>
        </button>

        {%- comment -%} Express checkout: Apple Pay / Shop Pay / Google Pay {%- endcomment -%}
        <div class="hb-pay">{{ form | payment_button }}</div>
      {%- endform -%}

      {%- if section.settings.discount_code != blank -%}
        <button type="button" class="hb-code" id="hb-code-{{ sid }}" data-code="{{ section.settings.discount_code }}">
          <span style="font-size:12.5px;color:var(--helios-mut,#56636E);">{{ section.settings.discount_label | default: 'Extra savings — tap to copy' }}</span>
          <b>{{ section.settings.discount_code }}
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
          </b>
        </button>
      {%- endif -%}

      <div class="hb-trust">🛡 30-day money-back · 🚚 Free shipping · 🔒 Secure checkout</div>
      <div class="hb-pays"><span>VISA</span><span>MASTERCARD</span><span>AMEX</span><span>PAYPAL</span><span>APPLE PAY</span><span>SHOP PAY</span></div>

      {%- if section.settings.eta_line != blank -%}<div class="hb-eta">🚚 {{ section.settings.eta_line }}</div>{%- endif -%}

      {%- if section.settings.show_stock -%}
        <div class="hb-stock">🔥 Summer demand is high — only <b>{{ section.settings.stock_left | default: 24 }}</b> left at this price.
          <div class="hb-stockbar"><i></i></div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_live -%}
        <div class="hb-live"><span class="hb-dot"></span>
          <b id="hb-view-{{ sid }}" style="color:var(--helios-ink,#0C1A24);">{{ section.settings.live_viewers | default: 58 }}</b> viewing ·
          <b id="hb-sold-{{ sid }}" style="color:var(--helios-ink,#0C1A24);">{{ section.settings.sold_today | default: 202 }}</b> sold today
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if section.settings.show_toasts -%}
  <div id="hb-toast-{{ sid }}"><span class="hb-tt-em">🌊</span><div style="line-height:1.25;"><div id="hb-toast-name-{{ sid }}" style="font-size:13px;font-weight:700;color:var(--helios-ink,#0C1A24);"></div><div id="hb-toast-meta-{{ sid }}" style="font-size:11.5px;color:var(--helios-mut,#56636E);"></div></div></div>
{%- endif -%}

<script>
(function(){
  var root = document.getElementById('hb-{{ sid }}');
  if(!root || root.dataset.init) return; root.dataset.init = '1';
  var money = function(cents){ return '{{ shop.money_format | strip_html }}'.replace(/\{\{\s*amount\s*\}\}/, (cents/100).toFixed(2)).replace(/\{\{\s*amount_no_decimals\s*\}\}/, Math.round(cents/100)); };

  /* ---- bundle tiers → hidden variant id + total + savings ---- */
  var hid = document.getElementById('hb-vid-{{ sid }}');
  var total = document.getElementById('hb-total-{{ sid }}');
  var price = document.getElementById('hb-price-{{ sid }}');
  var cmp = document.getElementById('hb-cmp-{{ sid }}');
  var savePct = document.getElementById('hb-savepct-{{ sid }}');
  var tiers = root.querySelectorAll('.hb-tier');
  function selectTier(t){
    tiers.forEach(function(x){ x.classList.remove('sel'); });
    t.classList.add('sel');
    var p = parseInt(t.dataset.price,10), c = parseInt(t.dataset.compare,10) || 0;
    if(hid) hid.value = t.dataset.vid;
    if(total) total.textContent = money(p);
    if(price) price.textContent = money(p);
    if(cmp){ if(c>p){ cmp.style.display=''; cmp.textContent = money(c); } else cmp.style.display='none'; }
    if(savePct){ if(c>p){ savePct.style.display=''; savePct.textContent = 'SAVE ' + Math.round((1-p/c)*100) + '%'; } else savePct.style.display='none'; }
    try{ var u=new URL(window.location); u.searchParams.set('variant', t.dataset.vid); history.replaceState({}, '', u); }catch(e){}
    window.dispatchEvent(new CustomEvent('helios:variant', { detail: { id: t.dataset.vid, price: money(p), compare: c>p ? money(c) : '' } }));
  }
  tiers.forEach(function(t){ t.addEventListener('click', function(e){ e.preventDefault(); selectTier(t); }); });

  /* ---- gallery thumbs (generic for double + mini) ---- */
  function bindGallery(gal){
    var track = gal.querySelector('[data-track]'); if(!track) return;
    var cells = Array.prototype.slice.call(track.querySelectorAll('.hb-cell'));
    var thumbs = Array.prototype.slice.call(gal.querySelectorAll('.hb-thumb[data-goto]'));
    var dotsWrap = gal.querySelector('[data-dots]');
    if(!cells.length) return;
    if(dotsWrap){ dotsWrap.innerHTML=''; cells.forEach(function(c,i){ var d=document.createElement('span'); d.className='hb-dot'+(i===0?' on':''); dotsWrap.appendChild(d); }); }
    var dots = dotsWrap ? Array.prototype.slice.call(dotsWrap.children) : [];
    function setActive(i){
      dots.forEach(function(d,j){ d.classList.toggle('on', j===i); });
      var key = cells[i].getAttribute('data-slide');
      thumbs.forEach(function(t){ t.classList.toggle('sel', t.getAttribute('data-goto')===key); });
      cells.forEach(function(c,j){ var v=c.querySelector('video'); if(v){ if(j===i){ var p=v.play(); if(p&&p.catch)p.catch(function(){}); } else { try{ v.pause(); }catch(e){} } } });
    }
    if('IntersectionObserver' in window){
      var io=new IntersectionObserver(function(ents){
        ents.forEach(function(en){ if(en.isIntersecting && en.intersectionRatio>=0.55){ var i=cells.indexOf(en.target); if(i>=0) setActive(i); } });
      },{root:track,threshold:[0.55,0.8]});
      cells.forEach(function(c){ io.observe(c); });
    }
    thumbs.forEach(function(t){
      t.addEventListener('click', function(){
        var key=t.getAttribute('data-goto');
        for(var i=0;i<cells.length;i++){ if(cells[i].getAttribute('data-slide')===key){ track.scrollTo({left:cells[i].offsetLeft,behavior:'smooth'}); setActive(i); break; } }
      });
    });
  }
  root.querySelectorAll('[data-gal]').forEach(bindGallery);

  /* ---- variant picker (Double / Mini) + Meta ad deep-link ---- */
  var picks = root.querySelectorAll('[data-pick]');
  function setMode(m){
    picks.forEach(function(p){ p.classList.toggle('on', p.dataset.pick===m); });
    root.querySelectorAll('[data-gal]').forEach(function(g){ g.style.display=g.dataset.gal===m?'':'none'; });
    root.querySelectorAll('[data-tier]').forEach(function(t){ t.style.display=t.dataset.tier===m?'':'none'; });
    var ttl=document.getElementById('hb-title-{{ sid }}'); if(ttl){ var nm=(m==='mini')?ttl.getAttribute('data-mini'):ttl.getAttribute('data-double'); if(nm) ttl.textContent=nm; }
    var def = root.querySelector('[data-tier="'+m+'"].sel') || root.querySelector('[data-tier="'+m+'"]');
    if(def) selectTier(def);
  }
  picks.forEach(function(p){ p.addEventListener('click', function(){ setMode(p.dataset.pick); }); });
  (function(){
    var qv=null; try{ qv=new URL(window.location).searchParams.get('variant'); }catch(e){}
    var st = qv ? root.querySelector('.hb-tier[data-vid="'+qv+'"]') : null;
    if(st){ setMode(st.dataset.tier || 'double'); selectTier(st); }
    else { setMode('double'); }
  })();

  /* ---- copy code ---- */
  var code = document.getElementById('hb-code-{{ sid }}');
  if(code) code.addEventListener('click', function(){
    var c = code.dataset.code, b = code.querySelector('b');
    var done = function(){ var html=b.innerHTML; b.textContent='✓ Copied '+c+'!'; code.style.borderColor='#1aa86b'; setTimeout(function(){ b.innerHTML=html; code.style.borderColor=''; },1800); };
    if(navigator.clipboard){ navigator.clipboard.writeText(c).then(done).catch(done); } else done();
  });

  /* ---- honest per-session countdown ---- */
  {%- if section.settings.show_countdown -%}
  (function(){
    var el = document.getElementById('hb-cd-{{ sid }}'); if(!el) return;
    var span = {{ section.settings.countdown_minutes | default: 480 }} * 60000;
    var key = 'helios_cd_{{ sid }}';
    var end = parseInt(sessionStorage.getItem(key),10);
    if(!end || isNaN(end) || end < Date.now()){ end = Date.now() + span; sessionStorage.setItem(key, end); }
    function tick(){ var d=Math.max(0,end-Date.now()); var h=Math.floor(d/3.6e6),m=Math.floor(d%3.6e6/6e4),s=Math.floor(d%6e4/1e3); el.textContent = (h<10?'0':'')+h+':'+(m<10?'0':'')+m+':'+(s<10?'0':'')+s; }
    tick(); setInterval(tick,1000);
  })();
  {%- endif -%}

  /* ---- live viewers ---- */
  {%- if section.settings.show_live -%}
  (function(){
    var lv=document.getElementById('hb-view-{{ sid }}'), sd=document.getElementById('hb-sold-{{ sid }}');
    var v={{ section.settings.live_viewers | default: 58 }}, s={{ section.settings.sold_today | default: 202 }};
    setInterval(function(){ v=Math.max(20,v+(Math.random()<0.5?-1:1)*(1+Math.floor(Math.random()*3))); if(lv)lv.textContent=v; if(Math.random()<0.4){ s++; if(sd)sd.textContent=s; } },3200);
  })();
  {%- endif -%}

  /* ---- recent-purchase toasts ---- */
  {%- if section.settings.show_toasts -%}
  (function(){
    var box=document.getElementById('hb-toast-{{ sid }}'),
        nm=document.getElementById('hb-toast-name-{{ sid }}'),
        mt=document.getElementById('hb-toast-meta-{{ sid }}');
    if(!box) return;
    var names=[['Jordan from TX','bought 2 — 3 min ago'],['Maya from HI','bought 1 — 7 min ago'],['Chris from NC','bought 4 — 12 min ago'],['Sophie from FL','bought 2 — 18 min ago'],['Devon from AZ','bought 1 — 24 min ago'],['Natalie from SC','bought 2 — 31 min ago']];
    var i=0;
    function show(){ var n=names[i%names.length]; i++; nm.textContent=n[0]; mt.textContent='Super Glide · '+n[1]; box.classList.add('show'); setTimeout(function(){ box.classList.remove('show'); }, 4200); }
    setTimeout(function loop(){ show(); setTimeout(loop, 11000); }, 6000);
  })();
  {%- endif -%}
})();
</script>

{%- comment -%} =================== SCHEMA =================== {%- endcomment -%}
{% schema %}
{
  "name": "HELIOS Buy Box",
  "tag": "section",
  "class": "helios-section",
  "settings": [
    { "type": "product", "id": "featured_product", "label": "Product (for homepage / non-product templates)" },
    { "type": "header", "content": "Lead media (A/B: video vs image)" },
    { "type": "select", "id": "lead_media_type", "label": "Lead media", "options": [{"value":"video","label":"Demo video (proof of motion)"},{"value":"image","label":"Image"}], "default": "video" },
    { "type": "video", "id": "lead_video", "label": "Demo video (autoplay muted loop)" },
    { "type": "image_picker", "id": "lead_image", "label": "Lead / poster image" },
    { "type": "header", "content": "Mini Glider media (shows when Mini is picked)" },
    { "type": "video", "id": "mini_video_1", "label": "Mini video 1" },
    { "type": "video", "id": "mini_video_2", "label": "Mini video 2" },
    { "type": "image_picker", "id": "mini_image_1", "label": "Mini image 1" },
    { "type": "image_picker", "id": "mini_image_2", "label": "Mini image 2" },
    { "type": "image_picker", "id": "mini_image_3", "label": "Mini image 3" },
    { "type": "image_picker", "id": "mini_image_4", "label": "Mini image 4" },
    { "type": "header", "content": "Copy (A/B)" },
    { "type": "text", "id": "title", "label": "Product title", "default": "HELIOS Super Glide" },
    { "type": "richtext", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "3,912" },
    { "type": "checkbox", "id": "tiktok_badge", "label": "Show 'As seen on TikTok' badge", "default": true },
    { "type": "text", "id": "cta_text", "label": "Add-to-cart text", "default": "Add to Cart" },
    { "type": "header", "content": "Discount chip (use a REAL active code)" },
    { "type": "text", "id": "discount_code", "label": "Discount code", "default": "SUPERGLIDEIT" },
    { "type": "text", "id": "discount_label", "label": "Discount label", "default": "Extra savings — tap to copy" },
    { "type": "header", "content": "Urgency & social proof" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    { "type": "range", "id": "countdown_minutes", "label": "Countdown length (minutes, per session)", "min": 30, "max": 1440, "step": 30, "default": 480 },
    { "type": "text", "id": "eta_line", "label": "Delivery ETA line", "default": "Order today → ships in 24h, arrives in 5–8 days" },
    { "type": "checkbox", "id": "show_stock", "label": "Show low-stock bar", "default": true },
    { "type": "number", "id": "stock_left", "label": "Stock left", "default": 24 },
    { "type": "checkbox", "id": "show_live", "label": "Show live viewers / sold", "default": true },
    { "type": "number", "id": "live_viewers", "label": "Viewers (starting)", "default": 58 },
    { "type": "number", "id": "sold_today", "label": "Sold today (starting)", "default": 202 },
    { "type": "checkbox", "id": "show_toasts", "label": "Show recent-purchase toasts", "default": true }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle tier",
      "settings": [
        { "type": "text", "id": "variant_id", "label": "Variant ID (real, numeric)", "info": "Products → variant → number at end of admin URL" },
        { "type": "number", "id": "qty", "label": "Units in this bundle", "default": 1 },
        { "type": "text", "id": "label", "label": "Tier label", "default": "2 Super Glide" },
        { "type": "text", "id": "sublabel", "label": "Sub label", "default": "BUY ONE GET ONE FREE · Race a friend" },
        { "type": "text", "id": "badge", "label": "Badge text (optional)", "default": "Most popular" },
