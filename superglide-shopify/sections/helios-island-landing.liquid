@media(max-width:899px){#pk .gal{flex-direction:column-reverse}#pk .gthumbs{flex-direction:row;overflow-x:auto;width:100%;scrollbar-width:none}#pk .gthumbs::-webkit-scrollbar{display:none}#pk .gth{flex:0 0 auto;width:56px}#pk .gmain{max-height:none;width:100%}}
