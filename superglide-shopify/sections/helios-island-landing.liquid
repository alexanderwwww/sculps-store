    }catch(e){ busy=false; un(); window.location.href=fallback; }
  }
  var atcg=document.getElementById('atcg');
  if(atcg)atcg.addEventListener('click',function(){ addThen(atcg); });
  var sgob=document.getElementById('sgob');
  if(sgob){ sgob.addEventListener('click',function(){ addThen(sgob.querySelector('.hh')); });
