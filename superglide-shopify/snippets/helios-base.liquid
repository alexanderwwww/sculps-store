{%- comment -%}
  HELIOS — base styles (fonts, palette, glass tokens, keyframes).
  Include ONCE near the top of layout/theme.liquid <head>:
      {% render 'helios-base' %}
  Every HELIOS section also falls back to these values inline, so it is safe
  if a section loads before this snippet — but include it once for best results.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --helios-ink:#0C1A24; --helios-ink2:#0A1219; --helios-mut:#56636E;
    --helios-acc:#0E7CC4; --helios-acc2:#16A6D6; --helios-accd:#0A5E97; --helios-teal:#2FC1D6;
    --helios-ocean1:#062F49; --helios-ocean2:#0E6FA8; --helios-ocean3:#2FB6D6;
    --helios-line:rgba(255,255,255,.6); --helios-lins:rgba(12,26,36,.08);
    --helios-g-bg:rgba(255,255,255,.55); --helios-g-bg2:rgba(255,255,255,.4);
    --helios-g-bd:1px solid rgba(255,255,255,.65); --helios-g-bd2:1px solid rgba(255,255,255,.45);
    --helios-g-blur:blur(20px) saturate(165%);
    --helios-g-sh:0 10px 34px rgba(6,47,73,.13),inset 0 1px 0 rgba(255,255,255,.75);
    --helios-g-shlg:0 26px 60px -18px rgba(6,47,73,.3),inset 0 1px 0 rgba(255,255,255,.75);
  }
  .helios{font-family:'Inter',system-ui,sans-serif;color:var(--helios-ink);line-height:1.55;}
  .helios *{box-sizing:border-box;}
  .helios h1,.helios h2,.helios h3,.helios .arch{font-family:'Archivo',system-ui,sans-serif;}
  .helios a{text-decoration:none;}
  .helios-bg{background:
    radial-gradient(60% 50% at 12% 6%,rgba(108,196,232,.26),transparent 60%),
    radial-gradient(55% 45% at 90% 3%,rgba(64,206,222,.2),transparent 60%),
    radial-gradient(52% 42% at 80% 86%,rgba(108,196,232,.18),transparent 60%),
    linear-gradient(180deg,#E6F2F8,#EEF6FA);}
  .helios [data-reveal]{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.16,.84,.3,1),transform .8s cubic-bezier(.16,.84,.3,1);}
  .helios [data-reveal].in{opacity:1;transform:none;}
  .helios-noscroll{scrollbar-width:none;-ms-overflow-style:none;}
  .helios-noscroll::-webkit-scrollbar{display:none;width:0;height:0;}
  @keyframes helios-sheen{0%{transform:translateX(-120%) skewX(-18deg);}60%,100%{transform:translateX(260%) skewX(-18deg);}}
  @keyframes helios-pulse{0%{opacity:1;transform:scale(1);}50%{opacity:.35;transform:scale(.55);}100%{opacity:1;transform:scale(1);}}
  @keyframes helios-mq{to{transform:translateX(-50%);}}
  @keyframes helios-marqA{from{transform:translateX(0);}to{transform:translateX(-50%);}}
  @keyframes helios-marqB{from{transform:translateX(-50%);}to{transform:translateX(0);}}
  @keyframes helios-toastin{from{opacity:0;transform:translateY(16px) scale(.96);}to{opacity:1;transform:translateY(0) scale(1);}}
</style>
<script>
  /* Shared scroll-reveal — runs once, observes any [data-reveal] now or later. */
  (function(){
    if (window.__heliosReveal) return; window.__heliosReveal = true;
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    function scan(){ document.querySelectorAll('.helios [data-reveal]:not(.in)').forEach(function(el){ io.observe(el); }); }
    document.addEventListener('DOMContentLoaded', scan); scan();
    window.heliosRevealScan = scan;
  })();
</script>
